# Astro Database
# Path to the SQLite database file for Astro DB
# In production, this should point to a persistent volume
ASTRO_DATABASE_FILE=./.astro/content.db

# Server Configuration
# Host to bind the server to (0.0.0.0 for all interfaces in production)
HOST=0.0.0.0

# Port for the server to listen on
PORT=4321

# Node Environment (development, production)
NODE_ENV=production

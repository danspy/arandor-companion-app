# Nothing is required for `npm run dev`. Copy to .env to override defaults.

# SQLite file the app opens.
# Default: ./data/dev.db under `astro dev`, ./data/content.db in a production build.
# DATABASE_FILE=./data/dev.db

# Signs login cookies; at least 32 characters. Required for a production run
# (generate with: openssl rand -hex 32). Dev uses a temporary secret if unset.
# SESSION_SECRET=

# Upload directory for a production run (dev always uses public/uploads).
# Default: /srv/arandor/uploads
# UPLOAD_DIR=./uploads

# Time zone in which calendar event times are entered. Default: Europe/Berlin
# CAMPAIGN_TIME_ZONE=Europe/Berlin

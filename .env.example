# OpenAI API Configuration for AI-powered diary summaries and image generation
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# Optional: Custom API base URL (for OpenRouter, local LLMs, etc.)
# OPENAI_API_BASE=https://api.openai.com/v1

# Optional: Model to use for summaries (default: gpt-3.5-turbo)
# OPENAI_MODEL=gpt-3.5-turbo

# Optional: Maximum tokens for summary generation (default: 150)
# Increase for longer summaries, decrease for shorter ones
# OPENAI_MAX_TOKENS=150

# Optional: Image generation model (default: dall-e-3)
# Options: dall-e-2, dall-e-3
# OPENAI_IMAGE_MODEL=dall-e-3

# Optional: Image size (default: 1024x1024)
# DALL-E 2 options: 256x256, 512x512, 1024x1024
# DALL-E 3 options: 1024x1024, 1792x1024, 1024x1792
# OPENAI_IMAGE_SIZE=1024x1024

# Optional: Image quality (default: standard)
# Options: standard, hd (DALL-E 3 only)
# OPENAI_IMAGE_QUALITY=standard

# Optional: Text-to-Speech model (default: tts-1-hd)
# Options: tts-1 (faster, cheaper), tts-1-hd (higher quality)
# OPENAI_TTS_MODEL=tts-1-hd

# Optional: TTS voice for podcast narration
# If not set, the voice is automatically selected based on detected language:
#   - German content: alloy (neutral, clear voice)
#   - English content: onyx (deep, epic voice)
# Options: alloy, echo, fable, onyx, nova, shimmer
# Recommended for English D&D narration: onyx (deep, epic), fable (storytelling)
# Recommended for German narration: alloy (clear, neutral), echo (balanced)
# OPENAI_TTS_VOICE=onyx

# Optional: TTS speed (default: 1.0)
# Range: 0.25 to 4.0 (1.0 is normal speed)
# OPENAI_TTS_SPEED=1.0

# Optional: AI podcast narrative generation settings
# These control the AI-generated narration that recollects the session highlights
# Temperature: Controls creativity (0.0-2.0, default: 0.8)
#   - Lower values (0.5-0.7) = more focused and consistent
#   - Higher values (0.8-1.0) = more creative and varied
# OPENAI_PODCAST_TEMPERATURE=0.8

# Max tokens: Controls narrative length (default: 2000)
#   - Roughly 300-800 words for 2-4 minute podcast episodes
#   - Must stay under OpenAI TTS limit of 4096 characters after generation
# OPENAI_PODCAST_MAX_TOKENS=2000

# For OpenRouter (alternative AI provider):
# OPENAI_API_KEY=your-openrouter-key
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-3.5-turbo

# For local LLMs (e.g., Ollama):
# OPENAI_API_KEY=dummy
# OPENAI_API_BASE=http://localhost:11434/v1
# OPENAI_MODEL=llama2

# OpenAI API Configuration for AI-powered diary summaries and image generation
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# Optional: Custom API base URL (for OpenRouter, local LLMs, etc.)
# OPENAI_API_BASE=https://api.openai.com/v1

# Optional: Model to use for summaries (default: gpt-3.5-turbo)
# OPENAI_MODEL=gpt-3.5-turbo

# Optional: Maximum tokens for summary generation (default: 150)
# Increase for longer summaries, decrease for shorter ones
# OPENAI_MAX_TOKENS=150

# Optional: Image generation model (default: dall-e-3)
# Options: dall-e-2, dall-e-3
# OPENAI_IMAGE_MODEL=dall-e-3

# Optional: Image size (default: 1024x1024)
# DALL-E 2 options: 256x256, 512x512, 1024x1024
# DALL-E 3 options: 1024x1024, 1792x1024, 1024x1792
# OPENAI_IMAGE_SIZE=1024x1024

# Optional: Image quality (default: standard)
# Options: standard, hd (DALL-E 3 only)
# OPENAI_IMAGE_QUALITY=standard

# For OpenRouter (alternative AI provider):
# OPENAI_API_KEY=your-openrouter-key
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-3.5-turbo

# For local LLMs (e.g., Ollama):
# OPENAI_API_KEY=dummy
# OPENAI_API_BASE=http://localhost:11434/v1
# OPENAI_MODEL=llama2

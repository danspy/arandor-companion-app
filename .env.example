# OpenAI API Key for podcast generation
# Get your API key from: https://platform.openai.com/api-keys
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace 'your-openai-api-key-here' with your actual API key
# 3. DO NOT use quotes around the value
# 4. Restart your dev server after creating/updating this file
#
# FORMAT: Just the key on one line, no quotes or extra spaces
# Correct:   OPENAI_API_KEY=sk-proj-abc123...
# Incorrect: OPENAI_API_KEY="sk-proj-abc123..."
# Incorrect: OPENAI_API_KEY = sk-proj-abc123...
#
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Custom uploads directory (defaults to /srv/arandor/uploads in production)
# UPLOADS_DIR=/custom/path/to/uploads

#!/bin/bash
# arandor-deploy-restart
# This script should be installed at /usr/local/sbin/arandor-deploy-restart
# and configured in sudoers to allow NOPASSWD execution by the deploy user.
#
# Add to /etc/sudoers.d/arandor-deploy:
# deploy ALL=(ALL) NOPASSWD: /usr/local/sbin/arandor-deploy-restart
# deploy ALL=(ALL) NOPASSWD: /usr/local/sbin/arandor-deploy-status

set -e

systemctl daemon-reload
systemctl enable arandor.service
systemctl restart arandor.service

echo "Arandor service restarted successfully"

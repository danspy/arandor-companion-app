---
import '../styles/global.css';
import { isAuthenticated, getUserRole } from '../lib/auth';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
}

const { title } = Astro.props;
const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);
const currentPath = Astro.url.pathname;

// Helper function to check if a nav link is active
// For home page, only match exact path
// For other pages, match if path starts with the nav link (to include detail pages)
function isActiveLink(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath === href || currentPath.startsWith(href + '/');
}

// Role-based access control
// Everyone can VIEW all pages except users (admin-only)
const canAccessUsers = userRole === 'admin';
// Edit permissions: admin and dungeonmaster can edit everything, player can edit content
const canEditContent = userRole === 'player' || userRole === 'dungeonmaster' || userRole === 'admin';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} - Arandor Companion</title>
    <ViewTransitions />
    <script is:inline>
      // Initialize dark mode before page renders to avoid flash
      const getThemePreference = () => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored) return stored;
        } catch (e) {
          // localStorage might not be available in private browsing mode
          console.warn('localStorage not available:', e);
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      
      const theme = getThemePreference();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-gray-50 dark:bg-black text-gray-900 dark:text-gray-100 transition-colors">
    <!-- Loading indicator for page transitions -->
    <div id="loading-indicator" class="hidden fixed inset-0 bg-black/20 dark:bg-black/40 z-[9999] flex items-center justify-center backdrop-blur-sm">
      <div class="loading-spinner"></div>
    </div>
    
    <nav class="bg-primary text-white shadow-lg dark:bg-black dark:border-b dark:border-gray-900 relative z-50" transition:persist>
      <div class="container mx-auto px-4 py-4">
        <div class="flex items-center justify-between">
          <a href="/" class="text-xl sm:text-2xl font-bold hover:text-secondary-200 transition">Arandor Companion</a>
          
          <!-- Mobile menu button -->
          <button 
            id="mobileMenuBtn" 
            class="lg:hidden text-white hover:text-secondary-200 transition p-2"
            aria-label="Toggle menu"
          >
            <svg id="menuIcon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg id="closeIcon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
          
          <!-- Desktop menu -->
          <div class="hidden lg:flex gap-6 items-center">
            <a href="/" class:list={["hover:text-secondary-200 transition", { "text-secondary-300 font-semibold": isActiveLink('/') && currentPath === '/' }]}>Dashboard</a>
            <a href="/diary" class:list={["hover:text-secondary-200 transition", { "text-secondary-300 font-semibold": isActiveLink('/diary') }]}>Diary</a>
            <a href="/library" class:list={["hover:text-secondary-200 transition", { "text-secondary-300 font-semibold": isActiveLink('/library') }]}>Library</a>
            <a href="/characters" class:list={["hover:text-secondary-200 transition", { "text-secondary-300 font-semibold": isActiveLink('/characters') }]}>Characters</a>
            <a href="/npcs" class:list={["hover:text-secondary-200 transition", { "text-secondary-300 font-semibold": isActiveLink('/npcs') }]}>NPCs</a>
            <a href="/locations" class:list={["hover:text-secondary-200 transition", { "text-secondary-300 font-semibold": isActiveLink('/locations') }]}>Locations</a>
            <a href="/map" data-astro-reload class:list={["hover:text-secondary-200 transition", { "text-secondary-300 font-semibold": isActiveLink('/map') }]}>Map</a>
            <a href="/quests" class:list={["hover:text-secondary-200 transition", { "text-secondary-300 font-semibold": isActiveLink('/quests') }]}>Quests</a>
            {canAccessUsers && <a href="/users" class:list={["hover:text-secondary-200 transition", { "text-secondary-300 font-semibold": isActiveLink('/users') }]}>Users</a>}
            
            <!-- Dark mode toggle -->
            <button 
              id="themeToggle"
              class="p-2 rounded-lg hover:bg-primary-700 dark:hover:bg-gray-700 transition"
              aria-label="Toggle dark mode"
            >
              <svg id="sunIcon" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
              <svg id="moonIcon" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
              </svg>
            </button>
            
            {isLoggedIn ? (
              <button 
                id="logoutBtn"
                class="bg-primary-800 hover:bg-primary-900 dark:bg-primary-900 dark:hover:bg-primary-800 px-4 py-2 rounded-lg transition"
              >
                Logout
              </button>
            ) : (
              <a href="/login" class="bg-primary-800 hover:bg-primary-900 dark:bg-primary-900 dark:hover:bg-primary-800 px-4 py-2 rounded-lg transition">
                Login
              </a>
            )}
          </div>
        </div>
        
        <!-- Mobile menu -->
        <div id="mobileMenu" class="hidden lg:hidden mt-4 pb-4">
          <div class="flex flex-col gap-3">
            <a href="/" class:list={["hover:text-secondary-200 transition py-2 px-4 rounded hover:bg-primary-700 dark:hover:bg-gray-700", { "text-secondary-300 font-semibold bg-primary-700 dark:bg-gray-700": currentPath === '/' }]}>Dashboard</a>
            <a href="/diary" class:list={["hover:text-secondary-200 transition py-2 px-4 rounded hover:bg-primary-700 dark:hover:bg-gray-700", { "text-secondary-300 font-semibold bg-primary-700 dark:bg-gray-700": isActiveLink('/diary') }]}>Diary</a>
            <a href="/library" class:list={["hover:text-secondary-200 transition py-2 px-4 rounded hover:bg-primary-700 dark:hover:bg-gray-700", { "text-secondary-300 font-semibold bg-primary-700 dark:bg-gray-700": isActiveLink('/library') }]}>Library</a>
            <a href="/characters" class:list={["hover:text-secondary-200 transition py-2 px-4 rounded hover:bg-primary-700 dark:hover:bg-gray-700", { "text-secondary-300 font-semibold bg-primary-700 dark:bg-gray-700": isActiveLink('/characters') }]}>Characters</a>
            <a href="/npcs" class:list={["hover:text-secondary-200 transition py-2 px-4 rounded hover:bg-primary-700 dark:hover:bg-gray-700", { "text-secondary-300 font-semibold bg-primary-700 dark:bg-gray-700": isActiveLink('/npcs') }]}>NPCs</a>
            <a href="/locations" class:list={["hover:text-secondary-200 transition py-2 px-4 rounded hover:bg-primary-700 dark:hover:bg-gray-700", { "text-secondary-300 font-semibold bg-primary-700 dark:bg-gray-700": isActiveLink('/locations') }]}>Locations</a>
            <a href="/map" data-astro-reload class:list={["hover:text-secondary-200 transition py-2 px-4 rounded hover:bg-primary-700 dark:hover:bg-gray-700", { "text-secondary-300 font-semibold bg-primary-700 dark:bg-gray-700": isActiveLink('/map') }]}>Map</a>
            <a href="/quests" class:list={["hover:text-secondary-200 transition py-2 px-4 rounded hover:bg-primary-700 dark:hover:bg-gray-700", { "text-secondary-300 font-semibold bg-primary-700 dark:bg-gray-700": isActiveLink('/quests') }]}>Quests</a>
            {canAccessUsers && <a href="/users" class:list={["hover:text-secondary-200 transition py-2 px-4 rounded hover:bg-primary-700 dark:hover:bg-gray-700", { "text-secondary-300 font-semibold bg-primary-700 dark:bg-gray-700": isActiveLink('/users') }]}>Users</a>}
            
            <!-- Dark mode toggle for mobile -->
            <button 
              id="themeToggleMobile"
              class="flex items-center gap-2 py-2 px-4 rounded hover:bg-primary-700 dark:hover:bg-gray-700 transition text-left"
              aria-label="Toggle dark mode"
            >
              <svg id="sunIconMobile" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
              <svg id="moonIconMobile" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
              </svg>
              <span id="themeTextMobile" class="dark:hidden">Dark Mode</span>
              <span id="themeTextMobile2" class="hidden dark:block">Light Mode</span>
            </button>
            
            {isLoggedIn ? (
              <button 
                id="logoutBtnMobile"
                class="bg-primary-800 hover:bg-primary-900 dark:bg-primary-900 dark:hover:bg-primary-800 px-4 py-2 rounded-lg transition text-left"
              >
                Logout
              </button>
            ) : (
              <a href="/login" class="bg-primary-800 hover:bg-primary-900 dark:bg-primary-900 dark:hover:bg-primary-800 px-4 py-2 rounded-lg transition">
                Login
              </a>
            )}
          </div>
        </div>
      </div>
    </nav>
    
    <main class="container mx-auto px-4 py-8 page-fade-in">
      <slot />
    </main>
    
    <footer class="bg-gray-200 text-gray-600 mt-16 py-8 dark:bg-black dark:border-t dark:border-gray-900" transition:persist>
      <div class="container mx-auto px-4 text-center">
        <p>&copy; 2025 Arandor Companion App. Track your D&D adventures.</p>
      </div>
    </footer>
    
    <script>
      // Function to get theme preference from localStorage
      const getThemePreference = () => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored) return stored;
        } catch (e) {
          console.warn('localStorage not available:', e);
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      
      // Function to apply theme
      const applyTheme = () => {
        const theme = getThemePreference();
        const html = document.documentElement;
        if (theme === 'dark') {
          html.classList.add('dark');
        } else {
          html.classList.remove('dark');
        }
      };
      
      // Dark mode toggle functionality
      const toggleTheme = () => {
        const html = document.documentElement;
        const isDark = html.classList.contains('dark');
        
        if (isDark) {
          html.classList.remove('dark');
          try {
            localStorage.setItem('theme', 'light');
          } catch (e) {
            console.warn('Failed to save theme preference:', e);
          }
        } else {
          html.classList.add('dark');
          try {
            localStorage.setItem('theme', 'dark');
          } catch (e) {
            console.warn('Failed to save theme preference:', e);
          }
        }
      };
      
      // Function to close mobile menu
      const closeMobileMenu = () => {
        const mobileMenu = document.getElementById('mobileMenu');
        const menuIcon = document.getElementById('menuIcon');
        const closeIcon = document.getElementById('closeIcon');
        
        if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
          mobileMenu.classList.add('hidden');
          menuIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        }
      };
      
      // Function to update navigation active states
      const updateNavigation = () => {
        const currentPath = window.location.pathname;
        const navLinks = document.querySelectorAll('nav a[href^="/"]');
        
        navLinks.forEach(link => {
          const href = link.getAttribute('href');
          if (!href) return;
          
          // Check if link is active
          const isActive = href === '/' 
            ? currentPath === '/' 
            : currentPath === href || currentPath.startsWith(href + '/');
          
          // Update classes
          if (isActive) {
            link.classList.add('text-secondary-300', 'font-semibold');
            if (link.classList.contains('py-2')) { // Mobile menu item
              link.classList.add('bg-primary-700');
              if (document.documentElement.classList.contains('dark')) {
                link.classList.add('dark:bg-gray-700');
              }
            }
          } else {
            link.classList.remove('text-secondary-300', 'font-semibold', 'bg-primary-700', 'dark:bg-gray-700');
          }
        });
      };
      
      // Initialize on first load
      const init = () => {
        // Check if nav has already been initialized (for persisted elements)
        const nav = document.querySelector('nav');
        if (nav?.dataset.initialized === 'true') {
          // Just update navigation states, don't re-attach listeners
          updateNavigation();
          return;
        }
        
        const themeToggle = document.getElementById('themeToggle');
        const themeToggleMobile = document.getElementById('themeToggleMobile');
        
        themeToggle?.addEventListener('click', toggleTheme);
        themeToggleMobile?.addEventListener('click', toggleTheme);
        
        // Mobile menu toggle
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        const menuIcon = document.getElementById('menuIcon');
        const closeIcon = document.getElementById('closeIcon');
        
        mobileMenuBtn?.addEventListener('click', () => {
          mobileMenu?.classList.toggle('hidden');
          menuIcon?.classList.toggle('hidden');
          closeIcon?.classList.toggle('hidden');
        });
        
        // Close mobile menu when clicking on navigation links
        const mobileMenuLinks = mobileMenu?.querySelectorAll('a[href^="/"]');
        mobileMenuLinks?.forEach(link => {
          link.addEventListener('click', () => {
            closeMobileMenu();
          });
        });
        
        // Logout handlers
        const handleLogout = async () => {
          try {
            const response = await fetch('/api/auth/logout', {
              method: 'POST',
            });
            
            if (response.ok) {
              window.location.href = '/';
            }
          } catch (error) {
            console.error('Logout failed:', error);
          }
        };
        
        const logoutBtn = document.getElementById('logoutBtn');
        const logoutBtnMobile = document.getElementById('logoutBtnMobile');
        
        logoutBtn?.addEventListener('click', handleLogout);
        logoutBtnMobile?.addEventListener('click', handleLogout);
        
        // Mark nav as initialized
        if (nav) nav.dataset.initialized = 'true';
        
        // Update navigation active states
        updateNavigation();
      };
      
      // Detect navigation direction and type
      let lastPath = window.location.pathname;
      
      const getNavigationType = (fromPath, toPath) => {
        // Detail page patterns (going to a detail page)
        const isToDetail = /\/(characters|npcs|locations|diary|library|quests)\/[^/]+$/.test(toPath);
        const isFromDetail = /\/(characters|npcs|locations|diary|library|quests)\/[^/]+$/.test(fromPath);
        
        // Going from list to detail (zoom in)
        if (!isFromDetail && isToDetail) {
          return 'zoom-in';
        }
        
        // Going from detail to list (zoom back)
        if (isFromDetail && !isToDetail) {
          return 'zoom-back';
        }
        
        // Lateral navigation between similar pages
        const mainPages = ['/', '/diary', '/library', '/characters', '/npcs', '/locations', '/map', '/quests'];
        const fromIndex = mainPages.indexOf(fromPath);
        const toIndex = mainPages.indexOf(toPath);
        
        if (fromIndex !== -1 && toIndex !== -1 && fromIndex !== toIndex) {
          return toIndex > fromIndex ? 'slide-left' : 'slide-right';
        }
        
        return 'fade';
      };
      
      // Apply transition classes before navigation
      document.addEventListener('astro:before-preparation', (event) => {
        // Close mobile menu when navigation starts
        closeMobileMenu();
        
        const loader = document.getElementById('loading-indicator');
        if (loader) loader.classList.remove('hidden');
        
        const toPath = event.newDocument?.location?.pathname || window.location.pathname;
        const fromPath = lastPath;
        const transitionType = getNavigationType(fromPath, toPath);
        
        // Apply transition class to root
        const root = document.documentElement;
        
        // Remove all transition classes
        root.classList.remove('zoom-out', 'zoom-in', 'zoom-back', 'zoom-back-in', 'slide-left', 'slide-right');
        
        // Add appropriate transition class
        if (transitionType === 'zoom-in') {
          document.documentElement.dataset.transition = 'zoom';
        } else if (transitionType === 'zoom-back') {
          document.documentElement.dataset.transition = 'zoom-back';
        } else if (transitionType === 'slide-left') {
          document.documentElement.dataset.transition = 'slide-left';
        } else if (transitionType === 'slide-right') {
          document.documentElement.dataset.transition = 'slide-right';
        }
      });
      
      document.addEventListener('astro:after-swap', () => {
        const loader = document.getElementById('loading-indicator');
        if (loader) loader.classList.add('hidden');
        
        // Update last path
        lastPath = window.location.pathname;
        
        // Reapply theme after page swap
        applyTheme();
        
        // Update navigation active states after page swap
        updateNavigation();
        
        // Clear transition data attribute
        setTimeout(() => {
          delete document.documentElement.dataset.transition;
        }, 500);
      });
      
      // Run on page load (includes first load and after view transitions)
      document.addEventListener('astro:page-load', () => {
        init();
        lastPath = window.location.pathname;
      });
    </script>
  </body>
</html>

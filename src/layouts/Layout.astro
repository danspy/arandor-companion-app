    <!-- Android/Chrome -->
    <meta name="mobile-web-app-capable" content="yes" />
    
    <title>{title} - Arandor Companion</title>
    <ClientRouter />
    <script is:inline>
      // Initialize dark mode before page renders to avoid flash
      const getThemePreference = () => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored) return stored;
        } catch (e) {
          // localStorage might not be available in private browsing mode
          console.warn('localStorage not available:', e);
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      
      const theme = getThemePreference();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-gray-50 dark:bg-black text-gray-900 dark:text-gray-100 transition-colors">
    <!-- Loading indicator for page transitions -->
    <div id="loading-indicator" class="hidden fixed inset-0 bg-black/20 dark:bg-black/40 z-[9999] flex items-center justify-center backdrop-blur-sm">

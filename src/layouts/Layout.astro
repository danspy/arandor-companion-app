              </svg>
              <svg id="moonIconMobile" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
              </svg>
              <span id="themeTextMobile" class="dark:hidden">Dark Mode</span>
              <span id="themeTextMobile2" class="hidden dark:block">Light Mode</span>
            </button>
            
            <!-- User/Auth Accordion for mobile -->
            <div class="border-t border-primary-700 dark:border-gray-700 pt-3 mt-3">
              <button 
                id="userMenuBtnMobile"
                class="flex items-center justify-between w-full py-2 px-4 rounded hover:bg-primary-700 dark:hover:bg-gray-700 transition text-left"
                aria-label="User menu"
              >
                <span class="flex items-center gap-2">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                  </svg>
                  <span>Account</span>
                </span>
                <svg id="accordionIconMobile" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              
              <!-- Accordion content -->
              <div id="userAccordionMobile" class="hidden pl-4 mt-2 space-y-2">
                {!isLoggedIn ? (
                  <a href="/login" class="block py-2 px-4 rounded hover:bg-primary-700 dark:hover:bg-gray-700 transition">
                    Login
                  </a>
                ) : (
                  <>
                    <a href="/profile" class="block py-2 px-4 rounded hover:bg-primary-700 dark:hover:bg-gray-700 transition">
                      Profile
                    </a>
                    {canAccessUsers && (
                      <a href="/users" class="block py-2 px-4 rounded hover:bg-primary-700 dark:hover:bg-gray-700 transition">
                        Users
                      </a>
                    )}
                    <button 
                      id="logoutBtnMobile"
                      class="w-full text-left py-2 px-4 rounded hover:bg-primary-700 dark:hover:bg-gray-700 transition"
                    >
                      Logout
                    </button>

---
import '../styles/global.css';
import { isAuthenticated, getUserRole } from '../lib/auth';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
}

const { title } = Astro.props;
const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);
const currentPath = Astro.url.pathname;

// Helper function to check if a nav link is active
// For home page, only match exact path
// For other pages, match if path starts with the nav link (to include detail pages)
function isActiveLink(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath === href || currentPath.startsWith(href + '/');
}

// Role-based access control
// Everyone can VIEW all pages except users (admin-only)
const canAccessUsers = userRole === 'admin';
// Edit permissions: admin and dungeonmaster can edit everything, player can edit content
const canEditContent = userRole === 'player' || userRole === 'dungeonmaster' || userRole === 'admin';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="A D&D companion app for tracking adventures, characters, NPCs, locations, and more" />
    

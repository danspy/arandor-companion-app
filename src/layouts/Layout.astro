---
import '../styles/global.css';
import { isAuthenticated, getUserRole } from '../lib/auth';
import { ClientRouter } from 'astro:transitions';
import PWAFloatingMenu from '../components/PWAFloatingMenu.astro';
import PWAQuickAccess from '../components/PWAQuickAccess.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);
const currentPath = Astro.url.pathname;

// Helper function to check if a nav link is active
// For home page, only match exact path
// For other pages, match if path starts with the nav link (to include detail pages)
function isActiveLink(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath === href || currentPath.startsWith(href + '/');
}

// Role-based access control
// Everyone can VIEW all pages except users (admin-only)
const canAccessUsers = userRole === 'admin';
// Edit permissions: admin and dungeonmaster can edit everything, player can edit content
const canEditContent = userRole === 'player' || userRole === 'dungeonmaster' || userRole === 'admin';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="A D&D companion app for tracking adventures, characters, NPCs, locations, and more" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    
    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.webmanifest" />
    
    <!-- Theme Colors -->
    <meta name="theme-color" content="#1e1408" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#080603" media="(prefers-color-scheme: dark)" />
    
    <!-- Apple Touch Icons -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/icons/apple-touch-icon-120x120.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/icons/apple-touch-icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="167x167" href="/icons/apple-touch-icon-167x167.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon-180x180.png" />
    
    <!-- iOS Meta Tags -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Arandor" />
    
    <!-- iOS Splash Screens (Light Mode) -->
    <link rel="apple-touch-startup-image" media="screen and (device-width: 320px) and (device-height: 568px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait) and (prefers-color-scheme: light)" href="/splash/apple-splash-iphone5.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 375px) and (device-height: 667px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait) and (prefers-color-scheme: light)" href="/splash/apple-splash-iphone6.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 414px) and (device-height: 736px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait) and (prefers-color-scheme: light)" href="/splash/apple-splash-iphone6plus.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 375px) and (device-height: 812px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait) and (prefers-color-scheme: light)" href="/splash/apple-splash-iphonex.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait) and (prefers-color-scheme: light)" href="/splash/apple-splash-iphonexsmax.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait) and (prefers-color-scheme: light)" href="/splash/apple-splash-iphonexr.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 390px) and (device-height: 844px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait) and (prefers-color-scheme: light)" href="/splash/apple-splash-iphone12.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 428px) and (device-height: 926px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait) and (prefers-color-scheme: light)" href="/splash/apple-splash-iphone12promax.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 768px) and (device-height: 1024px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait) and (prefers-color-scheme: light)" href="/splash/apple-splash-ipadmini.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 834px) and (device-height: 1112px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait) and (prefers-color-scheme: light)" href="/splash/apple-splash-ipadair.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 834px) and (device-height: 1194px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait) and (prefers-color-scheme: light)" href="/splash/apple-splash-ipadpro10.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 1024px) and (device-height: 1366px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait) and (prefers-color-scheme: light)" href="/splash/apple-splash-ipadpro12.png" />
    
    <!-- iOS Splash Screens (Dark Mode) -->
    <link rel="apple-touch-startup-image" media="screen and (device-width: 320px) and (device-height: 568px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait) and (prefers-color-scheme: dark)" href="/splash/apple-splash-iphone5-dark.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 375px) and (device-height: 667px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait) and (prefers-color-scheme: dark)" href="/splash/apple-splash-iphone6-dark.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 414px) and (device-height: 736px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait) and (prefers-color-scheme: dark)" href="/splash/apple-splash-iphone6plus-dark.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 375px) and (device-height: 812px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait) and (prefers-color-scheme: dark)" href="/splash/apple-splash-iphonex-dark.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait) and (prefers-color-scheme: dark)" href="/splash/apple-splash-iphonexsmax-dark.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait) and (prefers-color-scheme: dark)" href="/splash/apple-splash-iphonexr-dark.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 390px) and (device-height: 844px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait) and (prefers-color-scheme: dark)" href="/splash/apple-splash-iphone12-dark.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 428px) and (device-height: 926px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait) and (prefers-color-scheme: dark)" href="/splash/apple-splash-iphone12promax-dark.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 768px) and (device-height: 1024px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait) and (prefers-color-scheme: dark)" href="/splash/apple-splash-ipadmini-dark.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 834px) and (device-height: 1112px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait) and (prefers-color-scheme: dark)" href="/splash/apple-splash-ipadair-dark.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 834px) and (device-height: 1194px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait) and (prefers-color-scheme: dark)" href="/splash/apple-splash-ipadpro10-dark.png" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 1024px) and (device-height: 1366px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait) and (prefers-color-scheme: dark)" href="/splash/apple-splash-ipadpro12-dark.png" />
    
    <!-- Android/Chrome -->
    <meta name="mobile-web-app-capable" content="yes" />
    
    <title>{title} - Arandor Companion</title>
    <ClientRouter />
    <script is:inline>
      // Initialize dark mode before page renders to avoid flash
      const getThemePreference = () => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored) return stored;
        } catch (e) {
          // localStorage might not be available in private browsing mode
          console.warn('localStorage not available:', e);
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      
      const theme = getThemePreference();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body>
    <!-- PWA Status Bar Gradient Overlay -->
    <div class="pwa-status-bar-gradient" aria-hidden="true"></div>
    
    <!-- Loading indicator for page transitions -->
    <div id="loading-indicator" class="hidden fixed inset-0 bg-black/20 dark:bg-black/40 z-[9999] flex items-center justify-center backdrop-blur-sm">
      <div class="loading-spinner"></div>
    </div>
    
    <!-- ── Navigation ─────────────────────────────────────────── -->
    <nav class="app-nav sticky top-0 pwa-hide-nav" transition:persist>
      <div class="container mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between h-[60px]">

          <!-- Brand — Cormorant italic -->
          <a
            href="/"
            class="font-display italic font-semibold text-xl sm:text-2xl tracking-wide leading-none"
            style="color: var(--gold); text-shadow: 0 0 20px rgba(201,144,50,0.30);"
            data-testid="nav-brand"
          >Arandor</a>

          <!-- Mobile toggle -->
          <button
            id="mobileMenuBtn"
            class="lg:hidden p-2 -mr-1 rounded transition-colors"
            style="color: rgba(242,232,213,0.5);"
            aria-label="Toggle menu"
            data-testid="mobile-menu-btn"
          >
            <svg id="menuIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            <svg id="closeIcon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>

          <!-- Desktop nav links -->
          <div class="hidden lg:flex items-center gap-0.5" data-testid="desktop-nav">
            {[
              { href: '/diary',      label: 'Diary'      },
              { href: '/library',    label: 'Library'    },
              { href: '/characters', label: 'Characters' },
              { href: '/npcs',       label: 'NPCs'       },
              { href: '/locations',  label: 'Locations'  },
              { href: '/map',        label: 'Map', reload: true },
              { href: '/quests',     label: 'Quests'     },
            ].map(({ href, label, reload }) => (
              <a
                href={href}
                {...(reload ? { 'data-astro-reload': true } : {})}
                class:list={[
                  "nav-link px-3 py-1.5 text-sm rounded-md transition-all duration-200",
                  isActiveLink(href) ? "nav-link-active" : "nav-link-inactive"
                ]}
              >{label}</a>
            ))}
            {isLoggedIn && (
              <a
                href="/tools"
                class:list={[
                  "nav-link px-3 py-1.5 text-sm rounded-md transition-all duration-200",
                  isActiveLink('/tools') ? "nav-link-active" : "nav-link-inactive"
                ]}
              >Tools</a>
            )}

            <span class="w-px h-4 mx-2 shrink-0" style="background: rgba(201,144,50,0.18);"></span>

            <!-- Theme toggle -->
            <button
              id="themeToggle"
              class="p-2 rounded-md transition-colors"
              style="color: rgba(242,232,213,0.4);"
              aria-label="Toggle dark mode"
              data-testid="theme-toggle"
            >
              <svg id="sunIcon" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
              </svg>
              <svg id="moonIcon" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
              </svg>
            </button>

            <!-- User dropdown -->
            <div class="relative">
              <button
                id="userMenuBtn"
                class="p-2 rounded-md transition-colors"
                style="color: rgba(242,232,213,0.4);"
                aria-label="User menu"
                data-testid="user-menu-btn"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                </svg>
              </button>
              <div
                id="userDropdown"
                class="hidden absolute right-0 mt-2 w-44 rounded-xl shadow-2xl border py-1.5 z-50"
                style="background: var(--bg-raised); border-color: var(--border-gold);"
              >
                {!isLoggedIn ? (
                  <a href="/login" class="block px-4 py-2.5 text-sm transition-colors hover:text-[var(--accent)]" style="color: var(--text-body);">Login</a>
                ) : (
                  <>
                    <a href="/profile" class="block px-4 py-2.5 text-sm transition-colors hover:text-[var(--accent)]" style="color: var(--text-body);">Profile</a>
                    {canAccessUsers && (
                      <a href="/users" class="block px-4 py-2.5 text-sm transition-colors hover:text-[var(--accent)]" style="color: var(--text-body);">Users</a>
                    )}
                    <div class="my-1" style="border-top: 1px solid var(--border);"></div>
                    <button
                      id="logoutBtn"
                      class="w-full text-left px-4 py-2.5 text-sm transition-colors hover:text-[var(--accent)]"
                      style="color: var(--text-muted);"
                    >Logout</button>
                  </>
                )}
              </div>
            </div>
          </div>
        </div>

        <!-- Mobile menu -->
        <div id="mobileMenu" class="hidden lg:hidden py-3" style="border-top: 1px solid rgba(201,144,50,0.12);">
          <div class="flex flex-col gap-0.5">
            {[
              { href: '/diary',      label: 'Diary'      },
              { href: '/library',    label: 'Library'    },
              { href: '/characters', label: 'Characters' },
              { href: '/npcs',       label: 'NPCs'       },
              { href: '/locations',  label: 'Locations'  },
              { href: '/map',        label: 'Map', reload: true },
              { href: '/quests',     label: 'Quests'     },
            ].map(({ href, label, reload }) => (
              <a
                href={href}
                {...(reload ? { 'data-astro-reload': true } : {})}
                class:list={[
                  "nav-link px-3 py-2.5 text-sm rounded-md transition-all duration-200",
                  isActiveLink(href) ? "nav-link-active" : "nav-link-inactive"
                ]}
              >{label}</a>
            ))}
            {isLoggedIn && (
              <a
                href="/tools"
                class:list={[
                  "nav-link px-3 py-2.5 text-sm rounded-md transition-all duration-200",
                  isActiveLink('/tools') ? "nav-link-active" : "nav-link-inactive"
                ]}
              >Tools</a>
            )}

            <div class="my-2" style="border-top: 1px solid rgba(201,144,50,0.10);"></div>

            <button
              id="themeToggleMobile"
              class="flex items-center gap-3 px-3 py-2.5 text-sm rounded-md transition-colors text-left"
              style="color: rgba(242,232,213,0.45);"
              aria-label="Toggle dark mode"
            >
              <svg id="sunIconMobile" class="w-4 h-4 hidden dark:block shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
              </svg>
              <svg id="moonIconMobile" class="w-4 h-4 block dark:hidden shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
              </svg>
              <span id="themeTextMobile" class="dark:hidden">Dark Mode</span>
              <span id="themeTextMobile2" class="hidden dark:block">Light Mode</span>
            </button>

            <button
              id="userMenuBtnMobile"
              class="flex items-center justify-between w-full px-3 py-2.5 text-sm rounded-md transition-colors text-left"
              style="color: rgba(242,232,213,0.45);"
              aria-label="User menu"
            >
              <span class="flex items-center gap-3">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                </svg>
                Account
              </span>
              <svg id="accordionIconMobile" class="w-3.5 h-3.5 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <div id="userAccordionMobile" class="hidden pl-3 space-y-0.5">
              {!isLoggedIn ? (
                <a href="/login" class="block px-3 py-2.5 text-sm rounded-md transition-colors hover:text-[var(--accent)]" style="color: var(--text-muted);">Login</a>
              ) : (
                <>
                  <a href="/profile" class="block px-3 py-2.5 text-sm rounded-md transition-colors hover:text-[var(--accent)]" style="color: var(--text-muted);">Profile</a>
                  {canAccessUsers && (
                    <a href="/users" class="block px-3 py-2.5 text-sm rounded-md transition-colors hover:text-[var(--accent)]" style="color: var(--text-muted);">Users</a>
                  )}
                  <button id="logoutBtnMobile" class="w-full text-left px-3 py-2.5 text-sm rounded-md transition-colors hover:text-[var(--accent)]" style="color: var(--text-muted);">Logout</button>
                </>
              )}
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="container mx-auto px-4 sm:px-6 py-8 page-fade-in">
      <slot />
    </main>

    <footer class="mt-20 py-8 pwa-hide-footer" style="border-top: 1px solid var(--border);" transition:persist>
      <div class="container mx-auto px-4 sm:px-6 text-center">
        <p class="font-display italic text-sm" style="color: var(--text-faint); letter-spacing: 0.04em;">
          Arandor Companion &mdash; Chronicle your adventures
        </p>
      </div>
    </footer>
    
    <!-- PWA Floating Menu (only shown in standalone mode) -->
    <PWAFloatingMenu 
      currentPath={currentPath}
      isLoggedIn={isLoggedIn}
      canAccessUsers={canAccessUsers}
    />
    
    <!-- PWA Quick Access Buttons (only shown in standalone mode for logged-in users) -->
    {isLoggedIn && <PWAQuickAccess />}
    
    <script>
      // Function to get theme preference from localStorage
      const getThemePreference = () => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored) return stored;
        } catch (e) {
          console.warn('localStorage not available:', e);
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      
      // Function to apply theme
      const applyTheme = () => {
        const theme = getThemePreference();
        const html = document.documentElement;
        if (theme === 'dark') {
          html.classList.add('dark');
        } else {
          html.classList.remove('dark');
        }
      };
      
      // Dark mode toggle functionality
      const toggleTheme = () => {
        const html = document.documentElement;
        const isDark = html.classList.contains('dark');
        
        if (isDark) {
          html.classList.remove('dark');
          try {
            localStorage.setItem('theme', 'light');
          } catch (e) {
            console.warn('Failed to save theme preference:', e);
          }
        } else {
          html.classList.add('dark');
          try {
            localStorage.setItem('theme', 'dark');
          } catch (e) {
            console.warn('Failed to save theme preference:', e);
          }
        }
      };
      
      // Function to close mobile menu
      const closeMobileMenu = () => {
        const mobileMenu = document.getElementById('mobileMenu');
        const menuIcon = document.getElementById('menuIcon');
        const closeIcon = document.getElementById('closeIcon');
        
        if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
          mobileMenu.classList.add('hidden');
          menuIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        }
      };
      
      // Function to update navigation active states
      const updateNavigation = () => {
        const currentPath = window.location.pathname;
        const navLinks = document.querySelectorAll('nav a.nav-link[href^="/"]');

        navLinks.forEach(link => {
          const href = link.getAttribute('href');
          if (!href) return;

          const isActive = href === '/'
            ? currentPath === '/'
            : currentPath === href || currentPath.startsWith(href + '/');

          if (isActive) {
            link.classList.remove('nav-link-inactive');
            link.classList.add('nav-link-active');
          } else {
            link.classList.remove('nav-link-active');
            link.classList.add('nav-link-inactive');
          }
        });
      };
      
      // Initialize on first load
      const init = () => {
        // Check if nav has already been initialized (for persisted elements)
        const nav = document.querySelector('nav');
        if (nav?.dataset.initialized === 'true') {
          // Just update navigation states, don't re-attach listeners
          updateNavigation();
          return;
        }
        
        const themeToggle = document.getElementById('themeToggle');
        const themeToggleMobile = document.getElementById('themeToggleMobile');
        
        themeToggle?.addEventListener('click', toggleTheme);
        themeToggleMobile?.addEventListener('click', toggleTheme);
        
        // Desktop user menu dropdown
        const userMenuBtn = document.getElementById('userMenuBtn');
        const userDropdown = document.getElementById('userDropdown');
        
        userMenuBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          userDropdown?.classList.toggle('hidden');
        });
        
        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
          if (userDropdown && !userDropdown.contains(e.target as Node) && !userMenuBtn?.contains(e.target as Node)) {
            userDropdown.classList.add('hidden');
          }
        });
        
        // Mobile user menu accordion
        const userMenuBtnMobile = document.getElementById('userMenuBtnMobile');
        const userAccordionMobile = document.getElementById('userAccordionMobile');
        const accordionIconMobile = document.getElementById('accordionIconMobile');
        
        userMenuBtnMobile?.addEventListener('click', () => {
          userAccordionMobile?.classList.toggle('hidden');
          accordionIconMobile?.classList.toggle('rotate-180');
        });
        
        // Mobile menu toggle
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        const menuIcon = document.getElementById('menuIcon');
        const closeIcon = document.getElementById('closeIcon');
        
        mobileMenuBtn?.addEventListener('click', () => {
          mobileMenu?.classList.toggle('hidden');
          menuIcon?.classList.toggle('hidden');
          closeIcon?.classList.toggle('hidden');
        });
        
        // Close mobile menu when clicking on navigation links
        const mobileMenuLinks = mobileMenu?.querySelectorAll('a[href^="/"]');
        mobileMenuLinks?.forEach(link => {
          link.addEventListener('click', () => {
            closeMobileMenu();
          });
        });
        
        // Logout handlers
        const handleLogout = async () => {
          try {
            const response = await fetch('/api/auth/logout', {
              method: 'POST',
            });
            
            if (response.ok) {
              window.location.href = '/';
            }
          } catch (error) {
            console.error('Logout failed:', error);
          }
        };
        
        const logoutBtn = document.getElementById('logoutBtn');
        const logoutBtnMobile = document.getElementById('logoutBtnMobile');
        
        logoutBtn?.addEventListener('click', handleLogout);
        logoutBtnMobile?.addEventListener('click', handleLogout);
        
        // Mark nav as initialized
        if (nav) nav.dataset.initialized = 'true';
        
        // Update navigation active states
        updateNavigation();
      };
      
      // Detect navigation direction and type
      let lastPath = window.location.pathname;
      
      const getNavigationType = (fromPath, toPath) => {
        // Detail page patterns (going to a detail page)
        const isToDetail = /\/(characters|npcs|locations|diary|library|quests)\/[^/]+$/.test(toPath);
        const isFromDetail = /\/(characters|npcs|locations|diary|library|quests)\/[^/]+$/.test(fromPath);
        
        // Going from list to detail (zoom in)
        if (!isFromDetail && isToDetail) {
          return 'zoom-in';
        }
        
        // Going from detail to list (zoom back)
        if (isFromDetail && !isToDetail) {
          return 'zoom-back';
        }
        
        // Lateral navigation between similar pages
        const mainPages = ['/', '/diary', '/library', '/characters', '/npcs', '/locations', '/map', '/quests'];
        const fromIndex = mainPages.indexOf(fromPath);
        const toIndex = mainPages.indexOf(toPath);
        
        if (fromIndex !== -1 && toIndex !== -1 && fromIndex !== toIndex) {
          return toIndex > fromIndex ? 'slide-left' : 'slide-right';
        }
        
        return 'fade';
      };
      
      // Apply transition classes before navigation
      document.addEventListener('astro:before-preparation', (event) => {
        // Close mobile menu when navigation starts
        closeMobileMenu();
        
        const loader = document.getElementById('loading-indicator');
        if (loader) loader.classList.remove('hidden');
        
        const toPath = event.newDocument?.location?.pathname || window.location.pathname;
        const fromPath = lastPath;
        const transitionType = getNavigationType(fromPath, toPath);
        
        // Apply transition class to root
        const root = document.documentElement;
        
        // Remove all transition classes
        root.classList.remove('zoom-out', 'zoom-in', 'zoom-back', 'zoom-back-in', 'slide-left', 'slide-right');
        
        // Add appropriate transition class
        if (transitionType === 'zoom-in') {
          document.documentElement.dataset.transition = 'zoom';
        } else if (transitionType === 'zoom-back') {
          document.documentElement.dataset.transition = 'zoom-back';
        } else if (transitionType === 'slide-left') {
          document.documentElement.dataset.transition = 'slide-left';
        } else if (transitionType === 'slide-right') {
          document.documentElement.dataset.transition = 'slide-right';
        }
      });
      
      document.addEventListener('astro:after-swap', () => {
        const loader = document.getElementById('loading-indicator');
        if (loader) loader.classList.add('hidden');
        
        // Update last path
        lastPath = window.location.pathname;
        
        // Reapply theme after page swap
        applyTheme();
        
        // Update navigation active states after page swap
        updateNavigation();
        
        // Clear transition data attribute
        setTimeout(() => {
          delete document.documentElement.dataset.transition;
        }, 500);
      });
      
      // Run on page load (includes first load and after view transitions)
      document.addEventListener('astro:page-load', () => {
        init();
        lastPath = window.location.pathname;
      });
    </script>
  </body>
</html>

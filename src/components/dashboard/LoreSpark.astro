---
// "Do you remember…?" — a random NPC, location or library entry, shuffled per visit.
export interface LoreItem {
  kind: 'NPC' | 'Location' | 'Library';
  title: string;
  subtitle: string;
  text: string;
  href: string;
  imageUrl: string | null;
}

interface Props {
  items: LoreItem[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <div class="lore t-panel p-5" data-lore>
    <div class="flex items-center justify-between mb-3">
      <h2 class="t-section-h text-lg">Do you remember…?</h2>
      {items.length > 1 && (
        <button type="button" class="lore-next" data-lore-next title="Another memory" aria-label="Show another memory">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12a9 9 0 1 1-3-6.7L21 8" /><path d="M21 3v5h-5" />
          </svg>
        </button>
      )}
    </div>
    {items.map((item, i) => (
      <a href={item.href} class="lore-item" data-lore-item hidden={i !== 0}>
        <div class="lore-portrait">
          {item.imageUrl ? (
            <img src={item.imageUrl} alt="" loading="lazy" />
          ) : (
            <span>{item.title.charAt(0)}</span>
          )}
        </div>
        <span class="t-badge lore-kind">{item.kind}</span>
        <h3 class="lore-title">{item.title}</h3>
        {item.subtitle && <p class="t-faint text-xs">{item.subtitle}</p>}
        <p class="t-muted text-sm mt-2 line-clamp-4">{item.text}</p>
      </a>
    ))}
  </div>
)}

<style>
  .lore { height: 100%; display: flex; flex-direction: column; }
  .lore-next {
    display: inline-flex;
    padding: 0.4rem;
    border-radius: 999px;
    color: var(--gold);
    border: 1px solid var(--border-gold);
    transition: transform 0.4s ease, background 0.15s ease;
  }
  .lore-next:hover { background: var(--accent-dim); transform: rotate(180deg); }
  .lore-item { display: flex; flex-direction: column; align-items: center; text-align: center; flex: 1; }
  .lore-item[hidden] { display: none; }
  .lore-item.enter { animation: lore-in 0.4s ease-out both; }
  @keyframes lore-in {
    from { opacity: 0; transform: translateY(6px) rotateX(20deg); }
    to   { opacity: 1; transform: none; }
  }
  .lore-portrait {
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 999px;
    overflow: hidden;
    border: 2px solid var(--border-gold);
    box-shadow: 0 0 24px var(--accent-glow);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--gold-dim);
    margin-bottom: 0.75rem;
  }
  .lore-portrait img { width: 100%; height: 100%; object-fit: cover; }
  .lore-portrait span { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 2.5rem; font-weight: 700; color: var(--gold); }
  .lore-kind { margin-bottom: 0.4rem; }
  .lore-title { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.4rem; font-weight: 700; color: var(--text-strong); line-height: 1.15; }
  .lore-item:hover .lore-title { color: var(--gold); }
  @media (prefers-reduced-motion: reduce) {
    .lore-item.enter { animation: none; }
    .lore-next:hover { transform: none; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-lore]');
    const next = root?.querySelector<HTMLButtonElement>('[data-lore-next]');
    if (!root || !next) return;
    const items = [...root.querySelectorAll<HTMLElement>('[data-lore-item]')];
    let index = 0;
    next.addEventListener('click', () => {
      items[index].hidden = true;
      index = (index + 1) % items.length;
      items[index].hidden = false;
      items[index].classList.remove('enter');
      void items[index].offsetWidth;
      items[index].classList.add('enter');
    });
  });
</script>

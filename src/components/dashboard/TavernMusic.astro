---
// Compact strip for the site playlist. Rendered on the server; the script below only wires playback.
// Visitors may play it; the Edit link is for admin and dungeonmaster.
import type { PlaylistWithTracks } from '../../lib/music/server';

interface Props {
  playlist: PlaylistWithTracks | null;
  canEdit: boolean;
}

const { playlist, canEdit } = Astro.props;
const tracks = playlist?.tracks ?? [];
const show = !!playlist && (tracks.length > 0 || canEdit);
const data = playlist
  ? { id: playlist.id, name: playlist.name, tracks: tracks.map((t) => ({ id: t.id, kind: t.kind, title: t.title, ref: t.ref })) }
  : null;
---

{show && playlist && (
  <section id="tavern-music" class="t-panel tavern-music mb-6" data-playlist-id={playlist.id} data-state="idle">
    <div class="tm-head">
      <h2 class="t-section-h text-xl tm-h">
        <svg class="tm-h-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" /></svg>
        Tavern music
      </h2>
      <span class="tm-name t-muted">{tracks.length > 0 ? `${playlist.name} · ${tracks.length} ${tracks.length === 1 ? 'track' : 'tracks'}` : 'No tracks yet'}</span>
      <div class="tm-actions">
        {tracks.length > 0 && (
          <>
            <button type="button" class="tm-btn tm-btn-main" data-tm-play aria-label="Play">
              <svg class="tm-i-play" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
              <svg class="tm-i-pause" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
              <span data-tm-play-label>Play</span>
            </button>
            <button type="button" class="tm-btn" data-tm-shuffle aria-label="Shuffle">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5" /></svg>
              Shuffle
            </button>
          </>
        )}
        {canEdit && <a class="t-link" href={`/tools/music?playlist=${playlist.id}`}>Edit</a>}
      </div>
    </div>
    {tracks.length > 0 && (
      <>
        <p class="tm-now" data-tm-now hidden>
          <span class="tm-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="tm-now-title" data-tm-now-title></span>
          <span class="tm-paused" data-tm-paused></span>
        </p>
        <details class="tm-list">
          <summary class="t-link">Tracks</summary>
          <ol>
            {tracks.map((t, i) => (
              <li>
                <button type="button" class="tm-row" data-tm-row data-index={i} data-track-id={t.id}>
                  <span class="tm-num"><span class="tm-num-n">{i + 1}</span><span class="tm-eq tm-eq-row" aria-hidden="true"><i></i><i></i><i></i></span></span>
                  <span class="tm-title">{t.title}</span>
                </button>
              </li>
            ))}
          </ol>
        </details>
        <div class="tm-progress" data-tm-progress hidden><div class="tm-progress-fill"></div></div>
      </>
    )}
    {data && <script type="application/json" id="tavern-music-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />}
  </section>
)}

<style>
  .tavern-music { padding: 0.75rem 1.25rem; transition: border-color 0.3s ease, box-shadow 0.3s ease; }
  /* Playing: a firmer gold edge and the dice button's soft glow; paused keeps the edge without the glow */
  .tavern-music[data-state='playing'],
  .tavern-music[data-state='paused'] { border-color: color-mix(in srgb, var(--gold) 60%, transparent); }
  .tavern-music[data-state='playing'] { box-shadow: 0 0 18px var(--accent-glow); }

  .tm-head { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .tm-h { display: inline-flex; align-items: center; gap: 0.45rem; }
  .tm-h-icon { flex: none; opacity: 0.85; }
  .tm-name { font-size: 0.85rem; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tm-actions { margin-left: auto; display: flex; align-items: center; gap: 0.5rem; }
  .tm-btn {
    display: inline-flex; align-items: center; gap: 0.35rem;
    padding: 0.3rem 0.7rem; border-radius: 2px; font-size: 0.8rem; font-weight: 500;
    color: var(--gold); border: 1px solid var(--border-gold);
  }
  .tm-btn:hover { background: var(--accent-dim); }
  .tm-btn-main { background: var(--accent-dim); min-width: 5.6rem; justify-content: center; }
  .tm-i-pause { display: none; }
  .tavern-music[data-state='playing'] .tm-i-play { display: none; }
  .tavern-music[data-state='playing'] .tm-i-pause { display: inline; }

  /* Now-playing line */
  .tm-now { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.45rem; font-size: 0.875rem; min-width: 0; }
  .tm-now[hidden] { display: none; }
  .tm-now-title { color: var(--text-strong); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tm-paused {
    flex: none; font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted);
    border: 1px solid var(--border); border-radius: 2px; padding: 0 0.35rem;
  }
  .tm-paused:empty { display: none; }

  /* Equalizer: pure CSS bars; flat and still when paused */
  .tm-eq { display: inline-flex; align-items: flex-end; gap: 2px; height: 14px; flex: none; }
  .tm-eq i {
    display: block; width: 3px; height: 100%; background: var(--gold); border-radius: 1px;
    transform-origin: bottom; transform: scaleY(0.35);
    animation: tm-eq 0.9s ease-in-out infinite alternate;
  }
  .tm-eq i:nth-child(2) { animation-duration: 0.7s; animation-delay: -0.3s; }
  .tm-eq i:nth-child(3) { animation-duration: 1.1s; animation-delay: -0.6s; }
  .tm-eq i:nth-child(4) { animation-duration: 0.8s; animation-delay: -0.15s; }
  .tavern-music[data-state='paused'] .tm-eq i { animation: none; transform: scaleY(0.25); opacity: 0.7; }
  @keyframes tm-eq { from { transform: scaleY(0.25); } to { transform: scaleY(1); } }

  /* Thin progress line along the bottom edge */
  .tm-progress { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--accent-dim); pointer-events: none; }
  .tm-progress[hidden] { display: none; }
  .tm-progress-fill { height: 100%; width: 100%; background: var(--gold); transform-origin: left; transform: scaleX(0); transition: transform 0.25s linear; }

  .tm-list { margin-top: 0.5rem; }
  .tm-list summary { cursor: pointer; width: fit-content; }
  .tm-list ol { margin-top: 0.4rem; max-height: 14rem; overflow-y: auto; }
  .tm-row {
    display: flex; width: 100%; gap: 0.75rem; align-items: baseline; text-align: left;
    padding: 0.3rem 0.5rem; font-size: 0.85rem; color: var(--text-body); border-radius: 2px;
  }
  .tm-row:hover { background: var(--accent-dim); color: var(--text-strong); }
  .tm-row[aria-current='true'] { color: var(--gold); background: var(--accent-dim); }
  .tm-num { width: 1.5rem; flex: none; display: inline-flex; justify-content: flex-end; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .tm-eq-row { height: 11px; display: none; }
  .tm-row[aria-current='true'] .tm-num-n { display: none; }
  .tm-row[aria-current='true'] .tm-eq-row { display: inline-flex; }

  @media (prefers-reduced-motion: reduce) {
    .tavern-music, .tm-progress-fill { transition: none; }
    .tm-eq i { animation: none; transform: scaleY(0.6); }
    .tm-eq i:nth-child(2) { transform: scaleY(0.9); }
    .tm-eq i:nth-child(3) { transform: scaleY(0.45); }
  }
</style>

<script>
  import { music, MUSIC_STATE_EVENT, type MusicState } from '../../lib/music/player';

  type Data = { id: string; name: string; tracks: { id: string; kind: 'file' | 'youtube_video' | 'youtube_playlist'; title: string; ref: string }[] };
  type PanelState = 'idle' | 'playing' | 'paused';

  const LABELS: Record<PanelState, string> = { idle: 'Play', playing: 'Pause', paused: 'Resume' };

  function panelState(id: string, s: MusicState): PanelState {
    if (s.source?.playlistId !== id || s.queue.length === 0) return 'idle';
    return s.playing ? 'playing' : 'paused';
  }

  // 'music:state' fires several times a second while playing, so only changed text/attributes are written.
  // The cache is tied to the panel element: a ClientRouter swap brings a fresh panel and a fresh render.
  let last: { root: HTMLElement | null; state: string; title: string; trackId: string } = { root: null, state: '', title: '', trackId: '' };

  function render(root: HTMLElement, id: string, s: MusicState) {
    if (last.root !== root) last = { root, state: '', title: '', trackId: '' };
    const state = panelState(id, s);
    const track = state === 'idle' ? null : s.queue[s.index] ?? null;

    if (state !== last.state) {
      last.state = state;
      root.dataset.state = state;
      const main = root.querySelector<HTMLElement>('[data-tm-play]');
      const label = root.querySelector<HTMLElement>('[data-tm-play-label]');
      if (main && label) {
        label.textContent = LABELS[state];
        main.setAttribute('aria-label', LABELS[state]);
      }
      const now = root.querySelector<HTMLElement>('[data-tm-now]');
      if (now) now.hidden = state === 'idle';
      const paused = root.querySelector<HTMLElement>('[data-tm-paused]');
      if (paused) paused.textContent = state === 'paused' ? 'Paused' : '';
    }

    const title = track ? s.videoTitle || track.title : '';
    if (title !== last.title) {
      last.title = title;
      const el = root.querySelector<HTMLElement>('[data-tm-now-title]');
      if (el) el.textContent = title;
    }

    // Rows are matched by track id: under shuffle the queue order differs from the playlist order
    const trackId = track?.id ?? '';
    if (trackId !== last.trackId) {
      last.trackId = trackId;
      root.querySelectorAll<HTMLElement>('[data-tm-row]').forEach((row) => {
        if (trackId && row.dataset.trackId === trackId) row.setAttribute('aria-current', 'true');
        else row.removeAttribute('aria-current');
      });
    }

    const bar = root.querySelector<HTMLElement>('[data-tm-progress]');
    if (bar) {
      const show = state !== 'idle' && s.duration > 0;
      if (bar.hidden === show) bar.hidden = !show;
      if (show) {
        const fill = bar.firstElementChild as HTMLElement | null;
        if (fill) fill.style.transform = `scaleX(${Math.min(1, Math.max(0, s.position / s.duration))})`;
      }
    }
  }

  // The state listener lives on document and survives ClientRouter swaps, so it is bound once and looks the panel up each time.
  const w = window as any;
  if (!w.__tavernMusicBound) {
    w.__tavernMusicBound = true;
    document.addEventListener(MUSIC_STATE_EVENT, (e) => {
      const root = document.getElementById('tavern-music');
      if (root) render(root, root.dataset.playlistId ?? '', (e as CustomEvent<MusicState>).detail);
    });
  }

  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('tavern-music');
    const raw = document.getElementById('tavern-music-data')?.textContent;
    if (!root || !raw || root.dataset.bound) return;
    root.dataset.bound = '1';
    const data: Data = JSON.parse(raw);
    const playlist = { id: data.id, name: data.name, tracks: data.tracks };

    // Main button toggles: idle starts the list from the top, playing pauses, paused resumes
    root.querySelector('[data-tm-play]')?.addEventListener('click', () => {
      const state = panelState(data.id, music.getState());
      if (state === 'playing') music.pause();
      else if (state === 'paused') music.play();
      else music.playPlaylist(playlist, 0);
    });
    root.querySelector('[data-tm-shuffle]')?.addEventListener('click', () => music.playPlaylist(playlist, 0, { shuffle: true }));
    root.querySelectorAll<HTMLElement>('[data-tm-row]').forEach((row) => {
      row.addEventListener('click', () => music.playPlaylist(playlist, Number(row.dataset.index)));
    });
    render(root, data.id, music.getState());
  });
</script>

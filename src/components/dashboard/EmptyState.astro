---
// One-line empty state for dashboard cards, with an optional "add" link for editors.
interface Props {
  message: string;
  actionHref?: string;
  actionLabel?: string;
  canEdit?: boolean;
}

const { message, actionHref, actionLabel = 'Add one?', canEdit = false } = Astro.props;
---

<p class="empty-state">
  <span>{message}</span>
  {canEdit && actionHref && <a href={actionHref} class="t-link">{actionLabel}</a>}
</p>

<style>
  .empty-state {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    align-items: baseline;
    padding: 0.75rem 0.9rem;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--text-muted);
    border: 1px dashed var(--border-gold);
    border-radius: 2px;
  }
  .empty-state a { font-style: normal; }
</style>

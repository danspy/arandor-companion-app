---
import { markdownExcerpt } from '../../utils/markdown';

interface Props {
  entry: {
    id: string;
    title: string;
    date: string;
    session: number;
    summary: string | null;
    content: string;
    coverImageUrl: string | null;
  };
}

const { entry } = Astro.props;
const recap = markdownExcerpt(entry.summary || entry.content, 260);
const date = new Date(entry.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<a href={`/diary/${entry.id}`} class="recap t-panel group">
  {entry.coverImageUrl && <img src={entry.coverImageUrl} alt="" class="recap-img" loading="lazy" />}
  <div class="recap-shade"></div>
  <div class="recap-body">
    <p class="recap-kicker">Previously on Arandor…</p>
    <h2 class="recap-title">{entry.title}</h2>
    <p class="recap-meta">Session {entry.session} · {date}</p>
    {recap && <p class="recap-text">{recap}</p>}
    <span class="recap-link">Read the full entry →</span>
  </div>
</a>

<style>
  .recap {
    display: flex;
    align-items: flex-end;
    position: relative;
    overflow: hidden;
    min-height: 16rem;
    height: 100%;
    background: radial-gradient(ellipse at top right, rgba(201, 144, 50, 0.22), transparent 60%), #120d07;
  }
  .recap-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 6s ease-out;
  }
  .recap:hover .recap-img { transform: scale(1.1); }
  .recap-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(8, 6, 3, 0.95) 0%, rgba(8, 6, 3, 0.7) 45%, rgba(8, 6, 3, 0.15) 100%);
  }
  .recap-body { position: relative; padding: 1.5rem; max-width: 42rem; }
  .recap-kicker {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: 1.05rem;
    color: #d9af60;
    margin-bottom: 0.15rem;
  }
  .recap-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.6rem, 4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.1;
    color: #f2e8d5;
  }
  .recap-meta {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(242, 232, 213, 0.55);
    margin-top: 0.35rem;
  }
  .recap-text { margin-top: 0.75rem; font-size: 0.9rem; line-height: 1.55; color: rgba(242, 232, 213, 0.85); }
  .recap-link { display: inline-block; margin-top: 0.9rem; font-size: 0.8rem; font-weight: 600; color: #d9af60; }
  .recap:hover .recap-link { text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) {
    .recap-img, .recap:hover .recap-img { transition: none; transform: none; }
  }
</style>

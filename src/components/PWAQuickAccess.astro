---
import { getCurrentUser } from '../lib/auth';

// Get current user and their favorite pages
const user = await getCurrentUser(Astro.cookies);
const favoritePages = user?.favoritePages || [];
const userRole = user?.role || 'player';
const currentPath = Astro.url.pathname;

// Define all available pages with their metadata
const pageDefinitions = [
  {
    id: '/',
    name: 'Home',
    icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6'
  },
  {
    id: '/diary',
    name: 'Diary',
    icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253'
  },
  {
    id: '/library',
    name: 'Library',
    icon: 'M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z'
  },
  {
    id: '/characters',
    name: 'Characters',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z'
  },
  {
    id: '/npcs',
    name: 'NPCs',
    icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z'
  },
  {
    id: '/locations',
    name: 'Locations',
    icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z'
  },
  {
    id: '/map',
    name: 'Map',
    icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7'
  },
  {
    id: '/quests',
    name: 'Quests',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4'
  },
  {
    id: '/tools',
    name: 'Tools',
    icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z'
  },
  {
    id: '/tools/initiative',
    name: 'Initiative',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01'
  },
  {
    id: '/tools/dm-screen',
    name: 'DM Screen',
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
    dmOnly: true
  },
  {
    id: '/users',
    name: 'Users',
    icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
    adminOnly: true
  },
];

// Filter favorite pages based on user permissions and get their definitions
const visibleFavoritePages = favoritePages
  .map(pageId => pageDefinitions.find(p => p.id === pageId))
  .filter(page => {
    if (!page) return false;
    if (page.dmOnly && userRole !== 'admin' && userRole !== 'dungeonmaster') {
      return false;
    }
    if (page.adminOnly && userRole !== 'admin') {
      return false;
    }
    return true;
  });

// Helper function to check if a link is active
function isActiveLink(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<!-- Quick Access Buttons (only visible in PWA mode) -->
{visibleFavoritePages.length > 0 && (
  <div class="pwa-quick-access-container hidden-in-browser">
    <div class="pwa-quick-access-buttons">
      {visibleFavoritePages.map((page, index) => (
        <a
          href={page.id}
          data-astro-reload={page.id === '/map' ? true : undefined}
          class:list={[
            'pwa-quick-access-button',
            { 'pwa-quick-access-button-active': isActiveLink(page.id) }
          ]}
          title={page.name}
          style={`--button-index: ${index};`}
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={page.icon}></path>
          </svg>
        </a>
      ))}
    </div>
  </div>
)}

<style>
  :root {
    --pwa-quick-access-spacing: 16px;
    --pwa-quick-access-button-size: 52px;
  }

  .hidden-in-browser {
    display: none;
  }

  @media (display-mode: standalone) and (max-width: 1024px) {
    .hidden-in-browser {
      display: block;
    }
  }

  /* ── Container ── */
  .pwa-quick-access-container {
    position: fixed;
    bottom: var(--pwa-quick-access-spacing);
    left: calc(var(--pwa-quick-access-spacing) + env(safe-area-inset-left));
    z-index: 9999;
    pointer-events: none;
  }

  /* ── Button strip ── */
  .pwa-quick-access-buttons {
    display: flex;
    flex-direction: row;
    pointer-events: auto;
    border-radius: 2px;
    overflow: hidden;
    background: var(--bg-surface);
    border: 1px solid var(--border-gold);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }

  /* ── Individual button ── */
  .pwa-quick-access-button {
    width: var(--pwa-quick-access-button-size);
    height: var(--pwa-quick-access-button-size);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s ease;
    text-decoration: none;
    position: relative;
  }

  .pwa-quick-access-button svg {
    width: 20px;
    height: 20px;
    transition: color 0.2s ease;
  }

  /* ── Active state ── */
  .pwa-quick-access-button-active {
    color: var(--gold);
    background: var(--accent-dim);
  }

  .pwa-quick-access-button-active svg {
    color: var(--gold);
    filter: drop-shadow(0 0 3px var(--accent-glow));
  }

  /* ── Small screens ── */
  @media (max-width: 360px) {
    :root {
      --pwa-quick-access-button-size: 46px;
    }

    .pwa-quick-access-button svg {
      width: 18px;
      height: 18px;
    }
  }
</style>

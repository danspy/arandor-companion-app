---
// Site-wide music player: the <audio> element, the (later) YouTube tile and the mini bar.
// Persisted across ClientRouter page changes so playback never stops. All logic lives in
// src/lib/music/player.ts; this component only renders the store's state.
---

<div id="music-root" class="music-root" transition:persist>
  <audio id="music-audio" preload="metadata"></audio>
  <div id="music-yt-tile" class="music-yt-tile" hidden></div>

  <div id="music-panel" class="music-panel t-panel" role="region" aria-label="Music queue and options" hidden>
    <div class="music-seek-row">
      <span id="music-pos" class="music-time">0:00</span>
      <input id="music-seek" type="range" class="music-range" min="0" max="0" step="0.1" value="0" aria-label="Seek" />
      <span id="music-dur" class="music-time">0:00</span>
    </div>
    <div class="music-mode-row">
      <span id="music-source" class="t-label-sm music-source"></span>
      <button type="button" id="music-shuffle" class="music-btn music-mode" aria-label="Shuffle" aria-pressed="false" title="Shuffle">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5" /></svg>
      </button>
      <button type="button" id="music-repeat" class="music-btn music-mode" aria-label="Repeat: off" aria-pressed="false" title="Repeat: off">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 1l4 4-4 4" /><path d="M3 11V9a4 4 0 0 1 4-4h14" /><path d="M7 23l-4-4 4-4" /><path d="M21 13v2a4 4 0 0 1-4 4H3" /></svg>
        <span id="music-repeat-one" class="music-repeat-one" hidden>1</span>
      </button>
    </div>
    <ol id="music-queue" class="music-queue" aria-label="Queue"></ol>
  </div>

  <div id="music-bar" class="music-bar t-panel" hidden>
    <span id="music-title" class="music-title"></span>
    <button type="button" id="music-prev" class="music-btn" aria-label="Previous track" title="Previous">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M6 5h2v14H6zM20 5v14L9 12z" /></svg>
    </button>
    <button type="button" id="music-toggle" class="music-btn music-btn-main" aria-label="Play" title="Play">
      <svg class="music-icon-play" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z" /></svg>
      <svg class="music-icon-pause" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M6 4h4v16H6zM14 4h4v16h-4z" /></svg>
    </button>
    <button type="button" id="music-next" class="music-btn" aria-label="Next track" title="Next">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M16 5h2v14h-2zM4 5v14l11-7z" /></svg>
    </button>
    <input id="music-volume" type="range" class="music-range music-volume" min="0" max="1" step="0.05" value="0.8" aria-label="Volume" />
    <button type="button" id="music-expand" class="music-btn" aria-label="Show queue and options" aria-expanded="false" aria-controls="music-panel" title="Queue and options">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6" /></svg>
    </button>
    <button type="button" id="music-close" class="music-btn" aria-label="Stop and close player" title="Stop and close">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
  </div>
</div>

<style is:global>
  .music-root {
    --music-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    position: fixed;
    left: calc(16px + env(safe-area-inset-left, 0px));
    bottom: var(--music-bottom);
    z-index: 9980; /* below the dice button and its panel */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    /* Never under the dice button (56px wide, 16px from the right) */
    max-width: calc(100vw - 16px - 56px - 16px - 12px - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px));
    pointer-events: none;
  }
  .music-root > * { pointer-events: auto; }
  .music-root [hidden] { display: none !important; }

  .music-bar {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 44px;
    padding: 0 4px 0 12px;
    max-width: 100%;
    background-color: var(--bg-raised);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
  }
  .music-title {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 14rem;
    margin-right: 4px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 0.85rem;
    color: var(--text-strong);
  }
  .music-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 2px;
    color: var(--text-muted);
    background: none;
    border: 1px solid transparent;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .music-btn:hover, .music-btn:focus-visible { color: var(--gold); }
  .music-btn:focus-visible { outline: none; border-color: var(--border-gold); }
  .music-btn-main { color: var(--gold); }
  #music-toggle .music-icon-pause { display: none; }
  #music-toggle.is-playing .music-icon-play { display: none; }
  #music-toggle.is-playing .music-icon-pause { display: block; }
  #music-expand[aria-expanded='true'] svg { transform: rotate(180deg); }

  .music-range { accent-color: var(--gold); height: 4px; cursor: pointer; }
  .music-volume { width: 72px; margin: 0 6px; display: none; }
  @media (min-width: 768px) { .music-volume { display: block; } }

  .music-panel {
    width: min(22rem, 100%);
    max-height: min(50vh, 24rem);
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px 12px;
    background-color: var(--bg-raised);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
  }
  .music-seek-row, .music-mode-row { display: flex; align-items: center; gap: 8px; }
  .music-seek-row .music-range { flex: 1; min-width: 0; }
  .music-time { font-size: 0.7rem; color: var(--text-muted); font-variant-numeric: tabular-nums; min-width: 2.4rem; text-align: center; }
  .music-source { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .music-mode { position: relative; }
  .music-mode[aria-pressed='true'] { color: var(--gold); border-color: var(--border-gold); }
  .music-repeat-one { position: absolute; right: 2px; bottom: 1px; font-size: 0.6rem; font-weight: 700; }
  .music-queue { list-style: none; margin: 0; padding: 0; overflow-y: auto; border-top: 1px solid var(--border); }
  .music-queue button {
    display: flex;
    gap: 8px;
    width: 100%;
    padding: 6px 4px;
    text-align: left;
    font-size: 0.8rem;
    color: var(--text-body);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
  }
  .music-queue button:hover { color: var(--gold); }
  .music-queue button[aria-current='true'] { color: var(--gold); font-weight: 600; }
  .music-queue .music-q-n { flex: none; width: 1.5rem; color: var(--text-faint); font-variant-numeric: tabular-nums; }
  .music-queue .music-q-t { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

  .music-yt-tile { width: 200px; height: 200px; background: #000; border: 1px solid var(--border-gold); }

  /* Installed app: above the bottom dock, clear of the dice seal that pokes ~23px above it. */
  @media (display-mode: standalone) and (max-width: 1024px) {
    .music-root {
      --music-bottom: calc(var(--pwa-dock-height) + 30px + env(safe-area-inset-bottom, 0px));
      max-width: calc(100vw - 32px - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px));
      transition: bottom 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    /* Dock tucked away: the seal sits at the bottom edge, so stay above it. */
    html.pwa-dock-tucked .music-root { --music-bottom: calc(66px + env(safe-area-inset-bottom, 0px)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .music-root { transition: none; }
  }
</style>

<script>
  import { music, MUSIC_STATE_EVENT, type MusicState } from '../lib/music/player';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const fmt = (s: number) => {
    s = Math.max(0, Math.floor(s || 0));
    const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = String(s % 60).padStart(2, '0');
    return h ? `${h}:${String(m).padStart(2, '0')}:${sec}` : `${m}:${sec}`;
  };
  const REPEAT_NEXT = { off: 'all', all: 'one', one: 'off' } as const;
  const REPEAT_LABEL = { off: 'Repeat: off', all: 'Repeat: all', one: 'Repeat: this track' } as const;

  let seeking = false;
  let queueKey = '';

  function render(s: MusicState) {
    const bar = $('music-bar');
    if (!bar) return;
    const empty = s.queue.length === 0;
    bar.hidden = empty;
    const panel = $('music-panel')!;
    const expand = $('music-expand')!;
    if (empty) {
      panel.hidden = true;
      expand.setAttribute('aria-expanded', 'false');
    }
    $('music-yt-tile')!.hidden = !s.youtubeVisible;
    if (empty) return;

    const cur = s.queue[s.index];
    const title = $('music-title')!;
    title.textContent = cur?.title ?? '';
    title.title = cur?.title ?? '';

    const toggle = $('music-toggle')!;
    toggle.classList.toggle('is-playing', s.playing);
    toggle.setAttribute('aria-label', s.playing ? 'Pause' : 'Play');
    toggle.title = s.playing ? 'Pause' : 'Play';

    const vol = $<HTMLInputElement>('music-volume')!;
    if (document.activeElement !== vol) vol.value = String(s.volume);

    if (!panel.hidden) renderPanel(s);
  }

  function renderPanel(s: MusicState) {
    const seek = $<HTMLInputElement>('music-seek')!;
    seek.max = String(s.duration || 0);
    if (!seeking) seek.value = String(s.position);
    $('music-pos')!.textContent = fmt(seeking ? Number(seek.value) : s.position);
    $('music-dur')!.textContent = fmt(s.duration);
    $('music-source')!.textContent = s.source?.name ?? '';

    const shuffle = $('music-shuffle')!;
    shuffle.setAttribute('aria-pressed', String(s.shuffle));
    const repeat = $('music-repeat')!;
    repeat.setAttribute('aria-pressed', String(s.repeat !== 'off'));
    repeat.setAttribute('aria-label', REPEAT_LABEL[s.repeat]);
    repeat.title = REPEAT_LABEL[s.repeat];
    $('music-repeat-one')!.hidden = s.repeat !== 'one';

    const key = s.queue.map((t) => t.id).join('|') + '#' + s.index;
    if (key === queueKey) return;
    queueKey = key;
    const list = $('music-queue')!;
    list.replaceChildren(...s.queue.map((t, i) => {
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.type = 'button';
      b.dataset.index = String(i);
      if (i === s.index) b.setAttribute('aria-current', 'true');
      const n = document.createElement('span');
      n.className = 'music-q-n';
      n.textContent = String(i + 1);
      const tt = document.createElement('span');
      tt.className = 'music-q-t';
      tt.textContent = t.title;
      b.append(n, tt);
      b.setAttribute('aria-label', `Play ${t.title}`);
      li.append(b);
      return li;
    }));
    list.querySelector('[aria-current="true"]')?.scrollIntoView({ block: 'nearest' });
  }

  function bind() {
    const root = $('music-root');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    $('music-prev')!.addEventListener('click', () => music.prev());
    $('music-toggle')!.addEventListener('click', () => music.toggle());
    $('music-next')!.addEventListener('click', () => music.next());
    $('music-close')!.addEventListener('click', () => music.stop());
    $('music-volume')!.addEventListener('input', (e) => music.setVolume(Number((e.target as HTMLInputElement).value)));
    $('music-expand')!.addEventListener('click', () => {
      const panel = $('music-panel')!;
      panel.hidden = !panel.hidden;
      $('music-expand')!.setAttribute('aria-expanded', String(!panel.hidden));
      queueKey = '';
      if (!panel.hidden) renderPanel(music.getState());
    });
    $('music-shuffle')!.addEventListener('click', () => music.setShuffle(!music.getState().shuffle));
    $('music-repeat')!.addEventListener('click', () => music.setRepeat(REPEAT_NEXT[music.getState().repeat]));
    const seek = $<HTMLInputElement>('music-seek')!;
    seek.addEventListener('input', () => {
      seeking = true;
      $('music-pos')!.textContent = fmt(Number(seek.value));
    });
    seek.addEventListener('change', () => {
      seeking = false;
      music.seek(Number(seek.value));
    });
    $('music-queue')!.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-index]');
      if (b) music.jump(Number(b.dataset.index));
    });
    document.addEventListener(MUSIC_STATE_EVENT, (e) => render((e as CustomEvent<MusicState>).detail));
  }

  bind();
  render(music.getState());
  document.addEventListener('astro:page-load', () => {
    bind();
    render(music.getState());
  });
</script>

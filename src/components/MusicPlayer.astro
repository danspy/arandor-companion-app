---
// Site-wide music player: the music button (bottom left, the dice button's twin), the mini bar
// it slides out to its right, the queue panel above them, the <audio> element and the YouTube tile.
// Persisted across ClientRouter page changes so playback never stops. All logic lives in
// src/lib/music/player.ts; this component only renders the store's state.
---

<div id="music-root" class="music-root" transition:persist>
  <audio id="music-audio" preload="metadata"></audio>
  <!-- YouTube's terms forbid hidden playback: the video is visible (≥ 200×200) whenever it plays or is about to.
       While a YouTube track is paused the tile collapses (is-idle) but keeps its iframe, so nothing reloads. -->
  <div id="music-yt-tile" class="music-yt-tile t-panel" role="region" aria-label="YouTube video" hidden>
    <div class="music-yt-head">
      <span class="t-label-sm">YouTube</span>
      <button type="button" id="music-yt-size" class="music-btn" aria-label="Shrink video" title="Shrink video">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
      </button>
    </div>
    <div id="music-yt-frame" class="music-yt-frame"></div>
  </div>

  <!-- Queue and options: opens upwards, above the button and the bar (only while the player is open) -->
  <div id="music-panel" class="music-panel t-panel" role="region" aria-label="Music queue and options" hidden>
    <!-- Narrow screens: the bar has no room for these, so they live here -->
    <div class="music-panel-ctl">
      <span id="music-panel-title" class="music-panel-title"></span>
      <button type="button" id="music-prev-p" class="music-btn" aria-label="Previous track" title="Previous">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M6 5h2v14H6zM20 5v14L9 12z" /></svg>
      </button>
      <button type="button" id="music-close-p" class="music-btn" aria-label="Stop and close player" title="Stop and close">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
    <div class="music-seek-row">
      <span id="music-pos" class="music-time">0:00</span>
      <input id="music-seek" type="range" class="music-range" min="0" max="0" step="0.1" value="0" aria-label="Seek" />
      <span id="music-dur" class="music-time">0:00</span>
    </div>
    <div class="music-mode-row">
      <span id="music-source" class="t-label-sm music-source"></span>
      <button type="button" id="music-shuffle" class="music-btn music-mode" aria-label="Shuffle" aria-pressed="false" title="Shuffle">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5" /></svg>
      </button>
      <button type="button" id="music-repeat" class="music-btn music-mode" aria-label="Repeat: off" aria-pressed="false" title="Repeat: off">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 1l4 4-4 4" /><path d="M3 11V9a4 4 0 0 1 4-4h14" /><path d="M7 23l-4-4 4-4" /><path d="M21 13v2a4 4 0 0 1-4 4H3" /></svg>
        <span id="music-repeat-one" class="music-repeat-one" hidden>1</span>
      </button>
    </div>
    <ol id="music-queue" class="music-queue" aria-label="Queue"></ol>
  </div>

  <!-- One row along the bottom: the button, and the bar it slides out to its right -->
  <div class="music-row">
  <!-- Shown while there is something to play (a queue, or the site playlist cued) -->
  <button
    type="button"
    id="music-fab"
    class="music-fab"
    aria-label="Music player"
    aria-expanded="false"
    aria-controls="music-drawer"
    title="Music"
    hidden
  >
    <svg class="music-fab-note" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" />
    </svg>
    <!-- Playing: an equaliser instead of the note -->
    <span class="music-fab-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  </button>

  <!-- The mini bar slides out of the button. Shut, it takes no room and is inert. -->
  <div id="music-drawer" class="music-drawer">
  <div class="music-drawer-inner">
  <div id="music-bar" class="music-bar t-panel" hidden>
    <span id="music-title" class="music-title"></span>
    <button type="button" id="music-prev" class="music-btn music-wide-only" aria-label="Previous track" title="Previous">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M6 5h2v14H6zM20 5v14L9 12z" /></svg>
    </button>
    <button type="button" id="music-toggle" class="music-btn music-btn-main" aria-label="Play" title="Play">
      <svg class="music-icon-play" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z" /></svg>
      <svg class="music-icon-pause" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M6 4h4v16H6zM14 4h4v16h-4z" /></svg>
    </button>
    <button type="button" id="music-next" class="music-btn" aria-label="Next track" title="Next">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M16 5h2v14h-2zM4 5v14l11-7z" /></svg>
    </button>
    <input id="music-volume" type="range" class="music-range music-volume" min="0" max="1" step="0.05" value="0.8" aria-label="Volume" />
    <button type="button" id="music-expand" class="music-btn" aria-label="Show queue and options" aria-expanded="false" aria-controls="music-panel" title="Queue and options">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6" /></svg>
    </button>
    <button type="button" id="music-close" class="music-btn music-wide-only" aria-label="Stop and close player" title="Stop and close">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
    <div id="music-progress" class="music-progress" hidden aria-hidden="true"><div id="music-progress-fill" class="music-progress-fill"></div></div>
  </div>
  </div>
  </div>
  </div>
</div>

<style is:global>
  /* Where the music row sits, on the root so toasts and page padding can follow it.
     --music-bar-max: the room for the mini bar right of the button, up to the dice button
     (56px, 16px from the right edge) with a 12px gap. */
  :root {
    --music-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    --music-bar-max: calc(100vw - 16px - 56px - 8px - 12px - 56px - 16px - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px));
  }
  /* Distance from the screen bottom to the top of the button row (unset while there is no button);
     the toasts (ConfirmDialog) stay above this line. */
  html:has(#music-fab:not([hidden])) { --music-bar-top: calc(var(--music-bottom) + 56px); }
  /* Bottom up: one row (button + the mini bar to its right, same height and bottom line), then the
     queue panel, then the YouTube tile. The row stays clear of the dice button on the right. */
  .music-root {
    position: fixed;
    left: calc(16px + env(safe-area-inset-left, 0px));
    bottom: var(--music-bottom);
    z-index: 9980; /* below the dice button and its panel */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: calc(100vw - 32px - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px));
    pointer-events: none;
  }
  .music-root > :not(.music-row), .music-fab, .music-drawer-inner > * { pointer-events: auto; }
  .music-row { display: flex; align-items: flex-end; max-width: 100%; }
  .music-root [hidden] { display: none !important; }

  /* ── Music button: the dice button's twin on the left ── */
  .music-fab {
    position: relative;
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-surface);
    border: 1px solid var(--border-gold);
    color: var(--gold);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3), 0 0 18px var(--accent-glow);
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, opacity 0.3s ease;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
    animation: music-fab-in 0.25s ease-out backwards;
  }
  .music-fab:hover { transform: rotate(8deg) scale(1.06); border-color: var(--gold); box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35), 0 0 26px var(--accent-glow); }
  .music-fab:active { transform: scale(0.94); }
  .music-fab:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  .music-fab[aria-expanded='true'] { border-color: var(--gold); }
  @keyframes music-fab-in { from { opacity: 0; transform: scale(0.8); } to { opacity: 1; transform: none; } }

  /* Playing: an equaliser instead of the note (also while the player is shut) */
  .music-fab-eq { display: none; align-items: flex-end; gap: 3px; height: 22px; }
  .music-fab-eq i { display: block; width: 4px; height: 100%; background: currentColor; border-radius: 1px; transform-origin: bottom; animation: music-eq 0.9s ease-in-out infinite alternate; }
  .music-fab-eq i:nth-child(2) { animation-duration: 0.7s; animation-delay: -0.3s; }
  .music-fab-eq i:nth-child(3) { animation-duration: 1.1s; animation-delay: -0.6s; }
  .music-fab-eq i:nth-child(4) { animation-duration: 0.8s; animation-delay: -0.15s; }
  .music-fab.is-playing .music-fab-note { display: none; }
  .music-fab.is-playing .music-fab-eq { display: inline-flex; }
  .music-fab.is-playing { box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3), 0 0 24px var(--accent-glow); }
  @keyframes music-eq { from { transform: scaleY(0.25); } to { transform: scaleY(1); } }

  /* ── The mini bar slides out of the button to the right ── */
  .music-drawer {
    display: grid;
    grid-template-columns: 0fr;
    min-width: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-14px) scale(0.96);
    transform-origin: left center;
    transition:
      grid-template-columns 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.2s ease,
      visibility 0s linear 0.28s;
  }
  .music-drawer-inner { transition: padding 0.28s cubic-bezier(0.2, 0.8, 0.2, 1), margin 0.28s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .music-root.is-open .music-drawer {
    grid-template-columns: 1fr;
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  /* Clips while it slides; the padding (taken back by the margins) leaves room for the shadows,
     and open, 8px between the button and the mini bar. */
  .music-drawer-inner {
    min-width: 0;
    overflow: hidden;
    display: flex;
    padding: 24px 24px 24px 0;
    margin: -24px -24px -24px 0;
  }
  .music-root.is-open .music-drawer-inner { padding-left: 8px; }
  .music-yt-tile, .music-panel { margin-bottom: 8px; }
  /* The queue panel belongs to the open player */
  .music-root:not(.is-open) .music-panel { display: none !important; }
  .music-panel { animation: music-panel-in 0.2s ease-out both; transform-origin: bottom left; }
  @keyframes music-panel-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  .music-bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
    height: 56px;
    padding: 0 6px 0 12px;
    width: max-content;
    max-width: var(--music-bar-max);
    background-color: var(--bg-raised);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
  }
  /* Display-only progress line along the bottom edge (same look as the dashboard panel's) */
  .music-progress { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--accent-dim); pointer-events: none; }
  .music-progress-fill { height: 100%; width: 100%; background: var(--gold); transform-origin: left; transform: scaleX(0); transition: transform 0.25s linear; }
  .music-title {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 14rem;
    margin-right: 4px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 0.85rem;
    color: var(--text-strong);
  }
  .music-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 2px;
    color: var(--text-muted);
    background: none;
    border: 1px solid transparent;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .music-btn:hover, .music-btn:focus-visible { color: var(--gold); }
  .music-btn:focus-visible { outline: none; border-color: var(--border-gold); }
  .music-btn-main { color: var(--gold); }
  #music-toggle .music-icon-pause { display: none; }
  #music-toggle.is-playing .music-icon-play { display: none; }
  #music-toggle.is-playing .music-icon-pause { display: block; }
  #music-expand[aria-expanded='true'] svg { transform: rotate(180deg); }

  .music-range { accent-color: var(--gold); height: 4px; cursor: pointer; }
  .music-volume { width: 72px; margin: 0 6px; display: none; }
  @media (min-width: 768px) { .music-volume { display: block; } }

  /* Narrow screens: the bar fills the room between the two buttons and keeps title, play, next and
     the queue arrow; previous and stop move to the top of the queue panel. */
  .music-panel-ctl { display: none; align-items: center; gap: 4px; }
  .music-panel-title { flex: 1; min-width: 0; font-size: 0.85rem; color: var(--text-strong); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  @media (max-width: 599px) {
    .music-bar { width: var(--music-bar-max); }
    .music-title { max-width: none; }
    .music-bar .music-wide-only { display: none; }
    .music-panel-ctl { display: flex; }
  }

  .music-panel {
    width: min(22rem, 100%);
    /* Room left above the button row (and the YouTube tile while it shows) */
    max-height: min(24rem, calc(100dvh - var(--music-bottom) - 56px - 8px - 16px - env(safe-area-inset-top, 0px)));
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px 12px;
    background-color: var(--bg-raised);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
  }
  .music-seek-row, .music-mode-row { display: flex; align-items: center; gap: 8px; }
  .music-seek-row .music-range { flex: 1; min-width: 0; }
  .music-time { font-size: 0.7rem; color: var(--text-muted); font-variant-numeric: tabular-nums; min-width: 2.4rem; text-align: center; }
  .music-source { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .music-mode { position: relative; }
  .music-mode[aria-pressed='true'] { color: var(--gold); border-color: var(--border-gold); }
  .music-repeat-one { position: absolute; right: 2px; bottom: 1px; font-size: 0.6rem; font-weight: 700; }
  .music-queue { list-style: none; margin: 0; padding: 0; overflow-y: auto; border-top: 1px solid var(--border); }
  .music-queue button {
    display: flex;
    gap: 8px;
    width: 100%;
    padding: 6px 4px;
    text-align: left;
    font-size: 0.8rem;
    color: var(--text-body);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
  }
  .music-queue button:hover { color: var(--gold); }
  .music-queue button[aria-current='true'] { color: var(--gold); font-weight: 600; }
  .music-queue .music-q-n { flex: none; width: 1.5rem; color: var(--text-faint); font-variant-numeric: tabular-nums; }
  .music-queue .music-q-t { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

  .music-yt-tile {
    display: flex;
    flex-direction: column;
    padding: 0 4px 4px;
    background-color: var(--bg-raised);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
  }
  /* Paused: out of the layout and invisible, but the frame keeps its size so the player stays intact */
  .music-yt-tile.is-idle {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 0;
    padding: 0;
    overflow: hidden;
    visibility: hidden;
    pointer-events: none;
    box-shadow: none;
  }
  .music-yt-head { display: flex; align-items: center; justify-content: space-between; height: 28px; padding-left: 6px; }
  /* YouTube's minimum player size is 200×200; ▾ shrinks to exactly that, never smaller or hidden */
  /* 16:9 where it fits; root max-width (100vw − 100px) minus the tile padding */
  .music-yt-frame { width: max(200px, min(356px, calc(100vw - 108px))); height: 200px; background: #000; }
  .music-yt-tile.is-small .music-yt-frame { width: 200px; height: 200px; }
  .music-yt-tile.is-small #music-yt-size svg { transform: rotate(180deg); }
  .music-yt-frame iframe { display: block; width: 100%; height: 100%; border: 0; }
  .music-root:has(.music-yt-tile:not([hidden]):not(.is-idle)) .music-panel {
    max-height: min(24rem, calc(100dvh - var(--music-bottom) - 56px - 8px - 16px - 240px - env(safe-area-inset-top, 0px)));
  }

  /* Touch screens: every control at least 44px */
  @media (pointer: coarse) {
    .music-btn { width: 44px; height: 44px; }
    .music-yt-head { height: 44px; }
    .music-queue button { min-height: 44px; align-items: center; }
  }

  /* Phones and tablets: the dice panel opens over the queue panel, so that steps aside instead of
     peeking out around it. The YouTube tile stays (YouTube playback is never hidden). */
  @media (max-width: 1024px) {
    html:has(#dice-fab[aria-expanded='true']) .music-panel { visibility: hidden; }
  }

  /* Installed app: the row sits on the left above the bottom dock. The dice seal in the middle of the
     dock pokes ~23px above it, so the row's bottom line is 30px above the dock: the bar can then run
     to the right edge over the seal (the dice button lives in the dock, nothing else is on the right).
     While the dock is tucked away the button drops to the bottom edge; an open bar stays above the
     tucked seal (which reaches ~60px up). */
  @media (display-mode: standalone) and (max-width: 1024px) {
    :root {
      --music-bottom: calc(var(--pwa-dock-height) + 30px + env(safe-area-inset-bottom, 0px));
      --music-bar-max: calc(100vw - 16px - 56px - 8px - 16px - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px));
    }
    .music-root { transition: bottom 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); }
    html.pwa-dock-tucked { --music-bottom: calc(10px + env(safe-area-inset-bottom, 0px)); }
    html.pwa-dock-tucked:has(#music-root.is-open #music-bar:not([hidden])) { --music-bottom: calc(66px + env(safe-area-inset-bottom, 0px)); }
    /* Tucked and shut, like the seal: smaller and dimmer (still 44px+ to tap) */
    html.pwa-dock-tucked #music-root:not(.is-open) .music-fab { transform: scale(0.8); transform-origin: bottom left; opacity: 0.75; }
    html.pwa-dock-tucked #music-root:not(.is-open) .music-fab:active { transform: scale(0.74); }
    /* The page can scroll its last lines above the row (global.css pads main by this clearance).
       Uses the dock-shown position so tucking the dock never changes the page height. */
    html:has(#music-fab:not([hidden])) main { --pwa-floating-menu-clearance: calc(var(--pwa-dock-height) + 30px + 56px + 8px); }
    /* The dice panel opens over the row: button and bar step aside (the YouTube tile stays) */
    html:has(#dice-fab[aria-expanded='true']) .music-row,
    html:has(#dice-fab[aria-expanded='true']) .music-drawer { visibility: hidden; }
  }
  @media (prefers-reduced-motion: reduce) {
    .music-root, .music-progress-fill, .music-drawer, .music-drawer-inner, .music-fab { transition: none; }
    .music-fab { animation: none; }
    .music-fab:hover, .music-fab:active { transform: none; }
    .music-fab-eq i { animation: none; transform: scaleY(0.6); }
    .music-fab-eq i:nth-child(2) { transform: scaleY(0.9); }
    .music-fab-eq i:nth-child(3) { transform: scaleY(0.45); }
  }
</style>

<script>
  import { music, MUSIC_STATE_EVENT, MUSIC_PLAY_EVENT, fmtTime as fmt, type MusicState } from '../lib/music/player';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const REPEAT_NEXT = { off: 'all', all: 'one', one: 'off' } as const;
  const REPEAT_LABEL = { off: 'Repeat: off', all: 'Repeat: all', one: 'Repeat: this track' } as const;

  const YT_SMALL_KEY = 'arandor.music.ytSmall'; // per-viewer convenience only
  const OPEN_KEY = 'arandor.music.open'; // player open or shut, per viewer

  /** Slides the player open or shut. `remember`: store it (not for automatic changes). */
  function setOpen(open: boolean, remember = true) {
    const root = $('music-root');
    if (!root) return;
    root.classList.toggle('is-open', open);
    $('music-fab')?.setAttribute('aria-expanded', String(open));
    // Shut: out of the tab order and away from screen readers (the tile stays outside it)
    $('music-drawer')!.inert = !open;
    if (remember) {
      try { localStorage.setItem(OPEN_KEY, open ? '1' : '0'); } catch { /* storage blocked */ }
    }
  }

  let seeking = false;
  let queueKey = '';

  function render(s: MusicState) {
    const bar = $('music-bar');
    if (!bar) return;
    const empty = s.queue.length === 0;
    bar.hidden = empty;
    // Nothing to play (empty queue, no site playlist to cue): no button either
    const fab = $('music-fab')!;
    fab.hidden = empty;
    fab.classList.toggle('is-playing', s.playing);
    const fabLabel = s.playing ? 'Music player (playing)' : 'Music player';
    if (fab.getAttribute('aria-label') !== fabLabel) fab.setAttribute('aria-label', fabLabel);
    const panel = $('music-panel')!;
    const expand = $('music-expand')!;
    if (empty) {
      panel.hidden = true;
      expand.setAttribute('aria-expanded', 'false');
    }
    // No YouTube track: no tile. A paused YouTube track: collapsed, iframe kept (never display:none,
    // so the player is not reloaded); shown again before playback resumes.
    const ytTile = $('music-yt-tile')!;
    const cur = s.queue[s.index];
    const isYt = !!cur && cur.kind !== 'file';
    ytTile.hidden = !isYt;
    ytTile.classList.toggle('is-idle', isYt && !s.youtubeVisible);
    ytTile.setAttribute('aria-hidden', String(!s.youtubeVisible));
    renderProgress(empty ? null : s);
    if (empty) return;

    const title = $('music-title')!;
    title.textContent = s.videoTitle ?? cur?.title ?? '';
    title.title = title.textContent;
    $('music-panel-title')!.textContent = title.textContent;

    const toggle = $('music-toggle')!;
    toggle.classList.toggle('is-playing', s.playing);
    toggle.setAttribute('aria-label', s.playing ? 'Pause' : 'Play');
    toggle.title = s.playing ? 'Pause' : 'Play';

    const vol = $<HTMLInputElement>('music-volume')!;
    if (document.activeElement !== vol) vol.value = String(s.volume);

    if (!panel.hidden) renderPanel(s);
  }

  function renderProgress(s: MusicState | null) {
    const bar = $('music-progress');
    const fill = $('music-progress-fill');
    if (!bar || !fill) return;
    const show = !!s && s.duration > 0;
    if (bar.hidden === show) bar.hidden = !show;
    // Reset when hidden so the fill does not sweep backwards when the bar reappears
    const v = show ? Math.min(1, Math.max(0, s!.position / s!.duration)) : 0;
    const t = `scaleX(${v})`;
    if (fill.style.transform !== t) {
      if (!show) fill.style.transition = 'none'; else fill.style.transition = '';
      fill.style.transform = t;
    }
  }

  function renderPanel(s: MusicState) {
    const seek = $<HTMLInputElement>('music-seek')!;
    seek.max = String(s.duration || 0);
    if (!seeking) seek.value = String(s.position);
    $('music-pos')!.textContent = fmt(seeking ? Number(seek.value) : s.position);
    $('music-dur')!.textContent = fmt(s.duration);
    $('music-source')!.textContent = s.source?.name ?? '';

    const shuffle = $('music-shuffle')!;
    shuffle.setAttribute('aria-pressed', String(s.shuffle));
    const repeat = $('music-repeat')!;
    repeat.setAttribute('aria-pressed', String(s.repeat !== 'off'));
    repeat.setAttribute('aria-label', REPEAT_LABEL[s.repeat]);
    repeat.title = REPEAT_LABEL[s.repeat];
    $('music-repeat-one')!.hidden = s.repeat !== 'one';

    const key = s.queue.map((t) => t.id).join('|') + '#' + s.index;
    if (key === queueKey) return;
    queueKey = key;
    const list = $('music-queue')!;
    list.replaceChildren(...s.queue.map((t, i) => {
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.type = 'button';
      b.dataset.index = String(i);
      if (i === s.index) b.setAttribute('aria-current', 'true');
      const n = document.createElement('span');
      n.className = 'music-q-n';
      n.textContent = String(i + 1);
      const tt = document.createElement('span');
      tt.className = 'music-q-t';
      tt.textContent = t.title;
      b.append(n, tt);
      b.setAttribute('aria-label', `Play ${t.title}`);
      li.append(b);
      return li;
    }));
    list.querySelector('[aria-current="true"]')?.scrollIntoView({ block: 'nearest' });
  }

  function bind() {
    const root = $('music-root');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    $('music-prev')!.addEventListener('click', () => music.prev());
    $('music-prev-p')!.addEventListener('click', () => music.prev());
    $('music-toggle')!.addEventListener('click', () => music.toggle());
    $('music-next')!.addEventListener('click', () => music.next());
    // ✕ stops, clears the queue and shuts the player (the site playlist is cued again)
    const close = () => {
      music.stop();
      setOpen(false);
      $('music-fab')?.focus();
    };
    $('music-close')!.addEventListener('click', close);
    $('music-close-p')!.addEventListener('click', close);
    let open = false;
    try { open = localStorage.getItem(OPEN_KEY) === '1'; } catch { /* storage blocked */ }
    setOpen(open, false);
    $('music-fab')!.addEventListener('click', () => setOpen(!root.classList.contains('is-open')));
    // Playback asked for anywhere (Tools → Music, DM screen, media keys): the player slides open
    document.addEventListener(MUSIC_PLAY_EVENT, () => setOpen(true));
    $('music-volume')!.addEventListener('input', (e) => music.setVolume(Number((e.target as HTMLInputElement).value)));
    $('music-expand')!.addEventListener('click', () => {
      const panel = $('music-panel')!;
      panel.hidden = !panel.hidden;
      $('music-expand')!.setAttribute('aria-expanded', String(!panel.hidden));
      queueKey = '';
      if (!panel.hidden) renderPanel(music.getState());
    });
    const tile = $('music-yt-tile')!;
    let small = false;
    try { small = localStorage.getItem(YT_SMALL_KEY) === '1'; } catch { /* storage blocked */ }
    const sizeTile = () => {
      tile.classList.toggle('is-small', small);
      const label = small ? 'Enlarge video' : 'Shrink video';
      const btn = $('music-yt-size')!;
      btn.setAttribute('aria-label', label);
      btn.title = label;
    };
    sizeTile();
    $('music-yt-size')!.addEventListener('click', () => {
      small = !small;
      try { localStorage.setItem(YT_SMALL_KEY, small ? '1' : '0'); } catch { /* storage blocked */ }
      sizeTile();
    });
    $('music-shuffle')!.addEventListener('click', () => music.setShuffle(!music.getState().shuffle));
    $('music-repeat')!.addEventListener('click', () => music.setRepeat(REPEAT_NEXT[music.getState().repeat]));
    const seek = $<HTMLInputElement>('music-seek')!;
    seek.addEventListener('input', () => {
      seeking = true;
      $('music-pos')!.textContent = fmt(Number(seek.value));
    });
    seek.addEventListener('change', () => {
      seeking = false;
      music.seek(Number(seek.value));
    });
    $('music-queue')!.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-index]');
      if (b) music.jump(Number(b.dataset.index));
    });
    document.addEventListener(MUSIC_STATE_EVENT, (e) => render((e as CustomEvent<MusicState>).detail));
  }

  bind();
  render(music.getState());
  document.addEventListener('astro:page-load', () => {
    bind();
    render(music.getState());
  });
</script>

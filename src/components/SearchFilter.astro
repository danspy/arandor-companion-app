---
interface FilterOption {
  id: string;
  label: string;
  count: number;
  active?: boolean;
}

interface Props {
  searchPlaceholder: string;
  filters: FilterOption[];
  searchInputId?: string;
  filterClass?: string;
}

const { 
  searchPlaceholder, 
  filters, 
  searchInputId = 'searchInput',
  filterClass = 'filter-btn'
} = Astro.props;
---

<div class="bg-white dark:bg-black rounded-lg shadow-md p-4 mb-6 dark:border dark:border-gray-900">
  <div class="flex flex-col gap-3">
    <!-- Search Input - Always Full Width -->
    <div class="relative w-full">
      <input 
        type="text" 
        id={searchInputId}
        placeholder={searchPlaceholder}
        class="w-full px-4 py-2 pl-10 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100 transition"
      />
      <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>
    <!-- Filter Tags Below -->
    <div class="flex flex-wrap gap-2 items-center">
      <span class="text-sm text-gray-600 dark:text-gray-400 font-medium">Filter:</span>
      {filters.map(filter => (
        <button 
          class={`${filterClass} px-3 py-1.5 rounded-full text-sm font-medium transition-all duration-200 active:scale-95 ${
            filter.active 
              ? 'bg-primary-600 text-white hover:bg-primary-700' 
              : 'bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md'
          }`}
          data-filter={filter.id}
        >
          {filter.label} ({filter.count})
        </button>
      ))}
    </div>
  </div>
</div>

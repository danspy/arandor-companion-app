import Button from './Button.astro';
---
interface Props {
  title: string;
  heroImageUrl?: string | null;
  pageName: string;
  canEditHero: boolean;
}

const { title, heroImageUrl, pageName, canEditHero } = Astro.props;
---

{heroImageUrl ? (
  <div class="relative mb-8 rounded-lg overflow-hidden shadow-lg">
    <img 
      src={heroImageUrl} 
      alt={`${title} Hero`}
      class="w-full h-64 md:h-80 lg:h-96 object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent flex items-end">
      <div class="p-8">
        <h1 class="text-4xl md:text-5xl font-bold text-white drop-shadow-lg">{title}</h1>
      </div>
    </div>
    {canEditHero && (
      <button 
        class="edit-hero-btn absolute top-4 right-4 px-3 py-2 bg-white/90 hover:bg-white dark:bg-gray-800/90 dark:hover:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-lg transition text-sm shadow-lg flex items-center gap-2"
        data-page-name={pageName}
        title="Edit hero image"
      >
        <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <span>Edit</span>
      </button>
    )}
  </div>
) : (
  <div class="mb-8">
    <div class="flex justify-between items-center">
      <h1 class="text-4xl font-bold text-primary-700 dark:text-primary-400">{title}</h1>
      {canEditHero && (
        <button 
          class="edit-hero-btn text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 transition text-sm flex items-center gap-2 font-medium"
          data-page-name={pageName}
          title="Add hero image"
        >
          <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>Add Hero Image</span>
        </button>
      )}
    </div>
  </div>
)}

<!-- Hero Image Modal -->
{canEditHero && (
  <div id={`heroModal-${pageName}`} class="hero-modal hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-md w-full p-6 dark:border dark:border-gray-700">
      <div class="flex justify-between items-center mb-6">
        <h3 class="text-xl font-semibold text-primary-700 dark:text-primary-400">Hero Image</h3>
        <button class="close-hero-modal text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200" data-page-name={pageName}>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      
      <form class="hero-form space-y-4" data-page-name={pageName}>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
            Upload Hero Image
          </label>
          <input 
            type="file" 
            accept="image/*"
            class="hero-file-input w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-gray-100 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-primary-50 file:text-primary-700 hover:file:bg-primary-100 dark:file:bg-primary-900/20 dark:file:text-primary-400"
            data-page-name={pageName}
          />
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Upload an image file (max 5MB)</p>
        </div>
        
        <div class="relative">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-gray-300 dark:border-gray-600"></div>
          </div>
          <div class="relative flex justify-center text-sm">
            <span class="px-2 bg-white dark:bg-gray-800 text-gray-500 dark:text-gray-400">OR</span>
          </div>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
            Hero Image URL
          </label>
          <input 
            type="text" 
            class="hero-url-input w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-gray-100"
            value={heroImageUrl || ''}
            placeholder="https://example.com/hero-image.jpg or /uploads/image.jpg"
            data-page-name={pageName}
          />
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Or provide an image URL (absolute or relative)</p>
        </div>
        
        <div class="flex gap-3 pt-4">
          <button 
            type="submit" 
            class="hero-submit-btn flex-1 bg-primary-600 hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 text-white px-4 py-2 rounded-lg transition"
            data-page-name={pageName}
          >
            <span class="hero-submit-text">Save</span>
            <span class="hero-submit-loading hidden">
              <svg class="animate-spin inline-block h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Uploading...
            </span>
          </button>
          <button 
            type="button" 
            class="cancel-hero-btn flex-1 bg-gray-300 hover:bg-gray-400 dark:bg-gray-600 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 px-4 py-2 rounded-lg transition"
            data-page-name={pageName}
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
)}

<script>
  // Initialize hero image modals for all pages
  function initializePageHero() {
    // Handle edit button clicks
    document.querySelectorAll('.edit-hero-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const pageName = btn.getAttribute('data-page-name');
        const modal = document.getElementById(`heroModal-${pageName}`);
        modal?.classList.remove('hidden');
      });
    });

    // Handle close button clicks
    document.querySelectorAll('.close-hero-modal').forEach(btn => {
      btn.addEventListener('click', () => {
        const pageName = btn.getAttribute('data-page-name');
        const modal = document.getElementById(`heroModal-${pageName}`);
        modal?.classList.add('hidden');
      });
    });

    // Handle cancel button clicks
    document.querySelectorAll('.cancel-hero-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const pageName = btn.getAttribute('data-page-name');
        const modal = document.getElementById(`heroModal-${pageName}`);
        modal?.classList.add('hidden');
      });
    });

    // Handle modal background clicks
    document.querySelectorAll('.hero-modal').forEach(modal => {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.add('hidden');
        }
      });
    });

    // Handle form submissions
    document.querySelectorAll('.hero-form').forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const pageName = form.getAttribute('data-page-name');
        const urlInput = form.querySelector('.hero-url-input');
        const fileInput = form.querySelector('.hero-file-input');
        const submitBtn = form.querySelector('.hero-submit-btn');
        const submitText = submitBtn?.querySelector('.hero-submit-text');
        const submitLoading = submitBtn?.querySelector('.hero-submit-loading');
        
        let heroImageUrl = urlInput?.value || null;

        // Show loading state
        if (submitBtn) submitBtn.disabled = true;
        if (submitText) submitText.classList.add('hidden');
        if (submitLoading) submitLoading.classList.remove('hidden');

        try {
          // If a file was selected, upload it first
          if (fileInput?.files && fileInput.files.length > 0) {
            const formData = new FormData();
            formData.append('file', fileInput.files[0]);

            const uploadResponse = await fetch('/api/upload', {
              method: 'POST',
              body: formData,
            });

            if (!uploadResponse.ok) {
              alert('Failed to upload image');
              // Reset button state on error
              if (submitBtn) submitBtn.disabled = false;
              if (submitText) submitText.classList.remove('hidden');
              if (submitLoading) submitLoading.classList.add('hidden');
              return;
            }

            const uploadData = await uploadResponse.json();
            heroImageUrl = uploadData.url;
          }

          // Update page settings with the image URL
          const response = await fetch(`/api/page-settings/${pageName}`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ heroImageUrl }),
          });

          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to update hero image');
            // Reset button state on error
            if (submitBtn) submitBtn.disabled = false;
            if (submitText) submitText.classList.remove('hidden');
            if (submitLoading) submitLoading.classList.add('hidden');
          }
        } catch (error) {
          console.error('Error updating hero image:', error);
          alert('Failed to update hero image');
          // Reset button state on error
          if (submitBtn) submitBtn.disabled = false;
          if (submitText) submitText.classList.remove('hidden');
          if (submitLoading) submitLoading.classList.add('hidden');
        }
      });
    });
  }

  // Run on initial page load and after View Transitions navigation
  document.addEventListener('astro:page-load', initializePageHero);
</script>

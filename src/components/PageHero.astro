---
import Button from './Button.astro';

interface Props {
  title: string;
  heroImageUrl?: string | null;
  pageName: string;
  canEditHero: boolean;
}

const { title, heroImageUrl, pageName, canEditHero } = Astro.props;
---

{heroImageUrl ? (
  <div class="relative mb-8 rounded-xl overflow-hidden shadow-xl">
    <img
      src={heroImageUrl}
      alt={`${title} Hero`}
      class="w-full h-56 md:h-72 lg:h-88 object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent flex items-end">
      <div class="p-6 md:p-8">
        <h1 class="font-display text-3xl md:text-4xl lg:text-5xl font-semibold text-white tracking-wide drop-shadow-lg">{title}</h1>
      </div>
    </div>
    {canEditHero && (
      <button
        class="edit-hero-btn absolute top-4 right-4 px-3 py-1.5 bg-black/40 hover:bg-black/60 text-white/80 hover:text-white backdrop-blur-sm rounded-lg transition text-xs flex items-center gap-1.5 border border-white/10"
        data-page-name={pageName}
        title="Edit hero image"
      >
        <svg class="w-3.5 h-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <span>Edit</span>
      </button>
    )}
  </div>
) : (
  <div class="mb-8">
    <div class="flex justify-between items-start gap-4">
      <h1 class="font-display text-3xl md:text-4xl font-semibold text-primary-700 dark:text-primary-300 tracking-wide">{title}</h1>
      {canEditHero && (
        <button
          class="edit-hero-btn shrink-0 mt-1 text-xs text-secondary-600 hover:text-secondary-500 dark:text-secondary-500 dark:hover:text-secondary-400 transition flex items-center gap-1.5 font-medium"
          data-page-name={pageName}
          title="Add hero image"
        >
          <svg class="w-3.5 h-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>Add Hero</span>
        </button>
      )}
    </div>
  </div>
)}

<!-- Hero Image Modal -->
{canEditHero && (
  <div id={`heroModal-${pageName}`} class="hero-modal hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 modal-overlay-safe">
    <div class="bg-[var(--bg-card)] rounded-xl shadow-2xl max-w-md w-full p-6 border border-[var(--border-subtle)] modal-content-safe">
      <div class="flex justify-between items-center mb-5">
        <h3 class="font-display text-lg font-semibold text-primary-700 dark:text-primary-300 tracking-wide">Hero Image</h3>
        <button class="close-hero-modal text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition" data-page-name={pageName}>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <form class="hero-form space-y-4" data-page-name={pageName}>
        <div>
          <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">
            Upload Image
          </label>
          <input
            type="file"
            accept="image/*"
            class="hero-file-input w-full px-3 py-2 border border-[var(--border-subtle)] rounded-lg focus:ring-2 focus:ring-secondary-500 focus:border-secondary-500 bg-[var(--bg-page)] text-sm file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-medium file:bg-secondary-600 file:text-white hover:file:bg-secondary-700 transition"
            data-page-name={pageName}
          />
          <p class="text-xs text-gray-400 mt-1">Max 5MB</p>
        </div>

        <div class="relative">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-[var(--border-subtle)]"></div>
          </div>
          <div class="relative flex justify-center text-xs">
            <span class="px-2 bg-[var(--bg-card)] text-gray-400 uppercase tracking-wider">or</span>
          </div>
        </div>

        <div>
          <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">
            Image URL
          </label>
          <input
            type="text"
            class="hero-url-input w-full px-3 py-2 border border-[var(--border-subtle)] rounded-lg focus:ring-2 focus:ring-secondary-500 focus:border-secondary-500 bg-[var(--bg-page)] text-sm"
            value={heroImageUrl || ''}
            placeholder="https://... or /uploads/..."
            data-page-name={pageName}
          />
        </div>

        <div class="flex gap-3 pt-2">
          <button
            type="submit"
            class="hero-submit-btn flex-1 bg-secondary-600 hover:bg-secondary-700 text-white px-4 py-2 rounded-lg transition text-sm font-medium"
            data-page-name={pageName}
          >
            <span class="hero-submit-text">Save</span>
            <span class="hero-submit-loading hidden">
              <svg class="animate-spin inline-block h-4 w-4 mr-1.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Saving...
            </span>
          </button>
          <button
            type="button"
            class="cancel-hero-btn flex-1 border border-[var(--border-subtle)] hover:bg-gray-100 dark:hover:bg-white/5 text-gray-600 dark:text-gray-300 px-4 py-2 rounded-lg transition text-sm"
            data-page-name={pageName}
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
)}

<script>
  // Initialize hero image modals for all pages
  function initializePageHero() {
    // Handle edit button clicks
    document.querySelectorAll('.edit-hero-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const pageName = btn.getAttribute('data-page-name');
        const modal = document.getElementById(`heroModal-${pageName}`);
        modal?.classList.remove('hidden');
      });
    });

    // Handle close button clicks
    document.querySelectorAll('.close-hero-modal').forEach(btn => {
      btn.addEventListener('click', () => {
        const pageName = btn.getAttribute('data-page-name');
        const modal = document.getElementById(`heroModal-${pageName}`);
        modal?.classList.add('hidden');
      });
    });

    // Handle cancel button clicks
    document.querySelectorAll('.cancel-hero-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const pageName = btn.getAttribute('data-page-name');
        const modal = document.getElementById(`heroModal-${pageName}`);
        modal?.classList.add('hidden');
      });
    });

    // Handle modal background clicks
    document.querySelectorAll('.hero-modal').forEach(modal => {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.add('hidden');
        }
      });
    });

    // Handle form submissions
    document.querySelectorAll('.hero-form').forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const pageName = form.getAttribute('data-page-name');
        const urlInput = form.querySelector('.hero-url-input');
        const fileInput = form.querySelector('.hero-file-input');
        const submitBtn = form.querySelector('.hero-submit-btn');
        const submitText = submitBtn?.querySelector('.hero-submit-text');
        const submitLoading = submitBtn?.querySelector('.hero-submit-loading');

        let heroImageUrl = urlInput?.value || null;

        if (submitBtn) submitBtn.disabled = true;
        if (submitText) submitText.classList.add('hidden');
        if (submitLoading) submitLoading.classList.remove('hidden');

        try {
          if (fileInput?.files && fileInput.files.length > 0) {
            const formData = new FormData();
            formData.append('file', fileInput.files[0]);

            const uploadResponse = await fetch('/api/upload', {
              method: 'POST',
              body: formData,
            });

            if (!uploadResponse.ok) {
              alert('Failed to upload image');
              if (submitBtn) submitBtn.disabled = false;
              if (submitText) submitText.classList.remove('hidden');
              if (submitLoading) submitLoading.classList.add('hidden');
              return;
            }

            const uploadData = await uploadResponse.json();
            heroImageUrl = uploadData.url;
          }

          const response = await fetch(`/api/page-settings/${pageName}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ heroImageUrl }),
          });

          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to update hero image');
            if (submitBtn) submitBtn.disabled = false;
            if (submitText) submitText.classList.remove('hidden');
            if (submitLoading) submitLoading.classList.add('hidden');
          }
        } catch (error) {
          console.error('Error updating hero image:', error);
          alert('Failed to update hero image');
          if (submitBtn) submitBtn.disabled = false;
          if (submitText) submitText.classList.remove('hidden');
          if (submitLoading) submitLoading.classList.add('hidden');
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initializePageHero);
</script>

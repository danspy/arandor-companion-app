---
// Page header used across the app: a full-width scene under the (transparent) nav, the
// page title over it, an optional one-line summary and the page's main action.
// Pages without their own image borrow the campaign image, dimmed.
import { db, CampaignProgress } from '@/db';

interface Props {
  title: string;
  heroImageUrl?: string | null;
  pageName: string;
  canEditHero: boolean;
  /** One short line under the title, e.g. "57 NPCs, 19 of them allies". */
  subtitle?: string;
  /** Lower scene for tool pages that need the room below. */
  compact?: boolean;
}

const { title, heroImageUrl, pageName, canEditHero, subtitle, compact = false } = Astro.props;
const fallbackImage = heroImageUrl
  ? null
  : (await db.select({ url: CampaignProgress.heroImageUrl }).from(CampaignProgress).limit(1))[0]?.url ?? null;
const image = heroImageUrl || fallbackImage;
const hasActions = Astro.slots.has('actions');
---

<section class:list={['scene-hero', { 'scene-hero-compact': compact, 'scene-hero-borrowed': !heroImageUrl }]} data-immersive-hero>
  <div class="scene-hero-bg" aria-hidden="true">
    {image && <img src={image} alt="" fetchpriority="high" />}
  </div>

  {canEditHero && (
    <button class="edit-hero-btn scene-hero-edit" data-page-name={pageName} title={heroImageUrl ? 'Change the header image' : 'Set a header image for this page'}>
      <svg class="w-3.5 h-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      {heroImageUrl ? 'Change image' : 'Add image'}
    </button>
  )}

  <div class="scene-hero-content container mx-auto px-4 sm:px-6">
    <div class="scene-hero-text">
      <h1 class="scene-hero-title">{title}</h1>
      {subtitle && <p class="scene-hero-sub">{subtitle}</p>}
    </div>
    {hasActions && <div class="scene-hero-actions"><slot name="actions" /></div>}
  </div>
</section>

<style>
  /* Pull the scene up under the sticky nav (60px) and main's top padding (2rem). */
  .scene-hero {
    --hero-pull: calc(2rem + 60px);
    position: relative;
    /* --page-w: the viewport minus a side panel that pushes the page (statblock.css) */
    width: var(--page-w, 100vw);
    margin-left: calc(50% - var(--page-w, 100vw) / 2);
    margin-top: calc(-1 * var(--hero-pull));
    margin-bottom: 1.75rem;
    min-height: clamp(16rem, 42svh, 25rem);
    display: flex;
    align-items: flex-end;
    isolation: isolate;
  }
  .scene-hero-compact { min-height: clamp(11rem, 26svh, 14rem); }
  @media (display-mode: standalone) and (max-width: 1024px) {
    .scene-hero { --hero-pull: calc(2rem + var(--safe-top)); }
  }

  .scene-hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: radial-gradient(ellipse at 70% 20%, rgba(201, 144, 50, 0.25), transparent 60%), #120d07;
    /* Fade into the page instead of ending on a hard edge. */
    -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
  }
  .scene-hero-bg img { width: 100%; height: 100%; object-fit: cover; }
  .scene-hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(8, 6, 3, 0.55) 0%, transparent 30%),
      linear-gradient(to top, rgba(8, 6, 3, 0.6) 0%, rgba(8, 6, 3, 0.15) 60%, transparent 100%);
  }
  /* A borrowed campaign image is muted so each page's own image stays special. */
  .scene-hero-borrowed .scene-hero-bg img { filter: saturate(0.55) brightness(0.55) blur(2px); transform: scale(1.04); }

  .scene-hero-edit {
    position: absolute;
    top: calc(var(--hero-pull) + 0.25rem);
    right: 1rem;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    border-radius: 2px;
    background: rgba(8, 6, 3, 0.55);
    border: 1px solid rgba(201, 144, 50, 0.3);
    color: rgba(242, 232, 213, 0.8);
    backdrop-filter: blur(8px);
  }
  .scene-hero-edit:hover { color: #ffd98a; border-color: #ffd98a; }

  .scene-hero-content {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    padding-top: calc(var(--hero-pull) + 2.5rem);
    padding-bottom: 3rem;
  }
  .scene-hero-text { min-width: 0; }
  .scene-hero-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 600;
    font-size: clamp(2.6rem, 8vw, 4.75rem);
    line-height: 1;
    color: #f2e8d5;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.7);
  }
  .scene-hero-compact .scene-hero-title { font-size: clamp(2.2rem, 6vw, 3.4rem); }
  .scene-hero-sub {
    margin-top: 0.5rem;
    max-width: 40rem;
    font-size: 0.95rem;
    color: rgba(242, 232, 213, 0.82);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.8);
  }
  .scene-hero-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
</style>

<!-- Hero Image Modal -->
{canEditHero && (
  <div id={`heroModal-${pageName}`} class="hero-modal hidden fixed inset-0 z-50 flex items-center justify-center p-4 modal-overlay-safe" style="background: rgba(0,0,0,0.7); backdrop-filter: blur(4px);">
    <div class="t-modal-panel max-w-md w-full p-6 modal-content-safe">
      <div class="flex justify-between items-center mb-5">
        <h3 class="font-display italic font-semibold text-xl" style="color: var(--text-strong);">Hero Image</h3>
        <button class="close-hero-modal transition-colors" style="color: var(--text-muted);" data-page-name={pageName}>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <form class="hero-form space-y-4" data-page-name={pageName}>
        <div>
          <label class="block text-xs font-medium uppercase tracking-wider mb-2" style="color: var(--text-muted);">Upload Image</label>
          <input
            type="file"
            accept="image/*"
            class="hero-file-input w-full px-3 py-2 rounded-xs text-sm transition-colors"
            style="background: var(--bg-surface); border: 1px solid var(--border); color: var(--text-body);"
            data-page-name={pageName}
          />
          <p class="text-xs mt-1" style="color: var(--text-faint);">Max 5MB</p>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex-1 h-px" style="background: var(--border);"></div>
          <span class="text-xs uppercase tracking-wider" style="color: var(--text-faint);">or</span>
          <div class="flex-1 h-px" style="background: var(--border);"></div>
        </div>

        <div>
          <label class="block text-xs font-medium uppercase tracking-wider mb-2" style="color: var(--text-muted);">Image URL</label>
          <input
            type="text"
            class="hero-url-input w-full px-3 py-2 rounded-xs text-sm transition-colors"
            style="background: var(--bg-surface); border: 1px solid var(--border); color: var(--text-body);"
            value={heroImageUrl || ''}
            placeholder="https://... or /uploads/..."
            data-page-name={pageName}
          />
        </div>

        <div class="flex gap-3 pt-1">
          <button
            type="submit"
            class="hero-submit-btn flex-1 px-4 py-2.5 rounded-xs text-sm font-medium transition-all"
            style="background: var(--accent); color: #fff;"
            data-page-name={pageName}
          >
            <span class="hero-submit-text">Save</span>
            <span class="hero-submit-loading hidden">
              <svg class="animate-spin inline-block h-4 w-4 mr-1.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Saving...
            </span>
          </button>
          <button
            type="button"
            class="cancel-hero-btn flex-1 px-4 py-2.5 rounded-xs text-sm transition-all"
            style="background: transparent; border: 1px solid var(--border); color: var(--text-muted);"
            data-page-name={pageName}
          >Cancel</button>
        </div>
      </form>
    </div>
  </div>
)}

<script>
  function initializePageHero() {
    document.querySelectorAll('.edit-hero-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const pageName = btn.getAttribute('data-page-name');
        document.getElementById(`heroModal-${pageName}`)?.classList.remove('hidden');
      });
    });
    document.querySelectorAll('.close-hero-modal, .cancel-hero-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const pageName = btn.getAttribute('data-page-name');
        document.getElementById(`heroModal-${pageName}`)?.classList.add('hidden');
      });
    });
    document.querySelectorAll('.hero-modal').forEach(modal => {
      modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.add('hidden'); });
    });
    document.querySelectorAll('.hero-form').forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const pageName = form.getAttribute('data-page-name');
        const urlInput = form.querySelector('.hero-url-input');
        const fileInput = form.querySelector('.hero-file-input');
        const submitBtn = form.querySelector('.hero-submit-btn');
        const submitText = submitBtn?.querySelector('.hero-submit-text');
        const submitLoading = submitBtn?.querySelector('.hero-submit-loading');
        let heroImageUrl = urlInput?.value || null;
        if (submitBtn) submitBtn.disabled = true;
        if (submitText) submitText.classList.add('hidden');
        if (submitLoading) submitLoading.classList.remove('hidden');
        try {
          if (fileInput?.files && fileInput.files.length > 0) {
            const formData = new FormData();
            formData.append('file', fileInput.files[0]);
            const uploadResponse = await fetch('/api/upload', { method: 'POST', body: formData });
            if (!uploadResponse.ok) { alert('Failed to upload image'); return; }
            heroImageUrl = (await uploadResponse.json()).url;
          }
          const response = await fetch(`/api/page-settings/${pageName}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ heroImageUrl }),
          });
          if (response.ok) { window.arandorSoftReload(); }
          else { alert('Failed to update hero image'); }
        } catch (error) {
          console.error('Error updating hero image:', error);
          alert('Failed to update hero image');
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (submitText) submitText.classList.remove('hidden');
          if (submitLoading) submitLoading.classList.add('hidden');
        }
      });
    });
  }
  document.addEventListener('astro:page-load', initializePageHero);
</script>

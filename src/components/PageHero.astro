---
import Button from './Button.astro';

interface Props {
  title: string;
  heroImageUrl?: string | null;
  pageName: string;
  canEditHero: boolean;
}

const { title, heroImageUrl, pageName, canEditHero } = Astro.props;
---

{heroImageUrl ? (
  <div class="relative mb-10 rounded-2xl overflow-hidden" style="box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 0 0 1px var(--border);">
    <img
      src={heroImageUrl}
      alt={`${title} Hero`}
      class="w-full h-56 md:h-72 lg:h-88 object-cover"
    />
    <!-- Dramatic gradient overlay -->
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(8,6,3,0.85) 0%, rgba(8,6,3,0.35) 45%, rgba(8,6,3,0.05) 100%);"></div>
    <!-- Orange ember line at bottom -->
    <div class="absolute bottom-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, var(--accent) 30%, var(--accent) 70%, transparent); opacity: 0.6;"></div>
    <div class="absolute inset-0 flex items-end">
      <div class="p-6 md:p-8 w-full">
        <h1 class="font-display italic font-semibold text-4xl md:text-5xl lg:text-6xl leading-tight" style="color: var(--text-strong); text-shadow: 0 2px 20px rgba(0,0,0,0.6);">{title}</h1>
      </div>
    </div>
    {canEditHero && (
      <button
        class="edit-hero-btn absolute top-4 right-4 flex items-center gap-1.5 px-3 py-1.5 rounded-xs text-xs font-medium transition-all"
        style="background: rgba(8,6,3,0.65); border: 1px solid rgba(201,144,50,0.3); color: rgba(242,232,213,0.7); backdrop-filter: blur(8px);"
        data-page-name={pageName}
        title="Edit hero image"
      >
        <svg class="w-3.5 h-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        Edit
      </button>
    )}
  </div>
) : (
  <div class="mb-10">
    <div class="flex flex-wrap justify-between items-start gap-4">
      <h1 class="font-display italic font-semibold text-4xl md:text-5xl leading-tight" style="color: var(--text-strong);">{title}</h1>
      {canEditHero && (
        <button
          class="edit-hero-btn shrink-0 mt-2 flex items-center gap-1.5 text-xs font-medium transition-colors"
          style="color: var(--accent); opacity: 0.7;"
          data-page-name={pageName}
          title="Add hero image"
        >
          <svg class="w-3.5 h-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Add Hero
        </button>
      )}
    </div>
    <!-- Subtle underline rule -->
    <div class="mt-4 h-px" style="background: linear-gradient(90deg, var(--accent) 0%, var(--border-gold) 40%, transparent 100%); max-width: 320px;"></div>
  </div>
)}

<!-- Hero Image Modal -->
{canEditHero && (
  <div id={`heroModal-${pageName}`} class="hero-modal hidden fixed inset-0 z-50 flex items-center justify-center p-4 modal-overlay-safe" style="background: rgba(0,0,0,0.7); backdrop-filter: blur(4px);">
    <div class="max-w-md w-full p-6 rounded-2xl shadow-2xl modal-content-safe" style="background: var(--bg-raised); border: 1px solid var(--border-gold);">
      <div class="flex justify-between items-center mb-5">
        <h3 class="font-display italic font-semibold text-xl" style="color: var(--text-strong);">Hero Image</h3>
        <button class="close-hero-modal transition-colors" style="color: var(--text-muted);" data-page-name={pageName}>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <form class="hero-form space-y-4" data-page-name={pageName}>
        <div>
          <label class="block text-xs font-medium uppercase tracking-wider mb-2" style="color: var(--text-muted);">Upload Image</label>
          <input
            type="file"
            accept="image/*"
            class="hero-file-input w-full px-3 py-2 rounded-xs text-sm transition-colors"
            style="background: var(--bg-surface); border: 1px solid var(--border); color: var(--text-body);"
            data-page-name={pageName}
          />
          <p class="text-xs mt-1" style="color: var(--text-faint);">Max 5MB</p>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex-1 h-px" style="background: var(--border);"></div>
          <span class="text-xs uppercase tracking-wider" style="color: var(--text-faint);">or</span>
          <div class="flex-1 h-px" style="background: var(--border);"></div>
        </div>

        <div>
          <label class="block text-xs font-medium uppercase tracking-wider mb-2" style="color: var(--text-muted);">Image URL</label>
          <input
            type="text"
            class="hero-url-input w-full px-3 py-2 rounded-xs text-sm transition-colors"
            style="background: var(--bg-surface); border: 1px solid var(--border); color: var(--text-body);"
            value={heroImageUrl || ''}
            placeholder="https://... or /uploads/..."
            data-page-name={pageName}
          />
        </div>

        <div class="flex gap-3 pt-1">
          <button
            type="submit"
            class="hero-submit-btn flex-1 px-4 py-2.5 rounded-xs text-sm font-medium transition-all"
            style="background: var(--accent); color: #fff;"
            data-page-name={pageName}
          >
            <span class="hero-submit-text">Save</span>
            <span class="hero-submit-loading hidden">
              <svg class="animate-spin inline-block h-4 w-4 mr-1.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Saving...
            </span>
          </button>
          <button
            type="button"
            class="cancel-hero-btn flex-1 px-4 py-2.5 rounded-xs text-sm transition-all"
            style="background: transparent; border: 1px solid var(--border); color: var(--text-muted);"
            data-page-name={pageName}
          >Cancel</button>
        </div>
      </form>
    </div>
  </div>
)}

<script>
  function initializePageHero() {
    document.querySelectorAll('.edit-hero-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const pageName = btn.getAttribute('data-page-name');
        document.getElementById(`heroModal-${pageName}`)?.classList.remove('hidden');
      });
    });
    document.querySelectorAll('.close-hero-modal, .cancel-hero-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const pageName = btn.getAttribute('data-page-name');
        document.getElementById(`heroModal-${pageName}`)?.classList.add('hidden');
      });
    });
    document.querySelectorAll('.hero-modal').forEach(modal => {
      modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.add('hidden'); });
    });
    document.querySelectorAll('.hero-form').forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const pageName = form.getAttribute('data-page-name');
        const urlInput = form.querySelector('.hero-url-input');
        const fileInput = form.querySelector('.hero-file-input');
        const submitBtn = form.querySelector('.hero-submit-btn');
        const submitText = submitBtn?.querySelector('.hero-submit-text');
        const submitLoading = submitBtn?.querySelector('.hero-submit-loading');
        let heroImageUrl = urlInput?.value || null;
        if (submitBtn) submitBtn.disabled = true;
        if (submitText) submitText.classList.add('hidden');
        if (submitLoading) submitLoading.classList.remove('hidden');
        try {
          if (fileInput?.files && fileInput.files.length > 0) {
            const formData = new FormData();
            formData.append('file', fileInput.files[0]);
            const uploadResponse = await fetch('/api/upload', { method: 'POST', body: formData });
            if (!uploadResponse.ok) { alert('Failed to upload image'); return; }
            heroImageUrl = (await uploadResponse.json()).url;
          }
          const response = await fetch(`/api/page-settings/${pageName}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ heroImageUrl }),
          });
          if (response.ok) { window.location.reload(); }
          else { alert('Failed to update hero image'); }
        } catch (error) {
          console.error('Error updating hero image:', error);
          alert('Failed to update hero image');
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (submitText) submitText.classList.remove('hidden');
          if (submitLoading) submitLoading.classList.add('hidden');
        }
      });
    });
  }
  document.addEventListener('astro:page-load', initializePageHero);
</script>

---
// Normal / Adv / Dis for the next d20 roll on the character page (src/lib/character-rolls.ts)
---
<div class="cs-mode" role="group" aria-label="Advantage for the next d20 roll">
  <button type="button" data-roll-mode="normal" aria-pressed="true">Normal</button>
  <button type="button" data-roll-mode="advantage" aria-pressed="false" title="Advantage on the next d20">Adv</button>
  <button type="button" data-roll-mode="disadvantage" aria-pressed="false" title="Disadvantage on the next d20">Dis</button>
</div>

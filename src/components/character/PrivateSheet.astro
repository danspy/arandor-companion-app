---
// Skills, attacks and the spellbook: only rendered for the player, the DM and admins
import type { CharacterSheet } from '../../lib/character-sheet';
import { d20, signed } from '../../lib/character-rolls';
import RollMode from './RollMode.astro';
import Spellbook from './Spellbook.astro';

interface Props { sheet: CharacterSheet }
const { sheet } = Astro.props;
const ABBR = { str: 'STR', dex: 'DEX', con: 'CON', int: 'INT', wis: 'WIS', cha: 'CHA' } as const;
const PROF_LABEL = { none: 'Not proficient', half: 'Half proficiency', proficient: 'Proficient', expertise: 'Expertise' } as const;
const rollable = (expr: string | null) => !!expr && /\d+d\d+/.test(expr);
// Sheets stored before the spellbook existed have none until the next sync
const book = sheet.spellbook ?? null;
---
<p class="cs-private-note t-faint text-xs mb-3">Only you, the DM and admins see the sections below.</p>

<section id="cs-skills" class="t-panel p-6 sm:p-8 mb-6">
  <div class="cs-head">
    <h2 class="t-section-h text-xl">Skills</h2>
    <RollMode />
  </div>
  <div class="cs-skills">
    {sheet.skills.map((s) => (
      <button type="button" class="cs-roll cs-skill" data-roll={d20(s.bonus)} data-roll-name={s.name} title={`${s.name} (${d20(s.bonus)}) · ${PROF_LABEL[s.proficiency]}`}>
        <span class={`cs-dot is-${s.proficiency}`} aria-hidden="true"></span>
        <span class="cs-skill-name">{s.name}</span>
        <span class="cs-skill-ab">{ABBR[s.ability]}</span>
        <span class="cs-skill-bonus">{signed(s.bonus)}</span>
      </button>
    ))}
  </div>
  <p class="t-faint text-xs mt-3">Passive Investigation {sheet.passiveInvestigation} · Passive Insight {sheet.passiveInsight}</p>
</section>

{sheet.attacks.length > 0 && (
  <section id="cs-attacks" class="t-panel p-6 sm:p-8 mb-6">
    <div class="cs-head">
      <h2 class="t-section-h text-xl">Attacks</h2>
      <RollMode />
    </div>
    {!book && sheet.spellcasting.length > 0 && (
      <p class="cs-casting">
        {sheet.spellcasting.map((c) => (
          <span><b>{c.className}</b> ({ABBR[c.ability]}): spell save DC <b>{c.saveDc}</b>, spell attack
            <button type="button" class="cs-roll cs-chip" data-roll={d20(c.attack)} data-roll-name={`${c.className} spell attack`}>{signed(c.attack)}</button>
          </span>
        ))}
      </p>
    )}
    <div class="cs-attacks">
      {sheet.attacks.map((a) => (
        <div class="cs-attack">
          <div class="cs-attack-main">
            <span class="cs-attack-name">{a.name}</span>
            <span class="cs-attack-meta">{[a.range, a.damageType, a.notes].filter(Boolean).join(' · ')}</span>
          </div>
          <div class="cs-attack-rolls">
            {a.toHit != null && (
              <button type="button" class="cs-roll cs-chip" data-roll={d20(a.toHit)} data-roll-label="To hit" data-roll-name={a.name}
                data-roll-damage={rollable(a.damage) ? a.damage : undefined} data-roll-damage-label={a.damageType || 'Damage'}
                title={`Attack: ${d20(a.toHit)}${rollable(a.damage) ? ` and ${a.damage} damage` : ''}`}>{signed(a.toHit)} to hit</button>
            )}
            {a.damage && (rollable(a.damage)
              ? <button type="button" class="cs-roll cs-chip cs-chip-dmg" data-roll={a.damage} data-roll-name={`${a.name} damage`} data-roll-label={a.damageType || 'Damage'} title={`Damage only (${a.damage})`}>{a.damage}</button>
              : <span class="cs-chip cs-chip-flat" title="Fixed damage">{a.damage}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>
)}

{book && <Spellbook spellbook={book} spellcasting={sheet.spellcasting} />}

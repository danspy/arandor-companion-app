---
// Floating dice button shown on every page. Dice roll over the whole page
// via the shared engine in src/lib/dice.ts.
const DICE = ['d4', 'd6', 'd8', 'd10', 'd12', 'd20', 'd100'];
---

<div id="dice-overlay" aria-hidden="true" transition:persist></div>

<div id="dice-result-banner" class="dice-banner" role="status" aria-live="polite" transition:persist>
  <button type="button" class="dice-banner-card" hidden>
    <span class="dice-banner-formula"></span>
    <span class="dice-banner-total"></span>
    <span class="dice-banner-detail"></span>
    <span class="dice-banner-crit"></span>
  </button>
</div>

<div id="dice-fab-root" class="dice-fab-root" transition:persist>
  <div id="dice-fab-panel" class="dice-fab-panel t-modal-panel" role="dialog" aria-label="Dice roller" hidden>
    <div class="flex items-center justify-between mb-3">
      <span class="t-section-h text-base">Roll the dice</span>
      <a href="/tools/dice-roller" class="t-link text-xs">Full roller →</a>
    </div>

    <div class="grid grid-cols-3 gap-2 mb-3">
      <button type="button" class="dice-quick" data-quick="normal">d20</button>
      <button type="button" class="dice-quick" data-quick="advantage" title="Roll 2d20, keep the highest">Advantage</button>
      <button type="button" class="dice-quick" data-quick="disadvantage" title="Roll 2d20, keep the lowest">Disadvantage</button>
    </div>

    <div class="grid grid-cols-4 gap-2">
      {DICE.map((d) => (
        <button type="button" class="dice-pick" data-die={d} title={`Add ${d} (right-click to remove)`}>
          {d}
          <span class="dice-pick-count" hidden>0</span>
        </button>
      ))}
      <button type="button" class="dice-pick dice-pick-reset" data-reset title="Reset dice, modifier and the table">Reset</button>
    </div>

    <div class="flex items-center justify-between gap-3 mt-3">
      <div class="flex items-center gap-1" role="group" aria-label="Modifier">
        <button type="button" class="dice-step" data-step="-1" aria-label="Decrease modifier">−</button>
        <input id="dice-fab-mod" type="number" value="0" class="t-input dice-mod" aria-label="Modifier" />
        <button type="button" class="dice-step" data-step="1" aria-label="Increase modifier">+</button>
      </div>
      <button type="button" id="dice-fab-roll" class="t-btn-primary flex-1 justify-center py-2" disabled>Roll</button>
    </div>
    <p id="dice-fab-formula" class="t-faint text-xs mt-2 text-center min-h-4"></p>
  </div>

  <button
    type="button"
    id="dice-fab"
    class="dice-fab"
    aria-label="Dice roller (hold to roll a d20)"
    aria-expanded="false"
    aria-controls="dice-fab-panel"
    title="Dice roller — hold to roll a d20"
  >
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2.5 20.5 7.25v9.5L12 21.5 3.5 16.75v-9.5Z" />
      <path d="M12 2.5 7.6 14.6h8.8Z M3.5 7.25l4.1 7.35M20.5 7.25l-4.1 7.35M7.6 14.6 12 21.5l4.4-6.9M3.5 16.75l4.1-2.15M20.5 16.75l-4.1-2.15" />
    </svg>
  </button>
</div>

<style is:global>
  #dice-overlay {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 10005;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  #dice-overlay canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }

  /* ── Result banner ── */
  .dice-banner {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) + 5rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 10006;
    pointer-events: none;
  }
  .dice-banner-card {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 11rem;
    padding: 0.75rem 1.5rem 0.9rem;
    background: var(--bg-raised);
    border: 1px solid var(--border-gold);
    border-radius: 2px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45), 0 0 30px var(--accent-glow);
    cursor: pointer;
    animation: dice-banner-in 0.35s cubic-bezier(0.2, 1.4, 0.4, 1) both;
  }
  .dice-banner-card[hidden] { display: none; }
  .dice-banner-formula { font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.04em; }
  .dice-banner-total {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--gold);
  }
  .dice-banner-detail { font-size: 0.75rem; color: var(--text-faint); }
  .dice-banner-detail s { opacity: 0.6; }
  .dice-banner-crit { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .dice-banner-crit:empty { display: none; }

  .dice-banner-card.is-crit-success { border-color: #10b981; box-shadow: 0 0 50px rgba(16, 185, 129, 0.55), 0 12px 40px rgba(0, 0, 0, 0.45); }
  .dice-banner-card.is-crit-success .dice-banner-total,
  .dice-banner-card.is-crit-success .dice-banner-crit { color: #10b981; }
  .dice-banner-card.is-crit-fail { border-color: #ef4444; animation: dice-banner-in 0.35s both, dice-shake 0.5s 0.3s both; }
  .dice-banner-card.is-crit-fail .dice-banner-total,
  .dice-banner-card.is-crit-fail .dice-banner-crit { color: #ef4444; }

  .dice-spark {
    position: fixed;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    pointer-events: none;
    z-index: 10007;
    animation: dice-spark 1.1s ease-out forwards;
  }

  @keyframes dice-banner-in {
    from { opacity: 0; transform: translateY(-12px) scale(0.85); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes dice-shake {
    0%, 100% { transform: none; }
    20% { transform: translateX(-8px) rotate(-2deg); }
    40% { transform: translateX(7px) rotate(2deg); }
    60% { transform: translateX(-5px); }
    80% { transform: translateX(3px); }
  }
  @keyframes dice-spark {
    from { opacity: 1; transform: translate(0, 0) rotate(0); }
    to   { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(540deg); }
  }

  /* ── Floating button ── */
  .dice-fab-root {
    --dice-fab-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    position: fixed;
    right: calc(16px + env(safe-area-inset-right, 0px));
    bottom: var(--dice-fab-bottom);
    z-index: 9990;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }
  .dice-fab-root[hidden] { display: none; }

  .dice-fab {
    width: 56px;
    height: 56px;
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-surface);
    border: 1px solid var(--border-gold);
    color: var(--gold);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3), 0 0 18px var(--accent-glow);
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
  }
  .dice-fab:hover { transform: rotate(-12deg) scale(1.06); border-color: var(--gold); box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35), 0 0 26px var(--accent-glow); }
  .dice-fab:active { transform: scale(0.94); }
  .dice-fab[aria-expanded='true'] { border-color: var(--gold); transform: rotate(90deg); }
  .dice-fab.is-rolling svg { animation: dice-fab-spin 0.7s linear infinite; }
  @keyframes dice-fab-spin { to { transform: rotate(360deg); } }

  .dice-fab-panel {
    width: min(320px, calc(100vw - 32px));
    max-height: calc(100dvh - var(--dice-fab-bottom) - 56px - 12px - env(safe-area-inset-top, 0px) - 16px);
    overflow-y: auto;
    padding: 1rem;
    transform-origin: bottom right;
    animation: dice-panel-in 0.2s ease-out both;
  }
  .dice-fab-panel[hidden] { display: none; }
  @keyframes dice-panel-in {
    from { opacity: 0; transform: translateY(8px) scale(0.96); }
    to   { opacity: 1; transform: none; }
  }

  .dice-quick,
  .dice-pick,
  .dice-step {
    position: relative;
    padding: 0.5rem 0.25rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-body);
    background: var(--bg-surface);
    border: 1px solid var(--border-gold);
    border-radius: 2px;
    cursor: pointer;
    transition: border-color 0.15s ease, transform 0.1s ease, background 0.15s ease;
    user-select: none;
  }
  .dice-quick:hover, .dice-pick:hover, .dice-step:hover { border-color: var(--gold); background: var(--accent-dim); }
  .dice-quick:active, .dice-pick:active, .dice-step:active { transform: scale(0.95); }
  .dice-quick[data-quick='normal'] { color: var(--gold); }
  .dice-pick-reset { color: var(--text-muted); font-weight: 500; }
  .dice-step { width: 2rem; padding-inline: 0; }
  .dice-mod { width: 3.25rem; padding: 0.4rem 0.25rem; text-align: center; }

  .dice-pick-count {
    position: absolute;
    top: -0.5rem;
    right: -0.4rem;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 0.25rem;
    border-radius: 2px;
    background: var(--gold);
    color: #fff;
    font-size: 0.7rem;
    line-height: 1.25rem;
  }
  .dice-pick-count[hidden] { display: none; }

  /* Installed app: the button becomes the gilt seal in the middle of the bottom bar
     (PWADock), and the panel opens centred above it. */
  @media (display-mode: standalone) and (max-width: 1024px) {
    .dice-fab-root {
      --dice-fab-bottom: calc(var(--pwa-dock-height) - 35px + env(safe-area-inset-bottom, 0px));
      left: 0;
      right: 0;
      width: max-content;
      margin: 0 auto;
      align-items: center;
      z-index: 9999;
    }
    .dice-fab {
      position: relative;
      width: 58px;
      height: 58px;
      background: none;
      border: 0;
      box-shadow: none;
      filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.55)) drop-shadow(0 0 12px rgba(201, 144, 50, 0.35));
      transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.2s ease, opacity 0.3s ease;
    }
    .dice-fab::before,
    .dice-fab::after {
      content: '';
      position: absolute;
      inset: 0;
      clip-path: polygon(50% 0, 93.3% 25%, 93.3% 75%, 50% 100%, 6.7% 75%, 6.7% 25%);
    }
    .dice-fab::before { background: linear-gradient(160deg, #f0c873, #c99032 45%, #7a5216); }
    .dice-fab::after { inset: 2px; background: radial-gradient(circle at 50% 30%, #2a1f12, #120d08 75%); }
    .dice-fab svg { position: relative; z-index: 1; width: 26px; height: 26px; }
    .dice-fab:hover { transform: none; box-shadow: none; }
    .dice-fab:active { transform: scale(0.9); }
    /* A hexagon turned by 180° lands on itself, so the seal "clicks" round when it opens. */
    .dice-fab[aria-expanded='true'] {
      transform: rotate(180deg);
      filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.55)) drop-shadow(0 0 18px rgba(201, 144, 50, 0.6));
    }
    /* While the bar is tucked away the seal drops to the bottom edge, smaller and dimmer. */
    .dice-fab-root { transition: bottom 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); }
    html.pwa-dock-tucked .dice-fab-root { --dice-fab-bottom: calc(10px + env(safe-area-inset-bottom, 0px)); }
    html.pwa-dock-tucked .dice-fab {
      transform: scale(0.72);
      opacity: 0.6;
      filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.6));
    }
    html.pwa-dock-tucked .dice-fab:active { transform: scale(0.66); }
    .dice-fab-panel {
      transform-origin: bottom center;
      max-height: calc(100dvh - var(--dice-fab-bottom) - 58px - 12px - env(safe-area-inset-top, 0px) - 16px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dice-banner-card, .dice-fab-panel, .dice-spark { animation: none !important; }
    .dice-fab, .dice-fab:hover, .dice-fab[aria-expanded='true'] { transition: none; transform: none; }
    .dice-fab-root { transition: none; }
  }
</style>

<script>
  import {
    DIE_TYPES,
    ROLL_EVENT,
    roll,
    warmUp,
    clearTable,
    formatSelection,
    diceCount,
    type DieType,
    type DiceSelection,
    type RollMode,
    type RollRecord,
  } from '../lib/dice';

  // Pages that have their own full dice UI hide the floating button.
  const HIDE_ON = ['/tools/dice-roller', '/display'];

  const root = document.getElementById('dice-fab-root') as HTMLDivElement;
  const fab = document.getElementById('dice-fab') as HTMLButtonElement;
  const panel = document.getElementById('dice-fab-panel') as HTMLDivElement;
  const rollBtn = document.getElementById('dice-fab-roll') as HTMLButtonElement;
  const modInput = document.getElementById('dice-fab-mod') as HTMLInputElement;
  const formulaEl = document.getElementById('dice-fab-formula') as HTMLParagraphElement;
  const bannerCard = document.querySelector('#dice-result-banner .dice-banner-card') as HTMLButtonElement;

  const selection: DiceSelection = {};
  let bannerTimer: ReturnType<typeof setTimeout> | null = null;

  const modifier = () => parseInt(modInput.value || '0') || 0;

  function updateVisibility() {
    const path = window.location.pathname;
    root.hidden = HIDE_ON.some((p) => path === p || path.startsWith(p + '/'));
    if (root.hidden) setOpen(false);
  }

  function setOpen(open: boolean) {
    panel.hidden = !open;
    fab.setAttribute('aria-expanded', String(open));
    if (open) warmUp();
  }

  function renderSelection() {
    for (const btn of panel.querySelectorAll<HTMLButtonElement>('.dice-pick[data-die]')) {
      const die = btn.dataset.die as DieType;
      const count = selection[die] ?? 0;
      const badge = btn.querySelector('.dice-pick-count') as HTMLSpanElement;
      badge.textContent = String(count);
      badge.hidden = count === 0;
    }
    const hasDice = diceCount(selection) > 0;
    rollBtn.disabled = !hasDice;
    formulaEl.textContent = hasDice ? formatSelection(selection, modifier()) : 'Pick dice, or tap a quick roll';
  }

  async function doRoll(sel: DiceSelection, mode: RollMode = 'normal') {
    fab.classList.add('is-rolling');
    try {
      await roll(sel, modifier(), mode);
    } finally {
      fab.classList.remove('is-rolling');
    }
  }

  // ── Result banner (shows results of rolls from anywhere, including the page) ──
  function sparks(origin: DOMRect, colors: string[]) {
    const cx = origin.left + origin.width / 2;
    const cy = origin.top + origin.height / 2;
    for (let i = 0; i < 28; i++) {
      const s = document.createElement('span');
      s.className = 'dice-spark';
      const angle = (Math.PI * 2 * i) / 28 + Math.random() * 0.3;
      const dist = 80 + Math.random() * 120;
      s.style.left = `${cx}px`;
      s.style.top = `${cy}px`;
      s.style.background = colors[i % colors.length];
      s.style.setProperty('--dx', `${Math.cos(angle) * dist}px`);
      s.style.setProperty('--dy', `${Math.sin(angle) * dist}px`);
      document.body.appendChild(s);
      s.addEventListener('animationend', () => s.remove());
    }
  }

  function showBanner(r: RollRecord) {
    const formula = bannerCard.querySelector('.dice-banner-formula') as HTMLSpanElement;
    const total = bannerCard.querySelector('.dice-banner-total') as HTMLSpanElement;
    const detail = bannerCard.querySelector('.dice-banner-detail') as HTMLSpanElement;
    const crit = bannerCard.querySelector('.dice-banner-crit') as HTMLSpanElement;

    formula.textContent = r.formula;
    total.textContent = String(r.total);
    detail.innerHTML = '';
    if (r.dice.length > 1 || r.modifier !== 0) {
      r.dice.forEach((d, i) => {
        if (i > 0) detail.append(' + ');
        const el = document.createElement(d.dropped ? 's' : 'span');
        el.textContent = String(d.value);
        detail.append(el);
      });
      if (r.modifier !== 0) detail.append(` ${r.modifier > 0 ? '+' : '−'} ${Math.abs(r.modifier)}`);
    }
    crit.textContent = r.crit === 'success' ? 'Natural 20!' : r.crit === 'fail' ? 'Critical fail' : '';

    // Restart the entrance animation.
    bannerCard.hidden = true;
    bannerCard.className = 'dice-banner-card';
    void bannerCard.offsetWidth;
    if (r.crit) bannerCard.classList.add(`is-crit-${r.crit}`);
    bannerCard.hidden = false;

    if (r.crit === 'success' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      sparks(bannerCard.getBoundingClientRect(), ['#c99032', '#f5d58a', '#10b981', '#fff7dc']);
    }

    if (bannerTimer) clearTimeout(bannerTimer);
    bannerTimer = setTimeout(() => (bannerCard.hidden = true), r.crit ? 6000 : 4500);
  }

  bannerCard.addEventListener('click', () => (bannerCard.hidden = true));

  window.addEventListener(ROLL_EVENT, (e) => {
    const record = (e as CustomEvent<RollRecord>).detail;
    showBanner(record);
  });

  // ── FAB: tap toggles the panel, long-press rolls a d20 straight away ──
  let pressTimer: ReturnType<typeof setTimeout> | null = null;
  let longPressed = false;

  fab.addEventListener('pointerdown', () => {
    longPressed = false;
    pressTimer = setTimeout(() => {
      longPressed = true;
      navigator.vibrate?.(20);
      void doRoll({ d20: 1 });
    }, 500);
  });
  const cancelPress = () => {
    if (pressTimer) clearTimeout(pressTimer);
    pressTimer = null;
  };
  fab.addEventListener('pointerup', cancelPress);
  fab.addEventListener('pointerleave', cancelPress);
  fab.addEventListener('pointercancel', cancelPress);
  fab.addEventListener('contextmenu', (e) => e.preventDefault());

  fab.addEventListener('click', () => {
    if (longPressed) {
      longPressed = false;
      return;
    }
    setOpen(panel.hidden);
  });

  // ── Panel controls ──
  for (const btn of panel.querySelectorAll<HTMLButtonElement>('.dice-pick[data-die]')) {
    const die = btn.dataset.die as DieType;
    btn.addEventListener('click', () => {
      selection[die] = Math.min(20, (selection[die] ?? 0) + 1);
      renderSelection();
    });
    btn.addEventListener('contextmenu', (e) => {
      e.preventDefault();
      selection[die] = Math.max(0, (selection[die] ?? 0) - 1);
      renderSelection();
    });
  }

  panel.querySelector('[data-reset]')?.addEventListener('click', () => {
    for (const d of DIE_TYPES) delete selection[d];
    modInput.value = '0';
    renderSelection();
    clearTable();
    if (bannerTimer) clearTimeout(bannerTimer);
    bannerCard.hidden = true;
  });

  for (const btn of panel.querySelectorAll<HTMLButtonElement>('.dice-step')) {
    btn.addEventListener('click', () => {
      modInput.value = String(modifier() + parseInt(btn.dataset.step!));
      renderSelection();
    });
  }
  modInput.addEventListener('input', renderSelection);

  for (const btn of panel.querySelectorAll<HTMLButtonElement>('.dice-quick')) {
    btn.addEventListener('click', () => {
      setOpen(false);
      void doRoll({ d20: 1 }, btn.dataset.quick as RollMode);
    });
  }

  // Close the panel so the dice have the screen; the selection stays for the next roll.
  rollBtn.addEventListener('click', () => {
    setOpen(false);
    void doRoll({ ...selection });
  });

  // Close on Escape or a click outside the panel.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) {
      setOpen(false);
      fab.focus();
    }
  });
  document.addEventListener('pointerdown', (e) => {
    if (!panel.hidden && !root.contains(e.target as Node)) setOpen(false);
  });

  document.addEventListener('astro:page-load', updateVisibility);
  updateVisibility();
  renderSelection();
</script>

---
interface Props {
  variant?: 'primary' | 'secondary' | 'success' | 'danger' | 'warning' | 'ghost' | 'icon';
  size?: 'xs' | 'sm' | 'md' | 'lg';
  icon?: 'edit' | 'delete' | 'add' | 'play' | 'pause' | 'stop' | 'prev' | 'next' | 'close' | 'check' | 'image';
  iconPosition?: 'left' | 'right' | 'only';
  class?: string;
  disabled?: boolean;
  title?: string;
  ariaLabel?: string;
  id?: string;
  type?: 'button' | 'submit' | 'reset';
}

const {
  variant = 'primary',
  size = 'md',
  icon,
  iconPosition = 'left',
  class: className = '',
  disabled = false,
  title,
  ariaLabel,
  id,
  type = 'button',
} = Astro.props;

// Base classes
const baseClasses = 'transition cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed inline-flex items-center justify-center';

// Variant classes
const variantClasses = {
  primary: 'text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 font-medium',
  secondary: 'text-gray-600 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300 font-medium',
  success: 'text-green-600 hover:text-green-700 dark:text-green-400 dark:hover:text-green-300 font-medium',
  danger: 'text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 font-medium',
  warning: 'text-yellow-600 hover:text-yellow-700 dark:text-yellow-400 dark:hover:text-yellow-300 font-medium',
  ghost: 'text-gray-700 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg',
  icon: 'text-gray-700 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg',
};

// Size classes
const sizeClasses = {
  xs: iconPosition === 'only' ? 'p-1.5' : 'px-2 py-1 text-xs gap-1',
  sm: iconPosition === 'only' ? 'p-2' : 'px-3 py-1.5 text-sm gap-1.5',
  md: iconPosition === 'only' ? 'p-2.5' : 'px-4 py-2 text-base gap-2',
  lg: iconPosition === 'only' ? 'p-3' : 'px-5 py-2.5 text-lg gap-2.5',
};

// Icon size classes
const iconSizeClasses = {
  xs: 'w-3 h-3',
  sm: 'w-4 h-4',
  md: 'w-5 h-5',
  lg: 'w-6 h-6',
};

// For icon-only buttons, use slightly larger icons
const actualIconSize = iconPosition === 'only' ? 
  (size === 'xs' ? 'sm' : size === 'sm' ? 'md' : size === 'md' ? 'lg' : 'lg') : 
  size;

// SVG Icons
const icons = {
  edit: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>`,
  delete: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>`,
  add: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>`,
  play: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`,
  pause: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" />`,
  stop: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" />`,
  prev: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />`,
  next: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />`,
  close: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />`,
  check: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />`,
  image: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>`,
};

const buttonClasses = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
const iconSvgClass = `${iconSizeClasses[actualIconSize]} pointer-events-none`;
---

<button
  type={type}
  class={buttonClasses}
  disabled={disabled}
  title={title}
  aria-label={ariaLabel}
  id={id}
  {...Astro.props}
>
  {icon && (iconPosition === 'left' || iconPosition === 'only') && (
    <svg class={iconSvgClass} fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={icons[icon]} />
  )}
  {iconPosition !== 'only' && (
    <slot />
  )}
  {icon && iconPosition === 'right' && (
    <svg class={iconSvgClass} fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={icons[icon]} />
  )}
</button>

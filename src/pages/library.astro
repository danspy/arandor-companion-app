---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { isAuthenticated, getUserRole } from '../lib/auth';
import { db, PageSettings, eq } from 'astro:db';

const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);
const canEditHero = userRole === 'admin' || userRole === 'dungeonmaster';

// Get page settings for hero image
const pageSettings = await db.select().from(PageSettings).where(eq(PageSettings.pageName, 'library'));
const heroImageUrl = pageSettings.length > 0 ? pageSettings[0].heroImageUrl : null;
---

<Layout title="Library">
  <PageHero
    title="Library"
    heroImageUrl={heroImageUrl}
    pageName="library"
    canEditHero={canEditHero}
  />

  <div class="mb-8">
    <p class="t-muted">Access campaign knowledge and historical timeline</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <!-- Docs Card -->
    <a href="/library/docs" class="t-panel p-6 t-tool-card block">
      <div class="flex items-start gap-4">
        <div class="t-inset p-3 w-fit rounded-xs mb-0">
          <svg class="w-6 h-6" style="color:var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
        </div>
        <div class="flex-1">
          <h2 class="t-section-h text-lg mb-1">Docs</h2>
          <p class="t-muted text-sm">Browse and search campaign documentation, lore, and knowledge entries</p>
        </div>
      </div>
    </a>

    <!-- Timeline Card -->
    <a href="/library/timeline" class="t-panel p-6 t-tool-card block">
      <div class="flex items-start gap-4">
        <div class="t-inset p-3 w-fit rounded-xs mb-0">
          <svg class="w-6 h-6" style="color:var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div class="flex-1">
          <h2 class="t-section-h text-lg mb-1">Timeline</h2>
          <p class="t-muted text-sm">View campaign events in a chronological timeline with connections to characters, locations, and more</p>
        </div>
      </div>
    </a>
  </div>
</Layout>

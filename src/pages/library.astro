---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { db, LibraryEntry, Location, PageSettings, eq } from 'astro:db';
import { isAuthenticated } from '../lib/auth';

const libraryEntries = await db.select().from(LibraryEntry);
const locations = await db.select().from(Location);
const isLoggedIn = isAuthenticated(Astro.cookies);

// Get all unique tags from library entries
const allTags = [...new Set(libraryEntries.flatMap(entry => 
  Array.isArray(entry.tags) ? entry.tags : []
))].sort();

// Sort entries by newest first
const sortedEntries = libraryEntries.slice().sort((a, b) => 
  new Date(b.createdAt || 0).getTime() - new Date(a.createdAt || 0).getTime()
);

// Create a map of location IDs to location names
const locationMap = new Map(locations.map(loc => [loc.id, loc.name]));

// Get page settings for hero image
const pageSettings = await db.select().from(PageSettings).where(eq(PageSettings.pageName, 'library'));
const heroImageUrl = pageSettings.length > 0 ? pageSettings[0].heroImageUrl : null;
---

<Layout title="Library">
  <PageHero 
    title="Library" 
    heroImageUrl={heroImageUrl}
    pageName="library"
    isLoggedIn={isLoggedIn}
  />

  {isLoggedIn && (
    <div class="flex justify-end mb-4">
      <button 
        id="addEntry"
        class="bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
      >
        + New Entry
      </button>
    </div>
  )}

  <!-- Stats -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-primary-600 dark:text-primary-500">{libraryEntries.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Total Entries</div>
    </div>
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-secondary-600 dark:text-secondary-500">{allTags.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Unique Tags</div>
    </div>
  </div>

  <!-- Search and Filter -->
  <div class="bg-white dark:bg-black rounded-lg shadow-md p-4 mb-6 dark:border dark:border-gray-900">
    <div class="flex flex-col md:flex-row gap-4">
      <!-- Search Input -->
      <div class="flex-1">
        <div class="relative">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Search library entries by title or content..."
            class="w-full px-4 py-2 pl-10 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100 transition"
          >
          <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>
      <!-- Tag Filter -->
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-sm text-gray-600 dark:text-gray-400 font-medium">Filter:</span>
        <button 
          class="tag-filter px-3 py-1.5 rounded-full text-sm font-medium bg-primary-600 text-white transition-all duration-200 hover:bg-primary-700 active:scale-95"
          data-tag="all"
        >
          All ({libraryEntries.length})
        </button>
        {allTags.map(tag => {
          const count = sortedEntries.filter(e => Array.isArray(e.tags) && e.tags.includes(tag)).length;
          return (
            <button 
              class="tag-filter px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95"
              data-tag={tag}
            >
              #{tag} ({count})
            </button>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Library Entries List -->
  <div id="entriesList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {sortedEntries.map(entry => {
      const locationName = entry.locationId ? locationMap.get(entry.locationId) : null;
      const tags = Array.isArray(entry.tags) ? entry.tags : [];
      
      return (
        <article 
          class="library-entry bg-white dark:bg-black rounded-lg shadow-md p-6 hover:shadow-lg transition dark:border dark:border-gray-900" 
          data-entry-id={entry.id}
          data-tags={JSON.stringify(tags)}
          data-search={`${entry.title} ${entry.content}`.toLowerCase()}
        >
          <div class="mb-4">
            <a href={`/library/${entry.id}`} class="text-xl font-semibold text-primary-700 dark:text-primary-400 hover:text-primary-900 dark:hover:text-primary-300 transition block mb-2">
              {entry.title}
            </a>
            {locationName && (
              <a href={`/locations/${entry.locationId}`} class="text-sm text-secondary-600 dark:text-secondary-400 hover:underline flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                {locationName}
              </a>
            )}
          </div>
          
          {tags.length > 0 && (
            <div class="flex gap-2 flex-wrap mb-4">
              {tags.map((tag: string) => (
                <span class="bg-primary-100 dark:bg-primary-900/20 dark:border dark:border-primary-800 text-primary-700 dark:text-primary-400 px-3 py-1 rounded-full text-sm">
                  #{tag}
                </span>
              ))}
            </div>
          )}

          <a 
            href={`/library/${entry.id}`}
            class="block text-center bg-accent-100 dark:bg-accent-900/20 dark:border dark:border-accent-800 text-accent-700 dark:text-accent-400 px-4 py-2 rounded-lg hover:bg-accent-200 dark:hover:bg-accent-900/30 transition font-medium text-sm"
          >
            View Details →
          </a>

          {isLoggedIn && (
            <div class="flex gap-2 mt-2">
              <button class="edit-entry flex-1 bg-primary-600 text-white px-4 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition text-sm" data-id={entry.id}>Edit</button>
              <button class="delete-entry px-4 py-2 border-2 border-red-600 text-red-600 dark:text-red-400 dark:border-red-500 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition text-sm" data-id={entry.id}>Delete</button>
            </div>
          )}
        </article>
      );
    })}
  </div>

  {sortedEntries.length === 0 && (
    <div class="text-center py-16 bg-white dark:bg-black rounded-lg shadow-md dark:border dark:border-gray-900">
      <p class="text-gray-500 dark:text-gray-400 text-lg">No library entries yet. Start documenting your knowledge!</p>
    </div>
  )}

  <!-- Modal for Add/Edit Entry -->
  <div id="entryModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white dark:bg-black rounded-lg p-4 sm:p-8 max-w-3xl w-full max-h-[90vh] overflow-y-auto dark:border dark:border-gray-900">
      <h2 id="modalTitle" class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6 text-primary-700 dark:text-primary-400">New Library Entry</h2>
      <form id="entryForm" class="space-y-4">
        <input type="hidden" id="entryId" name="id">
        
        <div>
          <label for="title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Title</label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            required 
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          >
        </div>
        
        <div>
          <label for="content" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Content (Markdown supported)
            <a href="https://www.markdownguide.org/basic-syntax/" target="_blank" class="text-xs text-primary-600 dark:text-primary-400 hover:underline ml-2">
              Markdown Guide ↗
            </a>
          </label>
          <textarea 
            id="content" 
            name="content" 
            required 
            rows="15"
            placeholder="# Heading&#10;&#10;## Subheading&#10;&#10;- Bullet point 1&#10;- Bullet point 2&#10;&#10;**Bold text** and *italic text*"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100 font-mono text-sm"
          ></textarea>
          <div class="flex justify-between items-center mt-2">
            <p class="text-xs text-gray-500 dark:text-gray-400">Supports headings, lists, bold, italic, links, and more</p>
            <button type="button" id="togglePreview" class="text-sm text-primary-600 dark:text-primary-400 hover:underline">
              Toggle Preview
            </button>
          </div>
          <div id="markdownPreview" class="hidden mt-4 p-4 border border-gray-300 dark:border-gray-600 rounded-lg prose dark:prose-invert max-w-none dark:bg-gray-800"></div>
        </div>

        <div>
          <label for="location" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Location (optional)</label>
          <select 
            id="location" 
            name="location"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          >
            <option value="">-- None --</option>
            {locations.map(location => (
              <option value={location.id}>{location.name}</option>
            ))}
          </select>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Where was this information found?</p>
        </div>
        
        <div>
          <label for="tags" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Tags (comma-separated)</label>
          <input 
            type="text" 
            id="tags" 
            name="tags" 
            placeholder="lore, history, magic, artifact"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          >
        </div>
        
        <div class="flex gap-4 pt-4">
          <button 
            type="submit" 
            class="flex-1 bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
          >
            Save Entry
          </button>
          <button 
            type="button" 
            id="cancelModal"
            class="flex-1 bg-gray-300 dark:bg-gray-600 text-gray-700 dark:text-gray-200 px-6 py-2 rounded-lg hover:bg-gray-400 dark:hover:bg-gray-700 transition"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  import { renderMarkdown } from '../utils/markdown';

  // Shared state for editing entry ID
  let editingId: string | null = null;

  // Initialize search and filter functionality on page load
  // This ensures it works after Astro View Transitions navigation
  function initializeFilters() {
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const tagFilters = document.querySelectorAll('.tag-filter');
    const entries = document.querySelectorAll('.library-entry');
    
    let currentFilter = 'all';
    let currentSearch = '';
    
    const applyFilters = () => {
      const searchTerms = currentSearch.toLowerCase().split(/\s+/).filter(term => term.length > 0);
      
      entries.forEach(entry => {
        const entryTags = JSON.parse(entry.getAttribute('data-tags') || '[]');
        const searchText = entry.getAttribute('data-search') || '';
        
        const matchesTag = currentFilter === 'all' || entryTags.includes(currentFilter);
        // Match if ANY search term is found in the text (more flexible search)
        const matchesSearch = searchTerms.length === 0 || searchTerms.some(term => searchText.includes(term));
        
        (entry as HTMLElement).style.display = matchesTag && matchesSearch ? 'block' : 'none';
      });
    };

    // Search functionality
    searchInput?.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    // Tag filtering
    tagFilters.forEach(btn => {
      btn.addEventListener('click', () => {
        currentFilter = btn.getAttribute('data-tag') || 'all';
        
        // Update button styles
        tagFilters.forEach(b => {
          if (b.getAttribute('data-tag') === currentFilter) {
            b.classList.remove('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
            b.classList.add('bg-primary-600', 'text-white');
          } else {
            b.classList.remove('bg-primary-600', 'text-white');
            b.classList.add('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
          }
        });
        
        applyFilters();
      });
    });
  }

  // Initialize library modal and form functionality
  function initializeLibraryModal() {
    const modal = document.getElementById('entryModal');
    const form = document.getElementById('entryForm') as HTMLFormElement;
    const modalTitle = document.getElementById('modalTitle');
    const addButton = document.getElementById('addEntry');
    const cancelButton = document.getElementById('cancelModal');
    const contentTextarea = document.getElementById('content') as HTMLTextAreaElement;
    const togglePreviewBtn = document.getElementById('togglePreview');
    const previewDiv = document.getElementById('markdownPreview');

  // Markdown preview toggle
  togglePreviewBtn?.addEventListener('click', () => {
    if (previewDiv?.classList.contains('hidden')) {
      previewDiv.classList.remove('hidden');
      if (contentTextarea) {
        previewDiv.innerHTML = renderMarkdown(contentTextarea.value);
      }
    } else {
      previewDiv?.classList.add('hidden');
    }
  });

  // Update preview when typing (debounced)
  let previewTimeout: number;
  contentTextarea?.addEventListener('input', () => {
    clearTimeout(previewTimeout);
    previewTimeout = window.setTimeout(() => {
      if (previewDiv && !previewDiv.classList.contains('hidden')) {
        previewDiv.innerHTML = renderMarkdown(contentTextarea.value);
      }
    }, 500);
  });

  // Open modal for new entry
  addButton?.addEventListener('click', () => {
    editingId = null;
    form.reset();
    document.getElementById('entryId')?.setAttribute('value', '');
    if (modalTitle) modalTitle.textContent = 'New Library Entry';
    previewDiv?.classList.add('hidden');
    modal?.classList.remove('hidden');
  });

  // Close modal
  cancelButton?.addEventListener('click', () => {
    modal?.classList.add('hidden');
  });

  // Close modal on background click
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
    }
  });

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const tags = (formData.get('tags') as string).split(',').map(t => t.trim()).filter(t => t);
    const locationId = formData.get('location') as string;
    
    const data = {
      title: formData.get('title'),
      content: formData.get('content'),
      tags,
      locationId: locationId || null,
    };

    try {
      const url = editingId ? `/api/library/${editingId}` : '/api/library';
      const method = editingId ? 'PUT' : 'POST';
      
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        alert('Failed to save entry. Please try again.');
      }
    } catch (error) {
      alert('An error occurred. Please try again.');
    }
  });

    // Check for edit parameter on page load and open modal if present
    const urlParams = new URLSearchParams(window.location.search);
    const editId = urlParams.get('edit');
    
    if (editId && modal && form && modalTitle) {
      (async () => {
        try {
          const response = await fetch(`/api/library/${editId}`);
          if (!response.ok) {
            throw new Error('Library entry not found');
          }
          
          const entry = await response.json();
          
          editingId = editId;
          
          // Populate form fields with null checks
          const titleEl = document.getElementById('title') as HTMLInputElement;
          const contentEl = document.getElementById('content') as HTMLTextAreaElement;
          const tagsEl = document.getElementById('tags') as HTMLInputElement;
          const locationEl = document.getElementById('location') as HTMLSelectElement;
          
          if (!titleEl || !contentEl || !tagsEl || !locationEl) {
            console.error('One or more form elements not found');
            throw new Error('Form elements not found');
          }
          
          titleEl.value = entry.title || '';
          contentEl.value = entry.content || '';
          tagsEl.value = Array.isArray(entry.tags) ? entry.tags.join(', ') : '';
          locationEl.value = entry.locationId || '';
          
          modalTitle.textContent = 'Edit Library Entry';
          previewDiv?.classList.add('hidden');
          modal.classList.remove('hidden');
          
          // Clear the URL parameter so refreshing doesn't re-open the modal
          window.history.replaceState({}, '', '/library');
        } catch (error) {
          console.error('Failed to load library entry for editing:', error);
          alert('Failed to load library entry. Please try again.');
        }
      })();
    }
  }

  // Edit/Delete entries with event delegation
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    
    if (target.classList.contains('edit-entry')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      // Get DOM elements fresh
      const modal = document.getElementById('entryModal');
      const modalTitle = document.getElementById('modalTitle');
      const previewDiv = document.getElementById('markdownPreview');
      
      try {
        const response = await fetch(`/api/library/${id}`);
        if (!response.ok) {
          throw new Error('Failed to fetch entry');
        }
        const entry = await response.json();
        
        editingId = id;
        
        // Populate form fields with null checks
        const titleEl = document.getElementById('title') as HTMLInputElement;
        const contentEl = document.getElementById('content') as HTMLTextAreaElement;
        const tagsEl = document.getElementById('tags') as HTMLInputElement;
        const locationEl = document.getElementById('location') as HTMLSelectElement;
        
        if (!titleEl || !contentEl || !tagsEl || !locationEl) {
          console.error('One or more form elements not found');
          throw new Error('Form elements not found');
        }
        
        titleEl.value = entry.title || '';
        contentEl.value = entry.content || '';
        tagsEl.value = Array.isArray(entry.tags) ? entry.tags.join(', ') : '';
        locationEl.value = entry.locationId || '';
        
        if (modalTitle) modalTitle.textContent = 'Edit Library Entry';
        previewDiv?.classList.add('hidden');
        modal?.classList.remove('hidden');
      } catch (error) {
        console.error('Failed to load library entry:', error);
        alert('Failed to load entry. Please try again.');
      }
    }
    
    // Delete entry
    if (target.classList.contains('delete-entry')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      if (confirm('Are you sure you want to delete this entry?')) {
        try {
          const response = await fetch(`/api/library/${id}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete entry. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    }
  });

  // Run on initial page load and after View Transitions navigation
  document.addEventListener('astro:page-load', () => {
    initializeFilters();
    initializeLibraryModal();
  });
</script>

---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { isAuthenticated, getUserRole } from '../lib/auth';
import { db, PageSettings, eq } from 'astro:db';

const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);
const canEditHero = userRole === 'admin' || userRole === 'dungeonmaster';

// Get page settings for hero image
const pageSettings = await db.select().from(PageSettings).where(eq(PageSettings.pageName, 'library'));
const heroImageUrl = pageSettings.length > 0 ? pageSettings[0].heroImageUrl : null;
---

<Layout title="Library">
  <PageHero
    title="Library"
    heroImageUrl={heroImageUrl}
    pageName="library"
    canEditHero={canEditHero}
  />

  <p class="library-intro">Access campaign knowledge and historical timeline</p>

  <div class="library-grid">
    <!-- Docs Card -->
    <a href="/library/docs" class="lib-card lib-card--docs">
      <div class="lib-card__glow" aria-hidden="true"></div>
      <div class="lib-card__corner lib-card__corner--tl" aria-hidden="true"></div>
      <div class="lib-card__corner lib-card__corner--br" aria-hidden="true"></div>

      <div class="lib-card__icon">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
      </div>

      <div class="lib-card__body">
        <div class="lib-card__tag">Knowledge Base</div>
        <h2 class="lib-card__title">Docs</h2>
        <p class="lib-card__desc">Browse and search campaign documentation, lore, and knowledge entries</p>
      </div>

      <div class="lib-card__arrow" aria-hidden="true">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </div>
    </a>

    <!-- Timeline Card -->
    <a href="/library/timeline" class="lib-card lib-card--timeline">
      <div class="lib-card__glow" aria-hidden="true"></div>
      <div class="lib-card__corner lib-card__corner--tl" aria-hidden="true"></div>
      <div class="lib-card__corner lib-card__corner--br" aria-hidden="true"></div>

      <div class="lib-card__icon lib-card__icon--timeline">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>

      <div class="lib-card__body">
        <div class="lib-card__tag lib-card__tag--timeline">Chronicle</div>
        <h2 class="lib-card__title">Timeline</h2>
        <p class="lib-card__desc">View campaign events in a chronological timeline with connections to characters, locations, and more</p>
      </div>

      <div class="lib-card__arrow" aria-hidden="true">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </div>
    </a>
  </div>
</Layout>

<style>
  .library-intro {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    letter-spacing: 0.01em;
  }

  .library-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .library-grid { grid-template-columns: 1fr 1fr; }
  }

  /* ── Library card ──────────────────────────────────────────────── */
  .lib-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.75rem 1.75rem 1.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-gold);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
    box-shadow: 0 4px 24px rgba(0,0,0,0.2), 0 0 0 1px rgba(201,144,50,0.06);
  }

  .lib-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: 0 12px 40px rgba(0,0,0,0.35), 0 0 30px rgba(234,88,12,0.10), 0 0 0 1px rgba(234,88,12,0.25);
  }

  /* Glow effect on hover */
  .lib-card__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 40% at 20% 50%, rgba(234,88,12,0.06) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .lib-card--timeline .lib-card__glow {
    background: radial-gradient(ellipse 60% 40% at 20% 50%, rgba(201,144,50,0.07) 0%, transparent 70%);
  }
  .lib-card:hover .lib-card__glow { opacity: 1; }

  /* Corner flourish */
  .lib-card__corner {
    position: absolute;
    width: 20px;
    height: 20px;
    pointer-events: none;
  }
  .lib-card__corner::before,
  .lib-card__corner::after {
    content: '';
    position: absolute;
    background: var(--border-gold);
    border-radius: 1px;
    transition: background 0.2s ease;
  }
  .lib-card:hover .lib-card__corner::before,
  .lib-card:hover .lib-card__corner::after {
    background: var(--accent);
    opacity: 0.7;
  }
  .lib-card__corner--tl { top: -1px; left: -1px; }
  .lib-card__corner--br { bottom: -1px; right: -1px; }
  .lib-card__corner--tl::before { width: 14px; height: 2px; top: 0; left: 0; }
  .lib-card__corner--tl::after  { width: 2px; height: 14px; top: 0; left: 0; }
  .lib-card__corner--br::before { width: 14px; height: 2px; bottom: 0; right: 0; }
  .lib-card__corner--br::after  { width: 2px; height: 14px; bottom: 0; right: 0; }

  /* ── Icon ──────────────────────────────────────────────────────── */
  .lib-card__icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(234,88,12,0.10);
    border: 1px solid rgba(234,88,12,0.2);
    border-radius: 12px;
    color: var(--accent);
    flex-shrink: 0;
    transition: background 0.2s ease, box-shadow 0.2s ease;
  }
  .lib-card__icon--timeline {
    background: rgba(201,144,50,0.10);
    border-color: rgba(201,144,50,0.2);
    color: var(--gold);
  }
  .lib-card__icon svg { width: 26px; height: 26px; }
  .lib-card:hover .lib-card__icon {
    background: rgba(234,88,12,0.15);
    box-shadow: 0 0 16px rgba(234,88,12,0.20);
  }
  .lib-card:hover .lib-card__icon--timeline {
    background: rgba(201,144,50,0.15);
    box-shadow: 0 0 16px rgba(201,144,50,0.18);
  }

  /* ── Body ──────────────────────────────────────────────────────── */
  .lib-card__body { flex: 1; }

  .lib-card__tag {
    display: inline-block;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
    opacity: 0.8;
  }
  .lib-card__tag--timeline { color: var(--gold); }

  .lib-card__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 600;
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--text-strong);
    margin: 0 0 0.5rem;
    transition: color 0.2s ease;
  }
  .lib-card:hover .lib-card__title { color: var(--accent); }
  .lib-card:hover .lib-card--timeline .lib-card__title { color: var(--gold); }

  .lib-card__desc {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }

  /* ── Arrow ─────────────────────────────────────────────────────── */
  .lib-card__arrow {
    align-self: flex-end;
    color: var(--text-faint);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .lib-card__arrow svg { width: 18px; height: 18px; }
  .lib-card:hover .lib-card__arrow {
    color: var(--accent);
    transform: translateX(4px);
  }
</style>

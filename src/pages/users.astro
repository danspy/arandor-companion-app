---
import Layout from '../layouts/Layout.astro';
import { getUserRole } from '../lib/auth';

// Check if user is authenticated and is admin
const userRole = await getUserRole(Astro.cookies);
if (!userRole || userRole !== 'admin') {
  return Astro.redirect('/login');
}

// Fetch all users
import { db, User } from 'astro:db';

const users = await db.select({
  id: User.id,
  username: User.username,
  role: User.role,
  createdAt: User.createdAt,
}).from(User);
---

<Layout title="User Management">
  <div class="max-w-4xl mx-auto">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-4xl font-bold text-primary-700 dark:text-primary-400">User Management</h1>
      <button 
        id="addUserBtn"
        class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 transition flex items-center gap-2 font-medium"
        title="Add new user"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Add User</span>
      </button>
    </div>

    <!-- Success/Error Messages -->
    <div id="messageContainer" class="hidden mb-6"></div>

    <!-- Users List -->
    <div class="bg-white dark:bg-black rounded-lg shadow-md overflow-hidden dark:border dark:border-gray-900">
      <table class="w-full">
        <thead class="bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Username</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Role</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Created At</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody id="usersTableBody" class="divide-y divide-gray-200 dark:divide-gray-800">
          {users.map(user => (
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-900 transition" data-user-id={user.id}>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100">
                {user.username}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-300">
                <span class={`px-2 py-1 rounded-full text-xs font-medium ${
                  user.role === 'admin' ? 'bg-red-100 dark:bg-red-900/20 text-red-700 dark:text-red-400' :
                  user.role === 'dungeonmaster' ? 'bg-purple-100 dark:bg-purple-900/20 text-purple-700 dark:text-purple-400' :
                  'bg-blue-100 dark:bg-blue-900/20 text-blue-700 dark:text-blue-400'
                }`}>
                  {user.role || 'player'}
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                {new Date(user.createdAt).toLocaleString()}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <div class="flex gap-2 items-center">
                  <button 
                    class="edit-user-btn p-2.5 text-gray-700 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition cursor-pointer"
                    data-user-id={user.id}
                    data-username={user.username}
                    data-user-role={user.role || 'player'}
                    title="Edit user"
                    aria-label="Edit user"
                  >
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                  </button>
                  {user.username !== 'admin' && (
                    <button 
                      class="delete-user-btn p-2.5 text-gray-700 hover:text-red-600 dark:text-gray-300 dark:hover:text-red-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition cursor-pointer"
                      data-user-id={user.id}
                      data-username={user.username}
                      title="Delete user"
                      aria-label="Delete user"
                    >
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                      </svg>
                    </button>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add User Modal -->
  <div id="addUserModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-black rounded-lg shadow-xl max-w-md w-full p-6 dark:border dark:border-gray-900">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-primary-700 dark:text-primary-400">Add New User</h2>
        <button id="closeModalBtn" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <form id="addUserForm" class="space-y-4">
        <div>
          <label for="newUsername" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Username
          </label>
          <input 
            type="text" 
            id="newUsername" 
            name="username" 
            required 
            minlength="3"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            placeholder="Enter username (min 3 characters)"
          >
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Minimum 3 characters</p>
        </div>

        <div>
          <label for="newPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Password
          </label>
          <input 
            type="password" 
            id="newPassword" 
            name="password" 
            required 
            minlength="6"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            placeholder="Enter password (min 6 characters)"
          >
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Minimum 6 characters</p>
        </div>

        <div>
          <label for="newRole" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Role
          </label>
          <select 
            id="newRole" 
            name="role" 
            required
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          >
            <option value="player">Player</option>
            <option value="dungeonmaster">Dungeon Master</option>
            <option value="admin">Admin</option>
          </select>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Select user role</p>
        </div>

        <div id="modalErrorMessage" class="hidden text-red-600 dark:text-red-400 text-sm"></div>

        <div class="flex gap-3 pt-4">
          <button 
            type="submit" 
            class="flex-1 bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
          >
            Create User
          </button>
          <button 
            type="button" 
            id="cancelModalBtn"
            class="flex-1 bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600 transition"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit User Modal -->
  <div id="editUserModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-black rounded-lg shadow-xl max-w-md w-full p-6 dark:border dark:border-gray-900">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-primary-700 dark:text-primary-400">Edit User</h2>
        <button id="closeEditModalBtn" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <form id="editUserForm" class="space-y-4">
        <input type="hidden" id="editUserId" name="userId">
        
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Username
          </label>
          <p id="editUsername" class="w-full px-4 py-2 bg-gray-100 dark:bg-gray-800 rounded-lg text-gray-900 dark:text-gray-100"></p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Username cannot be changed</p>
        </div>

        <div>
          <label for="editRole" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Role
          </label>
          <select 
            id="editRole" 
            name="role" 
            required
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          >
            <option value="player">Player</option>
            <option value="dungeonmaster">Dungeon Master</option>
            <option value="admin">Admin</option>
          </select>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Select user role</p>
        </div>

        <div>
          <label for="editCurrentPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Current Password (optional)
          </label>
          <input 
            type="password" 
            id="editCurrentPassword" 
            name="currentPassword" 
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            placeholder="Enter current password"
          >
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Required only when changing password</p>
        </div>

        <div>
          <label for="editNewPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            New Password (optional)
          </label>
          <input 
            type="password" 
            id="editNewPassword" 
            name="newPassword" 
            minlength="6"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            placeholder="Enter new password (min 6 characters)"
          >
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Leave blank to keep current password</p>
        </div>

        <div id="editModalErrorMessage" class="hidden text-red-600 dark:text-red-400 text-sm"></div>

        <div class="flex gap-3 pt-4">
          <button 
            type="submit" 
            class="flex-1 bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
          >
            Update User
          </button>
          <button 
            type="button" 
            id="cancelEditModalBtn"
            class="flex-1 bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600 transition"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="deleteUserModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-black rounded-lg shadow-xl max-w-md w-full p-6 dark:border dark:border-gray-900">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-red-700 dark:text-red-400">Delete User</h2>
        <button id="closeDeleteModalBtn" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="mb-6">
        <p class="text-gray-700 dark:text-gray-300 mb-2">
          Are you sure you want to delete user <strong id="deleteUsername" class="text-red-700 dark:text-red-400"></strong>?
        </p>
        <p class="text-sm text-gray-600 dark:text-gray-400">
          This action cannot be undone.
        </p>
      </div>

      <input type="hidden" id="deleteUserId">

      <div id="deleteModalErrorMessage" class="hidden text-red-600 dark:text-red-400 text-sm mb-4"></div>

      <div class="flex gap-3">
        <button 
          id="confirmDeleteBtn"
          class="flex-1 bg-red-600 text-white px-6 py-2 rounded-lg hover:bg-red-700 dark:bg-red-700 dark:hover:bg-red-600 transition"
        >
          Delete User
        </button>
        <button 
          id="cancelDeleteModalBtn"
          class="flex-1 bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600 transition"
        >
          Cancel
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Initialize users page functionality
  function initUsersPage() {
    const addUserBtn = document.getElementById('addUserBtn');
    const addUserModal = document.getElementById('addUserModal');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const cancelModalBtn = document.getElementById('cancelModalBtn');
    const addUserForm = document.getElementById('addUserForm') as HTMLFormElement;
    const modalErrorMessage = document.getElementById('modalErrorMessage');
    const messageContainer = document.getElementById('messageContainer');
    const usersTableBody = document.getElementById('usersTableBody');

    // Edit User Modal
    const editUserModal = document.getElementById('editUserModal');
    const closeEditModalBtn = document.getElementById('closeEditModalBtn');
    const cancelEditModalBtn = document.getElementById('cancelEditModalBtn');
    const editUserForm = document.getElementById('editUserForm') as HTMLFormElement;
    const editModalErrorMessage = document.getElementById('editModalErrorMessage');
    const editUserId = document.getElementById('editUserId') as HTMLInputElement;
    const editUsername = document.getElementById('editUsername');
    const editRole = document.getElementById('editRole') as HTMLSelectElement;

    // Delete User Modal
    const deleteUserModal = document.getElementById('deleteUserModal');
    const closeDeleteModalBtn = document.getElementById('closeDeleteModalBtn');
    const cancelDeleteModalBtn = document.getElementById('cancelDeleteModalBtn');
    const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
    const deleteModalErrorMessage = document.getElementById('deleteModalErrorMessage');
    const deleteUserId = document.getElementById('deleteUserId') as HTMLInputElement;
    const deleteUsername = document.getElementById('deleteUsername');

    // HTML escape function to prevent XSS
    function escapeHtml(text: string): string {
      if (typeof text !== 'string') {
        text = String(text);
      }
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // Show Add User modal
    addUserBtn?.addEventListener('click', () => {
      addUserModal?.classList.remove('hidden');
      addUserForm?.reset();
      modalErrorMessage?.classList.add('hidden');
    });

    // Close Add User modal
    const closeModal = () => {
      addUserModal?.classList.add('hidden');
      addUserForm?.reset();
      modalErrorMessage?.classList.add('hidden');
    };

    closeModalBtn?.addEventListener('click', closeModal);
    cancelModalBtn?.addEventListener('click', closeModal);

    // Close Add User modal on background click
    addUserModal?.addEventListener('click', (e) => {
      if (e.target === addUserModal) {
        closeModal();
      }
    });

    // Show Edit User modal
    const showEditModal = (userId: string, username: string, userRole: string) => {
      if (editUserId && editUsername && editRole) {
        editUserId.value = userId;
        editUsername.textContent = username;
        editRole.value = userRole || 'player';
      }
      editUserModal?.classList.remove('hidden');
      // Clear password fields but keep role
      const currentPasswordField = document.getElementById('editCurrentPassword') as HTMLInputElement;
      const newPasswordField = document.getElementById('editNewPassword') as HTMLInputElement;
      if (currentPasswordField) currentPasswordField.value = '';
      if (newPasswordField) newPasswordField.value = '';
      editModalErrorMessage?.classList.add('hidden');
    };

    // Close Edit User modal
    const closeEditModal = () => {
      editUserModal?.classList.add('hidden');
      editUserForm?.reset();
      editModalErrorMessage?.classList.add('hidden');
    };

    closeEditModalBtn?.addEventListener('click', closeEditModal);
    cancelEditModalBtn?.addEventListener('click', closeEditModal);

    // Close Edit User modal on background click
    editUserModal?.addEventListener('click', (e) => {
      if (e.target === editUserModal) {
        closeEditModal();
      }
    });

    // Show Delete User modal
    const showDeleteModal = (userId: string, username: string) => {
      if (deleteUserId && deleteUsername) {
        deleteUserId.value = userId;
        deleteUsername.textContent = username;
      }
      deleteUserModal?.classList.remove('hidden');
      deleteModalErrorMessage?.classList.add('hidden');
    };

    // Close Delete User modal
    const closeDeleteModal = () => {
      deleteUserModal?.classList.add('hidden');
      deleteModalErrorMessage?.classList.add('hidden');
    };

    closeDeleteModalBtn?.addEventListener('click', closeDeleteModal);
    cancelDeleteModalBtn?.addEventListener('click', closeDeleteModal);

    // Close Delete User modal on background click
    deleteUserModal?.addEventListener('click', (e) => {
      if (e.target === deleteUserModal) {
        closeDeleteModal();
      }
    });

    // Show message
    function showMessage(message: string, type: 'success' | 'error') {
      if (!messageContainer) return;
      
      const bgColor = type === 'success' ? 'bg-green-50 dark:bg-green-950 border-green-200 dark:border-green-800' : 'bg-red-50 dark:bg-red-950 border-red-200 dark:border-red-800';
      const textColor = type === 'success' ? 'text-green-800 dark:text-green-400' : 'text-red-800 dark:text-red-400';
      
      messageContainer.className = `${bgColor} border rounded-lg p-4 ${textColor} mb-6`;
      messageContainer.textContent = message;
      messageContainer.classList.remove('hidden');

      // Auto-hide after 5 seconds
      setTimeout(() => {
        messageContainer.classList.add('hidden');
      }, 5000);
    }

    // Handle Add User form submission
    addUserForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(addUserForm);
      const data = {
        username: formData.get('username'),
        password: formData.get('password'),
        role: formData.get('role'),
      };

      try {
        const response = await fetch('/api/users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (response.ok) {
          closeModal();
          showMessage(`User '${data.username}' created successfully!`, 'success');
          
          // Add new user to table
          if (usersTableBody && result.user) {
            const row = document.createElement('tr');
            row.className = 'hover:bg-gray-50 dark:hover:bg-gray-900 transition';
            row.setAttribute('data-user-id', escapeHtml(result.user.id));
            const escapedId = escapeHtml(result.user.id);
            const escapedUsername = escapeHtml(result.user.username);
            const escapedRole = escapeHtml(result.user.role || 'player');
            const roleBadgeClass = escapedRole === 'admin' ? 'bg-red-100 dark:bg-red-900/20 text-red-700 dark:text-red-400' :
                                   escapedRole === 'dungeonmaster' ? 'bg-purple-100 dark:bg-purple-900/20 text-purple-700 dark:text-purple-400' :
                                   'bg-blue-100 dark:bg-blue-900/20 text-blue-700 dark:text-blue-400';
            const deleteButton = result.user.username !== 'admin' ? `
              <button 
                class="delete-user-btn text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300"
                data-user-id="${escapedId}"
                data-username="${escapedUsername}"
              >
                Delete
              </button>
            ` : '';
            row.innerHTML = `
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100">
                ${escapedUsername}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-300">
                <span class="px-2 py-1 rounded-full text-xs font-medium ${roleBadgeClass}">
                  ${escapedRole}
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                ${escapeHtml(new Date(result.user.createdAt).toLocaleString())}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                <button 
                  class="edit-user-btn text-primary-600 hover:text-primary-800 dark:text-primary-400 dark:hover:text-primary-300 mr-4"
                  data-user-id="${escapedId}"
                  data-username="${escapedUsername}"
                  data-user-role="${escapedRole}"
                >
                  Edit
                </button>
                ${deleteButton}
              </td>
            `;
            usersTableBody.insertBefore(row, usersTableBody.firstChild);
            attachButtonListeners(row);
          }
        } else {
          if (modalErrorMessage) {
            modalErrorMessage.textContent = result.error || 'Failed to create user. Please try again.';
            modalErrorMessage.classList.remove('hidden');
          }
        }
      } catch (error) {
        if (modalErrorMessage) {
          modalErrorMessage.textContent = 'An error occurred. Please try again.';
          modalErrorMessage.classList.remove('hidden');
        }
      }
    });

    // Handle Edit User form submission
    editUserForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(editUserForm);
      const userId = editUserId?.value;
      const username = editUsername?.textContent;
      const data: { currentPassword?: string; newPassword?: string; role: string } = {
        role: formData.get('role') as string,
      };

      // Only include password fields if both are provided
      const currentPassword = formData.get('currentPassword') as string;
      const newPassword = formData.get('newPassword') as string;
      if (currentPassword && newPassword) {
        data.currentPassword = currentPassword;
        data.newPassword = newPassword;
      }

      try {
        const response = await fetch(`/api/users/${userId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (response.ok) {
          closeEditModal();
          showMessage(`User '${username}' updated successfully!`, 'success');
          // Reload page to show updated role
          setTimeout(() => window.location.reload(), 1000);
        } else {
          if (editModalErrorMessage) {
            editModalErrorMessage.textContent = result.error || 'Failed to update user. Please try again.';
            editModalErrorMessage.classList.remove('hidden');
          }
        }
      } catch (error) {
        if (editModalErrorMessage) {
          editModalErrorMessage.textContent = 'An error occurred. Please try again.';
          editModalErrorMessage.classList.remove('hidden');
        }
      }
    });

    // Handle Delete User confirmation
    confirmDeleteBtn?.addEventListener('click', async () => {
      const userId = deleteUserId?.value;
      const username = deleteUsername?.textContent;

      try {
        const response = await fetch(`/api/users/${userId}`, {
          method: 'DELETE',
        });

        const result = await response.json();

        if (response.ok) {
          closeDeleteModal();
          showMessage(`User '${username}' deleted successfully!`, 'success');
          
          // Remove user row from table using escaped selector
          const row = document.querySelector(`tr[data-user-id="${CSS.escape(userId || '')}"]`);
          if (row) {
            row.remove();
          }
        } else {
          if (deleteModalErrorMessage) {
            deleteModalErrorMessage.textContent = result.error || 'Failed to delete user. Please try again.';
            deleteModalErrorMessage.classList.remove('hidden');
          }
        }
      } catch (error) {
        if (deleteModalErrorMessage) {
          deleteModalErrorMessage.textContent = 'An error occurred. Please try again.';
          deleteModalErrorMessage.classList.remove('hidden');
        }
      }
    });

    // Attach event listeners to Edit and Delete buttons
    function attachButtonListeners(container: HTMLElement | Document = document) {
      const editButtons = container.querySelectorAll('.edit-user-btn');
      const deleteButtons = container.querySelectorAll('.delete-user-btn');

      editButtons.forEach(button => {
        button.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const userId = target.getAttribute('data-user-id');
          const username = target.getAttribute('data-username');
          const userRole = target.getAttribute('data-user-role');
          if (userId && username) {
            showEditModal(userId, username, userRole || 'player');
          }
        });
      });

      deleteButtons.forEach(button => {
        button.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const userId = target.getAttribute('data-user-id');
          const username = target.getAttribute('data-username');
          if (userId && username) {
            showDeleteModal(userId, username);
          }
        });
      });
    }

    // Initialize button listeners on page load
    attachButtonListeners();
  }

  // Run on initial page load and after view transitions
  document.addEventListener('astro:page-load', initUsersPage);
</script>

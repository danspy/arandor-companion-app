---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { getUserRole } from '../lib/auth';

// Check if user is authenticated and is admin
const userRole = await getUserRole(Astro.cookies);
if (!userRole || userRole !== 'admin') {
  return Astro.redirect('/login');
}

// Fetch all users
import { db, User } from '@/db';

const users = await db.select({
  id: User.id,
  username: User.username,
  role: User.role,
  firstName: User.firstName,
  createdAt: User.createdAt,
}).from(User);
---

<Layout title="User Management">
  <PageHero title="User Management" pageName="users" canEditHero={false} compact subtitle="Who can log in, and what they may change.">
    <Fragment slot="actions">
      <Button 
        variant="primary"
        size="md"
        icon="add"
        id="addUserBtn"
        title="Add new Add User"
      >
        Add User
      </Button>
    </Fragment>
  </PageHero>
  <div class="max-w-4xl mx-auto">

    <!-- Success/Error Messages -->
    <div id="messageContainer" class="hidden mb-6"></div>

    <!-- Users List -->
    <div id="usersTableBody" class="space-y-4">
      {users.map(user => (
        <div class="t-panel p-6" data-user-id={user.id}>
          <div class="flex items-start justify-between gap-4">
            <!-- User Info -->
            <div class="flex-1 space-y-3">
              <!-- Username -->
              <div class="flex items-center gap-3">
                <h3 class="t-body-text text-xl font-bold">
                  {user.username}
                </h3>
                <span class={`px-3 py-1 rounded-xs text-xs font-medium ${
                  user.role === 'admin' ? 't-badge t-badge-red' :
                  user.role === 'dungeonmaster' ? 't-badge t-badge-accent' :
                  't-badge t-badge-blue'
                }`}>
                  {user.role || 'player'}
                </span>
              </div>
              
              <!-- First Name -->
              {user.firstName && (
                <div class="t-body-text text-sm">
                  <span class="font-medium">Name:</span> {user.firstName}
                </div>
              )}
              
              <!-- Created At -->
              <div class="t-faint text-sm">
                <span class="font-medium">Created:</span> {new Date(user.createdAt).toLocaleString()}
              </div>
            </div>
            
            <!-- Actions -->
            <div class="flex gap-1.5 items-center shrink-0">
              <button 
                class="edit-user-btn t-icon-btn"
                data-user-id={user.id}
                data-username={user.username}
                data-user-role={user.role || 'player'}
                data-first-name={user.firstName || ''}
                title="Edit user"
                aria-label="Edit user"
              >
                <svg class="w-5 h-5 md:w-6 md:h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
              </button>
              {user.username !== 'admin' && (
                <button 
                  class="delete-user-btn t-icon-btn t-icon-btn-danger"
                  data-user-id={user.id}
                  data-username={user.username}
                  title="Delete user"
                  aria-label="Delete user"
                >
                  <svg class="w-5 h-5 md:w-6 md:h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                </button>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Add User Modal -->
  <div id="addUserModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-xs z-50 flex items-center justify-center p-4 modal-overlay-safe">
    <div class="t-modal-panel max-w-md w-full p-6 modal-content-safe">
      <div class="flex justify-between items-center mb-6">
        <h2 class="font-display italic font-semibold text-2xl" style="color:var(--gold);">Add New User</h2>
        <button id="closeModalBtn" class="t-icon-btn">
          <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <form id="addUserForm" class="space-y-4">
        <div>
          <label for="newUsername" class="t-label block mb-1">
            Username
          </label>
          <input 
            type="text" 
            id="newUsername" 
            name="username" 
            required 
            minlength="3"
            class="t-input px-4 py-2"
            placeholder="Enter username (min 3 characters)"
          >
          <p class="t-faint text-xs mt-1">Minimum 3 characters</p>
        </div>

        <div>
          <label for="newFirstName" class="t-label block mb-1">
            First Name (optional)
          </label>
          <input 
            type="text" 
            id="newFirstName" 
            name="firstName" 
            class="t-input px-4 py-2"
            placeholder="Enter first name"
          >
          <p class="t-faint text-xs mt-1">Display name for the user</p>
        </div>

        <div>
          <label for="newPassword" class="t-label block mb-1">
            Password
          </label>
          <input 
            type="password" 
            id="newPassword" 
            name="password" 
            required 
            minlength="6"
            class="t-input px-4 py-2"
            placeholder="Enter password (min 6 characters)"
          >
          <p class="t-faint text-xs mt-1">Minimum 6 characters</p>
        </div>

        <div>
          <label for="newRole" class="t-label block mb-1">
            Role
          </label>
          <select 
            id="newRole" 
            name="role" 
            required
            class="t-input px-4 py-2"
          >
            <option value="player">Player</option>
            <option value="dungeonmaster">Dungeon Master</option>
            <option value="admin">Admin</option>
          </select>
          <p class="t-faint text-xs mt-1">Select user role</p>
        </div>

        <div id="modalErrorMessage" class="hidden text-sm" style="color:var(--danger);"></div>

        <div class="flex gap-3 pt-4">
          <button 
            type="submit" 
            class="t-btn-primary flex-1 px-6 py-2"
          >
            Create User
          </button>
          <button 
            type="button" 
            id="cancelModalBtn"
            class="t-btn-secondary flex-1 px-6 py-2"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit User Modal -->
  <div id="editUserModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-xs z-50 flex items-center justify-center p-4 modal-overlay-safe">
    <div class="t-modal-panel max-w-md w-full p-6 modal-content-safe">
      <div class="flex justify-between items-center mb-6">
        <h2 class="font-display italic font-semibold text-2xl" style="color:var(--gold);">Edit User</h2>
        <button id="closeEditModalBtn" class="t-icon-btn">
          <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <form id="editUserForm" class="space-y-4">
        <input type="hidden" id="editUserId" name="userId">
        
        <div>
          <label class="t-label block mb-1">
            Username
          </label>
          <p id="editUsername" class="t-inset px-4 py-2 rounded-xs t-body-text w-full"></p>
          <p class="t-faint text-xs mt-1">Username cannot be changed</p>
        </div>

        <div>
          <label for="editFirstName" class="t-label block mb-1">
            First Name (optional)
          </label>
          <input 
            type="text" 
            id="editFirstName" 
            name="firstName" 
            class="t-input px-4 py-2"
            placeholder="Enter first name"
          >
          <p class="t-faint text-xs mt-1">Display name for the user</p>
        </div>

        <div>
          <label for="editRole" class="t-label block mb-1">
            Role
          </label>
          <select 
            id="editRole" 
            name="role" 
            required
            class="t-input px-4 py-2"
          >
            <option value="player">Player</option>
            <option value="dungeonmaster">Dungeon Master</option>
            <option value="admin">Admin</option>
          </select>
          <p class="t-faint text-xs mt-1">Select user role</p>
        </div>

        <div>
          <label for="editNewPassword" class="t-label block mb-1">
            Reset Password (optional)
          </label>
          <input 
            type="password" 
            id="editNewPassword" 
            name="newPassword" 
            minlength="6"
            class="t-input px-4 py-2"
            placeholder="Enter new password (min 6 characters)"
          >
          <p class="t-faint text-xs mt-1">As admin, you can reset the password without knowing the current one. Leave blank to keep current password.</p>
        </div>

        <div id="editModalErrorMessage" class="hidden text-sm" style="color:var(--danger);"></div>

        <div class="flex gap-3 pt-4">
          <button 
            type="submit" 
            class="t-btn-primary flex-1 px-6 py-2"
          >
            Update User
          </button>
          <button 
            type="button" 
            id="cancelEditModalBtn"
            class="t-btn-secondary flex-1 px-6 py-2"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="deleteUserModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-xs z-50 flex items-center justify-center p-4 modal-overlay-safe">
    <div class="t-modal-panel max-w-md w-full p-6 modal-content-safe">
      <div class="flex justify-between items-center mb-6">
        <h2 class="font-display italic font-semibold text-2xl" style="color:var(--danger);">Delete User</h2>
        <button id="closeDeleteModalBtn" class="t-icon-btn">
          <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="mb-6">
        <p class="t-body-text mb-2">
          Are you sure you want to delete user <strong id="deleteUsername" class="font-bold" style="color:var(--danger);"></strong>?
        </p>
        <p class="t-faint text-sm">
          This action cannot be undone.
        </p>
      </div>

      <input type="hidden" id="deleteUserId">

      <div id="deleteModalErrorMessage" class="hidden text-sm mb-4" style="color:var(--danger);"></div>

      <div class="flex gap-3">
        <button 
          id="confirmDeleteBtn"
          class="t-btn-danger flex-1 px-6 py-2"
        >
          Delete User
        </button>
        <button 
          id="cancelDeleteModalBtn"
          class="t-btn-secondary flex-1 px-6 py-2"
        >
          Cancel
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Initialize users page functionality
  function initUsersPage() {
    const addUserBtn = document.getElementById('addUserBtn');
    const addUserModal = document.getElementById('addUserModal');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const cancelModalBtn = document.getElementById('cancelModalBtn');
    const addUserForm = document.getElementById('addUserForm') as HTMLFormElement;
    const modalErrorMessage = document.getElementById('modalErrorMessage');
    const messageContainer = document.getElementById('messageContainer');
    const usersTableBody = document.getElementById('usersTableBody');

    // Edit User Modal
    const editUserModal = document.getElementById('editUserModal');
    const closeEditModalBtn = document.getElementById('closeEditModalBtn');
    const cancelEditModalBtn = document.getElementById('cancelEditModalBtn');
    const editUserForm = document.getElementById('editUserForm') as HTMLFormElement;
    const editModalErrorMessage = document.getElementById('editModalErrorMessage');
    const editUserId = document.getElementById('editUserId') as HTMLInputElement;
    const editUsername = document.getElementById('editUsername');
    const editRole = document.getElementById('editRole') as HTMLSelectElement;

    // Delete User Modal
    const deleteUserModal = document.getElementById('deleteUserModal');
    const closeDeleteModalBtn = document.getElementById('closeDeleteModalBtn');
    const cancelDeleteModalBtn = document.getElementById('cancelDeleteModalBtn');
    const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
    const deleteModalErrorMessage = document.getElementById('deleteModalErrorMessage');
    const deleteUserId = document.getElementById('deleteUserId') as HTMLInputElement;
    const deleteUsername = document.getElementById('deleteUsername');

    // HTML escape function to prevent XSS
    function escapeHtml(text: string): string {
      if (typeof text !== 'string') {
        text = String(text);
      }
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // Show Add User modal
    addUserBtn?.addEventListener('click', () => {
      addUserModal?.classList.remove('hidden');
      addUserForm?.reset();
      modalErrorMessage?.classList.add('hidden');
    });

    // Close Add User modal
    const closeModal = () => {
      addUserModal?.classList.add('hidden');
      addUserForm?.reset();
      modalErrorMessage?.classList.add('hidden');
    };

    closeModalBtn?.addEventListener('click', closeModal);
    cancelModalBtn?.addEventListener('click', closeModal);

    // Close Add User modal on background click
    addUserModal?.addEventListener('click', (e) => {
      if (e.target === addUserModal) {
        closeModal();
      }
    });

    // Show Edit User modal
    const showEditModal = (userId: string, username: string, userRole: string, firstName: string = '') => {
      if (editUserId && editUsername && editRole) {
        editUserId.value = userId;
        editUsername.textContent = username;
        editRole.value = userRole || 'player';
      }
      const editFirstNameField = document.getElementById('editFirstName') as HTMLInputElement;
      if (editFirstNameField) {
        editFirstNameField.value = firstName || '';
      }
      editUserModal?.classList.remove('hidden');
      // Clear password field
      const newPasswordField = document.getElementById('editNewPassword') as HTMLInputElement;
      if (newPasswordField) newPasswordField.value = '';
      editModalErrorMessage?.classList.add('hidden');
    };

    // Close Edit User modal
    const closeEditModal = () => {
      editUserModal?.classList.add('hidden');
      editUserForm?.reset();
      editModalErrorMessage?.classList.add('hidden');
    };

    closeEditModalBtn?.addEventListener('click', closeEditModal);
    cancelEditModalBtn?.addEventListener('click', closeEditModal);

    // Close Edit User modal on background click
    editUserModal?.addEventListener('click', (e) => {
      if (e.target === editUserModal) {
        closeEditModal();
      }
    });

    // Show Delete User modal
    const showDeleteModal = (userId: string, username: string) => {
      if (deleteUserId && deleteUsername) {
        deleteUserId.value = userId;
        deleteUsername.textContent = username;
      }
      deleteUserModal?.classList.remove('hidden');
      deleteModalErrorMessage?.classList.add('hidden');
    };

    // Close Delete User modal
    const closeDeleteModal = () => {
      deleteUserModal?.classList.add('hidden');
      deleteModalErrorMessage?.classList.add('hidden');
    };

    closeDeleteModalBtn?.addEventListener('click', closeDeleteModal);
    cancelDeleteModalBtn?.addEventListener('click', closeDeleteModal);

    // Close Delete User modal on background click
    deleteUserModal?.addEventListener('click', (e) => {
      if (e.target === deleteUserModal) {
        closeDeleteModal();
      }
    });

    // Show message
    function showMessage(message: string, type: 'success' | 'error') {
      if (!messageContainer) return;
      
      
      
      
      messageContainer.className = type === 'success' ? 't-toast t-toast-success mb-6' : 't-toast t-toast-error mb-6';
      messageContainer.textContent = message;
      messageContainer.classList.remove('hidden');

      // Auto-hide after 5 seconds
      setTimeout(() => {
        messageContainer.classList.add('hidden');
      }, 5000);
    }

    // Handle Add User form submission
    addUserForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(addUserForm);
      const data = {
        username: formData.get('username'),
        password: formData.get('password'),
        role: formData.get('role'),
        firstName: formData.get('firstName'),
      };

      try {
        const response = await fetch('/api/users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (response.ok) {
          closeModal();
          showMessage(`User '${data.username}' created successfully!`, 'success');
          
          // Add new user to list
          if (usersTableBody && result.user) {
            const card = document.createElement('div');
            card.className = 't-panel p-6';
            card.setAttribute('data-user-id', escapeHtml(result.user.id));
            const escapedId = escapeHtml(result.user.id);
            const escapedUsername = escapeHtml(result.user.username);
            const escapedRole = escapeHtml(result.user.role || 'player');
            const escapedFirstName = result.user.firstName ? escapeHtml(result.user.firstName) : '';
            const roleBadgeClass = escapedRole === 'admin' ? 't-badge t-badge-red' :
                                   escapedRole === 'dungeonmaster' ? 't-badge t-badge-accent' :
                                   't-badge t-badge-blue';
            const firstNameDisplay = escapedFirstName ? `
              <div class="t-body-text text-sm">
                <span class="font-medium">Name:</span> ${escapedFirstName}
              </div>
            ` : '';
            const deleteButton = result.user.username !== 'admin' ? `
              <button 
                class="delete-user-btn t-icon-btn t-icon-btn-danger"
                data-user-id="${escapedId}"
                data-username="${escapedUsername}"
                title="Delete user"
                aria-label="Delete user"
              >
                <svg class="w-5 h-5 md:w-6 md:h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </button>
            ` : '';
            card.innerHTML = `
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 space-y-3">
                  <div class="flex items-center gap-3">
                    <h3 class="t-body-text text-xl font-bold">
                      ${escapedUsername}
                    </h3>
                    <span class="px-3 py-1 rounded-xs text-xs font-medium ${roleBadgeClass}">
                      ${escapedRole}
                    </span>
                  </div>
                  ${firstNameDisplay}
                  <div class="t-faint text-sm">
                    <span class="font-medium">Created:</span> ${escapeHtml(new Date(result.user.createdAt).toLocaleString())}
                  </div>
                </div>
                <div class="flex gap-1.5 items-center shrink-0">
                  <button 
                    class="edit-user-btn t-icon-btn"
                    data-user-id="${escapedId}"
                    data-username="${escapedUsername}"
                    data-user-role="${escapedRole}"
                    data-first-name="${escapedFirstName}"
                    title="Edit user"
                    aria-label="Edit user"
                  >
                    <svg class="w-5 h-5 md:w-6 md:h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                  </button>
                  ${deleteButton}
                </div>
              </div>
            `;
            usersTableBody.insertBefore(card, usersTableBody.firstChild);
            attachButtonListeners(card);
          }
        } else {
          if (modalErrorMessage) {
            modalErrorMessage.textContent = result.error || 'Failed to create user. Please try again.';
            modalErrorMessage.classList.remove('hidden');
          }
        }
      } catch (error) {
        if (modalErrorMessage) {
          modalErrorMessage.textContent = 'An error occurred. Please try again.';
          modalErrorMessage.classList.remove('hidden');
        }
      }
    });

    // Handle Edit User form submission
    editUserForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(editUserForm);
      const userId = editUserId?.value;
      const username = editUsername?.textContent;
      const data: { newPassword?: string; role: string; firstName?: string; adminPasswordReset?: boolean } = {
        role: formData.get('role') as string,
      };

      // Include firstName
      const firstName = formData.get('firstName') as string;
      data.firstName = firstName || '';

      // Handle password reset (admin can reset without current password)
      const newPassword = formData.get('newPassword') as string;
      if (newPassword) {
        data.newPassword = newPassword;
        data.adminPasswordReset = true; // Admin is resetting password
      }

      try {
        const response = await fetch(`/api/users/${userId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (response.ok) {
          closeEditModal();
          showMessage(`User '${username}' updated successfully!`, 'success');
          // Reload page to show updated role and name
          setTimeout(() => window.location.reload(), 1000);
        } else {
          if (editModalErrorMessage) {
            editModalErrorMessage.textContent = result.error || 'Failed to update user. Please try again.';
            editModalErrorMessage.classList.remove('hidden');
          }
        }
      } catch (error) {
        if (editModalErrorMessage) {
          editModalErrorMessage.textContent = 'An error occurred. Please try again.';
          editModalErrorMessage.classList.remove('hidden');
        }
      }
    });

    // Handle Delete User confirmation
    confirmDeleteBtn?.addEventListener('click', async () => {
      const userId = deleteUserId?.value;
      const username = deleteUsername?.textContent;

      try {
        const response = await fetch(`/api/users/${userId}`, {
          method: 'DELETE',
        });

        const result = await response.json();

        if (response.ok) {
          closeDeleteModal();
          showMessage(`User '${username}' deleted successfully!`, 'success');
          
          // Remove user card from list using escaped selector
          const card = document.querySelector(`div[data-user-id="${CSS.escape(userId || '')}"]`);
          if (card) {
            card.remove();
          }
        } else {
          if (deleteModalErrorMessage) {
            deleteModalErrorMessage.textContent = result.error || 'Failed to delete user. Please try again.';
            deleteModalErrorMessage.classList.remove('hidden');
          }
        }
      } catch (error) {
        if (deleteModalErrorMessage) {
          deleteModalErrorMessage.textContent = 'An error occurred. Please try again.';
          deleteModalErrorMessage.classList.remove('hidden');
        }
      }
    });

    // Attach event listeners to Edit and Delete buttons
    function attachButtonListeners(container: HTMLElement | Document = document) {
      const editButtons = container.querySelectorAll('.edit-user-btn');
      const deleteButtons = container.querySelectorAll('.delete-user-btn');

      editButtons.forEach(button => {
        button.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const userId = target.getAttribute('data-user-id');
          const username = target.getAttribute('data-username');
          const userRole = target.getAttribute('data-user-role');
          const firstName = target.getAttribute('data-first-name');
          if (userId && username) {
            showEditModal(userId, username, userRole || 'player', firstName || '');
          }
        });
      });

      deleteButtons.forEach(button => {
        button.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const userId = target.getAttribute('data-user-id');
          const username = target.getAttribute('data-username');
          if (userId && username) {
            showDeleteModal(userId, username);
          }
        });
      });
    }

    // Initialize button listeners on page load
    attachButtonListeners();
  }

  // Run on initial page load and after view transitions
  document.addEventListener('astro:page-load', initUsersPage);
</script>

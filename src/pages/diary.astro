---
import Layout from '../layouts/Layout.astro';
import { db, DiaryEntry, NPC, Location, Character, Quest } from 'astro:db';
import { isAuthenticated } from '../lib/auth';

const diaryEntries = await db.select().from(DiaryEntry);
const npcs = await db.select().from(NPC);
const locations = await db.select().from(Location);
const characters = await db.select().from(Character);
const quests = await db.select().from(Quest);
const isLoggedIn = isAuthenticated(Astro.cookies);
const editId = Astro.url.searchParams.get('edit');

const sortedEntries = diaryEntries.slice().sort((a, b) => 
  new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<Layout title="Adventure Diary">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold text-primary-700">Adventure Diary</h1>
    {isLoggedIn && (
      <button 
        id="addEntry"
        class="bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 transition"
      >
        + New Entry
      </button>
    )}
  </div>

  <div id="entriesList" class="space-y-6">
    {sortedEntries.map(entry => (
      <article class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition" data-entry-id={entry.id}>
        {entry.coverImageUrl && (
          <div class="mb-4 rounded-lg overflow-hidden">
            <img 
              src={entry.coverImageUrl} 
              alt={entry.title}
              class="w-full h-48 object-cover"
            />
          </div>
        )}
        <div class="flex justify-between items-start mb-4">
          <div class="flex-1">
            <a href={`/diary/${entry.id}`} class="text-2xl font-semibold text-primary-700 hover:text-primary-900 transition">
              {entry.title}
            </a>
            <div class="flex gap-4 text-sm text-gray-500 mt-1">
              <span>📅 {entry.date}</span>
              <span>🎲 Session {entry.session}</span>
            </div>
          </div>
          {isLoggedIn && (
            <div class="flex gap-2">
              <button class="edit-entry text-primary-600 hover:text-primary-800 px-3 py-1 rounded" data-id={entry.id}>Edit</button>
              <button class="delete-entry text-red-600 hover:text-red-800 px-3 py-1 rounded" data-id={entry.id}>Delete</button>
            </div>
          )}
        </div>
        
        <div class="prose max-w-none mb-4">
          <p class="text-gray-700 line-clamp-3">{entry.content}</p>
        </div>
        
        <div class="flex gap-2 flex-wrap mb-4">
          {Array.isArray(entry.tags) && entry.tags.map((tag: string) => (
            <span class="bg-primary-100 text-primary-700 px-3 py-1 rounded-full text-sm">
              #{tag}
            </span>
          ))}
        </div>

        <a href={`/diary/${entry.id}`} class="text-primary-600 hover:text-primary-800 text-sm font-medium">
          Read more →
        </a>
      </article>
    ))}
  </div>

  {sortedEntries.length === 0 && (
    <div class="text-center py-16 bg-white rounded-lg shadow-md">
      <p class="text-gray-500 text-lg">No diary entries yet. Start documenting your adventures!</p>
    </div>
  )}

  <!-- Modal for Add/Edit Entry -->
  <div id="entryModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg p-8 max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto">
      <h2 id="modalTitle" class="text-2xl font-bold mb-6 text-primary-700">New Diary Entry</h2>
      <form id="entryForm" class="space-y-4">
        <input type="hidden" id="entryId" name="id">
        
        <div>
          <label for="title" class="block text-sm font-medium text-gray-700 mb-1">Title</label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            required 
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
          >
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="date" class="block text-sm font-medium text-gray-700 mb-1">Date</label>
            <input 
              type="date" 
              id="date" 
              name="date" 
              required 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
          </div>
          
          <div>
            <label for="session" class="block text-sm font-medium text-gray-700 mb-1">Session Number</label>
            <input 
              type="number" 
              id="session" 
              name="session" 
              required 
              min="1"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
          </div>
        </div>
        
        <div>
          <label for="content" class="block text-sm font-medium text-gray-700 mb-1">Content</label>
          <textarea 
            id="content" 
            name="content" 
            required 
            rows="10"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
          ></textarea>
        </div>

        <div>
          <label for="coverImageUrl" class="block text-sm font-medium text-gray-700 mb-1">Cover Image URL (optional)</label>
          <input 
            type="url" 
            id="coverImageUrl" 
            name="coverImageUrl" 
            placeholder="https://example.com/image.jpg"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
          >
        </div>
        
        <div>
          <label for="tags" class="block text-sm font-medium text-gray-700 mb-1">Tags (comma-separated)</label>
          <input 
            type="text" 
            id="tags" 
            name="tags" 
            placeholder="combat, discovery, ruins"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
          >
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="npcs" class="block text-sm font-medium text-gray-700 mb-1">NPCs Met</label>
            <select 
              id="npcs" 
              name="npcs" 
              multiple 
              size="4"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
              {npcs.map(npc => (
                <option value={npc.id}>{npc.name}</option>
              ))}
            </select>
            <p class="text-xs text-gray-500 mt-1">Hold Ctrl/Cmd to select multiple</p>
          </div>

          <div>
            <label for="locations" class="block text-sm font-medium text-gray-700 mb-1">Locations Visited</label>
            <select 
              id="locations" 
              name="locations" 
              multiple 
              size="4"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
              {locations.map(location => (
                <option value={location.id}>{location.name}</option>
              ))}
            </select>
            <p class="text-xs text-gray-500 mt-1">Hold Ctrl/Cmd to select multiple</p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="characters" class="block text-sm font-medium text-gray-700 mb-1">Party Members</label>
            <select 
              id="characters" 
              name="characters" 
              multiple 
              size="4"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
              {characters.map(character => (
                <option value={character.id}>{character.name}</option>
              ))}
            </select>
            <p class="text-xs text-gray-500 mt-1">Hold Ctrl/Cmd to select multiple</p>
          </div>

          <div>
            <label for="quests" class="block text-sm font-medium text-gray-700 mb-1">Related Quests</label>
            <select 
              id="quests" 
              name="quests" 
              multiple 
              size="4"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
              {quests.map(quest => (
                <option value={quest.id}>{quest.title}</option>
              ))}
            </select>
            <p class="text-xs text-gray-500 mt-1">Hold Ctrl/Cmd to select multiple</p>
          </div>
        </div>
        
        <div class="flex gap-4 pt-4">
          <button 
            type="submit" 
            class="flex-1 bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 transition"
          >
            Save Entry
          </button>
          <button 
            type="button" 
            id="cancelModal"
            class="flex-1 bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 transition"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  const modal = document.getElementById('entryModal');
  const form = document.getElementById('entryForm') as HTMLFormElement;
  const modalTitle = document.getElementById('modalTitle');
  const addButton = document.getElementById('addEntry');
  const cancelButton = document.getElementById('cancelModal');

  let editingId: string | null = null;

  // Open modal for new entry
  addButton?.addEventListener('click', () => {
    editingId = null;
    form.reset();
    document.getElementById('entryId')?.setAttribute('value', '');
    if (modalTitle) modalTitle.textContent = 'New Diary Entry';
    
    // Set default date to today
    const today = new Date().toISOString().split('T')[0];
    (document.getElementById('date') as HTMLInputElement).value = today;
    
    modal?.classList.remove('hidden');
  });

  // Close modal
  cancelButton?.addEventListener('click', () => {
    modal?.classList.add('hidden');
  });

  // Close modal on background click
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
    }
  });

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const tags = (formData.get('tags') as string).split(',').map(t => t.trim()).filter(t => t);
    
    // Get selected values from multi-select fields
    const npcsSelect = document.getElementById('npcs') as HTMLSelectElement;
    const locationsSelect = document.getElementById('locations') as HTMLSelectElement;
    const charactersSelect = document.getElementById('characters') as HTMLSelectElement;
    const questsSelect = document.getElementById('quests') as HTMLSelectElement;
    
    const npcIds = Array.from(npcsSelect.selectedOptions).map(option => option.value);
    const locationIds = Array.from(locationsSelect.selectedOptions).map(option => option.value);
    const characterIds = Array.from(charactersSelect.selectedOptions).map(option => option.value);
    const questIds = Array.from(questsSelect.selectedOptions).map(option => option.value);
    
    const data = {
      title: formData.get('title'),
      date: formData.get('date'),
      session: parseInt(formData.get('session') as string),
      content: formData.get('content'),
      tags,
      coverImageUrl: formData.get('coverImageUrl') || null,
      npcIds,
      locationIds,
      characterIds,
      questIds,
    };

    try {
      const url = editingId ? `/api/diary/${editingId}` : '/api/diary';
      const method = editingId ? 'PUT' : 'POST';
      
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        alert('Failed to save entry. Please try again.');
      }
    } catch (error) {
      alert('An error occurred. Please try again.');
    }
  });

  // Edit entry
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    
    if (target.classList.contains('edit-entry')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      try {
        const response = await fetch(`/api/diary/${id}`);
        const entry = await response.json();
        
        editingId = id;
        (document.getElementById('title') as HTMLInputElement).value = entry.title;
        (document.getElementById('date') as HTMLInputElement).value = entry.date;
        (document.getElementById('session') as HTMLInputElement).value = entry.session;
        (document.getElementById('content') as HTMLTextAreaElement).value = entry.content;
        (document.getElementById('tags') as HTMLInputElement).value = Array.isArray(entry.tags) ? entry.tags.join(', ') : '';
        (document.getElementById('coverImageUrl') as HTMLInputElement).value = entry.coverImageUrl || '';
        
        // Set selected values for multi-select fields
        const npcsSelect = document.getElementById('npcs') as HTMLSelectElement;
        const locationsSelect = document.getElementById('locations') as HTMLSelectElement;
        const charactersSelect = document.getElementById('characters') as HTMLSelectElement;
        const questsSelect = document.getElementById('quests') as HTMLSelectElement;
        
        // Clear previous selections
        Array.from(npcsSelect.options).forEach(option => option.selected = false);
        Array.from(locationsSelect.options).forEach(option => option.selected = false);
        Array.from(charactersSelect.options).forEach(option => option.selected = false);
        Array.from(questsSelect.options).forEach(option => option.selected = false);
        
        // Set new selections
        const npcIds = Array.isArray(entry.npcIds) ? entry.npcIds : [];
        const locationIds = Array.isArray(entry.locationIds) ? entry.locationIds : [];
        const characterIds = Array.isArray(entry.characterIds) ? entry.characterIds : [];
        const questIds = Array.isArray(entry.questIds) ? entry.questIds : [];
        
        Array.from(npcsSelect.options).forEach(option => {
          if (npcIds.includes(option.value)) option.selected = true;
        });
        Array.from(locationsSelect.options).forEach(option => {
          if (locationIds.includes(option.value)) option.selected = true;
        });
        Array.from(charactersSelect.options).forEach(option => {
          if (characterIds.includes(option.value)) option.selected = true;
        });
        Array.from(questsSelect.options).forEach(option => {
          if (questIds.includes(option.value)) option.selected = true;
        });
        
        if (modalTitle) modalTitle.textContent = 'Edit Diary Entry';
        modal?.classList.remove('hidden');
      } catch (error) {
        alert('Failed to load entry. Please try again.');
      }
    }
    
    // Delete entry
    if (target.classList.contains('delete-entry')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      if (confirm('Are you sure you want to delete this entry?')) {
        try {
          const response = await fetch(`/api/diary/${id}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete entry. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    }
  });

  // Check if we should auto-open modal for editing
  const urlParams = new URLSearchParams(window.location.search);
  const editIdFromUrl = urlParams.get('edit');
  
  if (editIdFromUrl) {
    // Find and click the edit button for this entry
    const editButton = document.querySelector(`button.edit-entry[data-id="${editIdFromUrl}"]`);
    if (editButton) {
      (editButton as HTMLElement).click();
      // Remove the query parameter from URL
      window.history.replaceState({}, '', '/diary');
    }
  }
</script>

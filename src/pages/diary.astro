---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { db, DiaryEntry, NPC, Location, Character, Quest, PageSettings, eq } from 'astro:db';
import { isAuthenticated, getUserRole } from '../lib/auth';
import { getVideoMimeType } from '../utils/video';

const diaryEntries = await db.select().from(DiaryEntry);
const npcs = await db.select().from(NPC);
const locations = await db.select().from(Location);
const characters = await db.select().from(Character);
const quests = await db.select().from(Quest);
const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);
const canEditHero = userRole === 'admin' || userRole === 'dungeonmaster';
const editId = Astro.url.searchParams.get('edit');

const sortedEntries = diaryEntries.slice().sort((a, b) =>
  b.session - a.session
);

// Get all unique tags from diary entries
const allTags = [...new Set(diaryEntries.flatMap(entry =>
  Array.isArray(entry.tags) ? entry.tags : []
))].sort();

// Get max session number
const maxSession = diaryEntries.length > 0 ? Math.max(...diaryEntries.map(e => e.session)) : 0;

// Get page settings for hero image
const pageSettings = await db.select().from(PageSettings).where(eq(PageSettings.pageName, 'diary'));
const heroImageUrl = pageSettings.length > 0 ? pageSettings[0].heroImageUrl : null;
---

<Layout title="Adventure Diary">
  <PageHero
    title="Adventure Diary"
    heroImageUrl={heroImageUrl}
    pageName="diary"
    canEditHero={canEditHero}
  />

  {isLoggedIn && (
    <div class="flex justify-end mb-4">
      <Button
        variant="primary"
        size="md"
        icon="add"
        id="addDiaryEntry"
        title="Add new Add Entry"
      >
        Add Entry
      </Button>
    </div>
  )}

  <!-- Stats -->
  <div class="grid grid-cols-2 gap-2 md:gap-4 mb-8">
    <div class="t-panel p-3 md:p-6 text-center">
      <div class="t-num text-2xl md:text-3xl">{maxSession}</div>
      <div class="t-label-sm mt-1">Sessions</div>
    </div>
    <div class="t-panel p-3 md:p-6 text-center">
      <div class="t-num text-2xl md:text-3xl">{allTags.length}</div>
      <div class="t-label-sm mt-1">Unique Tags</div>
    </div>
  </div>

  <!-- Search and Filter -->
  <div class="t-panel p-4 mb-6">
    <div class="flex flex-col gap-3">
      <!-- Search Input - Always Full Width -->
      <div class="relative w-full">
        <input
          type="text"
          id="searchInput"
          placeholder="Search diary entries by title, content, or tags..."
          class="t-search w-full px-4 py-2 pl-10 rounded-sm transition"
        >
        <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 t-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <!-- Tag Filter Below -->
      {allTags.length > 0 && (
        <div class="flex flex-wrap gap-2 items-center">
          <span class="text-sm t-muted font-medium">Filter:</span>
          <button
            class="tag-filter t-pill active transition-all duration-200 active:scale-95"
            data-tag="all"
          >
            All ({diaryEntries.length})
          </button>
          {allTags.map(tag => {
            const count = sortedEntries.filter(e => Array.isArray(e.tags) && e.tags.includes(tag)).length;
            return (
              <button
                class="tag-filter t-pill transition-all duration-200 active:scale-95"
                data-tag={tag}
              >
                #{tag} ({count})
              </button>
            );
          })}
        </div>
      )}
    </div>
  </div>

  <div id="entriesList" class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {sortedEntries.map(entry => {
      const tags = Array.isArray(entry.tags) ? entry.tags : [];
      return (
      <article class="diary-entry t-panel p-6 hover:shadow-lg transition min-w-0" data-entry-id={entry.id} data-tags={JSON.stringify(tags)} data-search={`${entry.title} ${entry.content} ${tags.join(' ')}`.toLowerCase()}>
        {entry.coverVideoUrl ? (
          <div class="-mx-6 -mt-6 mb-5 overflow-hidden" style="border-bottom:1px solid var(--border-gold);">
            <video
              autoplay
              muted
              playsinline
              preload="auto"
              disablePictureInPicture
              class="w-full aspect-video object-cover block"
              aria-label={`Video for ${entry.title}`}
            >
              <source src={entry.coverVideoUrl} type={getVideoMimeType(entry.coverVideoUrl)} />
              Your browser does not support the video tag.
            </video>
          </div>
        ) : entry.coverImageUrl && (
          <div class="-mx-6 -mt-6 mb-5 overflow-hidden" style="border-bottom:1px solid var(--border-gold);">
            <img
              src={entry.coverImageUrl}
              alt={entry.title}
              class="w-full aspect-video object-cover block"
            />
          </div>
        )}
        <div class="mb-4">
          <div class="flex items-start justify-between gap-2 mb-1">
            <a href={`/diary/${entry.id}`} class="text-2xl font-semibold t-gold hover:opacity-80 transition min-w-0 break-words">
              {entry.title}
            </a>
            {isLoggedIn && (
              <div class="flex gap-2 items-center flex-shrink-0">
                <Button
                  variant="icon"
                  size="sm"
                  icon="edit"
                  iconPosition="only"
                  class="edit-entry"
                  data-id={entry.id}
                  title="Edit entry"
                  ariaLabel="Edit entry"
                />
                <Button
                  variant="ghost"
                  size="sm"
                  icon="delete"
                  iconPosition="only"
                  class="delete-entry hover:text-red-400"
                  data-id={entry.id}
                  title="Delete entry"
                  ariaLabel="Delete entry"
                />
              </div>
            )}
          </div>
          <div class="flex gap-4 text-sm t-faint mt-1">
            <span>Session {entry.session}</span>
          </div>
        </div>

        <div class="prose max-w-none mb-4">
          <p class="t-body-text line-clamp-3 break-words">{entry.content}</p>
        </div>

        <div class="flex gap-2 flex-wrap mb-4">
          {Array.isArray(entry.tags) && entry.tags.map((tag: string) => (
            <span class="t-badge t-badge-gold">#{tag}</span>
          ))}
        </div>

        <a
          href={`/diary/${entry.id}`}
          class="t-btn-secondary block text-center text-sm mt-4"
        >
          View Details →
        </a>
      </article>
      );
    })}
  </div>

  {sortedEntries.length === 0 && (
    <div class="text-center py-16 t-panel">
      <p class="t-faint text-lg">No diary entries yet. Start documenting your adventures!</p>
    </div>
  )}

  <!-- Modal for Add/Edit Entry -->
  <div id="diaryEntryModal" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50 p-4 modal-overlay-safe">
    <div class="t-modal-panel p-4 sm:p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto modal-content-safe">
      <h2 id="diaryModalTitle" class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6 t-section-h">New Diary Entry</h2>
      <form id="diaryEntryForm" class="space-y-4">
        <input type="hidden" id="diaryEntryId" name="id">

        <div>
          <label for="title" class="t-label block mb-1">Title</label>
          <input
            type="text"
            id="title"
            name="title"
            required
            class="t-input px-3 py-2"
          >
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="date" class="t-label block mb-1">Date</label>
            <input
              type="date"
              id="date"
              name="date"
              required
              class="t-input px-3 py-2"
            >
          </div>

          <div>
            <label for="session" class="t-label block mb-1">Session Number</label>
            <input
              type="number"
              id="session"
              name="session"
              required
              min="1"
              class="t-input px-3 py-2"
            >
          </div>
        </div>

        <div>
          <label for="content" class="t-label block mb-1">
            Content (Markdown supported)
            <a href="https://www.markdownguide.org/basic-syntax/" target="_blank" class="t-link ml-2">
              Markdown Guide ↗
            </a>
          </label>
          <textarea
            id="content"
            name="content"
            required
            rows="10"
            class="t-input px-3 py-2"
          ></textarea>
          <p class="text-xs t-faint mt-1">Use **bold**, *italic*, # headings, - lists, and more</p>
        </div>

        <div>
          <label for="summary" class="t-label block mb-1">Summary <span class="t-faint font-normal">(optional)</span></label>
          <textarea
            id="summary"
            name="summary"
            rows="3"
            maxlength="400"
            class="t-input px-3 py-2"
            placeholder="One or two sentences. Shown in the party's speech bubble on the world map."
          ></textarea>
        </div>

        <div>
          <label class="t-label block mb-1">Cover Image</label>
          <div class="space-y-3">
            <div>
              <label for="coverImageFile" class="t-label block mb-1">Upload Image (max 5MB)</label>
              <input
                type="file"
                id="coverImageFile"
                name="coverImageFile"
                accept="image/*"
                class="t-input px-3 py-2"
              >
            </div>
            <div class="text-center text-sm t-faint">— OR —</div>
            <div>
              <label for="coverImageUrl" class="t-label block mb-1">Image URL</label>
              <input
                type="text"
                id="coverImageUrl"
                name="coverImageUrl"
                placeholder="https://example.com/image.jpg"
                class="t-input px-3 py-2"
              >
              <p class="text-xs t-faint mt-1">External URL or uploaded image path</p>
            </div>
          </div>
          <div id="imagePreview" class="mt-3 hidden">
            <img id="previewImg" src="" alt="Preview" class="max-w-xs rounded-sm shadow-md">
          </div>
        </div>

        <div>
          <label class="t-label block mb-1">Cover Video</label>
          <div class="space-y-3">
            <div>
              <label for="coverVideoFile" class="t-label block mb-1">Upload Video (max 5MB)</label>
              <input
                type="file"
                id="coverVideoFile"
                name="coverVideoFile"
                accept="video/*"
                class="t-input px-3 py-2"
              >
            </div>
            <div class="text-center text-sm t-faint">— OR —</div>
            <div>
              <label for="coverVideoUrl" class="t-label block mb-1">Video URL</label>
              <input
                type="text"
                id="coverVideoUrl"
                name="coverVideoUrl"
                placeholder="https://example.com/video.mp4"
                class="t-input px-3 py-2"
              >
              <p class="text-xs t-faint mt-1">External URL or uploaded video path</p>
            </div>
          </div>
          <div id="videoPreview" class="mt-3 hidden">
            <video
              id="previewVideo"
              src=""
              autoplay
              muted
              playsinline
              loop
              preload="auto"
              disablePictureInPicture
              class="max-w-xs rounded-sm shadow-md"
              aria-label="Video preview"
            ></video>
          </div>
        </div>

        <div>
          <label class="t-label block mb-1">Session Gallery</label>
          <div>
            <label for="galleryFiles" class="t-label block mb-1">Upload Images / Videos (max 5MB each)</label>
            <input
              type="file"
              id="galleryFiles"
              name="galleryFiles"
              accept="image/*,video/*"
              multiple
              class="t-input px-3 py-2"
            >
            <p class="text-xs t-faint mt-1">Select one or more files to add impressions of the session</p>
          </div>
          <div id="galleryPreview" class="mt-3 grid grid-cols-3 sm:grid-cols-4 gap-2 hidden"></div>
        </div>

        <div>
          <label for="tags" class="t-label block mb-1">Tags (comma-separated)</label>
          <input
            type="text"
            id="tags"
            name="tags"
            placeholder="combat, discovery, ruins"
            class="t-input px-3 py-2"
          >
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="npcs" class="t-label block mb-1">NPCs Met</label>
            <select
              id="npcs"
              name="npcs"
              multiple
              size="4"
              class="t-input px-3 py-2"
            >
              {npcs.map(npc => (
                <option value={npc.id}>{npc.name}</option>
              ))}
            </select>
            <p class="text-xs t-faint mt-1">Hold Ctrl/Cmd to select multiple</p>
          </div>

          <div>
            <label for="locations" class="t-label block mb-1">Locations Visited</label>
            <select
              id="locations"
              name="locations"
              multiple
              size="4"
              class="t-input px-3 py-2"
            >
              {locations.map(location => (
                <option value={location.id}>{location.name}</option>
              ))}
            </select>
            <p class="text-xs t-faint mt-1">Hold Ctrl/Cmd to select multiple</p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="characters" class="t-label block mb-1">Party Members</label>
            <select
              id="characters"
              name="characters"
              multiple
              size="4"
              class="t-input px-3 py-2"
            >
              {characters.map(character => (
                <option value={character.id}>{character.name}</option>
              ))}
            </select>
            <p class="text-xs t-faint mt-1">Hold Ctrl/Cmd to select multiple</p>
          </div>

          <div>
            <label for="quests" class="t-label block mb-1">Related Quests</label>
            <select
              id="quests"
              name="quests"
              multiple
              size="4"
              class="t-input px-3 py-2"
            >
              {quests.map(quest => (
                <option value={quest.id}>{quest.title}</option>
              ))}
            </select>
            <p class="text-xs t-faint mt-1">Hold Ctrl/Cmd to select multiple</p>
          </div>
        </div>

        <div class="flex gap-4 pt-4">
          <button
            type="submit"
            class="t-btn-primary flex-1 px-4 py-2"
          >
            Save Entry
          </button>
          <button
            type="button"
            id="cancelDiaryModal"
            class="t-btn-secondary flex-1"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  import { isVideoUrl } from '../utils/video';

  // Shared state for editing entry ID
  let editingId: string | null = null;

  // Shared state for the session gallery (existing URLs + newly-selected files)
  let galleryExistingUrls: string[] = [];
  let pendingGalleryFiles: File[] = [];

  // Render gallery thumbnails (existing + pending) into the modal preview grid
  function renderGalleryPreview() {
    const container = document.getElementById('galleryPreview');
    if (!container) return;

    container.innerHTML = '';

    const items: Array<{ src: string; isVideo: boolean; kind: 'existing' | 'pending'; index: number }> = [];
    galleryExistingUrls.forEach((url, index) => {
      items.push({ src: url, isVideo: isVideoUrl(url), kind: 'existing', index });
    });
    pendingGalleryFiles.forEach((file, index) => {
      items.push({ src: URL.createObjectURL(file), isVideo: file.type.startsWith('video/'), kind: 'pending', index });
    });

    if (items.length === 0) {
      container.classList.add('hidden');
      return;
    }
    container.classList.remove('hidden');

    items.forEach(item => {
      const wrap = document.createElement('div');
      wrap.className = 'relative';

      const media = item.isVideo
        ? document.createElement('video')
        : document.createElement('img');
      media.src = item.src;
      media.className = 'w-full h-20 object-cover rounded-sm';
      if (item.isVideo) {
        (media as HTMLVideoElement).muted = true;
      }

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = '×';
      btn.title = 'Remove';
      btn.setAttribute('aria-label', 'Remove image');
      btn.className = 'absolute top-1 right-1 w-5 h-5 flex items-center justify-center rounded-full bg-black/70 text-white text-sm leading-none hover:bg-red-600';
      btn.addEventListener('click', () => {
        if (item.kind === 'existing') {
          galleryExistingUrls.splice(item.index, 1);
        } else {
          pendingGalleryFiles.splice(item.index, 1);
        }
        renderGalleryPreview();
      });

      wrap.appendChild(media);
      wrap.appendChild(btn);
      container.appendChild(wrap);
    });
  }

  // Initialize diary modal and form functionality
  function initializeDiaryModal() {
    const modal = document.getElementById('diaryEntryModal');
    const form = document.getElementById('diaryEntryForm') as HTMLFormElement;
    const modalTitle = document.getElementById('diaryModalTitle');
    const addButton = document.getElementById('addDiaryEntry');
    const cancelButton = document.getElementById('cancelDiaryModal');
    const fileInput = document.getElementById('coverImageFile') as HTMLInputElement;
    const urlInput = document.getElementById('coverImageUrl') as HTMLInputElement;
    const imagePreview = document.getElementById('imagePreview');
    const previewImg = document.getElementById('previewImg') as HTMLImageElement;
    const videoFileInput = document.getElementById('coverVideoFile') as HTMLInputElement;
    const videoUrlInput = document.getElementById('coverVideoUrl') as HTMLInputElement;
    const videoPreview = document.getElementById('videoPreview');
    const previewVideo = document.getElementById('previewVideo') as HTMLVideoElement;

  // Handle image file selection and preview
  fileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (e) => {
        if (previewImg && imagePreview) {
          previewImg.src = e.target?.result as string;
          imagePreview.classList.remove('hidden');
        }
        // Clear URL input when file is selected
        if (urlInput) urlInput.value = '';
      };
      reader.readAsDataURL(file);
    } else {
      imagePreview?.classList.add('hidden');
    }
  });

  // Handle URL input and preview
  urlInput?.addEventListener('input', (e) => {
    const url = (e.target as HTMLInputElement).value;
    if (url) {
      if (previewImg && imagePreview) {
        previewImg.src = url;
        imagePreview.classList.remove('hidden');
      }
      // Clear file input when URL is entered
      if (fileInput) fileInput.value = '';
    } else {
      imagePreview?.classList.add('hidden');
    }
  });

  // Handle video file selection and preview
  videoFileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      // Validate file size (5MB limit)
      const maxSize = 5 * 1024 * 1024;
      if (file.size > maxSize) {
        alert('Video file is too large. Maximum size is 5MB.');
        (e.target as HTMLInputElement).value = '';
        videoPreview?.classList.add('hidden');
        return;
      }
      const reader = new FileReader();
      reader.onload = (e) => {
        if (previewVideo && videoPreview) {
          previewVideo.src = e.target?.result as string;
          videoPreview.classList.remove('hidden');
        }
        // Clear URL input when file is selected
        if (videoUrlInput) videoUrlInput.value = '';
      };
      reader.readAsDataURL(file);
    } else {
      videoPreview?.classList.add('hidden');
    }
  });

  // Handle video URL input and preview
  videoUrlInput?.addEventListener('input', (e) => {
    const url = (e.target as HTMLInputElement).value;
    if (url) {
      // Basic URL validation
      try {
        new URL(url);
      } catch {
        // Invalid URL, don't show preview
        videoPreview?.classList.add('hidden');
        return;
      }
      if (previewVideo && videoPreview) {
        previewVideo.src = url;
        videoPreview.classList.remove('hidden');
      }
      // Clear file input when URL is entered
      if (videoFileInput) videoFileInput.value = '';
    } else {
      videoPreview?.classList.add('hidden');
    }
  });

  // Handle gallery multi-file selection
  const galleryFilesInput = document.getElementById('galleryFiles') as HTMLInputElement;
  galleryFilesInput?.addEventListener('change', (e) => {
    const files = Array.from((e.target as HTMLInputElement).files || []);
    const maxSize = 5 * 1024 * 1024; // 5MB
    for (const file of files) {
      if (file.size > maxSize) {
        alert(`"${file.name}" is too large. Maximum size is 5MB.`);
        continue;
      }
      pendingGalleryFiles.push(file);
    }
    // Clear so the same file can be re-selected later
    (e.target as HTMLInputElement).value = '';
    renderGalleryPreview();
  });

  // Open modal for new entry
  addButton?.addEventListener('click', () => {
    editingId = null;
    form.reset();
    document.getElementById('diaryEntryId')?.setAttribute('value', '');
    if (modalTitle) modalTitle.textContent = 'New Diary Entry';
    imagePreview?.classList.add('hidden');
    videoPreview?.classList.add('hidden');
    galleryExistingUrls = [];
    pendingGalleryFiles = [];
    renderGalleryPreview();

    // Set default date to today
    const today = new Date().toISOString().split('T')[0];
    (document.getElementById('date') as HTMLInputElement).value = today;

    modal?.classList.remove('hidden');
  });

  // Close modal
  cancelButton?.addEventListener('click', () => {
    modal?.classList.add('hidden');
  });

  // Close modal on background click
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
    }
  });

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const tags = (formData.get('tags') as string).split(',').map(t => t.trim()).filter(t => t);

    // Get selected values from multi-select fields
    const npcsSelect = document.getElementById('npcs') as HTMLSelectElement;
    const locationsSelect = document.getElementById('locations') as HTMLSelectElement;
    const charactersSelect = document.getElementById('characters') as HTMLSelectElement;
    const questsSelect = document.getElementById('quests') as HTMLSelectElement;

    const npcIds = Array.from(npcsSelect.selectedOptions).map(option => option.value);
    const locationIds = Array.from(locationsSelect.selectedOptions).map(option => option.value);
    const characterIds = Array.from(charactersSelect.selectedOptions).map(option => option.value);
    const questIds = Array.from(questsSelect.selectedOptions).map(option => option.value);

    // Handle image upload if file is selected
    let coverImageUrl = formData.get('coverImageUrl') as string || null;
    const imageFile = formData.get('coverImageFile') as File;

    if (imageFile && imageFile.size > 0) {
      try {
        const uploadFormData = new FormData();
        uploadFormData.append('file', imageFile);

        const uploadResponse = await fetch('/api/upload', {
          method: 'POST',
          body: uploadFormData,
        });

        if (uploadResponse.ok) {
          const uploadData = await uploadResponse.json();
          coverImageUrl = uploadData.url;
        } else {
          const error = await uploadResponse.json();
          alert(`Failed to upload image: ${error.error || 'Unknown error'}`);
          return;
        }
      } catch (error) {
        console.error('Upload error:', error);
        alert('Failed to upload image. Please try again.');
        return;
      }
    }

    // Handle video upload if file is selected
    let coverVideoUrl = formData.get('coverVideoUrl') as string || null;
    const videoFile = formData.get('coverVideoFile') as File;

    if (videoFile && videoFile.size > 0) {
      try {
        const uploadFormData = new FormData();
        uploadFormData.append('file', videoFile);

        const uploadResponse = await fetch('/api/upload', {
          method: 'POST',
          body: uploadFormData,
        });

        if (uploadResponse.ok) {
          const uploadData = await uploadResponse.json();
          coverVideoUrl = uploadData.url;
        } else {
          const error = await uploadResponse.json();
          alert(`Failed to upload video: ${error.error || 'Unknown error'}`);
          return;
        }
      } catch (error) {
        console.error('Upload error:', error);
        alert('Failed to upload video. Please try again.');
        return;
      }
    }

    // Upload any newly-selected gallery files
    const uploadedGalleryUrls: string[] = [];
    for (const file of pendingGalleryFiles) {
      try {
        const uploadFormData = new FormData();
        uploadFormData.append('file', file);

        const uploadResponse = await fetch('/api/upload', {
          method: 'POST',
          body: uploadFormData,
        });

        if (uploadResponse.ok) {
          const uploadData = await uploadResponse.json();
          uploadedGalleryUrls.push(uploadData.url);
        } else {
          const error = await uploadResponse.json();
          alert(`Failed to upload gallery file: ${error.error || 'Unknown error'}`);
          return;
        }
      } catch (error) {
        console.error('Upload error:', error);
        alert('Failed to upload gallery file. Please try again.');
        return;
      }
    }

    const galleryUrls = [...galleryExistingUrls, ...uploadedGalleryUrls];

    const data = {
      title: formData.get('title'),
      date: formData.get('date'),
      session: parseInt(formData.get('session') as string),
      content: formData.get('content'),
      summary: ((formData.get('summary') as string) || '').trim() || null,
      tags,
      coverImageUrl,
      coverVideoUrl,
      galleryUrls,
      npcIds,
      locationIds,
      characterIds,
      questIds,
    };

    try {
      const url = editingId ? `/api/diary/${editingId}` : '/api/diary';
      const method = editingId ? 'PUT' : 'POST';

      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        alert('Failed to save entry. Please try again.');
      }
    } catch (error) {
      alert('An error occurred. Please try again.');
    }
  });

    // Check if we should auto-open modal for editing
    const urlParams = new URLSearchParams(window.location.search);
    const editIdFromUrl = urlParams.get('edit');

    if (editIdFromUrl) {
      // Find and click the edit button for this entry
      const editButton = document.querySelector(`button.edit-entry[data-id="${editIdFromUrl}"]`);
      if (editButton) {
        (editButton as HTMLElement).click();
        // Remove the query parameter from URL
        window.history.replaceState({}, '', '/diary');
      }
    }
  }

  // Edit/Delete entries with event delegation
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    if (target.classList.contains('edit-entry')) {
      const id = target.getAttribute('data-id');
      if (!id) {
        console.error('No data-id found on edit button');
        return;
      }

      // Get DOM elements fresh
      const modal = document.getElementById('diaryEntryModal');
      const modalTitle = document.getElementById('diaryModalTitle');
      const imagePreview = document.getElementById('imagePreview');
      const previewImg = document.getElementById('previewImg') as HTMLImageElement;
      const fileInput = document.getElementById('coverImageFile') as HTMLInputElement;
      const videoPreview = document.getElementById('videoPreview');
      const previewVideo = document.getElementById('previewVideo') as HTMLVideoElement;
      const videoFileInput = document.getElementById('coverVideoFile') as HTMLInputElement;

      try {
        console.log('Fetching diary entry with ID:', id);
        const response = await fetch(`/api/diary/${id}`);
        console.log('Response status:', response.status, 'OK:', response.ok);
        if (!response.ok) {
          const errorData = await response.json().catch(() => ({ error: 'Unknown error' }));
          console.error('API error response:', errorData);
          throw new Error(`Failed to fetch entry: ${errorData.error || response.statusText}`);
        }
        const entry = await response.json();
        console.log('Successfully loaded diary entry:', entry);

        editingId = id;

        // Populate form fields with null checks
        const titleEl = document.getElementById('title') as HTMLInputElement;
        const dateEl = document.getElementById('date') as HTMLInputElement;
        const sessionEl = document.getElementById('session') as HTMLInputElement;
        const contentEl = document.getElementById('content') as HTMLTextAreaElement;
        const summaryEl = document.getElementById('summary') as HTMLTextAreaElement;
        const tagsEl = document.getElementById('tags') as HTMLInputElement;
        const coverImageUrlEl = document.getElementById('coverImageUrl') as HTMLInputElement;
        const coverVideoUrlEl = document.getElementById('coverVideoUrl') as HTMLInputElement;

        if (!titleEl || !dateEl || !sessionEl || !contentEl || !tagsEl || !coverImageUrlEl || !coverVideoUrlEl) {
          console.error('One or more form elements not found');
          throw new Error('Form elements not found');
        }

        titleEl.value = entry.title || '';
        dateEl.value = entry.date || '';
        sessionEl.value = entry.session || '';
        contentEl.value = entry.content || '';
        if (summaryEl) summaryEl.value = entry.summary || '';
        tagsEl.value = Array.isArray(entry.tags) ? entry.tags.join(', ') : '';
        coverImageUrlEl.value = entry.coverImageUrl || '';
        coverVideoUrlEl.value = entry.coverVideoUrl || '';

        // Show image preview if there's a cover image
        if (entry.coverImageUrl && imagePreview && previewImg) {
          previewImg.src = entry.coverImageUrl;
          imagePreview.classList.remove('hidden');
        } else {
          imagePreview?.classList.add('hidden');
        }

        // Show video preview if there's a cover video
        if (entry.coverVideoUrl && videoPreview && previewVideo) {
          previewVideo.src = entry.coverVideoUrl;
          videoPreview.classList.remove('hidden');
        } else {
          videoPreview?.classList.add('hidden');
        }

        // Clear file inputs
        if (fileInput) fileInput.value = '';
        if (videoFileInput) videoFileInput.value = '';

        // Seed the session gallery from the existing entry
        galleryExistingUrls = Array.isArray(entry.galleryUrls) ? [...entry.galleryUrls] : [];
        pendingGalleryFiles = [];
        const galleryFilesEl = document.getElementById('galleryFiles') as HTMLInputElement;
        if (galleryFilesEl) galleryFilesEl.value = '';
        renderGalleryPreview();

        // Set selected values for multi-select fields
        const npcsSelect = document.getElementById('npcs') as HTMLSelectElement;
        const locationsSelect = document.getElementById('locations') as HTMLSelectElement;
        const charactersSelect = document.getElementById('characters') as HTMLSelectElement;
        const questsSelect = document.getElementById('quests') as HTMLSelectElement;

        if (npcsSelect && locationsSelect && charactersSelect && questsSelect) {
          // Clear previous selections
          Array.from(npcsSelect.options).forEach(option => option.selected = false);
          Array.from(locationsSelect.options).forEach(option => option.selected = false);
          Array.from(charactersSelect.options).forEach(option => option.selected = false);
          Array.from(questsSelect.options).forEach(option => option.selected = false);

          // Set new selections
          const npcIds = Array.isArray(entry.npcIds) ? entry.npcIds : [];
          const locationIds = Array.isArray(entry.locationIds) ? entry.locationIds : [];
          const characterIds = Array.isArray(entry.characterIds) ? entry.characterIds : [];
          const questIds = Array.isArray(entry.questIds) ? entry.questIds : [];

          Array.from(npcsSelect.options).forEach(option => {
            if (npcIds.includes(option.value)) option.selected = true;
          });
          Array.from(locationsSelect.options).forEach(option => {
            if (locationIds.includes(option.value)) option.selected = true;
          });
          Array.from(charactersSelect.options).forEach(option => {
            if (characterIds.includes(option.value)) option.selected = true;
          });
          Array.from(questsSelect.options).forEach(option => {
            if (questIds.includes(option.value)) option.selected = true;
          });
        } else {
          console.warn('One or more multi-select elements not found');
        }

        if (modalTitle) modalTitle.textContent = 'Edit Diary Entry';
        modal?.classList.remove('hidden');
      } catch (error) {
        console.error('Failed to load diary entry:', error);
        alert('Failed to load entry. Please try again.');
      }
    }

    // Delete entry
    if (target.classList.contains('delete-entry')) {
      const id = target.getAttribute('data-id');
      if (!id) return;

      if (confirm('Are you sure you want to delete this entry?')) {
        try {
          const response = await fetch(`/api/diary/${id}`, {
            method: 'DELETE',
          });

          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete entry. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    }
  });

  // Initialize search and filter functionality on page load
  // This ensures it works after Astro View Transitions navigation
  function initializeFilters() {
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const filterBtns = document.querySelectorAll('.tag-filter');
    const diaryCards = document.querySelectorAll('.diary-entry');

    let currentFilter = 'all';
    let currentSearch = '';

    const applyFilters = () => {
      const searchTerms = currentSearch.toLowerCase().split(/\s+/).filter(term => term.length > 0);
      diaryCards.forEach(card => {
        const entryTags = JSON.parse(card.getAttribute('data-tags') || '[]');
        const searchText = card.getAttribute('data-search') || '';

        const matchesFilter = currentFilter === 'all' || entryTags.includes(currentFilter);
        // Match if ANY search term is found in the text (more flexible search)
        const matchesSearch = searchTerms.length === 0 || searchTerms.some(term => searchText.includes(term));

        (card as HTMLElement).style.display = matchesFilter && matchesSearch ? 'block' : 'none';
      });
    };

    // Search functionality
    searchInput?.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    // Filter functionality
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentFilter = btn.getAttribute('data-tag') || 'all';

        // Update button styles
        filterBtns.forEach(b => {
          if (b.getAttribute('data-tag') === currentFilter) {
            b.classList.add('active');
          } else {
            b.classList.remove('active');
          }
        });

        applyFilters();
      });
    });
  }

  // Run on initial page load and after View Transitions navigation
  document.addEventListener('astro:page-load', () => {
    initializeDiaryModal();
    initializeFilters();
  });
</script>

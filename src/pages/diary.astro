---
import Layout from '../layouts/Layout.astro';
import { db, DiaryEntry, NPC, Location, Character, Quest } from 'astro:db';
import { isAuthenticated } from '../lib/auth';
import { getVideoMimeType } from '../utils/video';

const diaryEntries = await db.select().from(DiaryEntry);
const npcs = await db.select().from(NPC);
const locations = await db.select().from(Location);
const characters = await db.select().from(Character);
const quests = await db.select().from(Quest);
const isLoggedIn = isAuthenticated(Astro.cookies);
const editId = Astro.url.searchParams.get('edit');

const sortedEntries = diaryEntries.slice().sort((a, b) => 
  b.session - a.session
);

// Get all unique tags from diary entries
const allTags = [...new Set(diaryEntries.flatMap(entry => 
  Array.isArray(entry.tags) ? entry.tags : []
))].sort();

// Get max session number
const maxSession = diaryEntries.length > 0 ? Math.max(...diaryEntries.map(e => e.session)) : 0;
---

<Layout title="Adventure Diary">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold text-primary-700 dark:text-primary-400">Adventure Diary</h1>
    {isLoggedIn && (
      <button 
        id="addEntry"
        class="bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
      >
        + New Entry
      </button>
    )}
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-secondary-600 dark:text-secondary-500">{maxSession}</div>
      <div class="text-gray-600 dark:text-gray-400">Sessions</div>
    </div>
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-accent-600 dark:text-accent-500">{allTags.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Unique Tags</div>
    </div>
  </div>

  <!-- Search and Filter -->
  <div class="bg-white dark:bg-black rounded-lg shadow-md p-4 mb-6 dark:border dark:border-gray-900">
    <div class="flex flex-col md:flex-row gap-4">
      <!-- Search Input -->
      <div class="flex-1">
        <div class="relative">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Search diary entries by title, content, or tags..."
            class="w-full px-4 py-2 pl-10 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100 transition"
          >
          <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>
      <!-- Tag Filter -->
      {allTags.length > 0 && (
        <div class="flex flex-wrap gap-2 items-center">
          <span class="text-sm text-gray-600 dark:text-gray-400 font-medium">Filter:</span>
          <button 
            class="tag-filter px-3 py-1.5 rounded-full text-sm font-medium bg-primary-600 text-white transition-all duration-200 hover:bg-primary-700 active:scale-95"
            data-tag="all"
          >
            All ({diaryEntries.length})
          </button>
          {allTags.map(tag => {
            const count = sortedEntries.filter(e => Array.isArray(e.tags) && e.tags.includes(tag)).length;
            return (
              <button 
                class="tag-filter px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95"
                data-tag={tag}
              >
                #{tag} ({count})
              </button>
            );
          })}
        </div>
      )}
    </div>
  </div>

  <div id="entriesList" class="grid md:grid-cols-2 gap-6">
    {sortedEntries.map(entry => {
      const tags = Array.isArray(entry.tags) ? entry.tags : [];
      return (
      <article class="diary-entry bg-white dark:bg-black rounded-lg shadow-md p-6 hover:shadow-lg transition dark:border dark:border-gray-900" data-entry-id={entry.id} data-tags={JSON.stringify(tags)} data-search={`${entry.title} ${entry.content} ${tags.join(' ')}`.toLowerCase()}>
        {entry.coverVideoUrl ? (
          <div class="mb-4 rounded-lg overflow-hidden">
            <video 
              autoplay
              muted
              playsinline
              loop
              preload="auto"
              disablePictureInPicture
              class="w-full h-48 object-cover"
              aria-label={`Video for ${entry.title}`}
            >
              <source src={entry.coverVideoUrl} type={getVideoMimeType(entry.coverVideoUrl)} />
              Your browser does not support the video tag.
            </video>
          </div>
        ) : entry.coverImageUrl && (
          <div class="mb-4 rounded-lg overflow-hidden">
            <img 
              src={entry.coverImageUrl} 
              alt={entry.title}
              class="w-full h-48 object-cover"
            />
          </div>
        )}
        <div class="mb-4">
          <a href={`/diary/${entry.id}`} class="text-2xl font-semibold text-primary-700 dark:text-primary-400 hover:text-primary-900 dark:hover:text-primary-300 transition">
            {entry.title}
          </a>
          <div class="flex gap-4 text-sm text-gray-500 mt-1">
            <span>Session {entry.session}</span>
          </div>
        </div>
        
        <div class="prose max-w-none mb-4">
          <p class="text-gray-700 dark:text-gray-300 line-clamp-3">{entry.content}</p>
        </div>
        
        <div class="flex gap-2 flex-wrap mb-4">
          {Array.isArray(entry.tags) && entry.tags.map((tag: string) => (
            <span class="bg-primary-100 dark:bg-primary-900/20 dark:border dark:border-primary-800 text-primary-700 dark:text-primary-400 px-3 py-1 rounded-full text-sm">
              #{tag}
            </span>
          ))}
        </div>

        <a 
          href={`/diary/${entry.id}`}
          class="block text-center bg-accent-100 dark:bg-accent-900/20 dark:border dark:border-accent-800 text-accent-700 dark:text-accent-400 px-4 py-2 rounded-lg hover:bg-accent-200 dark:hover:bg-accent-900/30 transition font-medium text-sm"
        >
          View Details →
        </a>

        {isLoggedIn && (
          <div class="flex gap-2 mt-2">
            <button class="edit-entry flex-1 bg-primary-600 text-white px-4 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition text-sm" data-id={entry.id}>Edit</button>
            <button class="delete-entry px-4 py-2 border-2 border-red-600 text-red-600 dark:text-red-400 dark:border-red-500 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition text-sm" data-id={entry.id}>Delete</button>
          </div>
        )}
      </article>
      );
    })}
  </div>

  {sortedEntries.length === 0 && (
    <div class="text-center py-16 bg-white dark:bg-black rounded-lg shadow-md dark:border dark:border-gray-900">
      <p class="text-gray-500 dark:text-gray-400 text-lg">No diary entries yet. Start documenting your adventures!</p>
    </div>
  )}

  <!-- Modal for Add/Edit Entry -->
  <div id="entryModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white dark:bg-black rounded-lg p-4 sm:p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto dark:border dark:border-gray-900">
      <h2 id="modalTitle" class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6 text-primary-700 dark:text-primary-400">New Diary Entry</h2>
      <form id="entryForm" class="space-y-4">
        <input type="hidden" id="entryId" name="id">
        
        <div>
          <label for="title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Title</label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            required 
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          >
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="date" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Date</label>
            <input 
              type="date" 
              id="date" 
              name="date" 
              required 
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
          </div>
          
          <div>
            <label for="session" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Session Number</label>
            <input 
              type="number" 
              id="session" 
              name="session" 
              required 
              min="1"
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
          </div>
        </div>
        
        <div>
          <label for="content" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Content (Markdown supported)
            <a href="https://www.markdownguide.org/basic-syntax/" target="_blank" class="text-xs text-primary-600 dark:text-primary-400 hover:underline ml-2">
              Markdown Guide ↗
            </a>
          </label>
          <textarea 
            id="content" 
            name="content" 
            required 
            rows="10"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          ></textarea>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Use **bold**, *italic*, # headings, - lists, and more</p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Cover Image</label>
          <div class="space-y-3">
            <div>
              <label for="coverImageFile" class="block text-xs text-gray-600 mb-1">Upload Image (max 5MB)</label>
              <input 
                type="file" 
                id="coverImageFile" 
                name="coverImageFile" 
                accept="image/*"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div class="text-center text-sm text-gray-500 dark:text-gray-400">— OR —</div>
            <div>
              <label for="coverImageUrl" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">Image URL</label>
              <input 
                type="text" 
                id="coverImageUrl" 
                name="coverImageUrl" 
                placeholder="https://example.com/image.jpg"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">External URL or uploaded image path</p>
            </div>
          </div>
          <div id="imagePreview" class="mt-3 hidden">
            <img id="previewImg" src="" alt="Preview" class="max-w-xs rounded-lg shadow-md">
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Cover Video</label>
          <div class="space-y-3">
            <div>
              <label for="coverVideoFile" class="block text-xs text-gray-600 mb-1">Upload Video (max 5MB)</label>
              <input 
                type="file" 
                id="coverVideoFile" 
                name="coverVideoFile" 
                accept="video/*"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div class="text-center text-sm text-gray-500 dark:text-gray-400">— OR —</div>
            <div>
              <label for="coverVideoUrl" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">Video URL</label>
              <input 
                type="text" 
                id="coverVideoUrl" 
                name="coverVideoUrl" 
                placeholder="https://example.com/video.mp4"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">External URL or uploaded video path</p>
            </div>
          </div>
          <div id="videoPreview" class="mt-3 hidden">
            <video 
              id="previewVideo" 
              src="" 
              autoplay
              muted
              playsinline
              loop
              preload="auto"
              disablePictureInPicture
              class="max-w-xs rounded-lg shadow-md" 
              aria-label="Video preview"
            ></video>
          </div>
        </div>
        
        <div>
          <label for="tags" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Tags (comma-separated)</label>
          <input 
            type="text" 
            id="tags" 
            name="tags" 
            placeholder="combat, discovery, ruins"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          >
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="npcs" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">NPCs Met</label>
            <select 
              id="npcs" 
              name="npcs" 
              multiple 
              size="4"
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
              {npcs.map(npc => (
                <option value={npc.id}>{npc.name}</option>
              ))}
            </select>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Hold Ctrl/Cmd to select multiple</p>
          </div>

          <div>
            <label for="locations" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Locations Visited</label>
            <select 
              id="locations" 
              name="locations" 
              multiple 
              size="4"
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
              {locations.map(location => (
                <option value={location.id}>{location.name}</option>
              ))}
            </select>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Hold Ctrl/Cmd to select multiple</p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="characters" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Party Members</label>
            <select 
              id="characters" 
              name="characters" 
              multiple 
              size="4"
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
              {characters.map(character => (
                <option value={character.id}>{character.name}</option>
              ))}
            </select>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Hold Ctrl/Cmd to select multiple</p>
          </div>

          <div>
            <label for="quests" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Related Quests</label>
            <select 
              id="quests" 
              name="quests" 
              multiple 
              size="4"
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
              {quests.map(quest => (
                <option value={quest.id}>{quest.title}</option>
              ))}
            </select>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Hold Ctrl/Cmd to select multiple</p>
          </div>
        </div>
        
        <div class="flex gap-4 pt-4">
          <button 
            type="submit" 
            class="flex-1 bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
          >
            Save Entry
          </button>
          <button 
            type="button" 
            id="cancelModal"
            class="flex-1 bg-gray-300 dark:bg-gray-600 text-gray-700 dark:text-gray-200 px-6 py-2 rounded-lg hover:bg-gray-400 dark:hover:bg-gray-700 transition"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  // Shared state for editing entry ID
  let editingId: string | null = null;

  // Initialize diary modal and form functionality
  function initializeDiaryModal() {
    const modal = document.getElementById('entryModal');
    const form = document.getElementById('entryForm') as HTMLFormElement;
    const modalTitle = document.getElementById('modalTitle');
    const addButton = document.getElementById('addEntry');
    const cancelButton = document.getElementById('cancelModal');
    const fileInput = document.getElementById('coverImageFile') as HTMLInputElement;
    const urlInput = document.getElementById('coverImageUrl') as HTMLInputElement;
    const imagePreview = document.getElementById('imagePreview');
    const previewImg = document.getElementById('previewImg') as HTMLImageElement;
    const videoFileInput = document.getElementById('coverVideoFile') as HTMLInputElement;
    const videoUrlInput = document.getElementById('coverVideoUrl') as HTMLInputElement;
    const videoPreview = document.getElementById('videoPreview');
    const previewVideo = document.getElementById('previewVideo') as HTMLVideoElement;

  // Handle image file selection and preview
  fileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (e) => {
        if (previewImg && imagePreview) {
          previewImg.src = e.target?.result as string;
          imagePreview.classList.remove('hidden');
        }
        // Clear URL input when file is selected
        if (urlInput) urlInput.value = '';
      };
      reader.readAsDataURL(file);
    } else {
      imagePreview?.classList.add('hidden');
    }
  });

  // Handle URL input and preview
  urlInput?.addEventListener('input', (e) => {
    const url = (e.target as HTMLInputElement).value;
    if (url) {
      if (previewImg && imagePreview) {
        previewImg.src = url;
        imagePreview.classList.remove('hidden');
      }
      // Clear file input when URL is entered
      if (fileInput) fileInput.value = '';
    } else {
      imagePreview?.classList.add('hidden');
    }
  });

  // Handle video file selection and preview
  videoFileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      // Validate file size (5MB limit)
      const maxSize = 5 * 1024 * 1024;
      if (file.size > maxSize) {
        alert('Video file is too large. Maximum size is 5MB.');
        (e.target as HTMLInputElement).value = '';
        videoPreview?.classList.add('hidden');
        return;
      }
      const reader = new FileReader();
      reader.onload = (e) => {
        if (previewVideo && videoPreview) {
          previewVideo.src = e.target?.result as string;
          videoPreview.classList.remove('hidden');
        }
        // Clear URL input when file is selected
        if (videoUrlInput) videoUrlInput.value = '';
      };
      reader.readAsDataURL(file);
    } else {
      videoPreview?.classList.add('hidden');
    }
  });

  // Handle video URL input and preview
  videoUrlInput?.addEventListener('input', (e) => {
    const url = (e.target as HTMLInputElement).value;
    if (url) {
      // Basic URL validation
      try {
        new URL(url);
      } catch {
        // Invalid URL, don't show preview
        videoPreview?.classList.add('hidden');
        return;
      }
      if (previewVideo && videoPreview) {
        previewVideo.src = url;
        videoPreview.classList.remove('hidden');
      }
      // Clear file input when URL is entered
      if (videoFileInput) videoFileInput.value = '';
    } else {
      videoPreview?.classList.add('hidden');
    }
  });

  // Open modal for new entry
  addButton?.addEventListener('click', () => {
    editingId = null;
    form.reset();
    document.getElementById('entryId')?.setAttribute('value', '');
    if (modalTitle) modalTitle.textContent = 'New Diary Entry';
    imagePreview?.classList.add('hidden');
    videoPreview?.classList.add('hidden');
    
    // Set default date to today
    const today = new Date().toISOString().split('T')[0];
    (document.getElementById('date') as HTMLInputElement).value = today;
    
    modal?.classList.remove('hidden');
  });

  // Close modal
  cancelButton?.addEventListener('click', () => {
    modal?.classList.add('hidden');
  });

  // Close modal on background click
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
    }
  });

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const tags = (formData.get('tags') as string).split(',').map(t => t.trim()).filter(t => t);
    
    // Get selected values from multi-select fields
    const npcsSelect = document.getElementById('npcs') as HTMLSelectElement;
    const locationsSelect = document.getElementById('locations') as HTMLSelectElement;
    const charactersSelect = document.getElementById('characters') as HTMLSelectElement;
    const questsSelect = document.getElementById('quests') as HTMLSelectElement;
    
    const npcIds = Array.from(npcsSelect.selectedOptions).map(option => option.value);
    const locationIds = Array.from(locationsSelect.selectedOptions).map(option => option.value);
    const characterIds = Array.from(charactersSelect.selectedOptions).map(option => option.value);
    const questIds = Array.from(questsSelect.selectedOptions).map(option => option.value);
    
    // Handle image upload if file is selected
    let coverImageUrl = formData.get('coverImageUrl') as string || null;
    const imageFile = formData.get('coverImageFile') as File;
    
    if (imageFile && imageFile.size > 0) {
      try {
        const uploadFormData = new FormData();
        uploadFormData.append('file', imageFile);
        
        const uploadResponse = await fetch('/api/upload', {
          method: 'POST',
          body: uploadFormData,
        });
        
        if (uploadResponse.ok) {
          const uploadData = await uploadResponse.json();
          coverImageUrl = uploadData.url;
        } else {
          const error = await uploadResponse.json();
          alert(`Failed to upload image: ${error.error || 'Unknown error'}`);
          return;
        }
      } catch (error) {
        console.error('Upload error:', error);
        alert('Failed to upload image. Please try again.');
        return;
      }
    }

    // Handle video upload if file is selected
    let coverVideoUrl = formData.get('coverVideoUrl') as string || null;
    const videoFile = formData.get('coverVideoFile') as File;
    
    if (videoFile && videoFile.size > 0) {
      try {
        const uploadFormData = new FormData();
        uploadFormData.append('file', videoFile);
        
        const uploadResponse = await fetch('/api/upload', {
          method: 'POST',
          body: uploadFormData,
        });
        
        if (uploadResponse.ok) {
          const uploadData = await uploadResponse.json();
          coverVideoUrl = uploadData.url;
        } else {
          const error = await uploadResponse.json();
          alert(`Failed to upload video: ${error.error || 'Unknown error'}`);
          return;
        }
      } catch (error) {
        console.error('Upload error:', error);
        alert('Failed to upload video. Please try again.');
        return;
      }
    }
    
    const data = {
      title: formData.get('title'),
      date: formData.get('date'),
      session: parseInt(formData.get('session') as string),
      content: formData.get('content'),
      tags,
      coverImageUrl,
      coverVideoUrl,
      npcIds,
      locationIds,
      characterIds,
      questIds,
    };

    try {
      const url = editingId ? `/api/diary/${editingId}` : '/api/diary';
      const method = editingId ? 'PUT' : 'POST';
      
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        alert('Failed to save entry. Please try again.');
      }
    } catch (error) {
      alert('An error occurred. Please try again.');
    }
  });

    // Check if we should auto-open modal for editing
    const urlParams = new URLSearchParams(window.location.search);
    const editIdFromUrl = urlParams.get('edit');
    
    if (editIdFromUrl) {
      // Find and click the edit button for this entry
      const editButton = document.querySelector(`button.edit-entry[data-id="${editIdFromUrl}"]`);
      if (editButton) {
        (editButton as HTMLElement).click();
        // Remove the query parameter from URL
        window.history.replaceState({}, '', '/diary');
      }
    }
  }

  // Edit/Delete entries with event delegation
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    
    if (target.classList.contains('edit-entry')) {
      const id = target.getAttribute('data-id');
      if (!id) {
        console.error('No data-id found on edit button');
        return;
      }
      
      // Get DOM elements fresh
      const modal = document.getElementById('entryModal');
      const modalTitle = document.getElementById('modalTitle');
      const imagePreview = document.getElementById('imagePreview');
      const previewImg = document.getElementById('previewImg') as HTMLImageElement;
      const fileInput = document.getElementById('coverImageFile') as HTMLInputElement;
      const videoPreview = document.getElementById('videoPreview');
      const previewVideo = document.getElementById('previewVideo') as HTMLVideoElement;
      const videoFileInput = document.getElementById('coverVideoFile') as HTMLInputElement;
      
      try {
        console.log('Fetching diary entry with ID:', id);
        const response = await fetch(`/api/diary/${id}`);
        console.log('Response status:', response.status, 'OK:', response.ok);
        if (!response.ok) {
          const errorData = await response.json().catch(() => ({ error: 'Unknown error' }));
          console.error('API error response:', errorData);
          throw new Error(`Failed to fetch entry: ${errorData.error || response.statusText}`);
        }
        const entry = await response.json();
        console.log('Successfully loaded diary entry:', entry);
        
        editingId = id;
        
        // Populate form fields with null checks
        const titleEl = document.getElementById('title') as HTMLInputElement;
        const dateEl = document.getElementById('date') as HTMLInputElement;
        const sessionEl = document.getElementById('session') as HTMLInputElement;
        const contentEl = document.getElementById('content') as HTMLTextAreaElement;
        const tagsEl = document.getElementById('tags') as HTMLInputElement;
        const coverImageUrlEl = document.getElementById('coverImageUrl') as HTMLInputElement;
        const coverVideoUrlEl = document.getElementById('coverVideoUrl') as HTMLInputElement;
        
        if (!titleEl || !dateEl || !sessionEl || !contentEl || !tagsEl || !coverImageUrlEl || !coverVideoUrlEl) {
          console.error('One or more form elements not found');
          throw new Error('Form elements not found');
        }
        
        titleEl.value = entry.title || '';
        dateEl.value = entry.date || '';
        sessionEl.value = entry.session || '';
        contentEl.value = entry.content || '';
        tagsEl.value = Array.isArray(entry.tags) ? entry.tags.join(', ') : '';
        coverImageUrlEl.value = entry.coverImageUrl || '';
        coverVideoUrlEl.value = entry.coverVideoUrl || '';
        
        // Show image preview if there's a cover image
        if (entry.coverImageUrl && imagePreview && previewImg) {
          previewImg.src = entry.coverImageUrl;
          imagePreview.classList.remove('hidden');
        } else {
          imagePreview?.classList.add('hidden');
        }

        // Show video preview if there's a cover video
        if (entry.coverVideoUrl && videoPreview && previewVideo) {
          previewVideo.src = entry.coverVideoUrl;
          videoPreview.classList.remove('hidden');
        } else {
          videoPreview?.classList.add('hidden');
        }
        
        // Clear file inputs
        if (fileInput) fileInput.value = '';
        if (videoFileInput) videoFileInput.value = '';
        
        // Set selected values for multi-select fields
        const npcsSelect = document.getElementById('npcs') as HTMLSelectElement;
        const locationsSelect = document.getElementById('locations') as HTMLSelectElement;
        const charactersSelect = document.getElementById('characters') as HTMLSelectElement;
        const questsSelect = document.getElementById('quests') as HTMLSelectElement;
        
        if (npcsSelect && locationsSelect && charactersSelect && questsSelect) {
          // Clear previous selections
          Array.from(npcsSelect.options).forEach(option => option.selected = false);
          Array.from(locationsSelect.options).forEach(option => option.selected = false);
          Array.from(charactersSelect.options).forEach(option => option.selected = false);
          Array.from(questsSelect.options).forEach(option => option.selected = false);
          
          // Set new selections
          const npcIds = Array.isArray(entry.npcIds) ? entry.npcIds : [];
          const locationIds = Array.isArray(entry.locationIds) ? entry.locationIds : [];
          const characterIds = Array.isArray(entry.characterIds) ? entry.characterIds : [];
          const questIds = Array.isArray(entry.questIds) ? entry.questIds : [];
          
          Array.from(npcsSelect.options).forEach(option => {
            if (npcIds.includes(option.value)) option.selected = true;
          });
          Array.from(locationsSelect.options).forEach(option => {
            if (locationIds.includes(option.value)) option.selected = true;
          });
          Array.from(charactersSelect.options).forEach(option => {
            if (characterIds.includes(option.value)) option.selected = true;
          });
          Array.from(questsSelect.options).forEach(option => {
            if (questIds.includes(option.value)) option.selected = true;
          });
        } else {
          console.warn('One or more multi-select elements not found');
        }
        
        if (modalTitle) modalTitle.textContent = 'Edit Diary Entry';
        modal?.classList.remove('hidden');
      } catch (error) {
        console.error('Failed to load diary entry:', error);
        alert('Failed to load entry. Please try again.');
      }
    }
    
    // Delete entry
    if (target.classList.contains('delete-entry')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      if (confirm('Are you sure you want to delete this entry?')) {
        try {
          const response = await fetch(`/api/diary/${id}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete entry. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    }
  });

  // Initialize search and filter functionality on page load
  // This ensures it works after Astro View Transitions navigation
  function initializeFilters() {
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const filterBtns = document.querySelectorAll('.tag-filter');
    const diaryCards = document.querySelectorAll('.diary-entry');
    
    let currentFilter = 'all';
    let currentSearch = '';

    const applyFilters = () => {
      const searchTerms = currentSearch.toLowerCase().split(/\s+/).filter(term => term.length > 0);
      diaryCards.forEach(card => {
        const entryTags = JSON.parse(card.getAttribute('data-tags') || '[]');
        const searchText = card.getAttribute('data-search') || '';
        
        const matchesFilter = currentFilter === 'all' || entryTags.includes(currentFilter);
        // Match if ANY search term is found in the text (more flexible search)
        const matchesSearch = searchTerms.length === 0 || searchTerms.some(term => searchText.includes(term));
        
        (card as HTMLElement).style.display = matchesFilter && matchesSearch ? 'block' : 'none';
      });
    };

    // Search functionality
    searchInput?.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    // Filter functionality
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentFilter = btn.getAttribute('data-tag') || 'all';
        
        // Update button styles
        filterBtns.forEach(b => {
          if (b.getAttribute('data-tag') === currentFilter) {
            b.classList.remove('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
            b.classList.add('bg-primary-600', 'text-white');
          } else {
            b.classList.remove('bg-primary-600', 'text-white');
            b.classList.add('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
          }
        });
        
        applyFilters();
      });
    });
  }

  // Run on initial page load and after View Transitions navigation
  document.addEventListener('astro:page-load', () => {
    initializeDiaryModal();
    initializeFilters();

    // Ensure videos play after View Transitions navigation
    const videos = document.querySelectorAll('video');
    videos.forEach(video => {
      // Reset and play the video to ensure autoplay works after navigation
      video.load();
      video.play().catch(error => {
        // Autoplay might be blocked, which is fine - user needs to interact first
        console.debug('Video autoplay prevented:', error);
      });
    });
  });
</script>

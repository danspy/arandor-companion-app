---
import Layout from '../layouts/Layout.astro';
import { db, Location } from 'astro:db';

const locations = await db.select().from(Location);

const visitedLocations = locations.filter(l => l.visited);
const unvisitedLocations = locations.filter(l => !l.visited);
---

<Layout title="Locations">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold text-purple-700">Locations</h1>
    <button 
      id="addLocation"
      class="bg-purple-600 text-white px-6 py-2 rounded-lg hover:bg-purple-700 transition"
    >
      + Add Location
    </button>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    <div class="bg-white rounded-lg shadow-md p-6 text-center">
      <div class="text-3xl font-bold text-purple-600">{locations.length}</div>
      <div class="text-gray-600">Total Locations</div>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6 text-center">
      <div class="text-3xl font-bold text-green-600">{visitedLocations.length}</div>
      <div class="text-gray-600">Visited</div>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6 text-center">
      <div class="text-3xl font-bold text-gray-600">{unvisitedLocations.length}</div>
      <div class="text-gray-600">To Explore</div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {locations.map(location => (
      <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
        <div class={`h-2 ${
          location.type === 'city' ? 'bg-blue-500' :
          location.type === 'dungeon' ? 'bg-purple-500' :
          location.type === 'wilderness' ? 'bg-green-500' :
          location.type === 'building' ? 'bg-amber-500' :
          'bg-gray-500'
        }`}></div>
        
        <div class="p-6">
          <div class="flex justify-between items-start mb-3">
            <h2 class="text-xl font-bold text-gray-900">{location.name}</h2>
            {location.visited && (
              <span class="bg-green-100 text-green-700 px-2 py-1 rounded text-xs font-medium">
                ✓ Visited
              </span>
            )}
          </div>

          <div class="flex gap-2 mb-3">
            <span class={`px-2 py-1 rounded text-xs font-medium ${
              location.type === 'city' ? 'bg-blue-100 text-blue-700' :
              location.type === 'dungeon' ? 'bg-purple-100 text-purple-700' :
              location.type === 'wilderness' ? 'bg-green-100 text-green-700' :
              location.type === 'building' ? 'bg-amber-100 text-amber-700' :
              'bg-gray-100 text-gray-700'
            }`}>
              {location.type}
            </span>
            {location.region && (
              <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded text-xs">
                {location.region}
              </span>
            )}
          </div>

          <p class="text-gray-700 mb-4">{location.description}</p>

          {location.notes && (
            <div class="bg-blue-50 border-l-4 border-blue-500 p-3 mb-4">
              <p class="text-sm text-blue-900"><strong>Notes:</strong> {location.notes}</p>
            </div>
          )}

          <div class="flex gap-2">
            <button class="edit-location flex-1 bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700 transition text-sm" data-id={location.id}>
              Edit
            </button>
            <button class="delete-location px-3 py-2 border border-red-300 text-red-600 rounded hover:bg-red-50 transition text-sm" data-id={location.id}>
              Delete
            </button>
          </div>
        </div>
      </div>
    ))}
  </div>

  {locations.length === 0 && (
    <div class="text-center py-16 bg-white rounded-lg shadow-md">
      <p class="text-gray-500 text-lg">No locations yet. Start mapping your world!</p>
    </div>
  )}

  <!-- Modal for Add/Edit Location -->
  <div id="locationModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg p-8 max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto">
      <h2 id="modalTitle" class="text-2xl font-bold mb-6 text-purple-700">New Location</h2>
      <form id="locationForm" class="space-y-4">
        <input type="hidden" id="locationId" name="id">
        
        <div>
          <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            required 
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
          >
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="type" class="block text-sm font-medium text-gray-700 mb-1">Type</label>
            <select 
              id="type" 
              name="type" 
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
            >
              <option value="city">City</option>
              <option value="dungeon">Dungeon</option>
              <option value="wilderness">Wilderness</option>
              <option value="building">Building</option>
              <option value="other">Other</option>
            </select>
          </div>
          
          <div>
            <label for="region" class="block text-sm font-medium text-gray-700 mb-1">Region (optional)</label>
            <input 
              type="text" 
              id="region" 
              name="region" 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
            >
          </div>
        </div>
        
        <div>
          <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
          <textarea 
            id="description" 
            name="description" 
            required 
            rows="3"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
          ></textarea>
        </div>
        
        <div>
          <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Notes (optional)</label>
          <textarea 
            id="notes" 
            name="notes" 
            rows="2"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
          ></textarea>
        </div>
        
        <div>
          <label class="flex items-center">
            <input 
              type="checkbox" 
              id="visited" 
              name="visited"
              class="w-4 h-4 text-purple-600 border-gray-300 rounded focus:ring-purple-500"
            >
            <span class="ml-2 text-sm text-gray-700">Mark as visited</span>
          </label>
        </div>
        
        <div class="flex gap-4 pt-4">
          <button 
            type="submit" 
            class="flex-1 bg-purple-600 text-white px-6 py-2 rounded-lg hover:bg-purple-700 transition"
          >
            Save Location
          </button>
          <button 
            type="button" 
            id="cancelModal"
            class="flex-1 bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 transition"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  const modal = document.getElementById('locationModal');
  const form = document.getElementById('locationForm') as HTMLFormElement;
  const modalTitle = document.getElementById('modalTitle');
  const addButton = document.getElementById('addLocation');
  const cancelButton = document.getElementById('cancelModal');

  let editingId: string | null = null;

  // Open modal for new location
  addButton?.addEventListener('click', () => {
    editingId = null;
    form.reset();
    if (modalTitle) modalTitle.textContent = 'New Location';
    modal?.classList.remove('hidden');
  });

  // Close modal
  cancelButton?.addEventListener('click', () => {
    modal?.classList.add('hidden');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
    }
  });

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const data = {
      name: formData.get('name'),
      type: formData.get('type'),
      region: formData.get('region') || undefined,
      description: formData.get('description'),
      notes: formData.get('notes') || undefined,
      visited: formData.get('visited') === 'on',
    };

    try {
      const url = editingId ? `/api/locations/${editingId}` : '/api/locations';
      const method = editingId ? 'PUT' : 'POST';
      
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        alert('Failed to save location. Please try again.');
      }
    } catch (error) {
      alert('An error occurred. Please try again.');
    }
  });

  // Edit location
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    
    if (target.classList.contains('edit-location')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      try {
        const response = await fetch(`/api/locations/${id}`);
        const location = await response.json();
        
        editingId = id;
        (document.getElementById('name') as HTMLInputElement).value = location.name;
        (document.getElementById('type') as HTMLSelectElement).value = location.type;
        (document.getElementById('region') as HTMLInputElement).value = location.region || '';
        (document.getElementById('description') as HTMLTextAreaElement).value = location.description;
        (document.getElementById('notes') as HTMLTextAreaElement).value = location.notes || '';
        (document.getElementById('visited') as HTMLInputElement).checked = location.visited;
        
        if (modalTitle) modalTitle.textContent = 'Edit Location';
        modal?.classList.remove('hidden');
      } catch (error) {
        alert('Failed to load location. Please try again.');
      }
    }
    
    // Delete location
    if (target.classList.contains('delete-location')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      if (confirm('Are you sure you want to delete this location?')) {
        try {
          const response = await fetch(`/api/locations/${id}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete location. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    }
  });
</script>
</script>

---
import Layout from '../layouts/Layout.astro';
import { db, Location } from 'astro:db';
import { isAuthenticated } from '../lib/auth';

const locations = await db.select().from(Location);
const isLoggedIn = isAuthenticated(Astro.cookies);

const visitedLocations = locations.filter(l => l.visited);
const unvisitedLocations = locations.filter(l => !l.visited);

// Get unique types for filtering
const allTypes = [...new Set(locations.map(l => l.type).filter(Boolean))].sort();
---

<Layout title="Locations">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold text-primary-700 dark:text-primary-400">Locations</h1>
    {isLoggedIn && (
      <button 
        id="addLocation"
        class="bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
      >
        + Add Location
      </button>
    )}
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-primary-600 dark:text-primary-400">{locations.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Total Locations</div>
    </div>
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-green-600 dark:text-green-400">{visitedLocations.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Visited</div>
    </div>
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-gray-600 dark:text-gray-400">{unvisitedLocations.length}</div>
      <div class="text-gray-600 dark:text-gray-400">To Explore</div>
    </div>
  </div>

  <!-- Search and Filter -->
  <div class="bg-white dark:bg-black rounded-lg shadow-md p-4 mb-6 dark:border dark:border-gray-900">
    <div class="flex flex-col md:flex-row gap-4">
      <!-- Search Input -->
      <div class="flex-1">
        <div class="relative">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Search locations by name, type, region, or description..."
            class="w-full px-4 py-2 pl-10 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100 transition"
          >
          <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>
      <!-- Type Filter -->
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-sm text-gray-600 dark:text-gray-400 font-medium">Filter:</span>
        <button 
          class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium bg-primary-600 text-white transition-all duration-200 hover:bg-primary-700 active:scale-95" 
          data-filter="all"
        >
          All ({locations.length})
        </button>
        <button 
          class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95" 
          data-filter="visited"
        >
          Visited ({visitedLocations.length})
        </button>
        <button 
          class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95" 
          data-filter="unvisited"
        >
          Unvisited ({unvisitedLocations.length})
        </button>
        {allTypes.map(type => {
          const count = locations.filter(l => l.type === type).length;
          return (
            <button 
              class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95" 
              data-filter={type}
            >
              {type} ({count})
            </button>
          );
        })}
      </div>
    </div>
  </div>

  <div id="locationGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {locations.map(location => (
      <div class="location-card bg-white dark:bg-black rounded-lg shadow-md overflow-hidden hover:shadow-lg transition dark:border dark:border-gray-900" data-type={location.type} data-visited={location.visited ? 'true' : 'false'} data-search={`${location.name} ${location.type} ${location.region || ''} ${location.description}`.toLowerCase()}>
        <a href={`/locations/${location.id}`} class="block">
          <div class={`h-2 ${
            location.type === 'city' ? 'bg-blue-500' :
            location.type === 'dungeon' ? 'bg-primary-500' :
            location.type === 'wilderness' ? 'bg-green-500' :
            location.type === 'building' ? 'bg-amber-500' :
            'bg-gray-500'
          }`}></div>
        </a>
        
        <div class="p-6">
          <a href={`/locations/${location.id}`} class="block hover:text-primary-700 transition">
            <div class="flex justify-between items-start mb-3">
              <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">{location.name}</h2>
              {location.visited && (
                <span class="bg-green-100 dark:bg-green-900/20 dark:border dark:border-green-800 text-green-700 dark:text-green-400 px-2 py-1 rounded text-xs font-medium">
                  ✓ Visited
                </span>
              )}
            </div>

            <div class="flex gap-2 mb-3">
              <span class={`px-2 py-1 rounded text-xs font-medium ${
                location.type === 'city' ? 'bg-blue-100 text-blue-700 dark:bg-blue-900/20 dark:text-blue-400' :
                location.type === 'dungeon' ? 'bg-primary-100 text-primary-700 dark:bg-primary-900/20 dark:text-primary-400' :
                location.type === 'wilderness' ? 'bg-green-100 text-green-700 dark:bg-green-900/20 dark:text-green-400' :
                location.type === 'building' ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/20 dark:text-amber-400' :
                'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300'
              }`}>
                {location.type}
              </span>
              {location.region && (
                <span class="bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 px-2 py-1 rounded text-xs">
                  {location.region}
                </span>
              )}
            </div>

            <p class="text-gray-700 dark:text-gray-300 mb-4 line-clamp-3">{location.description}</p>
          </a>

          {location.notes && (
            <div class="bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-500 dark:border-blue-400 p-3 mb-4 dark:border dark:border-blue-800">
              <p class="text-sm text-blue-900 dark:text-blue-200"><strong>Notes:</strong> {location.notes}</p>
            </div>
          )}

          <a 
            href={`/locations/${location.id}`}
            class="block mb-2 text-center bg-accent-100 dark:bg-accent-900/20 dark:border dark:border-accent-800 text-accent-700 dark:text-accent-400 px-4 py-2 rounded hover:bg-accent-200 dark:hover:bg-accent-900/30 transition font-medium text-sm"
          >
            View Details →
          </a>

          {isLoggedIn && (
            <div class="flex gap-2">
              <button class="edit-location flex-1 bg-primary-600 text-white px-4 py-2 rounded hover:bg-primary-700 transition text-sm" data-id={location.id}>
                Edit
              </button>
              <button class="delete-location px-3 py-2 border border-red-300 text-red-600 rounded hover:bg-red-50 transition text-sm" data-id={location.id}>
                Delete
              </button>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>

  {locations.length === 0 && (
    <div class="text-center py-16 bg-white rounded-lg shadow-md">
      <p class="text-gray-500 text-lg">No locations yet. Start mapping your world!</p>
    </div>
  )}

  <!-- Modal for Add/Edit Location -->
  <div id="locationModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white dark:bg-black rounded-lg p-4 sm:p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto dark:border dark:border-gray-900">
      <h2 id="modalTitle" class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6 text-primary-700 dark:text-primary-400">New Location</h2>
      <form id="locationForm" class="space-y-4">
        <input type="hidden" id="locationId" name="id">
        
        <div>
          <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Name</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            required 
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          >
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="type" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Type</label>
            <select 
              id="type" 
              name="type" 
              required
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
              <option value="city">City</option>
              <option value="dungeon">Dungeon</option>
              <option value="wilderness">Wilderness</option>
              <option value="building">Building</option>
              <option value="other">Other</option>
            </select>
          </div>
          
          <div>
            <label for="region" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Region (optional)</label>
            <input 
              type="text" 
              id="region" 
              name="region" 
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
          </div>
        </div>
        
        <div>
          <label for="description" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Description</label>
          <textarea 
            id="description" 
            name="description" 
            required 
            rows="3"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          ></textarea>
        </div>
        
        <div>
          <label for="notes" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Notes (optional)</label>
          <textarea 
            id="notes" 
            name="notes" 
            rows="2"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          ></textarea>
        </div>
        
        <div>
          <label class="flex items-center">
            <input 
              type="checkbox" 
              id="visited" 
              name="visited"
              class="w-4 h-4 text-primary-600 dark:text-primary-500 bg-gray-100 dark:bg-gray-700 border-gray-300 dark:border-gray-600 rounded focus:ring-primary-500"
            >
            <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Mark as visited</span>
          </label>
        </div>
        
        <div>
          <label class="flex items-center">
            <input 
              type="checkbox" 
              id="visibleOnMap" 
              name="visibleOnMap"
              class="w-4 h-4 text-primary-600 dark:text-primary-500 bg-gray-100 dark:bg-gray-700 border-gray-300 dark:border-gray-600 rounded focus:ring-primary-500"
            >
            <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Show pin on map</span>
          </label>
          <p class="text-xs text-gray-500 dark:text-gray-400 ml-6 mt-1">Uncheck to hide this location pin on the map (can be enabled later in edit mode)</p>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="mapX" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Map X Coordinate (optional)</label>
            <input 
              type="number" 
              id="mapX" 
              name="mapX" 
              min="0"
              max="100"
              step="0.1"
              placeholder="0-100"
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
          </div>
          <div>
            <label for="mapY" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Map Y Coordinate (optional)</label>
            <input 
              type="number" 
              id="mapY" 
              name="mapY" 
              min="0"
              max="100"
              step="0.1"
              placeholder="0-100"
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
          </div>
        </div>
        
        <div class="flex gap-4 pt-4">
          <button 
            type="submit" 
            class="flex-1 bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
          >
            Save Location
          </button>
          <button 
            type="button" 
            id="cancelModal"
            class="flex-1 bg-gray-300 dark:bg-gray-600 text-gray-700 dark:text-gray-200 px-6 py-2 rounded-lg hover:bg-gray-400 dark:hover:bg-gray-500 transition"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  const modal = document.getElementById('locationModal');
  const form = document.getElementById('locationForm') as HTMLFormElement;
  const modalTitle = document.getElementById('modalTitle');
  const addButton = document.getElementById('addLocation');
  const cancelButton = document.getElementById('cancelModal');

  let editingId: string | null = null;

  // Open modal for new location
  addButton?.addEventListener('click', () => {
    editingId = null;
    form.reset();
    if (modalTitle) modalTitle.textContent = 'New Location';
    modal?.classList.remove('hidden');
  });

  // Close modal
  cancelButton?.addEventListener('click', () => {
    modal?.classList.add('hidden');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
    }
  });

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const mapX = formData.get('mapX');
    const mapY = formData.get('mapY');
    
    const data = {
      name: formData.get('name'),
      type: formData.get('type'),
      region: formData.get('region') || undefined,
      description: formData.get('description'),
      notes: formData.get('notes') || undefined,
      visited: formData.get('visited') === 'on',
      visibleOnMap: formData.get('visibleOnMap') === 'on',
      mapX: mapX ? parseFloat(mapX as string) : undefined,
      mapY: mapY ? parseFloat(mapY as string) : undefined,
    };

    try {
      const url = editingId ? `/api/locations/${editingId}` : '/api/locations';
      const method = editingId ? 'PUT' : 'POST';
      
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        alert('Failed to save location. Please try again.');
      }
    } catch (error) {
      alert('An error occurred. Please try again.');
    }
  });

  // Edit location
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    
    if (target.classList.contains('edit-location')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      try {
        const response = await fetch(`/api/locations/${id}`);
        const location = await response.json();
        
        editingId = id;
        (document.getElementById('name') as HTMLInputElement).value = location.name;
        (document.getElementById('type') as HTMLSelectElement).value = location.type;
        (document.getElementById('region') as HTMLInputElement).value = location.region || '';
        (document.getElementById('description') as HTMLTextAreaElement).value = location.description;
        (document.getElementById('notes') as HTMLTextAreaElement).value = location.notes || '';
        (document.getElementById('visited') as HTMLInputElement).checked = location.visited;
        (document.getElementById('visibleOnMap') as HTMLInputElement).checked = location.visibleOnMap !== false;
        (document.getElementById('mapX') as HTMLInputElement).value = location.mapX || '';
        (document.getElementById('mapY') as HTMLInputElement).value = location.mapY || '';
        
        if (modalTitle) modalTitle.textContent = 'Edit Location';
        modal?.classList.remove('hidden');
      } catch (error) {
        alert('Failed to load location. Please try again.');
      }
    }
    
    // Delete location
    if (target.classList.contains('delete-location')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      if (confirm('Are you sure you want to delete this location?')) {
        try {
          const response = await fetch(`/api/locations/${id}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete location. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    }
  });

  // Check for edit parameter on page load and open modal if present
  (async () => {
    const urlParams = new URLSearchParams(window.location.search);
    const editId = urlParams.get('edit');
    
    if (editId && modal && form && modalTitle) {
      try {
        const response = await fetch(`/api/locations/${editId}`);
        if (!response.ok) {
          throw new Error('Location not found');
        }
        
        const location = await response.json();
        
        editingId = editId;
        (document.getElementById('name') as HTMLInputElement).value = location.name;
        (document.getElementById('type') as HTMLSelectElement).value = location.type;
        (document.getElementById('region') as HTMLInputElement).value = location.region || '';
        (document.getElementById('description') as HTMLTextAreaElement).value = location.description;
        (document.getElementById('notes') as HTMLTextAreaElement).value = location.notes || '';
        (document.getElementById('visited') as HTMLInputElement).checked = location.visited;
        (document.getElementById('visibleOnMap') as HTMLInputElement).checked = location.visibleOnMap !== false;
        (document.getElementById('mapX') as HTMLInputElement).value = location.mapX || '';
        (document.getElementById('mapY') as HTMLInputElement).value = location.mapY || '';
        
        modalTitle.textContent = 'Edit Location';
        modal.classList.remove('hidden');
        
        // Clear the URL parameter so refreshing doesn't re-open the modal
        window.history.replaceState({}, '', '/locations');
      } catch (error) {
        console.error('Failed to load location for editing:', error);
        alert('Failed to load location. Please try again.');
      }
    }
  })();

  // Search and Filter functionality
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const filterBtns = document.querySelectorAll('.filter-btn');
  const locationCards = document.querySelectorAll('.location-card');
  
  let currentFilter = 'all';
  let currentSearch = '';

  const applyFilters = () => {
    const searchTerms = currentSearch.toLowerCase().split(/\s+/).filter(term => term.length > 0);
    locationCards.forEach(card => {
      const cardType = card.getAttribute('data-type') || '';
      const cardVisited = card.getAttribute('data-visited') || '';
      const searchText = card.getAttribute('data-search') || '';
      
      let matchesFilter = false;
      if (currentFilter === 'all') {
        matchesFilter = true;
      } else if (currentFilter === 'visited') {
        matchesFilter = cardVisited === 'true';
      } else if (currentFilter === 'unvisited') {
        matchesFilter = cardVisited === 'false';
      } else {
        matchesFilter = cardType === currentFilter;
      }
      
      // Match if ANY search term is found in the text (more flexible search)
      const matchesSearch = searchTerms.length === 0 || searchTerms.some(term => searchText.includes(term));
      
      (card as HTMLElement).style.display = matchesFilter && matchesSearch ? 'block' : 'none';
    });
  };

  // Search functionality
  searchInput?.addEventListener('input', (e) => {
    currentSearch = (e.target as HTMLInputElement).value;
    applyFilters();
  });

  // Filter functionality
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      currentFilter = btn.getAttribute('data-filter') || 'all';
      
      // Update button styles
      filterBtns.forEach(b => {
        if (b.getAttribute('data-filter') === currentFilter) {
          b.classList.remove('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
          b.classList.add('bg-primary-600', 'text-white');
        } else {
          b.classList.remove('bg-primary-600', 'text-white');
          b.classList.add('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
        }
      });
      
      applyFilters();
    });
  });
</script>

---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { db, Location, PageSettings, eq } from 'astro:db';
import { isAuthenticated, getUserRole } from '../lib/auth';

const locations = await db.select().from(Location);
const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);
const canEditHero = userRole === 'admin' || userRole === 'dungeonmaster';

const visitedLocations = locations.filter(l => l.visited);
const unvisitedLocations = locations.filter(l => !l.visited);

// Get unique types for filtering
const allTypes = [...new Set(locations.map(l => l.type).filter(Boolean))].sort();

// Get page settings for hero image
const pageSettings = await db.select().from(PageSettings).where(eq(PageSettings.pageName, 'locations'));
const heroImageUrl = pageSettings.length > 0 ? pageSettings[0].heroImageUrl : null;
---

<Layout title="Locations">
  <PageHero 
    title="Locations" 
    heroImageUrl={heroImageUrl}
    pageName="locations"
    canEditHero={canEditHero}
  />

  {isLoggedIn && (
    <div class="flex justify-end mb-4">
      <Button 
        variant="primary"
        size="md"
        icon="add"
        id="addLocation"
        title="Add new Add Location"
      >
        Add Location
      </Button>
    </div>
  )}

  <!-- Stats -->
  <div class="grid grid-cols-3 gap-2 md:gap-4 mb-8">
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-3 md:p-6 text-center dark:border dark:border-gray-900">
      <div class="text-2xl md:text-3xl font-bold text-primary-600 dark:text-primary-400">{locations.length}</div>
      <div class="text-xs md:text-base text-gray-600 dark:text-gray-400">Total Locations</div>
    </div>
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-3 md:p-6 text-center dark:border dark:border-gray-900">
      <div class="text-2xl md:text-3xl font-bold text-green-600 dark:text-green-400">{visitedLocations.length}</div>
      <div class="text-xs md:text-base text-gray-600 dark:text-gray-400">Visited</div>
    </div>
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-3 md:p-6 text-center dark:border dark:border-gray-900">
      <div class="text-2xl md:text-3xl font-bold text-gray-600 dark:text-gray-400">{unvisitedLocations.length}</div>
      <div class="text-xs md:text-base text-gray-600 dark:text-gray-400">To Explore</div>
    </div>
  </div>

  <!-- Search and Filter -->
  <div class="bg-white dark:bg-black rounded-lg shadow-md p-4 mb-6 dark:border dark:border-gray-900">
    <div class="flex flex-col gap-3">
      <!-- Search Input - Always Full Width -->
      <div class="relative w-full">
        <input 
          type="text" 
          id="searchInput" 
          placeholder="Search locations by name, type, region, or description..."
          class="w-full px-4 py-2 pl-10 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100 transition"
        >
        <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <!-- Type Filter Below -->
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-sm text-gray-600 dark:text-gray-400 font-medium">Filter:</span>
        <button 
          class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium bg-primary-600 text-white transition-all duration-200 hover:bg-primary-700 active:scale-95" 
          data-filter="all"
        >
          All ({locations.length})
        </button>
        <button 
          class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95" 
          data-filter="visited"
        >
          Visited ({visitedLocations.length})
        </button>
        <button 
          class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95" 
          data-filter="unvisited"
        >
          Unvisited ({unvisitedLocations.length})
        </button>
        {allTypes.map(type => {
          const count = locations.filter(l => l.type === type).length;
          return (
            <button 
              class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95" 
              data-filter={type}
            >
              {type} ({count})
            </button>
          );
        })}
      </div>
    </div>
  </div>

  <div id="locationGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {locations.map(location => (
      <div class="location-card bg-white dark:bg-black rounded-lg shadow-md overflow-hidden hover:shadow-lg transition dark:border dark:border-gray-900" data-type={location.type} data-visited={location.visited ? 'true' : 'false'} data-search={`${location.name} ${location.type} ${location.region || ''} ${location.description}`.toLowerCase()}>
        <a href={`/locations/${location.id}`} class="block">
          <div class={`relative overflow-hidden ${location.imageUrl ? 'h-56' : 'h-12'}`}>
            <!-- Background -->
            {location.imageUrl ? (
              <>
                <img 
                  src={location.imageUrl} 
                  alt={location.name}
                  class="absolute inset-0 w-full h-full object-cover"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
              </>
            ) : (
              <div class={`absolute inset-0 ${
                location.type === 'city' ? 'bg-gradient-to-br from-blue-600 to-blue-500' :
                location.type === 'dungeon' ? 'bg-gradient-to-br from-purple-600 to-purple-500' :
                location.type === 'wilderness' ? 'bg-gradient-to-br from-green-600 to-green-500' :
                location.type === 'building' ? 'bg-gradient-to-br from-amber-600 to-amber-500' :
                'bg-gradient-to-br from-gray-600 to-gray-500'
              }`}></div>
            )}
            
            <!-- Type badge -->
            <div class={`absolute top-3 right-3 text-white text-xs px-3 py-1 rounded-full shadow-lg ${
              location.type === 'city' ? 'bg-blue-600/90' :
              location.type === 'dungeon' ? 'bg-purple-600/90' :
              location.type === 'wilderness' ? 'bg-green-600/90' :
              location.type === 'building' ? 'bg-amber-600/90' :
              'bg-gray-600/90'
            }`}>
              {location.type.charAt(0).toUpperCase() + location.type.slice(1)}
            </div>
          </div>
        </a>
        
        <div class="p-6">
          <div class="flex items-start justify-between gap-2 mb-2">
            <a href={`/locations/${location.id}`} class="block hover:text-primary-700 dark:hover:text-primary-400 transition">
              <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{location.name}</h2>
            </a>
            {isLoggedIn && (
              <div class="flex gap-2 items-center flex-shrink-0">
                <Button
                  variant="icon"
                  size="sm"
                  icon="edit"
                  iconPosition="only"
                  class="edit-location"
                  data-id={location.id}
                  title="Edit location"
                  ariaLabel="Edit location"
                />
                <Button
                  variant="ghost"
                  size="sm"
                  icon="delete"
                  iconPosition="only"
                  class="delete-location hover:text-red-600 dark:hover:text-red-400"
                  data-id={location.id}
                  title="Delete location"
                  ariaLabel="Delete location"
                />
              </div>
            )}
          </div>
          <a href={`/locations/${location.id}`} class="block hover:text-primary-700 dark:hover:text-primary-400 transition">
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              {location.region && `${location.region}`}
              {location.visited && (
                <span class="ml-2 text-green-600 dark:text-green-400">✓ Visited</span>
              )}
            </p>
          </a>

          {location.notes && (
            <div class="bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-500 dark:border-blue-400 p-3 mb-4 dark:border dark:border-blue-800">
              <p class="text-sm text-blue-900 dark:text-blue-200"><strong>Notes:</strong> {location.notes}</p>
            </div>
          )}

          <a 
            href={`/locations/${location.id}`}
            class="block mt-4 text-center bg-accent-100 dark:bg-accent-900/20 dark:border dark:border-accent-800 text-accent-700 dark:text-accent-400 px-4 py-2 rounded-lg hover:bg-accent-200 dark:hover:bg-accent-900/30 transition font-medium text-sm"
          >
            View Details →
          </a>
        </div>
      </div>
    ))}
  </div>

  {locations.length === 0 && (
    <div class="text-center py-16 bg-white rounded-lg shadow-md">
      <p class="text-gray-500 text-lg">No locations yet. Start mapping your world!</p>
    </div>
  )}

  <!-- Modal for Add/Edit Location -->
  <div id="locationModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white dark:bg-black rounded-lg p-4 sm:p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto dark:border dark:border-gray-900">
      <h2 id="modalTitle" class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6 text-primary-700 dark:text-primary-400">New Location</h2>
      <form id="locationForm" class="space-y-4">
        <input type="hidden" id="locationId" name="id">
        
        <div>
          <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Name</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            required 
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          >
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="type" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Type</label>
            <select 
              id="type" 
              name="type" 
              required
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
              <option value="city">City</option>
              <option value="dungeon">Dungeon</option>
              <option value="wilderness">Wilderness</option>
              <option value="building">Building</option>
              <option value="other">Other</option>
            </select>
          </div>
          
          <div>
            <label for="region" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Region (optional)</label>
            <input 
              type="text" 
              id="region" 
              name="region" 
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
          </div>
        </div>
        
        <div>
          <label for="description" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Description</label>
          <textarea 
            id="description" 
            name="description" 
            required 
            rows="3"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          ></textarea>
        </div>
        
        <div>
          <label for="notes" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Notes (optional)</label>
          <textarea 
            id="notes" 
            name="notes" 
            rows="2"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          ></textarea>
        </div>
        
        <div class="space-y-2">
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Header Image (optional)</label>
          <div class="space-y-2">
            <div>
              <label for="imageFile" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">Upload Image (max 5MB)</label>
              <input 
                type="file" 
                id="imageFile" 
                name="imageFile" 
                accept="image/*"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div class="flex items-center gap-2">
              <div class="flex-1 h-px bg-gray-300 dark:bg-gray-600"></div>
              <span class="text-xs text-gray-500 dark:text-gray-400">OR</span>
              <div class="flex-1 h-px bg-gray-300 dark:bg-gray-600"></div>
            </div>
            <div>
              <label for="imageUrl" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">Image URL</label>
              <input 
                type="text" 
                id="imageUrl" 
                name="imageUrl" 
                placeholder="https://example.com/image.jpg or /uploads/image.jpg"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
          </div>
          <p class="text-xs text-gray-500 dark:text-gray-400">An image to display in the location header. If not set, a gradient based on location type will be shown.</p>
          <div id="imagePreview" class="hidden mt-2">
            <img id="imagePreviewImg" src="" alt="Preview" class="max-w-full h-32 object-cover rounded-lg">
          </div>
        </div>
        
        <div>
          <label class="flex items-center">
            <input 
              type="checkbox" 
              id="visited" 
              name="visited"
              class="w-4 h-4 text-primary-600 dark:text-primary-500 bg-gray-100 dark:bg-gray-700 border-gray-300 dark:border-gray-600 rounded focus:ring-primary-500"
            >
            <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Mark as visited</span>
          </label>
        </div>
        
        <div>
          <label class="flex items-center">
            <input 
              type="checkbox" 
              id="visibleOnMap" 
              name="visibleOnMap"
              class="w-4 h-4 text-primary-600 dark:text-primary-500 bg-gray-100 dark:bg-gray-700 border-gray-300 dark:border-gray-600 rounded focus:ring-primary-500"
            >
            <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Show pin on map</span>
          </label>
          <p class="text-xs text-gray-500 dark:text-gray-400 ml-6 mt-1">Uncheck to hide this location pin on the map (can be enabled later in edit mode)</p>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="mapX" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Map X Coordinate (optional)</label>
            <input 
              type="number" 
              id="mapX" 
              name="mapX" 
              min="0"
              max="100"
              step="0.1"
              placeholder="0-100"
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
          </div>
          <div>
            <label for="mapY" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Map Y Coordinate (optional)</label>
            <input 
              type="number" 
              id="mapY" 
              name="mapY" 
              min="0"
              max="100"
              step="0.1"
              placeholder="0-100"
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
          </div>
        </div>
        
        <div class="flex gap-4 pt-4">
          <button 
            type="submit" 
            class="flex-1 bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
          >
            Save Location
          </button>
          <button 
            type="button" 
            id="cancelModal"
            class="flex-1 bg-gray-300 dark:bg-gray-600 text-gray-700 dark:text-gray-200 px-6 py-2 rounded-lg hover:bg-gray-400 dark:hover:bg-gray-700 transition"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  // Shared state for editing location ID
  let editingId: string | null = null;

  // Helper function to show image preview (accessible from event delegation)
  function showImagePreview(imageUrl: string, clearFileInput: boolean = false) {
    const imagePreview = document.getElementById('imagePreview');
    const imagePreviewImg = document.getElementById('imagePreviewImg') as HTMLImageElement;
    const imageFileInput = document.getElementById('imageFile') as HTMLInputElement;
    
    if (imageUrl && imagePreview && imagePreviewImg) {
      imagePreviewImg.src = imageUrl;
      imagePreview.classList.remove('hidden');
      if (clearFileInput && imageFileInput) {
        imageFileInput.value = '';
      }
    } else if (imagePreview) {
      imagePreview.classList.add('hidden');
    }
  }

  // Initialize location modal and form functionality
  function initializeLocationModal() {
    const modal = document.getElementById('locationModal');
    const form = document.getElementById('locationForm') as HTMLFormElement;
    const modalTitle = document.getElementById('modalTitle');
    const addButton = document.getElementById('addLocation');
    const cancelButton = document.getElementById('cancelModal');

  // Image preview handlers
    const imageFileInput = document.getElementById('imageFile') as HTMLInputElement;
    const imageUrlInput = document.getElementById('imageUrl') as HTMLInputElement;
    const imagePreview = document.getElementById('imagePreview');
    const imagePreviewImg = document.getElementById('imagePreviewImg') as HTMLImageElement;

    imageFileInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file && imagePreview && imagePreviewImg) {
        const reader = new FileReader();
        reader.onload = (e) => {
          imagePreviewImg.src = e.target?.result as string;
          imagePreview.classList.remove('hidden');
        };
        reader.readAsDataURL(file);
        // Clear URL input when file is selected
        if (imageUrlInput) imageUrlInput.value = '';
      }
    });

    imageUrlInput?.addEventListener('input', (e) => {
      const url = (e.target as HTMLInputElement).value;
      if (url && imagePreview && imagePreviewImg) {
        imagePreviewImg.src = url;
        imagePreview.classList.remove('hidden');
        // Clear file input when URL is entered
        if (imageFileInput) imageFileInput.value = '';
      } else if (imagePreview) {
        imagePreview.classList.add('hidden');
      }
    });

  // Open modal for new location
  addButton?.addEventListener('click', () => {
    editingId = null;
    form.reset();
    if (modalTitle) modalTitle.textContent = 'New Location';
    if (imagePreview) imagePreview.classList.add('hidden');
    modal?.classList.remove('hidden');
  });

  // Close modal
  cancelButton?.addEventListener('click', () => {
    if (imagePreview) imagePreview.classList.add('hidden');
    modal?.classList.add('hidden');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      if (imagePreview) imagePreview.classList.add('hidden');
      modal.classList.add('hidden');
    }
  });

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const mapX = formData.get('mapX');
    const mapY = formData.get('mapY');
    
    // Handle image upload
    let imageUrl = formData.get('imageUrl') as string || undefined;
    const imageFile = formData.get('imageFile') as File;
    
    if (imageFile && imageFile.size > 0) {
      // Validate file size (5MB max)
      const maxSize = 5 * 1024 * 1024; // 5MB in bytes
      if (imageFile.size > maxSize) {
        alert('Image file is too large. Maximum size is 5MB.');
        return;
      }
      
      try {
        const uploadFormData = new FormData();
        uploadFormData.append('file', imageFile);
        
        const uploadResponse = await fetch('/api/upload', {
          method: 'POST',
          body: uploadFormData,
        });
        
        if (uploadResponse.ok) {
          const uploadData = await uploadResponse.json();
          imageUrl = uploadData.url;
        } else {
          const error = await uploadResponse.json();
          alert(`Failed to upload image: ${error.error || 'Unknown error'}`);
          return;
        }
      } catch (error) {
        console.error('Upload error:', error);
        alert('Failed to upload image. Please try again.');
        return;
      }
    }
    
    const data = {
      name: formData.get('name'),
      type: formData.get('type'),
      region: formData.get('region') || undefined,
      description: formData.get('description'),
      notes: formData.get('notes') || undefined,
      imageUrl: imageUrl,
      visited: formData.get('visited') === 'on',
      visibleOnMap: formData.get('visibleOnMap') === 'on',
      mapX: mapX ? parseFloat(mapX as string) : undefined,
      mapY: mapY ? parseFloat(mapY as string) : undefined,
    };

    try {
      const url = editingId ? `/api/locations/${editingId}` : '/api/locations';
      const method = editingId ? 'PUT' : 'POST';
      
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        alert('Failed to save location. Please try again.');
      }
    } catch (error) {
      alert('An error occurred. Please try again.');
    }
  });

    // Check for edit parameter on page load and open modal if present
    const urlParams = new URLSearchParams(window.location.search);
    const editId = urlParams.get('edit');
    
    if (editId && modal && form && modalTitle) {
      (async () => {
        try {
          const response = await fetch(`/api/locations/${editId}`);
          if (!response.ok) {
            throw new Error('Location not found');
          }
          
          const location = await response.json();
          
          editingId = editId;
          (document.getElementById('name') as HTMLInputElement).value = location.name;
          (document.getElementById('type') as HTMLSelectElement).value = location.type;
          (document.getElementById('region') as HTMLInputElement).value = location.region || '';
          (document.getElementById('description') as HTMLTextAreaElement).value = location.description;
          (document.getElementById('notes') as HTMLTextAreaElement).value = location.notes || '';
          (document.getElementById('imageUrl') as HTMLInputElement).value = location.imageUrl || '';
          (document.getElementById('visited') as HTMLInputElement).checked = location.visited;
          (document.getElementById('visibleOnMap') as HTMLInputElement).checked = location.visibleOnMap !== false;
          (document.getElementById('mapX') as HTMLInputElement).value = location.mapX?.toString() || '';
          (document.getElementById('mapY') as HTMLInputElement).value = location.mapY?.toString() || '';
          
          // Show image preview if location has an image
          showImagePreview(location.imageUrl || '', true);
          
          modalTitle.textContent = 'Edit Location';
          modal.classList.remove('hidden');
          
          // Clear the URL parameter so refreshing doesn't re-open the modal
          window.history.replaceState({}, '', '/locations');
        } catch (error) {
          console.error('Failed to load location for editing:', error);
          alert('Failed to load location. Please try again.');
        }
      })();
    }
  }

  // Edit/Delete locations with event delegation
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    
    if (target.classList.contains('edit-location')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      // Get DOM elements fresh
      const modal = document.getElementById('locationModal');
      const modalTitle = document.getElementById('modalTitle');
      
      try {
        const response = await fetch(`/api/locations/${id}`);
        if (!response.ok) {
          throw new Error('Failed to fetch location');
        }
        const location = await response.json();
        
        editingId = id;
        (document.getElementById('name') as HTMLInputElement).value = location.name;
        (document.getElementById('type') as HTMLSelectElement).value = location.type;
        (document.getElementById('region') as HTMLInputElement).value = location.region || '';
        (document.getElementById('description') as HTMLTextAreaElement).value = location.description;
        (document.getElementById('notes') as HTMLTextAreaElement).value = location.notes || '';
        (document.getElementById('imageUrl') as HTMLInputElement).value = location.imageUrl || '';
        (document.getElementById('visited') as HTMLInputElement).checked = location.visited;
        (document.getElementById('visibleOnMap') as HTMLInputElement).checked = location.visibleOnMap !== false;
        (document.getElementById('mapX') as HTMLInputElement).value = location.mapX?.toString() || '';
        (document.getElementById('mapY') as HTMLInputElement).value = location.mapY?.toString() || '';
        
        // Show image preview if location has an image
        showImagePreview(location.imageUrl || '', true);
        
        if (modalTitle) modalTitle.textContent = 'Edit Location';
        modal?.classList.remove('hidden');
      } catch (error) {
        console.error('Failed to load location:', error);
        alert('Failed to load location. Please try again.');
      }
    }
    
    // Delete location
    if (target.classList.contains('delete-location')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      if (confirm('Are you sure you want to delete this location?')) {
        try {
          const response = await fetch(`/api/locations/${id}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete location. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    }
  });

  // Initialize search and filter functionality on page load
  // This ensures it works after Astro View Transitions navigation
  function initializeFilters() {
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const filterBtns = document.querySelectorAll('.filter-btn');
    const locationCards = document.querySelectorAll('.location-card');
    
    let currentFilter = 'all';
    let currentSearch = '';

    const applyFilters = () => {
      const searchTerms = currentSearch.toLowerCase().split(/\s+/).filter(term => term.length > 0);
      locationCards.forEach(card => {
        const cardType = card.getAttribute('data-type') || '';
        const cardVisited = card.getAttribute('data-visited') || '';
        const searchText = card.getAttribute('data-search') || '';
        
        let matchesFilter = false;
        if (currentFilter === 'all') {
          matchesFilter = true;
        } else if (currentFilter === 'visited') {
          matchesFilter = cardVisited === 'true';
        } else if (currentFilter === 'unvisited') {
          matchesFilter = cardVisited === 'false';
        } else {
          matchesFilter = cardType === currentFilter;
        }
        
        // Match if ANY search term is found in the text (more flexible search)
        const matchesSearch = searchTerms.length === 0 || searchTerms.some(term => searchText.includes(term));
        
        (card as HTMLElement).style.display = matchesFilter && matchesSearch ? 'block' : 'none';
      });
    };

    // Search functionality
    searchInput?.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    // Filter functionality
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentFilter = btn.getAttribute('data-filter') || 'all';
        
        // Update button styles
        filterBtns.forEach(b => {
          if (b.getAttribute('data-filter') === currentFilter) {
            b.classList.remove('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
            b.classList.add('bg-primary-600', 'text-white');
          } else {
            b.classList.remove('bg-primary-600', 'text-white');
            b.classList.add('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
          }
        });
        
        applyFilters();
      });
    });
  }

  // Run on initial page load and after View Transitions navigation
  document.addEventListener('astro:page-load', () => {
    initializeLocationModal();
    initializeFilters();
  });
</script>

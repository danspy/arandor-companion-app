---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { db, Location, NPC, DiaryEntry, LibraryEntry, Character } from 'astro:db';
import { getUserRole } from '../lib/auth';

// Map page is viewable by everyone, editable by dungeonmaster and admin
const userRole = await getUserRole(Astro.cookies);
const canEdit = userRole === 'admin' || userRole === 'dungeonmaster';

const [locations, npcs, diaryEntries, libraryEntries, characters] = await Promise.all([
  db.select().from(Location),
  db.select().from(NPC),
  db.select().from(DiaryEntry),
  db.select().from(LibraryEntry),
  db.select().from(Character),
]);

const asList = (v: unknown): string[] => (Array.isArray(v) ? v.map(String) : []);

/** Short, plain-text excerpt for the speech bubble: the DM summary, else the first sentences of the entry. */
function excerptFor(entry: { summary: string | null; content: string }): string {
  const source = (entry.summary && entry.summary.trim()) || entry.content || '';
  const plain = source
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/^#+\s*/gm, '')
    .replace(/^\s*(?:[-*+]|\d+[.)])\s+/gm, '')
    .replace(/[*_`>~]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  if (plain.length <= 200) return plain;
  const cut = plain.slice(0, 200);
  const end = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('! '), cut.lastIndexOf('? '));
  return (end > 80 ? cut.slice(0, end + 1) : cut.replace(/\s\S*$/, '') + '…');
}

const mapData = {
  canEdit,
  locations: locations.map((l) => ({
    id: l.id, name: l.name, type: l.type, region: l.region, visited: !!l.visited,
    visibleOnMap: l.visibleOnMap === true, mapX: l.mapX, mapY: l.mapY,
    description: l.description, notes: l.notes, imageUrl: l.imageUrl,
  })),
  characters: characters.map((c) => ({
    id: c.id, name: c.name, class: c.class, race: c.race, isActive: c.isActive !== false,
    hair: c.hair, skin: c.skin, avatarUrl: c.avatarUrl,
  })),
  entries: diaryEntries.map((e) => ({
    id: e.id, session: e.session, date: e.date, title: e.title, excerpt: excerptFor(e),
    locationIds: asList(e.locationIds), characterIds: asList(e.characterIds),
  })),
  npcsByLocation: Object.fromEntries(
    locations.map((l) => [l.id, npcs.filter((n) => n.locationId === l.id).map((n) => ({ id: n.id, name: n.name, race: n.race, occupation: n.occupation, relationship: n.relationship }))]),
  ),
  entriesByLocation: Object.fromEntries(
    locations.map((l) => [l.id, diaryEntries.filter((e) => asList(e.locationIds).includes(l.id)).map((e) => ({ id: e.id, title: e.title, session: e.session }))]),
  ),
  libraryByLocation: Object.fromEntries(
    locations.map((l) => [l.id, libraryEntries.filter((e) => e.locationId === l.id).map((e) => ({ id: e.id, title: e.title, tags: asList(e.tags) }))]),
  ),
};
---

<Layout title="World Map">
  <div class="mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
      <h1 class="font-display italic font-semibold text-4xl" style="color:var(--gold);">Map of Arandor</h1>

      <div class="flex flex-wrap gap-2">
        <Button variant="primary" size="sm" id="toggleJourney" title="Journey log" class="flex items-center gap-2">
          <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          <span class="hidden sm:inline">Journey</span>
        </Button>
        <Button variant="secondary" size="sm" id="toggleHeroPath" title="Toggle travelled path" class="flex items-center gap-2">
          <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12h3l3-8 4 16 3-12 3 8h3"></path>
          </svg>
          <span class="hidden sm:inline" id="heroPathToggleText">Hide Path</span>
        </Button>
        <Button variant="secondary" size="sm" id="toggleBubbles" title="Show or hide the story bubbles" class="flex items-center gap-2">
          <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
          </svg>
          <span class="hidden sm:inline" id="bubblesToggleText">Hide Story</span>
        </Button>
        <Button variant="secondary" size="sm" id="toggleLegend" title="Toggle legend" class="flex items-center gap-2">
          <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
          <span class="hidden sm:inline" id="legendToggleText">Show Legend</span>
        </Button>
        {canEdit && (
          <Button variant="primary" size="sm" id="toggleEditMode" class="flex items-center gap-2">
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            <span class="hidden sm:inline" id="editModeText">Edit Mode</span>
          </Button>
        )}
      </div>
    </div>
  </div>

  <div id="mapPageContainer" class="t-panel overflow-hidden">
    <div id="mapColumn" class="relative" style="height: calc(100vh - 310px); min-height: 520px;">

      <!-- Viewport: canvas (terrain + trail) + world-space sprites + screen-space labels -->
      <div id="mapViewport" class="absolute inset-0 overflow-hidden select-none" style="touch-action:none; background:#2b63a8; cursor:grab;">
        <canvas id="worldCanvas" class="absolute inset-0"></canvas>
        <div id="spriteLayer" class="absolute left-0 top-0" style="transform-origin:0 0;"></div>
        <div id="labelLayer" class="absolute inset-0 pointer-events-none overflow-hidden">
          <div id="partyBubble" class="wm-bubble"></div>
        </div>
        <div id="mapLoading" class="absolute inset-0 flex items-center justify-center" style="background:#2b63a8;">
          <div class="wm-pixel text-sm" style="color:#eaf4ff;">Drawing the world…</div>
        </div>
      </div>

      <!-- Zoom controls -->
      <div class="absolute top-4 left-4 z-20 flex gap-2">
        <button id="zoomIn" title="Zoom in" class="map-ctrl-btn">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        </button>
        <button id="zoomOut" title="Zoom out" class="map-ctrl-btn">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path></svg>
        </button>
        <button id="zoomFit" title="Show whole world" class="map-ctrl-btn">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"></path></svg>
        </button>
        <button id="zoomParty" title="Find the party" class="map-ctrl-btn">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
        </button>
      </div>

      <!-- Legend -->
      <div id="mapLegend" class="absolute left-4 z-20 max-w-[calc(100%-2rem)] rounded-sm p-3 transition-opacity duration-300 opacity-0 pointer-events-none" style="bottom: 84px; background:rgba(12,9,6,0.92); border:1px solid var(--border-gold); box-shadow:0 4px 16px rgba(0,0,0,0.5);">
        <div class="flex flex-wrap gap-x-4 gap-y-2 text-xs" style="color:#d0c4aa;">
          <div class="flex items-center gap-2"><canvas data-legend="city" width="16" height="16"></canvas><span>City</span></div>
          <div class="flex items-center gap-2"><canvas data-legend="building" width="16" height="16"></canvas><span>Building</span></div>
          <div class="flex items-center gap-2"><canvas data-legend="dungeon" width="16" height="16"></canvas><span>Dungeon</span></div>
          <div class="flex items-center gap-2"><canvas data-legend="wilderness" width="16" height="16"></canvas><span>Wilderness</span></div>
          <div class="flex items-center gap-2"><canvas data-legend="other" width="16" height="16"></canvas><span>Other</span></div>
          <div class="flex items-center gap-2"><span class="inline-block w-3 h-3" style="background:#f0a04a;"></span><span>Travelled path</span></div>
          <div class="flex items-center gap-2"><span class="inline-block w-3 h-3" style="background:#eaf4ff;"></span><span>By sea</span></div>
          <div class="flex items-center gap-2"><span class="inline-block w-3 h-3 opacity-50" style="background:#f0a04a;"></span><span>Ahead</span></div>
        </div>
      </div>

      <!-- Timeline bar -->
      <div id="timelineBar" class="absolute left-0 right-0 bottom-0 z-20 px-3 py-2 flex items-center gap-2" style="background:rgba(12,9,6,0.92); border-top:1px solid var(--border-gold);">
        <button id="tlPrev" class="map-ctrl-btn" title="Previous stop">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"></path></svg>
        </button>
        <button id="tlPlay" class="map-ctrl-btn map-ctrl-btn-accent" title="Play the journey">
          <svg id="tlPlayIcon" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg>
          <svg id="tlPauseIcon" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 5h4v14H6zM14 5h4v14h-4z"></path></svg>
        </button>
        <button id="tlNext" class="map-ctrl-btn" title="Next stop">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"></path></svg>
        </button>
        <div class="flex-1 min-w-0 flex flex-col gap-1">
          <input id="tlRange" type="range" min="0" max="0" value="0" class="wm-range w-full" aria-label="Journey position" />
          <div id="tlLabel" class="wm-pixel text-[11px] truncate" style="color:#d0c4aa;">No journey yet — link diary entries to located places.</div>
        </div>
        <button id="tlSpeed" class="map-ctrl-btn wm-pixel text-[10px] px-2" title="Playback speed" style="width:auto;">1×</button>
      </div>

      <!-- Sidebar: location details / journey log -->
      <div id="locationDetails" class="absolute top-0 right-0 bottom-0 w-full sm:w-96 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out z-40 overflow-y-auto" style="background:var(--bg-surface);">
        <div class="sticky top-0 p-4 flex items-center justify-between z-10" style="background:var(--bg-surface);border-bottom:1px solid var(--border);">
          <h2 id="sidebarTitle" class="font-display italic font-semibold text-xl" style="color:var(--gold);">Journey</h2>
          <Button variant="icon" size="md" icon="close" iconPosition="only" id="closeSidebar" title="Close sidebar" ariaLabel="Close sidebar" />
        </div>

        <div id="journeyView" class="p-4">
          <p class="t-muted text-sm mb-4">Every stop of the party, in session order. Click a stop to travel there.</p>
          <ol id="journeyList" class="space-y-1"></ol>
        </div>

        <div id="detailsView" class="p-4 hidden">
          <div id="detailsContent"></div>
          {canEdit && (
            <div id="coordinateEditor" class="hidden mt-6 pt-6" style="border-top:1px solid var(--border);">
              <h3 class="t-body-text text-lg font-semibold mb-2">Map Coordinates</h3>
              <p class="t-muted text-xs mb-4">Drag the marker on the map or type values (0–100).</p>
              <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                  <label class="t-label block mb-1">X Position (%)</label>
                  <input type="number" id="coordX" min="0" max="100" step="0.1" class="t-input w-full px-4 py-2" />
                </div>
                <div>
                  <label class="t-label block mb-1">Y Position (%)</label>
                  <input type="number" id="coordY" min="0" max="100" step="0.1" class="t-input w-full px-4 py-2" />
                </div>
              </div>
              <Button variant="primary" size="md" id="saveCoordinates" class="w-full">Save Coordinates</Button>
            </div>
          )}
        </div>
      </div>
    </div>

    <div id="sidebarBackdrop" class="hidden sm:hidden fixed inset-0 bg-black/50 z-30" style="display: none;"></div>
  </div>

  <script type="application/json" id="mapData" set:html={JSON.stringify(mapData).replace(/</g, '\\u003c')}></script>
</Layout>

<script>
  import { initWorldMap, type MapLocation, type Step, type WorldMapApi } from '../lib/worldmap/engine';
  import { LOCATION_SPRITES, rasterize } from '../lib/worldmap/sprites';
  import { renderMarkdown } from '../utils/markdown';

  const esc = (s: string) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const cap = (s: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : '');
  const typeBadge = (type: string) => ({ city: 'bg-blue-500 text-white', dungeon: 'bg-purple-600 text-white', wilderness: 'bg-green-600 text-white', building: 'bg-amber-500 text-white' }[type] || 'bg-gray-500 text-white');

  function initializeMap() {
    const viewport = document.getElementById('mapViewport');
    const dataEl = document.getElementById('mapData');
    if (!viewport || !dataEl || viewport.dataset.ready) return;
    viewport.dataset.ready = '1';
    const data = JSON.parse(dataEl.textContent || '{}');

    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
    const sidebar = $('locationDetails')!, backdrop = $('sidebarBackdrop')!, sidebarTitle = $('sidebarTitle')!;
    const journeyView = $('journeyView')!, detailsView = $('detailsView')!, journeyList = $('journeyList')!;
    const detailsContent = $('detailsContent')!, coordinateEditor = $('coordinateEditor');
    const coordX = $<HTMLInputElement>('coordX'), coordY = $<HTMLInputElement>('coordY');
    const tlRange = $<HTMLInputElement>('tlRange')!, tlLabel = $('tlLabel')!;
    const tlPlayIcon = $('tlPlayIcon')!, tlPauseIcon = $('tlPauseIcon')!;
    let sidebarOpen = false, selected: MapLocation | null = null, editMode = false;

    /* ── sidebar ────────────────────────────────────────────────── */
    function openSidebar(view: 'journey' | 'details') {
      journeyView.classList.toggle('hidden', view !== 'journey');
      detailsView.classList.toggle('hidden', view !== 'details');
      sidebarTitle.innerHTML = view === 'journey' ? 'Journey' : (selected ? `<a href="/locations/${esc(selected.id)}" class="hover:underline">${esc(selected.name)}</a>` : 'Location');
      if (!sidebarOpen) {
        sidebarOpen = true;
        sidebar.classList.remove('translate-x-full');
        if (window.innerWidth < 640) { backdrop.style.display = 'block'; setTimeout(() => backdrop.classList.remove('hidden'), 10); }
      }
    }
    function closeSidebar() {
      sidebarOpen = false;
      sidebar.classList.add('translate-x-full');
      backdrop.classList.add('hidden'); setTimeout(() => (backdrop.style.display = 'none'), 300);
    }
    $('closeSidebar')?.addEventListener('click', closeSidebar);
    backdrop.addEventListener('click', closeSidebar);
    $('toggleJourney')?.addEventListener('click', () => (sidebarOpen && !journeyView.classList.contains('hidden')) ? closeSidebar() : openSidebar('journey'));

    function renderDetails(loc: MapLocation) {
      const npcs = data.npcsByLocation[loc.id] || [], entries = data.entriesByLocation[loc.id] || [], lib = data.libraryByLocation[loc.id] || [];
      let html = `<div class="space-y-4">
        ${loc.imageUrl ? `<div class="relative -mx-4 -mt-4 mb-4 h-48 overflow-hidden"><img src="${esc(loc.imageUrl)}" alt="${esc(loc.name)}" class="w-full h-full object-cover" /><div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div></div>` : ''}
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-block px-3 py-1 rounded-full text-sm font-semibold shadow-sm ${typeBadge(loc.type)}">${esc(cap(loc.type))}</span>
          ${loc.region ? `<span class="t-muted text-sm">📍 ${esc(loc.region)}</span>` : ''}
          ${loc.visited ? `<span class="t-badge t-badge-green">✓ Visited</span>` : ''}
        </div>
        <div class="t-prose max-w-none">${renderMarkdown(loc.description || '')}</div>
        ${loc.notes ? `<div class="t-callout p-3"><p class="t-body-text text-sm"><strong>Notes:</strong> ${esc(loc.notes)}</p></div>` : ''}`;
      if (npcs.length) html += `<div class="pt-4" style="border-top:1px solid var(--border);"><h3 class="t-body-text font-semibold mb-2">NPCs at this location</h3><div class="space-y-2">${npcs.map((n: any) => `
        <a href="/npcs/${esc(n.id)}" class="t-row p-3 block"><div class="flex justify-between items-start"><div><div class="t-link font-medium">${esc(n.name)}</div><div class="t-muted text-sm">${esc(n.race)}${n.occupation ? ` • ${esc(n.occupation)}` : ''}</div></div>
        <span class="${n.relationship === 'ally' ? 't-badge t-badge-green' : n.relationship === 'enemy' ? 't-badge t-badge-red' : 't-badge'}">${esc(n.relationship)}</span></div></a>`).join('')}</div></div>`;
      if (entries.length) html += `<div class="pt-4" style="border-top:1px solid var(--border);"><h3 class="t-body-text font-semibold mb-2">Diary entries</h3><div class="space-y-2">${entries.map((e: any) => `
        <a href="/diary/${esc(e.id)}" class="t-row p-3 block"><div class="t-link font-medium">${esc(e.title)}</div><div class="t-muted text-sm">Session ${esc(String(e.session))}</div></a>`).join('')}</div></div>`;
      if (lib.length) html += `<div class="pt-4" style="border-top:1px solid var(--border);"><h3 class="t-body-text font-semibold mb-2">Library entries</h3><div class="space-y-2">${lib.map((e: any) => `
        <a href="/library/${esc(e.id)}" class="t-row p-3 block"><div class="t-link font-medium">${esc(e.title)}</div><div class="t-muted text-sm">${e.tags.length ? e.tags.slice(0, 3).map((t: string) => `#${esc(t)}`).join(' ') : 'No tags'}</div></a>`).join('')}</div></div>`;
      html += '</div>';
      detailsContent.innerHTML = html;
      if (coordinateEditor) {
        coordinateEditor.classList.toggle('hidden', !editMode);
        if (coordX && coordY) { coordX.value = String(loc.mapX ?? 50); coordY.value = String(loc.mapY ?? 50); }
      }
    }

    function renderJourney(current: Step | null, steps: Step[]) {
      if (!steps.length) { journeyList.innerHTML = '<li class="t-faint text-sm">No stops yet. Diary entries linked to locations that are visible on the map become the party\'s journey.</li>'; return; }
      let lastSession = -1;
      journeyList.innerHTML = steps.map((s) => {
        const head = s.entry.session !== lastSession ? `<li class="wm-pixel text-[10px] pt-3 pb-1" style="color:var(--gold);">SESSION ${s.entry.session}<span class="t-faint font-sans text-xs ml-2">${esc(s.entry.date)}</span></li>` : '';
        lastSession = s.entry.session;
        const active = current && current.index === s.index;
        return `${head}<li><button data-step="${s.index}" class="t-row w-full text-left p-3 block ${active ? 'wm-step-active' : ''}">
          <div class="flex items-center gap-2"><span class="wm-step-dot"></span><div class="min-w-0"><div class="t-link font-medium truncate">${esc(s.location.name)}</div><div class="t-muted text-xs truncate">${esc(s.entry.title)}</div></div></div>
          ${s.newMembers.length ? `<div class="text-xs mt-1" style="color:var(--gold);">✦ ${esc(s.newMembers.map((id) => data.characters.find((c: any) => c.id === id)?.name).filter(Boolean).join(', '))} joined</div>` : ''}
        </button></li>`;
      }).join('');
      journeyList.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => {
        api.pause(); api.goToStep(Number(b.dataset.step), true);
        if (window.innerWidth < 640) closeSidebar();
      }));
      const activeEl = journeyList.querySelector('.wm-step-active');
      if (activeEl && sidebarOpen) activeEl.scrollIntoView({ block: 'nearest' });
    }

    /* ── engine ─────────────────────────────────────────────────── */
    const api: WorldMapApi = initWorldMap(viewport, data, {
      onSelectLocation(loc) { selected = loc; renderDetails(loc); openSidebar('details'); },
      onStepChange(step, steps) {
        tlRange.max = String(Math.max(0, steps.length - 1));
        tlRange.value = String(step ? step.index : 0);
        tlLabel.textContent = step ? `Session ${step.entry.session} · ${step.location.name} — ${step.entry.title}` : 'No journey yet — link diary entries to located places.';
        renderJourney(step, steps);
      },
      async onLocationMoved(loc) {
        try {
          const res = await fetch(`/api/locations/${loc.id}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mapX: loc.mapX, mapY: loc.mapY }) });
          if (!res.ok) alert('Failed to save coordinates. Please try again.');
          return res.ok;
        } catch { alert('An error occurred while saving coordinates.'); return false; }
      },
      onReady() { $('mapLoading')?.remove(); },
    });

    viewport.addEventListener('wm:coords', (ev: Event) => {
      const loc = (ev as CustomEvent<MapLocation>).detail;
      if (selected && selected.id === loc.id && coordX && coordY) { coordX.value = String(loc.mapX); coordY.value = String(loc.mapY); }
    });
    viewport.addEventListener('wm:playing', (ev: Event) => {
      const on = (ev as CustomEvent<boolean>).detail;
      tlPlayIcon.classList.toggle('hidden', on); tlPauseIcon.classList.toggle('hidden', !on);
    });

    /* ── controls ───────────────────────────────────────────────── */
    $('zoomIn')?.addEventListener('click', () => api.zoomIn());
    $('zoomOut')?.addEventListener('click', () => api.zoomOut());
    $('zoomFit')?.addEventListener('click', () => api.fitWorld());
    $('zoomParty')?.addEventListener('click', () => api.centerOnParty());
    $('tlPrev')?.addEventListener('click', () => { api.pause(); api.prev(); });
    $('tlNext')?.addEventListener('click', () => { api.pause(); api.next(); });
    $('tlPlay')?.addEventListener('click', () => api.togglePlay());
    tlRange.addEventListener('input', () => { api.pause(); api.goToStep(Number(tlRange.value), false); });
    const speeds = [1, 2, 4];
    $('tlSpeed')?.addEventListener('click', (ev) => {
      const next = speeds[(speeds.indexOf(api.speed) + 1) % speeds.length];
      api.setSpeed(next); (ev.currentTarget as HTMLElement).textContent = `${next}×`;
    });
    document.addEventListener('keydown', (ev) => {
      if ((ev.target as HTMLElement)?.matches('input, textarea, select')) return;
      if (ev.key === ' ') { ev.preventDefault(); api.togglePlay(); }
      else if (ev.key === 'ArrowRight') { api.pause(); api.next(); }
      else if (ev.key === 'ArrowLeft') { api.pause(); api.prev(); }
      else if (ev.key === 'b' || ev.key === 'B') { api.setBubbles(!api.bubblesEnabled); if (bubblesText) bubblesText.textContent = api.bubblesEnabled ? 'Hide Story' : 'Show Story'; }
    }, { signal: pageSignal() });

    const bubblesText = $('bubblesToggleText');
    $('toggleBubbles')?.addEventListener('click', () => {
      api.setBubbles(!api.bubblesEnabled);
      if (bubblesText) bubblesText.textContent = api.bubblesEnabled ? 'Hide Story' : 'Show Story';
    });
    const heroPathText = $('heroPathToggleText');
    $('toggleHeroPath')?.addEventListener('click', () => {
      api.setTrail(!api.trailVisible);
      if (heroPathText) heroPathText.textContent = api.trailVisible ? 'Hide Path' : 'Show Path';
    });

    const legend = $('mapLegend')!, legendText = $('legendToggleText');
    legend.querySelectorAll<HTMLCanvasElement>('canvas[data-legend]').forEach((c) => {
      c.getContext('2d')!.drawImage(rasterize(LOCATION_SPRITES[c.dataset.legend!]), 0, 0);
    });
    let legendVisible = false;
    $('toggleLegend')?.addEventListener('click', () => {
      legendVisible = !legendVisible;
      legend.style.opacity = legendVisible ? '1' : '0';
      legend.style.pointerEvents = legendVisible ? 'auto' : 'none';
      if (legendText) legendText.textContent = legendVisible ? 'Hide Legend' : 'Show Legend';
    });

    const editText = $('editModeText');
    $('toggleEditMode')?.addEventListener('click', () => {
      editMode = !editMode;
      api.setEditMode(editMode);
      if (editText) editText.textContent = editMode ? 'Done Editing' : 'Edit Mode';
      coordinateEditor?.classList.toggle('hidden', !editMode || !selected);
    });
    $('saveCoordinates')?.addEventListener('click', async () => {
      if (!selected || !coordX || !coordY) return;
      const x = parseFloat(coordX.value), y = parseFloat(coordY.value);
      if (isNaN(x) || isNaN(y) || x < 0 || x > 100 || y < 0 || y > 100) { alert('Please enter valid coordinates between 0 and 100.'); return; }
      selected.mapX = Math.round(x * 10) / 10; selected.mapY = Math.round(y * 10) / 10;
      const res = await fetch(`/api/locations/${selected.id}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mapX: selected.mapX, mapY: selected.mapY }) });
      if (!res.ok) { alert('Failed to save coordinates. Please try again.'); return; }
      api.locationsChanged();
      api.centerOnLocation(selected);
    });
  }

  // document-level listeners are removed when navigating away (view transitions)
  function pageSignal() {
    const ac = new AbortController();
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
    return ac.signal;
  }

  document.addEventListener('astro:page-load', initializeMap);
</script>


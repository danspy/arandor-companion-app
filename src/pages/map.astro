---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { db, Location, NPC, DiaryEntry, LibraryEntry } from 'astro:db';
import { getUserRole } from '../lib/auth';

// Map page is viewable by everyone, editable by dungeonmaster and admin
const userRole = await getUserRole(Astro.cookies);

const locations = await db.select().from(Location);
const npcs = await db.select().from(NPC);
const diaryEntries = await db.select().from(DiaryEntry);
const libraryEntries = await db.select().from(LibraryEntry);
const isLoggedIn = !!userRole;
const canEdit = userRole === 'admin' || userRole === 'dungeonmaster';

// Hard-coded, non-editable landmarks you can configure in code
/*const configuredLandmarks = [
  { id: 'lm-capital', name: 'Arandor City', type: 'city', mapX: 30, mapY: 50, notes: 'Capital of the realm' },
  { id: 'lm-fort', name: 'Greyfort', type: 'building', mapX: 55, mapY: 45, notes: 'Old fort' },
  { id: 'lm-ancient', name: 'Stone Circle', type: 'wilderness', mapX: 70, mapY: 40, notes: 'Druidic site' }
];*/
const configuredLandmarks = [];

// Create a map of location IDs to NPCs
const locationNPCs = new Map<string, typeof npcs>();
npcs.forEach(npc => {
  if (npc.locationId) {
    if (!locationNPCs.has(npc.locationId)) {
      locationNPCs.set(npc.locationId, []);
    }
    locationNPCs.get(npc.locationId)!.push(npc);
  }
});

// Create a map of location IDs to diary entries
const locationDiaryEntries = new Map<string, typeof diaryEntries>();
diaryEntries.forEach(entry => {
  const locationIds = Array.isArray(entry.locationIds) ? entry.locationIds : [];
  locationIds.forEach((locId: string) => {
    if (!locationDiaryEntries.has(locId)) {
      locationDiaryEntries.set(locId, []);
    }
    locationDiaryEntries.get(locId)!.push(entry);
  });
});

// Create a map of location IDs to library entries
const locationLibraryEntries = new Map<string, typeof libraryEntries>();
libraryEntries.forEach(entry => {
  if (entry.locationId) {
    if (!locationLibraryEntries.has(entry.locationId)) {
      locationLibraryEntries.set(entry.locationId, []);
    }
    locationLibraryEntries.get(entry.locationId)!.push(entry);
  }
});
---

<Layout title="Interactive Map">
  <!-- Map Container with natural grid flow -->
  <div id="mapPageContainer" class="bg-gradient-to-br from-amber-50 to-green-50 dark:from-gray-900 dark:to-gray-800 rounded-lg shadow-lg overflow-hidden">
    
    <!-- Map Controls Header -->
    <div class="bg-white/95 dark:bg-black/95 backdrop-blur-sm border-b border-gray-200 dark:border-gray-900 shadow-md px-4 py-3">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-4">
          <h1 class="text-xl sm:text-2xl font-bold text-primary-700 dark:text-primary-400">Map of Arandor</h1>
        </div>
        
        <div class="flex flex-wrap gap-2">
          <Button 
            variant="primary"
            size="sm"
            id="toggleSidebar"
            title="Toggle location details sidebar"
          >
            <span id="sidebarToggleText">Show Details</span>
          </Button>
          <Button
            variant="secondary"
            size="sm"
            id="toggleHeroPath"
            title="Toggle hero path"
          >
            <span id="heroPathToggleText">Show Path</span>
          </Button>
          <Button
            variant="ghost"
            size="sm"
            id="toggleLegend"
            title="Toggle legend"
          >
            <span id="legendToggleText">Hide Legend</span>
          </Button>
          {canEdit && (
            <Button 
              variant="primary"
              size="sm"
              id="toggleEditMode"
            >
              <span id="editModeText">Edit Mode</span>
            </Button>
          )}
        </div>
      </div>
    </div>

    <!-- Map Viewport with max-height: navbar (72px) + header (80px) + padding/footer (68px) = 220px -->
    <div id="mapColumn" class="relative bg-white dark:bg-black" style="height: calc(100vh - 220px); min-height: 500px;">
      <!-- Zoom controls - positioned in top-left to avoid PWA menu -->
      <div class="absolute top-4 left-4 z-20 flex gap-2">
        <Button
          variant="ghost"
          size="sm"
          id="zoomIn"
          title="Zoom In"
          class="bg-white/90 dark:bg-black/90 backdrop-blur-sm shadow-lg"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"></path>
          </svg>
        </Button>
        <Button
          variant="ghost"
          size="sm"
          id="zoomOut"
          title="Zoom Out"
          class="bg-white/90 dark:bg-black/90 backdrop-blur-sm shadow-lg"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7"></path>
          </svg>
        </Button>
        <Button
          variant="ghost"
          size="sm"
          id="resetZoom"
          title="Reset View"
          class="bg-white/90 dark:bg-black/90 backdrop-blur-sm shadow-lg"
        >
          Reset
        </Button>
      </div>

      <!-- Map container with panning and zooming -->
      <div class="relative bg-[rgb(208,208,208)] overflow-hidden w-full h-full" id="mapViewport" style="touch-action: none;">
        <!-- Draggable map container -->
        <div id="mapWrapper" class="absolute inset-0" style="cursor: grab;">
          <div id="mapContainer" class="absolute w-full h-full">
            <!-- SVG-based map: image + pins + path all live in a single SVG coordinate space (0..100) -->
            <svg id="mapSvg" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 w-full h-full">
              <g id="mapGroup">
                <!-- raster map image as SVG image so pins and path share the same coordinate system -->
                <image id="mapImage" class="grayscale" href="/map.png" x="0" y="0" width="100" height="100" preserveAspectRatio="xMidYMid meet"></image>

                <!-- path layer -->
                <g id="pathGroup" pointer-events="none">
                  <polyline id="heroPath" fill="none" stroke="rgba(250,100,0,0.95)" stroke-width="0.2" stroke-linecap="round" stroke-linejoin="round" opacity="0.95"></polyline>
                </g>

                <!-- landmarks (non-editable) -->
                <g id="landmarksGroup"></g>

                <!-- pins (locations) -->
                <g id="pinsGroup"></g>
              </g>
            </svg>
          </div>
        </div>
      </div>

      <!-- Legend - positioned in bottom-left, toggleable -->
      <div id="mapLegend" class="absolute bottom-6 left-4 z-20 bg-white/90 dark:bg-black/90 backdrop-blur-sm rounded-lg shadow-lg p-3 transition-opacity duration-300">
        <div class="flex flex-wrap gap-3 text-xs sm:text-sm text-gray-700 dark:text-gray-200">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 bg-blue-500 rounded-full"></div>
            <span>City</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 bg-purple-600 rounded-full"></div>
            <span>Dungeon</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 bg-green-500 rounded-full"></div>
            <span>Wilderness</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 bg-amber-500 rounded-full"></div>
            <span>Building</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 bg-gray-500 rounded-full"></div>
            <span>Other</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Slide-in Sidebar for Location Details -->
    <div id="locationDetails" class="fixed top-0 right-0 bottom-0 w-full sm:w-96 bg-white dark:bg-black shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out z-50 overflow-y-auto">
      <!-- Sidebar Header -->
      <div class="sticky top-0 bg-white dark:bg-black border-b border-gray-200 dark:border-gray-900 p-4 flex items-center justify-between z-10">
        <h2 id="detailsLocationName" class="text-xl font-bold text-primary-700 dark:text-primary-400">Location Details</h2>
        <Button
          variant="icon"
          size="md"
          icon="close"
          iconPosition="only"
          id="closeSidebar"
          title="Close sidebar"
          ariaLabel="Close sidebar"
        />
      </div>
      </div>

      <!-- Sidebar Content -->
      <div class="p-4">
        <div id="locationDetailsPlaceholder" class="text-center text-gray-400 dark:text-gray-500 py-12">
          <svg class="w-16 h-16 mx-auto mb-4 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <p class="text-sm">Click on a location pin to view details</p>
        </div>
        <div id="locationDetailsContent" class="hidden">
          <div id="detailsContent"></div>
          
          {canEdit && (
            <div id="coordinateEditor" class="hidden mt-6 pt-6 border-t border-gray-200 dark:border-gray-900">
              <h3 class="text-lg font-semibold mb-4 dark:text-gray-200">Map Coordinates</h3>
              <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">X Position (%)</label>
                  <input 
                    type="number" 
                    id="coordX" 
                    min="0" 
                    max="100" 
                    step="0.1"
                    class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Y Position (%)</label>
                  <input 
                    type="number" 
                    id="coordY" 
                    min="0" 
                    max="100" 
                    step="0.1"
                    class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                  />
                </div>
              </div>
              <Button
                variant="primary"
                size="md"
                id="saveCoordinates"
                class="w-full"
              >
                Save Coordinates
              </Button>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Mobile Overlay Backdrop -->
    <div id="sidebarBackdrop" class="hidden sm:hidden fixed inset-0 bg-black/50 z-40" style="display: none;"></div>
  </div>

  <!-- Upload modal removed — using built-in, non-user-uploadable map image -->
</Layout>

<script>
  // Import markdown renderer for client-side use
  import { renderMarkdown } from '../utils/markdown';
  // Make it globally available for the inline script
  window.renderMarkdown = renderMarkdown;
</script>

<script define:vars={{ locations, diaryEntries, configuredLandmarks, locationNPCs: Object.fromEntries(locationNPCs), locationDiaryEntries: Object.fromEntries(locationDiaryEntries), locationLibraryEntries: Object.fromEntries(locationLibraryEntries), isLoggedIn: isLoggedIn, canEdit: canEdit }}>
  let editMode = false;
  let selectedLocationId = null;
  let draggedPin = null;
  let currentMapImage = null;
  let isSidebarOpen = false;
  
  // Constants for pin opacity (strings because SVG setAttribute expects strings)
  const VISITED_OPACITY = '1.0';
  const UNVISITED_OPACITY = '0.5';
  
  // Debounce time to prevent click event immediately after drag
  const DRAG_CLICK_DEBOUNCE_MS = 100;
  
  // Zoom and pan state with default scale
  let scale = 1; // Start at 50% zoom to show more of the map
  let translateX = 0;
  let translateY = 0;
  let isPanning = false;
  let startPanX = 0;
  let startPanY = 0;

  // Touch state for pinch zoom
  let touchStartDistance = 0;
  let touchStartScale = 1;
  let touchStartTranslateX = 0;
  let touchStartTranslateY = 0;
  // Track last pointer position (relative to mapWrapper) so button zoom can use pointer as origin
  let lastPointerX = null;
  let lastPointerY = null;
  let isPointerOverMap = false;

  const mapWrapper = document.getElementById('mapWrapper');
  const mapContainer = document.getElementById('mapContainer');
  const mapSvg = document.getElementById('mapSvg');
  const mapGroup = document.getElementById('mapGroup');
  const pinsGroup = document.getElementById('pinsGroup');
  const pathGroup = document.getElementById('pathGroup');
  const heroPath = document.getElementById('heroPath');
  const landmarksGroup = document.getElementById('landmarksGroup');
  const locationDetails = document.getElementById('locationDetails');
  const toggleEditModeBtn = document.getElementById('toggleEditMode');
  const editModeText = document.getElementById('editModeText');
  const coordinateEditor = document.getElementById('coordinateEditor');
  const zoomInBtn = document.getElementById('zoomIn');
  const zoomOutBtn = document.getElementById('zoomOut');
  const resetZoomBtn = document.getElementById('resetZoom');
  const toggleSidebarBtn = document.getElementById('toggleSidebar');
  const closeSidebarBtn = document.getElementById('closeSidebar');
  const sidebarToggleText = document.getElementById('sidebarToggleText');
  const sidebarBackdrop = document.getElementById('sidebarBackdrop');
  const mapViewport = document.getElementById('mapViewport');
  const heroPathToggleBtn = document.getElementById('toggleHeroPath');
  const heroPathToggleText = document.getElementById('heroPathToggleText');
  const toggleLegendBtn = document.getElementById('toggleLegend');
  const legendToggleText = document.getElementById('legendToggleText');
  const mapLegend = document.getElementById('mapLegend');
  
  // Legend state
  let isLegendVisible = true;

  // Make map fluid: container fills available area and SVG uses a 0-100 viewBox
  function applyMapSize() {
    if (!mapContainer) return;
    // Use fluid sizing so the map fills the viewport wrapper
    mapContainer.style.width = '100%';
    mapContainer.style.height = '100%';
    // Make sure the SVG fills the container and uses the 0..100 coordinate system
    if (mapSvg) {
      mapSvg.style.width = '100%';
      mapSvg.style.height = '100%';
      mapSvg.setAttribute('viewBox', '0 0 100 100');
      mapSvg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
    }
  }

  // Ensure the heroPathSvg fills the map container and scales with it.
  function ensureMapSvgFillsContainer() {
    if (!mapSvg || !mapContainer) return;
    mapSvg.style.position = 'absolute';
    mapSvg.style.left = '0';
    mapSvg.style.top = '0';
    mapSvg.style.width = '100%';
    mapSvg.style.height = '100%';
    mapSvg.style.bottom = '0';
    mapSvg.style.right = '0';
    mapSvg.setAttribute('viewBox', '0 0 100 100');
    mapSvg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
  }

  // Fit map to viewport initially (no fixed pixel math) — reset transform to show full container
  function fitToViewport() {
    // With fluid sizing we start with identity scale and centered position
    scale = 1;
    translateX = 0;
    translateY = 0;
    updateTransform();
  }

  window.addEventListener('resize', () => {
    fitToViewport();
    // realign SVG overlay after resize
  try { ensureMapSvgFillsContainer(); } catch (e) {}
  });

  // Render configured, non-editable landmarks into the SVG landmarksGroup
  function renderLandmarks() {
    if (!landmarksGroup) return;
    // remove any existing landmark tooltips to avoid leaks
    document.querySelectorAll('.landmark-tooltip').forEach(t => t.remove());
    landmarksGroup.innerHTML = '';
    (configuredLandmarks || []).forEach(l => {
      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      g.setAttribute('class', 'landmark-pin');
      g.setAttribute('data-landmark-id', l.id);
      g.setAttribute('transform', `translate(${l.mapX}, ${l.mapY})`);

      // render icon: prefer inline svg markup, then image, otherwise a simple circle
      if (l.svg && typeof l.svg === 'string') {
        // insert raw SVG markup inside group (trusted config)
        const wrapper = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        wrapper.innerHTML = l.svg;
        g.appendChild(wrapper);
      } else if (l.iconUrl) {
        const img = document.createElementNS('http://www.w3.org/2000/svg', 'image');
        img.setAttribute('href', l.iconUrl);
        img.setAttribute('x', '-3');
        img.setAttribute('y', '-8');
        img.setAttribute('width', '6');
        img.setAttribute('height', '6');
        g.appendChild(img);
      } else {
        const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        circle.setAttribute('cx', '0');
        circle.setAttribute('cy', '-3');
        circle.setAttribute('r', '0.5');
        circle.setAttribute('fill', getLocationHex(l.type));
        circle.setAttribute('stroke', '#fff');
        circle.setAttribute('stroke-width', '0.2');
        g.appendChild(circle);
      }

      landmarksGroup.appendChild(g);

      // create tooltip element for this landmark (DOM) and position it over the svg group
      const tooltip = document.createElement('div');
      tooltip.className = 'landmark-tooltip fixed bg-white dark:bg-black border-2 border-gray-300 dark:border-gray-600 px-3 py-2 rounded-lg shadow-xl text-xs opacity-0 transition-opacity';
      tooltip.style.cssText = 'min-width: 100px; max-width: 220px; white-space: normal; z-index: 9999; pointer-events: none;';
      tooltip.innerHTML = `<div class="font-semibold">${l.name}</div>${l.notes ? `<div class="text-xs text-gray-600 dark:text-gray-400 mt-1">${l.notes}</div>` : ''}`;
      document.body.appendChild(tooltip);

      let hideTimeout;

      const showTooltipAt = () => {
        const rect = g.getBoundingClientRect();
        tooltip.style.left = `${rect.left + rect.width / 2}px`;
        tooltip.style.top = `${rect.top - 8}px`;
        tooltip.style.transform = 'translate(-50%, -100%)';
        tooltip.style.opacity = '1';
        tooltip.style.pointerEvents = 'auto';
      };

      g.addEventListener('mouseenter', () => {
        clearTimeout(hideTimeout);
        showTooltipAt();
      });

      g.addEventListener('mouseleave', () => {
        hideTimeout = setTimeout(() => {
          tooltip.style.opacity = '0';
          tooltip.style.pointerEvents = 'none';
        }, 100);
      });

      g.addEventListener('click', (e) => {
        e.stopPropagation();
        // toggle tooltip visibility
        const visible = tooltip.style.opacity === '1';
        document.querySelectorAll('.landmark-tooltip').forEach(t => { t.style.opacity = '0'; t.style.pointerEvents = 'none'; });
        if (!visible) showTooltipAt();
      });

      g.addEventListener('touchstart', (e) => { e.stopPropagation(); const visible = tooltip.style.opacity === '1'; document.querySelectorAll('.landmark-tooltip').forEach(t => { t.style.opacity = '0'; t.style.pointerEvents = 'none'; }); if (!visible) showTooltipAt(); }, { passive: true });
    });
    // ensure svg fills container
    try { ensureMapSvgFillsContainer(); } catch (e) {}
  }

  // Hide any open landmark tooltips when tapping/clicking outside
  document.addEventListener('click', () => {
    document.querySelectorAll('.landmark-tooltip').forEach(t => { t.style.opacity = '0'; t.style.pointerEvents = 'none'; });
  });
  document.addEventListener('touchstart', () => {
    document.querySelectorAll('.landmark-tooltip').forEach(t => { t.style.opacity = '0'; t.style.pointerEvents = 'none'; });
  }, { passive: true });

  // Build hero path from diary entries connected to locations
  function buildHeroPath() {
    if (!heroPath) return;
    // diaryEntries is passed in from the server
    const entries = (diaryEntries || []).slice();
    // Sort chronologically by session then date
    entries.sort((a, b) => {
      const sA = a.session || 0;
      const sB = b.session || 0;
      if (sA !== sB) return sA - sB;
      const dA = new Date(a.date || 0).getTime();
      const dB = new Date(b.date || 0).getTime();
      return dA - dB;
    });

    // Build ordered list of location ids from diary entries (all referenced locations)
    const sequence = [];
    entries.forEach(entry => {
      const locIds = Array.isArray(entry.locationIds) ? entry.locationIds : [];
      locIds.forEach(locId => sequence.push({ locId, entry }));
    });

    // For each referenced location, try to read the existing pin's transform (preferred),
    // otherwise fall back to location.mapX/mapY from server data.
    const points = [];
    sequence.forEach(({ locId }) => {
      const pin = document.querySelector(`[data-location-id="${locId}"]`);
      let xPct = null, yPct = null;
      if (pin) {
        // Try to read SVG transform translate(x y)
        const t = pin.getAttribute('transform') || '';
        const m = t.match(/translate\(([^)]+)\)/);
        if (m) {
          const parts = m[1].trim().split(/[ ,]+/).map(Number);
          if (parts.length >= 2 && !isNaN(parts[0]) && !isNaN(parts[1])) {
            xPct = parts[0];
            yPct = parts[1];
          }
        }
      }

      // fallback to server-side coordinates if pin not found
      if ((xPct == null || yPct == null) && locations) {
        const loc = locations.find(l => l.id === locId);
        if (loc && loc.mapX != null && loc.mapY != null) {
          xPct = Number(loc.mapX);
          yPct = Number(loc.mapY);
        }
      }

      if (xPct != null && yPct != null) {
        points.push({ x: xPct, y: yPct });
      }
    });

    // Update polyline points on existing heroPath element
    heroPath.setAttribute('points', '');
    if (points.length < 2) {
      console.warn('Hero path: not enough points to build a route (need 2+).');
      return;
    }

    // debug: print the computed points in console to help diagnose mismatches
    console.debug('Hero path points (percent):', points);

    // Draw a single simple polyline connecting the pin positions (percent coordinates within viewBox 0..100)
    heroPath.setAttribute('points', points.map(p => `${p.x},${p.y}`).join(' '));
  }

  // Toggle visibility handler
  if (heroPathToggleBtn) {
    heroPathToggleBtn.addEventListener('click', () => {
      if (!heroPath) return;
      const hidden = heroPath.style.display === 'none' || heroPath.getAttribute('data-hidden') === 'true';
      heroPath.style.display = hidden ? 'block' : 'none';
      heroPath.setAttribute('data-hidden', hidden ? 'false' : 'true');
      if (heroPathToggleText) heroPathToggleText.textContent = hidden ? 'Hide Path' : 'Show Path';
    });
  }

  // Toggle legend visibility handler
  if (toggleLegendBtn && mapLegend) {
    toggleLegendBtn.addEventListener('click', () => {
      isLegendVisible = !isLegendVisible;
      if (isLegendVisible) {
        mapLegend.style.opacity = '1';
        mapLegend.style.pointerEvents = 'auto';
        if (legendToggleText) legendToggleText.textContent = 'Hide Legend';
      } else {
        mapLegend.style.opacity = '0';
        mapLegend.style.pointerEvents = 'none';
        if (legendToggleText) legendToggleText.textContent = 'Show Legend';
      }
    });
  }

  // Get color for location type (returns full class string for tag styling)
  function getLocationColor(type) {
    switch(type) {
      case 'city': return 'bg-blue-500 text-white';
      case 'dungeon': return 'bg-purple-600 text-white';
      case 'wilderness': return 'bg-green-600 text-white';
      case 'building': return 'bg-amber-500 text-white';
      default: return 'bg-gray-500 text-white';
    }
  }
  
  // Capitalize first letter of location type for display
  function capitalizeType(type) {
    if (!type) return '';
    return type.charAt(0).toUpperCase() + type.slice(1);
  }

  // Hex color mapping for SVG pins
  function getLocationHex(type) {
    switch(type) {
      case 'city': return '#3b82f6'; // blue-500
      case 'dungeon': return '#9333ea'; // purple-600
      case 'wilderness': return '#16a34a'; // green-600
      case 'building': return '#f59e0b'; // amber-500
      default: return '#6b7280'; // gray-500
    }
  }

  // Create pin element
  function createPin(location) {
    // Create an SVG-based pin (group) so it shares the SVG coordinate system
    const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    g.setAttribute('class', 'location-pin');
    g.setAttribute('data-location-id', location.id);
    const x = location.mapX != null ? Number(location.mapX) : 50;
    const y = location.mapY != null ? Number(location.mapY) : 50;
    g.setAttribute('transform', `translate(${x}, ${y})`);

    // Set opacity based on visited status (only for visible pins)
    if (location.visited) {
      g.setAttribute('opacity', VISITED_OPACITY);
    } else {
      g.setAttribute('opacity', UNVISITED_OPACITY);
    }

    // visual: circle above a small tip so that the provided (x,y) is the bottom-center anchor
    const color = getLocationHex(location.type);
    // Classic map pin: teardrop / pin shape with white outline and small white center highlight
    const pinPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    // symmetric teardrop whose tip sits at (0,0) and bulb extends upward (negative y)
  // Plain, classic map pin made from a rounded head (circle) and a pointed bottom (triangle).
  // Tip (apex) sits at (0,0) so the given translate(x,y) anchors the pin to that point.
  const head = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
  head.setAttribute('cx', '0');
  head.setAttribute('cy', '-1.7');
  head.setAttribute('r', '1');
  head.setAttribute('fill', color);
  head.setAttribute('stroke', '#ffffff');
  head.setAttribute('stroke-width', '0.2');
  g.appendChild(head);

  // Small triangle under the circle pointing to (0,0).
  // Make the point smaller and fill it fully white so it reads as a precise anchor.
  const tri = document.createElementNS('http://www.w3.org/2000/svg', 'path');
  // narrower base and shorter height so the tip is small
  tri.setAttribute('d', 'M -0.3 -0.7 L 0.3 -0.7 L 0 0 Z');
  tri.setAttribute('fill', '#ffffff');
  tri.setAttribute('stroke', 'none');
  g.appendChild(tri);

    // Build tooltip content (DOM) as before
    const npcs = locationNPCs[location.id] || [];
    const entries = locationDiaryEntries[location.id] || [];
    const libraryItems = locationLibraryEntries[location.id] || [];
    let tooltipContent = `<div class="font-semibold mb-1"><a href="/locations/${location.id}" class="hover:underline">${location.name}</a></div>`;
    if (npcs.length > 0) {
      tooltipContent += `<div class="text-xs mt-1 border-t border-gray-200 dark:border-gray-600 pt-1"><div class="font-medium">NPCs:</div>`;
      npcs.slice(0,3).forEach(npc => { tooltipContent += `<a href="/npcs/${npc.id}" class="block hover:underline text-blue-600 dark:text-blue-400">• ${npc.name}</a>`; });
      if (npcs.length > 3) tooltipContent += `<div class="text-gray-500 dark:text-gray-400">+${npcs.length-3} more</div>`;
      tooltipContent += `</div>`;
    }
    if (entries.length > 0) {
      tooltipContent += `<div class="text-xs mt-1 border-t border-gray-200 dark:border-gray-600 pt-1"><div class="font-medium">Diary:</div>`;
      entries.slice(0,2).forEach(entry => { tooltipContent += `<a href="/diary/${entry.id}" class="block hover:underline text-amber-600 dark:text-amber-400">• ${entry.title}</a>`; });
      if (entries.length > 2) tooltipContent += `<div class="text-gray-500 dark:text-gray-400">+${entries.length-2} more</div>`;
      tooltipContent += `</div>`;
    }
    if (libraryItems.length > 0) {
      tooltipContent += `<div class="text-xs mt-1 border-t border-gray-200 dark:border-gray-600 pt-1"><div class="font-medium">Library:</div>`;
      libraryItems.slice(0,2).forEach(item => { tooltipContent += `<a href="/library/${item.id}" class="block hover:underline text-purple-600 dark:text-purple-400">• ${item.title}</a>`; });
      if (libraryItems.length > 2) tooltipContent += `<div class="text-gray-500 dark:text-gray-400">+${libraryItems.length-2} more</div>`;
      tooltipContent += `</div>`;
    }

    const tooltip = document.createElement('div');
    tooltip.className = 'pin-tooltip fixed bg-white dark:bg-black border-2 border-gray-300 dark:border-gray-600 px-3 py-2 rounded-lg shadow-xl text-xs opacity-0 transition-opacity';
    tooltip.style.cssText = 'min-width: 150px; max-width: 250px; white-space: normal; z-index: 9999; pointer-events: none;';
    tooltip.innerHTML = tooltipContent;
    document.body.appendChild(tooltip);

    let hideTooltipTimeout;

    const showTooltip = () => {
      const rect = g.getBoundingClientRect();
      tooltip.style.left = `${rect.left + rect.width/2}px`;
      tooltip.style.top = `${rect.top - 8}px`;
      tooltip.style.transform = 'translate(-50%, -100%)';
      tooltip.style.opacity = '1';
      tooltip.style.pointerEvents = 'auto';
    };

    const hideTooltip = () => {
      hideTooltipTimeout = setTimeout(() => { tooltip.style.opacity = '0'; tooltip.style.pointerEvents = 'none'; }, 100);
    };

    g.addEventListener('mouseenter', () => { clearTimeout(hideTooltipTimeout); showTooltip(); });
    g.addEventListener('mouseleave', () => { hideTooltip(); });
    tooltip.addEventListener('mouseenter', () => { clearTimeout(hideTooltipTimeout); tooltip.style.opacity = '1'; tooltip.style.pointerEvents = 'auto'; });
    tooltip.addEventListener('mouseleave', hideTooltip);

    g.addEventListener('click', (e) => {
      if (!draggedPin || !editMode) {
        document.querySelectorAll('.location-pin').forEach(p => p.classList && p.classList.remove('pin-active'));
        // mark as active visually via class on SVG group
        if (g.classList) g.classList.add('pin-active');
        showLocationDetails(location);
      }
    });

    // Drag functionality in edit mode
    // This handler is only attached to visible pins (visibleOnMap === true), 
    // but only activates when editMode is enabled
    if (canEdit) {
      g.addEventListener('mousedown', (e) => {
        if (editMode) {
          e.preventDefault();
          draggedPin = { element: g, location: location };
          // bring to front
          g.setAttribute('data-z', '1000');
        }
      });
    }

    return g;
  }

  // Render all pins
  function renderPins() {
    if (!pinsGroup) return;
    // Remove any existing pin tooltips to avoid memory leaks and duplicates
    document.querySelectorAll('.pin-tooltip').forEach(t => t.remove());
    pinsGroup.innerHTML = '';
    locations.forEach(location => {
      // Only render pins that are explicitly marked as visible on map
      // Uses strict equality (=== true) to require explicit opt-in;
      // undefined/null/false all result in pin not being rendered (secure by default)
      if (location.visibleOnMap === true) {
        const pinEl = createPin(location);
        pinsGroup.appendChild(pinEl);
      }
    });
    // ensure SVG sizing
    try { ensureMapSvgFillsContainer(); } catch (e) {}
  }

  // Show location details
  function showLocationDetails(location) {
    selectedLocationId = location.id;
    
    const detailsPanel = document.getElementById('locationDetails');
    const detailsPlaceholder = document.getElementById('locationDetailsPlaceholder');
    const detailsContent = document.getElementById('locationDetailsContent');
    const detailsLocationName = document.getElementById('detailsLocationName');
    const detailsContentDiv = document.getElementById('detailsContent');
    const coordX = document.getElementById('coordX');
    const coordY = document.getElementById('coordY');
    const coordinateEditor = document.getElementById('coordinateEditor');
    
    // Show the panel if hidden
    detailsPanel.classList.remove('hidden');
    
    // Hide placeholder, show content
    detailsPlaceholder.classList.add('hidden');
    detailsContent.classList.remove('hidden');
    
    // Set location name as clickable link
    detailsLocationName.innerHTML = `<a href="/locations/${location.id}" class="hover:underline">${location.name}</a>`;
    
    // Render description as markdown
    const renderedDescription = window.renderMarkdown ? window.renderMarkdown(location.description) : location.description;
    
    let html = `
      <div class="space-y-4">
        ${location.imageUrl ? `
          <div class="relative -mx-4 -mt-4 mb-4 h-48 overflow-hidden">
            <img 
              src="${location.imageUrl}" 
              alt="${location.name}"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
          </div>
        ` : ''}
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-block px-3 py-1 rounded-full text-sm font-semibold shadow-sm ${getLocationColor(location.type)}">
            ${capitalizeType(location.type)}
          </span>
          ${location.region ? `<span class="text-sm text-gray-600 dark:text-gray-400">📍 ${location.region}</span>` : ''}
          ${location.visited ? `<span class="text-sm text-green-600 dark:text-green-400">✓ Visited</span>` : ''}
        </div>
        <div class="prose dark:prose-invert max-w-none text-gray-700 dark:text-gray-300">${renderedDescription}</div>
        ${location.notes ? `<div class="bg-blue-50 dark:bg-blue-900 dark:bg-opacity-30 border-l-4 border-blue-500 p-3"><p class="text-sm text-blue-900 dark:text-blue-200"><strong>Notes:</strong> ${location.notes}</p></div>` : ''}
    `;

    // Add NPCs
    const npcs = locationNPCs[location.id] || [];
    if (npcs.length > 0) {
      html += `
        <div class="border-t border-gray-200 dark:border-gray-900 pt-4">
          <h3 class="font-semibold mb-2 dark:text-gray-200">NPCs at this location:</h3>
          <div class="space-y-2">
            ${npcs.map(npc => `
              <a href="/npcs/${npc.id}" class="block p-3 bg-gray-50 dark:bg-gray-700 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-600 transition">
                <div class="flex justify-between items-start">
                  <div>
                    <div class="font-medium text-primary-700 dark:text-primary-400">${npc.name}</div>
                    <div class="text-sm text-gray-600 dark:text-gray-400">${npc.race} ${npc.occupation ? `• ${npc.occupation}` : ''}</div>
                  </div>
                  <span class="px-2 py-1 rounded text-xs font-medium ${
                    npc.relationship === 'ally' ? 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300' :
                    npc.relationship === 'enemy' ? 'bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300' :
                    'bg-gray-100 text-gray-700 dark:bg-gray-600 dark:text-gray-300'
                  }">
                    ${npc.relationship}
                  </span>
                </div>
              </a>
            `).join('')}
          </div>
        </div>
      `;
    }

    // Add diary entries
    const entries = locationDiaryEntries[location.id] || [];
    if (entries.length > 0) {
      html += `
        <div class="border-t border-gray-200 dark:border-gray-900 pt-4">
          <h3 class="font-semibold mb-2 dark:text-gray-200">Diary Entries:</h3>
          <div class="space-y-2">
            ${entries.map(entry => `
              <a href="/diary/${entry.id}" class="block p-3 bg-amber-50 dark:bg-amber-900 dark:bg-opacity-30 rounded-lg hover:bg-amber-100 dark:hover:bg-amber-800 dark:hover:bg-opacity-40 transition">
                <div class="font-medium text-primary-700 dark:text-primary-400">${entry.title}</div>
                <div class="text-sm text-gray-600 dark:text-gray-400">Session ${entry.session}</div>
              </a>
            `).join('')}
          </div>
        </div>
      `;
    }

    // Add library entries
    const libraryItems = locationLibraryEntries[location.id] || [];
    if (libraryItems.length > 0) {
      html += `
        <div class="border-t border-gray-200 dark:border-gray-900 pt-4">
          <h3 class="font-semibold mb-2 dark:text-gray-200">Library Entries:</h3>
          <div class="space-y-2">
            ${libraryItems.map(item => `
              <a href="/library/${item.id}" class="block p-3 bg-purple-50 dark:bg-purple-900 dark:bg-opacity-30 rounded-lg hover:bg-purple-100 dark:hover:bg-purple-800 dark:hover:bg-opacity-40 transition">
                <div class="font-medium text-primary-700 dark:text-primary-400">${item.title}</div>
                <div class="text-sm text-gray-600 dark:text-gray-400">${item.tags && item.tags.length > 0 ? item.tags.slice(0, 3).map(tag => `#${tag}`).join(' ') : 'No tags'}</div>
              </a>
            `).join('')}
          </div>
        </div>
      `;
    }

    html += '</div>';
    detailsContentDiv.innerHTML = html;

    if (canEdit && editMode && coordinateEditor) {
      coordinateEditor.classList.remove('hidden');
      if (coordX && coordY) {
        coordX.value = location.mapX || 50;
        coordY.value = location.mapY || 50;
      }
    } else if (coordinateEditor) {
      coordinateEditor.classList.add('hidden');
    }

    // Open sidebar when location is selected
    if (!isSidebarOpen) {
      toggleSidebar();
    }
  }

  // Toggle sidebar
  function toggleSidebar() {
    isSidebarOpen = !isSidebarOpen;
    
    if (isSidebarOpen) {
      locationDetails.classList.remove('translate-x-full');
      if (sidebarToggleText) {
        sidebarToggleText.textContent = 'Hide Details';
      }
      
      // Show backdrop on mobile
      if (window.innerWidth < 640) {
        sidebarBackdrop.style.display = 'block';
        setTimeout(() => sidebarBackdrop.classList.remove('hidden'), 10);
      }
    } else {
      locationDetails.classList.add('translate-x-full');
      if (sidebarToggleText) {
        sidebarToggleText.textContent = 'Show Details';
      }
      
      // Hide backdrop on mobile
      sidebarBackdrop.classList.add('hidden');
      setTimeout(() => sidebarBackdrop.style.display = 'none', 300);
    }
  }

  toggleSidebarBtn?.addEventListener('click', toggleSidebar);
  closeSidebarBtn?.addEventListener('click', toggleSidebar);
  sidebarBackdrop?.addEventListener('click', toggleSidebar);

  // Toggle edit mode
  toggleEditModeBtn?.addEventListener('click', () => {
    editMode = !editMode;
    if (editMode) {
      editModeText.textContent = 'Disable Edit Mode';
      mapContainer.style.cursor = 'crosshair';
      if (selectedLocationId) {
        coordinateEditor?.classList.remove('hidden');
      }
    } else {
      editModeText.textContent = 'Enable Edit Mode';
      mapContainer.style.cursor = 'default';
      coordinateEditor?.classList.add('hidden');
    }
  });

  // Drag handling
  if (canEdit) {
    document.addEventListener('mousemove', (e) => {
      if (draggedPin && editMode) {
        const rect = mapSvg.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;

        // Clamp values
        const clampedX = Math.max(0, Math.min(100, x));
        const clampedY = Math.max(0, Math.min(100, y));

        // update svg group transform
        draggedPin.element.setAttribute('transform', `translate(${clampedX}, ${clampedY})`);

        // Update coordinate inputs if details panel is open
        if (selectedLocationId === draggedPin.location.id) {
          document.getElementById('coordX').value = clampedX.toFixed(1);
          document.getElementById('coordY').value = clampedY.toFixed(1);
        }
      }
    });

    document.addEventListener('mouseup', async (e) => {
      if (draggedPin && editMode) {
        const rect = mapSvg.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;

        const clampedX = Math.max(0, Math.min(100, x));
        const clampedY = Math.max(0, Math.min(100, y));

        // Save coordinates
        await saveLocationCoordinates(draggedPin.location.id, clampedX, clampedY);

        // restore z
        draggedPin.element.removeAttribute('data-z');

        // Small delay before clearing to prevent immediate click event
        setTimeout(() => {
          draggedPin = null;
        }, DRAG_CLICK_DEBOUNCE_MS);
      }
    });
  }

  // Save coordinates
  async function saveLocationCoordinates(locationId, x, y) {
    try {
      const response = await fetch(`/api/locations/${locationId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
          mapX: parseFloat(x.toFixed(1)),
          mapY: parseFloat(y.toFixed(1))
        }),
      });

      if (!response.ok) {
        alert('Failed to save coordinates. Please try again.');
      } else {
        // Update local data
        const location = locations.find(l => l.id === locationId);
        if (location) {
          location.mapX = parseFloat(x.toFixed(1));
          location.mapY = parseFloat(y.toFixed(1));
          // rebuild route after coordinates changed
          try { buildHeroPath(); } catch (e) { /* ignore */ }
        }
      }
    } catch (error) {
      alert('An error occurred while saving coordinates.');
    }
  }

  // Save coordinates from input fields
  document.getElementById('saveCoordinates')?.addEventListener('click', async () => {
    if (!selectedLocationId) return;
    
    const x = parseFloat(document.getElementById('coordX').value);
    const y = parseFloat(document.getElementById('coordY').value);
    
    if (isNaN(x) || isNaN(y) || x < 0 || x > 100 || y < 0 || y > 100) {
      alert('Please enter valid coordinates between 0 and 100.');
      return;
    }
    
    await saveLocationCoordinates(selectedLocationId, x, y);
    
    // Update pin position (SVG group transform)
    const pin = document.querySelector(`[data-location-id="${selectedLocationId}"]`);
    if (pin) {
      pin.setAttribute('transform', `translate(${x}, ${y})`);
    }
    
    // update route to reflect changed pin position
    try { buildHeroPath(); } catch (e) {}

    alert('Coordinates saved successfully!');
  });

  // Custom map upload/ localStorage removed — using built-in map image

  // Zoom and pan functionality
  let rafId = null;
  
  function updateTransform() {
    // Cancel any pending animation frame to avoid stacking updates
    if (rafId !== null) {
      cancelAnimationFrame(rafId);
    }
    
    rafId = requestAnimationFrame(() => {
      // Apply transforms to the SVG so image, pins and path scale together in the same coordinate space
      if (mapSvg) {
        mapSvg.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
        mapSvg.style.transformOrigin = '0 0';
      } else {
        mapContainer.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
      }
      rafId = null;
    });
  }
  
  // Zoom button controls
  zoomInBtn?.addEventListener('click', () => {
    const rect = mapWrapper.getBoundingClientRect();
    // If the pointer is over the map and we have a last pointer position, zoom toward that point.
    const centerX = (isPointerOverMap && lastPointerX != null) ? lastPointerX : rect.width / 2;
    const centerY = (isPointerOverMap && lastPointerY != null) ? lastPointerY : rect.height / 2;
    
    const newScale = Math.min(scale * 1.2, 3);
    const scaleChange = newScale / scale;
    translateX = centerX - (centerX - translateX) * scaleChange;
    translateY = centerY - (centerY - translateY) * scaleChange;
    
    scale = newScale;
    updateTransform();
  });
  
  zoomOutBtn?.addEventListener('click', () => {
    const rect = mapWrapper.getBoundingClientRect();
    const centerX = (isPointerOverMap && lastPointerX != null) ? lastPointerX : rect.width / 2;
    const centerY = (isPointerOverMap && lastPointerY != null) ? lastPointerY : rect.height / 2;
    
    const newScale = Math.max(scale * 0.8, 0.3);
    const scaleChange = newScale / scale;
    translateX = centerX - (centerX - translateX) * scaleChange;
    translateY = centerY - (centerY - translateY) * scaleChange;
    
    scale = newScale;
    updateTransform();
  });
  
  resetZoomBtn?.addEventListener('click', () => {
    scale = 1;
    translateX = 0;
    translateY = 0;
    updateTransform();
  });

  // Mouse wheel zoom
  mapWrapper?.addEventListener('wheel', (e) => {
    e.preventDefault();
    
    const rect = mapWrapper.getBoundingClientRect();
    const mouseX = e.clientX - rect.left;
    const mouseY = e.clientY - rect.top;
    
    // Calculate zoom
    const delta = e.deltaY > 0 ? 0.9 : 1.1;
    const newScale = Math.min(Math.max(0.3, scale * delta), 3);
    
    // Adjust translation to zoom towards mouse position
    const scaleChange = newScale / scale;
    translateX = mouseX - (mouseX - translateX) * scaleChange;
    translateY = mouseY - (mouseY - translateY) * scaleChange;
    
    scale = newScale;
    updateTransform();
  });

  // Touch support for pinch zoom and pan
  let touches = [];
  
  function getTouchDistance(touch1, touch2) {
    const dx = touch1.clientX - touch2.clientX;
    const dy = touch1.clientY - touch2.clientY;
    return Math.sqrt(dx * dx + dy * dy);
  }
  
  function getTouchCenter(touch1, touch2) {
    return {
      x: (touch1.clientX + touch2.clientX) / 2,
      y: (touch1.clientY + touch2.clientY) / 2
    };
  }

  mapWrapper?.addEventListener('touchstart', (e) => {
    touches = Array.from(e.touches);
    
    // record pointer/touch for possible button-origin zoom
    if (touches.length >= 1) {
      const rect = mapWrapper.getBoundingClientRect();
      lastPointerX = touches[0].clientX - rect.left;
      lastPointerY = touches[0].clientY - rect.top;
      isPointerOverMap = true;
    }

    if (touches.length === 2) {
      // Start pinch zoom - prevent default to stop browser zoom
      e.preventDefault();
      // Disable transition during interaction for smooth performance
      if (mapSvg) mapSvg.style.transition = 'none';
      mapWrapper.classList.add('interacting');
      touchStartDistance = getTouchDistance(touches[0], touches[1]);
      touchStartScale = scale;
      
      const rect = mapWrapper.getBoundingClientRect();
      const center = getTouchCenter(touches[0], touches[1]);
      const centerX = center.x - rect.left;
      const centerY = center.y - rect.top;
      
      touchStartTranslateX = translateX;
      touchStartTranslateY = translateY;
    } else if (touches.length === 1) {
      // Start pan - set up state but allow tap/click to work naturally
      // Disable transition during interaction for smooth performance
      if (mapSvg) mapSvg.style.transition = 'none';
      mapWrapper.classList.add('interacting');
      isPanning = true;
      startPanX = touches[0].clientX - translateX;
      startPanY = touches[0].clientY - translateY;
    }
  }, { passive: false });

  mapWrapper?.addEventListener('touchmove', (e) => {
    touches = Array.from(e.touches);
    
    if (touches.length === 2) {
      // Pinch zoom - prevent browser zoom
      e.preventDefault();
      const currentDistance = getTouchDistance(touches[0], touches[1]);
      const distanceRatio = currentDistance / touchStartDistance;
      
      const newScale = Math.min(Math.max(0.3, touchStartScale * distanceRatio), 3);
      
      const rect = mapWrapper.getBoundingClientRect();
      const center = getTouchCenter(touches[0], touches[1]);
      const centerX = center.x - rect.left;
      const centerY = center.y - rect.top;
      
      // Adjust translation to zoom towards center of pinch
      const scaleChange = newScale / touchStartScale;
      translateX = centerX - (centerX - touchStartTranslateX) * scaleChange;
      translateY = centerY - (centerY - touchStartTranslateY) * scaleChange;
      
      scale = newScale;
      updateTransform();
    } else if (touches.length === 1 && isPanning) {
      // Pan with single finger - prevent scroll
      e.preventDefault();
      translateX = touches[0].clientX - startPanX;
      translateY = touches[0].clientY - startPanY;
      updateTransform();
    }
  }, { passive: false });

  mapWrapper?.addEventListener('touchend', (e) => {
    touches = Array.from(e.touches);
    
    if (touches.length < 2) {
      touchStartDistance = 0;
    }
    
    if (touches.length === 0) {
      isPanning = false;
      mapWrapper.classList.remove('interacting');
      // Re-enable transition after interaction ends
      if (mapSvg) mapSvg.style.transition = '';
    }
  });

  mapWrapper?.addEventListener('touchcancel', (e) => {
    touches = [];
    touchStartDistance = 0;
    isPanning = false;
    mapWrapper.classList.remove('interacting');
    // Re-enable transition after interaction ends
    if (mapSvg) mapSvg.style.transition = '';
  });

  // Track mouse/touch pointer inside the map so zoom buttons can use pointer-origin when hovering
  mapWrapper?.addEventListener('mouseenter', (e) => {
    isPointerOverMap = true;
  });
  mapWrapper?.addEventListener('mouseleave', (e) => {
    isPointerOverMap = false;
    lastPointerX = null;
    lastPointerY = null;
  });
  mapWrapper?.addEventListener('mousemove', (e) => {
    const rect = mapWrapper.getBoundingClientRect();
    lastPointerX = e.clientX - rect.left;
    lastPointerY = e.clientY - rect.top;
  });

  // Pan with mouse drag
  mapWrapper?.addEventListener('mousedown', (e) => {
    // Don't pan if clicking on a pin or in edit mode dragging a pin
    if (e.target.closest('.location-pin') && editMode) {
      return;
    }
    
    isPanning = true;
    // Disable transition during interaction for smooth performance
    if (mapSvg) mapSvg.style.transition = 'none';
    mapWrapper.classList.add('interacting');
    startPanX = e.clientX - translateX;
    startPanY = e.clientY - translateY;
    mapWrapper.style.cursor = 'grabbing';
  });

  document.addEventListener('mousemove', (e) => {
    if (isPanning && !draggedPin) {
      translateX = e.clientX - startPanX;
      translateY = e.clientY - startPanY;
      updateTransform();
    }
  });

  document.addEventListener('mouseup', () => {
    if (isPanning) {
      isPanning = false;
      mapWrapper.classList.remove('interacting');
      // Re-enable transition after interaction ends
      if (mapSvg) mapSvg.style.transition = '';
      mapWrapper.style.cursor = 'grab';
    }
  });

  // Prevent context menu on map
  mapWrapper?.addEventListener('contextmenu', (e) => {
    e.preventDefault();
  });

  // Initial render and setup function
  function initializeMap() {
    // Apply configured map size and initial fitting
    applyMapSize();
    renderLandmarks();
    // Render pins first so DOM elements exist, then build the hero path from actual pin positions
    renderPins();
    // Now that pins are in the DOM, build the hero path to follow them
    buildHeroPath();
    fitToViewport();
    updateTransform(); // Apply initial transform
  }
  
  // Initialize map on page load (works with both initial load and view transitions)
  // astro:page-load fires after the page is visible and scripts are loaded
  document.addEventListener('astro:page-load', () => {
    initializeMap();
  });

</script>

<style>
  /* Map page container */
  #mapPageContainer {
    position: relative;
  }

  /* SVG pin root: keep small by default and scale up on hover or on touch devices */
  .location-pin {
    transform-box: fill-box; /* ensure CSS transform uses the group's bounding box */
    transform-origin: 50% 50%;
    transform: scale(0.7);
    transition: transform 0.12s ease, opacity 0.12s ease;
    cursor: pointer;
  }

  .location-pin:hover {
    transform: scale(1.0);
    z-index: 50;
  }

  .location-pin.pin-active {
    transform: scale(1.15);
    z-index: 60;
  }

  .location-pin.pin-active .pin-circle {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    transform: scale(1.3);
  }
  
  .pin-tooltip a {
    pointer-events: auto !important;
  }

  #mapContainer {
    user-select: none;
  }
  
  #mapWrapper {
    position: relative;
  }
  
  #mapSvg {
    /* Hardware acceleration for smoother transforms on mobile */
    transform: translateZ(0);
    backface-visibility: hidden;
  }
  
  /* Apply will-change only during active interactions for better performance */
  #mapWrapper.interacting #mapSvg {
    will-change: transform;
  }

  /* Sidebar slide-in animation */
  #locationDetails {
    transition: transform 0.3s ease-in-out;
  }

  /* Make pins larger on touch devices for better tap targets */
  @media (hover: none) and (pointer: coarse) {
    .location-pin {
      transform: scale(1.15);
    }
    .location-pin:active {
      transform: scale(1.2);
    }
  }

  /* Mobile overlay sidebar */
  @media (max-width: 639px) {
    #locationDetails {
      width: 100%;
    }
    
    #sidebarBackdrop {
      display: none;
      opacity: 0;
      transition: opacity 0.3s ease-in-out;
    }
    
    #sidebarBackdrop:not(.hidden) {
      opacity: 1;
    }
  }

  /* Landmarks (non-editable) */
  .landmark-pin { z-index: 15; }
  .landmark-dot { box-shadow: 0 2px 6px rgba(0,0,0,0.15); }
  .landmark-svg svg { width: 1.25rem; height: 1.25rem; display: block; }

  /* Landmark tooltip */
  .landmark-tooltip { z-index: 9999; pointer-events: none; }

  /* Hero path styling (SVG) */
  #mapSvg { z-index: 5; }

  /* Markdown prose styling for location descriptions */
  .prose {
    @apply text-gray-900 dark:text-gray-100;
  }
  
  .prose :where(h1):not(:where([class~="not-prose"] *)) {
    @apply text-primary-700 dark:text-primary-400;
  }
  
  .prose :where(h2):not(:where([class~="not-prose"] *)) {
    @apply text-primary-600 dark:text-primary-400;
  }
  
  .prose :where(h3):not(:where([class~="not-prose"] *)) {
    @apply text-primary-600 dark:text-primary-500;
  }
  
  .prose :where(a):not(:where([class~="not-prose"] *)) {
    @apply text-primary-600 dark:text-primary-400 no-underline hover:underline;
  }
  
  .prose :where(strong):not(:where([class~="not-prose"] *)) {
    @apply text-gray-900 dark:text-gray-100;
  }
  
  .prose :where(code):not(:where([class~="not-prose"] *)) {
    @apply bg-gray-100 dark:bg-gray-800 text-primary-700 dark:text-primary-400 px-1 py-0.5 rounded;
  }
  
  .prose :where(blockquote):not(:where([class~="not-prose"] *)) {
    @apply border-l-4 border-primary-500 dark:border-primary-600 bg-gray-50 dark:bg-gray-900 pl-4 py-2;
  }
  
  .prose :where(ul):not(:where([class~="not-prose"] *)),
  .prose :where(ol):not(:where([class~="not-prose"] *)) {
    @apply text-gray-700 dark:text-gray-300;
  }
  
  .prose :where(hr):not(:where([class~="not-prose"] *)) {
    @apply border-gray-300 dark:border-gray-700;
  }
</style>
</Layout>

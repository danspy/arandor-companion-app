---
import Layout from '../layouts/Layout.astro';
import { db, Quest } from 'astro:db';
import { isAuthenticated } from '../lib/auth';

const quests = await db.select().from(Quest);
const isLoggedIn = isAuthenticated(Astro.cookies);

const activeQuests = quests.filter(q => q.status === 'active');
const completedQuests = quests.filter(q => q.status === 'completed');
const failedQuests = quests.filter(q => q.status === 'failed');
---

<Layout title="Quests">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold text-primary-700 dark:text-primary-400">Quests</h1>
    {isLoggedIn && (
      <button 
        id="addQuest"
        class="bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
      >
        + Add Quest
      </button>
    )}
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-700">
      <div class="text-3xl font-bold text-primary-600 dark:text-primary-400">{quests.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Total Quests</div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-700">
      <div class="text-3xl font-bold text-accent-600 dark:text-accent-400">{activeQuests.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Active</div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-700">
      <div class="text-3xl font-bold text-green-600 dark:text-green-400">{completedQuests.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Completed</div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-700">
      <div class="text-3xl font-bold text-red-600 dark:text-red-400">{failedQuests.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Failed</div>
    </div>
  </div>

  <!-- Active Quests -->
  <section class="mb-8">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4">Active Quests</h2>
    <div class="space-y-4">
      {activeQuests.map(quest => (
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 hover:shadow-lg transition dark:border dark:border-gray-700">
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-4">
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-2">
                <h3 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-gray-100">{quest.title}</h3>
                <span class={`px-3 py-1 rounded-full text-xs font-medium whitespace-nowrap ${
                  quest.priority === 'high' ? 'bg-red-100 text-red-700' :
                  quest.priority === 'medium' ? 'bg-secondary-100 text-secondary-700' :
                  'bg-green-100 text-green-700'
                }`}>
                  {quest.priority} priority
                </span>
              </div>
              <p class="text-gray-700 dark:text-gray-300 text-sm sm:text-base">{quest.description}</p>
            </div>
            {isLoggedIn && (
              <div class="flex flex-col sm:flex-row gap-2 sm:ml-4 w-full sm:w-auto">
                <button class="complete-quest px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 transition text-sm" data-id={quest.id}>
                  Complete
                </button>
                <button class="fail-quest px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 transition text-sm" data-id={quest.id}>
                  Fail
                </button>
                <button class="edit-quest px-4 py-2 border border-gray-300 dark:border-gray-600 rounded hover:bg-gray-50 dark:hover:bg-gray-700 transition text-sm" data-id={quest.id}>
                  Edit
                </button>
                <button class="delete-quest px-4 py-2 bg-gray-600 text-white rounded hover:bg-gray-700 transition text-sm" data-id={quest.id}>
                  Delete
                </button>
              </div>
            )}
          </div>
        </div>
      ))}
      {activeQuests.length === 0 && (
        <div class="text-center py-8 bg-white dark:bg-gray-800 rounded-lg shadow-md dark:border dark:border-gray-700">
          <p class="text-gray-500 dark:text-gray-400">No active quests</p>
        </div>
      )}
    </div>
  </section>

  <!-- Completed Quests -->
  {completedQuests.length > 0 && (
    <section class="mb-8">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4">Completed Quests</h2>
      <div class="space-y-4">
        {completedQuests.map(quest => (
          <div class="bg-green-50 dark:bg-green-900/20 rounded-lg shadow p-6 opacity-75 dark:border dark:border-green-800">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100">{quest.title}</h3>
                <p class="text-gray-700 dark:text-gray-300">{quest.description}</p>
              </div>
              <span class="bg-green-600 text-white px-3 py-1 rounded text-sm">
                ✓ Completed
              </span>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Failed Quests -->
  {failedQuests.length > 0 && (
    <section>
      <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4">Failed Quests</h2>
      <div class="space-y-4">
        {failedQuests.map(quest => (
          <div class="bg-red-50 dark:bg-red-900/20 rounded-lg shadow p-6 opacity-75 dark:border dark:border-red-800">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100">{quest.title}</h3>
                <p class="text-gray-700 dark:text-gray-300">{quest.description}</p>
              </div>
              <span class="bg-red-600 text-white px-3 py-1 rounded text-sm">
                ✗ Failed
              </span>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Modal for Add/Edit Quest -->
  <div id="questModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white dark:bg-gray-800 rounded-lg p-4 sm:p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto dark:border dark:border-gray-700">
      <h2 id="modalTitle" class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6 text-primary-700 dark:text-primary-400">New Quest</h2>
      <form id="questForm" class="space-y-4">
        <input type="hidden" id="questId" name="id">
        
        <div>
          <label for="title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Title</label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            required 
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          >
        </div>
        
        <div>
          <label for="description" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Description</label>
          <textarea 
            id="description" 
            name="description" 
            required 
            rows="4"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          ></textarea>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="priority" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Priority</label>
            <select 
              id="priority" 
              name="priority" 
              required
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
              <option value="low">Low</option>
              <option value="medium" selected>Medium</option>
              <option value="high">High</option>
            </select>
          </div>
          
          <div>
            <label for="status" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Status</label>
            <select 
              id="status" 
              name="status" 
              required
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
              <option value="active" selected>Active</option>
              <option value="completed">Completed</option>
              <option value="failed">Failed</option>
            </select>
          </div>
        </div>
        
        <div class="flex gap-4 pt-4">
          <button 
            type="submit" 
            class="flex-1 bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 transition"
          >
            Save Quest
          </button>
          <button 
            type="button" 
            id="cancelModal"
            class="flex-1 bg-gray-300 dark:bg-gray-600 text-gray-700 dark:text-gray-200 px-6 py-2 rounded-lg hover:bg-gray-400 dark:hover:bg-gray-500 transition"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  const modal = document.getElementById('questModal');
  const form = document.getElementById('questForm') as HTMLFormElement;
  const modalTitle = document.getElementById('modalTitle');
  const addButton = document.getElementById('addQuest');
  const cancelButton = document.getElementById('cancelModal');

  let editingId: string | null = null;

  // Open modal for new quest
  addButton?.addEventListener('click', () => {
    editingId = null;
    form.reset();
    if (modalTitle) modalTitle.textContent = 'New Quest';
    modal?.classList.remove('hidden');
  });

  // Close modal
  cancelButton?.addEventListener('click', () => {
    modal?.classList.add('hidden');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
    }
  });

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const data = {
      title: formData.get('title'),
      description: formData.get('description'),
      priority: formData.get('priority'),
      status: formData.get('status'),
    };

    try {
      const url = editingId ? `/api/quests/${editingId}` : '/api/quests';
      const method = editingId ? 'PUT' : 'POST';
      
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        alert('Failed to save quest. Please try again.');
      }
    } catch (error) {
      alert('An error occurred. Please try again.');
    }
  });

  // Edit quest
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    
    if (target.classList.contains('edit-quest')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      try {
        const response = await fetch(`/api/quests/${id}`);
        const quest = await response.json();
        
        editingId = id;
        (document.getElementById('title') as HTMLInputElement).value = quest.title;
        (document.getElementById('description') as HTMLTextAreaElement).value = quest.description;
        (document.getElementById('priority') as HTMLSelectElement).value = quest.priority;
        (document.getElementById('status') as HTMLSelectElement).value = quest.status;
        
        if (modalTitle) modalTitle.textContent = 'Edit Quest';
        modal?.classList.remove('hidden');
      } catch (error) {
        alert('Failed to load quest. Please try again.');
      }
    }
    
    // Complete quest
    if (target.classList.contains('complete-quest')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      try {
        const response = await fetch(`/api/quests/${id}`);
        const quest = await response.json();
        
        const updateResponse = await fetch(`/api/quests/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...quest, status: 'completed' }),
        });
        
        if (updateResponse.ok) {
          window.location.reload();
        } else {
          alert('Failed to complete quest. Please try again.');
        }
      } catch (error) {
        alert('An error occurred. Please try again.');
      }
    }
    
    // Fail quest
    if (target.classList.contains('fail-quest')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      try {
        const response = await fetch(`/api/quests/${id}`);
        const quest = await response.json();
        
        const updateResponse = await fetch(`/api/quests/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...quest, status: 'failed' }),
        });
        
        if (updateResponse.ok) {
          window.location.reload();
        } else {
          alert('Unable to mark quest as failed. Please try again.');
        }
      } catch (error) {
        alert('An error occurred. Please try again.');
      }
    }
    
    // Delete quest
    if (target.classList.contains('delete-quest')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      if (confirm('Are you sure you want to delete this quest?')) {
        try {
          const response = await fetch(`/api/quests/${id}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete quest. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    }
  });
</script>

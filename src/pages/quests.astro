---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { db, Quest, PageSettings, eq } from '@/db';
import { getUserRole } from '../lib/auth';

// Quests page is viewable by everyone, editable by dungeonmaster and admin
const userRole = await getUserRole(Astro.cookies);

const quests = await db.select().from(Quest);
const isLoggedIn = !!userRole;
const canEdit = userRole === 'admin' || userRole === 'dungeonmaster';

const activeQuests = quests.filter(q => q.status === 'active');
const completedQuests = quests.filter(q => q.status === 'completed');
const failedQuests = quests.filter(q => q.status === 'failed');

// Get priority counts
const highPriority = quests.filter(q => q.priority === 'high').length;
const mediumPriority = quests.filter(q => q.priority === 'medium').length;
const lowPriority = quests.filter(q => q.priority === 'low').length;

// Sort quests: active first, then by priority (high > medium > low)
const sortedQuests = [...quests].sort((a, b) => {
  // First sort by status (active first)
  const statusOrder: Record<string, number> = { 'active': 0, 'completed': 1, 'failed': 2 };
  const statusA = statusOrder[a.status] ?? 3;
  const statusB = statusOrder[b.status] ?? 3;
  if (statusA !== statusB) return statusA - statusB;

  // Then by priority (high first)
  const priorityOrder: Record<string, number> = { 'high': 0, 'medium': 1, 'low': 2 };
  const priorityA = priorityOrder[a.priority] ?? 3;
  const priorityB = priorityOrder[b.priority] ?? 3;
  return priorityA - priorityB;
});

// Get page settings for hero image
const pageSettings = await db.select().from(PageSettings).where(eq(PageSettings.pageName, 'quests'));
const heroImageUrl = pageSettings.length > 0 ? pageSettings[0].heroImageUrl : null;
---

<Layout title="Quests">
  <PageHero
    title="Quests"
    heroImageUrl={heroImageUrl}
    pageName="quests"
    canEditHero={canEdit}
    subtitle={`${activeQuests.length} open, ${completedQuests.length} completed${failedQuests.length ? `, ${failedQuests.length} failed` : ''}`}
  >
    <Fragment slot="actions">
      {canEdit && (
    <Button
      variant="primary"
      size="md"
      icon="add"
      id="addQuest"
      title="Add new Add Quest"
    >
      Add quest
    </Button>
      )}
    </Fragment>
  </PageHero>

  <!-- Search and Filter -->
  <div class="t-panel p-4 mb-6">
    <div class="flex flex-col gap-3">
      <!-- Search Input - Always Full Width -->
      <div class="relative w-full">
        <input
          type="text"
          id="searchInput"
          placeholder="Search quests by title or description..."
          class="t-search w-full px-4 py-2 pl-10 rounded-xs transition"
        >
        <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 t-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <!-- Status and Priority Filters Below -->
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-sm t-muted font-medium">Status:</span>
        <button class="filter-btn t-pill active transition-all duration-200 active:scale-95" data-filter="all">
          All ({quests.length})
        </button>
        <button class="filter-btn t-pill transition-all duration-200 active:scale-95" data-filter="active">
          Active ({activeQuests.length})
        </button>
        <button class="filter-btn t-pill transition-all duration-200 active:scale-95" data-filter="completed">
          Completed ({completedQuests.length})
        </button>
        <button class="filter-btn t-pill transition-all duration-200 active:scale-95" data-filter="failed">
          Failed ({failedQuests.length})
        </button>
      </div>
    </div>
  </div>

  <!-- All Quests Grid -->
  <div id="questsGrid" class="space-y-4">
    {sortedQuests.map(quest => (
      <div class="quest-card t-panel p-6 hover:shadow-lg transition" data-status={quest.status} data-priority={quest.priority} data-search={`${quest.title} ${quest.description}`.toLowerCase()}>
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-4">
          <div class="flex-1">
            <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-2">
              <h3 class="text-lg sm:text-xl font-bold t-strong-text"><a href={`/quests/${quest.id}`} class="hover:underline">{quest.title}</a></h3>
              <span class={`t-badge ${
                quest.status === 'completed' ? 't-badge-green' :
                quest.status === 'failed' ? 't-badge-red' :
                't-badge-accent'
              }`}>
                {quest.status}
              </span>
              <span class={`t-badge ${
                quest.priority === 'high' ? 't-badge-red' :
                quest.priority === 'medium' ? 't-badge-gold' :
                't-badge-green'
              }`}>
                {quest.priority} priority
              </span>
            </div>
            <p class="t-body-text text-sm sm:text-base">{quest.description}</p>
          </div>
          {canEdit && (
            <div class="flex flex-col sm:flex-row gap-2 sm:ml-4 w-full sm:w-auto items-center items-end">
              {quest.status === 'active' && (
                <>
                  <Button variant="success" size="xs" class="complete-quest" data-id={quest.id}>
                    Complete
                  </Button>
                  <Button variant="danger" size="xs" class="fail-quest" data-id={quest.id}>
                    Fail
                  </Button>
                </>
              )}
              {(quest.status === 'completed' || quest.status === 'failed') && (
                <Button variant="secondary" size="xs" class="reactivate-quest" data-id={quest.id}>
                  Reactivate
                </Button>
              )}
              <div class="flex gap-2 items-center">
                <Button
                variant="icon"
                size="sm"
                icon="edit"
                iconPosition="only"
                class="edit-quest"
                data-id={quest.id}
                title="Edit quest"
                ariaLabel="Edit quest"
              />
                <Button
                variant="icon"
                size="sm"
                icon="delete"
                iconPosition="only"
                class="delete-quest hover:text-red-400"
                data-id={quest.id}
                title="Delete quest"
                ariaLabel="Delete quest"
              />
              </div>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>

  {quests.length === 0 && (
    <div class="text-center py-16 t-panel">
      <p class="t-faint text-lg">No quests yet. Start adding adventures!</p>
    </div>
  )}

  <!-- Modal for Add/Edit Quest -->
  <div id="questModal" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50 p-4 modal-overlay-safe">
    <div class="t-modal-panel p-4 sm:p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto modal-content-safe">
      <h2 id="modalTitle" class="t-section-h text-xl sm:text-2xl mb-4 sm:mb-6">New Quest</h2>
      <form id="questForm" class="space-y-4">
        <input type="hidden" id="questId" name="id">

        <div>
          <label for="title" class="t-label block mb-1">Title</label>
          <input type="text" id="title" name="title" required class="t-input px-4 py-2">
        </div>

        <div>
          <label for="description" class="t-label block mb-1">Description</label>
          <textarea id="description" name="description" required rows="4" class="t-input px-4 py-2"></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="priority" class="t-label block mb-1">Priority</label>
            <select id="priority" name="priority" required class="t-input px-4 py-2">
              <option value="low">Low</option>
              <option value="medium" selected>Medium</option>
              <option value="high">High</option>
            </select>
          </div>

          <div>
            <label for="status" class="t-label block mb-1">Status</label>
            <select id="status" name="status" required class="t-input px-4 py-2">
              <option value="active" selected>Active</option>
              <option value="completed">Completed</option>
              <option value="failed">Failed</option>
            </select>
          </div>
        </div>

        <div class="flex gap-4 pt-4">
          <button type="submit" class="t-btn-primary flex-1 px-6 py-2">Save quest</button>
          <button type="button" id="cancelModal" class="t-btn-secondary flex-1">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  // Shared state for editing quest ID
  let editingId: string | null = null;

  // Initialize quest functionality on page load
  // This ensures it works after Astro View Transitions navigation
  function initializeQuests() {
    const modal = document.getElementById('questModal');
    const form = document.getElementById('questForm') as HTMLFormElement;
    const modalTitle = document.getElementById('modalTitle');
    const addButton = document.getElementById('addQuest');
    const cancelButton = document.getElementById('cancelModal');

    // Open modal for new quest
    addButton?.addEventListener('click', () => {
      editingId = null;
      form.reset();
      if (modalTitle) modalTitle.textContent = 'New Quest';
      modal?.classList.remove('hidden');
    });

    // Close modal
    cancelButton?.addEventListener('click', () => {
      modal?.classList.add('hidden');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });

    // Handle form submission
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = {
        title: formData.get('title'),
        description: formData.get('description'),
        priority: formData.get('priority'),
        status: formData.get('status'),
      };

      try {
        const url = editingId ? `/api/quests/${editingId}` : '/api/quests';
        const method = editingId ? 'PUT' : 'POST';

        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Failed to save quest. Please try again.');
        }
      } catch (error) {
        alert('An error occurred. Please try again.');
      }
    });

    // Open the edit modal when arriving from a quest page (?edit=<id>)
    const editId = new URLSearchParams(window.location.search).get('edit');
    if (editId && modal) {
      (async () => {
        try {
          const response = await fetch(`/api/quests/${editId}`);
          if (!response.ok) throw new Error('Quest not found');
          const quest = await response.json();

          editingId = editId;
          (document.getElementById('title') as HTMLInputElement).value = quest.title;
          (document.getElementById('description') as HTMLTextAreaElement).value = quest.description;
          (document.getElementById('priority') as HTMLSelectElement).value = quest.priority;
          (document.getElementById('status') as HTMLSelectElement).value = quest.status;

          if (modalTitle) modalTitle.textContent = 'Edit quest';
          modal.classList.remove('hidden');
          window.history.replaceState({}, '', '/quests');
        } catch {
          alert('Failed to load quest. Please try again.');
        }
      })();
    }
  }

  // Handle quest actions with event delegation (once per page lifecycle)
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const modal = document.getElementById('questModal');
    const modalTitle = document.getElementById('modalTitle');

    // Edit quest
    if (target.classList.contains('edit-quest')) {
      const id = target.getAttribute('data-id');
      if (!id) return;

      try {
        const response = await fetch(`/api/quests/${id}`);
        const quest = await response.json();

        editingId = id;
        (document.getElementById('title') as HTMLInputElement).value = quest.title;
        (document.getElementById('description') as HTMLTextAreaElement).value = quest.description;
        (document.getElementById('priority') as HTMLSelectElement).value = quest.priority;
        (document.getElementById('status') as HTMLSelectElement).value = quest.status;

        if (modalTitle) modalTitle.textContent = 'Edit quest';
        modal?.classList.remove('hidden');
      } catch (error) {
        alert('Failed to load quest. Please try again.');
      }
    }

    // Complete quest
    if (target.classList.contains('complete-quest')) {
      const id = target.getAttribute('data-id');
      if (!id) return;

      try {
        const response = await fetch(`/api/quests/${id}`);
        const quest = await response.json();

        const updateResponse = await fetch(`/api/quests/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...quest, status: 'completed' }),
        });

        if (updateResponse.ok) {
          window.location.reload();
        } else {
          alert('Failed to complete quest. Please try again.');
        }
      } catch (error) {
        alert('An error occurred. Please try again.');
      }
    }

    // Fail quest
    if (target.classList.contains('fail-quest')) {
      const id = target.getAttribute('data-id');
      if (!id) return;

      try {
        const response = await fetch(`/api/quests/${id}`);
        const quest = await response.json();

        const updateResponse = await fetch(`/api/quests/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...quest, status: 'failed' }),
        });

        if (updateResponse.ok) {
          window.location.reload();
        } else {
          alert('Unable to mark quest as failed. Please try again.');
        }
      } catch (error) {
        alert('An error occurred. Please try again.');
      }
    }

    // Reactivate quest (set status back to active)
    if (target.classList.contains('reactivate-quest')) {
      const id = target.getAttribute('data-id');
      if (!id) return;

      try {
        const response = await fetch(`/api/quests/${id}`);
        const quest = await response.json();

        const updateResponse = await fetch(`/api/quests/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...quest, status: 'active' }),
        });

        if (updateResponse.ok) {
          window.location.reload();
        } else {
          alert('Failed to reactivate quest. Please try again.');
        }
      } catch (error) {
        alert('An error occurred. Please try again.');
      }
    }

    // Delete quest
    if (target.classList.contains('delete-quest')) {
      const id = target.getAttribute('data-id');
      if (!id) return;

      if ((await window.arandorConfirm('Delete this quest?', { detail: 'This can\u2019t be undone.', confirmLabel: 'Delete', danger: true }))) {
        try {
          const response = await fetch(`/api/quests/${id}`, {
            method: 'DELETE',
          });

          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete quest. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    }
  });

  // Initialize search and filter functionality on page load
  // This ensures it works after Astro View Transitions navigation
  function initializeFilters() {
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const filterBtns = document.querySelectorAll('.filter-btn');
    const questCards = document.querySelectorAll('.quest-card');

    let currentFilter = 'all';
    let currentSearch = '';

    const applyFilters = () => {
      const searchTerms = currentSearch.toLowerCase().split(/\s+/).filter(term => term.length > 0);
      questCards.forEach(card => {
        const cardStatus = card.getAttribute('data-status') || '';
        const searchText = card.getAttribute('data-search') || '';

        const matchesFilter = currentFilter === 'all' || cardStatus === currentFilter;
        // Match if ANY search term is found in the text (more flexible search)
        const matchesSearch = searchTerms.length === 0 || searchTerms.some(term => searchText.includes(term));

        (card as HTMLElement).style.display = matchesFilter && matchesSearch ? 'block' : 'none';
      });
    };

    // Search functionality
    searchInput?.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    // Filter functionality
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentFilter = btn.getAttribute('data-filter') || 'all';

        // Update button styles
        filterBtns.forEach(b => {
          if (b.getAttribute('data-filter') === currentFilter) {
            b.classList.add('active');
          } else {
            b.classList.remove('active');
          }
        });

        applyFilters();
      });
    });
  }

  // Run on initial page load and after View Transitions navigation
  document.addEventListener('astro:page-load', () => {
    initializeQuests();
    initializeFilters();
  });
</script>

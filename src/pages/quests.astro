---
import Layout from '../layouts/Layout.astro';
import { db, Quest } from 'astro:db';

const quests = await db.select().from(Quest);

const activeQuests = quests.filter(q => q.status === 'active');
const completedQuests = quests.filter(q => q.status === 'completed');
const failedQuests = quests.filter(q => q.status === 'failed');
---

<Layout title="Quests">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold text-purple-700">Quests</h1>
    <button 
      id="addQuest"
      class="bg-purple-600 text-white px-6 py-2 rounded-lg hover:bg-purple-700 transition"
    >
      + Add Quest
    </button>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white rounded-lg shadow-md p-6 text-center">
      <div class="text-3xl font-bold text-purple-600">{quests.length}</div>
      <div class="text-gray-600">Total Quests</div>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6 text-center">
      <div class="text-3xl font-bold text-blue-600">{activeQuests.length}</div>
      <div class="text-gray-600">Active</div>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6 text-center">
      <div class="text-3xl font-bold text-green-600">{completedQuests.length}</div>
      <div class="text-gray-600">Completed</div>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6 text-center">
      <div class="text-3xl font-bold text-red-600">{failedQuests.length}</div>
      <div class="text-gray-600">Failed</div>
    </div>
  </div>

  <!-- Active Quests -->
  <section class="mb-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Active Quests</h2>
    <div class="space-y-4">
      {activeQuests.map(quest => (
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition">
          <div class="flex justify-between items-start">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-2">
                <h3 class="text-xl font-bold text-gray-900">{quest.title}</h3>
                <span class={`px-3 py-1 rounded-full text-xs font-medium ${
                  quest.priority === 'high' ? 'bg-red-100 text-red-700' :
                  quest.priority === 'medium' ? 'bg-yellow-100 text-yellow-700' :
                  'bg-green-100 text-green-700'
                }`}>
                  {quest.priority} priority
                </span>
              </div>
              <p class="text-gray-700">{quest.description}</p>
            </div>
            <div class="flex gap-2 ml-4">
              <button class="complete-quest px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 transition text-sm" data-id={quest.id}>
                Complete
              </button>
              <button class="edit-quest px-4 py-2 border border-gray-300 rounded hover:bg-gray-50 transition text-sm" data-id={quest.id}>
                Edit
              </button>
              <button class="delete-quest px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 transition text-sm" data-id={quest.id}>
                Delete
              </button>
            </div>
          </div>
        </div>
      ))}
      {activeQuests.length === 0 && (
        <div class="text-center py-8 bg-white rounded-lg shadow-md">
          <p class="text-gray-500">No active quests</p>
        </div>
      )}
    </div>
  </section>

  <!-- Completed Quests -->
  {completedQuests.length > 0 && (
    <section>
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Completed Quests</h2>
      <div class="space-y-4">
        {completedQuests.map(quest => (
          <div class="bg-green-50 rounded-lg shadow p-6 opacity-75">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <h3 class="text-xl font-bold text-gray-900">{quest.title}</h3>
                <p class="text-gray-700">{quest.description}</p>
              </div>
              <span class="bg-green-600 text-white px-3 py-1 rounded text-sm">
                ✓ Completed
              </span>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Modal for Add/Edit Quest -->
  <div id="questModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg p-8 max-w-2xl w-full mx-4">
      <h2 id="modalTitle" class="text-2xl font-bold mb-6 text-purple-700">New Quest</h2>
      <form id="questForm" class="space-y-4">
        <input type="hidden" id="questId" name="id">
        
        <div>
          <label for="title" class="block text-sm font-medium text-gray-700 mb-1">Title</label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            required 
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
          >
        </div>
        
        <div>
          <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
          <textarea 
            id="description" 
            name="description" 
            required 
            rows="4"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
          ></textarea>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="priority" class="block text-sm font-medium text-gray-700 mb-1">Priority</label>
            <select 
              id="priority" 
              name="priority" 
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
            >
              <option value="low">Low</option>
              <option value="medium" selected>Medium</option>
              <option value="high">High</option>
            </select>
          </div>
          
          <div>
            <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
            <select 
              id="status" 
              name="status" 
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
            >
              <option value="active" selected>Active</option>
              <option value="completed">Completed</option>
              <option value="failed">Failed</option>
            </select>
          </div>
        </div>
        
        <div class="flex gap-4 pt-4">
          <button 
            type="submit" 
            class="flex-1 bg-purple-600 text-white px-6 py-2 rounded-lg hover:bg-purple-700 transition"
          >
            Save Quest
          </button>
          <button 
            type="button" 
            id="cancelModal"
            class="flex-1 bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 transition"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  const modal = document.getElementById('questModal');
  const form = document.getElementById('questForm') as HTMLFormElement;
  const modalTitle = document.getElementById('modalTitle');
  const addButton = document.getElementById('addQuest');
  const cancelButton = document.getElementById('cancelModal');

  let editingId: string | null = null;

  // Open modal for new quest
  addButton?.addEventListener('click', () => {
    editingId = null;
    form.reset();
    if (modalTitle) modalTitle.textContent = 'New Quest';
    modal?.classList.remove('hidden');
  });

  // Close modal
  cancelButton?.addEventListener('click', () => {
    modal?.classList.add('hidden');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
    }
  });

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const data = {
      title: formData.get('title'),
      description: formData.get('description'),
      priority: formData.get('priority'),
      status: formData.get('status'),
    };

    try {
      const url = editingId ? `/api/quests/${editingId}` : '/api/quests';
      const method = editingId ? 'PUT' : 'POST';
      
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        alert('Failed to save quest. Please try again.');
      }
    } catch (error) {
      alert('An error occurred. Please try again.');
    }
  });

  // Edit quest
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    
    if (target.classList.contains('edit-quest')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      try {
        const response = await fetch(`/api/quests/${id}`);
        const quest = await response.json();
        
        editingId = id;
        (document.getElementById('title') as HTMLInputElement).value = quest.title;
        (document.getElementById('description') as HTMLTextAreaElement).value = quest.description;
        (document.getElementById('priority') as HTMLSelectElement).value = quest.priority;
        (document.getElementById('status') as HTMLSelectElement).value = quest.status;
        
        if (modalTitle) modalTitle.textContent = 'Edit Quest';
        modal?.classList.remove('hidden');
      } catch (error) {
        alert('Failed to load quest. Please try again.');
      }
    }
    
    // Complete quest
    if (target.classList.contains('complete-quest')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      try {
        const response = await fetch(`/api/quests/${id}`);
        const quest = await response.json();
        
        const updateResponse = await fetch(`/api/quests/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...quest, status: 'completed' }),
        });
        
        if (updateResponse.ok) {
          window.location.reload();
        } else {
          alert('Failed to complete quest. Please try again.');
        }
      } catch (error) {
        alert('An error occurred. Please try again.');
      }
    }
    
    // Delete quest
    if (target.classList.contains('delete-quest')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      if (confirm('Are you sure you want to delete this quest?')) {
        try {
          const response = await fetch(`/api/quests/${id}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete quest. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    }
  });
</script>

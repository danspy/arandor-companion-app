---
import Layout from '../layouts/Layout.astro';
import { db, Quest } from 'astro:db';
import { isAuthenticated } from '../lib/auth';

const quests = await db.select().from(Quest);
const isLoggedIn = isAuthenticated(Astro.cookies);

const activeQuests = quests.filter(q => q.status === 'active');
const completedQuests = quests.filter(q => q.status === 'completed');
const failedQuests = quests.filter(q => q.status === 'failed');

// Get priority counts
const highPriority = quests.filter(q => q.priority === 'high').length;
const mediumPriority = quests.filter(q => q.priority === 'medium').length;
const lowPriority = quests.filter(q => q.priority === 'low').length;

// Sort quests: active first, then by priority (high > medium > low)
const sortedQuests = [...quests].sort((a, b) => {
  // First sort by status (active first)
  const statusOrder: Record<string, number> = { 'active': 0, 'completed': 1, 'failed': 2 };
  const statusA = statusOrder[a.status] ?? 3;
  const statusB = statusOrder[b.status] ?? 3;
  if (statusA !== statusB) return statusA - statusB;
  
  // Then by priority (high first)
  const priorityOrder: Record<string, number> = { 'high': 0, 'medium': 1, 'low': 2 };
  const priorityA = priorityOrder[a.priority] ?? 3;
  const priorityB = priorityOrder[b.priority] ?? 3;
  return priorityA - priorityB;
});
---

<Layout title="Quests">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold text-primary-700 dark:text-primary-400">Quests</h1>
    {isLoggedIn && (
      <button 
        id="addQuest"
        class="bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
      >
        + Add Quest
      </button>
    )}
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-primary-600 dark:text-primary-400">{quests.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Total Quests</div>
    </div>
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-accent-600 dark:text-accent-400">{activeQuests.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Active</div>
    </div>
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-green-600 dark:text-green-400">{completedQuests.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Completed</div>
    </div>
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-red-600 dark:text-red-400">{failedQuests.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Failed</div>
    </div>
  </div>

  <!-- Search and Filter -->
  <div class="bg-white dark:bg-black rounded-lg shadow-md p-4 mb-6 dark:border dark:border-gray-900">
    <div class="flex flex-col md:flex-row gap-4">
      <!-- Search Input -->
      <div class="flex-1">
        <div class="relative">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Search quests by title or description..."
            class="w-full px-4 py-2 pl-10 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100 transition"
          >
          <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>
      <!-- Status and Priority Filters -->
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-sm text-gray-600 dark:text-gray-400 font-medium">Status:</span>
        <button class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium bg-primary-600 text-white transition-all duration-200 hover:bg-primary-700 active:scale-95" data-filter="all">
          All ({quests.length})
        </button>
        <button class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95" data-filter="active">
          Active ({activeQuests.length})
        </button>
        <button class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95" data-filter="completed">
          Completed ({completedQuests.length})
        </button>
        <button class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95" data-filter="failed">
          Failed ({failedQuests.length})
        </button>
      </div>
    </div>
  </div>

  <!-- All Quests Grid -->
  <div id="questsGrid" class="space-y-4">
    {sortedQuests.map(quest => (
      <div class="quest-card bg-white dark:bg-black rounded-lg shadow-md p-6 hover:shadow-lg transition dark:border dark:border-gray-900" data-status={quest.status} data-priority={quest.priority} data-search={`${quest.title} ${quest.description}`.toLowerCase()}>
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-4">
          <div class="flex-1">
            <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-2">
              <h3 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-gray-100">{quest.title}</h3>
              <span class={`px-3 py-1 rounded-full text-xs font-medium whitespace-nowrap ${
                quest.status === 'completed' ? 'bg-green-100 text-green-700 dark:bg-green-900/20 dark:text-green-400' :
                quest.status === 'failed' ? 'bg-red-100 text-red-700 dark:bg-red-900/20 dark:text-red-400' :
                'bg-accent-100 text-accent-700 dark:bg-accent-900/20 dark:text-accent-400'
              }`}>
                {quest.status}
              </span>
              <span class={`px-3 py-1 rounded-full text-xs font-medium whitespace-nowrap ${
                quest.priority === 'high' ? 'bg-red-100 text-red-700 dark:bg-red-900/20 dark:text-red-400' :
                quest.priority === 'medium' ? 'bg-secondary-100 text-secondary-700 dark:bg-secondary-900/20 dark:text-secondary-400' :
                'bg-green-100 text-green-700 dark:bg-green-900/20 dark:text-green-400'
              }`}>
                {quest.priority} priority
              </span>
            </div>
            <p class="text-gray-700 dark:text-gray-300 text-sm sm:text-base">{quest.description}</p>
          </div>
          {isLoggedIn && (
            <div class="flex flex-col sm:flex-row gap-2 sm:ml-4 w-full sm:w-auto">
              {quest.status === 'active' && (
                <>
                  <button class="complete-quest px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 dark:bg-green-700 dark:hover:bg-green-600 transition text-sm" data-id={quest.id}>
                    Complete
                  </button>
                  <button class="fail-quest px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 dark:bg-red-700 dark:hover:bg-red-600 transition text-sm" data-id={quest.id}>
                    Fail
                  </button>
                </>
              )}
              {(quest.status === 'completed' || quest.status === 'failed') && (
                <button class="reactivate-quest px-4 py-2 bg-accent-600 text-white rounded hover:bg-accent-700 dark:bg-accent-700 dark:hover:bg-accent-600 transition text-sm" data-id={quest.id}>
                  Reactivate
                </button>
              )}
              <button class="edit-quest px-4 py-2 bg-primary-600 text-white rounded hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition text-sm" data-id={quest.id}>
                Edit
              </button>
              <button class="delete-quest px-4 py-2 border-2 border-red-600 text-red-600 dark:text-red-400 dark:border-red-500 rounded hover:bg-red-50 dark:hover:bg-red-900/20 transition text-sm" data-id={quest.id}>
                Delete
              </button>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>

  {quests.length === 0 && (
    <div class="text-center py-16 bg-white dark:bg-black rounded-lg shadow-md dark:border dark:border-gray-900">
      <p class="text-gray-500 dark:text-gray-400 text-lg">No quests yet. Start adding adventures!</p>
    </div>
  )}

  <!-- Modal for Add/Edit Quest -->
  <div id="questModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white dark:bg-black rounded-lg p-4 sm:p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto dark:border dark:border-gray-900">
      <h2 id="modalTitle" class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6 text-primary-700 dark:text-primary-400">New Quest</h2>
      <form id="questForm" class="space-y-4">
        <input type="hidden" id="questId" name="id">
        
        <div>
          <label for="title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Title</label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            required 
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          >
        </div>
        
        <div>
          <label for="description" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Description</label>
          <textarea 
            id="description" 
            name="description" 
            required 
            rows="4"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          ></textarea>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="priority" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Priority</label>
            <select 
              id="priority" 
              name="priority" 
              required
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
              <option value="low">Low</option>
              <option value="medium" selected>Medium</option>
              <option value="high">High</option>
            </select>
          </div>
          
          <div>
            <label for="status" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Status</label>
            <select 
              id="status" 
              name="status" 
              required
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
              <option value="active" selected>Active</option>
              <option value="completed">Completed</option>
              <option value="failed">Failed</option>
            </select>
          </div>
        </div>
        
        <div class="flex gap-4 pt-4">
          <button 
            type="submit" 
            class="flex-1 bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
          >
            Save Quest
          </button>
          <button 
            type="button" 
            id="cancelModal"
            class="flex-1 bg-gray-300 dark:bg-gray-600 text-gray-700 dark:text-gray-200 px-6 py-2 rounded-lg hover:bg-gray-400 dark:hover:bg-gray-700 transition"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  // Shared state for editing quest ID
  let editingId: string | null = null;

  // Initialize quest functionality on page load
  // This ensures it works after Astro View Transitions navigation
  function initializeQuests() {
    const modal = document.getElementById('questModal');
    const form = document.getElementById('questForm') as HTMLFormElement;
    const modalTitle = document.getElementById('modalTitle');
    const addButton = document.getElementById('addQuest');
    const cancelButton = document.getElementById('cancelModal');

    // Open modal for new quest
    addButton?.addEventListener('click', () => {
      editingId = null;
      form.reset();
      if (modalTitle) modalTitle.textContent = 'New Quest';
      modal?.classList.remove('hidden');
    });

    // Close modal
    cancelButton?.addEventListener('click', () => {
      modal?.classList.add('hidden');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });

    // Handle form submission
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const data = {
        title: formData.get('title'),
        description: formData.get('description'),
        priority: formData.get('priority'),
        status: formData.get('status'),
      };

      try {
        const url = editingId ? `/api/quests/${editingId}` : '/api/quests';
        const method = editingId ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Failed to save quest. Please try again.');
        }
      } catch (error) {
        alert('An error occurred. Please try again.');
      }
    });
  }

  // Handle quest actions with event delegation (once per page lifecycle)
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const modal = document.getElementById('questModal');
    const modalTitle = document.getElementById('modalTitle');
    
    // Edit quest
    if (target.classList.contains('edit-quest')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      try {
        const response = await fetch(`/api/quests/${id}`);
        const quest = await response.json();
        
        editingId = id;
        (document.getElementById('title') as HTMLInputElement).value = quest.title;
        (document.getElementById('description') as HTMLTextAreaElement).value = quest.description;
        (document.getElementById('priority') as HTMLSelectElement).value = quest.priority;
        (document.getElementById('status') as HTMLSelectElement).value = quest.status;
        
        if (modalTitle) modalTitle.textContent = 'Edit Quest';
        modal?.classList.remove('hidden');
      } catch (error) {
        alert('Failed to load quest. Please try again.');
      }
    }
    
    // Complete quest
    if (target.classList.contains('complete-quest')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      try {
        const response = await fetch(`/api/quests/${id}`);
        const quest = await response.json();
        
        const updateResponse = await fetch(`/api/quests/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...quest, status: 'completed' }),
        });
        
        if (updateResponse.ok) {
          window.location.reload();
        } else {
          alert('Failed to complete quest. Please try again.');
        }
      } catch (error) {
        alert('An error occurred. Please try again.');
      }
    }
    
    // Fail quest
    if (target.classList.contains('fail-quest')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      try {
        const response = await fetch(`/api/quests/${id}`);
        const quest = await response.json();
        
        const updateResponse = await fetch(`/api/quests/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...quest, status: 'failed' }),
        });
        
        if (updateResponse.ok) {
          window.location.reload();
        } else {
          alert('Unable to mark quest as failed. Please try again.');
        }
      } catch (error) {
        alert('An error occurred. Please try again.');
      }
    }
    
    // Reactivate quest (set status back to active)
    if (target.classList.contains('reactivate-quest')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      try {
        const response = await fetch(`/api/quests/${id}`);
        const quest = await response.json();
        
        const updateResponse = await fetch(`/api/quests/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...quest, status: 'active' }),
        });
        
        if (updateResponse.ok) {
          window.location.reload();
        } else {
          alert('Failed to reactivate quest. Please try again.');
        }
      } catch (error) {
        alert('An error occurred. Please try again.');
      }
    }
    
    // Delete quest
    if (target.classList.contains('delete-quest')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      if (confirm('Are you sure you want to delete this quest?')) {
        try {
          const response = await fetch(`/api/quests/${id}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete quest. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    }
  });

  // Initialize search and filter functionality on page load
  // This ensures it works after Astro View Transitions navigation
  function initializeFilters() {
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const filterBtns = document.querySelectorAll('.filter-btn');
    const questCards = document.querySelectorAll('.quest-card');
    
    let currentFilter = 'all';
    let currentSearch = '';

    const applyFilters = () => {
      const searchTerms = currentSearch.toLowerCase().split(/\s+/).filter(term => term.length > 0);
      questCards.forEach(card => {
        const cardStatus = card.getAttribute('data-status') || '';
        const searchText = card.getAttribute('data-search') || '';
        
        const matchesFilter = currentFilter === 'all' || cardStatus === currentFilter;
        // Match if ANY search term is found in the text (more flexible search)
        const matchesSearch = searchTerms.length === 0 || searchTerms.some(term => searchText.includes(term));
        
        (card as HTMLElement).style.display = matchesFilter && matchesSearch ? 'block' : 'none';
      });
    };

    // Search functionality
    searchInput?.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    // Filter functionality
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentFilter = btn.getAttribute('data-filter') || 'all';
        
        // Update button styles
        filterBtns.forEach(b => {
          if (b.getAttribute('data-filter') === currentFilter) {
            b.classList.remove('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
            b.classList.add('bg-primary-600', 'text-white');
          } else {
            b.classList.remove('bg-primary-600', 'text-white');
            b.classList.add('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
          }
        });
        
        applyFilters();
      });
    });
  }

  // Run on initial page load and after View Transitions navigation
  document.addEventListener('astro:page-load', () => {
    initializeQuests();
    initializeFilters();
  });
</script>

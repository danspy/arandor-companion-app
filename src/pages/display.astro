---
// Player display: a full-screen page for the TV or second screen at the table. Public (no
// login). Shows whatever the DM picks on /tools/dm-screen; it polls /api/display, which only
// contains what players may see (health bands, never exact HP).
// /display?preview is the same page as a small live thumbnail on the DM screen: it never asks
// to keep the screen awake, goes full screen, hides the cursor or draws the idle sparks.
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en" class="dark" style="color-scheme: dark;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Player display · Arandor</title>
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
  </head>
  <body class="dsp" data-mode="idle">
    <!-- Blurred campaign image behind the idle screen and the NPC-only scene -->
    <div class="dsp-backdrop" aria-hidden="true"><img id="backdropImg" alt="" /></div>
    <!-- Start screen with "Title + last session": that diary entry's picture, sharp -->
    <div class="dsp-start-image" aria-hidden="true"><img id="startImage" alt="" /></div>
    <canvas class="dsp-idle-sparks" id="idleSparks" aria-hidden="true"></canvas>

    <!-- Waiting / paused / connecting -->
    <div class="dsp-idle" id="idle" role="status" aria-live="polite">
      <div class="dsp-idle-mark" aria-hidden="true"></div>
      <h1 class="dsp-idle-title" id="idleTitle">Connecting…</h1>
      <p class="dsp-idle-text" id="idleText"></p>
    </div>

    <!-- Session start: title card, optionally with a recap of the last session -->
    <div class="dsp-start" id="startScreen">
      <div class="dsp-idle-mark dsp-start-mark" aria-hidden="true"></div>
      <p class="dsp-start-campaign" id="startCampaign">Arandor</p>
      <p class="dsp-start-session" id="startSession" hidden></p>
      <h1 class="dsp-start-title" id="startTitle"></h1>
      <p class="dsp-start-date" id="startDate"></p>
      <div class="dsp-start-rule" aria-hidden="true"><span></span></div>
      <section class="dsp-start-recap t-panel" id="startRecap" hidden>
        <h2 class="dsp-start-recap-head">Previously…</h2>
        <p class="dsp-start-recap-entry" id="startRecapEntry" hidden></p>
        <p class="dsp-start-recap-text" id="startRecapText"></p>
      </section>
    </div>

    <!-- No session running: the campaign and, if planned, the next game night -->
    <div class="dsp-start" id="offScreen">
      <div class="dsp-idle-mark dsp-start-mark" aria-hidden="true"></div>
      <p class="dsp-start-campaign" id="offCampaign">Arandor</p>
      <h1 class="dsp-start-title" id="offTitle">No session running</h1>
      <p class="dsp-start-date" id="offNext" hidden></p>
    </div>

    <!-- DM hid the screen and set a wallpaper -->
    <div class="dsp-wallpaper" id="wallpaper"><img id="wallpaperImg" alt="" /></div>

    <main class="dsp-stage" id="stage">
      <section class="dsp-scene" id="scene">
        <div class="dsp-location" id="location">
          <div class="dsp-loc-layers" id="locLayers"></div>
          <div class="dsp-loc-shade" aria-hidden="true"></div>
          <div class="dsp-loc-caption" id="locCaption">
            <p class="dsp-loc-kind" id="locKind"></p>
            <h1 class="dsp-loc-name" id="locName"></h1>
          </div>
        </div>
        <ul class="dsp-cast" id="cast" aria-label="Characters in the scene"></ul>
      </section>

      <aside class="dsp-side" id="side">
        <section class="dsp-timer t-panel" id="timer" aria-label="Timer">
          <div class="dsp-timer-time" id="timerTime">00:00</div>
          <div class="dsp-timer-bar" aria-hidden="true"><span id="timerFill"></span></div>
          <p class="dsp-timer-status" id="timerStatus"></p>
        </section>

        <section class="dsp-turns t-panel" id="turns" aria-label="Turn order">
          <header class="dsp-turns-head">
            <h2 class="dsp-turns-title">Turn order</h2>
            <p class="dsp-round" id="roundBox">Round <b id="round">1</b></p>
          </header>
          <div class="dsp-now" id="now" aria-live="polite">
            <canvas class="dsp-now-sparks" id="nowSparks" aria-hidden="true"></canvas>
            <p class="dsp-now-label" id="nowLabel">Now acting</p>
            <p class="dsp-now-name" id="nowName"></p>
            <p class="dsp-conds dsp-now-conds" id="nowConds"></p>
            <p class="dsp-now-next" id="nowNext"></p>
          </div>
          <ol class="dsp-ledger" id="ledger"></ol>
        </section>
      </aside>
    </main>

    <p class="dsp-conn" id="conn" role="status">Connection lost, retrying…</p>
    <p class="dsp-hint" id="hint">Press F for full screen</p>

    <style is:global>
      /* Scale everything with the screen so it reads from across the table. The smaller of
         width and height decides, so an ultrawide (height-bound) or a 4K TV both fit. */
      html:has(body.dsp) { font-size: clamp(14px, min(1.05vw, 1.9vh), 44px); }
      body.dsp {
        margin: 0;
        min-height: 100dvh;
        overflow: hidden;
        background: var(--bg-page);
        color: var(--text-body);
        --party: #8fb36a;
        --ally: var(--gold);
        --foe: #df6a48;
        --neutral: #9a8a70;
        --ease: cubic-bezier(.2, .7, .2, 1);
        /* Portraits and the place name gliding to a new layout: starts and ends gently */
        --ease-move: cubic-bezier(.45, 0, .2, 1);
        --side-w: clamp(22rem, 32vw, 42rem);
      }
      body.dsp.cursor-idle, body.dsp.cursor-idle * { cursor: none !important; }

      /* Mode switching: idle | start | off | wallpaper | stage */
      .dsp-idle, .dsp-start, .dsp-wallpaper, .dsp-stage, .dsp-backdrop, .dsp-idle-sparks, .dsp-start-image {
        position: fixed; inset: 0;
        opacity: 0; visibility: hidden;
        transition: opacity .8s var(--ease), visibility 0s linear .8s;
      }
      body[data-mode="idle"] :is(.dsp-idle, .dsp-backdrop, .dsp-idle-sparks),
      body[data-mode="start"] :is(#startScreen, .dsp-backdrop, .dsp-idle-sparks),
      body[data-mode="start"][data-start-image="1"] .dsp-start-image,
      body[data-mode="off"] :is(#offScreen, .dsp-backdrop, .dsp-idle-sparks),
      body[data-mode="wallpaper"] .dsp-wallpaper,
      body[data-mode="stage"] .dsp-stage,
      body[data-mode="stage"]:is([data-scene="cast"], [data-scene="none"]) .dsp-backdrop {
        opacity: 1; visibility: visible; transition-delay: 0s;
      }

      /* ── Backdrop (campaign image, blurred) ─────────────────────────── */
      .dsp-backdrop { overflow: hidden; z-index: 0; }
      .dsp-backdrop img {
        width: 100%; height: 100%; object-fit: cover;
        filter: blur(36px) saturate(1.15) brightness(.55);
        transform: scale(1.2);
      }
      .dsp-backdrop::after {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(ellipse 80% 70% at 50% 45%, transparent 0%, rgba(12, 9, 6, .85) 100%);
      }
      .dsp-idle-sparks { z-index: 1; width: 100%; height: 100%; pointer-events: none; }

      /* ── Idle ─────────────────────────────────────────────────────── */
      .dsp-idle {
        z-index: 2;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        text-align: center; padding: 2rem;
      }
      .dsp-idle-mark {
        width: 4.5rem; height: 4.5rem; margin-bottom: 2rem;
        border: 1px solid var(--border-gold);
        transform: rotate(45deg);
        position: relative;
        box-shadow: 0 0 3rem rgba(201, 144, 50, .18);
      }
      .dsp-idle-mark::after {
        content: ''; position: absolute; inset: 28%;
        background: var(--gold); opacity: .85;
        box-shadow: 0 0 1.5rem rgba(201, 144, 50, .7);
      }
      .dsp-idle-title {
        font-family: var(--font-display); font-style: italic; font-weight: 600;
        font-size: 4.2rem; line-height: 1.05; color: var(--text-strong);
        margin: 0; text-shadow: 0 .2rem 2rem rgba(0, 0, 0, .6);
      }
      .dsp-idle-text { margin: 1rem 0 0; font-size: 1.15rem; color: var(--text-muted); max-width: 36ch; }

      /* ── Start screen (and the no-session screen, same look) ──────── */
      .dsp-start {
        z-index: 2;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        text-align: center; padding: 2rem; gap: .6rem;
      }
      .dsp-start [hidden] { display: none; }
      .dsp-start-campaign, .dsp-start-session {
        margin: 0; font-size: 1.1rem; letter-spacing: .3em; text-transform: uppercase; color: var(--accent);
      }
      .dsp-start-title {
        font-family: var(--font-display); font-style: italic; font-weight: 600;
        font-size: 4.2rem; line-height: 1.05; color: var(--text-strong);
        margin: .4rem 0 0; max-width: 24ch; text-wrap: balance;
        text-shadow: 0 .2rem 2rem rgba(0, 0, 0, .6);
      }
      .dsp-start-date { margin: 0; font-size: 1.15rem; color: var(--text-muted); }
      .dsp-start-recap {
        margin-top: 1.5rem; width: min(52rem, 100%); min-height: 0; flex: 0 1 auto;
        display: flex; flex-direction: column; padding: 1.25rem 1.75rem; text-align: left;
        background-color: rgba(20, 15, 10, .78);
      }
      .dsp-start-recap-head {
        margin: 0 0 .6rem; font-family: var(--font-display); font-style: italic; font-weight: 600;
        font-size: 1.4rem; color: var(--accent);
      }
      .dsp-start-recap-text {
        margin: 0; min-height: 0; overflow-y: auto; white-space: pre-line;
        font-size: 1.2rem; line-height: 1.5; color: var(--text-body);
      }

      /* Opening: the backdrop drifts slowly, the mark breathes and the title card rises line by
         line (the animations start each time the screen switches to start or off) */
      body:is([data-mode="start"], [data-mode="off"]) .dsp-backdrop img {
        animation: dsp-start-drift 40s ease-in-out infinite alternate;
      }
      @keyframes dsp-start-drift {
        from { transform: scale(1.2); }
        to   { transform: scale(1.35) translate3d(-2%, -1.5%, 0); }
      }
      .dsp-start-mark { margin-bottom: 1.2rem; }
      /* The diary entry's picture: sharp, darkened towards the edges and the bottom so the text
         stays readable, drifting slowly */
      .dsp-start-image { z-index: 0; overflow: hidden; }
      .dsp-start-image img {
        width: 100%; height: 100%; object-fit: cover;
        filter: brightness(.62) saturate(1.05);
        animation: dsp-start-pan 45s ease-in-out infinite alternate;
      }
      .dsp-start-image::after {
        content: ''; position: absolute; inset: 0;
        background:
          radial-gradient(ellipse 75% 65% at 50% 45%, rgba(12, 9, 6, .1) 0%, rgba(12, 9, 6, .78) 100%),
          linear-gradient(180deg, rgba(12, 9, 6, .3) 0%, transparent 30%, transparent 50%, rgba(12, 9, 6, .85) 100%);
      }
      @keyframes dsp-start-pan {
        from { transform: scale(1.02); }
        to   { transform: scale(1.12) translate3d(1.5%, -1%, 0); }
      }
      .dsp-start-recap-entry {
        margin: -.25rem 0 .7rem; font-size: .95rem; letter-spacing: .18em; text-transform: uppercase;
        color: var(--text-muted);
      }
      body:is([data-mode="start"], [data-mode="off"]) .dsp-start-mark {
        animation: dsp-start-mark-in 1.1s var(--ease) both, dsp-start-glow 4s ease-in-out 1.1s infinite;
      }
      @keyframes dsp-start-mark-in {
        from { opacity: 0; transform: rotate(-135deg) scale(.4); }
        to   { opacity: 1; transform: rotate(45deg); }
      }
      @keyframes dsp-start-glow {
        50% { box-shadow: 0 0 5rem rgba(201, 144, 50, .45); border-color: var(--gold); }
      }
      body:is([data-mode="start"], [data-mode="off"]) .dsp-start > :not(.dsp-start-mark) {
        animation: dsp-start-in 1.1s var(--ease) both;
      }
      .dsp-start > :nth-child(2) { animation-delay: .35s !important; }
      .dsp-start > :nth-child(3) { animation-delay: .6s !important; }
      .dsp-start > :nth-child(4) { animation-delay: .85s !important; }
      .dsp-start > :nth-child(5) { animation-delay: 1.15s !important; }
      .dsp-start > :nth-child(6) { animation-delay: 1.4s !important; }
      .dsp-start > :nth-child(7) { animation-delay: 1.8s !important; }
      @keyframes dsp-start-in {
        from { opacity: 0; transform: translateY(1.2rem); filter: blur(6px); }
        to   { opacity: 1; transform: none; filter: none; }
      }
      /* The title catches the firelight now and then */
      body[data-mode="start"] .dsp-start-title {
        background: linear-gradient(100deg, var(--text-strong) 40%, #ffe3a3 50%, var(--text-strong) 60%) 0 0 / 300% 100%;
        -webkit-background-clip: text; background-clip: text; color: transparent;
        animation: dsp-start-in 1.1s var(--ease) both, dsp-start-shine 7s ease-in-out 2s infinite;
        text-shadow: none; filter: drop-shadow(0 .2rem 1.5rem rgba(0, 0, 0, .6));
      }
      @keyframes dsp-start-shine {
        0% { background-position: 100% 0; }
        35%, 100% { background-position: 0 0; }
      }
      .dsp-start-rule {
        display: flex; align-items: center; justify-content: center; gap: .8rem;
        width: min(22rem, 60%); margin: .6rem 0 0;
      }
      .dsp-start-rule::before, .dsp-start-rule::after {
        content: ''; flex: 1; height: 1px;
        background: linear-gradient(90deg, transparent, var(--border-gold));
      }
      .dsp-start-rule::after { transform: scaleX(-1); }
      .dsp-start-rule span {
        width: .55rem; height: .55rem; transform: rotate(45deg);
        background: var(--gold); box-shadow: 0 0 .8rem rgba(201, 144, 50, .8);
      }
      body[data-mode="start"] .dsp-start-recap { box-shadow: 0 0 4rem rgba(0, 0, 0, .5), 0 0 2rem rgba(201, 144, 50, .08); }

      /* ── Wallpaper ─────────────────────────────────────────────────── */
      .dsp-wallpaper { z-index: 3; background: #000; }
      .dsp-wallpaper img { width: 100%; height: 100%; object-fit: cover; }

      /* ── Stage layout ──────────────────────────────────────────────── */
      /* The scene (location, portraits) always fills the screen. Timer and turn order float
         over its right side, so a lone timer leaves no empty column. */
      .dsp-stage { z-index: 2; display: grid; grid-template-columns: minmax(0, 1fr); }
      body[data-scene="none"] .dsp-scene { display: none; }
      body[data-side="0"] .dsp-side { display: none; }

      .dsp-scene { position: absolute; inset: 0; overflow: hidden; }
      /* Darken the right edge under the floating panels */
      .dsp-location::after {
        content: ''; position: absolute; inset: 0; pointer-events: none; display: none;
        background: linear-gradient(to left, rgba(12, 9, 6, .7) 0, rgba(12, 9, 6, .3) var(--side-w), transparent calc(var(--side-w) + 14rem));
      }
      body[data-side="1"] .dsp-location::after { display: block; }


      /* Location: full-bleed art with a slow drift */
      .dsp-location { position: absolute; inset: 0; display: none; }
      body[data-location="1"] .dsp-location { display: block; }
      .dsp-loc-layers { position: absolute; inset: 0; overflow: hidden; }
      .dsp-loc-layer {
        position: absolute; inset: 0;
        opacity: 0; transition: opacity 1.4s var(--ease);
      }
      .dsp-loc-layer.is-in { opacity: 1; }
      .dsp-loc-layer img {
        width: 100%; height: 100%; object-fit: cover;
        animation: dsp-drift 60s ease-in-out infinite alternate;
        transform-origin: 60% 40%;
      }
      .dsp-loc-fill { display: none; }
      .dsp-location[data-fit="contain"] .dsp-loc-fill {
        display: block; position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
        filter: blur(40px) saturate(1.1) brightness(.45); transform: scale(1.15); animation: none;
      }
      .dsp-location[data-fit="contain"] .dsp-loc-layer img.dsp-loc-img { object-fit: contain; position: relative; animation-duration: 90s; }
      .dsp-loc-layer.is-painted { display: flex; align-items: center; justify-content: center; }
      .dsp-loc-layer.is-painted::before {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(ellipse 70% 60% at 50% 40%, rgba(201, 144, 50, .14), transparent 70%);
      }
      @keyframes dsp-drift {
        from { transform: scale(1.04) translate3d(0, 0, 0); }
        to   { transform: scale(1.14) translate3d(-2%, -1.5%, 0); }
      }
      .dsp-loc-shade {
        position: absolute; inset: 0; pointer-events: none;
        background:
          linear-gradient(to top, rgba(12, 9, 6, .92) 0%, rgba(12, 9, 6, .35) 30%, transparent 55%),
          linear-gradient(to right, rgba(12, 9, 6, .55) 0%, transparent 40%),
          radial-gradient(ellipse 120% 100% at 50% 50%, transparent 55%, rgba(12, 9, 6, .6) 100%);
      }
      .dsp-loc-caption {
        position: absolute; left: 3.5rem; bottom: 3rem; right: 3.5rem;
      }
      /* With portraits along the bottom, the place name moves to the top */
      body[data-cast="1"] .dsp-loc-caption { bottom: auto; top: 2.75rem; }
      body[data-side="1"] .dsp-loc-caption { right: calc(var(--side-w) + 1.5rem); }
      body[data-cast="1"] .dsp-loc-shade {
        background:
          linear-gradient(to bottom, rgba(12, 9, 6, .85) 0%, transparent 32%),
          linear-gradient(to top, rgba(12, 9, 6, .9) 0%, transparent 45%),
          radial-gradient(ellipse 120% 100% at 50% 50%, transparent 55%, rgba(12, 9, 6, .6) 100%);
      }
      .dsp-loc-kind {
        margin: 0 0 .4rem; font-size: 1.05rem; letter-spacing: .04em;
        color: var(--gold); text-shadow: 0 1px 8px rgba(0, 0, 0, .8);
      }
      .dsp-loc-kind:empty { display: none; }
      .dsp-loc-name {
        margin: 0; font-family: var(--font-display); font-style: italic; font-weight: 600;
        font-size: min(5.6rem, 11vw); line-height: .95; color: var(--text-strong);
        text-shadow: 0 .15rem 2.5rem rgba(0, 0, 0, .75);
        text-wrap: balance;
      }
      body[data-side="1"] .dsp-loc-name { font-size: min(4.6rem, 9vw); }

      /* NPC portraits: over the location, or on their own across the backdrop */
      /* The block is exactly as wide as its columns (--cast-w, set by layoutCast), so rows are
         balanced and a shorter last row sits centred under the others. */
      .dsp-cast {
        list-style: none; margin: 0; padding: 0;
        position: absolute; display: none;
        width: var(--cast-w, auto);
        flex-wrap: wrap; gap: var(--gap, 1.5rem); justify-content: center; align-content: center;
      }
      body[data-cast="1"] .dsp-cast { display: flex; }
      /* Over a location: along the bottom, centred in the free space, growing upward with more rows */
      body[data-location="1"] .dsp-cast { left: 3.5rem; right: 3.5rem; bottom: 2.5rem; margin: 0 auto; align-content: flex-end; }
      body[data-location="0"] .dsp-cast { inset: 3.5rem; margin: 0 auto; }
      body[data-side="1"] .dsp-cast { right: calc(var(--side-w) + 1.5rem); }
      .dsp-cast > li { display: block; }
      /* Only portraits that just joined rise in; the others glide to their new place (see play) */
      .dsp-cast > li.is-entering .dsp-portrait { animation: dsp-rise .7s var(--ease) both; animation-delay: calc(var(--enter-delay, 0ms) + var(--i, 0) * 70ms); }
      .dsp-cast > li.is-leaving { position: absolute; opacity: 0; transform: translateY(1rem) scale(.94); pointer-events: none; transition: opacity .4s ease, transform .4s var(--ease-move); }
      .dsp-portrait {
        position: relative; margin: 0;
        height: var(--ph, 12rem); width: calc(var(--ph, 12rem) * .75);
        font-size: clamp(.55rem, calc(var(--ph, 12rem) * .045), 1.1rem);
        background: var(--bg-raised);
        border: 1px solid var(--border-gold);
        box-shadow: 0 1.5rem 3rem rgba(0, 0, 0, .55);
        overflow: hidden;
      }
      .dsp-portrait img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; display: block; }
      .dsp-portrait-mono {
        width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
        font-family: var(--font-display); font-style: italic; font-weight: 600; font-size: 5em;
        color: var(--gold); background: radial-gradient(ellipse at 50% 35%, #2a1d0c, var(--bg-surface));
      }
      .dsp-portrait figcaption {
        position: absolute; left: 0; right: 0; bottom: 0;
        padding: 3em 1em .9em;
        background: linear-gradient(to top, rgba(12, 9, 6, .95) 10%, rgba(12, 9, 6, .6) 55%, transparent);
      }
      .dsp-portrait-name {
        margin: 0; font-family: var(--font-display); font-style: italic; font-weight: 600;
        font-size: 1.7em; line-height: 1.05; color: var(--text-strong);
        overflow-wrap: anywhere; text-wrap: balance;
      }
      .dsp-portrait-role { margin: .25em 0 0; font-size: .85em; color: var(--text-muted); line-height: 1.3; }
      /* Small portraits (many NPCs, small screens): name only, closer to the edge */
      .dsp-cast[data-compact] .dsp-portrait-role { display: none; }
      .dsp-cast[data-compact] .dsp-portrait figcaption { padding: 2.5em .9em .9em 1em; } /* clear of the corner marks */
      /* Gold corner marks, like the app's panels (sized with the portrait) */
      .dsp-portrait::before {
        content: ''; position: absolute; inset: .42em; pointer-events: none; z-index: 1;
        background:
          linear-gradient(var(--gold), var(--gold)) 0 0 / .85em 2px,
          linear-gradient(var(--gold), var(--gold)) 0 0 / 2px .85em,
          linear-gradient(var(--gold), var(--gold)) 100% 0 / .85em 2px,
          linear-gradient(var(--gold), var(--gold)) 100% 0 / 2px .85em,
          linear-gradient(var(--gold), var(--gold)) 0 100% / .85em 2px,
          linear-gradient(var(--gold), var(--gold)) 0 100% / 2px .85em,
          linear-gradient(var(--gold), var(--gold)) 100% 100% / .85em 2px,
          linear-gradient(var(--gold), var(--gold)) 100% 100% / 2px .85em;
        background-repeat: no-repeat; opacity: .7;
      }
      @keyframes dsp-rise {
        from { opacity: 0; transform: translateY(1.5rem); }
        to   { opacity: 1; transform: none; }
      }

      /* ── Side column: timer and turn order ───────────────────────────── */
      .dsp-side {
        position: relative; z-index: 1;
        display: flex; flex-direction: column; gap: 1.25rem;
        padding: 1.75rem;
        min-height: 0;
      }
      body:not([data-scene="none"]) .dsp-side { position: absolute; top: 0; right: 0; bottom: 0; width: var(--side-w); box-sizing: border-box; }
      body:not([data-scene="none"]) .dsp-side .t-panel {
        background-color: rgba(20, 15, 10, .72);
        backdrop-filter: blur(14px) saturate(1.1);
        -webkit-backdrop-filter: blur(14px) saturate(1.1);
      }
      body[data-scene="none"] .dsp-side {
        padding: 2.5rem; width: min(100%, 64rem); justify-self: center;
        background: none;
      }
      body[data-scene="none"] .dsp-side .t-panel { background-color: rgba(20, 15, 10, .78); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
      body[data-scene="none"] .dsp-side:has(.dsp-turns[hidden]) { justify-content: center; }

      .dsp-timer { padding: 1.4rem 1.6rem 1.2rem; text-align: center; flex: none; }
      .dsp-timer-time {
        font-family: var(--font-display); font-weight: 700; font-size: 5.4rem; line-height: 1;
        font-variant-numeric: lining-nums tabular-nums; color: var(--text-strong);
        transition: color .4s ease;
      }
      /* Timer on its own: big, in the middle of the screen */
      body[data-scene="none"] .dsp-side:has(.dsp-turns[hidden]) .dsp-timer-time { font-size: min(13rem, 24vw, 40vh); }
      body[data-scene="none"] .dsp-side:has(.dsp-turns[hidden]) .dsp-timer { padding: 3rem 4rem 2.5rem; }
      .dsp-timer-bar { height: 3px; margin: 1rem 0 .7rem; background: var(--border-gold); overflow: hidden; }
      .dsp-timer-bar span { display: block; height: 100%; width: 100%; background: var(--gold); transform-origin: left; transition: transform .3s linear, background .4s ease; }
      .dsp-timer-status { margin: 0; font-size: 1rem; color: var(--text-muted); }
      .dsp-timer[data-state="low"] .dsp-timer-time { color: #f0b056; }
      .dsp-timer[data-state="low"] .dsp-timer-bar span { background: var(--foe); }
      .dsp-timer[data-state="done"] .dsp-timer-time { color: var(--foe); animation: dsp-pulse 1.1s ease-in-out infinite; }
      .dsp-timer[data-state="done"] .dsp-timer-status { color: var(--foe); font-weight: 600; }
      @keyframes dsp-pulse { 50% { opacity: .45; } }

      .dsp-side > [hidden] { display: none; }
      /* As tall as its rows (a long list shrinks it to the screen and fitLedger takes over) */
      .dsp-turns { flex: 0 1 auto; min-height: 0; display: flex; flex-direction: column; padding: 1.4rem 0 .6rem; }
      .dsp-turns-head { display: flex; align-items: baseline; justify-content: space-between; padding: 0 1.6rem; }
      .dsp-turns-title { margin: 0; font-family: var(--font-display); font-style: italic; font-weight: 600; font-size: 1.6rem; color: var(--gold); }
      .dsp-round { margin: 0; font-size: 1rem; color: var(--text-muted); }
      .dsp-round b { font-family: var(--font-display); font-weight: 700; font-size: 2rem; color: var(--text-strong); margin-left: .3rem; }

      /* Whose turn: the one big moment of the screen */
      .dsp-now {
        position: relative; overflow: hidden;
        margin: 1rem 0 .75rem; padding: 1.1rem 1.6rem 1.2rem;
        background:
          radial-gradient(ellipse 90% 140% at 0% 100%, rgba(201, 144, 50, .28), transparent 65%),
          linear-gradient(to right, rgba(201, 144, 50, .14), rgba(201, 144, 50, .02));
        border-top: 1px solid var(--border-gold);
        border-bottom: 1px solid var(--border-gold);
      }
      .dsp-now::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--gold); box-shadow: 0 0 1.2rem rgba(201, 144, 50, .9); }
      .dsp-now[hidden] { display: none; }
      .dsp-now-sparks { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: .75; }
      .dsp-now > p { position: relative; }
      .dsp-now-label { margin: 0; font-size: .95rem; color: var(--gold); }
      .dsp-now-name {
        margin: .1rem 0 .35rem; font-family: var(--font-display); font-style: italic; font-weight: 700;
        font-size: 3.3rem; line-height: 1; color: var(--text-strong);
        text-shadow: 0 0 2rem rgba(201, 144, 50, .45);
        overflow-wrap: anywhere;
      }
      .dsp-now-name.is-new { animation: dsp-enter .7s var(--ease) both; }
      @keyframes dsp-enter { from { opacity: 0; transform: translateX(-1rem); filter: blur(4px); } to { opacity: 1; transform: none; filter: none; } }
      .dsp-now-next { margin: 0; font-size: 1rem; color: var(--text-muted); }
      .dsp-now-next b { color: var(--text-body); font-weight: 500; }
      .dsp-now[data-paused] .dsp-now-name { color: var(--text-muted); text-shadow: none; }

      .dsp-ledger { list-style: none; margin: 0; padding: 0 .9rem 0 1rem; overflow-y: auto; scrollbar-width: none; flex: 1; min-height: 0; }
      .dsp-ledger::-webkit-scrollbar { display: none; }
      .dsp-row {
        font-size: calc(1rem * var(--fit, 1));
        display: grid; grid-template-columns: 3.2em minmax(0, 1fr) auto; align-items: center; gap: .9em;
        padding: .55em .7em .55em .6em;
        border-left: 3px solid var(--kind, var(--neutral));
        transition: background .4s ease, opacity .4s ease;
      }
      .dsp-row + .dsp-row { margin-top: .3em; }
      .dsp-row[data-type="character"] { --kind: var(--party); }
      .dsp-row[data-type="npc"] { --kind: var(--ally); }
      .dsp-row[data-type="monster"] { --kind: var(--foe); }
      .dsp-row-init {
        font-family: var(--font-display); font-weight: 700; font-size: 2em; line-height: 1;
        font-variant-numeric: lining-nums; text-align: center; color: var(--gold);
      }
      .dsp-row-who { min-width: 0; }
      .dsp-row-name { display: block; font-size: 1.25em; font-weight: 500; color: var(--text-strong); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      /* Conditions (set by the DM in the tracker's side panel) */
      .dsp-conds { display: flex; flex-wrap: wrap; gap: .3em; margin: .2em 0 0; }
      .dsp-conds:empty { display: none; }
      .dsp-cond { font-size: .72em; line-height: 1.5; padding: 0 .5em; color: var(--gold); border: 1px solid var(--border-gold); background: rgba(12, 9, 6, .45); }
      /* Spells/effects and the DM's own tags in violet, official conditions in gold */
      .dsp-cond.is-effect, .dsp-cond.is-custom { color: #e2d3ff; border-color: #8b6cc4; background: rgba(60, 38, 98, .55); }
      .dsp-now-conds { position: relative; margin: 0 0 .45rem; font-size: 1.05rem; }
      .dsp-row.is-current { background: linear-gradient(to right, rgba(201, 144, 50, .2), rgba(201, 144, 50, .03)); }
      .dsp-row.is-current .dsp-row-name { color: #fff3dc; }
      .dsp-row.is-past { opacity: .62; }
      .dsp-row[data-health="dead"] { opacity: .4; }
      .dsp-row[data-health="dead"] .dsp-row-name { text-decoration: line-through; text-decoration-color: rgba(242, 232, 213, .5); }

      .dsp-health {
        font-size: .85em; font-weight: 600; padding: .2em .6em; color: #fff7e6; white-space: nowrap;
        background: var(--h, #3a3128);
      }
      .dsp-health[data-h="healthy"] { --h: #4d7a3c; }
      .dsp-health[data-h="injured"] { --h: #8a6d1d; }
      .dsp-health[data-h="hurt"] { --h: #a4561e; }
      .dsp-health[data-h="bloodied"] { --h: #a82e24; }
      .dsp-health[data-h="unconscious"] { --h: #5b1712; box-shadow: inset 0 0 0 1px #d0573a; animation: dsp-pulse 2s ease-in-out infinite; }
      .dsp-health[data-h="stable"] { --h: #3b4a5c; }
      .dsp-health[data-h="dead"] { --h: #1e1914; color: var(--text-muted); }

      .dsp-empty { padding: 2rem 1.6rem; color: var(--text-muted); font-size: 1.1rem; }

      /* ── Status bits ───────────────────────────────────────────────── */
      .dsp-conn, .dsp-hint {
        position: fixed; z-index: 10; margin: 0;
        font-size: .85rem; padding: .45rem .9rem;
        background: rgba(12, 9, 6, .85); border: 1px solid var(--border-gold);
        transition: opacity .6s ease;
      }
      .dsp-conn { top: 1rem; left: 50%; transform: translateX(-50%); color: #f0b056; opacity: 0; pointer-events: none; }
      body.is-offline .dsp-conn { opacity: 1; }
      .dsp-hint { right: 1rem; bottom: 1rem; color: var(--text-muted); opacity: 0; pointer-events: none; }
      .dsp-hint.is-shown { opacity: 1; }

      /* ── Short landscape screens (phone on its side, small laptop) ─────── */
      @media (max-height: 600px) and (min-aspect-ratio: 1/1) {
        .dsp-side { gap: .6rem; padding: .75rem; }
        body[data-scene="none"] .dsp-side { padding: .75rem; }
        .dsp-timer { padding: .5rem 1rem .5rem; }
        .dsp-timer-time { font-size: 3rem; }
        .dsp-timer-bar { margin: .4rem 0 .3rem; }
        .dsp-timer-status:empty { display: none; }
        .dsp-turns { padding: .6rem 0 .3rem; }
        .dsp-turns-title { font-size: 1.2rem; }
        .dsp-round b { font-size: 1.5rem; }
        .dsp-now { margin: .4rem 0; padding: .5rem 1rem .6rem; }
        .dsp-now-name { font-size: 2rem; }
        .dsp-loc-caption { left: 1.25rem; right: 1.25rem; bottom: 1rem; }
        body[data-cast="1"] .dsp-loc-caption { top: 1rem; }
        .dsp-loc-name, body[data-side="1"] .dsp-loc-name { font-size: 2.2rem; }
        body[data-location="1"] .dsp-cast { left: 1rem; right: 1rem; bottom: 1rem; }
        body[data-location="0"] .dsp-cast { inset: 1rem; }
        body[data-side="1"] .dsp-cast, body[data-side="1"] .dsp-loc-caption { right: calc(var(--side-w) + .75rem); }
        .dsp-idle-title, .dsp-start-title { font-size: 2.4rem; }
      }

      /* ── Portrait screens (phones, tablets upright): one column, page scrolls.
            Whose turn it is comes first; the scene follows. ─────────────────── */
      @media (max-aspect-ratio: 1/1), (max-width: 640px) {
        html:has(body.dsp) { font-size: clamp(15px, 2.3vw, 26px); }
        body.dsp { overflow-y: auto; }
        .dsp-stage { position: absolute; min-height: 100dvh; display: flex; flex-direction: column; }
        .dsp-scene { position: relative; inset: auto; flex: none; height: 46vh; min-height: 15rem; }
        /* Nothing else to show: the scene gets the whole screen */
        body[data-side="0"] .dsp-scene { height: 100dvh; }
        /* With portraits the scene grows with them (the page scrolls) instead of squeezing them */
        body[data-cast="1"] .dsp-scene { height: auto; }
        body:not([data-scene="none"]) .dsp-side { position: relative; inset: auto; width: auto; }
        body[data-side="1"] .dsp-location::after { display: none; }
        body[data-side="1"] .dsp-loc-caption { right: 1rem; }
        body[data-location="0"] .dsp-scene { min-height: 0; }
        /* Portraits in the page flow; over a location they start below the place name */
        body[data-cast="1"] .dsp-cast, body[data-side="1"] .dsp-cast {
          position: relative; inset: auto; margin: 0 auto;
          padding: var(--cast-top, 1rem) 1rem 1rem; box-sizing: content-box;
          width: var(--cast-w, calc(100% - 2rem));
        }
        body[data-location="1"] .dsp-scene { min-height: 46vh; }
        body[data-location="1"] .dsp-cast { min-height: calc(46vh - var(--cast-top, 1rem) - 1rem); }
        body[data-location="0"] .dsp-cast { min-height: calc(62vh - 2rem); }
        body[data-location="0"][data-side="0"] .dsp-cast { min-height: calc(100dvh - 2rem); }
        body[data-turns="1"] .dsp-side { order: -1; }
        body[data-scene="none"] .dsp-side, .dsp-side { padding: 1rem; width: auto; flex: none; }
        body[data-scene="none"] .dsp-side:has(.dsp-turns[hidden]) { flex: 1; }
        .dsp-turns { flex: none; }
        .dsp-ledger { overflow: visible; flex: none; }
        .dsp-timer-time { font-size: min(5.4rem, 20vw); }
        .dsp-now-name { font-size: min(3.3rem, 11vw); }
        .dsp-loc-caption { left: 1.25rem; right: 1.25rem; bottom: 1.25rem; }
        body[data-cast="1"] .dsp-loc-caption { top: 1.25rem; }
        .dsp-idle-title, .dsp-start-title { font-size: min(4.2rem, 11vw); }
      }

      /* Touch screens have no F key */
      @media (pointer: coarse) { .dsp-hint { display: none; } }

      @media (prefers-reduced-motion: reduce) {
        .dsp-loc-layer img, .dsp-portrait, .dsp-cast > li, .dsp-now-name.is-new, .dsp-health, .dsp-timer-time { animation: none !important; }
        .dsp-cast > li, .dsp-loc-caption { transition: none !important; }
        .dsp-start > *, .dsp-start-title, .dsp-backdrop img, .dsp-start-image img { animation: none !important; }
      }
    </style>

    <script>
      import { startSparks } from '../lib/sparks';
      import { tagKind } from '../lib/conditions';

      type Health = 'healthy' | 'injured' | 'hurt' | 'bloodied' | 'unconscious' | 'dead' | null;
      interface DisplayState {
        screenVisible: boolean;
        mode?: 'off' | 'start' | 'live' | 'pause';
        nextSession?: { date: string; time: string } | null;
        startScreen?: {
          title: string; session: number | null; date: string; recap: string; showRecap: boolean;
          lastSession?: { session: number; title: string; excerpt: string; imageUrl: string | null } | null;
        } | null;
        wallpaperUrl: string | null;
        backdropUrl: string | null;
        location: { name: string; type: string; region: string | null; imageUrl: string | null } | null;
        npcs: { id: string; name: string; subtitle: string; avatarUrl: string | null }[];
        initiative: null | {
          status: 'active' | 'paused' | 'stopped';
          round: number;
          entries: { id: string; name: string; initiative: number; type: string; health: Health; isStable: boolean; isCurrent: boolean; conditions?: string[] }[];
        };
        timer: null | { status: 'running' | 'paused' | 'stopped'; duration: number; startedAt: number | null; pausedAt: number | null };
      }

      const POLL_MS = 2000;
      const MAX_BACKOFF_MS = 30000;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // /display?preview: the DM screen's thumbnail (no sparks, wake lock, full screen, cursor hiding)
      const preview = new URLSearchParams(location.search).has('preview');
      const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
      const body = document.body;

      let state: DisplayState | null = null;
      let etag: string | null = null;
      let clockOffset = 0; // server time − local time
      let failures = 0;

      const HEALTH_LABEL: Record<string, string> = {
        healthy: 'Healthy', injured: 'Injured', hurt: 'Hurt', bloodied: 'Bloodied',
        unconscious: 'Unconscious', stable: 'Stable', dead: 'Dead',
      };
      const PLACE_LABEL: Record<string, string> = {
        city: 'City', dungeon: 'Dungeon', wilderness: 'Wilderness', building: 'Building', other: '',
      };

      // ── Sparks: only run where they are visible ─────────────────────────
      const sparks = new Map<HTMLCanvasElement, () => void>();
      function setSparks(canvas: HTMLCanvasElement, on: boolean) {
        if (reduceMotion || preview) return;
        if (on && !sparks.has(canvas)) sparks.set(canvas, startSparks(canvas));
        if (!on && sparks.has(canvas)) { sparks.get(canvas)!(); sparks.delete(canvas); }
      }

      // ── Modes ──────────────────────────────────────────────────────────
      function showIdle(title: string, text: string) {
        body.dataset.mode = 'idle';
        $('idleTitle').textContent = title;
        $('idleText').textContent = text;
        setSparks($<HTMLCanvasElement>('idleSparks'), true);
        setSparks($<HTMLCanvasElement>('nowSparks'), false);
      }

      function setBackdrop(url: string | null) {
        const img = $<HTMLImageElement>('backdropImg');
        if (url && img.getAttribute('src') !== url) img.src = url;
        img.hidden = !url;
      }

      function showStart(st: NonNullable<DisplayState['startScreen']>) {
        body.dataset.mode = 'start';
        $('startTitle').textContent = st.title;
        const session = $('startSession');
        session.hidden = st.session == null;
        session.textContent = st.session == null ? '' : `Session ${st.session}`;
        // The ISO date is a calendar day, not an instant: parse it as local time
        const [y, m, d] = st.date.split('-').map(Number);
        $('startDate').textContent = new Date(y, m - 1, d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
        // "Title + last session": that diary entry instead of the typed recap, its picture behind
        const last = st.lastSession ?? null;
        const recap = $('startRecap');
        recap.hidden = last ? false : !(st.showRecap && st.recap);
        const entry = $('startRecapEntry');
        entry.hidden = !last;
        entry.textContent = last ? `Session ${last.session} · ${last.title}` : '';
        $('startRecapText').textContent = last ? last.excerpt : st.recap; // text only, never HTML
        const image = $<HTMLImageElement>('startImage');
        if (!last?.imageUrl) {
          image.onload = null; // a picture still loading for an earlier entry
          delete body.dataset.startImage;
        } else if (image.getAttribute('src') !== last.imageUrl) {
          delete body.dataset.startImage; // fade in once loaded, not half drawn
          image.onload = () => { body.dataset.startImage = '1'; };
          image.src = last.imageUrl;
        } else if (image.complete) {
          body.dataset.startImage = '1';
        }
        setSparks($<HTMLCanvasElement>('idleSparks'), true);
        setSparks($<HTMLCanvasElement>('nowSparks'), false);
      }

      function showOff(next: DisplayState['nextSession']) {
        body.dataset.mode = 'off';
        const line = $('offNext');
        line.hidden = !next;
        if (next) {
          // Calendar day and wall-clock time: parse as local time, like the start screen's date
          const [y, m, d] = next.date.split('-').map(Number);
          const day = new Date(y, m - 1, d);
          const weekday = day.toLocaleDateString('en-GB', { weekday: 'long' });
          const date = day.toLocaleDateString('en-GB', { day: 'numeric', month: 'long' });
          line.textContent = `Next session: ${weekday}, ${date} · ${next.time}`; // Friday, 23 October · 19:00
        }
        setSparks($<HTMLCanvasElement>('idleSparks'), true);
        setSparks($<HTMLCanvasElement>('nowSparks'), false);
      }

      function render(s: DisplayState) {
        setBackdrop(s.backdropUrl);

        const fallback = s.screenVisible === false ? 'pause' : 'live';
        const mode = s.mode === 'start' && !s.startScreen ? fallback : (s.mode ?? fallback);
        if (mode === 'start' && s.startScreen) {
          showStart(s.startScreen);
          return;
        }
        if (mode === 'off') {
          showOff(s.nextSession ?? null);
          return;
        }

        if (mode === 'pause') {
          if (s.wallpaperUrl) {
            const img = $<HTMLImageElement>('wallpaperImg');
            if (img.getAttribute('src') !== s.wallpaperUrl) img.src = s.wallpaperUrl;
            body.dataset.mode = 'wallpaper';
            setSparks($<HTMLCanvasElement>('idleSparks'), false);
            setSparks($<HTMLCanvasElement>('nowSparks'), false);
          } else {
            showIdle('Short break', 'The DM has paused the screen. Back in a moment.');
          }
          return;
        }

        const hasLocation = !!s.location;
        const before = snapshot();
        const cast = renderCast(s.npcs);
        // Keep the cast area while removed portraits are still fading out
        const hasCast = s.npcs.length > 0 || cast.leaving.length > 0 || !!$('cast').querySelector('.is-leaving');
        const hasSide = !!(s.initiative || s.timer);
        if (!hasLocation && !hasCast && !hasSide) {
          showIdle('Waiting for the DM', 'Scenes, characters and the turn order appear here when the DM shares them.');
          return;
        }

        body.dataset.mode = 'stage';
        body.dataset.scene = hasLocation ? 'location' : hasCast ? 'cast' : 'none';
        body.dataset.location = hasLocation ? '1' : '0';
        body.dataset.cast = hasCast ? '1' : '0';
        body.dataset.side = hasSide ? '1' : '0';
        body.dataset.turns = s.initiative ? '1' : '0';
        setSparks($<HTMLCanvasElement>('idleSparks'), false);

        renderLocation(s.location);
        renderTurns(s.initiative);
        renderTimer();
        fitLayout();
        play(before, cast);
      }

      // ── Fit to the screen (any size, from phone to 32:9) ──────────────────
      // Portraits: the largest size at which all of them fit their box, in one row or several,
      // with the gap growing along. Over a location they prefer the lower half of the scene, so
      // the picture stays visible, and only add rows upward towards the place name when they
      // would otherwise get smaller than LOC_MIN. On upright screens the scene grows with them
      // (the page scrolls) rather than shrinking them below a readable size.
      const GAP = 0.06;      // gap between portraits, relative to their height
      const LOC_BAND = 0.48; // over a location: preferred share of the scene's height
      const LOC_MAX = 0.44;  // ...largest portrait
      const LOC_MIN = 0.22;  // ...smallest portrait before they take more room
      const flowQuery = window.matchMedia('(max-aspect-ratio: 1/1), (max-width: 640px)');

      // Largest portrait height for n portraits in width × height
      function fitPortraits(n: number, width: number, height: number) {
        let best = 0;
        for (let rows = 1; rows <= n; rows++) {
          const cols = Math.ceil(n / rows);
          best = Math.max(best, Math.min(height / (rows + GAP * (rows - 1)), width / (0.75 * cols + GAP * (cols - 1))));
        }
        return best;
      }

      function layoutCast() {
        const cast = $('cast');
        const n = castItems.size; // not counting portraits that are fading out
        if (!n || body.dataset.cast !== '1') return;
        const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
        const flow = flowQuery.matches;
        const overLocation = body.dataset.location === '1';
        const sceneH = flow ? window.innerHeight : $('scene').clientHeight;
        const cap = $('locCaption');
        const below = overLocation ? cap.offsetTop + cap.offsetHeight + 1.25 * rem : 0;

        // The room: measured with the block at its full width
        if (flow) cast.style.setProperty('--cast-top', `${overLocation ? Math.round(below) : rem}px`);
        cast.style.removeProperty('--cast-w');
        const css = getComputedStyle(cast);
        const width = cast.clientWidth - parseFloat(css.paddingLeft) - parseFloat(css.paddingRight) - 1;
        if (width <= 0) return;

        let ph: number;
        if (flow) {
          const pref = (overLocation ? 0.42 : body.dataset.side === '1' ? 0.62 : 1) * sceneH - 2 * rem;
          const min = Math.max(6 * rem, width * 0.28) / 0.75;
          ph = Math.min(fitPortraits(n, width, pref), overLocation ? sceneH * LOC_MAX : Infinity);
          if (ph < min) ph = Math.min(min, width / 0.75);
        } else if (overLocation) {
          const room = $('scene').clientHeight - parseFloat(css.bottom) - below; // up to the place name
          ph = Math.min(fitPortraits(n, width, Math.min(room, sceneH * LOC_BAND)), sceneH * LOC_MAX);
          if (ph < sceneH * LOC_MIN) ph = Math.min(sceneH * LOC_MIN, fitPortraits(n, width, room));
        } else {
          const height = cast.clientHeight - parseFloat(css.paddingTop) - parseFloat(css.paddingBottom) - 1;
          if (height <= 0) return;
          ph = fitPortraits(n, width, height);
        }
        ph = Math.max(1, Math.floor(ph));
        const gap = Math.floor(ph * GAP);
        const w = ph * 0.75;
        // Balanced rows: as few columns as the row count allows (16 → 6·5·5 rather than 7·7·2)
        let cols = Math.max(1, Math.min(n, Math.floor((width + gap + 0.5) / (w + gap))));
        cols = Math.ceil(n / Math.ceil(n / cols));
        cast.style.setProperty('--ph', `${ph}px`);
        cast.style.setProperty('--gap', `${gap}px`);
        cast.style.setProperty('--cast-w', `${Math.ceil(cols * w + (cols - 1) * gap) + 1}px`);
        cast.toggleAttribute('data-compact', ph < 14 * rem);
        fitNames();
      }

      // A name with a word too long for its portrait is set smaller (down to 60 %) rather than
      // broken in the middle of the word; only beyond that does it break.
      function fitNames() {
        $('cast').querySelectorAll<HTMLElement>('li:not(.is-leaving) .dsp-portrait-name').forEach((el) => {
          el.style.fontSize = '';
          el.style.overflowWrap = 'normal';
          for (let k = 0.92; el.scrollWidth > el.clientWidth + 1 && k > 0.55; k -= 0.08) el.style.fontSize = `${(1.7 * k).toFixed(2)}em`;
          el.style.overflowWrap = '';
        });
      }

      // Turn order: shrink the rows until every combatant fits (down to 60 %), then scroll.
      function fitLedger() {
        const ledger = $('ledger');
        if ($('turns').hidden) return;
        let fit = 1;
        ledger.style.setProperty('--fit', '1');
        while (ledger.scrollHeight > ledger.clientHeight + 1 && fit > 0.6) {
          fit -= 0.05;
          ledger.style.setProperty('--fit', fit.toFixed(2));
        }
        ledger.querySelector('.is-current')?.scrollIntoView({ block: 'nearest' });
      }

      // Location: fills the screen (cover) on landscape screens. In the stacked layout of upright
      // screens (phones, tablets) the frame is a short strip, so the whole picture is shown over a
      // blurred copy of itself instead of cropping most of it away.
      function fitLocation() {
        $('location').dataset.fit = flowQuery.matches ? 'contain' : 'cover';
      }

      function fitLayout() {
        layoutCast();
        fitLedger();
        fitLocation();
      }
      let fitFrame = 0;
      new ResizeObserver(() => {
        cancelAnimationFrame(fitFrame);
        fitFrame = requestAnimationFrame(fitLayout);
      }).observe(document.documentElement);

      // ── Location: crossfade to the new picture once it has loaded ─────
      let locationKey = '';
      function renderLocation(loc: DisplayState['location']) {
        const key = loc ? `${loc.name}|${loc.imageUrl ?? ''}|${loc.type}` : '';
        if (key === locationKey) return;
        locationKey = key;
        if (!loc) return;

        $('locName').textContent = loc.name;
        $('locKind').textContent = [PLACE_LABEL[loc.type] ?? loc.type, loc.region].filter(Boolean).join(' in ');

        const layers = $('locLayers');
        const layer = document.createElement('div');
        layer.className = 'dsp-loc-layer';
        const reveal = () => {
          layers.appendChild(layer);
          requestAnimationFrame(() => requestAnimationFrame(() => layer.classList.add('is-in')));
          // Drop the previous picture after the crossfade
          setTimeout(() => { while (layers.firstChild && layers.firstChild !== layer) layers.firstChild.remove(); }, 1600);
        };
        if (loc.imageUrl) {
          const fill = new Image();
          fill.alt = '';
          fill.className = 'dsp-loc-fill';
          fill.decoding = 'async';
          fill.src = loc.imageUrl;
          const img = new Image();
          img.alt = '';
          img.className = 'dsp-loc-img';
          img.decoding = 'async';
          img.src = loc.imageUrl;
          layer.append(fill, img);
          // Decoded before it is shown, so a large picture does not stall portraits on the move
          Promise.allSettled([img.decode(), fill.decode()]).then(() => { if (locationKey === key) { reveal(); fitLocation(); } });
        } else {
          layer.classList.add('is-painted', `place-bg-${loc.type}`);
          reveal();
        }
      }

      // ── Gliding between layouts (FLIP) ──────────────────────────────────
      // Any change can move the portraits and the place name: NPCs joining or leaving, the
      // location, timer or turn order appearing or going. render() notes where everything is on
      // screen first (snapshot), lays out the new state, then starts each element from its old
      // spot and lets it glide to the new one (play). Leaving portraits fade out where they
      // stood, the others move once they have started to go, new ones rise in last.
      function snapshot() {
        const rects = new Map<HTMLElement, DOMRect>();
        castItems.forEach((li) => rects.set(li, li.getBoundingClientRect()));
        const cap = $('locCaption');
        rects.set(cap, cap.getBoundingClientRect());
        return rects;
      }

      function glide(el: HTMLElement, from: DOMRect | undefined, delay: number, scaled: boolean): boolean {
        // Measure the new spot without a transform left over from an unfinished glide
        el.style.transition = 'none';
        el.style.transform = '';
        const to = el.getBoundingClientRect();
        if (reduceMotion || !from?.width || !to.width) return false;
        const dx = from.left - to.left, dy = from.top - to.top, scale = scaled ? from.height / to.height : 1;
        if (Math.abs(dx) < 1 && Math.abs(dy) < 1 && Math.abs(scale - 1) < 0.01) return false;
        el.style.transformOrigin = '0 0';
        el.style.transform = `translate(${dx}px, ${dy}px)${scaled ? ` scale(${scale})` : ''}`;
        void el.offsetWidth;
        // Longer ways take a little longer, so nothing races across the screen
        const ms = Math.round(Math.min(950, 550 + Math.hypot(dx, dy) * 0.4));
        el.style.transition = `transform ${ms}ms var(--ease-move) ${delay}ms`;
        el.style.transform = '';
        return true;
      }
      // A finished glide leaves no inline transition behind (a later layout change must not animate by itself)
      for (const el of [$('cast'), $('locCaption')]) {
        el.addEventListener('transitionend', (e) => {
          const t = e.target as HTMLElement;
          if (e.propertyName === 'transform' && !t.style.transform && !t.classList.contains('is-leaving')) {
            t.style.transition = '';
            t.style.transformOrigin = '';
          }
        });
      }

      function play(before: Map<HTMLElement, DOMRect>, { leaving, entering }: CastChange) {
        const cast = $('cast');
        const castRect = cast.getBoundingClientRect();
        leaving.forEach((li) => {
          const r = before.get(li)!;
          Object.assign(li.style, { left: `${r.left - castRect.left - cast.clientLeft}px`, top: `${r.top - castRect.top - cast.clientTop}px` });
          void li.offsetWidth;
          li.classList.add('is-leaving');
        });
        const delay = leaving.length ? 120 : 0;
        let moved = false;
        castItems.forEach((li) => { if (!entering.includes(li)) moved = glide(li, before.get(li), delay, true) || moved; });
        // Scaled too: the place name is set smaller while the side panel is shown
        glide($('locCaption'), before.get($('locCaption')), delay, true);
        if (moved || leaving.length) entering.forEach((li) => li.style.setProperty('--enter-delay', `${delay + 280}ms`));
      }

      // ── NPC portraits ─────────────────────────────────────────────────
      // Portraits are keyed by NPC, so the ones that stay keep their element (and can glide).
      let castKey = '';
      const castItems = new Map<string, HTMLLIElement>();
      interface CastChange { leaving: HTMLLIElement[]; entering: HTMLLIElement[] }

      function buildPortrait(npc: DisplayState['npcs'][number]): HTMLLIElement {
        const li = document.createElement('li');
        li.dataset.sig = `${npc.name}|${npc.avatarUrl ?? ''}|${npc.subtitle}`;
        const fig = document.createElement('figure');
        fig.className = 'dsp-portrait';
        if (npc.avatarUrl) {
          const img = document.createElement('img');
          img.src = npc.avatarUrl;
          img.alt = '';
          fig.appendChild(img);
        } else {
          const mono = document.createElement('div');
          mono.className = 'dsp-portrait-mono';
          mono.textContent = npc.name.trim().charAt(0).toUpperCase();
          fig.appendChild(mono);
        }
        const cap = document.createElement('figcaption');
        const name = document.createElement('p');
        name.className = 'dsp-portrait-name';
        name.textContent = npc.name;
        cap.appendChild(name);
        if (npc.subtitle) {
          const role = document.createElement('p');
          role.className = 'dsp-portrait-role';
          role.textContent = npc.subtitle;
          cap.appendChild(role);
        }
        fig.appendChild(cap);
        li.appendChild(fig);
        return li;
      }

      // Brings the portraits in line with the spotlight. Leaving ones are taken out of the flow
      // right away (so the new layout is measured without them) and placed by play().
      function renderCast(npcs: DisplayState['npcs']): CastChange {
        const change: CastChange = { leaving: [], entering: [] };
        const key = npcs.map((n) => `${n.id}|${n.avatarUrl ?? ''}|${n.name}|${n.subtitle}`).join(',');
        if (key === castKey) return change;
        castKey = key;
        const cast = $('cast');

        const wanted = new Set(npcs.map((n) => n.id));
        castItems.forEach((li, id) => {
          if (wanted.has(id)) return;
          castItems.delete(id);
          const r = li.getBoundingClientRect();
          if (reduceMotion || !r.width) { li.remove(); return; }
          // Freeze it at its current (possibly mid-glide) size, out of the flow
          Object.assign(li.style, { transition: '', transform: '', transformOrigin: '', position: 'absolute' });
          li.style.setProperty('--ph', `${r.height}px`);
          li.classList.remove('is-entering');
          change.leaving.push(li);
          // Gone once faded out (or after a while, if the fade never runs, e.g. off screen)
          let done = false;
          const remove = () => {
            if (done) return;
            done = true;
            li.remove();
            // The cast area was kept while they faded; let the layout settle without them
            if (state && !cast.querySelector('.is-leaving')) render(state);
          };
          li.addEventListener('transitionend', (e) => { if (e.target === li && e.propertyName === 'opacity') remove(); });
          setTimeout(remove, 1500);
        });

        let prev: HTMLLIElement | null = null;
        for (const npc of npcs) {
          let li = castItems.get(npc.id);
          const sig = `${npc.name}|${npc.avatarUrl ?? ''}|${npc.subtitle}`;
          if (li && li.dataset.sig !== sig) {
            const fresh = buildPortrait(npc);
            li.replaceWith(fresh);
            li = fresh;
            castItems.set(npc.id, li);
          }
          if (!li) {
            li = buildPortrait(npc);
            li.classList.add('is-entering');
            li.style.setProperty('--i', String(change.entering.length));
            change.entering.push(li);
            li.addEventListener('animationend', () => li!.classList.remove('is-entering'), { once: true });
            castItems.set(npc.id, li);
          }
          const target: ChildNode | null = prev ? prev.nextSibling : cast.firstChild;
          if (target !== li) cast.insertBefore(li, target);
          prev = li;
        }
        return change;
      }

      // ── Turn order ────────────────────────────────────────────────────
      let currentId: string | null = null;
      function renderTurns(ini: DisplayState['initiative']) {
        const turns = $('turns');
        turns.hidden = !ini;
        if (!ini) { setSparks($<HTMLCanvasElement>('nowSparks'), false); currentId = null; return; }

        $('round').textContent = String(ini.round);

        const entries = ini.entries;
        const curIndex = entries.findIndex((e) => e.isCurrent);
        const cur = entries[curIndex];
        const now = $('now');
        now.hidden = !cur;
        if (cur) {
          const nameEl = $('nowName');
          if (cur.id !== currentId) {
            nameEl.textContent = cur.name;
            nameEl.classList.remove('is-new');
            void nameEl.offsetWidth; // restart the entrance animation
            nameEl.classList.add('is-new');
          }
          now.toggleAttribute('data-paused', ini.status !== 'active');
          renderConditions($('nowConds'), cur.conditions);
          $('nowLabel').textContent = { active: 'Now acting', paused: 'Combat paused', stopped: 'Combat stopped' }[ini.status] ?? 'Now acting';
          // Next living combatant
          const next = [...entries.slice(curIndex + 1), ...entries.slice(0, curIndex)].find((e) => e.health !== 'dead');
          const nextEl = $('nowNext');
          nextEl.replaceChildren();
          if (next && next.id !== cur.id) {
            nextEl.append('Up next: ');
            const b = document.createElement('b');
            b.textContent = next.name;
            nextEl.appendChild(b);
          }
        }
        currentId = cur?.id ?? null;
        setSparks($<HTMLCanvasElement>('nowSparks'), !!cur && ini.status === 'active');

        const ledger = $('ledger');
        ledger.replaceChildren();
        if (entries.length === 0) {
          const p = document.createElement('li');
          p.className = 'dsp-empty';
          p.textContent = 'No one has rolled initiative yet.';
          ledger.appendChild(p);
          return;
        }
        entries.forEach((e, i) => {
          const li = document.createElement('li');
          li.className = 'dsp-row';
          li.dataset.type = e.type;
          if (e.health) li.dataset.health = e.health;
          if (e.isCurrent) { li.classList.add('is-current'); li.setAttribute('aria-current', 'true'); }
          else if (curIndex >= 0 && i < curIndex) li.classList.add('is-past');

          const init = document.createElement('span');
          init.className = 'dsp-row-init';
          init.textContent = String(e.initiative);
          const who = document.createElement('div');
          who.className = 'dsp-row-who';
          const name = document.createElement('span');
          name.className = 'dsp-row-name';
          name.textContent = e.name;
          const conds = document.createElement('p');
          conds.className = 'dsp-conds';
          renderConditions(conds, e.conditions);
          who.append(name, conds);
          li.append(init, who);

          if (e.health) {
            const h = e.health === 'unconscious' && e.isStable ? 'stable' : e.health;
            const pill = document.createElement('span');
            pill.className = 'dsp-health';
            pill.dataset.h = h;
            pill.textContent = HEALTH_LABEL[h];
            li.appendChild(pill);
          }
          ledger.appendChild(li);
        });
        ledger.querySelector('.is-current')?.scrollIntoView({ block: 'nearest', behavior: reduceMotion ? 'auto' : 'smooth' });
      }

      function renderConditions(box: HTMLElement, conditions: string[] | undefined) {
        box.replaceChildren(...(conditions ?? []).map((c) => Object.assign(document.createElement('span'), { className: `dsp-cond is-${tagKind(c)}`, textContent: c })));
      }

      // ── Timer (runs on the server's clock) ────────────────────────────
      let timerTick: number | null = null;
      function remainingSeconds(t: NonNullable<DisplayState['timer']>): number {
        if (t.status === 'stopped' || !t.startedAt) return t.duration;
        const end = t.status === 'paused' && t.pausedAt ? t.pausedAt : Date.now() + clockOffset;
        return Math.max(0, t.duration - (end - t.startedAt) / 1000);
      }
      function renderTimer() {
        const t = state?.timer;
        $('timer').hidden = !t;
        if (timerTick) { clearInterval(timerTick); timerTick = null; }
        if (!t) return;
        const draw = () => {
          const left = remainingSeconds(t);
          const whole = Math.ceil(left);
          const m = Math.floor(whole / 60), sec = whole % 60;
          $('timerTime').textContent = `${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
          $('timerFill').style.transform = `scaleX(${t.duration ? left / t.duration : 0})`;
          const done = t.status === 'running' && left <= 0;
          $('timer').dataset.state = done ? 'done' : t.status === 'running' && left <= 10 ? 'low' : '';
          $('timerStatus').textContent = done ? 'Time’s up!' : t.status === 'paused' ? 'Paused' : t.status === 'running' ? '' : 'Ready';
          if (done && timerTick) { clearInterval(timerTick); timerTick = null; }
        };
        draw();
        if (t.status === 'running') timerTick = window.setInterval(draw, 250);
      }

      // ── Polling ────────────────────────────────────────────────────────
      let pollTimer: number | null = null;
      async function poll() {
        if (pollTimer) { clearTimeout(pollTimer); pollTimer = null; }
        try {
          const res = await fetch('/api/display', { cache: 'no-store', headers: etag ? { 'If-None-Match': etag } : {} });
          const serverTime = Number(res.headers.get('X-Server-Time'));
          if (serverTime) clockOffset = serverTime - Date.now();
          if (res.status !== 304) {
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            state = (await res.json()) as DisplayState;
            etag = res.headers.get('ETag');
            render(state);
          }
          failures = 0;
          body.classList.remove('is-offline');
        } catch (error) {
          failures++;
          if (failures >= 2) body.classList.add('is-offline');
          console.warn('Player display: update failed', error);
        }
        const delay = failures ? Math.min(POLL_MS * 2 ** failures, MAX_BACKOFF_MS) : POLL_MS;
        if (!document.hidden) pollTimer = window.setTimeout(poll, delay);
      }

      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) { poll(); keepAwake(); }
      });

      // ── TV conveniences: stay awake, full screen on F, hide idle cursor ──
      // Not in the DM screen's preview: that's a thumbnail, not the TV.
      let wakeLock: { release(): Promise<void> } | null = null;
      async function keepAwake() {
        if (preview) return;
        try {
          if ('wakeLock' in navigator && !wakeLock) {
            wakeLock = await (navigator as any).wakeLock.request('screen');
            (wakeLock as any).addEventListener?.('release', () => { wakeLock = null; });
          }
        } catch { /* not allowed (e.g. no user gesture yet); harmless */ }
      }
      if (!preview) {
        const toggleFullscreen = () => {
          if (document.fullscreenElement) document.exitFullscreen?.();
          else document.documentElement.requestFullscreen?.().catch(() => {});
          keepAwake();
        };
        document.addEventListener('keydown', (e) => {
          if (e.key === 'f' || e.key === 'F') toggleFullscreen();
        });
        document.addEventListener('dblclick', toggleFullscreen);

        let cursorTimer: number | undefined;
        document.addEventListener('mousemove', () => {
          body.classList.remove('cursor-idle');
          clearTimeout(cursorTimer);
          cursorTimer = window.setTimeout(() => body.classList.add('cursor-idle'), 3000);
        });

        if (!document.fullscreenElement && window.self === window.top && matchMedia('(pointer: fine)').matches) {
          const hint = $('hint');
          hint.classList.add('is-shown');
          setTimeout(() => hint.classList.remove('is-shown'), 6000);
        }
      }

      keepAwake();
      poll();
    </script>
  </body>
</html>

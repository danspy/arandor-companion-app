---
import { db, Location, NPC, InitiativeTracker, CombatState, eq } from 'astro:db';

// Player display is public - no authentication required
// This page will be displayed on a second screen for players

// We'll load initial state server-side, then poll for updates client-side
const COMBAT_STATE_ID = 'current-combat';
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Player Display - Arandor</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
    <script is:inline>
      // Initialize dark mode
      const getThemePreference = () => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored) return stored;
        } catch (e) {
          console.error('Error accessing localStorage:', e);
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      
      const theme = getThemePreference();
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
  </head>
  <body class="bg-gray-900 text-white min-h-screen md:overflow-hidden">
    <div id="displayContainer" class="w-full h-screen flex items-center justify-center">
      <!-- Mobile/Tablet Warning - Only shown on smaller screens -->
      <div id="mobileWarning" class="hidden lg:hidden w-full h-full flex items-center justify-center p-8">
        <div class="text-center max-w-2xl">
          <svg class="w-24 h-24 mx-auto mb-6 text-secondary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <h1 class="text-3xl md:text-4xl font-bold mb-4 text-gray-100">Please Use a Larger Screen</h1>
          <p class="text-lg md:text-xl text-gray-300 mb-6">
            The Player Display is designed for larger screens such as desktops, laptops, or TVs for the best D&D session experience.
          </p>
          <div class="bg-secondary-900/30 border-2 border-secondary-700 rounded-lg p-6 text-left">
            <p class="text-sm md:text-base text-gray-400 mb-3">
              <strong class="text-secondary-400">Recommended devices:</strong>
            </p>
            <ul class="text-sm md:text-base text-gray-400 space-y-2">
              <li class="flex items-center gap-2">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                Desktop computers or laptops
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                Large displays or TVs
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                Second monitors for your game sessions
              </li>
            </ul>
          </div>
        </div>
      </div>
      
      <!-- Loading state -->
      <div id="loadingState" class="text-center">
        <div class="animate-spin rounded-full h-16 w-16 border-b-2 border-primary-500 mx-auto mb-4"></div>
        <p class="text-xl text-gray-400">Connecting to DM...</p>
      </div>

      <!-- Main content container - Hidden on small screens -->
      <div id="mainContent" class="hidden lg:block w-full h-full">
        <!-- Placeholder/Hidden state -->
        <div id="placeholderState" class="hidden h-full">
          <div id="placeholderImage" class="hidden h-full">
            <img id="placeholderImg" class="w-full h-full object-cover" alt="Placeholder" />
          </div>
          <div id="defaultPlaceholder" class="flex items-center justify-center h-full bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900">
            <div class="text-center max-w-2xl px-8">
              <svg class="w-32 h-32 mx-auto mb-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
              </svg>
              <h1 class="text-5xl font-bold mb-4 text-gray-300">Session Paused</h1>
              <p class="text-2xl text-gray-400">
                The DM will resume shortly...
              </p>
            </div>
          </div>
        </div>
        
        <!-- Empty state -->
        <div id="emptyState" class="flex items-center justify-center h-full">
          <div class="text-center max-w-2xl px-8">
            <svg class="w-24 h-24 mx-auto mb-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
            <h1 class="text-4xl font-bold mb-4">Awaiting DM...</h1>
            <p class="text-xl text-gray-400">
              Your DM will control what appears on this screen during the session.
            </p>
          </div>
        </div>

        <!-- Combined display area - uses flexbox for side-by-side layout on desktop, stacks on mobile -->
        <div id="combinedDisplay" class="hidden h-full flex flex-col md:flex-row">
          <!-- Left panel (60% width when split on desktop, 100% on mobile) -->
          <div id="leftPanel" class="h-full overflow-auto">
            <!-- Location display (fullscreen when alone) -->
            <div id="locationDisplay" class="hidden h-full">
              <div class="relative h-full">
                <!-- Location image -->
                <img id="locationImage" class="w-full h-full object-cover hidden" alt="Location" />
                <!-- Placeholder when no image -->
                <div id="locationPlaceholder" class="hidden w-full h-full bg-gradient-to-br from-gray-800 via-gray-700 to-gray-800 flex items-center justify-center">
                  <svg class="w-32 h-32 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                </div>
                <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-gray-900/80"></div>
                <div class="absolute bottom-0 left-0 right-0 p-4 md:p-8">
                  <h1 id="locationName" class="text-3xl md:text-5xl lg:text-6xl font-bold mb-2"></h1>
                  <p id="locationInfo" class="text-lg md:text-2xl lg:text-3xl text-gray-300"></p>
                </div>
              </div>
            </div>

            <!-- NPCs in spotlight (fullscreen when alone) -->
            <div id="npcSpotlight" class="hidden h-full">
              <div class="h-full flex flex-col p-4 md:p-8">
                <div class="flex-1 overflow-auto">
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6" id="npcGrid">
                    <!-- NPCs will be inserted here -->
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right panel - Timer and Initiative tracker (40% width when split on desktop, 100% on mobile) -->
          <div id="rightPanel" class="h-full overflow-auto">
            <!-- Timer Display -->
            <div id="timerDisplay" class="hidden">
              <div class="flex flex-col p-4 md:p-8">
                <div class="bg-gray-800 rounded-lg shadow-2xl border-2 border-secondary-600 p-6 md:p-8">
                  <div class="flex items-center justify-center mb-4">
                    <svg class="w-8 h-8 md:w-12 md:h-12 text-secondary-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold">Timer</h2>
                  </div>
                  <div class="text-center">
                    <div id="playerTimerDisplay" class="text-6xl md:text-8xl font-bold text-secondary-400 mb-2 font-mono">
                      00:00
                    </div>
                    <div id="playerTimerStatus" class="text-lg md:text-xl text-gray-400">
                      Ready
                    </div>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Initiative Display -->
            <div id="initiativeDisplay" class="hidden h-full">
              <div class="h-full flex flex-col p-4 md:p-8">
                <div class="bg-gray-800 rounded-lg shadow-2xl border-2 border-primary-600 p-4 md:p-6 flex-1 flex flex-col">
                  <div class="flex items-center justify-between mb-4 md:mb-6 md:flex-row flex-col md:gap-0 gap-3">
                    <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold flex items-center gap-2 md:gap-3">
                      <svg class="w-6 h-6 md:w-10 md:h-10 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                      </svg>
                      Initiative
                    </h2>
                    <div class="bg-primary-600 px-3 py-1.5 md:px-4 md:py-2 rounded-lg">
                      <span class="text-xs md:text-sm font-medium">Round: </span>
                      <span id="currentRound" class="text-lg md:text-2xl font-bold">1</span>
                    </div>
                  </div>
                  <div id="initiativeList" class="flex-1 overflow-auto space-y-2 md:space-y-3">
                    <!-- Initiative entries will be inserted here -->
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Store current state
      let currentDisplayState = {
        locationId: null,
        npcIds: [],
        showInitiative: false,
        screenVisible: true,
        placeholderImageUrl: null,
        showTimer: false,
        timerDuration: 0,
        timerStartedAt: null,
        timerPausedAt: null,
        timerStatus: 'stopped',
      };

      // Data caches
      const locationsCache = new Map();
      const npcsCache = new Map();
      
      // Timer update interval
      let timerUpdateInterval = null;

      // Load reference data
      async function loadReferenceData() {
        try {
          const [locationsResponse, npcsResponse] = await Promise.all([
            fetch('/api/locations'),
            fetch('/api/npcs'),
          ]);

          if (locationsResponse.ok) {
            const locations = await locationsResponse.json();
            locations.forEach(loc => locationsCache.set(loc.id, loc));
          }

          if (npcsResponse.ok) {
            const npcs = await npcsResponse.json();
            npcs.forEach(npc => npcsCache.set(npc.id, npc));
          }
        } catch (error) {
          console.error('Error loading reference data:', error);
        }
      }
      
      // Timer utility functions
      function getRemainingTime(state) {
        if (!state.timerDuration) return 0;
        
        if (state.timerStatus === 'stopped') {
          return state.timerDuration;
        } else if (state.timerStatus === 'paused') {
          if (!state.timerPausedAt || !state.timerStartedAt) return state.timerDuration;
          const elapsed = (state.timerPausedAt - state.timerStartedAt) / 1000;
          return Math.max(0, state.timerDuration - elapsed);
        } else if (state.timerStatus === 'running') {
          if (!state.timerStartedAt) return state.timerDuration;
          const elapsed = (Date.now() - state.timerStartedAt) / 1000;
          return Math.max(0, state.timerDuration - elapsed);
        }
        return 0;
      }
      
      function formatTime(seconds) {
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
      }
      
      function updatePlayerTimerDisplay() {
        const timerDisplayEl = document.getElementById('playerTimerDisplay');
        const timerStatusEl = document.getElementById('playerTimerStatus');
        
        const remaining = getRemainingTime(currentDisplayState);
        if (timerDisplayEl) timerDisplayEl.textContent = formatTime(remaining);
        
        if (timerStatusEl) {
          let statusText = 'Ready';
          if (currentDisplayState.timerStatus === 'running') {
            statusText = remaining <= 0 ? 'Time\'s Up!' : 'Running';
          } else if (currentDisplayState.timerStatus === 'paused') {
            statusText = 'Paused';
          }
          timerStatusEl.textContent = statusText;
          
          // Add visual indicator when time is up
          if (remaining <= 0 && currentDisplayState.timerStatus === 'running') {
            timerDisplayEl.className = 'text-6xl md:text-8xl font-bold text-red-500 mb-2 font-mono animate-pulse';
          } else {
            timerDisplayEl.className = 'text-6xl md:text-8xl font-bold text-secondary-400 mb-2 font-mono';
          }
        }
      }
      
      function startPlayerTimerUpdates() {
        if (timerUpdateInterval) {
          clearInterval(timerUpdateInterval);
        }
        
        if (currentDisplayState.timerStatus === 'running') {
          timerUpdateInterval = setInterval(() => {
            updatePlayerTimerDisplay();
          }, 100); // Update every 100ms for smooth countdown
        }
      }

      // Check if screen is large enough for player display
      function isLargeScreen() {
        return window.innerWidth >= 1024; // lg breakpoint in Tailwind
      }

      // Show or hide mobile warning based on screen size
      function updateMobileWarning() {
        const mobileWarning = document.getElementById('mobileWarning');
        const mainContent = document.getElementById('mainContent');
        
        if (!isLargeScreen()) {
          // Show mobile warning on small screens
          if (mobileWarning) {
            mobileWarning.classList.remove('hidden');
            mobileWarning.classList.add('flex');
          }
          if (mainContent) {
            mainContent.classList.add('hidden');
            mainContent.classList.remove('block');
          }
          return true; // Indicates mobile warning is showing
        } else {
          // Hide mobile warning on large screens
          if (mobileWarning) {
            mobileWarning.classList.add('hidden');
            mobileWarning.classList.remove('flex');
          }
          return false; // Indicates mobile warning is not showing
        }
      }

      // Update display based on state
      async function updateDisplay(state) {
        const hasLocation = state.currentLocationId;
        const hasNpcs = state.spotlightNpcIds && state.spotlightNpcIds.length > 0;
        const showInitiative = state.showInitiativeTracker;
        const showTimer = state.showTimer;
        const screenVisible = state.screenVisible === undefined ? true : state.screenVisible; // Default to true if undefined

        // Hide loading
        const loadingState = document.getElementById('loadingState');
        if (loadingState) loadingState.classList.add('hidden');
        
        // Check screen size and show mobile warning if needed
        const showingMobileWarning = updateMobileWarning();
        
        // If showing mobile warning, don't proceed with normal display logic
        if (showingMobileWarning) {
          return;
        }
        
        // Show main content on large screens
        const mainContent = document.getElementById('mainContent');
        if (mainContent) {
          mainContent.classList.remove('hidden');
          mainContent.classList.add('block');
        }

        // Update current state BEFORE early return so polling detects changes
        currentDisplayState = {
          locationId: state.currentLocationId,
          npcIds: state.spotlightNpcIds || [],
          showInitiative: state.showInitiativeTracker,
          screenVisible: screenVisible,
          placeholderImageUrl: state.placeholderImageUrl,
          showTimer: state.showTimer,
          timerDuration: state.timerDuration,
          timerStartedAt: state.timerStartedAt,
          timerPausedAt: state.timerPausedAt,
          timerStatus: state.timerStatus || 'stopped',
        };
        
        // Update timer display
        updatePlayerTimerDisplay();
        
        // Start or stop timer updates based on status
        if (state.timerStatus === 'running') {
          startPlayerTimerUpdates();
        } else if (timerUpdateInterval) {
          clearInterval(timerUpdateInterval);
          timerUpdateInterval = null;
        }

        // Check if screen is hidden - show placeholder
        if (!screenVisible) {
          showPlaceholder(state.placeholderImageUrl);
          return;
        }
        
        // Hide placeholder when screen is visible
        document.getElementById('placeholderState')?.classList.add('hidden');

        // Count active sections (timer shows on top of or instead of initiative)
        const activeCount = [hasLocation, hasNpcs, showInitiative || showTimer].filter(Boolean).length;
        
        if (activeCount === 0) {
          // Show empty state
          showEmpty();
        } else {
          // Hide empty state and show combined display
          document.getElementById('emptyState')?.classList.add('hidden');
          document.getElementById('combinedDisplay')?.classList.remove('hidden');
          
          const leftPanel = document.getElementById('leftPanel');
          const rightPanel = document.getElementById('rightPanel');
          const locationDisplay = document.getElementById('locationDisplay');
          const npcSpotlight = document.getElementById('npcSpotlight');
          const initiativeDisplay = document.getElementById('initiativeDisplay');
          const timerDisplay = document.getElementById('timerDisplay');
          
          // Reset all displays and their heights
          locationDisplay?.classList.add('hidden');
          npcSpotlight?.classList.add('hidden');
          initiativeDisplay?.classList.add('hidden');
          timerDisplay?.classList.add('hidden');
          
          // Reset all heights to allow dynamic resizing
          if (locationDisplay) locationDisplay.style.height = '';
          if (npcSpotlight) npcSpotlight.style.height = '';
          if (initiativeDisplay) initiativeDisplay.style.height = '';
          if (timerDisplay) timerDisplay.style.height = '';
          
          // Check if we're on mobile (< 768px)
          const isMobile = window.innerWidth < 768;
          
          // Apply layout based on what's active
          if (activeCount === 1) {
            // Single item - fullscreen
            if (hasLocation) {
              leftPanel.style.width = '100%';
              rightPanel.style.width = '0';
              rightPanel.classList.add('hidden');
              leftPanel.classList.remove('hidden');
              locationDisplay?.classList.remove('hidden');
              showLocation(state.currentLocationId);
            } else if (hasNpcs) {
              leftPanel.style.width = '100%';
              rightPanel.style.width = '0';
              rightPanel.classList.add('hidden');
              leftPanel.classList.remove('hidden');
              npcSpotlight?.classList.remove('hidden');
              showNpcs(state.spotlightNpcIds, false); // Pass false - no initiative shown
            } else if (showTimer || showInitiative) {
              leftPanel.style.width = '0';
              leftPanel.classList.add('hidden');
              rightPanel.style.width = '100%';
              rightPanel.classList.remove('hidden');
              
              // Timer takes priority over initiative if both are shown
              if (showTimer) {
                timerDisplay?.classList.remove('hidden');
                if (showInitiative) {
                  // Show both: timer on top, initiative below
                  timerDisplay.style.height = 'auto';
                  initiativeDisplay?.classList.remove('hidden');
                  initiativeDisplay.style.height = 'auto';
                  await showInitiativeTracker();
                }
              } else if (showInitiative) {
                initiativeDisplay?.classList.remove('hidden');
                await showInitiativeTracker();
              }
            }
          } else if (activeCount === 2) {
            // Two items
            leftPanel.classList.remove('hidden');
            rightPanel.classList.remove('hidden');
            
            if (isMobile) {
              // Mobile: Stack vertically - each takes 50% height
              leftPanel.style.width = '100%';
              rightPanel.style.width = '100%';
              
              if (showTimer || showInitiative) {
                // Timer/Initiative on bottom half
                leftPanel.style.height = '50%';
                rightPanel.style.height = '50%';
                
                if (showTimer) {
                  timerDisplay?.classList.remove('hidden');
                  if (showInitiative) {
                    // Both timer and initiative
                    timerDisplay.style.height = 'auto';
                    initiativeDisplay?.classList.remove('hidden');
                    initiativeDisplay.style.height = 'auto';
                    await showInitiativeTracker();
                  }
                } else if (showInitiative) {
                  initiativeDisplay?.classList.remove('hidden');
                  await showInitiativeTracker();
                }
                
                if (hasLocation) {
                  locationDisplay?.classList.remove('hidden');
                  showLocation(state.currentLocationId);
                } else if (hasNpcs) {
                  npcSpotlight?.classList.remove('hidden');
                  showNpcs(state.spotlightNpcIds, true); // Pass true - initiative is shown
                }
              } else {
                // Location and NPCs - both stacked vertically
                leftPanel.style.height = '50%';
                rightPanel.style.height = 'auto';
                rightPanel.classList.add('hidden');
                leftPanel.style.width = '100%';
                
                if (hasLocation) {
                  locationDisplay?.classList.remove('hidden');
                  locationDisplay.style.height = '50%';
                  showLocation(state.currentLocationId);
                }
                if (hasNpcs) {
                  npcSpotlight?.classList.remove('hidden');
                  npcSpotlight.style.height = '50%';
                  showNpcs(state.spotlightNpcIds, false); // Pass false - no initiative
                }
              }
            } else {
              // Desktop: Side by side 60/40
              leftPanel.style.height = '';
              rightPanel.style.height = '';
              
              if (showTimer || showInitiative) {
                // Timer/Initiative always on right when present
                leftPanel.style.width = '60%';
                rightPanel.style.width = '40%';
                
                if (showTimer) {
                  timerDisplay?.classList.remove('hidden');
                  if (showInitiative) {
                    // Both timer and initiative
                    timerDisplay.style.height = 'auto';
                    initiativeDisplay?.classList.remove('hidden');
                    initiativeDisplay.style.height = 'auto';
                    await showInitiativeTracker();
                  }
                } else if (showInitiative) {
                  initiativeDisplay?.classList.remove('hidden');
                  await showInitiativeTracker();
                }
                
                if (hasLocation) {
                  locationDisplay?.classList.remove('hidden');
                  showLocation(state.currentLocationId);
                } else if (hasNpcs) {
                  npcSpotlight?.classList.remove('hidden');
                  showNpcs(state.spotlightNpcIds, true); // Pass true - initiative is shown on desktop
                }
              } else {
                // Location and NPCs - both on left, split the space
                leftPanel.style.width = '100%';
                rightPanel.style.width = '0';
                rightPanel.classList.add('hidden');
                
                if (hasLocation) {
                  locationDisplay?.classList.remove('hidden');
                  locationDisplay.style.height = '50%';
                  showLocation(state.currentLocationId);
                }
                if (hasNpcs) {
                  npcSpotlight?.classList.remove('hidden');
                  npcSpotlight.style.height = '50%';
                  showNpcs(state.spotlightNpcIds, false); // Pass false - no initiative
                }
              }
            }
          } else if (activeCount === 3) {
            // All three items
            leftPanel.classList.remove('hidden');
            rightPanel.classList.remove('hidden');
            
            if (isMobile) {
              // Mobile: Stack all three vertically - location and NPCs at 50% height each, timer/initiative scrollable below
              leftPanel.style.width = '100%';
              rightPanel.style.width = '100%';
              leftPanel.style.height = '100dvh'; // Full dynamic viewport height for location and NPCs
              rightPanel.style.height = 'auto'; // Auto height for timer/initiative (scrollable)
              
              // Split left panel vertically for location and NPCs
              locationDisplay?.classList.remove('hidden');
              locationDisplay.style.height = '50%';
              showLocation(state.currentLocationId);
              
              npcSpotlight?.classList.remove('hidden');
              npcSpotlight.style.height = '50%';
              showNpcs(state.spotlightNpcIds, true); // Pass true because timer/initiative is shown
              
              // Timer/Initiative on bottom (scrollable)
              if (showTimer) {
                timerDisplay?.classList.remove('hidden');
                if (showInitiative) {
                  timerDisplay.style.height = 'auto';
                  initiativeDisplay?.classList.remove('hidden');
                  initiativeDisplay.style.height = 'auto';
                  await showInitiativeTracker();
                }
              } else if (showInitiative) {
                initiativeDisplay?.classList.remove('hidden');
                await showInitiativeTracker();
              }
            } else {
              // Desktop: Location + NPCs on left (60%), Timer/Initiative on right (40%)
              leftPanel.style.width = '60%';
              rightPanel.style.width = '40%';
              leftPanel.style.height = '';
              rightPanel.style.height = '';
              
              // Split left panel vertically
              locationDisplay?.classList.remove('hidden');
              locationDisplay.style.height = '50%';
              showLocation(state.currentLocationId);
              
              npcSpotlight?.classList.remove('hidden');
              npcSpotlight.style.height = '50%';
              showNpcs(state.spotlightNpcIds, true); // Pass true because timer/initiative is shown
              
              // Timer/Initiative on right
              if (showTimer) {
                timerDisplay?.classList.remove('hidden');
                if (showInitiative) {
                  timerDisplay.style.height = 'auto';
                  initiativeDisplay?.classList.remove('hidden');
                  initiativeDisplay.style.height = 'auto';
                  await showInitiativeTracker();
                }
              } else if (showInitiative) {
                initiativeDisplay?.classList.remove('hidden');
                await showInitiativeTracker();
              }
            }
          }
        }
      }

      // Show placeholder/hidden state
      function showPlaceholder(imageUrl) {
        document.getElementById('combinedDisplay')?.classList.add('hidden');
        
        if (imageUrl) {
          // Show custom placeholder image
          document.getElementById('emptyState')?.classList.add('hidden');
          const placeholderState = document.getElementById('placeholderState');
          const placeholderImage = document.getElementById('placeholderImage');
          const placeholderImg = document.getElementById('placeholderImg');
          const defaultPlaceholder = document.getElementById('defaultPlaceholder');
          
          placeholderState?.classList.remove('hidden');
          if (placeholderImg) placeholderImg.src = imageUrl;
          placeholderImage?.classList.remove('hidden');
          defaultPlaceholder?.classList.add('hidden');
        } else {
          // No image set - show "Awaiting DM..." screen
          document.getElementById('placeholderState')?.classList.add('hidden');
          document.getElementById('emptyState')?.classList.remove('hidden');
        }
      }
      
      // Show empty state
      function showEmpty() {
        document.getElementById('emptyState')?.classList.remove('hidden');
        document.getElementById('combinedDisplay')?.classList.add('hidden');
        document.getElementById('placeholderState')?.classList.add('hidden');
      }

      // Show location
      function showLocation(locationId) {
        const location = locationsCache.get(locationId);
        if (!location) return;

        const display = document.getElementById('locationDisplay');
        const image = document.getElementById('locationImage');
        const placeholder = document.getElementById('locationPlaceholder');
        const name = document.getElementById('locationName');
        const info = document.getElementById('locationInfo');

        if (display) display.classList.remove('hidden');
        
        // Toggle between image and placeholder based on imageUrl existence
        if (location.imageUrl) {
          // Show image, hide placeholder
          if (image) {
            image.src = location.imageUrl;
            image.alt = location.name;
            image.classList.remove('hidden');
          }
          if (placeholder) placeholder.classList.add('hidden');
        } else {
          // Show placeholder, hide image
          if (image) image.classList.add('hidden');
          if (placeholder) placeholder.classList.remove('hidden');
        }
        
        if (name) name.textContent = location.name;
        if (info) {
          const parts = [location.type];
          if (location.region) parts.push(location.region);
          info.textContent = parts.join(' • ');
        }
      }

      // Show NPCs
      function showNpcs(npcIds, initiativeShown = false) {
        const spotlight = document.getElementById('npcSpotlight');
        const grid = document.getElementById('npcGrid');
        
        if (!spotlight || !grid) return;

        spotlight.classList.remove('hidden');
        grid.innerHTML = '';
        
        // Update grid columns based on whether initiative tracker is shown
        // When initiative is shown on desktop, use 2 columns instead of 3
        if (initiativeShown) {
          grid.className = 'grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6';
        } else {
          grid.className = 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6';
        }

        npcIds.forEach(npcId => {
          const npc = npcsCache.get(npcId);
          if (!npc) return;

          const card = document.createElement('div');
          card.className = 'bg-gray-800 rounded-lg overflow-hidden shadow-xl border-2 grid grid-cols-1 lg:grid-cols-[4.5fr_2.5fr] lg:aspect-[4/3] border-gray-700 hover:border-primary-600 transition';
          
          const avatarHtml = npc.avatarUrl 
            ? `<img src="${npc.avatarUrl}" alt="${npc.name}" class="w-full aspect-video lg:aspect-auto lg:h-full object-cover" />`
            : `<div class="w-full aspect-video lg:aspect-auto lg:h-full bg-gray-700 flex items-center justify-center">
                <svg class="w-16 h-16 md:w-20 md:h-20 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              </div>`;

          card.innerHTML = `
            ${avatarHtml}
            <div class="p-3 sm:p-4 flex flex-col justify-center lg:justify-end">
              <h3 class="text-base sm:text-lg md:text-xl font-bold mb-1">${npc.name}</h3>
              <p class="text-gray-400 mb-1 sm:mb-2 text-xs sm:text-sm">${npc.occupation || npc.race}</p>
            </div>
          `;
          
          grid.appendChild(card);
        });
      }

      // Show initiative tracker
      async function showInitiativeTracker() {
        const display = document.getElementById('initiativeDisplay');
        if (display) display.classList.remove('hidden');

        await updateInitiativeList();
      }

      // Update initiative list
      async function updateInitiativeList() {
        try {
          const [initiativeResponse, combatResponse] = await Promise.all([
            fetch('/api/initiative'),
            fetch('/api/combat-state'),
          ]);

          if (!initiativeResponse.ok || !combatResponse.ok) return;

          const initiatives = await initiativeResponse.json();
          const combat = await combatResponse.json();

          const list = document.getElementById('initiativeList');
          const roundDisplay = document.getElementById('currentRound');
          
          if (roundDisplay) roundDisplay.textContent = combat.currentRound || 1;
          if (!list) return;

          // Sort by initiative
          const sorted = initiatives.sort((a, b) => {
            if (b.initiative !== a.initiative) return b.initiative - a.initiative;
            return a.name.localeCompare(b.name);
          });

          // Filter active entries
          const active = sorted.filter(e => e.isActive);

          list.innerHTML = '';
          
          // Debug logging
          console.log('Combat state:', combat);
          console.log('Active entries:', active.length);
          console.log('Current turn index:', combat.currentTurnIndex);
          console.log('Combat status:', combat.status);

          active.forEach((entry, index) => {
            const isCurrentTurn = index === combat.currentTurnIndex && combat.status === 'active';
            
            // Debug log for each entry
            if (isCurrentTurn) {
              console.log(`Current turn: ${entry.name} (index ${index})`);
            }
            
            const getHealthStatus = (hp, maxHp) => {
              if (hp === null || maxHp === null) return { text: '-', classes: 'text-gray-400' };
              if (hp === 0) return { text: 'Dead', classes: 'bg-black text-white' };
              const percent = hp / maxHp;
              if (percent <= 0.25) return { text: 'Bloodied', classes: 'bg-red-600 text-white' };
              if (percent <= 0.5) return { text: 'Hurt', classes: 'bg-orange-600 text-white' };
              if (percent <= 0.75) return { text: 'Injured', classes: 'bg-yellow-600 text-white' };
              return { text: 'Healthy', classes: 'bg-green-600 text-white' };
            };

            const getTypeBadge = (type) => {
              const colors = {
                character: 'bg-green-900/30',
                npc: 'bg-blue-900/30',
                monster: 'bg-red-900/30',
                other: 'bg-gray-900/30',
              };
              return colors[type] || colors.other;
            };

            const health = getHealthStatus(entry.hp, entry.maxHp);
            
            const entryEl = document.createElement('div');
            entryEl.className = `p-3 md:p-4 rounded-lg transition ${getTypeBadge(entry.type)} ${
              isCurrentTurn 
                ? 'border-2 border-yellow-500 shadow-lg' 
                : ''
            }`;
            
            entryEl.innerHTML = `
              <div class="flex items-center gap-2 md:gap-4">
                <div class="text-2xl md:text-4xl font-bold text-primary-400 min-w-12 md:min-w-16 text-center">
                  ${entry.initiative}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <h3 class="text-base md:text-xl font-semibold truncate">${entry.name}</h3>
                  </div>
                  ${health.text !== '-' 
                    ? `<span class="inline-block px-2 py-1 rounded text-xs md:text-sm font-semibold ${health.classes}">
                        ${health.text}
                      </span>`
                    : ''
                  }
                </div>
                ${isCurrentTurn 
                  ? `<div class="text-yellow-400 font-bold text-sm md:text-lg whitespace-nowrap" aria-label="Current turn indicator">
                      ▶ <span class="hidden sm:inline">Current Turn</span>
                    </div>`
                  : ''
                }
              </div>
            `;
            
            list.appendChild(entryEl);
          });

          if (active.length === 0) {
            list.innerHTML = '<p class="text-center text-gray-400 py-8">No active combatants</p>';
          }
        } catch (error) {
          console.error('Error updating initiative list:', error);
        }
      }

      // Polling management
      let pollInterval = null;
      let pollRetryCount = 0;
      const MAX_RETRY_DELAY = 30000; // Maximum 30 seconds between retries

      // Poll for state updates with smart retry logic
      async function pollForUpdates() {
        // Skip polling if page is hidden
        if (document.hidden) {
          return;
        }

        try {
          const response = await fetch('/api/dm-screen');
          if (!response.ok) throw new Error('Failed to fetch');

          const state = await response.json();
          
          // Reset retry count on success
          pollRetryCount = 0;
          
          // Check if state changed
          const screenVisible = state.screenVisible === undefined ? true : state.screenVisible;
          const stateChanged = 
            state.currentLocationId !== currentDisplayState.locationId ||
            JSON.stringify(state.spotlightNpcIds) !== JSON.stringify(currentDisplayState.npcIds) ||
            state.showInitiativeTracker !== currentDisplayState.showInitiative ||
            screenVisible !== currentDisplayState.screenVisible ||
            state.placeholderImageUrl !== currentDisplayState.placeholderImageUrl ||
            state.showTimer !== currentDisplayState.showTimer ||
            state.timerDuration !== currentDisplayState.timerDuration ||
            state.timerStartedAt !== currentDisplayState.timerStartedAt ||
            state.timerPausedAt !== currentDisplayState.timerPausedAt ||
            state.timerStatus !== currentDisplayState.timerStatus;

          if (stateChanged) {
            await updateDisplay(state);
          }

          // If showing initiative, update the list on every poll to catch turn changes
          if (state.showInitiativeTracker) {
            await updateInitiativeList();
          }
          
          // If showing timer, update the display on every poll
          if (state.showTimer) {
            updatePlayerTimerDisplay();
          }
        } catch (error) {
          console.error('Error polling for updates:', error);
          // Implement exponential backoff on errors
          pollRetryCount++;
          const delay = Math.min(2000 * Math.pow(2, pollRetryCount), MAX_RETRY_DELAY);
          console.warn(`Polling failed. Retrying in ${delay / 1000}s...`);
        }
      }

      // Initialize
      async function initialize() {
        await loadReferenceData();
        
        // Load initial state
        const response = await fetch('/api/dm-screen');
        if (response.ok) {
          const state = await response.json();
          await updateDisplay(state);
        } else {
          showEmpty();
        }

        // Poll for updates every 2 seconds
        pollInterval = setInterval(pollForUpdates, 2000);
        
        // Stop polling when page is hidden, resume when visible
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            console.log('Page hidden - polling paused');
          } else {
            console.log('Page visible - polling resumed');
            // Immediately poll when page becomes visible
            pollForUpdates();
          }
        });
        
        // Handle window resize to update layout
        let resizeTimeout;
        window.addEventListener('resize', () => {
          // Debounce resize events
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(async () => {
            // Check if we should show mobile warning
            const showingMobileWarning = updateMobileWarning();
            
            // If showing mobile warning, don't re-render display
            if (showingMobileWarning) {
              return;
            }
            
            // Re-render with current state (no API call needed - just re-layout)
            await updateDisplay({
              currentLocationId: currentDisplayState.locationId,
              spotlightNpcIds: currentDisplayState.npcIds,
              showInitiativeTracker: currentDisplayState.showInitiative,
              screenVisible: currentDisplayState.screenVisible,
              placeholderImageUrl: currentDisplayState.placeholderImageUrl,
              showTimer: currentDisplayState.showTimer,
              timerDuration: currentDisplayState.timerDuration,
              timerStartedAt: currentDisplayState.timerStartedAt,
              timerPausedAt: currentDisplayState.timerPausedAt,
              timerStatus: currentDisplayState.timerStatus
            });
          }, 250);
        });
      }

      // Cleanup on page unload
      window.addEventListener('beforeunload', () => {
        if (pollInterval) {
          clearInterval(pollInterval);
        }
        if (timerUpdateInterval) {
          clearInterval(timerUpdateInterval);
        }
      });

      // Start when page loads
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initialize);
      } else {
        initialize();
      }
    </script>
  </body>
</html>

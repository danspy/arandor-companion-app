---
import Layout from '../../layouts/Layout.astro';
import { db, NPC, Location, eq } from 'astro:db';
import { isAuthenticated } from '../../lib/auth';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/npcs');
}

const npcs = await db.select().from(NPC).where(eq(NPC.id, id));
const npc = npcs[0];

if (!npc) {
  return Astro.redirect('/npcs');
}

// Fetch location if locationId exists
let location = null;
if (npc.locationId) {
  const locations = await db.select().from(Location).where(eq(Location.id, npc.locationId));
  location = locations[0];
}

const isLoggedIn = isAuthenticated(Astro.cookies);
---

<Layout title={npc.name}>
  <div class="max-w-4xl mx-auto">
    <!-- Header with Back Button -->
    <div class="flex items-center justify-between mb-6">
      <a href="/npcs" class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to NPCs
      </a>
      {isLoggedIn && (
        <div class="flex gap-2">
          <button 
            id="editNPC"
            data-id={npc.id}
            class="bg-primary-600 text-white px-4 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
          >
            Edit
          </button>
          <button 
            id="deleteNPC"
            data-id={npc.id}
            class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 dark:bg-red-700 dark:hover:bg-red-600 transition"
          >
            Delete
          </button>
        </div>
      )}
    </div>

    <!-- NPC Header -->
    <article class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden mb-6 dark:border dark:border-gray-700">
      <!-- NPC Banner with Avatar -->
      <div class={`h-48 relative ${
        npc.relationship === 'ally' ? 'bg-gradient-to-r from-green-600 to-green-500' :
        npc.relationship === 'enemy' ? 'bg-gradient-to-r from-red-600 to-red-500' :
        'bg-gradient-to-r from-gray-600 to-gray-500'
      }`}>
        <div class="absolute bottom-0 left-8 transform translate-y-1/2">
          {npc.avatarUrl ? (
            <img 
              src={npc.avatarUrl} 
              alt={npc.name}
              class="w-32 h-32 rounded-full border-4 border-white shadow-lg object-cover"
            />
          ) : (
            <div class="w-32 h-32 bg-white rounded-full border-4 border-white shadow-lg flex items-center justify-center text-5xl font-bold text-primary-700">
              {npc.name.charAt(0)}
            </div>
          )}
        </div>
      </div>

      <!-- NPC Info -->
      <div class="pt-20 px-8 pb-8">
        <h1 class="text-4xl font-bold text-primary-700 dark:text-primary-400 mb-2">{npc.name}</h1>
        <p class="text-xl text-gray-600 dark:text-gray-400 mb-6">{npc.race} {npc.occupation && `• ${npc.occupation}`}</p>

        <!-- Quick Info -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          <div class={`p-4 rounded-lg ${
            npc.relationship === 'ally' ? 'bg-green-50' :
            npc.relationship === 'enemy' ? 'bg-red-50' :
            'bg-gray-50'
          }`}>
            <div class="text-sm text-gray-600 dark:text-gray-400 mb-1">Relationship</div>
            <div class={`text-2xl font-semibold ${
              npc.relationship === 'ally' ? 'text-green-700' :
              npc.relationship === 'enemy' ? 'text-red-700' :
              'text-gray-700'
            }`}>
              {npc.relationship.charAt(0).toUpperCase() + npc.relationship.slice(1)}
            </div>
          </div>
          {location && (
            <div class="bg-primary-50 dark:bg-primary-900/20 dark:border dark:border-primary-800 p-4 rounded-lg">
              <div class="text-sm text-gray-600 dark:text-gray-400 mb-1">Location</div>
              <a href={`/locations/${location.id}`} class="text-2xl font-semibold text-primary-700 dark:text-primary-400 hover:text-primary-900 dark:hover:text-primary-300 hover:underline">
                {location.name}
              </a>
            </div>
          )}
        </div>
      </div>
    </article>

    <!-- Description Section -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-8 mb-6 dark:border dark:border-gray-700">
      <h2 class="text-2xl font-bold text-primary-700 dark:text-primary-400 mb-4">Description</h2>
      <p class="text-lg text-gray-800 dark:text-gray-200 leading-relaxed">{npc.description}</p>
    </div>

    <!-- Notes Section -->
    {npc.notes && (
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-8 mb-6 dark:border dark:border-gray-700">
        <h2 class="text-2xl font-bold text-primary-700 dark:text-primary-400 mb-4">Notes</h2>
        <div class="bg-amber-50 dark:bg-amber-900/20 border-l-4 border-amber-500 dark:border-amber-400 p-4 rounded dark:border dark:border-amber-800">
          <p class="text-gray-800 dark:text-gray-200 leading-relaxed">{npc.notes}</p>
        </div>
      </div>
    )}
  </div>
</Layout>

<script>
  const deleteBtn = document.getElementById('deleteNPC');
  const editBtn = document.getElementById('editNPC');
  
  // Handle edit button click
  if (editBtn) {
    editBtn.addEventListener('click', () => {
      const id = editBtn.getAttribute('data-id');
      if (id) {
        window.location.href = `/npcs?edit=${id}`;
      }
    });
  }
  
  if (deleteBtn) {
    deleteBtn.addEventListener('click', async () => {
      const id = deleteBtn.getAttribute('data-id');
      if (!id) return;
      
      if (confirm('Are you sure you want to delete this NPC?')) {
        try {
          const response = await fetch(`/api/npcs/${id}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.href = '/npcs';
          } else {
            const error = await response.json().catch(() => ({ error: 'Unknown error' }));
            alert(`Failed to delete NPC: ${error.error || response.statusText}`);
          }
        } catch (error) {
          console.error('Delete error:', error);
          alert('An error occurred while deleting the NPC. Please check your connection and try again.');
        }
      }
    });
  }
</script>

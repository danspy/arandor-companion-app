---
import Layout from '../../layouts/Layout.astro';
import SceneBackdrop from '../../components/SceneBackdrop.astro';
import { db, NPC, Location, DiaryEntry, eq } from '@/db';
import { isAuthenticated } from '../../lib/auth';
import { renderMarkdown } from '../../utils/markdown';

const { id } = Astro.params;
if (!id) return Astro.redirect('/npcs');

const npcs = await db.select().from(NPC).where(eq(NPC.id, id));
const npc = npcs[0];
if (!npc) return Astro.redirect('/npcs');

let location = null;
if (npc.locationId) {
  const locations = await db.select().from(Location).where(eq(Location.id, npc.locationId));
  location = locations[0];
}

const allDiaryEntries = await db.select().from(DiaryEntry);
const relatedDiaryEntries = allDiaryEntries.filter(entry => {
  const npcIds = Array.isArray(entry.npcIds) ? entry.npcIds : [];
  return npcIds.includes(id);
}).sort((a, b) => b.session - a.session);

const isLoggedIn = isAuthenticated(Astro.cookies);
const renderedDescription = renderMarkdown(npc.description);

const relBadge = npc.relationship === 'ally' ? 't-badge-green' : npc.relationship === 'enemy' ? 't-badge-red' : '';
const heroBg = npc.relationship === 'ally'
  ? 'from-emerald-950 to-stone-900'
  : npc.relationship === 'enemy'
  ? 'from-red-950 to-stone-900'
  : 'from-stone-900 to-stone-800';
---

<Layout title={npc.name}>
  <SceneBackdrop imageUrl={npc.avatarUrl} />
  <div class="max-w-4xl mx-auto px-1 sm:px-0">

    <!-- Nav row -->
    <div class="flex items-center justify-between mb-6">
      <a href="/npcs" class="t-back-link">
        <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/>
        </svg>
        All NPCs
      </a>
      {isLoggedIn && (
        <div class="flex gap-2">
          <button id="editNPC" data-id={npc.id} class="t-icon-btn" title="Edit NPC" aria-label="Edit NPC">
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </button>
          <button id="deleteNPC" data-id={npc.id} class="t-icon-btn t-icon-btn-danger" title="Delete NPC" aria-label="Delete NPC">
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
          </button>
        </div>
      )}
    </div>

    <!-- NPC Card -->
    <div class="t-panel overflow-hidden mb-6">
      <!-- Hero banner -->
      <div class={`t-hero-banner bg-linear-to-br ${heroBg}`} style="min-height:240px;">
        {npc.avatarUrl && (
          <>
            <img src={npc.avatarUrl} alt={npc.name}
              class="absolute inset-0 w-full h-full object-cover"
              style="filter:blur(16px) brightness(0.45) saturate(0.65); transform:scale(1.08);"/>
            <div class="absolute inset-0" style="background:linear-gradient(to bottom,rgba(8,6,3,0.2),rgba(8,6,3,0.7));"></div>
          </>
        )}
        <div class="t-hero-banner-content flex flex-col sm:flex-row items-center sm:items-end gap-5">
          {npc.avatarUrl ? (
            <img src={npc.avatarUrl} alt={npc.name}
              class="w-24 h-24 sm:w-28 sm:h-28 rounded-full object-cover shrink-0 shadow-2xl"
              style="border:3px solid var(--border-gold);"/>
          ) : (
            <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full shrink-0 flex items-center justify-center shadow-2xl"
              style="background:var(--bg-surface);border:3px solid var(--border-gold);font-family:'Cormorant Garamond',serif;font-size:3rem;font-weight:700;color:var(--gold);">
              {npc.name.charAt(0)}
            </div>
          )}
          <div class="text-center sm:text-left">
            <div class="flex flex-wrap items-center gap-2 mb-1 justify-center sm:justify-start">
              <h1 class="font-display italic font-semibold text-3xl sm:text-4xl leading-tight"
                style="color:#fff;text-shadow:0 2px 16px rgba(0,0,0,0.8);">{npc.name}</h1>
              <span class={`t-badge ${relBadge}`} style="backdrop-filter:blur(8px);">
                {npc.relationship.charAt(0).toUpperCase() + npc.relationship.slice(1)}
              </span>
            </div>
            {(npc.race || npc.occupation) && (
              <p class="text-base sm:text-lg" style="color:rgba(242,232,213,0.8);">
                {[npc.race, npc.occupation].filter(Boolean).join(' · ')}
              </p>
            )}
          </div>
        </div>
      </div>

      <!-- Quick facts strip -->
      {location && (
        <div class="px-6 py-4" style="border-top:1px solid var(--border-gold);">
          <div class="t-field-label">Last Known Location</div>
          <a href={`/locations/${location.id}`} class="t-link text-base font-semibold">
            {location.name}
          </a>
        </div>
      )}
    </div>

    <!-- Description -->
    {npc.description && (
      <div class="t-panel p-6 sm:p-8 mb-6">
        <div class="t-section-header">
          <h2 class="t-section-h text-xl">Description</h2>
        </div>
        <div class="t-prose" set:html={renderedDescription}/>
      </div>
    )}

    <!-- Notes -->
    {npc.notes && (
      <div class="t-panel p-6 sm:p-8 mb-6">
        <div class="t-section-header">
          <h2 class="t-section-h text-xl">Notes</h2>
        </div>
        <div class="t-callout">
          <p class="t-body-text leading-relaxed">{npc.notes}</p>
        </div>
      </div>
    )}

    <!-- Diary Appearances -->
    {relatedDiaryEntries.length > 0 && (
      <div class="t-panel p-6 sm:p-8 mb-6">
        <div class="t-section-header">
          <h2 class="t-section-h text-xl">Diary Appearances</h2>
          <span class="t-badge t-badge-gold ml-auto">{relatedDiaryEntries.length}</span>
        </div>
        <div class="flex flex-col gap-3">
          {relatedDiaryEntries.map(entry => (
            <a href={`/diary/${entry.id}`} class="t-row p-4 flex items-start justify-between gap-4">
              <div class="min-w-0">
                <div class="t-body-text font-medium truncate">{entry.title}</div>
                <div class="t-faint text-xs mt-0.5 line-clamp-2">
                  {entry.content.substring(0, 120)}{entry.content.length > 120 ? '…' : ''}
                </div>
                {Array.isArray(entry.tags) && entry.tags.length > 0 && (
                  <div class="flex gap-1.5 flex-wrap mt-2">
                    {entry.tags.slice(0, 3).map((tag: string) => (
                      <span class="t-badge t-badge-gold">#{tag}</span>
                    ))}
                    {entry.tags.length > 3 && <span class="t-faint text-xs">+{entry.tags.length - 3}</span>}
                  </div>
                )}
              </div>
              <span class="t-badge t-badge-accent shrink-0">Session {entry.session}</span>
            </a>
          ))}
        </div>
      </div>
    )}

  </div>
</Layout>

<script>
  function initializeDetailPage() {
    document.getElementById('editNPC')?.addEventListener('click', () => {
      const id = document.getElementById('editNPC')?.getAttribute('data-id');
      if (id) window.location.href = `/npcs?edit=${id}`;
    });
    document.getElementById('deleteNPC')?.addEventListener('click', async () => {
      const id = document.getElementById('deleteNPC')?.getAttribute('data-id');
      if (!id) return;
      if (confirm('Are you sure you want to delete this NPC?')) {
        try {
          const response = await fetch(`/api/npcs/${id}`, { method: 'DELETE' });
          if (response.ok) {
            window.location.href = '/npcs';
          } else {
            const error = await response.json().catch(() => ({ error: 'Unknown error' }));
            alert(`Failed to delete NPC: ${error.error || response.statusText}`);
          }
        } catch { alert('An error occurred while deleting the NPC.'); }
      }
    });
  }
  document.addEventListener('astro:page-load', initializeDetailPage);
</script>

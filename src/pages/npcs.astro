---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { db, NPC, Location, PageSettings, eq } from '@/db';
import { isAuthenticated, getUserRole } from '../lib/auth';

const npcs = await db.select().from(NPC);
const locations = await db.select().from(Location);
const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);
const canEditHero = userRole === 'admin' || userRole === 'dungeonmaster';

const alliedNPCs = npcs.filter(n => n.relationship === 'ally');
const neutralNPCs = npcs.filter(n => n.relationship === 'neutral');
const enemyNPCs = npcs.filter(n => n.relationship === 'enemy');

// Get page settings for hero image
const pageSettings = await db.select().from(PageSettings).where(eq(PageSettings.pageName, 'npcs'));
const heroImageUrl = pageSettings.length > 0 ? pageSettings[0].heroImageUrl : null;
---

<Layout title="NPCs">
  <PageHero
    title="Non-Player Characters"
    heroImageUrl={heroImageUrl}
    pageName="npcs"
    canEditHero={canEditHero}
    subtitle={`${npcs.length} people met, ${alliedNPCs.length} of them allies and ${enemyNPCs.length} enemies`}
  >
    <Fragment slot="actions">
      {isLoggedIn && (
    <Button
      variant="primary"
      size="md"
      icon="add"
      id="addNPC"
      title="Add new Add NPC"
    >
      Add NPC
    </Button>
      )}
    </Fragment>
  </PageHero>

  <!-- Search and Filter -->
  <div class="t-panel p-4 mb-6">
    <div class="flex flex-col gap-3">
      <!-- Search Input - Always Full Width -->
      <div class="relative w-full">
        <input
          type="text"
          id="searchInput"
          placeholder="Search NPCs by name, race, occupation, or location..."
          class="t-search w-full px-4 py-2 pl-10 rounded-xs transition"
        >
        <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 t-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <!-- Relationship Filter Below -->
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-sm t-muted font-medium">Filter:</span>
        <button class="filter-tab t-pill active transition-all duration-200 active:scale-95" data-filter="all">
          All ({npcs.length})
        </button>
        <button class="filter-tab t-pill transition-all duration-200 active:scale-95" data-filter="ally">
          Allies ({alliedNPCs.length})
        </button>
        <button class="filter-tab t-pill transition-all duration-200 active:scale-95" data-filter="neutral">
          Neutral ({neutralNPCs.length})
        </button>
        <button class="filter-tab t-pill transition-all duration-200 active:scale-95" data-filter="enemy">
          Enemies ({enemyNPCs.length})
        </button>
      </div>
    </div>
  </div>

  <div id="npcGrid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {npcs.map(npc => (
      <div class="npc-card t-panel overflow-hidden hover:shadow-lg transition" data-relationship={npc.relationship} data-search={`${npc.name} ${npc.race} ${npc.occupation || ''} ${npc.location || ''} ${npc.description}`.toLowerCase()}>
        <a href={`/npcs/${npc.id}`} class="block">
          <div class="relative h-56 overflow-hidden">
            <!-- Blurred background -->
            {npc.avatarUrl ? (
              <>
                <img
                  src={npc.avatarUrl}
                  alt={npc.name}
                  class="absolute inset-0 w-full h-full object-cover blur-md scale-110"
                />
                <div class="absolute inset-0 bg-black/30"></div>
              </>
            ) : (
              <div class={`absolute inset-0 rel-bg-${['ally','enemy'].includes(npc.relationship) ? npc.relationship : 'neutral'}`}></div>
            )}

            <!-- Circular avatar on top -->
            <div class="relative h-full flex items-center justify-center">
              {npc.avatarUrl ? (
                <img
                  src={npc.avatarUrl}
                  alt={npc.name}
                  class="w-32 h-32 rounded-full object-cover shadow-xl"
                  style="border:3px solid var(--border-gold);"
                />
              ) : (
                <div class="w-32 h-32 rounded-full flex items-center justify-center text-5xl font-bold shadow-xl" style="background:var(--bg-surface);border:3px solid var(--border-gold);color:var(--gold);font-family:'Cormorant Garamond',serif;">
                  {npc.name.charAt(0)}
                </div>
              )}
            </div>

            <!-- Relationship badge -->
            <div class={`absolute top-3 right-3 text-xs px-3 py-1 rounded-xs shadow-lg rel-tag rel-tag-${['ally','enemy'].includes(npc.relationship) ? npc.relationship : 'neutral'}`}>
              {npc.relationship.charAt(0).toUpperCase() + npc.relationship.slice(1)}
            </div>
          </div>
        </a>

        <div class="p-6">
          <div class="flex items-start justify-between gap-2 mb-2">
            <a href={`/npcs/${npc.id}`} class="block t-gold hover:opacity-80 transition">
              <h2 class="text-2xl font-bold">{npc.name}</h2>
            </a>
            {isLoggedIn && (
              <div class="flex gap-2 items-center shrink-0">
                <Button
                  variant="icon"
                  size="sm"
                  icon="edit"
                  iconPosition="only"
                  class="edit-npc"
                  data-id={npc.id}
                  title="Edit NPC"
                  ariaLabel="Edit NPC"
                />
                <Button
                  variant="icon"
                  size="sm"
                  icon="delete"
                  iconPosition="only"
                  class="delete-npc hover:text-red-400"
                  data-id={npc.id}
                  title="Delete NPC"
                  ariaLabel="Delete NPC"
                />
              </div>
            )}
          </div>
          <a href={`/npcs/${npc.id}`} class="block t-muted hover:opacity-80 transition">
            <p class="mb-4">{npc.race} {npc.occupation && `• ${npc.occupation}`}</p>
          </a>

          {npc.location && (
            <div class="mb-3">
              <span class="text-sm t-faint">📍 Location: </span>
              <span class="text-sm font-medium t-strong-text">{npc.location}</span>
            </div>
          )}

          <a
            href={`/npcs/${npc.id}`}
            class="t-btn-secondary block mt-4 text-center text-sm"
          >
            View details →
          </a>
        </div>
      </div>
    ))}
  </div>

  {npcs.length === 0 && (
    <div class="text-center py-16 t-panel">
      <p class="t-faint text-lg">No NPCs yet. Start adding characters you've encountered!</p>
    </div>
  )}

  <!-- Modal for Add/Edit NPC -->
  <div id="npcModal" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50 p-4 modal-overlay-safe">
    <div class="t-modal-panel p-4 sm:p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto modal-content-safe">
      <h2 id="modalTitle" class="t-section-h text-xl sm:text-2xl mb-4 sm:mb-6">New NPC</h2>
      <form id="npcForm" class="space-y-4">
        <input type="hidden" id="npcId" name="id">

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="name" class="t-label block mb-1">Name</label>
            <input type="text" id="name" name="name" required class="t-input px-4 py-2">
          </div>
          <div>
            <label for="race" class="t-label block mb-1">Race</label>
            <input type="text" id="race" name="race" required class="t-input px-4 py-2">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="occupation" class="t-label block mb-1">Occupation (optional)</label>
            <input type="text" id="occupation" name="occupation" class="t-input px-4 py-2">
          </div>
          <div>
            <label for="locationId" class="t-label block mb-1">Location (optional)</label>
            <select id="locationId" name="locationId" class="t-input px-4 py-2">
              <option value="">-- No Location --</option>
              {locations.map(location => (
                <option value={location.id}>{location.name}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="space-y-2">
          <label class="t-label block">Avatar (optional)</label>
          <div class="space-y-2">
            <div>
              <label for="avatarFile" class="t-faint text-xs block mb-1">Upload Image (max 5MB)</label>
              <input type="file" id="avatarFile" name="avatarFile" accept="image/*" class="t-input px-4 py-2 file:mr-3 file:py-1 file:px-3 file:rounded-sm file:border-0 file:text-xs file:font-semibold file:bg-amber-900/30 file:text-amber-300">
            </div>
            <div class="flex items-center gap-2">
              <div class="flex-1 h-px" style="background:var(--border);"></div>
              <span class="t-faint text-xs">OR</span>
              <div class="flex-1 h-px" style="background:var(--border);"></div>
            </div>
            <div>
              <label for="avatarUrl" class="t-faint text-xs block mb-1">Avatar URL</label>
              <input type="text" id="avatarUrl" name="avatarUrl" class="t-input px-4 py-2" placeholder="https://example.com/image.jpg">
            </div>
          </div>
          <div id="avatarPreview" class="hidden mt-2">
            <img id="avatarPreviewImg" src="" alt="Preview" class="max-w-full h-32 object-cover rounded-xs">
          </div>
        </div>

        <div>
          <label for="relationship" class="t-label block mb-1">Relationship</label>
          <select id="relationship" name="relationship" required class="t-input px-4 py-2">
            <option value="ally">Ally</option>
            <option value="neutral" selected>Neutral</option>
            <option value="enemy">Enemy</option>
          </select>
        </div>

        <div>
          <label for="description" class="t-label block mb-1">Description</label>
          <textarea id="description" name="description" required rows="3" class="t-input px-4 py-2"></textarea>
        </div>

        <div>
          <label for="notes" class="t-label block mb-1">Notes (optional)</label>
          <textarea id="notes" name="notes" rows="2" class="t-input px-4 py-2"></textarea>
        </div>

        <div class="flex gap-4 pt-4">
          <button type="submit" class="t-btn-primary flex-1 px-6 py-2">Save NPC</button>
          <button type="button" id="cancelModal" class="t-btn-secondary flex-1">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  // Shared state for editing NPC ID
  let editingId: string | null = null;

  // Initialize NPC modal and form functionality
  function initializeNPCModal() {
    const modal = document.getElementById('npcModal');
    const form = document.getElementById('npcForm') as HTMLFormElement;
    const modalTitle = document.getElementById('modalTitle');
    const addButton = document.getElementById('addNPC');
    const cancelButton = document.getElementById('cancelModal');

  // Open modal for new NPC
  addButton?.addEventListener('click', () => {
    editingId = null;
    form.reset();
    if (modalTitle) modalTitle.textContent = 'New NPC';
    modal?.classList.remove('hidden');
  });

  // Close modal
  cancelButton?.addEventListener('click', () => {
    modal?.classList.add('hidden');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
    }
  });

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);

    // Helper to convert empty strings to undefined for optional fields
    const getOptionalValue = (key: string) => {
      const value = formData.get(key) as string;
      return value?.trim() || undefined;
    };

    // Handle avatar upload
    let avatarUrl = getOptionalValue('avatarUrl');
    const avatarFile = formData.get('avatarFile') as File;

    if (avatarFile && avatarFile.size > 0) {
      try {
        const uploadFormData = new FormData();
        uploadFormData.append('file', avatarFile);

        const uploadResponse = await fetch('/api/upload', {
          method: 'POST',
          body: uploadFormData,
        });

        if (uploadResponse.ok) {
          const uploadData = await uploadResponse.json();
          avatarUrl = uploadData.url;
        } else {
          const error = await uploadResponse.json();
          alert(`Failed to upload avatar: ${error.error || 'Unknown error'}`);
          return;
        }
      } catch (error) {
        console.error('Upload error:', error);
        alert('Failed to upload avatar. Please try again.');
        return;
      }
    }

    const data = {
      name: formData.get('name'),
      race: formData.get('race'),
      occupation: getOptionalValue('occupation'),
      locationId: getOptionalValue('locationId'),
      relationship: formData.get('relationship'),
      description: formData.get('description'),
      notes: getOptionalValue('notes'),
      avatarUrl,
    };

    try {
      const url = editingId ? `/api/npcs/${editingId}` : '/api/npcs';
      const method = editingId ? 'PUT' : 'POST';

      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        alert('Failed to save NPC. Please try again.');
      }
    } catch (error) {
      alert('An error occurred. Please try again.');
    }
  });

  // Handle avatar file preview
  const avatarFileInput = document.getElementById('avatarFile') as HTMLInputElement;
  const avatarUrlInput = document.getElementById('avatarUrl') as HTMLInputElement;
  const avatarPreview = document.getElementById('avatarPreview');
  const avatarPreviewImg = document.getElementById('avatarPreviewImg') as HTMLImageElement;

  avatarFileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file && avatarPreview && avatarPreviewImg) {
      const reader = new FileReader();
      reader.onload = (e) => {
        avatarPreviewImg.src = e.target?.result as string;
        avatarPreview.classList.remove('hidden');
      };
      reader.readAsDataURL(file);
      // Clear URL input when file is selected
      if (avatarUrlInput) avatarUrlInput.value = '';
    }
  });

  avatarUrlInput?.addEventListener('input', (e) => {
    const url = (e.target as HTMLInputElement).value;
    if (url && avatarPreview && avatarPreviewImg) {
      avatarPreviewImg.src = url;
      avatarPreview.classList.remove('hidden');
      // Clear file input when URL is entered
      if (avatarFileInput) avatarFileInput.value = '';
    } else if (avatarPreview) {
      avatarPreview.classList.add('hidden');
    }
  });

    // Check for edit parameter on page load and open modal if present
    const urlParams = new URLSearchParams(window.location.search);
    const editId = urlParams.get('edit');

    if (editId && modal && form && modalTitle) {
      (async () => {
        try {
          const response = await fetch(`/api/npcs/${editId}`);
          if (!response.ok) {
            throw new Error('NPC not found');
          }

          const npc = await response.json();

          editingId = editId;
          (document.getElementById('name') as HTMLInputElement).value = npc.name;
          (document.getElementById('race') as HTMLInputElement).value = npc.race;
          (document.getElementById('occupation') as HTMLInputElement).value = npc.occupation || '';
          (document.getElementById('locationId') as HTMLSelectElement).value = npc.locationId || '';
          (document.getElementById('relationship') as HTMLSelectElement).value = npc.relationship;
          (document.getElementById('description') as HTMLTextAreaElement).value = npc.description;
          (document.getElementById('notes') as HTMLTextAreaElement).value = npc.notes || '';
          (document.getElementById('avatarUrl') as HTMLInputElement).value = npc.avatarUrl || '';

          modalTitle.textContent = 'Edit NPC';
          modal.classList.remove('hidden');

          // Clear the URL parameter so refreshing doesn't re-open the modal
          window.history.replaceState({}, '', '/npcs');
        } catch (error) {
          console.error('Failed to load NPC for editing:', error);
          alert('Failed to load NPC. Please try again.');
        }
      })();
    }
  }

  // Edit/Delete NPCs with event delegation
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    if (target.classList.contains('edit-npc')) {
      const id = target.getAttribute('data-id');
      if (!id) return;

      // Get DOM elements fresh
      const modal = document.getElementById('npcModal');
      const modalTitle = document.getElementById('modalTitle');

      try {
        const response = await fetch(`/api/npcs/${id}`);
        if (!response.ok) {
          throw new Error('Failed to fetch NPC');
        }
        const npc = await response.json();

        editingId = id;
        (document.getElementById('name') as HTMLInputElement).value = npc.name;
        (document.getElementById('race') as HTMLInputElement).value = npc.race;
        (document.getElementById('occupation') as HTMLInputElement).value = npc.occupation || '';
        (document.getElementById('locationId') as HTMLSelectElement).value = npc.locationId || '';
        (document.getElementById('relationship') as HTMLSelectElement).value = npc.relationship;
        (document.getElementById('description') as HTMLTextAreaElement).value = npc.description;
        (document.getElementById('notes') as HTMLTextAreaElement).value = npc.notes || '';
        (document.getElementById('avatarUrl') as HTMLInputElement).value = npc.avatarUrl || '';

        if (modalTitle) modalTitle.textContent = 'Edit NPC';
        modal?.classList.remove('hidden');
      } catch (error) {
        console.error('Failed to load NPC:', error);
        alert('Failed to load NPC. Please try again.');
      }
    }

    // Delete NPC
    if (target.classList.contains('delete-npc')) {
      const id = target.getAttribute('data-id');
      if (!id) return;

      if ((await window.arandorConfirm('Delete this NPC?', { detail: 'This can\u2019t be undone.', confirmLabel: 'Delete', danger: true }))) {
        try {
          const response = await fetch(`/api/npcs/${id}`, {
            method: 'DELETE',
          });

          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete NPC. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    }
  });

  // Initialize search and filter functionality on page load
  // This ensures it works after Astro View Transitions navigation
  function initializeFilters() {
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const filterTabs = document.querySelectorAll('.filter-tab');
    const npcCards = document.querySelectorAll('.npc-card');

    let currentFilter = 'all';
    let currentSearch = '';

    const applyFilters = () => {
      const searchTerms = currentSearch.toLowerCase().split(/\s+/).filter(term => term.length > 0);
      npcCards.forEach(card => {
        const relationship = card.getAttribute('data-relationship') || '';
        const searchText = card.getAttribute('data-search') || '';

        const matchesFilter = currentFilter === 'all' || relationship === currentFilter;
        // Match if ANY search term is found in the text (more flexible search)
        const matchesSearch = searchTerms.length === 0 || searchTerms.some(term => searchText.includes(term));

        (card as HTMLElement).style.display = matchesFilter && matchesSearch ? 'block' : 'none';
      });
    };

    // Search functionality
    searchInput?.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    // Filter functionality
    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        currentFilter = tab.getAttribute('data-filter') || 'all';

        // Update button styles
        filterTabs.forEach(t => {
          if (t.getAttribute('data-filter') === currentFilter) {
            t.classList.add('active');
          } else {
            t.classList.remove('active');
          }
        });

        applyFilters();
      });
    });
  }

  // Run on initial page load and after View Transitions navigation
  document.addEventListener('astro:page-load', () => {
    initializeNPCModal();
    initializeFilters();
  });
</script>

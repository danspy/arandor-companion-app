---
import Layout from '../layouts/Layout.astro';
import { db, NPC } from 'astro:db';

const npcs = await db.select().from(NPC);

const alliedNPCs = npcs.filter(n => n.relationship === 'ally');
const neutralNPCs = npcs.filter(n => n.relationship === 'neutral');
const enemyNPCs = npcs.filter(n => n.relationship === 'enemy');
---

<Layout title="NPCs">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold text-purple-700">Non-Player Characters</h1>
    <button 
      id="addNPC"
      class="bg-purple-600 text-white px-6 py-2 rounded-lg hover:bg-purple-700 transition"
    >
      + Add NPC
    </button>
  </div>

  <!-- Filter tabs -->
  <div class="flex gap-4 mb-6 border-b">
    <button class="px-4 py-2 border-b-2 border-purple-600 text-purple-600 font-semibold">
      All ({npcs.length})
    </button>
    <button class="px-4 py-2 text-gray-600 hover:text-purple-600">
      Allies ({alliedNPCs.length})
    </button>
    <button class="px-4 py-2 text-gray-600 hover:text-purple-600">
      Neutral ({neutralNPCs.length})
    </button>
    <button class="px-4 py-2 text-gray-600 hover:text-purple-600">
      Enemies ({enemyNPCs.length})
    </button>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {npcs.map(npc => (
      <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition">
        <div class="flex justify-between items-start mb-4">
          <div>
            <h2 class="text-2xl font-bold text-gray-900">{npc.name}</h2>
            <p class="text-gray-600">{npc.race} {npc.occupation && `• ${npc.occupation}`}</p>
          </div>
          <span class={`px-3 py-1 rounded-full text-sm font-medium ${
            npc.relationship === 'ally' ? 'bg-green-100 text-green-700' :
            npc.relationship === 'enemy' ? 'bg-red-100 text-red-700' :
            'bg-gray-100 text-gray-700'
          }`}>
            {npc.relationship}
          </span>
        </div>

        <div class="mb-4">
          <p class="text-gray-700">{npc.description}</p>
        </div>

        {npc.location && (
          <div class="mb-3">
            <span class="text-sm text-gray-500">📍 Location: </span>
            <span class="text-sm font-medium">{npc.location}</span>
          </div>
        )}

        {npc.notes && (
          <div class="bg-amber-50 border-l-4 border-amber-500 p-3 mb-3">
            <p class="text-sm text-amber-900"><strong>Notes:</strong> {npc.notes}</p>
          </div>
        )}

        <div class="flex gap-2 mt-4">
          <button class="edit-npc flex-1 bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700 transition" data-id={npc.id}>
            Edit
          </button>
          <button class="delete-npc px-4 py-2 border border-red-300 text-red-600 rounded hover:bg-red-50 transition" data-id={npc.id}>
            Delete
          </button>
        </div>
      </div>
    ))}
  </div>

  {npcs.length === 0 && (
    <div class="text-center py-16 bg-white rounded-lg shadow-md">
      <p class="text-gray-500 text-lg">No NPCs yet. Start adding characters you've encountered!</p>
    </div>
  )}

  <!-- Modal for Add/Edit NPC -->
  <div id="npcModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg p-8 max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto">
      <h2 id="modalTitle" class="text-2xl font-bold mb-6 text-purple-700">New NPC</h2>
      <form id="npcForm" class="space-y-4">
        <input type="hidden" id="npcId" name="id">
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
            >
          </div>
          
          <div>
            <label for="race" class="block text-sm font-medium text-gray-700 mb-1">Race</label>
            <input 
              type="text" 
              id="race" 
              name="race" 
              required 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
            >
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="occupation" class="block text-sm font-medium text-gray-700 mb-1">Occupation (optional)</label>
            <input 
              type="text" 
              id="occupation" 
              name="occupation" 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
            >
          </div>
          
          <div>
            <label for="location" class="block text-sm font-medium text-gray-700 mb-1">Location (optional)</label>
            <input 
              type="text" 
              id="location" 
              name="location" 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
            >
          </div>
        </div>
        
        <div>
          <label for="relationship" class="block text-sm font-medium text-gray-700 mb-1">Relationship</label>
          <select 
            id="relationship" 
            name="relationship" 
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
          >
            <option value="ally">Ally</option>
            <option value="neutral" selected>Neutral</option>
            <option value="enemy">Enemy</option>
          </select>
        </div>
        
        <div>
          <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
          <textarea 
            id="description" 
            name="description" 
            required 
            rows="3"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
          ></textarea>
        </div>
        
        <div>
          <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Notes (optional)</label>
          <textarea 
            id="notes" 
            name="notes" 
            rows="2"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
          ></textarea>
        </div>
        
        <div class="flex gap-4 pt-4">
          <button 
            type="submit" 
            class="flex-1 bg-purple-600 text-white px-6 py-2 rounded-lg hover:bg-purple-700 transition"
          >
            Save NPC
          </button>
          <button 
            type="button" 
            id="cancelModal"
            class="flex-1 bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 transition"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  const modal = document.getElementById('npcModal');
  const form = document.getElementById('npcForm') as HTMLFormElement;
  const modalTitle = document.getElementById('modalTitle');
  const addButton = document.getElementById('addNPC');
  const cancelButton = document.getElementById('cancelModal');

  let editingId: string | null = null;

  // Open modal for new NPC
  addButton?.addEventListener('click', () => {
    editingId = null;
    form.reset();
    if (modalTitle) modalTitle.textContent = 'New NPC';
    modal?.classList.remove('hidden');
  });

  // Close modal
  cancelButton?.addEventListener('click', () => {
    modal?.classList.add('hidden');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
    }
  });

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const data = {
      name: formData.get('name'),
      race: formData.get('race'),
      occupation: formData.get('occupation') || undefined,
      location: formData.get('location') || undefined,
      relationship: formData.get('relationship'),
      description: formData.get('description'),
      notes: formData.get('notes') || undefined,
    };

    try {
      const url = editingId ? `/api/npcs/${editingId}` : '/api/npcs';
      const method = editingId ? 'PUT' : 'POST';
      
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        alert('Failed to save NPC. Please try again.');
      }
    } catch (error) {
      alert('An error occurred. Please try again.');
    }
  });

  // Edit NPC
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    
    if (target.classList.contains('edit-npc')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      try {
        const response = await fetch(`/api/npcs/${id}`);
        const npc = await response.json();
        
        editingId = id;
        (document.getElementById('name') as HTMLInputElement).value = npc.name;
        (document.getElementById('race') as HTMLInputElement).value = npc.race;
        (document.getElementById('occupation') as HTMLInputElement).value = npc.occupation || '';
        (document.getElementById('location') as HTMLInputElement).value = npc.location || '';
        (document.getElementById('relationship') as HTMLSelectElement).value = npc.relationship;
        (document.getElementById('description') as HTMLTextAreaElement).value = npc.description;
        (document.getElementById('notes') as HTMLTextAreaElement).value = npc.notes || '';
        
        if (modalTitle) modalTitle.textContent = 'Edit NPC';
        modal?.classList.remove('hidden');
      } catch (error) {
        alert('Failed to load NPC. Please try again.');
      }
    }
    
    // Delete NPC
    if (target.classList.contains('delete-npc')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      if (confirm('Are you sure you want to delete this NPC?')) {
        try {
          const response = await fetch(`/api/npcs/${id}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete NPC. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    }
  });
</script>
</script>

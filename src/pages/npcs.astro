---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { db, NPC, Location, PageSettings, eq } from 'astro:db';
import { isAuthenticated, getUserRole } from '../lib/auth';

const npcs = await db.select().from(NPC);
const locations = await db.select().from(Location);
const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);
const canEditHero = userRole === 'admin' || userRole === 'dungeonmaster';

const alliedNPCs = npcs.filter(n => n.relationship === 'ally');
const neutralNPCs = npcs.filter(n => n.relationship === 'neutral');
const enemyNPCs = npcs.filter(n => n.relationship === 'enemy');

// Get page settings for hero image
const pageSettings = await db.select().from(PageSettings).where(eq(PageSettings.pageName, 'npcs'));
const heroImageUrl = pageSettings.length > 0 ? pageSettings[0].heroImageUrl : null;
---

<Layout title="NPCs">
  <PageHero 
    title="Non-Player Characters" 
    heroImageUrl={heroImageUrl}
    pageName="npcs"
    canEditHero={canEditHero}
  />

  {isLoggedIn && (
    <div class="flex justify-end mb-4">
      <button 
        id="addNPC"
        class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 transition flex items-center gap-2 font-medium"
        title="Add new NPC"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Add NPC</span>
      </button>
    </div>
  )}

  <!-- Stats -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-primary-600 dark:text-primary-400">{npcs.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Total NPCs</div>
    </div>
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-green-600 dark:text-green-400">{alliedNPCs.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Allies</div>
    </div>
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-gray-600 dark:text-gray-400">{neutralNPCs.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Neutral</div>
    </div>
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-red-600 dark:text-red-400">{enemyNPCs.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Enemies</div>
    </div>
  </div>

  <!-- Search and Filter -->
  <div class="bg-white dark:bg-black rounded-lg shadow-md p-4 mb-6 dark:border dark:border-gray-900">
    <div class="flex flex-col md:flex-row gap-4">
      <!-- Search Input -->
      <div class="flex-1">
        <div class="relative">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Search NPCs by name, race, occupation, or location..."
            class="w-full px-4 py-2 pl-10 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100 transition"
          >
          <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>
      <!-- Relationship Filter -->
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-sm text-gray-600 dark:text-gray-400 font-medium">Filter:</span>
        <button class="filter-tab px-3 py-1.5 rounded-full text-sm font-medium bg-primary-600 text-white transition-all duration-200 hover:bg-primary-700 active:scale-95" data-filter="all">
          All ({npcs.length})
        </button>
        <button class="filter-tab px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95" data-filter="ally">
          Allies ({alliedNPCs.length})
        </button>
        <button class="filter-tab px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95" data-filter="neutral">
          Neutral ({neutralNPCs.length})
        </button>
        <button class="filter-tab px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95" data-filter="enemy">
          Enemies ({enemyNPCs.length})
        </button>
      </div>
    </div>
  </div>

  <div id="npcGrid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {npcs.map(npc => (
      <div class="npc-card bg-white dark:bg-black rounded-lg shadow-md overflow-hidden hover:shadow-lg transition dark:border dark:border-gray-900" data-relationship={npc.relationship} data-search={`${npc.name} ${npc.race} ${npc.occupation || ''} ${npc.location || ''} ${npc.description}`.toLowerCase()}>
        <a href={`/npcs/${npc.id}`} class="block">
          <div class="relative h-56 overflow-hidden">
            <!-- Blurred background -->
            {npc.avatarUrl ? (
              <>
                <img 
                  src={npc.avatarUrl} 
                  alt={npc.name}
                  class="absolute inset-0 w-full h-full object-cover blur-md scale-110"
                />
                <div class="absolute inset-0 bg-black/30"></div>
              </>
            ) : (
              <div class={`absolute inset-0 ${
                npc.relationship === 'ally' ? 'bg-gradient-to-br from-green-600 to-green-500' :
                npc.relationship === 'enemy' ? 'bg-gradient-to-br from-red-600 to-red-500' :
                'bg-gradient-to-br from-gray-600 to-gray-500'
              }`}></div>
            )}
            
            <!-- Circular avatar on top -->
            <div class="relative h-full flex items-center justify-center">
              {npc.avatarUrl ? (
                <img 
                  src={npc.avatarUrl} 
                  alt={npc.name}
                  class="w-32 h-32 rounded-full object-cover border-4 border-white dark:border-gray-800 shadow-xl"
                />
              ) : (
                <div class="w-32 h-32 bg-white dark:bg-gray-800 rounded-full flex items-center justify-center text-5xl font-bold text-primary-700 dark:text-primary-400 shadow-xl border-4 border-white dark:border-gray-700">
                  {npc.name.charAt(0)}
                </div>
              )}
            </div>
            
            <!-- Relationship badge -->
            <div class={`absolute top-3 right-3 text-white text-xs px-3 py-1 rounded-full shadow-lg ${
              npc.relationship === 'ally' ? 'bg-green-600/90' :
              npc.relationship === 'enemy' ? 'bg-red-600/90' :
              'bg-gray-600/90'
            }`}>
              {npc.relationship.charAt(0).toUpperCase() + npc.relationship.slice(1)}
            </div>
          </div>
        </a>

        <div class="p-6">
          <a href={`/npcs/${npc.id}`} class="block hover:text-primary-700 dark:hover:text-primary-400 transition">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">{npc.name}</h2>
            <p class="text-gray-600 dark:text-gray-400 mb-4">{npc.race} {npc.occupation && `• ${npc.occupation}`}</p>
          </a>

          {npc.location && (
            <div class="mb-3">
              <span class="text-sm text-gray-500 dark:text-gray-400">📍 Location: </span>
              <span class="text-sm font-medium dark:text-gray-200">{npc.location}</span>
            </div>
          )}

          <a 
            href={`/npcs/${npc.id}`}
            class="block mt-4 text-center bg-accent-100 dark:bg-accent-900/20 dark:border dark:border-accent-800 text-accent-700 dark:text-accent-400 px-4 py-2 rounded-lg hover:bg-accent-200 dark:hover:bg-accent-900/30 transition font-medium text-sm"
          >
            View Details →
          </a>

          {isLoggedIn && (
            <div class="flex gap-2 mt-3 justify-end items-center border-t dark:border-gray-800 pt-3">
              <button 
                class="edit-npc p-2 text-gray-500 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition cursor-pointer" 
                data-id={npc.id}
                title="Edit NPC"
                aria-label="Edit NPC"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
              </button>
              <button 
                class="delete-npc p-2 text-gray-500 hover:text-red-600 dark:text-gray-400 dark:hover:text-red-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition cursor-pointer" 
                data-id={npc.id}
                title="Delete NPC"
                aria-label="Delete NPC"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </button>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>

  {npcs.length === 0 && (
    <div class="text-center py-16 bg-white dark:bg-black rounded-lg shadow-md dark:border dark:border-gray-900">
      <p class="text-gray-500 dark:text-gray-400 text-lg">No NPCs yet. Start adding characters you've encountered!</p>
    </div>
  )}

  <!-- Modal for Add/Edit NPC -->
  <div id="npcModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white dark:bg-black rounded-lg p-4 sm:p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto dark:border dark:border-gray-900">
      <h2 id="modalTitle" class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6 text-primary-700 dark:text-primary-400">New NPC</h2>
      <form id="npcForm" class="space-y-4">
        <input type="hidden" id="npcId" name="id">
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Name</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
          </div>
          
          <div>
            <label for="race" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Race</label>
            <input 
              type="text" 
              id="race" 
              name="race" 
              required 
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="occupation" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Occupation (optional)</label>
            <input 
              type="text" 
              id="occupation" 
              name="occupation" 
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
          </div>
          
          <div>
            <label for="locationId" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Location (optional)</label>
            <select 
              id="locationId" 
              name="locationId" 
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
              <option value="">-- No Location --</option>
              {locations.map(location => (
                <option value={location.id}>{location.name}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="space-y-2">
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Avatar (optional)</label>
          <div class="space-y-2">
            <div>
              <label for="avatarFile" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">Upload Image (max 5MB)</label>
              <input 
                type="file" 
                id="avatarFile" 
                name="avatarFile" 
                accept="image/*"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div class="flex items-center gap-2">
              <div class="flex-1 h-px bg-gray-300 dark:bg-gray-600"></div>
              <span class="text-xs text-gray-500 dark:text-gray-400">OR</span>
              <div class="flex-1 h-px bg-gray-300 dark:bg-gray-600"></div>
            </div>
            <div>
              <label for="avatarUrl" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">Avatar URL</label>
              <input 
                type="text" 
                id="avatarUrl" 
                name="avatarUrl" 
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
                placeholder="https://example.com/image.jpg or /uploads/image.jpg"
              >
            </div>
          </div>
          <div id="avatarPreview" class="hidden mt-2">
            <img id="avatarPreviewImg" src="" alt="Preview" class="max-w-full h-32 object-cover rounded-lg">
          </div>
        </div>
        
        <div>
          <label for="relationship" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Relationship</label>
          <select 
            id="relationship" 
            name="relationship" 
            required
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          >
            <option value="ally">Ally</option>
            <option value="neutral" selected>Neutral</option>
            <option value="enemy">Enemy</option>
          </select>
        </div>
        
        <div>
          <label for="description" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Description</label>
          <textarea 
            id="description" 
            name="description" 
            required 
            rows="3"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          ></textarea>
        </div>
        
        <div>
          <label for="notes" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Notes (optional)</label>
          <textarea 
            id="notes" 
            name="notes" 
            rows="2"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          ></textarea>
        </div>
        
        <div class="flex gap-4 pt-4">
          <button 
            type="submit" 
            class="flex-1 bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
          >
            Save NPC
          </button>
          <button 
            type="button" 
            id="cancelModal"
            class="flex-1 bg-gray-300 dark:bg-gray-600 text-gray-700 dark:text-gray-200 px-6 py-2 rounded-lg hover:bg-gray-400 dark:hover:bg-gray-700 transition"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  // Shared state for editing NPC ID
  let editingId: string | null = null;

  // Initialize NPC modal and form functionality
  function initializeNPCModal() {
    const modal = document.getElementById('npcModal');
    const form = document.getElementById('npcForm') as HTMLFormElement;
    const modalTitle = document.getElementById('modalTitle');
    const addButton = document.getElementById('addNPC');
    const cancelButton = document.getElementById('cancelModal');

  // Open modal for new NPC
  addButton?.addEventListener('click', () => {
    editingId = null;
    form.reset();
    if (modalTitle) modalTitle.textContent = 'New NPC';
    modal?.classList.remove('hidden');
  });

  // Close modal
  cancelButton?.addEventListener('click', () => {
    modal?.classList.add('hidden');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
    }
  });

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    
    // Helper to convert empty strings to undefined for optional fields
    const getOptionalValue = (key: string) => {
      const value = formData.get(key) as string;
      return value?.trim() || undefined;
    };
    
    // Handle avatar upload
    let avatarUrl = getOptionalValue('avatarUrl');
    const avatarFile = formData.get('avatarFile') as File;
    
    if (avatarFile && avatarFile.size > 0) {
      try {
        const uploadFormData = new FormData();
        uploadFormData.append('file', avatarFile);
        
        const uploadResponse = await fetch('/api/upload', {
          method: 'POST',
          body: uploadFormData,
        });
        
        if (uploadResponse.ok) {
          const uploadData = await uploadResponse.json();
          avatarUrl = uploadData.url;
        } else {
          const error = await uploadResponse.json();
          alert(`Failed to upload avatar: ${error.error || 'Unknown error'}`);
          return;
        }
      } catch (error) {
        console.error('Upload error:', error);
        alert('Failed to upload avatar. Please try again.');
        return;
      }
    }
    
    const data = {
      name: formData.get('name'),
      race: formData.get('race'),
      occupation: getOptionalValue('occupation'),
      locationId: getOptionalValue('locationId'),
      relationship: formData.get('relationship'),
      description: formData.get('description'),
      notes: getOptionalValue('notes'),
      avatarUrl,
    };

    try {
      const url = editingId ? `/api/npcs/${editingId}` : '/api/npcs';
      const method = editingId ? 'PUT' : 'POST';
      
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        alert('Failed to save NPC. Please try again.');
      }
    } catch (error) {
      alert('An error occurred. Please try again.');
    }
  });

  // Handle avatar file preview
  const avatarFileInput = document.getElementById('avatarFile') as HTMLInputElement;
  const avatarUrlInput = document.getElementById('avatarUrl') as HTMLInputElement;
  const avatarPreview = document.getElementById('avatarPreview');
  const avatarPreviewImg = document.getElementById('avatarPreviewImg') as HTMLImageElement;

  avatarFileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file && avatarPreview && avatarPreviewImg) {
      const reader = new FileReader();
      reader.onload = (e) => {
        avatarPreviewImg.src = e.target?.result as string;
        avatarPreview.classList.remove('hidden');
      };
      reader.readAsDataURL(file);
      // Clear URL input when file is selected
      if (avatarUrlInput) avatarUrlInput.value = '';
    }
  });

  avatarUrlInput?.addEventListener('input', (e) => {
    const url = (e.target as HTMLInputElement).value;
    if (url && avatarPreview && avatarPreviewImg) {
      avatarPreviewImg.src = url;
      avatarPreview.classList.remove('hidden');
      // Clear file input when URL is entered
      if (avatarFileInput) avatarFileInput.value = '';
    } else if (avatarPreview) {
      avatarPreview.classList.add('hidden');
    }
  });

    // Check for edit parameter on page load and open modal if present
    const urlParams = new URLSearchParams(window.location.search);
    const editId = urlParams.get('edit');
    
    if (editId && modal && form && modalTitle) {
      (async () => {
        try {
          const response = await fetch(`/api/npcs/${editId}`);
          if (!response.ok) {
            throw new Error('NPC not found');
          }
          
          const npc = await response.json();
          
          editingId = editId;
          (document.getElementById('name') as HTMLInputElement).value = npc.name;
          (document.getElementById('race') as HTMLInputElement).value = npc.race;
          (document.getElementById('occupation') as HTMLInputElement).value = npc.occupation || '';
          (document.getElementById('locationId') as HTMLSelectElement).value = npc.locationId || '';
          (document.getElementById('relationship') as HTMLSelectElement).value = npc.relationship;
          (document.getElementById('description') as HTMLTextAreaElement).value = npc.description;
          (document.getElementById('notes') as HTMLTextAreaElement).value = npc.notes || '';
          (document.getElementById('avatarUrl') as HTMLInputElement).value = npc.avatarUrl || '';
          
          modalTitle.textContent = 'Edit NPC';
          modal.classList.remove('hidden');
          
          // Clear the URL parameter so refreshing doesn't re-open the modal
          window.history.replaceState({}, '', '/npcs');
        } catch (error) {
          console.error('Failed to load NPC for editing:', error);
          alert('Failed to load NPC. Please try again.');
        }
      })();
    }
  }

  // Edit/Delete NPCs with event delegation
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    
    if (target.classList.contains('edit-npc')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      // Get DOM elements fresh
      const modal = document.getElementById('npcModal');
      const modalTitle = document.getElementById('modalTitle');
      
      try {
        const response = await fetch(`/api/npcs/${id}`);
        if (!response.ok) {
          throw new Error('Failed to fetch NPC');
        }
        const npc = await response.json();
        
        editingId = id;
        (document.getElementById('name') as HTMLInputElement).value = npc.name;
        (document.getElementById('race') as HTMLInputElement).value = npc.race;
        (document.getElementById('occupation') as HTMLInputElement).value = npc.occupation || '';
        (document.getElementById('locationId') as HTMLSelectElement).value = npc.locationId || '';
        (document.getElementById('relationship') as HTMLSelectElement).value = npc.relationship;
        (document.getElementById('description') as HTMLTextAreaElement).value = npc.description;
        (document.getElementById('notes') as HTMLTextAreaElement).value = npc.notes || '';
        (document.getElementById('avatarUrl') as HTMLInputElement).value = npc.avatarUrl || '';
        
        if (modalTitle) modalTitle.textContent = 'Edit NPC';
        modal?.classList.remove('hidden');
      } catch (error) {
        console.error('Failed to load NPC:', error);
        alert('Failed to load NPC. Please try again.');
      }
    }
    
    // Delete NPC
    if (target.classList.contains('delete-npc')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      if (confirm('Are you sure you want to delete this NPC?')) {
        try {
          const response = await fetch(`/api/npcs/${id}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete NPC. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    }
  });

  // Initialize search and filter functionality on page load
  // This ensures it works after Astro View Transitions navigation
  function initializeFilters() {
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const filterTabs = document.querySelectorAll('.filter-tab');
    const npcCards = document.querySelectorAll('.npc-card');
    
    let currentFilter = 'all';
    let currentSearch = '';

    const applyFilters = () => {
      const searchTerms = currentSearch.toLowerCase().split(/\s+/).filter(term => term.length > 0);
      npcCards.forEach(card => {
        const relationship = card.getAttribute('data-relationship') || '';
        const searchText = card.getAttribute('data-search') || '';
        
        const matchesFilter = currentFilter === 'all' || relationship === currentFilter;
        // Match if ANY search term is found in the text (more flexible search)
        const matchesSearch = searchTerms.length === 0 || searchTerms.some(term => searchText.includes(term));
        
        (card as HTMLElement).style.display = matchesFilter && matchesSearch ? 'block' : 'none';
      });
    };

    // Search functionality
    searchInput?.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    // Filter functionality
    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        currentFilter = tab.getAttribute('data-filter') || 'all';
        
        // Update button styles
        filterTabs.forEach(t => {
          if (t.getAttribute('data-filter') === currentFilter) {
            t.classList.remove('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
            t.classList.add('bg-primary-600', 'text-white');
          } else {
            t.classList.remove('bg-primary-600', 'text-white');
            t.classList.add('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
          }
        });
        
        applyFilters();
      });
    });
  }

  // Run on initial page load and after View Transitions navigation
  document.addEventListener('astro:page-load', () => {
    initializeNPCModal();
    initializeFilters();
  });
</script>

---
import Layout from '../layouts/Layout.astro';
import { db, NPC, Location } from 'astro:db';
import { isAuthenticated } from '../lib/auth';

const npcs = await db.select().from(NPC);
const locations = await db.select().from(Location);
const isLoggedIn = isAuthenticated(Astro.cookies);

const alliedNPCs = npcs.filter(n => n.relationship === 'ally');
const neutralNPCs = npcs.filter(n => n.relationship === 'neutral');
const enemyNPCs = npcs.filter(n => n.relationship === 'enemy');
---

<Layout title="NPCs">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold text-primary-700">Non-Player Characters</h1>
    {isLoggedIn && (
      <button 
        id="addNPC"
        class="bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 transition"
      >
        + Add NPC
      </button>
    )}
  </div>

  <!-- Filter tabs -->
  <div class="flex gap-4 mb-6 border-b">
    <button class="filter-tab px-4 py-2 border-b-2 border-primary-600 text-primary-600 font-semibold" data-filter="all">
      All ({npcs.length})
    </button>
    <button class="filter-tab px-4 py-2 text-gray-600 hover:text-primary-600" data-filter="ally">
      Allies ({alliedNPCs.length})
    </button>
    <button class="filter-tab px-4 py-2 text-gray-600 hover:text-primary-600" data-filter="neutral">
      Neutral ({neutralNPCs.length})
    </button>
    <button class="filter-tab px-4 py-2 text-gray-600 hover:text-primary-600" data-filter="enemy">
      Enemies ({enemyNPCs.length})
    </button>
  </div>

  <div id="npcGrid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {npcs.map(npc => (
      <div class="npc-card bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition" data-relationship={npc.relationship}>
        <a href={`/npcs/${npc.id}`} class="block">
          <div class={`h-24 flex items-center justify-center ${
            npc.relationship === 'ally' ? 'bg-gradient-to-r from-green-600 to-green-500' :
            npc.relationship === 'enemy' ? 'bg-gradient-to-r from-red-600 to-red-500' :
            'bg-gradient-to-r from-gray-600 to-gray-500'
          }`}>
            {npc.avatarUrl ? (
              <img 
                src={npc.avatarUrl} 
                alt={npc.name}
                class="w-16 h-16 rounded-full object-cover border-2 border-white"
              />
            ) : (
              <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center text-3xl font-bold text-gray-700">
                {npc.name.charAt(0)}
              </div>
            )}
          </div>
        </a>

        <div class="p-6">
          <a href={`/npcs/${npc.id}`} class="block hover:text-primary-700 transition">
            <div class="flex justify-between items-start mb-2">
              <h2 class="text-2xl font-bold text-gray-900">{npc.name}</h2>
              <span class={`px-3 py-1 rounded-full text-sm font-medium ${
                npc.relationship === 'ally' ? 'bg-green-100 text-green-700' :
                npc.relationship === 'enemy' ? 'bg-red-100 text-red-700' :
                'bg-gray-100 text-gray-700'
              }`}>
                {npc.relationship}
              </span>
            </div>
            <p class="text-gray-600 mb-4">{npc.race} {npc.occupation && `• ${npc.occupation}`}</p>
          </a>

          <div class="mb-4">
            <p class="text-gray-700 line-clamp-3">{npc.description}</p>
          </div>

          {npc.location && (
            <div class="mb-3">
              <span class="text-sm text-gray-500">📍 Location: </span>
              <span class="text-sm font-medium">{npc.location}</span>
            </div>
          )}

          <a 
            href={`/npcs/${npc.id}`}
            class="block mt-4 text-center bg-accent-100 text-accent-700 px-4 py-2 rounded hover:bg-accent-200 transition font-medium"
          >
            View Details →
          </a>

          {isLoggedIn && (
            <div class="flex gap-2 mt-2">
              <button class="edit-npc flex-1 bg-primary-600 text-white px-4 py-2 rounded hover:bg-primary-700 transition" data-id={npc.id}>
                Edit
              </button>
              <button class="delete-npc px-4 py-2 border border-red-300 text-red-600 rounded hover:bg-red-50 transition" data-id={npc.id}>
                Delete
              </button>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>

  {npcs.length === 0 && (
    <div class="text-center py-16 bg-white rounded-lg shadow-md">
      <p class="text-gray-500 text-lg">No NPCs yet. Start adding characters you've encountered!</p>
    </div>
  )}

  <!-- Modal for Add/Edit NPC -->
  <div id="npcModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-lg p-4 sm:p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <h2 id="modalTitle" class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6 text-primary-700">New NPC</h2>
      <form id="npcForm" class="space-y-4">
        <input type="hidden" id="npcId" name="id">
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
          </div>
          
          <div>
            <label for="race" class="block text-sm font-medium text-gray-700 mb-1">Race</label>
            <input 
              type="text" 
              id="race" 
              name="race" 
              required 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="occupation" class="block text-sm font-medium text-gray-700 mb-1">Occupation (optional)</label>
            <input 
              type="text" 
              id="occupation" 
              name="occupation" 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
          </div>
          
          <div>
            <label for="locationId" class="block text-sm font-medium text-gray-700 mb-1">Location (optional)</label>
            <select 
              id="locationId" 
              name="locationId" 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
              <option value="">-- No Location --</option>
              {locations.map(location => (
                <option value={location.id}>{location.name}</option>
              ))}
            </select>
          </div>
        </div>

        <div>
          <label for="avatarUrl" class="block text-sm font-medium text-gray-700 mb-1">Avatar URL (optional)</label>
          <input 
            type="url" 
            id="avatarUrl" 
            name="avatarUrl" 
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            placeholder="https://example.com/image.jpg"
          >
        </div>
        
        <div>
          <label for="relationship" class="block text-sm font-medium text-gray-700 mb-1">Relationship</label>
          <select 
            id="relationship" 
            name="relationship" 
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
          >
            <option value="ally">Ally</option>
            <option value="neutral" selected>Neutral</option>
            <option value="enemy">Enemy</option>
          </select>
        </div>
        
        <div>
          <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
          <textarea 
            id="description" 
            name="description" 
            required 
            rows="3"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
          ></textarea>
        </div>
        
        <div>
          <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Notes (optional)</label>
          <textarea 
            id="notes" 
            name="notes" 
            rows="2"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
          ></textarea>
        </div>
        
        <div class="flex gap-4 pt-4">
          <button 
            type="submit" 
            class="flex-1 bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 transition"
          >
            Save NPC
          </button>
          <button 
            type="button" 
            id="cancelModal"
            class="flex-1 bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 transition"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  const modal = document.getElementById('npcModal');
  const form = document.getElementById('npcForm') as HTMLFormElement;
  const modalTitle = document.getElementById('modalTitle');
  const addButton = document.getElementById('addNPC');
  const cancelButton = document.getElementById('cancelModal');

  let editingId: string | null = null;

  // Open modal for new NPC
  addButton?.addEventListener('click', () => {
    editingId = null;
    form.reset();
    if (modalTitle) modalTitle.textContent = 'New NPC';
    modal?.classList.remove('hidden');
  });

  // Close modal
  cancelButton?.addEventListener('click', () => {
    modal?.classList.add('hidden');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
    }
  });

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    
    // Helper to convert empty strings to undefined for optional fields
    const getOptionalValue = (key: string) => {
      const value = formData.get(key) as string;
      return value?.trim() || undefined;
    };
    
    const data = {
      name: formData.get('name'),
      race: formData.get('race'),
      occupation: getOptionalValue('occupation'),
      locationId: getOptionalValue('locationId'),
      relationship: formData.get('relationship'),
      description: formData.get('description'),
      notes: getOptionalValue('notes'),
      avatarUrl: getOptionalValue('avatarUrl'),
    };

    try {
      const url = editingId ? `/api/npcs/${editingId}` : '/api/npcs';
      const method = editingId ? 'PUT' : 'POST';
      
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        alert('Failed to save NPC. Please try again.');
      }
    } catch (error) {
      alert('An error occurred. Please try again.');
    }
  });

  // Edit NPC
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    
    if (target.classList.contains('edit-npc')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      try {
        const response = await fetch(`/api/npcs/${id}`);
        const npc = await response.json();
        
        editingId = id;
        (document.getElementById('name') as HTMLInputElement).value = npc.name;
        (document.getElementById('race') as HTMLInputElement).value = npc.race;
        (document.getElementById('occupation') as HTMLInputElement).value = npc.occupation || '';
        (document.getElementById('locationId') as HTMLSelectElement).value = npc.locationId || '';
        (document.getElementById('relationship') as HTMLSelectElement).value = npc.relationship;
        (document.getElementById('description') as HTMLTextAreaElement).value = npc.description;
        (document.getElementById('notes') as HTMLTextAreaElement).value = npc.notes || '';
        (document.getElementById('avatarUrl') as HTMLInputElement).value = npc.avatarUrl || '';
        
        if (modalTitle) modalTitle.textContent = 'Edit NPC';
        modal?.classList.remove('hidden');
      } catch (error) {
        alert('Failed to load NPC. Please try again.');
      }
    }
    
    // Delete NPC
    if (target.classList.contains('delete-npc')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      if (confirm('Are you sure you want to delete this NPC?')) {
        try {
          const response = await fetch(`/api/npcs/${id}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete NPC. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    }
  });

  // Tab filtering functionality
  const filterTabs = document.querySelectorAll('.filter-tab');
  const npcCards = document.querySelectorAll('.npc-card');
  
  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const filter = tab.getAttribute('data-filter');
      
      // Update active tab
      filterTabs.forEach(t => {
        t.classList.remove('border-primary-600', 'text-primary-600', 'font-semibold');
        t.classList.add('text-gray-600');
      });
      tab.classList.add('border-primary-600', 'text-primary-600', 'font-semibold');
      tab.classList.remove('text-gray-600');
      
      // Filter NPCs
      npcCards.forEach(card => {
        const relationship = card.getAttribute('data-relationship');
        if (filter === 'all' || relationship === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });

  // Check for edit parameter on page load and open modal if present
  (async () => {
    const urlParams = new URLSearchParams(window.location.search);
    const editId = urlParams.get('edit');
    
    if (editId && modal && form && modalTitle) {
      try {
        const response = await fetch(`/api/npcs/${editId}`);
        if (!response.ok) {
          throw new Error('NPC not found');
        }
        
        const npc = await response.json();
        
        editingId = editId;
        (document.getElementById('name') as HTMLInputElement).value = npc.name;
        (document.getElementById('race') as HTMLInputElement).value = npc.race;
        (document.getElementById('occupation') as HTMLInputElement).value = npc.occupation || '';
        (document.getElementById('locationId') as HTMLSelectElement).value = npc.locationId || '';
        (document.getElementById('relationship') as HTMLSelectElement).value = npc.relationship;
        (document.getElementById('description') as HTMLTextAreaElement).value = npc.description;
        (document.getElementById('notes') as HTMLTextAreaElement).value = npc.notes || '';
        (document.getElementById('avatarUrl') as HTMLInputElement).value = npc.avatarUrl || '';
        
        modalTitle.textContent = 'Edit NPC';
        modal.classList.remove('hidden');
        
        // Clear the URL parameter so refreshing doesn't re-open the modal
        window.history.replaceState({}, '', '/npcs');
      } catch (error) {
        console.error('Failed to load NPC for editing:', error);
        alert('Failed to load NPC. Please try again.');
      }
    }
  })();
</script>

---
import Layout from '../../layouts/Layout.astro';
import SceneBackdrop from '../../components/SceneBackdrop.astro';
import Button from '../../components/Button.astro';
import { db, LibraryEntry, Location, eq } from '@/db';
import { isAuthenticated } from '../../lib/auth';
import { renderMarkdown } from '../../utils/markdown';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/library/docs');
}

const entries = await db.select().from(LibraryEntry).where(eq(LibraryEntry.id, id));

if (entries.length === 0) {
  return Astro.redirect('/library/docs');
}

const entry = entries[0];
const isLoggedIn = isAuthenticated(Astro.cookies);

// Get location if connected
let location = null;
if (entry.locationId) {
  const locations = await db.select().from(Location).where(eq(Location.id, entry.locationId));
  if (locations.length > 0) {
    location = locations[0];
  }
}

// Render markdown content
const renderedContent = renderMarkdown(entry.content);
---

<Layout title={entry.title}>
  <SceneBackdrop imageUrl={null} />
  <div class="max-w-4xl mx-auto">
    <!-- Header with Back Button -->
    <div class="flex items-center justify-between mb-6">
      <a href="/library/docs" class="t-back-link">
        <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        All documents
      </a>
      {isLoggedIn && (
        <div class="flex gap-2">
          <button 
            id="editEntry"
            data-id={entry.id}
            class="t-icon-btn"
            title="Edit entry"
            aria-label="Edit entry"
          >
            <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
          </button>
          <button 
            id="deleteEntry"
            data-id={entry.id}
            class="t-icon-btn t-icon-btn-danger"
            title="Delete entry"
            aria-label="Delete entry"
          >
            <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </button>
        </div>
      )}
    </div>

    <!-- Entry Header -->
    <article class="t-panel p-6 sm:p-8 mb-6">
      <h1 class="font-display italic font-semibold text-4xl mb-4" style="color:var(--gold);">{entry.title}</h1>
      
      <!-- Metadata -->
      {location && (
        <div class="flex gap-4 text-sm t-muted mb-6">
          <a href={`/locations/${location.id}`} class="t-link flex items-center gap-1">
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Found at: {location.name}
          </a>
        </div>
      )}

      <!-- Tags -->
      {Array.isArray(entry.tags) && entry.tags.length > 0 && (
        <div class="flex gap-2 flex-wrap mb-6">
          {entry.tags.map((tag: string) => (
            <a 
              href={`/library/docs?tag=${encodeURIComponent(tag)}`}
              class="t-badge t-badge-gold"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}

      <!-- Content -->
      <div class="t-prose max-w-none">
        <div 
          class="t-prose text-lg leading-relaxed"
          set:html={renderedContent}
        />
      </div>
    </article>
  </div>
</Layout>

<script>
  function initializeDetailPage() {
    const editBtn = document.getElementById('editEntry');
    const deleteBtn = document.getElementById('deleteEntry');
    
    editBtn?.addEventListener('click', () => {
      const entryId = editBtn.getAttribute('data-id');
      if (entryId) {
        window.location.href = `/library/docs?edit=${entryId}`;
      }
    });
    
    deleteBtn?.addEventListener('click', async () => {
      if (confirm('Are you sure you want to delete this entry? This action cannot be undone.')) {
        const entryId = deleteBtn.getAttribute('data-id');
        if (!entryId) return;
        
        try {
          const response = await fetch(`/api/library/${entryId}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.href = '/library/docs';
          } else {
            alert('Failed to delete entry. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    });
  }

  // Run on initial page load and after View Transitions navigation
  document.addEventListener('astro:page-load', initializeDetailPage);
</script>

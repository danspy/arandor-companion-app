---
// The campaign timeline as a chronicle: one vertical spine, events as cards (each with its own page,
// /library/timeline/[id]), labels as short notes on the spine, long stretches collapsed into a gap
// marker, and an overview bar on a true scale. /library/timeline#<id> jumps to an entry;
// ?edit=<id> opens the edit form (the detail page's Edit button).
import Layout from '../../layouts/Layout.astro';
import { MONTH_NAMES } from '../../lib/fantasy-calendar';
import { chronicle, overviewMarks } from '../../lib/timeline-layout';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import { db, TimelineEntry, DiaryEntry, LibraryEntry, NPC, Location, Character, Quest, PageSettings, eq } from '@/db';
import { isAuthenticated, getUserRole } from '../../lib/auth';

const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);
const canEditHero = userRole === 'admin' || userRole === 'dungeonmaster';

const timelineEntries = await db.select().from(TimelineEntry);
const items = chronicle(timelineEntries);
const marks = overviewMarks(timelineEntries);
const firstYear = marks[0]?.year;
const lastYear = marks[marks.length - 1]?.year;

// Only names and avatars: full rows would hand every visitor the private character sheet
const characters = await db.select({ id: Character.id, name: Character.name, avatarUrl: Character.avatarUrl }).from(Character);
const characterMap = new Map(characters.map(c => [c.id, c]));
const linkedCharacters = (ids: unknown) => (Array.isArray(ids) ? ids : []).map(id => characterMap.get(id)).filter(c => c != null);

// The edit form's choices, only for those who can edit
const [diaryEntries, libraryEntries, npcs, locations, quests] = isLoggedIn ? await Promise.all([
  db.select({ id: DiaryEntry.id, session: DiaryEntry.session, title: DiaryEntry.title }).from(DiaryEntry),
  db.select({ id: LibraryEntry.id, title: LibraryEntry.title }).from(LibraryEntry),
  db.select({ id: NPC.id, name: NPC.name }).from(NPC),
  db.select({ id: Location.id, name: Location.name }).from(Location),
  db.select({ id: Quest.id, title: Quest.title }).from(Quest),
]) : [[], [], [], [], []];

// Events alternate sides of the spine on wide screens
let eventIndex = 0;
const side = () => (eventIndex++ % 2 === 0 ? 'is-left' : 'is-right');

const pageSettings = await db.select().from(PageSettings).where(eq(PageSettings.pageName, 'timeline'));
const heroImageUrl = pageSettings.length > 0 ? pageSettings[0].heroImageUrl : null;

const editIcon = 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z';
const deleteIcon = 'M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16';
---

<Layout title="Timeline">
  <PageHero
    title="Campaign Timeline"
    heroImageUrl={heroImageUrl}
    pageName="timeline"
    canEditHero={canEditHero}
  >
    <Fragment slot="actions">
      {isLoggedIn && (
        <Button variant="primary" size="md" icon="add" id="addTimelineEntry" title="Add new Timeline Entry">
          Add entry
        </Button>
      )}
    </Fragment>
  </PageHero>

  {timelineEntries.length === 0 && (
    <div class="t-panel text-center py-16">
      <p class="t-faint text-lg">No timeline entries yet. Start documenting your campaign history!</p>
    </div>
  )}

  {marks.length > 0 && (
    <nav class="tl-overview" aria-label="Timeline overview">
      <div class="tl-ov-track" data-first={firstYear} data-last={lastYear}>
        <span class="tl-ov-window" aria-hidden="true"></span>
        {marks.map(m => (
          <a href={`#${m.id}`} class={`tl-ov-mark is-${m.kind}`} style={`left:${m.pct}%`} data-jump={m.id}
            title={`${m.year}: ${timelineEntries.find(e => e.id === m.id)?.[m.kind === 'label' ? 'label' : 'headline'] ?? ''}`}>
            <span class="sr-only">{m.year}</span>
          </a>
        ))}
      </div>
      <div class="tl-ov-scale" aria-hidden="true"><span>{firstYear}</span><span>{lastYear}</span></div>
    </nav>
  )}

  <ol class="tl-chronicle">
    {items.map(item => item.kind === 'gap' ? (
      <li class="tl-gap"><span>· {item.years} years ·</span></li>
    ) : (
      <li class="tl-year" data-year={item.year}>
        <div class="tl-year-head">
          <div class="tl-year-badge">{item.year}</div>
          {item.entries.some(e => e.entryType === 'label') && <div class="tl-year-notes">{item.entries.filter(e => e.entryType === 'label').map(entry => (
            <div id={entry.id} class="tl-note">
              <span class="tl-diamond" aria-hidden="true"></span>
              <span class="tl-note-text">{entry.month ? `${MONTH_NAMES[entry.month]} · ` : ''}{entry.label}</span>
              {isLoggedIn && (
                <span class="tl-actions">
                  <button class="edit-timeline-entry t-icon-btn" data-id={entry.id} title="Edit note" aria-label="Edit note">
                    <svg class="w-3.5 h-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={editIcon}></path></svg>
                  </button>
                  <button class="delete-timeline-entry t-icon-btn t-icon-btn-danger" data-id={entry.id} title="Delete note" aria-label="Delete note">
                    <svg class="w-3.5 h-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={deleteIcon}></path></svg>
                  </button>
                </span>
              )}
            </div>
          ))}</div>}
        </div>
        {item.entries.some(e => e.entryType !== 'label') && <ol class="tl-entries">
          {item.entries.filter(e => e.entryType !== 'label').map(entry => (
            <li id={entry.id} class={`tl-event ${side()}`}>
              <span class="tl-dot" aria-hidden="true"></span>
              <article class="t-panel tl-card">
                {entry.imageUrl && <img src={entry.imageUrl} alt="" class="tl-card-img" loading="lazy" />}
                <div class="tl-card-body">
                  <div class="tl-card-date">{entry.month ? `${MONTH_NAMES[entry.month]} ` : ''}{entry.year}</div>
                  <h3 class="tl-card-title"><a href={`/library/timeline/${entry.id}`} class="tl-card-link">{entry.headline}</a></h3>
                  {entry.shortDescription && <p class="tl-card-text">{entry.shortDescription}</p>}
                  {linkedCharacters(entry.characterIds).length > 0 && (
                    <ul class="tl-card-people" aria-label="Characters">
                      {linkedCharacters(entry.characterIds).map(c => (
                        <li title={c.name}>
                          {c.avatarUrl ? <img src={c.avatarUrl} alt={c.name} loading="lazy" /> : <span>{c.name.charAt(0)}</span>}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
                {isLoggedIn && (
                  <span class="tl-actions tl-card-actions">
                    <button class="edit-timeline-entry t-icon-btn" data-id={entry.id} title="Edit event" aria-label="Edit event">
                      <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={editIcon}></path></svg>
                    </button>
                    <button class="delete-timeline-entry t-icon-btn t-icon-btn-danger" data-id={entry.id} title="Delete event" aria-label="Delete event">
                      <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={deleteIcon}></path></svg>
                    </button>
                  </span>
                )}
              </article>
            </li>
          ))}
        </ol>}
      </li>
    ))}
  </ol>

  {isLoggedIn && (
  <div id="timelineEntryModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-xs flex items-center justify-center z-50 p-4 modal-overlay-safe">
    <div class="t-modal-panel p-6 sm:p-8 max-w-4xl w-full max-h-[90vh] overflow-y-auto modal-content-safe">
      <h2 id="timelineModalTitle" class="font-display italic font-semibold text-2xl mb-6" style="color:var(--gold);">New Timeline Entry</h2>
      <form id="timelineEntryForm" class="space-y-6">
        <input type="hidden" id="timelineEntryId" name="id">
        
        <div>
          <label for="entryType" class="t-label block mb-1">Entry Type</label>
          <select 
            id="entryType" 
            name="entryType" 
            class="t-input px-4 py-2"
          >
            <option value="event">Event</option>
            <option value="label">Note</option>
          </select>
          <p class="t-faint text-xs mt-1">Events are cards with their own page. Notes are a short line on the timeline, e.g. “Anvil brennt”.</p>
        </div>
        
        {/* Label fields (only for labels) */}
        <div id="labelFieldContainer" style="display: none;">
          <div>
            <label for="labelYear" class="t-label block mb-1">
              Year <span class="text-red-500">*</span>
            </label>
            <input 
              type="number" 
              id="labelYear" 
              name="labelYear" 
              placeholder="e.g., 500"
              class="t-input px-4 py-2"
            />
            <p class="t-faint text-xs mt-1">The note sits under this year on the timeline</p>
          </div>
          
          <div>
            <label for="label" class="t-label block mb-1">Note <span class="text-red-500">*</span></label>
            <input 
              type="text" 
              id="label" 
              name="label" 
              placeholder="e.g., Anvil brennt"
              class="t-input px-4 py-2"
            />
            <p class="t-faint text-xs mt-1">One short line; notes have no page of their own</p>
          </div>
        </div>
        
        {/* Event fields (only for events) */}
        <div id="eventFieldsContainer">
          <div>
            <label for="year" class="t-label block mb-1">
              Year <span class="text-red-500">*</span>
              <span class="t-faint text-xs ml-2">(numeric, e.g., 0, 900, 1492)</span>
            </label>
            <input 
              type="number" 
              id="year" 
              name="year" 
              placeholder="e.g., 900"
              class="t-input px-4 py-2"
            />
          </div>
          
          <div>
            <label for="month" class="t-label block mb-1">Month (optional)</label>
            <select 
              id="month" 
              name="month"
              class="t-input px-4 py-2"
            >
              <option value="">-- Select Month --</option>
              <option value="1">Jalun</option>
              <option value="2">Forun</option>
              <option value="3">Myrt</option>
              <option value="4">Adrel</option>
              <option value="5">Mel</option>
              <option value="6">Juton</option>
              <option value="7">Jilu</option>
              <option value="8">Aykast</option>
              <option value="9">Sibton</option>
              <option value="10">Oni</option>
              <option value="11">Novrum</option>
              <option value="12">Decetra</option>
            </select>
          </div>
          
          <div>
            <label for="headline" class="t-label block mb-1">Headline <span class="text-red-500">*</span></label>
            <input 
              type="text" 
              id="headline" 
              name="headline" 
              class="t-input px-4 py-2"
            />
          </div>
          
          <div>
            <label for="shortDescription" class="t-label block mb-1">Short Description (optional)</label>
            <textarea 
              id="shortDescription" 
              name="shortDescription" 
              rows="3"
              class="t-input px-4 py-2"
            ></textarea>
          </div>
          
          <div>
            <label for="fullDescription" class="t-label block mb-1">
              Full Description (optional, Markdown supported)
              <a href="https://www.markdownguide.org/basic-syntax/" target="_blank" class="t-link text-xs ml-2">
                Markdown Guide ↗
              </a>
            </label>
            <textarea 
              id="fullDescription" 
              name="fullDescription" 
              rows="8"
              class="t-input w-full px-4 py-2 font-mono text-sm"
            ></textarea>
          </div>
          
          <div>
            <label class="t-label block mb-1">Image (optional)</label>
            <div class="space-y-3">
              <div>
                <label for="imageFile" class="t-faint text-xs block mb-1">Upload Image (max 5MB)</label>
                <input 
                  type="file" 
                  id="imageFile" 
                  name="imageFile" 
                  accept="image/*"
                  class="t-input px-4 py-2"
                />
              </div>
              <div class="t-faint text-sm text-center">— OR —</div>
              <div>
                <label for="imageUrl" class="t-faint text-xs block mb-1">Image URL</label>
                <input 
                  type="text" 
                  id="imageUrl" 
                  name="imageUrl" 
                  placeholder="https://example.com/image.jpg or /uploads/image.jpg"
                  class="t-input px-4 py-2"
                />
                <p class="t-faint text-xs mt-1">External URL or uploaded image path</p>
              </div>
            </div>
            
            {/* Image Preview */}
            <div id="imagePreview" class="hidden mt-4">
              <img id="previewImg" src="" alt="Preview" class="max-w-full h-48 object-cover rounded-xs" />
            </div>
          </div>
          
          <div class="pt-4" style="border-top:1px solid var(--border);">
            <h3 class="t-body-text text-lg font-semibold mb-4">Connections (optional)</h3>
            <p class="t-muted text-sm mb-4">Select entries to connect to this timeline event</p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="diaryEntryIds" class="t-label block mb-1">Diary Entries</label>
              <select 
                id="diaryEntryIds" 
                name="diaryEntryIds" 
                multiple 
                size="4"
                class="t-input px-4 py-2"
              >
                {diaryEntries.map(entry => (
                  <option value={entry.id}>Session {entry.session}: {entry.title}</option>
                ))}
              </select>
              <p class="t-faint text-xs mt-1">Hold Ctrl/Cmd to select multiple</p>
            </div>
            
            <div>
              <label for="libraryDocsEntryIds" class="t-label block mb-1">Library Docs</label>
              <select 
                id="libraryDocsEntryIds" 
                name="libraryDocsEntryIds" 
                multiple 
                size="4"
                class="t-input px-4 py-2"
              >
                {libraryEntries.map(entry => (
                  <option value={entry.id}>{entry.title}</option>
                ))}
              </select>
              <p class="t-faint text-xs mt-1">Hold Ctrl/Cmd to select multiple</p>
            </div>
            
            <div>
              <label for="npcIds" class="t-label block mb-1">NPCs</label>
              <select 
                id="npcIds" 
                name="npcIds" 
                multiple 
                size="4"
                class="t-input px-4 py-2"
              >
                {npcs.map(npc => (
                  <option value={npc.id}>{npc.name}</option>
                ))}
              </select>
              <p class="t-faint text-xs mt-1">Hold Ctrl/Cmd to select multiple</p>
            </div>
            
            <div>
              <label for="locationIds" class="t-label block mb-1">Locations</label>
              <select 
                id="locationIds" 
                name="locationIds" 
                multiple 
                size="4"
                class="t-input px-4 py-2"
              >
                {locations.map(location => (
                  <option value={location.id}>{location.name}</option>
                ))}
              </select>
              <p class="t-faint text-xs mt-1">Hold Ctrl/Cmd to select multiple</p>
            </div>
            
            <div>
              <label for="characterIds" class="t-label block mb-1">Characters</label>
              <select 
                id="characterIds" 
                name="characterIds" 
                multiple 
                size="4"
                class="t-input px-4 py-2"
              >
                {characters.map(character => (
                  <option value={character.id}>{character.name}</option>
                ))}
              </select>
              <p class="t-faint text-xs mt-1">Hold Ctrl/Cmd to select multiple</p>
            </div>
            
            <div>
              <label for="questIds" class="t-label block mb-1">Quests</label>
              <select 
                id="questIds" 
                name="questIds" 
                multiple 
                size="4"
                class="t-input px-4 py-2"
              >
                {quests.map(quest => (
                  <option value={quest.id}>{quest.title}</option>
                ))}
              </select>
              <p class="t-faint text-xs mt-1">Hold Ctrl/Cmd to select multiple</p>
            </div>
          </div>
        </div>
        </div>
        
        <div class="flex gap-4 pt-4">
          <button 
            type="submit" 
            class="t-btn-primary flex-1 px-6 py-2"
          >
            Save entry
          </button>
          <button 
            type="button" 
            id="cancelTimelineModal"
            class="t-btn-secondary flex-1 px-6 py-2"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
  )}
</Layout>

<script>
  // Bundled once; astro:page-load fires after every navigation and every soft refresh (fresh DOM),
  // so each run binds to new elements and nothing is bound twice.
  const $ = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as T | null;

  // Scroll an entry into view and let it glow for a moment
  function focusEntry(id: string, smooth = true) {
    const el = document.getElementById(id);
    if (!el) return;
    el.scrollIntoView({ block: 'center', behavior: smooth ? 'smooth' : 'auto' });
    el.classList.remove('tl-flash');
    void el.offsetWidth; // restart the animation
    el.classList.add('tl-flash');
  }

  // The overview bar's band: which years are on screen right now
  function trackWindow() {
    const track = document.querySelector<HTMLElement>('.tl-ov-track');
    const band = document.querySelector<HTMLElement>('.tl-ov-window');
    if (!track || !band) return () => {};
    const first = Number(track.dataset.first), span = Number(track.dataset.last) - first;
    const years = [...document.querySelectorAll<HTMLElement>('.tl-year')];
    let queued = false;
    const update = () => {
      queued = false;
      const visible = years.filter((y) => { const r = y.getBoundingClientRect(); return r.bottom > 0 && r.top < innerHeight; })
        .map((y) => Number(y.dataset.year));
      if (!visible.length || !span) { band.style.opacity = '0'; return; }
      const from = ((Math.min(...visible) - first) / span) * 100, to = ((Math.max(...visible) - first) / span) * 100;
      band.style.opacity = '1';
      band.style.left = `${from}%`;
      band.style.width = `max(6px, ${to - from}%)`;
    };
    const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();
    return () => { removeEventListener('scroll', onScroll); removeEventListener('resize', onScroll); };
  }

  function initEditing() {
    const modal = $<HTMLDivElement>('timelineEntryModal');
    const form = $<HTMLFormElement>('timelineEntryForm');
    if (!modal || !form) return;
    const modalTitle = $<HTMLHeadingElement>('timelineModalTitle')!;
    const entryType = $<HTMLSelectElement>('entryType')!;
    const eventFields = $<HTMLDivElement>('eventFieldsContainer')!;
    const labelFields = $<HTMLDivElement>('labelFieldContainer')!;
    const fileInput = $('imageFile')!, urlInput = $('imageUrl')!;
    const preview = $<HTMLDivElement>('imagePreview')!, previewImg = $<HTMLImageElement>('previewImg')!;
    const MULTI = ['diaryEntryIds', 'libraryDocsEntryIds', 'npcIds', 'locationIds', 'characterIds', 'questIds'] as const;
    let editingId: string | null = null;

    const showFields = (type: string) => {
      eventFields.style.display = type === 'label' ? 'none' : 'block';
      labelFields.style.display = type === 'label' ? 'block' : 'none';
    };
    const showPreview = (src: string) => { previewImg.src = src; preview.classList.toggle('hidden', !src); };
    const close = () => modal.classList.add('hidden');

    entryType.addEventListener('change', () => showFields(entryType.value));
    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (!file) { showPreview(''); return; }
      const reader = new FileReader();
      reader.onload = () => { showPreview(String(reader.result)); urlInput.value = ''; };
      reader.readAsDataURL(file);
    });
    urlInput.addEventListener('input', () => { showPreview(urlInput.value); if (urlInput.value) fileInput.value = ''; });

    $('addTimelineEntry')?.addEventListener('click', () => {
      editingId = null;
      form.reset();
      showPreview('');
      modalTitle.textContent = 'New Timeline Entry';
      entryType.value = 'event';
      showFields('event');
      modal.classList.remove('hidden');
    });
    $('cancelTimelineModal')?.addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });

    async function openEdit(id: string) {
      const response = await fetch(`/api/timeline/${id}`);
      if (!response.ok) { alert('Failed to load entry. Please try again.'); return; }
      const entry = await response.json();
      editingId = id;
      form.reset();
      entryType.value = entry.entryType || 'event';
      showFields(entryType.value);
      if (entry.entryType === 'label') {
        $('labelYear')!.value = entry.year ?? 0;
        $('label')!.value = entry.label || '';
      } else {
        $('year')!.value = entry.year;
        $<HTMLSelectElement>('month')!.value = entry.month || '';
        $('headline')!.value = entry.headline || '';
        $<HTMLTextAreaElement>('shortDescription')!.value = entry.shortDescription || '';
        $<HTMLTextAreaElement>('fullDescription')!.value = entry.fullDescription || '';
        urlInput.value = entry.imageUrl || '';
        showPreview(entry.imageUrl || '');
        for (const key of MULTI) {
          const ids: string[] = entry[key] || [];
          for (const option of $<HTMLSelectElement>(key)!.options) option.selected = ids.includes(option.value);
        }
      }
      modalTitle.textContent = 'Edit Timeline Entry';
      modal.classList.remove('hidden');
    }

    document.querySelectorAll<HTMLButtonElement>('.edit-timeline-entry').forEach((btn) =>
      btn.addEventListener('click', () => openEdit(btn.dataset.id!)));

    document.querySelectorAll<HTMLButtonElement>('.delete-timeline-entry').forEach((btn) =>
      btn.addEventListener('click', async () => {
        if (!(await window.arandorConfirm('Delete this timeline entry?', { detail: 'This can’t be undone.', confirmLabel: 'Delete', danger: true }))) return;
        const response = await fetch(`/api/timeline/${btn.dataset.id}`, { method: 'DELETE' }).catch(() => null);
        if (response?.ok) window.arandorSoftReload();
        else alert('Failed to delete entry. Please try again.');
      }));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const type = String(formData.get('entryType') || 'event');
      const data: Record<string, unknown> = { entryType: type };
      if (type === 'label') {
        data.year = parseInt(String(formData.get('labelYear'))) || 0;
        data.label = formData.get('label');
        data.sortOrder = 0;
      } else {
        let imageUrl = String(formData.get('imageUrl') || '') || null;
        const imageFile = formData.get('imageFile') as File | null;
        if (imageFile && imageFile.size > 0) {
          const upload = new FormData();
          upload.append('file', imageFile);
          const response = await fetch('/api/upload', { method: 'POST', body: upload }).catch(() => null);
          if (!response?.ok) {
            const error = await response?.json().catch(() => null);
            alert(`Failed to upload image: ${error?.error || 'Unknown error'}`);
            return;
          }
          imageUrl = (await response.json()).url;
        }
        const month = String(formData.get('month') || '');
        Object.assign(data, {
          year: parseInt(String(formData.get('year'))) || 0,
          month: month ? parseInt(month) : null,
          headline: formData.get('headline'),
          shortDescription: formData.get('shortDescription'),
          fullDescription: formData.get('fullDescription'),
          imageUrl,
          ...Object.fromEntries(MULTI.map((key) => [key, [...$<HTMLSelectElement>(key)!.selectedOptions].map((o) => o.value)])),
        });
      }
      const response = await fetch(editingId ? `/api/timeline/${editingId}` : '/api/timeline', {
        method: editingId ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      }).catch(() => null);
      if (response?.ok) window.arandorSoftReload();
      else alert('Failed to save entry. Please try again.');
    });

    // From the detail page's Edit button
    const editParam = new URLSearchParams(location.search).get('edit');
    if (editParam) {
      history.replaceState(history.state, '', location.pathname + location.hash);
      openEdit(editParam);
    }
  }

  let stopTracking = () => {};
  document.addEventListener('astro:page-load', () => {
    stopTracking();
    stopTracking = () => {};
    if (location.pathname.replace(/\/$/, '') !== '/library/timeline') return;

    document.querySelectorAll<HTMLAnchorElement>('[data-jump]').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        history.replaceState(history.state, '', `#${a.dataset.jump}`);
        focusEntry(a.dataset.jump!);
      }));
    stopTracking = trackWindow();
    initEditing();
    if (location.hash) focusEntry(decodeURIComponent(location.hash.slice(1)), false);
  });
</script>

<style>
  /* ── Overview bar: every entry on a true scale ─────────────── */
  .tl-overview {
    position: sticky; top: 0; z-index: 20;
    margin: 0 0 2rem; padding: 0.75rem 1rem 0.4rem;
    background: color-mix(in srgb, var(--bg-page) 88%, transparent);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .tl-ov-track { position: relative; height: 18px; margin: 0 6px; }
  .tl-ov-track::before {
    content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 2px; transform: translateY(-50%);
    background: var(--border-gold);
  }
  .tl-ov-window {
    position: absolute; top: 1px; bottom: 1px; opacity: 0; border-radius: 2px;
    background: var(--accent-dim); border: 1px solid var(--border-gold);
    transition: left 0.15s ease, width 0.15s ease, opacity 0.2s;
  }
  .tl-ov-mark {
    position: absolute; top: 50%; width: 9px; height: 9px; transform: translate(-50%, -50%);
    border-radius: 50%; background: var(--gold); border: 2px solid var(--bg-page);
  }
  .tl-ov-mark.is-label { width: 7px; height: 7px; border-radius: 1px; transform: translate(-50%, -50%) rotate(45deg); background: var(--text-faint); }
  .tl-ov-mark:hover, .tl-ov-mark:focus-visible { background: var(--text-strong); z-index: 1; }
  .tl-ov-scale { display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--text-faint); margin-top: 0.15rem; }

  /* ── The chronicle: a gold spine, years on it, events beside it ─ */
  .tl-chronicle { --spine: 1.25rem; position: relative; list-style: none; margin: 0 0 3rem; padding: 0; }
  .tl-chronicle::before {
    content: ''; position: absolute; top: 0; bottom: 0; left: var(--spine); width: 2px; transform: translateX(-50%);
    background: linear-gradient(to bottom, transparent, var(--border-gold) 2rem, var(--border-gold) calc(100% - 2rem), transparent);
  }
  .tl-entries { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .tl-year { position: relative; margin-bottom: 1.25rem; }
  .tl-year:has(.tl-event) { margin-bottom: 1.75rem; }
  .tl-year-badge {
    position: relative; z-index: 1; margin-left: calc(var(--spine) - 1.6rem);
    min-width: 3.2rem; padding: 0.2rem 0.6rem; text-align: center;
    font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; line-height: 1.3;
    color: var(--on-gold); background: var(--gold); border: 3px solid var(--bg-page); border-radius: 2px;
  }
  /* A year's notes sit on the same line as its badge */
  .tl-year-head { display: flex; align-items: flex-start; gap: 1rem; }
  .tl-year-notes { display: flex; flex-direction: column; padding-top: 0.2rem; min-width: 0; }
  .tl-year-head + .tl-entries { margin-top: 1.25rem; }
  .tl-gap { position: relative; margin: -0.5rem 0 1.75rem; padding-left: calc(var(--spine) + 1.25rem); }
  .tl-gap span { font-family: var(--font-display); font-style: italic; font-size: 1rem; color: var(--text-faint); }
  .tl-gap::before { /* the spine fades to dashes across a long stretch */
    content: ''; position: absolute; left: var(--spine); top: -0.75rem; bottom: -0.75rem; width: 2px; transform: translateX(-50%);
    background: repeating-linear-gradient(to bottom, var(--bg-page) 0 4px, transparent 4px 9px);
  }

  .tl-note, .tl-event { scroll-margin-top: 6rem; }
  .tl-event { position: relative; padding-left: calc(var(--spine) + 1.25rem); }
  .tl-note { display: flex; align-items: center; gap: 0.5rem; min-height: 1.75rem; padding: 0 0.25rem; }
  .tl-diamond { flex: none; width: 8px; height: 8px; transform: rotate(45deg); border: 2px solid var(--accent); }
  .tl-note-text { font-family: var(--font-display); font-style: italic; font-weight: 600; font-size: 1.1rem; color: var(--accent); }
  .tl-actions { display: inline-flex; gap: 0.15rem; }
  .tl-note .tl-actions { opacity: 0.55; }
  .tl-note:hover .tl-actions, .tl-note:focus-within .tl-actions { opacity: 1; }

  .tl-dot {
    position: absolute; left: var(--spine); top: 1.4rem; width: 12px; height: 12px; transform: translate(-50%, -50%);
    border-radius: 50%; background: var(--gold); border: 3px solid var(--bg-page); box-shadow: 0 0 0 1px var(--border-gold);
  }
  .tl-card { position: relative; overflow: hidden; padding: 0; transition: border-color 0.2s, transform 0.2s; }
  .tl-card:hover { border-color: var(--border-gold); transform: translateY(-1px); }
  .tl-card-img { width: 100%; aspect-ratio: 16 / 7; object-fit: cover; display: block; }
  .tl-card-body { padding: 1rem 1.25rem 1.1rem; }
  .tl-card-date { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); font-weight: 600; }
  .tl-card-title { font-family: var(--font-display); font-weight: 700; font-size: 1.45rem; line-height: 1.2; color: var(--text-strong); margin: 0.15rem 0 0; padding-right: 3.5rem; }
  .tl-card-link { color: inherit; text-decoration: none; }
  .tl-card-link::after { content: ''; position: absolute; inset: 0; } /* the whole card opens the entry */
  .tl-card-link:focus-visible { outline: none; }
  .tl-card:has(.tl-card-link:focus-visible) { outline: 2px solid var(--gold); outline-offset: 2px; }
  .tl-card-text { margin: 0.5rem 0 0; color: var(--text-muted); line-height: 1.55; }
  .tl-card-people { list-style: none; display: flex; margin: 0.75rem 0 0; padding: 0; }
  .tl-card-people li { width: 28px; height: 28px; margin-right: -6px; border-radius: 50%; overflow: hidden; border: 2px solid var(--bg-surface); background: var(--bg-raised); display: grid; place-items: center; font-size: 0.75rem; color: var(--gold); }
  .tl-card-people img { width: 100%; height: 100%; object-fit: cover; }
  .tl-card-actions { position: absolute; top: 0.6rem; right: 0.6rem; z-index: 1; }
  .tl-card-img ~ .tl-card-actions { background: color-mix(in srgb, var(--bg-surface) 85%, transparent); border-radius: 2px; }

  /* Linked to (#id) or picked in the overview */
  .tl-flash .tl-card, .tl-flash.tl-note { animation: tl-flash 2.2s ease-out; }
  @keyframes tl-flash {
    0%, 30% { box-shadow: 0 0 0 2px var(--gold), 0 0 24px var(--accent-glow); }
    100% { box-shadow: 0 0 0 2px transparent, 0 0 24px transparent; }
  }

  /* Wide screens: spine in the middle, events alternating left and right */
  @media (min-width: 900px) {
    .tl-chronicle { --spine: 50%; }
    .tl-year-head { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1.25rem; }
    .tl-year-badge { grid-column: 2; margin: 0; }
    .tl-year-notes { grid-column: 3; }
    .tl-gap { padding-left: 0; text-align: center; }
    .tl-gap span { position: relative; z-index: 1; background: var(--bg-page); padding: 0 0.75rem; }
    .tl-event { width: 50%; padding-left: 0; }
    .tl-event.is-left { padding-right: 2.25rem; }
    .tl-event.is-right { margin-left: 50%; padding-left: 2.25rem; }
    .tl-event .tl-dot { left: auto; }
    .tl-event.is-left .tl-dot { right: 0; transform: translate(50%, -50%); }
    .tl-event.is-right .tl-dot { left: 0; }
    /* consecutive events overlap a little so the alternating column stays dense */
    .tl-event.is-left + .tl-event.is-right, .tl-event.is-right + .tl-event.is-left { margin-top: -3rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tl-card, .tl-ov-window { transition: none; }
    .tl-flash .tl-card, .tl-flash.tl-note { animation: none; box-shadow: 0 0 0 2px var(--gold); }
  }
</style>

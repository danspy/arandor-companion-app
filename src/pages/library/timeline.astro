---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import { db, TimelineEntry, DiaryEntry, LibraryEntry, NPC, Location, Character, Quest } from 'astro:db';
import { isAuthenticated, getUserRole } from '../../lib/auth';

const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);

// Fetch all timeline entries sorted by year and month
const timelineEntries = await db.select().from(TimelineEntry);
const sortedEntries = timelineEntries.sort((a, b) => {
  if (a.year !== b.year) return a.year - b.year;
  return a.month - b.month;
});

// Fetch all related data for connections
const diaryEntries = await db.select().from(DiaryEntry);
const libraryEntries = await db.select().from(LibraryEntry);
const npcs = await db.select().from(NPC);
const locations = await db.select().from(Location);
const characters = await db.select().from(Character);
const quests = await db.select().from(Quest);

// Create lookup maps
const diaryMap = new Map(diaryEntries.map(d => [d.id, d]));
const libraryMap = new Map(libraryEntries.map(l => [l.id, l]));
const npcMap = new Map(npcs.map(n => [n.id, n]));
const locationMap = new Map(locations.map(l => [l.id, l]));
const characterMap = new Map(characters.map(c => [c.id, c]));
const questMap = new Map(quests.map(q => [q.id, q]));

// Month names
const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 
                    'July', 'August', 'September', 'October', 'November', 'December'];
---

<Layout title="Timeline">
  <div class="mb-6">
    <a href="/library" class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 flex items-center gap-2 inline-flex">
      <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Library
    </a>
  </div>

  <div class="mb-8">
    <h1 class="text-4xl font-bold text-primary-700 dark:text-primary-400 mb-4">Campaign Timeline</h1>
    <p class="text-gray-600 dark:text-gray-400">Chronological view of campaign events and milestones</p>
  </div>

  {isLoggedIn && (
    <div class="flex justify-end mb-6">
      <Button 
        variant="primary"
        size="md"
        icon="add"
        id="addTimelineEntry"
        title="Add new Timeline Entry"
      >
        Add Entry
      </Button>
    </div>
  )}

  {sortedEntries.length === 0 && (
    <div class="text-center py-16 bg-white dark:bg-black rounded-lg shadow-md dark:border dark:border-gray-900">
      <p class="text-gray-500 dark:text-gray-400 text-lg">No timeline entries yet. Start documenting your campaign history!</p>
    </div>
  )}

  {/* Desktop: Horizontal scrolling timeline */}
  <div class="hidden md:block relative">
    <div class="overflow-x-auto pb-8">
      <div class="flex gap-6 min-w-max px-4">
        {sortedEntries.map((entry, index) => {
          const monthName = monthNames[entry.month - 1] || 'Unknown';
          return (
            <div class="timeline-entry-card w-80 flex-shrink-0" data-entry-id={entry.id}>
              {/* Date header */}
              <div class="text-center mb-4">
                <div class="inline-block bg-primary-600 dark:bg-primary-700 text-white px-4 py-2 rounded-lg shadow-md">
                  <div class="text-sm font-medium">{monthName}</div>
                  <div class="text-2xl font-bold">{entry.year}</div>
                </div>
              </div>
              
              {/* Card */}
              <div class="bg-white dark:bg-black rounded-lg shadow-md dark:border dark:border-gray-900 p-6 hover:shadow-lg transition">
                {entry.imageUrl && (
                  <img 
                    src={entry.imageUrl} 
                    alt={entry.headline}
                    class="w-full h-48 object-cover rounded-lg mb-4"
                  />
                )}
                
                <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-3">
                  {entry.headline}
                </h3>
                
                <p class="text-gray-600 dark:text-gray-400 mb-4 line-clamp-3">
                  {entry.shortDescription}
                </p>
                
                <button 
                  class="view-timeline-detail w-full bg-accent-100 dark:bg-accent-900/20 dark:border dark:border-accent-800 text-accent-700 dark:text-accent-400 px-4 py-2 rounded-lg hover:bg-accent-200 dark:hover:bg-accent-900/30 transition font-medium text-sm"
                  data-entry-id={entry.id}
                >
                  + More
                </button>
                
                {isLoggedIn && (
                  <div class="flex gap-2 mt-4 pt-4 border-t border-gray-200 dark:border-gray-800">
                    <Button
                      variant="icon"
                      size="sm"
                      icon="edit"
                      iconPosition="only"
                      class="edit-timeline-entry flex-1"
                      data-id={entry.id}
                      title="Edit entry"
                      ariaLabel="Edit entry"
                    />
                    <Button
                      variant="ghost"
                      size="sm"
                      icon="delete"
                      iconPosition="only"
                      class="delete-timeline-entry hover:text-red-600 dark:hover:text-red-400 flex-1"
                      data-id={entry.id}
                      title="Delete entry"
                      ariaLabel="Delete entry"
                    />
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  {/* Mobile: Vertical timeline */}
  <div class="md:hidden space-y-6">
    {sortedEntries.map((entry, index) => {
      const monthName = monthNames[entry.month - 1] || 'Unknown';
      return (
        <div class="timeline-entry-card" data-entry-id={entry.id}>
          {/* Date header */}
          <div class="mb-4">
            <div class="inline-block bg-primary-600 dark:bg-primary-700 text-white px-4 py-2 rounded-lg shadow-md">
              <div class="text-sm font-medium">{monthName} {entry.year}</div>
            </div>
          </div>
          
          {/* Card */}
          <div class="bg-white dark:bg-black rounded-lg shadow-md dark:border dark:border-gray-900 p-6">
            {entry.imageUrl && (
              <img 
                src={entry.imageUrl} 
                alt={entry.headline}
                class="w-full h-48 object-cover rounded-lg mb-4"
              />
            )}
            
            <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-3">
              {entry.headline}
            </h3>
            
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              {entry.shortDescription}
            </p>
            
            <button 
              class="view-timeline-detail w-full bg-accent-100 dark:bg-accent-900/20 dark:border dark:border-accent-800 text-accent-700 dark:text-accent-400 px-4 py-2 rounded-lg hover:bg-accent-200 dark:hover:bg-accent-900/30 transition font-medium text-sm"
              data-entry-id={entry.id}
            >
              + More
            </button>
            
            {isLoggedIn && (
              <div class="flex gap-2 mt-4 pt-4 border-t border-gray-200 dark:border-gray-800">
                <Button
                  variant="icon"
                  size="sm"
                  icon="edit"
                  iconPosition="only"
                  class="edit-timeline-entry flex-1"
                  data-id={entry.id}
                  title="Edit entry"
                  ariaLabel="Edit entry"
                />
                <Button
                  variant="ghost"
                  size="sm"
                  icon="delete"
                  iconPosition="only"
                  class="delete-timeline-entry hover:text-red-600 dark:hover:text-red-400 flex-1"
                  data-id={entry.id}
                  title="Delete entry"
                  ariaLabel="Delete entry"
                />
              </div>
            )}
          </div>
        </div>
      );
    })}
  </div>

  {/* Detail Modal */}
  <div id="timelineDetailModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4 modal-overlay-safe">
    <div class="bg-white dark:bg-black rounded-lg p-4 sm:p-8 max-w-4xl w-full max-h-[90vh] overflow-y-auto dark:border dark:border-gray-900 modal-content-safe">
      <div class="flex justify-between items-start mb-6">
        <div>
          <div id="detailDate" class="inline-block bg-primary-600 dark:bg-primary-700 text-white px-4 py-2 rounded-lg shadow-md mb-4">
            <div class="text-sm font-medium">Month Year</div>
          </div>
          <h2 id="detailHeadline" class="text-3xl font-bold text-primary-700 dark:text-primary-400"></h2>
        </div>
        <button id="closeDetailModal" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      
      <div id="detailImage" class="hidden mb-6">
        <img src="" alt="" class="w-full h-64 object-cover rounded-lg" />
      </div>
      
      <div id="detailDescription" class="prose dark:prose-invert max-w-none mb-6"></div>
      
      <div id="detailConnections" class="space-y-4"></div>
    </div>
  </div>

  {/* Add/Edit Modal */}
  <div id="timelineEntryModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4 modal-overlay-safe">
    <div class="bg-white dark:bg-black rounded-lg p-4 sm:p-8 max-w-4xl w-full max-h-[90vh] overflow-y-auto dark:border dark:border-gray-900 modal-content-safe">
      <h2 id="timelineModalTitle" class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6 text-primary-700 dark:text-primary-400">New Timeline Entry</h2>
      <form id="timelineEntryForm" class="space-y-4">
        <input type="hidden" id="timelineEntryId" name="id">
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="year" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Year</label>
            <input 
              type="number" 
              id="year" 
              name="year" 
              required 
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            />
          </div>
          
          <div>
            <label for="month" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Month</label>
            <select 
              id="month" 
              name="month" 
              required 
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
              {monthNames.map((name, idx) => (
                <option value={idx + 1}>{name}</option>
              ))}
            </select>
          </div>
        </div>
        
        <div>
          <label for="headline" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Headline</label>
          <input 
            type="text" 
            id="headline" 
            name="headline" 
            required 
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          />
        </div>
        
        <div>
          <label for="shortDescription" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Short Description</label>
          <textarea 
            id="shortDescription" 
            name="shortDescription" 
            required 
            rows="3"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
          ></textarea>
        </div>
        
        <div>
          <label for="fullDescription" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Full Description (Markdown supported)
            <a href="https://www.markdownguide.org/basic-syntax/" target="_blank" class="text-xs text-primary-600 dark:text-primary-400 hover:underline ml-2">
              Markdown Guide ↗
            </a>
          </label>
          <textarea 
            id="fullDescription" 
            name="fullDescription" 
            required 
            rows="8"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100 font-mono text-sm"
          ></textarea>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Image (optional)</label>
          <div class="space-y-3">
            <div>
              <label for="imageFile" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">Upload Image (max 5MB)</label>
              <input 
                type="file" 
                id="imageFile" 
                name="imageFile" 
                accept="image/*"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              />
            </div>
            <div class="text-center text-sm text-gray-500 dark:text-gray-400">— OR —</div>
            <div>
              <label for="imageUrl" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">Image URL</label>
              <input 
                type="url" 
                id="imageUrl" 
                name="imageUrl" 
                placeholder="https://example.com/image.jpg"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              />
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">External URL or uploaded image path</p>
            </div>
          </div>
          
          <!-- Image Preview -->
          <div id="imagePreview" class="hidden mt-4">
            <img id="previewImg" src="" alt="Preview" class="max-w-full h-48 object-cover rounded-lg" />
          </div>
        </div>
        
        <div class="border-t border-gray-200 dark:border-gray-700 pt-4">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">Connections (optional)</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">Select entries to connect to this timeline event</p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="diaryEntryIds" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Diary Entries</label>
              <select 
                id="diaryEntryIds" 
                name="diaryEntryIds" 
                multiple 
                size="4"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
                {diaryEntries.map(entry => (
                  <option value={entry.id}>Session {entry.session}: {entry.title}</option>
                ))}
              </select>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Hold Ctrl/Cmd to select multiple</p>
            </div>
            
            <div>
              <label for="libraryDocsEntryIds" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Library Docs</label>
              <select 
                id="libraryDocsEntryIds" 
                name="libraryDocsEntryIds" 
                multiple 
                size="4"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
                {libraryEntries.map(entry => (
                  <option value={entry.id}>{entry.title}</option>
                ))}
              </select>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Hold Ctrl/Cmd to select multiple</p>
            </div>
            
            <div>
              <label for="npcIds" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">NPCs</label>
              <select 
                id="npcIds" 
                name="npcIds" 
                multiple 
                size="4"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
                {npcs.map(npc => (
                  <option value={npc.id}>{npc.name}</option>
                ))}
              </select>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Hold Ctrl/Cmd to select multiple</p>
            </div>
            
            <div>
              <label for="locationIds" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Locations</label>
              <select 
                id="locationIds" 
                name="locationIds" 
                multiple 
                size="4"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
                {locations.map(location => (
                  <option value={location.id}>{location.name}</option>
                ))}
              </select>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Hold Ctrl/Cmd to select multiple</p>
            </div>
            
            <div>
              <label for="characterIds" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Characters</label>
              <select 
                id="characterIds" 
                name="characterIds" 
                multiple 
                size="4"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
                {characters.map(character => (
                  <option value={character.id}>{character.name}</option>
                ))}
              </select>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Hold Ctrl/Cmd to select multiple</p>
            </div>
            
            <div>
              <label for="questIds" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Quests</label>
              <select 
                id="questIds" 
                name="questIds" 
                multiple 
                size="4"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
                {quests.map(quest => (
                  <option value={quest.id}>{quest.title}</option>
                ))}
              </select>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Hold Ctrl/Cmd to select multiple</p>
            </div>
          </div>
        </div>
        
        <div class="flex gap-4 pt-4">
          <button 
            type="submit" 
            class="flex-1 bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
          >
            Save Entry
          </button>
          <button 
            type="button" 
            id="cancelTimelineModal"
            class="flex-1 bg-gray-300 dark:bg-gray-600 text-gray-700 dark:text-gray-200 px-6 py-2 rounded-lg hover:bg-gray-400 dark:hover:bg-gray-700 transition"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script define:vars={{ 
  monthNames,
  diaryMap: Object.fromEntries(diaryMap),
  libraryMap: Object.fromEntries(libraryMap),
  npcMap: Object.fromEntries(npcMap),
  locationMap: Object.fromEntries(locationMap),
  characterMap: Object.fromEntries(characterMap),
  questMap: Object.fromEntries(questMap),
  sortedEntries
}}>
  let editingId = null;
  
  // Initialize timeline functionality
  function initializeTimeline() {
    const addButton = document.getElementById('addTimelineEntry');
    const modal = document.getElementById('timelineEntryModal');
    const detailModal = document.getElementById('timelineDetailModal');
    const form = document.getElementById('timelineEntryForm');
    const modalTitle = document.getElementById('timelineModalTitle');
    const cancelButton = document.getElementById('cancelTimelineModal');
    const closeDetailButton = document.getElementById('closeDetailModal');
    const fileInput = document.getElementById('imageFile');
    const urlInput = document.getElementById('imageUrl');
    const imagePreview = document.getElementById('imagePreview');
    const previewImg = document.getElementById('previewImg');
    
    // Handle image file selection and preview
    fileInput?.addEventListener('change', (e) => {
      const file = e.target.files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (e) => {
          if (previewImg && imagePreview) {
            previewImg.src = e.target?.result;
            imagePreview.classList.remove('hidden');
          }
          // Clear URL input when file is selected
          if (urlInput) urlInput.value = '';
        };
        reader.readAsDataURL(file);
      } else {
        imagePreview?.classList.add('hidden');
      }
    });
    
    // Handle URL input and preview
    urlInput?.addEventListener('input', (e) => {
      const url = e.target.value;
      if (url) {
        if (previewImg && imagePreview) {
          previewImg.src = url;
          imagePreview.classList.remove('hidden');
        }
        // Clear file input when URL is entered
        if (fileInput) fileInput.value = '';
      } else {
        imagePreview?.classList.add('hidden');
      }
    });
    
    // Open add modal
    addButton?.addEventListener('click', () => {
      editingId = null;
      form?.reset();
      imagePreview?.classList.add('hidden');
      if (modalTitle) modalTitle.textContent = 'New Timeline Entry';
      modal?.classList.remove('hidden');
    });
    
    // Close modals
    cancelButton?.addEventListener('click', () => {
      modal?.classList.add('hidden');
    });
    
    closeDetailButton?.addEventListener('click', () => {
      detailModal?.classList.add('hidden');
    });
    
    // Close modals on background click
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });
    
    detailModal?.addEventListener('click', (e) => {
      if (e.target === detailModal) {
        detailModal.classList.add('hidden');
      }
    });
    
    // Handle form submission
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      
      // Get selected values from multi-select fields
      const diarySelect = document.getElementById('diaryEntryIds');
      const libraryDocsSelect = document.getElementById('libraryDocsEntryIds');
      const npcsSelect = document.getElementById('npcIds');
      const locationsSelect = document.getElementById('locationIds');
      const charactersSelect = document.getElementById('characterIds');
      const questsSelect = document.getElementById('questIds');
      
      const diaryEntryIds = Array.from(diarySelect.selectedOptions).map(option => option.value);
      const libraryDocsEntryIds = Array.from(libraryDocsSelect.selectedOptions).map(option => option.value);
      const npcIds = Array.from(npcsSelect.selectedOptions).map(option => option.value);
      const locationIds = Array.from(locationsSelect.selectedOptions).map(option => option.value);
      const characterIds = Array.from(charactersSelect.selectedOptions).map(option => option.value);
      const questIds = Array.from(questsSelect.selectedOptions).map(option => option.value);
      
      // Handle image upload if file is selected
      let imageUrl = formData.get('imageUrl') || null;
      const imageFile = formData.get('imageFile');
      
      if (imageFile && imageFile.size > 0) {
        try {
          const uploadFormData = new FormData();
          uploadFormData.append('file', imageFile);
          
          const uploadResponse = await fetch('/api/upload', {
            method: 'POST',
            body: uploadFormData,
          });
          
          if (uploadResponse.ok) {
            const uploadData = await uploadResponse.json();
            imageUrl = uploadData.url;
          } else {
            const error = await uploadResponse.json();
            alert(`Failed to upload image: ${error.error || 'Unknown error'}`);
            return;
          }
        } catch (error) {
          console.error('Upload error:', error);
          alert('Failed to upload image. Please try again.');
          return;
        }
      }
      
      const data = {
        year: parseInt(formData.get('year')),
        month: parseInt(formData.get('month')),
        headline: formData.get('headline'),
        shortDescription: formData.get('shortDescription'),
        fullDescription: formData.get('fullDescription'),
        imageUrl,
        diaryEntryIds,
        libraryDocsEntryIds,
        npcIds,
        locationIds,
        characterIds,
        questIds,
      };
      
      try {
        const url = editingId ? `/api/timeline/${editingId}` : '/api/timeline';
        const method = editingId ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        
        if (response.ok) {
          window.location.reload();
        } else {
          alert('Failed to save entry. Please try again.');
        }
      } catch (error) {
        alert('An error occurred. Please try again.');
      }
    });
    
    // View detail modal
    document.querySelectorAll('.view-timeline-detail').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const entryId = e.target.getAttribute('data-entry-id');
        if (!entryId) return;
        
        try {
          const response = await fetch(`/api/timeline/${entryId}`);
          if (!response.ok) throw new Error('Failed to fetch entry');
          
          const entry = await response.json();
          
          // Update modal content
          const detailDate = document.getElementById('detailDate');
          const detailHeadline = document.getElementById('detailHeadline');
          const detailImage = document.getElementById('detailImage');
          const detailDescription = document.getElementById('detailDescription');
          const detailConnections = document.getElementById('detailConnections');
          
          if (detailDate) {
            const monthName = monthNames[entry.month - 1] || 'Unknown';
            detailDate.innerHTML = `<div class="text-sm font-medium">${monthName} ${entry.year}</div>`;
          }
          
          if (detailHeadline) detailHeadline.textContent = entry.headline;
          
          if (entry.imageUrl && detailImage) {
            detailImage.classList.remove('hidden');
            const img = detailImage.querySelector('img');
            if (img) {
              img.src = entry.imageUrl;
              img.alt = entry.headline;
            }
          } else if (detailImage) {
            detailImage.classList.add('hidden');
          }
          
          if (detailDescription) {
            // Use the renderMarkdown function from the window object
            detailDescription.innerHTML = window.renderMarkdown(entry.fullDescription);
          }
          
          // Build connections section
          if (detailConnections) {
            let connectionsHtml = '';
            
            const addSection = (title, ids, map, route) => {
              const items = ids.map(id => map[id]).filter(Boolean);
              if (items.length > 0) {
                connectionsHtml += `
                  <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4">
                    <h4 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">${title}</h4>
                    <ul class="space-y-1">
                      ${items.map(item => `
                        <li>
                          <a href="${route}/${item.id}" class="text-primary-600 dark:text-primary-400 hover:underline">
                            ${item.title || item.name}
                          </a>
                        </li>
                      `).join('')}
                    </ul>
                  </div>
                `;
              }
            };
            
            if (entry.diaryEntryIds && entry.diaryEntryIds.length > 0) {
              addSection('Diary Entries', entry.diaryEntryIds, diaryMap, '/diary');
            }
            if (entry.libraryDocsEntryIds && entry.libraryDocsEntryIds.length > 0) {
              addSection('Library Docs', entry.libraryDocsEntryIds, libraryMap, '/library');
            }
            if (entry.npcIds && entry.npcIds.length > 0) {
              addSection('NPCs', entry.npcIds, npcMap, '/npcs');
            }
            if (entry.locationIds && entry.locationIds.length > 0) {
              addSection('Locations', entry.locationIds, locationMap, '/locations');
            }
            if (entry.characterIds && entry.characterIds.length > 0) {
              addSection('Characters', entry.characterIds, characterMap, '/characters');
            }
            if (entry.questIds && entry.questIds.length > 0) {
              addSection('Quests', entry.questIds, questMap, '/quests');
            }
            
            if (connectionsHtml) {
              detailConnections.innerHTML = `
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">Connected Entries</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  ${connectionsHtml}
                </div>
              `;
            } else {
              detailConnections.innerHTML = '';
            }
          }
          
          detailModal?.classList.remove('hidden');
        } catch (error) {
          console.error('Failed to load timeline entry:', error);
          alert('Failed to load entry details. Please try again.');
        }
      });
    });
    
    // Edit entry
    document.querySelectorAll('.edit-timeline-entry').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = e.target.getAttribute('data-id');
        if (!id) return;
        
        try {
          const response = await fetch(`/api/timeline/${id}`);
          if (!response.ok) throw new Error('Failed to fetch entry');
          
          const entry = await response.json();
          editingId = id;
          
          // Populate form
          document.getElementById('year').value = entry.year;
          document.getElementById('month').value = entry.month;
          document.getElementById('headline').value = entry.headline;
          document.getElementById('shortDescription').value = entry.shortDescription;
          document.getElementById('fullDescription').value = entry.fullDescription;
          document.getElementById('imageUrl').value = entry.imageUrl || '';
          
          // Set selected options in multi-select dropdowns
          const setSelectedOptions = (selectId, ids) => {
            const select = document.getElementById(selectId);
            if (select && ids) {
              Array.from(select.options).forEach(option => {
                option.selected = ids.includes(option.value);
              });
            }
          };
          
          setSelectedOptions('diaryEntryIds', entry.diaryEntryIds || []);
          setSelectedOptions('libraryDocsEntryIds', entry.libraryDocsEntryIds || []);
          setSelectedOptions('npcIds', entry.npcIds || []);
          setSelectedOptions('locationIds', entry.locationIds || []);
          setSelectedOptions('characterIds', entry.characterIds || []);
          setSelectedOptions('questIds', entry.questIds || []);
          
          // Show image preview if URL exists
          if (entry.imageUrl && previewImg && imagePreview) {
            previewImg.src = entry.imageUrl;
            imagePreview.classList.remove('hidden');
          }
          
          if (modalTitle) modalTitle.textContent = 'Edit Timeline Entry';
          modal?.classList.remove('hidden');
        } catch (error) {
          console.error('Failed to load timeline entry:', error);
          alert('Failed to load entry. Please try again.');
        }
      });
    });
    
    // Delete entry
    document.querySelectorAll('.delete-timeline-entry').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = e.target.getAttribute('data-id');
        if (!id) return;
        
        if (confirm('Are you sure you want to delete this timeline entry?')) {
          try {
            const response = await fetch(`/api/timeline/${id}`, {
              method: 'DELETE',
            });
            
            if (response.ok) {
              window.location.reload();
            } else {
              alert('Failed to delete entry. Please try again.');
            }
          } catch (error) {
            alert('An error occurred. Please try again.');
          }
        }
      });
    });
  }
  
  // Run on initial page load and after View Transitions navigation
  document.addEventListener('astro:page-load', initializeTimeline);
</script>

<script>
  import { marked } from 'marked';
  
  // Configure marked for safe rendering
  marked.setOptions({
    breaks: true,
    gfm: true,
  });
  
  // Make renderMarkdown function available globally for the other script
  window.renderMarkdown = function(content) {
    if (!content) return '';
    return marked.parse(content);
  };
</script>


---
import Layout from '../layouts/Layout.astro';
import { getCurrentUser } from '../lib/auth';

// Check if user is authenticated
const user = await getCurrentUser(Astro.cookies);
if (!user) {
  return Astro.redirect('/login');
}

const roleDisplay = {
  'admin': 'Admin',
  'dungeonmaster': 'Dungeon Master',
  'player': 'Player'
}[user.role || 'player'] || 'Player';
---

<Layout title="My Profile">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-4xl font-bold text-primary-700 dark:text-primary-400 mb-8">My Profile</h1>

    <!-- Success/Error Messages -->
    <div id="messageContainer" class="hidden mb-6"></div>

    <!-- Profile Information -->
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 mb-6 dark:border dark:border-gray-900">
      <h2 class="text-2xl font-bold text-primary-700 dark:text-primary-400 mb-4">Account Information</h2>
      
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Username
          </label>
          <p class="w-full px-4 py-2 bg-gray-100 dark:bg-gray-800 rounded-lg text-gray-900 dark:text-gray-100">
            {user.username}
          </p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Role
          </label>
          <p class="w-full px-4 py-2 bg-gray-100 dark:bg-gray-800 rounded-lg">
            <span class={`px-2 py-1 rounded-full text-xs font-medium ${
              user.role === 'admin' ? 'bg-red-100 dark:bg-red-900/20 text-red-700 dark:text-red-400' :
              user.role === 'dungeonmaster' ? 'bg-purple-100 dark:bg-purple-900/20 text-purple-700 dark:text-purple-400' :
              'bg-blue-100 dark:bg-blue-900/20 text-blue-700 dark:text-blue-400'
            }`}>
              {roleDisplay}
            </span>
          </p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Member Since
          </label>
          <p class="w-full px-4 py-2 bg-gray-100 dark:bg-gray-800 rounded-lg text-gray-900 dark:text-gray-100">
            {new Date(user.createdAt).toLocaleDateString()}
          </p>
        </div>
      </div>
    </div>

    <!-- Change Password Form -->
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900">
      <h2 class="text-2xl font-bold text-primary-700 dark:text-primary-400 mb-4">Change Password</h2>
      
      <form id="changePasswordForm" class="space-y-4">
        <div>
          <label for="currentPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Current Password
          </label>
          <input 
            type="password" 
            id="currentPassword" 
            name="currentPassword" 
            required 
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            placeholder="Enter current password"
          >
        </div>

        <div>
          <label for="newPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            New Password
          </label>
          <input 
            type="password" 
            id="newPassword" 
            name="newPassword" 
            required 
            minlength="6"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            placeholder="Enter new password (min 6 characters)"
          >
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Minimum 6 characters</p>
        </div>

        <div>
          <label for="confirmPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Confirm New Password
          </label>
          <input 
            type="password" 
            id="confirmPassword" 
            name="confirmPassword" 
            required 
            minlength="6"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            placeholder="Confirm new password"
          >
        </div>

        <div id="formErrorMessage" class="hidden text-red-600 dark:text-red-400 text-sm"></div>

        <div class="pt-4">
          <button 
            type="submit" 
            class="w-full bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
          >
            Update Password
          </button>
        </div>
      </form>
    </div>

    <!-- Info Box -->
    <div class="mt-8 bg-blue-50 dark:bg-blue-950 border border-blue-200 dark:border-blue-800 rounded-lg p-6">
      <h2 class="text-lg font-semibold text-blue-900 dark:text-blue-300 mb-2">ℹ️ About Your Account</h2>
      <div class="text-sm text-blue-800 dark:text-blue-400 space-y-2">
        <p>Your username and role cannot be changed from this page. Contact an administrator if you need to update these settings.</p>
        <p class="mt-2">For security, always use a strong password that is unique to this account.</p>
      </div>
    </div>
  </div>
</Layout>

<script>
  const changePasswordForm = document.getElementById('changePasswordForm') as HTMLFormElement;
  const formErrorMessage = document.getElementById('formErrorMessage');
  const messageContainer = document.getElementById('messageContainer');

  // Show message
  function showMessage(message: string, type: 'success' | 'error') {
    if (!messageContainer) return;
    
    const bgColor = type === 'success' ? 'bg-green-50 dark:bg-green-950 border-green-200 dark:border-green-800' : 'bg-red-50 dark:bg-red-950 border-red-200 dark:border-red-800';
    const textColor = type === 'success' ? 'text-green-800 dark:text-green-400' : 'text-red-800 dark:text-red-400';
    
    messageContainer.className = `${bgColor} border rounded-lg p-4 ${textColor} mb-6`;
    messageContainer.textContent = message;
    messageContainer.classList.remove('hidden');

    // Auto-hide after 5 seconds
    setTimeout(() => {
      messageContainer.classList.add('hidden');
    }, 5000);
  }

  // Handle form submission
  changePasswordForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(changePasswordForm);
    const currentPassword = formData.get('currentPassword') as string;
    const newPassword = formData.get('newPassword') as string;
    const confirmPassword = formData.get('confirmPassword') as string;

    // Clear previous error messages
    formErrorMessage?.classList.add('hidden');

    // Validate passwords match
    if (newPassword !== confirmPassword) {
      if (formErrorMessage) {
        formErrorMessage.textContent = 'New passwords do not match';
        formErrorMessage.classList.remove('hidden');
      }
      return;
    }

    try {
      const response = await fetch('/api/profile', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          currentPassword,
          newPassword,
        }),
      });

      const result = await response.json();

      if (response.ok) {
        showMessage('Password updated successfully!', 'success');
        changePasswordForm.reset();
      } else {
        if (formErrorMessage) {
          formErrorMessage.textContent = result.error || 'Failed to update password. Please try again.';
          formErrorMessage.classList.remove('hidden');
        }
      }
    } catch (error) {
      if (formErrorMessage) {
        formErrorMessage.textContent = 'An error occurred. Please try again.';
        formErrorMessage.classList.remove('hidden');
      }
    }
  });
</script>

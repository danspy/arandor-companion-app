---
import Layout from '../layouts/Layout.astro';
import { getCurrentUser } from '../lib/auth';

// Check if user is authenticated
const user = await getCurrentUser(Astro.cookies);
if (!user) {
  return Astro.redirect('/login');
}

const roleDisplay = {
  'admin': 'Admin',
  'dungeonmaster': 'Dungeon Master',
  'player': 'Player'
}[user.role || 'player'] || 'Player';
---

<Layout title="My Profile">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-4xl font-bold text-primary-700 dark:text-primary-400 mb-8">My Profile</h1>

    <!-- Success/Error Messages -->
    <div id="messageContainer" class="hidden mb-6"></div>

    <!-- Profile Information -->
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 mb-6 dark:border dark:border-gray-900">
      <h2 class="text-2xl font-bold text-primary-700 dark:text-primary-400 mb-4">Account Information</h2>
      
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Username
          </label>
          <p class="w-full px-4 py-2 bg-gray-100 dark:bg-gray-800 rounded-lg text-gray-900 dark:text-gray-100">
            {user.username}
          </p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Role
          </label>
          <p class="w-full px-4 py-2 bg-gray-100 dark:bg-gray-800 rounded-lg">
            <span class={`px-2 py-1 rounded-full text-xs font-medium ${
              user.role === 'admin' ? 'bg-red-100 dark:bg-red-900/20 text-red-700 dark:text-red-400' :
              user.role === 'dungeonmaster' ? 'bg-purple-100 dark:bg-purple-900/20 text-purple-700 dark:text-purple-400' :
              'bg-blue-100 dark:bg-blue-900/20 text-blue-700 dark:text-blue-400'
            }`}>
              {roleDisplay}
            </span>
          </p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Member Since
          </label>
          <p class="w-full px-4 py-2 bg-gray-100 dark:bg-gray-800 rounded-lg text-gray-900 dark:text-gray-100">
            {new Date(user.createdAt).toLocaleDateString()}
          </p>
        </div>
      </div>
    </div>

    <!-- Editable Profile Information -->
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 mb-6 dark:border dark:border-gray-900">
      <h2 class="text-2xl font-bold text-primary-700 dark:text-primary-400 mb-4">Profile Information</h2>
      
      <form id="profileForm" class="space-y-4">
        <div>
          <label for="firstName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            First Name
          </label>
          <input 
            type="text" 
            id="firstName" 
            name="firstName" 
            value={user.firstName || ''}
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            placeholder="Enter your first name"
          >
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">This will be displayed in the player field for your characters</p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Profile Image</label>
          <div class="space-y-2">
            <div>
              <label for="profileImageFile" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">Upload Image (max 5MB)</label>
              <input 
                type="file" 
                id="profileImageFile" 
                name="profileImageFile" 
                accept="image/*"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div class="flex items-center gap-2">
              <div class="flex-1 h-px bg-gray-300 dark:bg-gray-600"></div>
              <span class="text-xs text-gray-500 dark:text-gray-400">OR</span>
              <div class="flex-1 h-px bg-gray-300 dark:bg-gray-600"></div>
            </div>
            <div>
              <label for="profileImageUrl" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">Image URL</label>
              <input 
                type="text" 
                id="profileImageUrl" 
                name="profileImageUrl" 
                value={user.profileImageUrl || ''}
                placeholder="https://example.com/image.jpg or /uploads/image.jpg"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
          </div>
          <div id="profileImagePreview" class={user.profileImageUrl ? '' : 'hidden'} style="margin-top: 0.5rem;">
            <img id="profileImagePreviewImg" src={user.profileImageUrl || ''} alt="Preview" class="max-w-full h-32 object-cover rounded-lg">
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
            My Characters
          </label>
          <div class="space-y-3">
            <div id="selectedCharacters" class="space-y-2">
              <!-- Selected characters will be displayed here -->
            </div>
            
            <div class="flex gap-2">
              <select 
                id="characterSelect"
                class="flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-white"
              >
                <option value="">-- Select Character --</option>
              </select>
              <button 
                type="button"
                id="addCharacterBtn"
                class="bg-primary-600 text-white px-4 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition whitespace-nowrap"
              >
                Add
              </button>
            </div>
          </div>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Select the characters you play</p>
        </div>

        <div id="profileFormError" class="hidden text-red-600 dark:text-red-400 text-sm"></div>

        <div class="pt-4">
          <button 
            type="submit" 
            class="w-full bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
          >
            Update Profile
          </button>
        </div>
      </form>
    </div>

    <!-- Change Password Form -->
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900">
      <h2 class="text-2xl font-bold text-primary-700 dark:text-primary-400 mb-4">Change Password</h2>
      
      <form id="changePasswordForm" class="space-y-4">
        <div>
          <label for="currentPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Current Password
          </label>
          <input 
            type="password" 
            id="currentPassword" 
            name="currentPassword" 
            required 
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            placeholder="Enter current password"
          >
        </div>

        <div>
          <label for="newPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            New Password
          </label>
          <input 
            type="password" 
            id="newPassword" 
            name="newPassword" 
            required 
            minlength="6"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            placeholder="Enter new password (min 6 characters)"
          >
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Minimum 6 characters</p>
        </div>

        <div>
          <label for="confirmPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Confirm New Password
          </label>
          <input 
            type="password" 
            id="confirmPassword" 
            name="confirmPassword" 
            required 
            minlength="6"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            placeholder="Confirm new password"
          >
        </div>

        <div id="formErrorMessage" class="hidden text-red-600 dark:text-red-400 text-sm"></div>

        <div class="pt-4">
          <button 
            type="submit" 
            class="w-full bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
          >
            Update Password
          </button>
        </div>
      </form>
    </div>

    <!-- Info Box -->
    <div class="mt-8 bg-blue-50 dark:bg-blue-950 border border-blue-200 dark:border-blue-800 rounded-lg p-6">
      <h2 class="text-lg font-semibold text-blue-900 dark:text-blue-300 mb-2">ℹ️ About Your Account</h2>
      <div class="text-sm text-blue-800 dark:text-blue-400 space-y-2">
        <p>Your username and role cannot be changed from this page. Contact an administrator if you need to update these settings.</p>
      </div>
    </div>
  </div>
</Layout>

<script>
  const changePasswordForm = document.getElementById('changePasswordForm') as HTMLFormElement;
  const formErrorMessage = document.getElementById('formErrorMessage');
  const messageContainer = document.getElementById('messageContainer');

  // Show message
  function showMessage(message: string, type: 'success' | 'error') {
    if (!messageContainer) return;
    
    const bgColor = type === 'success' ? 'bg-green-50 dark:bg-green-950 border-green-200 dark:border-green-800' : 'bg-red-50 dark:bg-red-950 border-red-200 dark:border-red-800';
    const textColor = type === 'success' ? 'text-green-800 dark:text-green-400' : 'text-red-800 dark:text-red-400';
    
    messageContainer.className = `${bgColor} border rounded-lg p-4 ${textColor} mb-6`;
    messageContainer.textContent = message;
    messageContainer.classList.remove('hidden');

    // Auto-hide after 5 seconds
    setTimeout(() => {
      messageContainer.classList.add('hidden');
    }, 5000);
  }

  // Handle form submission
  changePasswordForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(changePasswordForm);
    const currentPassword = formData.get('currentPassword') as string;
    const newPassword = formData.get('newPassword') as string;
    const confirmPassword = formData.get('confirmPassword') as string;

    // Clear previous error messages
    formErrorMessage?.classList.add('hidden');

    // Validate passwords match
    if (newPassword !== confirmPassword) {
      if (formErrorMessage) {
        formErrorMessage.textContent = 'New passwords do not match';
        formErrorMessage.classList.remove('hidden');
      }
      return;
    }

    try {
      const response = await fetch('/api/profile', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          currentPassword,
          newPassword,
        }),
      });

      const result = await response.json();

      if (response.ok) {
        showMessage('Password updated successfully!', 'success');
        changePasswordForm.reset();
      } else {
        if (formErrorMessage) {
          formErrorMessage.textContent = result.error || 'Failed to update password. Please try again.';
          formErrorMessage.classList.remove('hidden');
        }
      }
    } catch (error) {
      if (formErrorMessage) {
        formErrorMessage.textContent = 'An error occurred. Please try again.';
        formErrorMessage.classList.remove('hidden');
      }
    }
  });

  // Profile form handling
  const profileForm = document.getElementById('profileForm') as HTMLFormElement;
  const profileFormError = document.getElementById('profileFormError');
  const profileImageFileInput = document.getElementById('profileImageFile') as HTMLInputElement;
  const profileImageUrlInput = document.getElementById('profileImageUrl') as HTMLInputElement;
  const profileImagePreview = document.getElementById('profileImagePreview');
  const profileImagePreviewImg = document.getElementById('profileImagePreviewImg') as HTMLImageElement;
  const characterSelect = document.getElementById('characterSelect') as HTMLSelectElement;
  const addCharacterBtn = document.getElementById('addCharacterBtn');
  const selectedCharactersDiv = document.getElementById('selectedCharacters');

  // Store selected character IDs
  let selectedCharacterIds: string[] = [];
  let allCharacters: any[] = [];

  // Load characters and user's selected characters
  async function loadCharacters() {
    try {
      // Fetch user profile first to get current user's selected characters
      const profileResponse = await fetch('/api/profile');
      if (profileResponse.ok) {
        const profile = await profileResponse.json();
        selectedCharacterIds = profile.characterIds || [];
      }

      // Fetch available characters (filters out those assigned to other users)
      const charactersResponse = await fetch('/api/characters/available');
      if (charactersResponse.ok) {
        allCharacters = await charactersResponse.json();
        
        // Populate character dropdown with available characters
        characterSelect.innerHTML = '<option value="">-- Select Character --</option>';
        allCharacters.forEach((char: any) => {
          const option = document.createElement('option');
          option.value = char.id;
          option.textContent = `${char.name} (${char.class})`;
          characterSelect.appendChild(option);
        });
      }

      updateSelectedCharactersDisplay();
    } catch (error) {
      console.error('Error loading characters:', error);
    }
  }

  // Update the display of selected characters
  function updateSelectedCharactersDisplay() {
    if (!selectedCharactersDiv) return;
    
    selectedCharactersDiv.innerHTML = '';
    
    if (selectedCharacterIds.length === 0) {
      selectedCharactersDiv.innerHTML = '<p class="text-sm text-gray-500 dark:text-gray-400 italic">No characters selected</p>';
      return;
    }

    selectedCharacterIds.forEach(charId => {
      const character = allCharacters.find(c => c.id === charId);
      if (!character) return;

      const charDiv = document.createElement('div');
      charDiv.className = 'flex items-center justify-between bg-primary-50 dark:bg-primary-900/20 border border-primary-200 dark:border-primary-800 rounded-lg p-3';
      
      // Create character display section
      const contentDiv = document.createElement('div');
      contentDiv.className = 'flex items-center gap-3';
      
      // Create avatar
      if (character.avatarUrl) {
        const img = document.createElement('img');
        img.src = character.avatarUrl;
        img.alt = character.name;
        img.className = 'w-10 h-10 rounded-full object-cover border-2 border-primary-300 dark:border-primary-700';
        contentDiv.appendChild(img);
      } else {
        const avatarDiv = document.createElement('div');
        avatarDiv.className = 'w-10 h-10 rounded-full bg-primary-200 dark:bg-primary-800 flex items-center justify-center text-primary-700 dark:text-primary-300 font-bold';
        avatarDiv.textContent = character.name.charAt(0);
        contentDiv.appendChild(avatarDiv);
      }
      
      // Create character info
      const infoDiv = document.createElement('div');
      
      const namePara = document.createElement('p');
      namePara.className = 'font-semibold text-gray-900 dark:text-gray-100';
      namePara.textContent = character.name;
      
      const detailsPara = document.createElement('p');
      detailsPara.className = 'text-xs text-gray-600 dark:text-gray-400';
      detailsPara.textContent = `${character.race} ${character.class} (Level ${character.level})`;
      
      infoDiv.appendChild(namePara);
      infoDiv.appendChild(detailsPara);
      contentDiv.appendChild(infoDiv);
      
      // Create remove button
      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'remove-character text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300 transition';
      removeBtn.setAttribute('data-character-id', charId);
      removeBtn.title = 'Remove character';
      
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('class', 'w-5 h-5');
      svg.setAttribute('fill', 'none');
      svg.setAttribute('stroke', 'currentColor');
      svg.setAttribute('viewBox', '0 0 24 24');
      
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('stroke-linecap', 'round');
      path.setAttribute('stroke-linejoin', 'round');
      path.setAttribute('stroke-width', '2');
      path.setAttribute('d', 'M6 18L18 6M6 6l12 12');
      
      svg.appendChild(path);
      removeBtn.appendChild(svg);
      
      charDiv.appendChild(contentDiv);
      charDiv.appendChild(removeBtn);
      
      selectedCharactersDiv.appendChild(charDiv);
    });

    // Add event listeners to remove buttons
    document.querySelectorAll('.remove-character').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const charId = (e.currentTarget as HTMLElement).getAttribute('data-character-id');
        if (charId) {
          selectedCharacterIds = selectedCharacterIds.filter(id => id !== charId);
          updateSelectedCharactersDisplay();
        }
      });
    });
  }

  // Add character to selection
  addCharacterBtn?.addEventListener('click', () => {
    const selectedValue = characterSelect.value;
    if (!selectedValue) {
      return;
    }

    if (!selectedCharacterIds.includes(selectedValue)) {
      selectedCharacterIds.push(selectedValue);
      updateSelectedCharactersDisplay();
    }

    // Reset dropdown
    characterSelect.value = '';
  });

  // Handle profile image file preview
  profileImageFileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      // Validate file size (max 5MB)
      const maxSize = 5 * 1024 * 1024; // 5MB in bytes
      if (file.size > maxSize) {
        if (profileFormError) {
          profileFormError.textContent = 'Profile image file size must be 5MB or less';
          profileFormError.classList.remove('hidden');
        }
        (e.target as HTMLInputElement).value = ''; // Clear the input
        if (profileImagePreview) profileImagePreview.classList.add('hidden');
        return;
      }
      
      // Clear any previous errors
      profileFormError?.classList.add('hidden');
      
      if (profileImagePreview && profileImagePreviewImg) {
        const reader = new FileReader();
        reader.onload = (e) => {
          profileImagePreviewImg.src = e.target?.result as string;
          profileImagePreview.classList.remove('hidden');
        };
        reader.readAsDataURL(file);
        // Clear URL input when file is selected
        if (profileImageUrlInput) profileImageUrlInput.value = '';
      }
    }
  });

  // Handle profile image URL input
  profileImageUrlInput?.addEventListener('input', (e) => {
    const url = (e.target as HTMLInputElement).value;
    if (url && profileImagePreview && profileImagePreviewImg) {
      profileImagePreviewImg.src = url;
      profileImagePreview.classList.remove('hidden');
      // Clear file input when URL is entered
      if (profileImageFileInput) profileImageFileInput.value = '';
    } else if (profileImagePreview && !url) {
      profileImagePreview.classList.add('hidden');
    }
  });

  // Handle profile form submission
  profileForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(profileForm);
    const firstName = formData.get('firstName') as string;
    
    // Clear previous error messages
    profileFormError?.classList.add('hidden');

    try {
      // Handle profile image upload
      let profileImageUrl = formData.get('profileImageUrl') as string || undefined;
      const profileImageFile = formData.get('profileImageFile') as File;
      
      if (profileImageFile && profileImageFile.size > 0) {
        try {
          const uploadFormData = new FormData();
          uploadFormData.append('file', profileImageFile);
          
          const uploadResponse = await fetch('/api/upload', {
            method: 'POST',
            body: uploadFormData,
          });
          
          if (uploadResponse.ok) {
            const uploadData = await uploadResponse.json();
            profileImageUrl = uploadData.url;
          } else {
            const error = await uploadResponse.json();
            throw new Error(`Failed to upload image: ${error.error || 'Unknown error'}`);
          }
        } catch (error) {
          if (profileFormError) {
            profileFormError.textContent = error instanceof Error ? error.message : 'Failed to upload image. Please try again.';
            profileFormError.classList.remove('hidden');
          }
          return;
        }
      }

      const response = await fetch('/api/profile', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          firstName: firstName || null,
          profileImageUrl: profileImageUrl || null,
          characterIds: selectedCharacterIds,
        }),
      });

      const result = await response.json();

      if (response.ok) {
        showMessage('Profile updated successfully!', 'success');
      } else {
        if (profileFormError) {
          profileFormError.textContent = result.error || 'Failed to update profile. Please try again.';
          profileFormError.classList.remove('hidden');
        }
      }
    } catch (error) {
      if (profileFormError) {
        profileFormError.textContent = 'An error occurred. Please try again.';
        profileFormError.classList.remove('hidden');
      }
    }
  });

  // Initialize on page load
  loadCharacters();
</script>

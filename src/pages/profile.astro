---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getCurrentUser } from '../lib/auth';

// Check if user is authenticated
const user = await getCurrentUser(Astro.cookies);
if (!user) {
  return Astro.redirect('/login');
}

const roleDisplay = {
  'admin': 'Admin',
  'dungeonmaster': 'Dungeon Master',
  'player': 'Player'
}[user.role || 'player'] || 'Player';
---

<Layout title="My Profile">
  <PageHero title="My Profile" pageName="profile" canEditHero={false} compact subtitle="Your name, picture, characters and password." />
  <div class="max-w-2xl mx-auto" data-user-role={user.role}>

    <!-- Success/Error Messages -->
    <div id="messageContainer" class="hidden mb-6"></div>

    <!-- Profile Information -->
    <div class="t-panel p-6 mb-6">
      <h2 class="t-section-h text-xl mb-4">Account Information</h2>
      
      <div class="space-y-4">
        <div>
          <label class="t-label block mb-1">
            Username
          </label>
          <p class="t-inset px-4 py-2 rounded-xs t-body-text w-full">
            {user.username}
          </p>
        </div>

        <div>
          <label class="t-label block mb-1">
            Role
          </label>
          <p class="t-inset px-4 py-2 rounded-xs w-full">
            <span class={`px-2 py-1 rounded-full text-xs font-medium ${
              user.role === 'admin' ? 't-badge t-badge-red' :
              user.role === 'dungeonmaster' ? 't-badge t-badge-accent' :
              't-badge t-badge-blue'
            }`}>
              {roleDisplay}
            </span>
          </p>
        </div>

        <div>
          <label class="t-label block mb-1">
            Member Since
          </label>
          <p class="t-inset px-4 py-2 rounded-xs t-body-text w-full">
            {new Date(user.createdAt).toLocaleDateString()}
          </p>
        </div>
      </div>
    </div>

    <!-- Editable Profile Information -->
    <div class="t-panel p-6 mb-6">
      <h2 class="t-section-h text-xl mb-4">Profile Information</h2>
      
      <form id="profileForm" class="space-y-4">
        <div>
          <label for="firstName" class="t-label block mb-1">
            First Name
          </label>
          <input 
            type="text" 
            id="firstName" 
            name="firstName" 
            value={user.firstName || ''}
            class="t-input px-4 py-2"
            placeholder="Enter your first name"
          >
          <p class="t-faint text-xs mt-1">This will be displayed in the player field for your characters</p>
        </div>

        <div>
          <label class="t-label block mb-1">Profile Image</label>
          <div class="space-y-2">
            <div>
              <label for="profileImageFile" class="t-faint text-xs block mb-1">Upload Image (max 5MB)</label>
              <input 
                type="file" 
                id="profileImageFile" 
                name="profileImageFile" 
                accept="image/*"
                class="t-input px-4 py-2 w-full"
              >
            </div>
            <div class="flex items-center gap-2">
              <div class="flex-1 h-px" style="background:var(--border);"></div>
              <span class="t-faint text-xs">OR</span>
              <div class="flex-1 h-px" style="background:var(--border);"></div>
            </div>
            <div>
              <label for="profileImageUrl" class="t-faint text-xs block mb-1">Image URL</label>
              <input 
                type="text" 
                id="profileImageUrl" 
                name="profileImageUrl" 
                value={user.profileImageUrl || ''}
                placeholder="https://example.com/image.jpg or /uploads/image.jpg"
                class="t-input px-4 py-2"
              >
            </div>
          </div>
          <div id="profileImagePreview" class={user.profileImageUrl ? '' : 'hidden'} style="margin-top: 0.5rem;">
            <img id="profileImagePreviewImg" src={user.profileImageUrl || ''} alt="Preview" class="max-w-full h-32 object-cover rounded-xs">
          </div>
        </div>

        <div>
          <label class="t-label block mb-1">
            My Characters
          </label>
          <div class="space-y-3">
            <div id="selectedCharacters" class="space-y-2">
              <!-- Selected characters will be displayed here -->
            </div>
            
            <div class="flex gap-2">
              <select 
                id="characterSelect"
                class="t-input flex-1 min-w-0 truncate px-4 py-2"
              >
                <option value="">-- Select Character --</option>
              </select>
              <button 
                type="button"
                id="addCharacterBtn"
                class="t-btn-primary px-4 py-2 whitespace-nowrap"
              >
                Add
              </button>
            </div>
          </div>
          <p class="t-faint text-xs mt-1">Select the characters you play</p>
        </div>

        <div>
          <label class="t-label block mb-1">
            Favorite Pages (PWA Quick Access)
          </label>
          <div class="space-y-3">
            <div id="selectedFavoritePages" class="space-y-2">
              <!-- Selected favorite pages will be displayed here -->
            </div>
            
            <div class="flex gap-2">
              <select 
                id="favoritePageSelect"
                class="t-input flex-1 min-w-0 truncate px-4 py-2"
              >
                <option value="">-- Select Page --</option>
              </select>
              <button 
                type="button"
                id="addFavoritePageBtn"
                class="t-btn-primary px-4 py-2 whitespace-nowrap"
              >
                Add
              </button>
            </div>
          </div>
          <p class="t-faint text-xs mt-1">Select up to 4 pages for quick access in PWA mode. Drag to reorder.</p>
        </div>

        <div id="profileFormError" class="hidden text-sm" style="color:var(--danger);"></div>

        <div class="pt-4">
          <button 
            type="submit" 
            class="t-btn-primary w-full px-6 py-2"
          >
            Update Profile
          </button>
        </div>
      </form>
    </div>

    <!-- Change Password Form -->
    <div class="t-panel p-6">
      <h2 class="t-section-h text-xl mb-4">Change Password</h2>
      
      <form id="changePasswordForm" class="space-y-4">
        <div>
          <label for="currentPassword" class="t-label block mb-1">
            Current Password
          </label>
          <input 
            type="password" 
            id="currentPassword" 
            name="currentPassword" 
            required 
            class="t-input px-4 py-2"
            placeholder="Enter current password"
          >
        </div>

        <div>
          <label for="newPassword" class="t-label block mb-1">
            New Password
          </label>
          <input 
            type="password" 
            id="newPassword" 
            name="newPassword" 
            required 
            minlength="6"
            class="t-input px-4 py-2"
            placeholder="Enter new password (min 6 characters)"
          >
          <p class="t-faint text-xs mt-1">Minimum 6 characters</p>
        </div>

        <div>
          <label for="confirmPassword" class="t-label block mb-1">
            Confirm New Password
          </label>
          <input 
            type="password" 
            id="confirmPassword" 
            name="confirmPassword" 
            required 
            minlength="6"
            class="t-input px-4 py-2"
            placeholder="Confirm new password"
          >
        </div>

        <div id="formErrorMessage" class="hidden text-sm" style="color:var(--danger);"></div>

        <div class="pt-4">
          <button 
            type="submit" 
            class="t-btn-primary w-full px-6 py-2"
          >
            Update Password
          </button>
        </div>
      </form>
    </div>

    <!-- Info Box -->
    <div class="t-callout mt-8 p-6">
      <h2 class="t-callout-title text-lg mb-2">ℹ️ About Your Account</h2>
      <div class="t-faint text-sm space-y-2">
        <p>Your username and role cannot be changed from this page. Contact an administrator if you need to update these settings.</p>
      </div>
    </div>

    <!-- Changelog Link -->
    <div class="mt-6 text-center">
      <a 
        href="/changelog" 
        class="t-link inline-flex items-center gap-2"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <span>View Changelog - What's new in the app</span>
      </a>
    </div>
  </div>
</Layout>

<script>
  const changePasswordForm = document.getElementById('changePasswordForm') as HTMLFormElement;
  const formErrorMessage = document.getElementById('formErrorMessage');
  const messageContainer = document.getElementById('messageContainer');

  // Show message
  function showMessage(message: string, type: 'success' | 'error') {
    if (!messageContainer) return;
    
    
    
    
    messageContainer.className = type === 'success' ? 't-toast t-toast-success mb-6' : 't-toast t-toast-error mb-6';
    messageContainer.textContent = message;
    messageContainer.classList.remove('hidden');

    // Auto-hide after 5 seconds
    setTimeout(() => {
      messageContainer.classList.add('hidden');
    }, 5000);
  }

  // Handle form submission
  changePasswordForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(changePasswordForm);
    const currentPassword = formData.get('currentPassword') as string;
    const newPassword = formData.get('newPassword') as string;
    const confirmPassword = formData.get('confirmPassword') as string;

    // Clear previous error messages
    formErrorMessage?.classList.add('hidden');

    // Validate passwords match
    if (newPassword !== confirmPassword) {
      if (formErrorMessage) {
        formErrorMessage.textContent = 'New passwords do not match';
        formErrorMessage.classList.remove('hidden');
      }
      return;
    }

    try {
      const response = await fetch('/api/profile', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          currentPassword,
          newPassword,
        }),
      });

      const result = await response.json();

      if (response.ok) {
        showMessage('Password updated successfully!', 'success');
        changePasswordForm.reset();
      } else {
        if (formErrorMessage) {
          formErrorMessage.textContent = result.error || 'Failed to update password. Please try again.';
          formErrorMessage.classList.remove('hidden');
        }
      }
    } catch (error) {
      if (formErrorMessage) {
        formErrorMessage.textContent = 'An error occurred. Please try again.';
        formErrorMessage.classList.remove('hidden');
      }
    }
  });

  // Store selected character IDs
  let selectedCharacterIds: string[] = [];
  let allCharacters: any[] = [];
  let availableCharacters: any[] = [];
  
  // Store selected favorite pages
  let selectedFavoritePages: string[] = [];
  
  // Available pages for favorites
  const availablePages = [
    { id: '/', name: 'Home', icon: 'home' },
    { id: '/diary', name: 'Diary', icon: 'book' },
    { id: '/library', name: 'Library', icon: 'library' },
    { id: '/characters', name: 'Characters', icon: 'characters' },
    { id: '/npcs', name: 'NPCs', icon: 'npc' },
    { id: '/locations', name: 'Locations', icon: 'location' },
    { id: '/map', name: 'Map', icon: 'map' },
    { id: '/quests', name: 'Quests', icon: 'quest' },
    { id: '/tools', name: 'Tools', icon: 'tools' },
    { id: '/tools/initiative', name: 'Initiative Tracker', icon: 'initiative' },
    { id: '/tools/dm-screen', name: 'DM Screen', icon: 'dm-screen', dmOnly: true },
    { id: '/users', name: 'Users', icon: 'users', adminOnly: true },
  ];

  // Load characters and user's selected characters
  async function loadCharacters() {
    // Get fresh DOM references in case of View Transitions navigation
    const charSelect = document.getElementById('characterSelect') as HTMLSelectElement;
    const selCharactersDiv = document.getElementById('selectedCharacters');
    
    if (!charSelect || !selCharactersDiv) {
      console.error('Required DOM elements not found');
      return;
    }
    
    try {
      // Fetch user profile first to get current user's selected characters
      const profileResponse = await fetch('/api/profile');
      if (profileResponse.ok) {
        const profile = await profileResponse.json();
        selectedCharacterIds = profile.characterIds || [];
        selectedFavoritePages = profile.favoritePages || [];
      }

      // Fetch ALL characters to display already-selected ones
      const allCharsResponse = await fetch('/api/characters');
      if (allCharsResponse.ok) {
        allCharacters = await allCharsResponse.json();
      }

      // Fetch available characters for dropdown (filters out those assigned to other users)
      const availableResponse = await fetch('/api/characters/available');
      if (availableResponse.ok) {
        availableCharacters = await availableResponse.json();
        
        // Populate character dropdown with available characters only
        charSelect.innerHTML = '<option value="">-- Select Character --</option>';
        availableCharacters.forEach((char: any) => {
          const option = document.createElement('option');
          option.value = char.id;
          option.textContent = `${char.name} (${char.class})`;
          charSelect.appendChild(option);
        });
      }

      updateSelectedCharactersDisplay();
      updateFavoritePagesDropdown();
      updateSelectedFavoritePagesDisplay();
    } catch (error) {
      console.error('Error loading characters:', error);
    }
  }
  
  // Load favorite pages dropdown with available pages
  function updateFavoritePagesDropdown() {
    const pageSelect = document.getElementById('favoritePageSelect') as HTMLSelectElement;
    if (!pageSelect) return;
    
    // Get user role from data attribute
    const container = document.querySelector('[data-user-role]');
    const userRole = container?.getAttribute('data-user-role') || 'player';
    
    pageSelect.innerHTML = '<option value="">-- Select Page --</option>';
    
    availablePages.forEach((page: any) => {
      // Filter out already selected pages
      if (!selectedFavoritePages.includes(page.id)) {
        // Only show DM-only pages to DM/admin users
        if (page.dmOnly && userRole !== 'admin' && userRole !== 'dungeonmaster') {
          return;
        }
        // Only show admin-only pages to admin users
        if (page.adminOnly && userRole !== 'admin') {
          return;
        }
        
        const option = document.createElement('option');
        option.value = page.id;
        option.textContent = page.name;
        pageSelect.appendChild(option);
      }
    });
  }
  
  // Update the display of selected favorite pages
  function updateSelectedFavoritePagesDisplay() {
    const selFavoritePagesDiv = document.getElementById('selectedFavoritePages');
    if (!selFavoritePagesDiv) return;
    
    selFavoritePagesDiv.innerHTML = '';
    
    if (selectedFavoritePages.length === 0) {
      selFavoritePagesDiv.innerHTML = '<p class="t-faint text-sm italic">No favorite pages selected</p>';
      return;
    }
    
    selectedFavoritePages.forEach((pageId, index) => {
      const page = availablePages.find(p => p.id === pageId);
      if (!page) return;
      
      const pageDiv = document.createElement('div');
      pageDiv.className = 't-row p-3 flex items-center justify-between cursor-move';
      pageDiv.draggable = true;
      pageDiv.setAttribute('data-page-id', pageId);
      pageDiv.setAttribute('data-index', index.toString());
      
      // Add drag event listeners
      pageDiv.addEventListener('dragstart', handleDragStart);
      pageDiv.addEventListener('dragover', handleDragOver);
      pageDiv.addEventListener('drop', handleDrop);
      pageDiv.addEventListener('dragend', handleDragEnd);
      
      const contentDiv = document.createElement('div');
      contentDiv.className = 'flex items-center gap-3';
      
      // Drag handle icon
      const dragHandle = document.createElement('div');
      dragHandle.className = 't-faint touch-drag-handle cursor-move';
      dragHandle.innerHTML = '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M7 2a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 2zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 8zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 14zm6-8a2 2 0 1 0-.001-4.001A2 2 0 0 0 13 6zm0 2a2 2 0 1 0 .001 4.001A2 2 0 0 0 13 8zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 13 14z"></path></svg>';
      contentDiv.appendChild(dragHandle);
      
      // Add touch event listeners for mobile - only on the drag handle and name
      contentDiv.addEventListener('touchstart', handleTouchStart);
      contentDiv.addEventListener('touchmove', handleTouchMove);
      contentDiv.addEventListener('touchend', handleTouchEnd);
      
      const namePara = document.createElement('p');
      namePara.className = 't-body-text font-semibold';
      namePara.textContent = page.name;
      contentDiv.appendChild(namePara);
      
      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'remove-favorite-page t-icon-btn t-icon-btn-danger';
      removeBtn.setAttribute('data-page-id', pageId);
      removeBtn.title = 'Remove favorite page';
      
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('class', 'w-5 h-5');
      svg.setAttribute('fill', 'none');
      svg.setAttribute('stroke', 'currentColor');
      svg.setAttribute('viewBox', '0 0 24 24');
      
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('stroke-linecap', 'round');
      path.setAttribute('stroke-linejoin', 'round');
      path.setAttribute('stroke-width', '2');
      path.setAttribute('d', 'M6 18L18 6M6 6l12 12');
      
      svg.appendChild(path);
      removeBtn.appendChild(svg);
      
      pageDiv.appendChild(contentDiv);
      pageDiv.appendChild(removeBtn);
      
      selFavoritePagesDiv.appendChild(pageDiv);
    });
    
    // Add event listeners to remove buttons
    document.querySelectorAll('.remove-favorite-page').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const pageId = (e.currentTarget as HTMLElement).getAttribute('data-page-id');
        if (pageId) {
          selectedFavoritePages = selectedFavoritePages.filter(id => id !== pageId);
          updateFavoritePagesDropdown();
          updateSelectedFavoritePagesDisplay();
        }
      });
    });
  }
  
  // Drag and drop handlers for favorite pages
  let draggedElement: HTMLElement | null = null;
  
  function handleDragStart(e: DragEvent) {
    draggedElement = e.target as HTMLElement;
    draggedElement.classList.add('opacity-50');
  }
  
  function handleDragOver(e: DragEvent) {
    e.preventDefault();
    const target = (e.target as HTMLElement).closest('[data-page-id]') as HTMLElement;
    if (target && target !== draggedElement) {
      target.classList.add('border-t-4', 'border-primary-500');
    }
  }
  
  function handleDrop(e: DragEvent) {
    e.preventDefault();
    const target = (e.target as HTMLElement).closest('[data-page-id]') as HTMLElement;
    
    if (target && draggedElement && target !== draggedElement) {
      const draggedIndex = parseInt(draggedElement.getAttribute('data-index') || '0');
      const targetIndex = parseInt(target.getAttribute('data-index') || '0');
      
      // Reorder the array
      const [removed] = selectedFavoritePages.splice(draggedIndex, 1);
      selectedFavoritePages.splice(targetIndex, 0, removed);
      
      updateSelectedFavoritePagesDisplay();
    }
    
    target?.classList.remove('border-t-4', 'border-primary-500');
  }
  
  function handleDragEnd(e: DragEvent) {
    if (draggedElement) {
      draggedElement.classList.remove('opacity-50');
    }
    document.querySelectorAll('[data-page-id]').forEach(el => {
      el.classList.remove('border-t-4', 'border-primary-500');
    });
    draggedElement = null;
  }

  // Touch drag and drop handlers for favorite pages
  let touchDraggedElement: HTMLElement | null = null;
  let touchClone: HTMLElement | null = null;
  let touchDraggedRect: DOMRect | null = null;
  let touchHighlightedElement: HTMLElement | null = null;

  // Helper function to clean up touch drag state
  function cleanupTouchDrag() {
    if (touchDraggedElement) {
      touchDraggedElement.classList.remove('opacity-50');
    }
    if (touchHighlightedElement) {
      touchHighlightedElement.classList.remove('border-t-4', 'border-primary-500');
    }
    touchClone?.remove();
    touchDraggedElement = null;
    touchClone = null;
    touchDraggedRect = null;
    touchHighlightedElement = null;
  }

  function handleTouchStart(e: TouchEvent) {
    const touch = e.touches[0];
    if (!touch) return;
    
    // Find the parent page div element
    const target = (e.currentTarget as HTMLElement).closest('[data-page-id]') as HTMLElement;
    if (!target) return;
    
    touchDraggedElement = target;
    
    const rect = target.getBoundingClientRect();
    touchDraggedRect = rect;
    
    // Create a visual clone for dragging
    touchClone = target.cloneNode(true) as HTMLElement;
    touchClone.style.position = 'fixed';
    touchClone.style.left = rect.left + 'px';
    touchClone.style.top = rect.top + 'px';
    touchClone.style.width = rect.width + 'px';
    touchClone.style.opacity = '0.8';
    touchClone.style.zIndex = '9999';
    touchClone.style.pointerEvents = 'none';
    document.body.appendChild(touchClone);
    
    target.classList.add('opacity-50');
    
    // Prevent scrolling while dragging
    e.preventDefault();
  }

  function handleTouchMove(e: TouchEvent) {
    if (!touchDraggedElement || !touchClone || !touchDraggedRect) return;
    
    const touch = e.touches[0];
    if (!touch) return;
    
    // Move the clone with the touch, keeping it centered under the touch point
    touchClone.style.left = (touch.clientX - touchDraggedRect.width / 2) + 'px';
    touchClone.style.top = (touch.clientY - touchDraggedRect.height / 2) + 'px';
    
    // Find the element under the touch point (pointer-events: none allows this to work)
    const elementBelow = document.elementFromPoint(touch.clientX, touch.clientY);
    const targetElement = elementBelow?.closest('[data-page-id]') as HTMLElement;
    
    // Only update highlights if the target has changed
    if (targetElement !== touchHighlightedElement) {
      // Clear previous highlight
      if (touchHighlightedElement) {
        touchHighlightedElement.classList.remove('border-t-4', 'border-primary-500');
      }
      
      // Highlight the new drop target
      if (targetElement && targetElement !== touchDraggedElement) {
        targetElement.classList.add('border-t-4', 'border-primary-500');
        touchHighlightedElement = targetElement;
      } else {
        touchHighlightedElement = null;
      }
    }
    
    e.preventDefault();
  }

  function handleTouchEnd(e: TouchEvent) {
    if (!touchDraggedElement || !touchClone) return;
    
    const touch = e.changedTouches[0];
    if (!touch) {
      // Cleanup even if no touch available
      cleanupTouchDrag();
      return;
    }
    
    // Find the element under the touch point (pointer-events: none allows this to work)
    const elementBelow = document.elementFromPoint(touch.clientX, touch.clientY);
    const targetElement = elementBelow?.closest('[data-page-id]') as HTMLElement;
    
    if (targetElement && targetElement !== touchDraggedElement) {
      const draggedIndex = parseInt(touchDraggedElement.getAttribute('data-index') || '0');
      const targetIndex = parseInt(targetElement.getAttribute('data-index') || '0');
      
      // Reorder the array
      const [removed] = selectedFavoritePages.splice(draggedIndex, 1);
      selectedFavoritePages.splice(targetIndex, 0, removed);
      
      updateSelectedFavoritePagesDisplay();
    }
    
    // Cleanup
    cleanupTouchDrag();
  }

  // Update the display of selected characters
  function updateSelectedCharactersDisplay() {
    // Get fresh DOM reference in case of View Transitions navigation
    const selCharactersDiv = document.getElementById('selectedCharacters');
    if (!selCharactersDiv) return;
    
    selCharactersDiv.innerHTML = '';
    
    if (selectedCharacterIds.length === 0) {
      selCharactersDiv.innerHTML = '<p class="t-faint text-sm italic">No characters selected</p>';
      return;
    }

    selectedCharacterIds.forEach(charId => {
      const character = allCharacters.find(c => c.id === charId);
      if (!character) return;

      const charDiv = document.createElement('div');
      charDiv.className = 't-row p-3 flex items-center justify-between';
      
      // Create character display section
      const contentDiv = document.createElement('div');
      contentDiv.className = 'flex items-center gap-3';
      
      // Create avatar
      if (character.avatarUrl) {
        const img = document.createElement('img');
        img.src = character.avatarUrl;
        img.alt = character.name;
        img.className = 'w-10 h-10 rounded-full object-cover' ; img.style.border='2px solid var(--border-gold)';
        contentDiv.appendChild(img);
      } else {
        const avatarDiv = document.createElement('div');
        avatarDiv.className = 'w-10 h-10 rounded-full flex items-center justify-center font-bold' ; avatarDiv.style.cssText='background:var(--bg-raised);border:2px solid var(--border-gold);color:var(--gold);font-family:Cormorant Garamond,serif;';
        avatarDiv.textContent = character.name.charAt(0);
        contentDiv.appendChild(avatarDiv);
      }
      
      // Create character info
      const infoDiv = document.createElement('div');
      
      const namePara = document.createElement('p');
      namePara.className = 't-body-text font-semibold';
      namePara.textContent = character.name;
      
      const detailsPara = document.createElement('p');
      detailsPara.className = 't-faint text-xs';
      detailsPara.textContent = `${character.race} ${character.class} (Level ${character.level})`;
      
      infoDiv.appendChild(namePara);
      infoDiv.appendChild(detailsPara);
      contentDiv.appendChild(infoDiv);
      
      // Create remove button
      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'remove-character t-icon-btn t-icon-btn-danger';
      removeBtn.setAttribute('data-character-id', charId);
      removeBtn.title = 'Remove character';
      
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('class', 'w-5 h-5');
      svg.setAttribute('fill', 'none');
      svg.setAttribute('stroke', 'currentColor');
      svg.setAttribute('viewBox', '0 0 24 24');
      
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('stroke-linecap', 'round');
      path.setAttribute('stroke-linejoin', 'round');
      path.setAttribute('stroke-width', '2');
      path.setAttribute('d', 'M6 18L18 6M6 6l12 12');
      
      svg.appendChild(path);
      removeBtn.appendChild(svg);
      
      charDiv.appendChild(contentDiv);
      charDiv.appendChild(removeBtn);
      
      selCharactersDiv.appendChild(charDiv);
    });

    // Add event listeners to remove buttons
    document.querySelectorAll('.remove-character').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const charId = (e.currentTarget as HTMLElement).getAttribute('data-character-id');
        if (charId) {
          selectedCharacterIds = selectedCharacterIds.filter(id => id !== charId);
          updateSelectedCharactersDisplay();
        }
      });
    });
  }

  // Initialize profile form and character selection
  function initializeProfileForm() {
    const profileForm = document.getElementById('profileForm') as HTMLFormElement;
    const profileFormError = document.getElementById('profileFormError');
    const profileImageFileInput = document.getElementById('profileImageFile') as HTMLInputElement;
    const profileImageUrlInput = document.getElementById('profileImageUrl') as HTMLInputElement;
    const profileImagePreview = document.getElementById('profileImagePreview');
    const profileImagePreviewImg = document.getElementById('profileImagePreviewImg') as HTMLImageElement;
    const addCharacterBtn = document.getElementById('addCharacterBtn');
    const addFavoritePageBtn = document.getElementById('addFavoritePageBtn');

    // Add character to selection
    addCharacterBtn?.addEventListener('click', () => {
      const charSelect = document.getElementById('characterSelect') as HTMLSelectElement;
      if (!charSelect) return;
      
      const selectedValue = charSelect.value;
      if (!selectedValue) {
        return;
      }

      if (!selectedCharacterIds.includes(selectedValue)) {
        selectedCharacterIds.push(selectedValue);
        updateSelectedCharactersDisplay();
      }

      // Reset dropdown
      charSelect.value = '';
    });
    
    // Add favorite page to selection
    addFavoritePageBtn?.addEventListener('click', () => {
      const pageSelect = document.getElementById('favoritePageSelect') as HTMLSelectElement;
      if (!pageSelect) return;
      
      const selectedValue = pageSelect.value;
      if (!selectedValue) {
        return;
      }
      
      // Check max 4 pages
      if (selectedFavoritePages.length >= 4) {
        if (profileFormError) {
          profileFormError.textContent = 'You can select up to 4 favorite pages';
          profileFormError.classList.remove('hidden');
          setTimeout(() => profileFormError.classList.add('hidden'), 3000);
        }
        return;
      }

      if (!selectedFavoritePages.includes(selectedValue)) {
        selectedFavoritePages.push(selectedValue);
        updateFavoritePagesDropdown();
        updateSelectedFavoritePagesDisplay();
      }

      // Reset dropdown
      pageSelect.value = '';
    });

    // Handle profile image file preview
    profileImageFileInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) {
        // Validate file size (max 5MB)
        const maxSize = 5 * 1024 * 1024; // 5MB in bytes
        if (file.size > maxSize) {
          if (profileFormError) {
            profileFormError.textContent = 'Profile image file size must be 5MB or less';
            profileFormError.classList.remove('hidden');
          }
          (e.target as HTMLInputElement).value = ''; // Clear the input
          if (profileImagePreview) profileImagePreview.classList.add('hidden');
          return;
        }
        
        // Clear any previous errors
        profileFormError?.classList.add('hidden');
        
        if (profileImagePreview && profileImagePreviewImg) {
          const reader = new FileReader();
          reader.onload = (e) => {
            profileImagePreviewImg.src = e.target?.result as string;
            profileImagePreview.classList.remove('hidden');
          };
          reader.readAsDataURL(file);
          // Clear URL input when file is selected
          if (profileImageUrlInput) profileImageUrlInput.value = '';
        }
      }
    });

    // Handle profile image URL input
    profileImageUrlInput?.addEventListener('input', (e) => {
      const url = (e.target as HTMLInputElement).value;
      if (url && profileImagePreview && profileImagePreviewImg) {
        profileImagePreviewImg.src = url;
        profileImagePreview.classList.remove('hidden');
        // Clear file input when URL is entered
        if (profileImageFileInput) profileImageFileInput.value = '';
      } else if (profileImagePreview && !url) {
        profileImagePreview.classList.add('hidden');
      }
    });

    // Handle profile form submission
    profileForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(profileForm);
      const firstName = formData.get('firstName') as string;
      
      // Clear previous error messages
      profileFormError?.classList.add('hidden');

      try {
        // Handle profile image upload
        let profileImageUrl = formData.get('profileImageUrl') as string || undefined;
        const profileImageFile = formData.get('profileImageFile') as File;
        
        if (profileImageFile && profileImageFile.size > 0) {
          try {
            const uploadFormData = new FormData();
            uploadFormData.append('file', profileImageFile);
            
            const uploadResponse = await fetch('/api/upload', {
              method: 'POST',
              body: uploadFormData,
            });
            
            if (uploadResponse.ok) {
              const uploadData = await uploadResponse.json();
              profileImageUrl = uploadData.url;
            } else {
              const error = await uploadResponse.json();
              throw new Error(`Failed to upload image: ${error.error || 'Unknown error'}`);
            }
          } catch (error) {
            if (profileFormError) {
              profileFormError.textContent = error instanceof Error ? error.message : 'Failed to upload image. Please try again.';
              profileFormError.classList.remove('hidden');
            }
            return;
          }
        }

        const response = await fetch('/api/profile', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            firstName: firstName || null,
            profileImageUrl: profileImageUrl || null,
            characterIds: selectedCharacterIds,
            favoritePages: selectedFavoritePages,
          }),
        });

        const result = await response.json();

        if (response.ok) {
          showMessage('Profile updated successfully!', 'success');
        } else {
          if (profileFormError) {
            profileFormError.textContent = result.error || 'Failed to update profile. Please try again.';
            profileFormError.classList.remove('hidden');
          }
        }
      } catch (error) {
        if (profileFormError) {
          profileFormError.textContent = 'An error occurred. Please try again.';
          profileFormError.classList.remove('hidden');
        }
      }
    });
  }

  // Run on initial page load and after View Transitions navigation
  document.addEventListener('astro:page-load', () => {
    loadCharacters();
    initializeProfileForm();
  });
</script>

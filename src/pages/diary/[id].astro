<script>
  // Session gallery lightbox
  function initializeGalleryLightbox() {
    const lightbox = document.getElementById('galleryLightbox');
    const content = document.getElementById('galleryLightboxContent');
    const closeBtn = document.getElementById('galleryLightboxClose');
    const prevBtn = document.getElementById('galleryLightboxPrev');
    const nextBtn = document.getElementById('galleryLightboxNext');
    const counter = document.getElementById('galleryLightboxCounter');
    if (!lightbox || !content) return;

    // Collect all gallery items in display order
    const items = Array.from(document.querySelectorAll('.gallery-thumb')).map(thumb => ({
      src: thumb.getAttribute('data-gallery-src') || '',
      type: thumb.getAttribute('data-gallery-type') || 'image',
    }));

    const hasMultiple = items.length > 1;
    if (prevBtn) prevBtn.style.display = hasMultiple ? '' : 'none';
    if (nextBtn) nextBtn.style.display = hasMultiple ? '' : 'none';

    let currentIndex = 0;

    function render() {
      const item = items[currentIndex];
      if (!item) return;
      content.innerHTML = '';
      if (item.type === 'video') {
        const video = document.createElement('video');
        video.src = item.src;
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        video.className = 'max-w-full max-h-[90vh] rounded-xs';
        content.appendChild(video);
      } else {
        const img = document.createElement('img');
        img.src = item.src;
        img.alt = 'Session impression';
        img.className = 'max-w-full max-h-[90vh] object-contain rounded-xs';
        content.appendChild(img);
      }
      if (counter) counter.textContent = `${currentIndex + 1} / ${items.length}`;
    }

    function close() {
      lightbox.classList.add('hidden');
      content.innerHTML = '';
    }

    function open(index: number) {
      currentIndex = index;
      render();
      lightbox.classList.remove('hidden');
    }

    function go(delta: number) {
      if (items.length === 0) return;
      currentIndex = (currentIndex + delta + items.length) % items.length;
      render();
    }

    document.querySelectorAll('.gallery-thumb').forEach((thumb, index) => {
      thumb.addEventListener('click', () => open(index));
    });

    closeBtn?.addEventListener('click', close);
    prevBtn?.addEventListener('click', () => go(-1));
    nextBtn?.addEventListener('click', () => go(1));
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') go(-1);
      else if (e.key === 'ArrowRight') go(1);
    });
  }

  document.addEventListener('astro:page-load', initializeGalleryLightbox);
</script>


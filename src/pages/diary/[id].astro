  import { initializeVideoAutoplay } from '../../utils/video';
  
  // Ensure videos play after View Transitions navigation
  document.addEventListener('astro:page-load', initializeVideoAutoplay);
</script>

<script>
  // Import marked for markdown rendering
  import { marked } from 'marked';

  // Configure marked for safe rendering
  marked.setOptions({
    breaks: true,
    gfm: true,
  });

  function initializePlayerNotes() {
    // Get entry ID from the page URL
    const pathParts = window.location.pathname.split('/');
    const entryId = pathParts[pathParts.length - 1];
    const noteDisplay = document.getElementById('noteDisplay');
    const noteEditor = document.getElementById('noteEditor');
    const noteContent = document.getElementById('noteContent');
    const noteTextarea = document.getElementById('noteTextarea');
    const saveNoteBtn = document.getElementById('saveNoteBtn');
    const cancelNoteBtn = document.getElementById('cancelNoteBtn');
    const editNoteBtn = document.getElementById('editNoteBtn');
    const deleteNoteBtn = document.getElementById('deleteNoteBtn');

    if (!noteDisplay || !noteEditor || !noteContent || !noteTextarea) {
      return; // Not logged in, elements don't exist
    }

    let currentNote = null;
    let isEditing = false;

    // Fetch existing note
    async function fetchNote() {
      try {
        const response = await fetch(`/api/diary-notes/${entryId}`);
        if (!response.ok) {
          if (response.status === 401) {
            // Not authenticated, hide notes section
            const section = document.getElementById('playerNotesSection');
            if (section) section.style.display = 'none';
            return;
          }
          throw new Error('Failed to fetch note');
        }

        const data = await response.json();
        currentNote = data.note;

        if (currentNote && currentNote.content) {
          // Show existing note with markdown rendering
          noteContent.innerHTML = marked.parse(currentNote.content);
          noteDisplay.classList.remove('hidden');
          noteEditor.classList.add('hidden');
        } else {
          // No note yet, show editor
          noteDisplay.classList.add('hidden');
          noteEditor.classList.remove('hidden');
          cancelNoteBtn.classList.add('hidden');
        }
      } catch (error) {
        console.error('Error fetching note:', error);
      }
    }

    // Save or update note
    async function saveNote() {
      const content = noteTextarea.value.trim();
      
      if (!content) {
        alert('Please enter some content for your note.');
        return;
      }

      try {
        const method = currentNote ? 'PUT' : 'POST';
        const response = await fetch(`/api/diary-notes/${entryId}`, {
          method: method,
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ content }),
        });

        if (!response.ok) {
          const error = await response.json().catch(() => ({ error: 'Unknown error' }));
          throw new Error(error.error || 'Failed to save note');
        }

        const data = await response.json();
        currentNote = data.note;

        // Update display with markdown rendering
        noteContent.innerHTML = marked.parse(currentNote.content);
        noteDisplay.classList.remove('hidden');
        noteEditor.classList.add('hidden');
        isEditing = false;
      } catch (error) {
        console.error('Error saving note:', error);
        alert(`Failed to save note: ${error.message}`);
      }
    }

    // Edit note
    function editNote() {
      if (currentNote) {
        noteTextarea.value = currentNote.content;
      }
      noteDisplay.classList.add('hidden');
      noteEditor.classList.remove('hidden');
      cancelNoteBtn.classList.remove('hidden');
      isEditing = true;
    }

    // Cancel editing
    function cancelEdit() {
      if (currentNote) {
        noteDisplay.classList.remove('hidden');
        noteEditor.classList.add('hidden');
      } else {
        noteTextarea.value = '';
      }
      cancelNoteBtn.classList.add('hidden');
      isEditing = false;
    }

    // Delete note
    async function deleteNote() {
      if (!confirm('Are you sure you want to delete this note?')) {
        return;
      }

      try {
        const response = await fetch(`/api/diary-notes/${entryId}`, {
          method: 'DELETE',
        });

        if (!response.ok) {
          throw new Error('Failed to delete note');
        }

        currentNote = null;
        noteTextarea.value = '';
        noteDisplay.classList.add('hidden');
        noteEditor.classList.remove('hidden');
        cancelNoteBtn.classList.add('hidden');
      } catch (error) {
        console.error('Error deleting note:', error);
        alert('Failed to delete note. Please try again.');
      }
    }

    // Event listeners
    saveNoteBtn?.addEventListener('click', saveNote);
    cancelNoteBtn?.addEventListener('click', cancelEdit);
    editNoteBtn?.addEventListener('click', editNote);
    deleteNoteBtn?.addEventListener('click', deleteNote);

    // Load note on page load
    fetchNote();
  }

  // Initialize on page load
  document.addEventListener('astro:page-load', initializePlayerNotes);
</script>

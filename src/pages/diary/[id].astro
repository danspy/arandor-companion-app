---
import Layout from '../../layouts/Layout.astro';
import { db, DiaryEntry, NPC, Location, Character, Quest, eq, inArray } from 'astro:db';
import { isAuthenticated, getUserRole } from '../../lib/auth';
import { renderMarkdown } from '../../utils/markdown';
import { getVideoMimeType } from '../../utils/video';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/diary');
}

const entries = await db.select().from(DiaryEntry).where(eq(DiaryEntry.id, id));
const entry = entries[0];

if (!entry) {
  return Astro.redirect('/diary');
}

const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);
const canGenerateSummary = userRole === 'dungeonmaster' || userRole === 'admin';

// Get all diary entries to find previous and next sessions
// Note: For typical D&D campaigns (10-100 sessions), fetching all entries is acceptable.
// For larger datasets, consider optimizing with targeted queries based on session number.
const allEntries = await db.select().from(DiaryEntry);
allEntries.sort((a, b) => a.session - b.session);

// Find previous and next entries based on session number
let previousEntry = null;
let nextEntry = null;

const currentIndex = allEntries.findIndex(e => e.id === id);
if (currentIndex > 0) {
  previousEntry = allEntries[currentIndex - 1];
}
if (currentIndex < allEntries.length - 1) {
  nextEntry = allEntries[currentIndex + 1];
}

// Fetch related entities
let relatedNPCs: any[] = [];
let relatedLocations: any[] = [];
let relatedCharacters: any[] = [];
let relatedQuests: any[] = [];

const npcIds = Array.isArray(entry.npcIds) ? entry.npcIds : [];
const locationIds = Array.isArray(entry.locationIds) ? entry.locationIds : [];
const characterIds = Array.isArray(entry.characterIds) ? entry.characterIds : [];
const questIds = Array.isArray(entry.questIds) ? entry.questIds : [];

if (npcIds.length > 0) {
  relatedNPCs = await db.select().from(NPC).where(inArray(NPC.id, npcIds));
}
if (locationIds.length > 0) {
  relatedLocations = await db.select().from(Location).where(inArray(Location.id, locationIds));
}
if (characterIds.length > 0) {
  relatedCharacters = await db.select().from(Character).where(inArray(Character.id, characterIds));
}
if (questIds.length > 0) {
  relatedQuests = await db.select().from(Quest).where(inArray(Quest.id, questIds));
}

// Render markdown content
const renderedContent = renderMarkdown(entry.content);
---

<Layout title={entry.title}>
  <div class="max-w-4xl mx-auto">
    <!-- Header with Back Button -->
    <div class="flex items-center justify-between mb-6">
      <a href="/diary" class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Diary
      </a>
      {isLoggedIn && (
        <div class="flex gap-2">
          <button 
            id="editEntry"
            data-id={entry.id}
            class="bg-primary-600 text-white px-4 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
          >
            Edit
          </button>
          <button 
            id="deleteEntry"
            data-id={entry.id}
            class="border-2 border-red-600 text-red-600 dark:text-red-400 dark:border-red-500 px-4 py-2 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition"
          >
            Delete
          </button>
        </div>
      )}
    </div>

    <!-- Cover Video or Image -->
    {entry.coverVideoUrl ? (
      <div class="mb-8 rounded-lg overflow-hidden shadow-lg">
        <video 
          autoplay
          muted
          playsinline
          loop
          preload="auto"
          disablePictureInPicture
          class="w-full h-96 object-cover"
          aria-label={`Cover video for ${entry.title}`}
        >
          <source src={entry.coverVideoUrl} type={getVideoMimeType(entry.coverVideoUrl)} />
          Your browser does not support the video tag.
        </video>
      </div>
    ) : entry.coverImageUrl && (
      <div class="mb-8 rounded-lg overflow-hidden shadow-lg">
        <img 
          src={entry.coverImageUrl} 
          alt={entry.title}
          class="w-full h-96 object-cover"
        />
      </div>
    )}

    <!-- Entry Header -->
    <article class="bg-white dark:bg-black rounded-lg shadow-md p-8 mb-6 dark:border dark:border-gray-900">
      <h1 class="text-4xl font-bold text-primary-700 dark:text-primary-400 mb-4">{entry.title}</h1>
      
      <div class="flex gap-4 text-sm text-gray-600 dark:text-gray-400 mb-6">
        <span class="flex items-center gap-1">
          Session {entry.session}
        </span>
      </div>

      <!-- Tags -->
      {Array.isArray(entry.tags) && entry.tags.length > 0 && (
        <div class="flex gap-2 flex-wrap mb-6">
          {entry.tags.map((tag: string) => (
            <span class="bg-primary-100 dark:bg-primary-900/20 dark:border dark:border-primary-800 text-primary-700 dark:text-primary-400 px-3 py-1 rounded-full text-sm">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <!-- AI Tools Accordion (only for DM/admin) -->
      {canGenerateSummary && (
        <details class="mb-6 border border-gray-200 dark:border-gray-800 bg-white dark:bg-black rounded-lg">
          <summary class="cursor-pointer px-4 py-3 font-semibold text-gray-900 dark:text-gray-100 flex items-center gap-2 hover:bg-gray-50 dark:hover:bg-gray-900 rounded-lg">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            AI Tools
          </summary>
          <div class="px-4 pb-4 pt-2 flex flex-wrap gap-2">
            <button
              id="generateSummaryBtn"
              class="px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 dark:bg-blue-700 dark:hover:bg-blue-600 rounded-lg transition flex items-center gap-2"
              title="Generate summary"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span id="generateSummaryBtnText">Generate Summary</span>
            </button>
            <button
              id="generateImageBtn"
              class="px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 dark:bg-blue-700 dark:hover:bg-blue-600 rounded-lg transition flex items-center gap-2"
              title="Generate image"
            >
              <svg id="generateImageIcon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <svg id="generateImageSpinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span id="generateImageBtnText">Generate Image</span>
            </button>
            <button
              id="generatePodcastBtn"
              class="px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 dark:bg-blue-700 dark:hover:bg-blue-600 rounded-lg transition flex items-center gap-2"
              title="Generate podcast"
            >
              <svg id="generatePodcastIcon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
              </svg>
              <svg id="generatePodcastSpinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span id="generatePodcastBtnText">Generate Podcast</span>
            </button>
          </div>
        </details>
      )}

      <!-- Summary (visible to all when exists) -->
      {entry.summary && (
        <div data-summary-section class="mb-6 bg-gray-50 dark:bg-gray-900 rounded-lg p-4 border border-gray-200 dark:border-gray-800">
          <div class="flex items-start justify-between gap-4 mb-3">
            <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Summary
            </h3>
            {canGenerateSummary && (
              <button
                id="deleteSummaryBtn"
                class="text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 p-1.5 rounded transition"
                title="Delete summary"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            )}
          </div>
          <div id="summaryContent" class="text-sm text-gray-700 dark:text-gray-300">
            <p>{entry.summary}</p>
          </div>
        </div>
      )}

      <!-- Podcast (visible to all when exists) -->
      {entry.podcastAudioUrl && (
        <div data-podcast-section class="mb-6 bg-gray-50 dark:bg-gray-900 rounded-lg p-4 border border-gray-200 dark:border-gray-800">
          <div class="flex items-start justify-between gap-4 mb-3">
            <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
              </svg>
              Podcast
            </h3>
            {canGenerateSummary && (
              <button
                id="deletePodcastBtn"
                class="text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 p-1.5 rounded transition"
                title="Delete podcast"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            )}
          </div>
          <audio 
            controls 
            class="w-full"
            preload="metadata"
          >
            <source src={entry.podcastAudioUrl} type="audio/mpeg" />
            Your browser does not support the audio element.
          </audio>
        </div>
      )}

      <!-- Content -->
      <div class="prose dark:prose-invert max-w-none mb-6">
        <div 
          class="diary-text text-gray-700 dark:text-gray-300 text-lg leading-relaxed"
          set:html={renderedContent}
        />
      </div>

      <!-- Session Navigation -->
      <div class="flex items-center justify-center gap-3 pt-6 border-t border-gray-200 dark:border-gray-800">
        {previousEntry ? (
          <a 
            href={`/diary/${previousEntry.id}`}
            class="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-accent-100 dark:bg-accent-900/20 dark:border dark:border-accent-800 text-accent-700 dark:text-accent-400 rounded-lg hover:bg-accent-200 dark:hover:bg-accent-900/30 transition font-medium text-sm"
            title={`Session ${previousEntry.session}: ${previousEntry.title}`}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span>Session {previousEntry.session}</span>
          </a>
        ) : (
          <div class="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-400 dark:text-gray-600 rounded-lg cursor-not-allowed font-medium text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span>Previous</span>
          </div>
        )}
        
        {nextEntry ? (
          <a 
            href={`/diary/${nextEntry.id}`}
            class="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-accent-100 dark:bg-accent-900/20 dark:border dark:border-accent-800 text-accent-700 dark:text-accent-400 rounded-lg hover:bg-accent-200 dark:hover:bg-accent-900/30 transition font-medium text-sm"
            title={`Session ${nextEntry.session}: ${nextEntry.title}`}
          >
            <span>Session {nextEntry.session}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ) : (
          <div class="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-400 dark:text-gray-600 rounded-lg cursor-not-allowed font-medium text-sm">
            <span>Next</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        )}
      </div>
    </article>

    <!-- Player Notes Section (only visible when logged in) -->
    {isLoggedIn && (
      <div id="playerNotesSection" class="bg-white dark:bg-black rounded-lg shadow-md p-8 mb-6 dark:border dark:border-gray-900">
        <h2 class="text-2xl font-bold text-primary-700 dark:text-primary-400 mb-4 flex items-center gap-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          My Notes
        </h2>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
          Private notes only you can see
        </p>
        
        <!-- Note Display/Edit Area -->
        <div id="noteDisplay" class="hidden">
          <div 
            id="noteContent"
            class="prose dark:prose-invert max-w-none mb-4 bg-gray-50 dark:bg-gray-900 p-4 rounded-lg border border-gray-200 dark:border-gray-800"
          ></div>
          <div class="flex gap-2">
            <button 
              id="editNoteBtn"
              class="bg-primary-600 text-white px-4 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
            >
              Edit Note
            </button>
            <button 
              id="deleteNoteBtn"
              class="border-2 border-red-600 text-red-600 dark:text-red-400 dark:border-red-500 px-4 py-2 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition"
            >
              Delete Note
            </button>
          </div>
        </div>

        <!-- Note Editor -->
        <div id="noteEditor">
          <textarea 
            id="noteTextarea"
            class="w-full min-h-[200px] p-4 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 focus:border-transparent resize-y"
            placeholder="Add your private notes here... (Markdown supported)"
          ></textarea>
          <div class="flex gap-2 mt-4">
            <button 
              id="saveNoteBtn"
              class="bg-primary-600 text-white px-4 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
            >
              Save Note
            </button>
            <button 
              id="cancelNoteBtn"
              class="hidden border-2 border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 px-4 py-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition"
            >
              Cancel
            </button>
          </div>
        </div>
      </div>
    )}

    <!-- Related Entities -->
    {(relatedNPCs.length > 0 || relatedLocations.length > 0 || relatedCharacters.length > 0 || relatedQuests.length > 0) && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {/* NPCs */}
        {relatedNPCs.length > 0 && (
          <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900">
            <h3 class="text-xl font-semibold text-primary-700 dark:text-primary-400 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              NPCs Met
            </h3>
            <ul class="space-y-2">
              {relatedNPCs.map(npc => (
                <li class="border-l-2 border-primary-300 dark:border-primary-700 pl-3">
                  <a href={`/npcs/${npc.id}`} class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
                    {npc.name}
                  </a>
                  <p class="text-sm text-gray-600 dark:text-gray-400">{npc.race} - {npc.relationship}</p>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Locations */}
        {relatedLocations.length > 0 && (
          <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900">
            <h3 class="text-xl font-semibold text-primary-700 dark:text-primary-400 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              Locations Visited
            </h3>
            <ul class="space-y-2">
              {relatedLocations.map(location => (
                <li class="border-l-2 border-primary-300 dark:border-primary-700 pl-3">
                  <a href={`/locations/${location.id}`} class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
                    {location.name}
                  </a>
                  <p class="text-sm text-gray-600 capitalize">{location.type}</p>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Characters */}
        {relatedCharacters.length > 0 && (
          <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900">
            <h3 class="text-xl font-semibold text-primary-700 dark:text-primary-400 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              Party Members
            </h3>
            <ul class="space-y-2">
              {relatedCharacters.map(character => (
                <li class="border-l-2 border-primary-300 dark:border-primary-700 pl-3">
                  <a href={`/characters/${character.id}`} class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
                    {character.name}
                  </a>
                  <p class="text-sm text-gray-600 dark:text-gray-400">Level {character.level} {character.race} {character.class}</p>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Quests */}
        {relatedQuests.length > 0 && (
          <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900">
            <h3 class="text-xl font-semibold text-primary-700 dark:text-primary-400 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
              Related Quests
            </h3>
            <ul class="space-y-2">
              {relatedQuests.map(quest => (
                <li class="border-l-2 border-primary-300 dark:border-primary-700 pl-3">
                  <a href="/quests" class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
                    {quest.title}
                  </a>
                  <p class="text-sm text-gray-600 capitalize">{quest.status} - {quest.priority} priority</p>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </div>

  <!-- AI Image Preview Modal -->
  <div id="imagePreviewModal" class="hidden fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center z-50 p-4">
    <div class="bg-white dark:bg-gray-900 rounded-lg max-w-4xl w-full max-h-[90vh] overflow-y-auto dark:border dark:border-gray-700 relative">
      <!-- Loading Overlay -->
      <div id="modalLoadingOverlay" class="hidden absolute inset-0 bg-white dark:bg-gray-900 bg-opacity-90 dark:bg-opacity-90 flex items-center justify-center z-10 rounded-lg">
        <div class="text-center">
          <svg class="animate-spin h-12 w-12 text-purple-600 dark:text-purple-400 mx-auto mb-4" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <p class="text-lg font-semibold text-purple-700 dark:text-purple-400" id="modalLoadingText">Generating image...</p>
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">This may take 10-30 seconds</p>
        </div>
      </div>

      <div class="p-6">
        <h2 class="text-2xl font-bold text-primary-700 dark:text-primary-400 mb-4">AI Generated Image Preview</h2>
        
        <div id="previewImageContainer" class="mb-6 rounded-lg overflow-hidden bg-gray-100 dark:bg-gray-800">
          <img 
            id="previewImage" 
            src="" 
            alt="AI Generated Preview"
            class="w-full h-auto max-h-[60vh] object-contain"
          />
        </div>

        <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">
          Review the generated image. You can regenerate a new version or accept this one to set it as the cover image.
        </p>

        <div class="flex gap-3 flex-wrap">
          <button
            id="acceptImageBtn"
            class="flex-1 bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 dark:bg-green-700 dark:hover:bg-green-600 transition font-medium flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span id="acceptImageBtnText">Accept & Save</span>
          </button>
          <button
            id="regenerateImageBtn"
            class="flex-1 bg-purple-600 text-white px-6 py-3 rounded-lg hover:bg-purple-700 dark:bg-purple-700 dark:hover:bg-purple-600 transition font-medium flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <svg id="regenerateIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <!-- Spinner for regenerate -->
            <svg id="regenerateSpinner" class="hidden w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span id="regenerateImageBtnText">Regenerate</span>
          </button>
          <button
            id="cancelPreviewBtn"
            class="flex-1 bg-gray-300 dark:bg-gray-600 text-gray-700 dark:text-gray-200 px-6 py-3 rounded-lg hover:bg-gray-400 dark:hover:bg-gray-700 transition font-medium disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Cancel
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .diary-text p + p {
    margin-top: 2rem;
  }
  
  /* Audio element styling */
  audio {
    background-color: transparent;
    color: black;
  }
  
  :root.dark audio {
    filter: invert(1);
  }
</style>

<script>
  function initializeDetailPage() {
    const deleteBtn = document.getElementById('deleteEntry');
    const editBtn = document.getElementById('editEntry');
    const generateSummaryBtn = document.getElementById('generateSummaryBtn');
    const deleteSummaryBtn = document.getElementById('deleteSummaryBtn');
    const summaryContent = document.getElementById('summaryContent');
    const summaryBtnText = document.getElementById('generateSummaryBtnText');
    
    // Helper function to get entry ID from URL
    function getEntryIdFromUrl() {
      const pathParts = window.location.pathname.split('/');
      return pathParts[pathParts.length - 1];
    }

    // Helper function to show error alert
    function showError(message) {
      alert(message);
    }
    
    // Handle edit button click
    editBtn?.addEventListener('click', () => {
      const id = editBtn.getAttribute('data-id');
      if (id) {
        window.location.href = `/diary?edit=${id}`;
      }
    });
    
    deleteBtn?.addEventListener('click', async () => {
    const id = deleteBtn.getAttribute('data-id');
    if (!id) return;
    
    if (confirm('Are you sure you want to delete this entry?')) {
      try {
        const response = await fetch(`/api/diary/${id}`, {
          method: 'DELETE',
        });
        
        if (response.ok) {
          window.location.href = '/diary';
        } else {
          const error = await response.json().catch(() => ({ error: 'Unknown error' }));
          showError(`Failed to delete entry: ${error.error || response.statusText}`);
        }
      } catch (error) {
        console.error('Delete error:', error);
        showError('An error occurred while deleting the entry. Please check your connection and try again.');
      }
    }
  });

  // Handle delete summary button click
  deleteSummaryBtn?.addEventListener('click', async () => {
    const entryId = getEntryIdFromUrl();

    if (!entryId) {
      showError('Unable to determine entry ID');
      return;
    }

    if (!confirm('Are you sure you want to delete this summary? This action cannot be undone.')) {
      return;
    }

    try {
      const response = await fetch(`/api/diary/${entryId}/summary`, {
        method: 'DELETE',
      });

      const data = await response.json();

      if (response.ok && data.success) {
        // Remove the summary section
        const summarySection = document.querySelector('[data-summary-section]');
        if (summarySection) {
          summarySection.remove();
        }
      } else {
        showError(`Failed to delete summary: ${data.error || 'Unknown error'}`);
      }
    } catch (error) {
      console.error('Error deleting summary:', error);
      showError('Failed to delete summary. Please check your connection and try again.');
    }
  });

  // Define deleteSummary function for dynamic event binding
  async function deleteSummary() {
    const entryId = getEntryIdFromUrl();

    if (!entryId) {
      showError('Unable to determine entry ID');
      return;
    }

    if (!confirm('Are you sure you want to delete this summary? This action cannot be undone.')) {
      return;
    }

    try {
      const response = await fetch(`/api/diary/${entryId}/summary`, {
        method: 'DELETE',
      });

      const data = await response.json();

      if (response.ok && data.success) {
        // Remove the summary section
        const summarySection = document.querySelector('[data-summary-section]');
        if (summarySection) {
          summarySection.remove();
        }
      } else {
        showError(`Failed to delete summary: ${data.error || 'Unknown error'}`);
      }
    } catch (error) {
      console.error('Error deleting summary:', error);
      showError('Failed to delete summary. Please check your connection and try again.');
    }
  }

  // Handle generate summary button click
  generateSummaryBtn?.addEventListener('click', async () => {
    const entryId = getEntryIdFromUrl();

    if (!entryId) {
      showError('Unable to determine entry ID');
      return;
    }

    // Show loading state
    if (generateSummaryBtn && summaryBtnText) {
      generateSummaryBtn.disabled = true;
      summaryBtnText.textContent = 'Generating...';
    }

    try {
      const response = await fetch(`/api/diary/${entryId}/summary`, {
        method: 'POST',
      });

      const data = await response.json();

      if (response.ok && data.success) {
        // Create or update the summary section
        let summarySection = document.querySelector('[data-summary-section]');
        
        if (!summarySection) {
          // Create new summary section
          const aiToolsAccordion = document.querySelector('details');
          summarySection = document.createElement('div');
          summarySection.setAttribute('data-summary-section', '');
          summarySection.className = 'mb-6 bg-gray-50 dark:bg-gray-900 rounded-lg p-4 border border-gray-200 dark:border-gray-800';
          
          summarySection.innerHTML = `
            <div class="flex items-start justify-between gap-4 mb-3">
              <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Summary
              </h3>
              <button
                id="deleteSummaryBtn"
                class="text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 p-1.5 rounded transition"
                title="Delete summary"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </div>
            <div id="summaryContent" class="text-sm text-gray-700 dark:text-gray-300">
              <p></p>
            </div>
          `;
          
          // Insert after AI Tools accordion
          if (aiToolsAccordion) {
            aiToolsAccordion.insertAdjacentElement('afterend', summarySection);
          }
          
          // Re-attach delete event listener to new button
          const newDeleteBtn = summarySection.querySelector('#deleteSummaryBtn');
          newDeleteBtn?.addEventListener('click', deleteSummary);
        }
        
        // Update the summary content
        const summaryContentEl = summarySection.querySelector('#summaryContent p');
        if (summaryContentEl) {
          summaryContentEl.textContent = data.summary;
        }
        
        // Reset button state
        if (generateSummaryBtn && summaryBtnText) {
          generateSummaryBtn.disabled = false;
          summaryBtnText.textContent = 'Generate Summary';
        }
      } else {
        // Show error
        showError(`Failed to generate summary: ${data.error || 'Unknown error'}`);
        
        // Reset button
        if (summaryBtnText) {
          summaryBtnText.textContent = 'Generate Summary';
        }
        if (generateSummaryBtn) {
          generateSummaryBtn.disabled = false;
        }
      }
    } catch (error) {
      console.error('Error generating summary:', error);
      showError('Failed to generate summary. Please check your connection and try again.');
      
      // Reset button
      if (summaryBtnText) {
        summaryBtnText.textContent = 'Generate Summary';
      }
      if (generateSummaryBtn) {
        generateSummaryBtn.disabled = false;
      }
    }
  });

  // Handle AI image generation with preview modal
  const generateImageBtn = document.getElementById('generateImageBtn');
  const imagePreviewModal = document.getElementById('imagePreviewModal');
  const previewImage = document.getElementById('previewImage') as HTMLImageElement;
  const acceptImageBtn = document.getElementById('acceptImageBtn');
  const regenerateImageBtn = document.getElementById('regenerateImageBtn');
  const cancelPreviewBtn = document.getElementById('cancelPreviewBtn');
  const generateImageBtnText = document.getElementById('generateImageBtnText');
  const generateImageIcon = document.getElementById('generateImageIcon');
  const generateImageSpinner = document.getElementById('generateImageSpinner');
  const modalLoadingOverlay = document.getElementById('modalLoadingOverlay');
  const modalLoadingText = document.getElementById('modalLoadingText');
  const regenerateIcon = document.getElementById('regenerateIcon');
  const regenerateSpinner = document.getElementById('regenerateSpinner');
  const regenerateImageBtnText = document.getElementById('regenerateImageBtnText');
  const acceptImageBtnText = document.getElementById('acceptImageBtnText');

  let currentPreviewUrl: string | null = null;

  // Generate image preview
  async function generateImagePreview() {
    const entryId = getEntryIdFromUrl();

    if (!entryId) {
      showError('Unable to determine entry ID');
      return;
    }

    // Show loading state with spinner
    if (generateImageBtn && generateImageBtnText && generateImageIcon && generateImageSpinner) {
      generateImageBtn.disabled = true;
      generateImageBtnText.textContent = 'Generating...';
      generateImageIcon.classList.add('hidden');
      generateImageSpinner.classList.remove('hidden');
    }

    try {
      const response = await fetch(`/api/diary/${entryId}/generate-image`, {
        method: 'POST',
      });

      const data = await response.json();

      if (response.ok && data.success && data.imageUrl) {
        // Store the preview URL
        currentPreviewUrl = data.imageUrl;
        
        // Show the preview modal
        if (previewImage && imagePreviewModal) {
          previewImage.src = data.imageUrl;
          imagePreviewModal.classList.remove('hidden');
        }
      } else {
        // Show error
        showError(`Failed to generate image: ${data.error || 'Unknown error'}`);
      }
    } catch (error) {
      console.error('Error generating image:', error);
      showError('Failed to generate image. Please check your connection and try again.');
    } finally {
      // Re-enable button and restore icon
      if (generateImageBtn && generateImageBtnText && generateImageIcon && generateImageSpinner) {
        generateImageBtn.disabled = false;
        generateImageBtnText.textContent = 'Generate Preview';
        generateImageIcon.classList.remove('hidden');
        generateImageSpinner.classList.add('hidden');
      }
    }
  }

  // Generate with modal overlay (for regenerate)
  async function regenerateWithOverlay() {
    const entryId = getEntryIdFromUrl();

    if (!entryId) {
      showError('Unable to determine entry ID');
      return;
    }

    // Show loading overlay in modal
    if (modalLoadingOverlay) {
      modalLoadingOverlay.classList.remove('hidden');
    }
    if (modalLoadingText) {
      modalLoadingText.textContent = 'Regenerating image...';
    }

    // Disable all buttons
    if (acceptImageBtn) acceptImageBtn.disabled = true;
    if (regenerateImageBtn) regenerateImageBtn.disabled = true;
    if (cancelPreviewBtn) cancelPreviewBtn.disabled = true;

    // Show spinner on regenerate button
    if (regenerateIcon && regenerateSpinner && regenerateImageBtnText) {
      regenerateIcon.classList.add('hidden');
      regenerateSpinner.classList.remove('hidden');
      regenerateImageBtnText.textContent = 'Regenerating...';
    }

    try {
      const response = await fetch(`/api/diary/${entryId}/generate-image`, {
        method: 'POST',
      });

      const data = await response.json();

      if (response.ok && data.success && data.imageUrl) {
        // Store the new preview URL
        currentPreviewUrl = data.imageUrl;
        
        // Update the preview image
        if (previewImage) {
          previewImage.src = data.imageUrl;
        }
      } else {
        // Show error
        showError(`Failed to regenerate image: ${data.error || 'Unknown error'}`);
      }
    } catch (error) {
      console.error('Error regenerating image:', error);
      showError('Failed to regenerate image. Please check your connection and try again.');
    } finally {
      // Hide loading overlay
      if (modalLoadingOverlay) {
        modalLoadingOverlay.classList.add('hidden');
      }

      // Re-enable buttons
      if (acceptImageBtn) acceptImageBtn.disabled = false;
      if (regenerateImageBtn) regenerateImageBtn.disabled = false;
      if (cancelPreviewBtn) cancelPreviewBtn.disabled = false;

      // Restore regenerate button
      if (regenerateIcon && regenerateSpinner && regenerateImageBtnText) {
        regenerateIcon.classList.remove('hidden');
        regenerateSpinner.classList.add('hidden');
        regenerateImageBtnText.textContent = 'Regenerate';
      }
    }
  }

  // Accept and save the preview image
  async function acceptImage() {
    if (!currentPreviewUrl) {
      showError('No preview image to accept');
      return;
    }

    const entryId = getEntryIdFromUrl();
    if (!entryId) {
      showError('Unable to determine entry ID');
      return;
    }

    // Show loading state with overlay
    if (modalLoadingOverlay) {
      modalLoadingOverlay.classList.remove('hidden');
    }
    if (modalLoadingText) {
      modalLoadingText.textContent = 'Saving image...';
    }

    // Disable all buttons
    if (acceptImageBtn) {
      acceptImageBtn.disabled = true;
    }
    if (regenerateImageBtn) {
      regenerateImageBtn.disabled = true;
    }
    if (cancelPreviewBtn) {
      cancelPreviewBtn.disabled = true;
    }

    // Update accept button text
    if (acceptImageBtnText) {
      acceptImageBtnText.textContent = 'Saving...';
    }

    try {
      const response = await fetch(`/api/diary/${entryId}/generate-image`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ imageUrl: currentPreviewUrl }),
      });

      const data = await response.json();

      if (response.ok && data.success) {
        // Update loading text to show success
        if (modalLoadingText) {
          modalLoadingText.textContent = 'Saved! Reloading page...';
        }
        
        // Close modal and reload page to show the new cover image
        setTimeout(() => {
          if (imagePreviewModal) {
            imagePreviewModal.classList.add('hidden');
          }
          window.location.reload();
        }, 500);
      } else {
        showError(`Failed to save image: ${data.error || 'Unknown error'}`);
        
        // Hide overlay
        if (modalLoadingOverlay) {
          modalLoadingOverlay.classList.add('hidden');
        }
        
        // Re-enable buttons
        if (acceptImageBtn) acceptImageBtn.disabled = false;
        if (regenerateImageBtn) regenerateImageBtn.disabled = false;
        if (cancelPreviewBtn) cancelPreviewBtn.disabled = false;
        
        // Restore button text
        if (acceptImageBtnText) {
          acceptImageBtnText.textContent = 'Accept & Save';
        }
      }
    } catch (error) {
      console.error('Error accepting image:', error);
      showError('Failed to save image. Please try again.');
      
      // Hide overlay
      if (modalLoadingOverlay) {
        modalLoadingOverlay.classList.add('hidden');
      }
      
      // Re-enable buttons
      if (acceptImageBtn) acceptImageBtn.disabled = false;
      if (regenerateImageBtn) regenerateImageBtn.disabled = false;
      if (cancelPreviewBtn) cancelPreviewBtn.disabled = false;
      
      // Restore button text
      if (acceptImageBtnText) {
        acceptImageBtnText.textContent = 'Accept & Save';
      }
    }
  }

  // Close the preview modal
  function closePreviewModal() {
    if (imagePreviewModal) {
      imagePreviewModal.classList.add('hidden');
    }
    currentPreviewUrl = null;
  }

  // Event listeners for image generation
  generateImageBtn?.addEventListener('click', generateImagePreview);
  acceptImageBtn?.addEventListener('click', acceptImage);
  regenerateImageBtn?.addEventListener('click', regenerateWithOverlay);
  cancelPreviewBtn?.addEventListener('click', closePreviewModal);

  // Close modal on background click
  imagePreviewModal?.addEventListener('click', (e) => {
    if (e.target === imagePreviewModal) {
      closePreviewModal();
    }
  });

  // Handle AI podcast generation
  const generatePodcastBtn = document.getElementById('generatePodcastBtn');
  const deletePodcastBtn = document.getElementById('deletePodcastBtn');
  const generatePodcastBtnText = document.getElementById('generatePodcastBtnText');
  const generatePodcastIcon = document.getElementById('generatePodcastIcon');
  const generatePodcastSpinner = document.getElementById('generatePodcastSpinner');

  // Generate podcast
  async function generatePodcast() {
    const entryId = getEntryIdFromUrl();

    if (!entryId) {
      showError('Unable to determine entry ID');
      return;
    }

    // Show loading state
    if (generatePodcastBtn && generatePodcastBtnText && generatePodcastIcon && generatePodcastSpinner) {
      generatePodcastBtn.disabled = true;
      generatePodcastBtnText.textContent = 'Generating...';
      generatePodcastIcon.classList.add('hidden');
      generatePodcastSpinner.classList.remove('hidden');
    }

    try {
      const response = await fetch(`/api/diary/${entryId}/podcast`, {
        method: 'POST',
      });

      const data = await response.json();

      if (response.ok && data.success) {
        // Create or update the podcast player section
        let podcastSection = document.querySelector('[data-podcast-section]');
        
        if (!podcastSection) {
          // Create new podcast section
          const aiToolsAccordion = document.querySelector('details');
          podcastSection = document.createElement('div');
          podcastSection.setAttribute('data-podcast-section', '');
          podcastSection.className = 'mb-6 bg-gray-50 dark:bg-gray-900 rounded-lg p-4 border border-gray-200 dark:border-gray-800';
          
          podcastSection.innerHTML = `
            <div class="flex items-start justify-between gap-4 mb-3">
              <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                </svg>
                Podcast
              </h3>
              <button
                id="deletePodcastBtn"
                class="text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 p-1.5 rounded transition"
                title="Delete podcast"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </div>
            <audio 
              controls 
              class="w-full"
              preload="metadata"
            >
              <source src="${data.audioUrl}" type="audio/mpeg" />
              Your browser does not support the audio element.
            </audio>
          `;
          
          // Insert after summary section or after AI Tools accordion
          const summarySection = document.querySelector('[data-summary-section]');
          if (summarySection) {
            summarySection.insertAdjacentElement('afterend', podcastSection);
          } else if (aiToolsAccordion) {
            aiToolsAccordion.insertAdjacentElement('afterend', podcastSection);
          }
          
          // Re-attach delete event listener to new button
          const newDeleteBtn = podcastSection.querySelector('#deletePodcastBtn');
          newDeleteBtn?.addEventListener('click', deletePodcast);
        } else {
          // Update existing audio source
          const audioElement = podcastSection.querySelector('audio source');
          if (audioElement) {
            audioElement.src = data.audioUrl;
            const audio = podcastSection.querySelector('audio');
            audio?.load();
          }
        }
        
        // Reset button state
        if (generatePodcastBtn && generatePodcastBtnText && generatePodcastIcon && generatePodcastSpinner) {
          generatePodcastBtn.disabled = false;
          generatePodcastBtnText.textContent = 'Generate Podcast';
          generatePodcastIcon.classList.remove('hidden');
          generatePodcastSpinner.classList.add('hidden');
        }
      } else {
        showError(`Failed to generate podcast: ${data.error || 'Unknown error'}`);
        
        // Reset button
        if (generatePodcastBtn && generatePodcastBtnText && generatePodcastIcon && generatePodcastSpinner) {
          generatePodcastBtn.disabled = false;
          generatePodcastBtnText.textContent = 'Generate Podcast';
          generatePodcastIcon.classList.remove('hidden');
          generatePodcastSpinner.classList.add('hidden');
        }
      }
    } catch (error) {
      console.error('Error generating podcast:', error);
      showError('Failed to generate podcast. Please check your connection and try again.');
      
      // Reset button
      if (generatePodcastBtn && generatePodcastBtnText && generatePodcastIcon && generatePodcastSpinner) {
        generatePodcastBtn.disabled = false;
        generatePodcastBtnText.textContent = 'Generate Podcast';
        generatePodcastIcon.classList.remove('hidden');
        generatePodcastSpinner.classList.add('hidden');
      }
    }
  }

  // Delete podcast
  async function deletePodcast() {
    const entryId = getEntryIdFromUrl();

    if (!entryId) {
      showError('Unable to determine entry ID');
      return;
    }

    if (!confirm('Are you sure you want to delete this podcast? This action cannot be undone.')) {
      return;
    }

    try {
      const response = await fetch(`/api/diary/${entryId}/podcast`, {
        method: 'DELETE',
      });

      const data = await response.json();

      if (response.ok && data.success) {
        // Remove the podcast section
        const podcastSection = document.querySelector('[data-podcast-section]');
        if (podcastSection) {
          podcastSection.remove();
        }
      } else {
        showError(`Failed to delete podcast: ${data.error || 'Unknown error'}`);
      }
    } catch (error) {
      console.error('Error deleting podcast:', error);
      showError('Failed to delete podcast. Please check your connection and try again.');
    }
  }

  // Event listeners for podcast generation
  generatePodcastBtn?.addEventListener('click', generatePodcast);
  deletePodcastBtn?.addEventListener('click', deletePodcast);
  }

  // Run on initial page load and after View Transitions navigation
  document.addEventListener('astro:page-load', initializeDetailPage);
</script>


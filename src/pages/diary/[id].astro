---
import Layout from '../../layouts/Layout.astro';
import { db, DiaryEntry, NPC, Location, Character, Quest, eq, inArray } from 'astro:db';
import { isAuthenticated, getUserRole } from '../../lib/auth';
import { renderMarkdown } from '../../utils/markdown';
import { getVideoMimeType } from '../../utils/video';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/diary');
}

const entries = await db.select().from(DiaryEntry).where(eq(DiaryEntry.id, id));
const entry = entries[0];

if (!entry) {
  return Astro.redirect('/diary');
}

const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);
const canGenerateSummary = userRole === 'dungeonmaster' || userRole === 'admin';

// Get all diary entries to find previous and next sessions
// Note: For typical D&D campaigns (10-100 sessions), fetching all entries is acceptable.
// For larger datasets, consider optimizing with targeted queries based on session number.
const allEntries = await db.select().from(DiaryEntry);
allEntries.sort((a, b) => a.session - b.session);

// Find previous and next entries based on session number
let previousEntry = null;
let nextEntry = null;

const currentIndex = allEntries.findIndex(e => e.id === id);
if (currentIndex > 0) {
  previousEntry = allEntries[currentIndex - 1];
}
if (currentIndex < allEntries.length - 1) {
  nextEntry = allEntries[currentIndex + 1];
}

// Fetch related entities
let relatedNPCs: any[] = [];
let relatedLocations: any[] = [];
let relatedCharacters: any[] = [];
let relatedQuests: any[] = [];

const npcIds = Array.isArray(entry.npcIds) ? entry.npcIds : [];
const locationIds = Array.isArray(entry.locationIds) ? entry.locationIds : [];
const characterIds = Array.isArray(entry.characterIds) ? entry.characterIds : [];
const questIds = Array.isArray(entry.questIds) ? entry.questIds : [];

if (npcIds.length > 0) {
  relatedNPCs = await db.select().from(NPC).where(inArray(NPC.id, npcIds));
}
if (locationIds.length > 0) {
  relatedLocations = await db.select().from(Location).where(inArray(Location.id, locationIds));
}
if (characterIds.length > 0) {
  relatedCharacters = await db.select().from(Character).where(inArray(Character.id, characterIds));
}
if (questIds.length > 0) {
  relatedQuests = await db.select().from(Quest).where(inArray(Quest.id, questIds));
}

// Render markdown content
const renderedContent = renderMarkdown(entry.content);
---

<Layout title={entry.title}>
  <div class="max-w-4xl mx-auto">
    <!-- Header with Back Button -->
    <div class="flex items-center justify-between mb-6">
      <a href="/diary" class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Diary
      </a>
      {isLoggedIn && (
        <div class="flex gap-2">
          <button 
            id="editEntry"
            data-id={entry.id}
            class="bg-primary-600 text-white px-4 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
          >
            Edit
          </button>
          <button 
            id="deleteEntry"
            data-id={entry.id}
            class="border-2 border-red-600 text-red-600 dark:text-red-400 dark:border-red-500 px-4 py-2 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition"
          >
            Delete
          </button>
        </div>
      )}
    </div>

    <!-- Cover Video or Image -->
    {entry.coverVideoUrl ? (
      <div class="mb-8 rounded-lg overflow-hidden shadow-lg">
        <video 
          autoplay
          muted
          playsinline
          loop
          preload="auto"
          disablePictureInPicture
          class="w-full h-96 object-cover"
          aria-label={`Cover video for ${entry.title}`}
        >
          <source src={entry.coverVideoUrl} type={getVideoMimeType(entry.coverVideoUrl)} />
          Your browser does not support the video tag.
        </video>
      </div>
    ) : entry.coverImageUrl && (
      <div class="mb-8 rounded-lg overflow-hidden shadow-lg">
        <img 
          src={entry.coverImageUrl} 
          alt={entry.title}
          class="w-full h-96 object-cover"
        />
      </div>
    )}

    <!-- Entry Header -->
    <article class="bg-white dark:bg-black rounded-lg shadow-md p-8 mb-6 dark:border dark:border-gray-900">
      <h1 class="text-4xl font-bold text-primary-700 dark:text-primary-400 mb-4">{entry.title}</h1>
      
      <div class="flex gap-4 text-sm text-gray-600 dark:text-gray-400 mb-6">
        <span class="flex items-center gap-1">
          Session {entry.session}
        </span>
      </div>

      <!-- Tags -->
      {Array.isArray(entry.tags) && entry.tags.length > 0 && (
        <div class="flex gap-2 flex-wrap mb-6">
          {entry.tags.map((tag: string) => (
            <span class="bg-primary-100 dark:bg-primary-900/20 dark:border dark:border-primary-800 text-primary-700 dark:text-primary-400 px-3 py-1 rounded-full text-sm">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <!-- AI Summary -->
      {(entry.summary || canGenerateSummary) && (
        <div id="summarySection" class="mb-6 border-l-4 border-secondary-500 bg-secondary-50 dark:bg-secondary-900/10 dark:border-secondary-600 p-4 rounded-r-lg">
          <div class="flex flex-col items-start justify-between gap-4">
            <div class="flex-1">
              <h3 class="text-sm font-semibold text-secondary-700 dark:text-secondary-400 mb-2 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
                AI Summary
              </h3>
              <div id="summaryContent" class="text-gray-700 dark:text-gray-300">
                {entry.summary ? (
                  <p>{entry.summary}</p>
                ) : (
                  <p class="text-gray-500 dark:text-gray-500 italic">No summary yet</p>
                )}
              </div>
            </div>
            {canGenerateSummary && (
              <div class="flex-shrink-0 flex gap-2">
                <button
                  id="generateSummaryBtn"
                  class="bg-secondary-600 text-white px-3 py-1.5 rounded-lg hover:bg-secondary-700 dark:bg-secondary-700 dark:hover:bg-secondary-600 transition text-sm font-medium flex items-center gap-2"
                  title="Generate AI summary"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                  <span id="generateSummaryBtnText">Generate</span>
                </button>
                <button
                  id="deleteSummaryBtn"
                  class:list={[
                    "border-2 border-red-600 text-red-600 dark:text-red-400 dark:border-red-500 px-3 py-1.5 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition text-sm font-medium flex items-center gap-2",
                    { "hidden": !entry.summary }
                  ]}
                  title="Delete AI summary"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
            )}
          </div>
        </div>
      )}

      <!-- Podcast Player -->
      <div class="mb-6 flex items-center gap-3">
        <button
          id="playPauseBtn"
          class="w-10 h-10 rounded-full bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 flex items-center justify-center transition-all shadow-sm hover:shadow-md"
          title="Play"
        >
          <svg id="playIcon" class="w-5 h-5 text-gray-700 dark:text-gray-300 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <svg id="pauseIcon" class="hidden w-5 h-5 text-gray-700 dark:text-gray-300" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
          </svg>
        </button>
        <button
          id="stopBtn"
          class="hidden w-8 h-8 rounded-full bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 flex items-center justify-center transition-all"
          title="Stop"
        >
          <svg class="w-4 h-4 text-gray-700 dark:text-gray-300" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 6h12v12H6z"/>
          </svg>
        </button>
        <div id="podcastStatus" class="text-xs text-gray-500 dark:text-gray-500 hidden">
          <span id="podcastStatusText"></span>
        </div>
      </div>

      <!-- Content -->
      <div class="prose dark:prose-invert max-w-none mb-6">
        <div 
          class="diary-text text-gray-700 dark:text-gray-300 text-lg leading-relaxed"
          set:html={renderedContent}
        />
      </div>

      <!-- Session Navigation -->
      <div class="flex items-center justify-center gap-3 pt-6 border-t border-gray-200 dark:border-gray-800">
        {previousEntry ? (
          <a 
            href={`/diary/${previousEntry.id}`}
            class="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-accent-100 dark:bg-accent-900/20 dark:border dark:border-accent-800 text-accent-700 dark:text-accent-400 rounded-lg hover:bg-accent-200 dark:hover:bg-accent-900/30 transition font-medium text-sm"
            title={`Session ${previousEntry.session}: ${previousEntry.title}`}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span>Session {previousEntry.session}</span>
          </a>
        ) : (
          <div class="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-400 dark:text-gray-600 rounded-lg cursor-not-allowed font-medium text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span>Previous</span>
          </div>
        )}
        
        {nextEntry ? (
          <a 
            href={`/diary/${nextEntry.id}`}
            class="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-accent-100 dark:bg-accent-900/20 dark:border dark:border-accent-800 text-accent-700 dark:text-accent-400 rounded-lg hover:bg-accent-200 dark:hover:bg-accent-900/30 transition font-medium text-sm"
            title={`Session ${nextEntry.session}: ${nextEntry.title}`}
          >
            <span>Session {nextEntry.session}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ) : (
          <div class="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-400 dark:text-gray-600 rounded-lg cursor-not-allowed font-medium text-sm">
            <span>Next</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        )}
      </div>
    </article>

    <!-- Player Notes Section (only visible when logged in) -->
    {isLoggedIn && (
      <div id="playerNotesSection" class="bg-white dark:bg-black rounded-lg shadow-md p-8 mb-6 dark:border dark:border-gray-900">
        <h2 class="text-2xl font-bold text-primary-700 dark:text-primary-400 mb-4 flex items-center gap-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          My Notes
        </h2>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
          Private notes only you can see
        </p>
        
        <!-- Note Display/Edit Area -->
        <div id="noteDisplay" class="hidden">
          <div 
            id="noteContent"
            class="prose dark:prose-invert max-w-none mb-4 bg-gray-50 dark:bg-gray-900 p-4 rounded-lg border border-gray-200 dark:border-gray-800"
          ></div>
          <div class="flex gap-2">
            <button 
              id="editNoteBtn"
              class="bg-primary-600 text-white px-4 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
            >
              Edit Note
            </button>
            <button 
              id="deleteNoteBtn"
              class="border-2 border-red-600 text-red-600 dark:text-red-400 dark:border-red-500 px-4 py-2 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition"
            >
              Delete Note
            </button>
          </div>
        </div>

        <!-- Note Editor -->
        <div id="noteEditor">
          <textarea 
            id="noteTextarea"
            class="w-full min-h-[200px] p-4 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 focus:border-transparent resize-y"
            placeholder="Add your private notes here... (Markdown supported)"
          ></textarea>
          <div class="flex gap-2 mt-4">
            <button 
              id="saveNoteBtn"
              class="bg-primary-600 text-white px-4 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
            >
              Save Note
            </button>
            <button 
              id="cancelNoteBtn"
              class="hidden border-2 border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 px-4 py-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition"
            >
              Cancel
            </button>
          </div>
        </div>
      </div>
    )}

    <!-- Related Entities -->
    {(relatedNPCs.length > 0 || relatedLocations.length > 0 || relatedCharacters.length > 0 || relatedQuests.length > 0) && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {/* NPCs */}
        {relatedNPCs.length > 0 && (
          <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900">
            <h3 class="text-xl font-semibold text-primary-700 dark:text-primary-400 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              NPCs Met
            </h3>
            <ul class="space-y-2">
              {relatedNPCs.map(npc => (
                <li class="border-l-2 border-primary-300 dark:border-primary-700 pl-3">
                  <a href={`/npcs/${npc.id}`} class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
                    {npc.name}
                  </a>
                  <p class="text-sm text-gray-600 dark:text-gray-400">{npc.race} - {npc.relationship}</p>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Locations */}
        {relatedLocations.length > 0 && (
          <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900">
            <h3 class="text-xl font-semibold text-primary-700 dark:text-primary-400 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              Locations Visited
            </h3>
            <ul class="space-y-2">
              {relatedLocations.map(location => (
                <li class="border-l-2 border-primary-300 dark:border-primary-700 pl-3">
                  <a href={`/locations/${location.id}`} class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
                    {location.name}
                  </a>
                  <p class="text-sm text-gray-600 capitalize">{location.type}</p>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Characters */}
        {relatedCharacters.length > 0 && (
          <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900">
            <h3 class="text-xl font-semibold text-primary-700 dark:text-primary-400 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              Party Members
            </h3>
            <ul class="space-y-2">
              {relatedCharacters.map(character => (
                <li class="border-l-2 border-primary-300 dark:border-primary-700 pl-3">
                  <a href={`/characters/${character.id}`} class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
                    {character.name}
                  </a>
                  <p class="text-sm text-gray-600 dark:text-gray-400">Level {character.level} {character.race} {character.class}</p>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Quests */}
        {relatedQuests.length > 0 && (
          <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900">
            <h3 class="text-xl font-semibold text-primary-700 dark:text-primary-400 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
              Related Quests
            </h3>
            <ul class="space-y-2">
              {relatedQuests.map(quest => (
                <li class="border-l-2 border-primary-300 dark:border-primary-700 pl-3">
                  <a href="/quests" class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
                    {quest.title}
                  </a>
                  <p class="text-sm text-gray-600 capitalize">{quest.status} - {quest.priority} priority</p>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </div>
</Layout>

<style is:global>
  .diary-text p + p {
    margin-top: 2rem;
  }
</style>

<script>
  function initializeDetailPage() {
    const deleteBtn = document.getElementById('deleteEntry');
    const editBtn = document.getElementById('editEntry');
    const generateSummaryBtn = document.getElementById('generateSummaryBtn');
    const deleteSummaryBtn = document.getElementById('deleteSummaryBtn');
    const summaryContent = document.getElementById('summaryContent');
    const summaryBtnText = document.getElementById('generateSummaryBtnText');
    
    // Helper function to get entry ID from URL
    function getEntryIdFromUrl() {
      const pathParts = window.location.pathname.split('/');
      return pathParts[pathParts.length - 1];
    }

    // Helper function to show error alert
    function showError(message) {
      alert(message);
    }
    
    // Handle edit button click
    editBtn?.addEventListener('click', () => {
      const id = editBtn.getAttribute('data-id');
      if (id) {
        window.location.href = `/diary?edit=${id}`;
      }
    });
    
    deleteBtn?.addEventListener('click', async () => {
    const id = deleteBtn.getAttribute('data-id');
    if (!id) return;
    
    if (confirm('Are you sure you want to delete this entry?')) {
      try {
        const response = await fetch(`/api/diary/${id}`, {
          method: 'DELETE',
        });
        
        if (response.ok) {
          window.location.href = '/diary';
        } else {
          const error = await response.json().catch(() => ({ error: 'Unknown error' }));
          showError(`Failed to delete entry: ${error.error || response.statusText}`);
        }
      } catch (error) {
        console.error('Delete error:', error);
        showError('An error occurred while deleting the entry. Please check your connection and try again.');
      }
    }
  });

  // Handle delete summary button click
  deleteSummaryBtn?.addEventListener('click', async () => {
    const entryId = getEntryIdFromUrl();

    if (!entryId) {
      showError('Unable to determine entry ID');
      return;
    }

    if (!confirm('Are you sure you want to delete this summary? This action cannot be undone.')) {
      return;
    }

    try {
      const response = await fetch(`/api/diary/${entryId}/summary`, {
        method: 'DELETE',
      });

      const data = await response.json();

      if (response.ok && data.success) {
        // Update the summary display to show "No summary yet"
        if (summaryContent) {
          summaryContent.innerHTML = '';
          const p = document.createElement('p');
          p.className = 'text-gray-500 dark:text-gray-500 italic';
          p.textContent = 'No summary yet';
          summaryContent.appendChild(p);
        }
        
        // Hide the delete button
        if (deleteSummaryBtn) {
          deleteSummaryBtn.classList.add('hidden');
        }

        // Update generate button text
        if (summaryBtnText) {
          summaryBtnText.textContent = 'Generate';
        }
      } else {
        showError(`Failed to delete summary: ${data.error || 'Unknown error'}`);
      }
    } catch (error) {
      console.error('Error deleting summary:', error);
      showError('Failed to delete summary. Please check your connection and try again.');
    }
  });

  // Handle generate summary button click
  generateSummaryBtn?.addEventListener('click', async () => {
    const entryId = getEntryIdFromUrl();

    if (!entryId) {
      showError('Unable to determine entry ID');
      return;
    }

    // Show loading state
    if (generateSummaryBtn && summaryBtnText) {
      generateSummaryBtn.disabled = true;
      summaryBtnText.textContent = 'Generating...';
    }

    try {
      const response = await fetch(`/api/diary/${entryId}/summary`, {
        method: 'POST',
      });

      const data = await response.json();

      if (response.ok && data.success) {
        // Update the summary display (using textContent to prevent XSS)
        if (summaryContent) {
          // Clear existing content
          summaryContent.innerHTML = '';
          // Create a new paragraph element and set text safely
          const p = document.createElement('p');
          p.textContent = data.summary;
          summaryContent.appendChild(p);
        }
        
        // Show the delete button if it exists
        if (deleteSummaryBtn) {
          deleteSummaryBtn.classList.remove('hidden');
        }
        
        // Show success message
        if (summaryBtnText) {
          summaryBtnText.textContent = 'Regenerate';
        }
      } else {
        // Show error
        showError(`Failed to generate summary: ${data.error || 'Unknown error'}`);
        
        // Reset button
        if (summaryBtnText) {
          summaryBtnText.textContent = 'Generate';
        }
      }
    } catch (error) {
      console.error('Error generating summary:', error);
      showError('Failed to generate summary. Please check your connection and try again.');
      
      // Reset button
      if (summaryBtnText) {
        summaryBtnText.textContent = 'Generate';
      }
    } finally {
      // Re-enable button
      if (generateSummaryBtn) {
        generateSummaryBtn.disabled = false;
      }
    }
  });
  }

  // Run on initial page load and after View Transitions navigation
  document.addEventListener('astro:page-load', initializeDetailPage);
</script>


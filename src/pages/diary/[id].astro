---
import Layout from '../../layouts/Layout.astro';
import { db, DiaryEntry, NPC, Location, Character, Quest, eq, inArray } from 'astro:db';
import { isAuthenticated } from '../../lib/auth';
import { renderMarkdown } from '../../utils/markdown';
import { getVideoMimeType } from '../../utils/video';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/diary');
}

const entries = await db.select().from(DiaryEntry).where(eq(DiaryEntry.id, id));
const entry = entries[0];

if (!entry) {
  return Astro.redirect('/diary');
}

const isLoggedIn = isAuthenticated(Astro.cookies);

// Get all diary entries to find previous and next sessions
// Note: For typical D&D campaigns (10-100 sessions), fetching all entries is acceptable.
// For larger datasets, consider optimizing with targeted queries based on session number.
const allEntries = await db.select().from(DiaryEntry);
allEntries.sort((a, b) => a.session - b.session);

// Find previous and next entries based on session number
let previousEntry = null;
let nextEntry = null;

const currentIndex = allEntries.findIndex(e => e.id === id);
if (currentIndex > 0) {
  previousEntry = allEntries[currentIndex - 1];
}
if (currentIndex < allEntries.length - 1) {
  nextEntry = allEntries[currentIndex + 1];
}

// Fetch related entities
let relatedNPCs: any[] = [];
let relatedLocations: any[] = [];
let relatedCharacters: any[] = [];
let relatedQuests: any[] = [];

const npcIds = Array.isArray(entry.npcIds) ? entry.npcIds : [];
const locationIds = Array.isArray(entry.locationIds) ? entry.locationIds : [];
const characterIds = Array.isArray(entry.characterIds) ? entry.characterIds : [];
const questIds = Array.isArray(entry.questIds) ? entry.questIds : [];

if (npcIds.length > 0) {
  relatedNPCs = await db.select().from(NPC).where(inArray(NPC.id, npcIds));
}
if (locationIds.length > 0) {
  relatedLocations = await db.select().from(Location).where(inArray(Location.id, locationIds));
}
if (characterIds.length > 0) {
  relatedCharacters = await db.select().from(Character).where(inArray(Character.id, characterIds));
}
if (questIds.length > 0) {
  relatedQuests = await db.select().from(Quest).where(inArray(Quest.id, questIds));
}

// Render markdown content
const renderedContent = renderMarkdown(entry.content);
---

<Layout title={entry.title}>
  <div class="max-w-4xl mx-auto">
    <!-- Header with Back Button -->
    <div class="flex items-center justify-between mb-6">
      <a href="/diary" class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Diary
      </a>
      {isLoggedIn && (
        <div class="flex gap-2">
          <button 
            id="editEntry"
            data-id={entry.id}
            class="bg-primary-600 text-white px-4 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
          >
            Edit
          </button>
          <button 
            id="deleteEntry"
            data-id={entry.id}
            class="border-2 border-red-600 text-red-600 dark:text-red-400 dark:border-red-500 px-4 py-2 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition"
          >
            Delete
          </button>
        </div>
      )}
    </div>

    <!-- Cover Video or Image -->
    {entry.coverVideoUrl ? (
      <div class="mb-8 rounded-lg overflow-hidden shadow-lg">
        <video 
          autoplay
          muted
          playsinline
          loop
          preload="auto"
          disablePictureInPicture
          class="w-full h-96 object-cover"
          aria-label={`Cover video for ${entry.title}`}
        >
          <source src={entry.coverVideoUrl} type={getVideoMimeType(entry.coverVideoUrl)} />
          Your browser does not support the video tag.
        </video>
      </div>
    ) : entry.coverImageUrl && (
      <div class="mb-8 rounded-lg overflow-hidden shadow-lg">
        <img 
          src={entry.coverImageUrl} 
          alt={entry.title}
          class="w-full h-96 object-cover"
        />
      </div>
    )}

    <!-- Entry Header -->
    <article class="bg-white dark:bg-black rounded-lg shadow-md p-8 mb-6 dark:border dark:border-gray-900">
      <h1 class="text-4xl font-bold text-primary-700 dark:text-primary-400 mb-4">{entry.title}</h1>
      
      <div class="flex gap-4 text-sm text-gray-600 dark:text-gray-400 mb-6">
        <span class="flex items-center gap-1">
          Session {entry.session}
        </span>
      </div>

      <!-- Tags -->
      {Array.isArray(entry.tags) && entry.tags.length > 0 && (
        <div class="flex gap-2 flex-wrap mb-6">
          {entry.tags.map((tag: string) => (
            <span class="bg-primary-100 dark:bg-primary-900/20 dark:border dark:border-primary-800 text-primary-700 dark:text-primary-400 px-3 py-1 rounded-full text-sm">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <!-- Podcast Player -->
      <div class="mb-6 bg-secondary-50 dark:bg-secondary-900/10 border-2 border-secondary-200 dark:border-secondary-800 rounded-lg p-4">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-lg font-semibold text-secondary-700 dark:text-secondary-400 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
            </svg>
            Podcast Version
          </h3>
          <div id="podcastVoiceSelect" class="hidden">
            <select id="voiceSelector" class="text-sm px-2 py-1 border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300">
              <option value="">Default Voice</option>
            </select>
          </div>
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
          Listen to this diary entry as an audio podcast
        </p>
        <div class="flex gap-2">
          <button
            id="playPodcastBtn"
            class="flex items-center gap-2 bg-secondary-600 text-white px-4 py-2 rounded-lg hover:bg-secondary-700 dark:bg-secondary-700 dark:hover:bg-secondary-600 transition font-medium text-sm"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
            Play Podcast
          </button>
          <button
            id="pausePodcastBtn"
            class="hidden items-center gap-2 bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition font-medium text-sm"
            style="display: none;"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
            </svg>
            Pause
          </button>
          <button
            id="stopPodcastBtn"
            class="hidden items-center gap-2 bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition font-medium text-sm"
            style="display: none;"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6 6h12v12H6z"/>
            </svg>
            Stop
          </button>
        </div>
        <div id="podcastStatus" class="mt-3 text-sm text-gray-600 dark:text-gray-400 hidden">
          <span id="podcastStatusText"></span>
        </div>
      </div>

      <!-- Content -->
      <div class="prose dark:prose-invert max-w-none mb-6">
        <div 
          class="diary-text text-gray-700 dark:text-gray-300 text-lg leading-relaxed"
          set:html={renderedContent}
        />
      </div>

      <!-- Session Navigation -->
      <div class="flex items-center justify-center gap-3 pt-6 border-t border-gray-200 dark:border-gray-800">
        {previousEntry ? (
          <a 
            href={`/diary/${previousEntry.id}`}
            class="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-accent-100 dark:bg-accent-900/20 dark:border dark:border-accent-800 text-accent-700 dark:text-accent-400 rounded-lg hover:bg-accent-200 dark:hover:bg-accent-900/30 transition font-medium text-sm"
            title={`Session ${previousEntry.session}: ${previousEntry.title}`}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span>Session {previousEntry.session}</span>
          </a>
        ) : (
          <div class="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-400 dark:text-gray-600 rounded-lg cursor-not-allowed font-medium text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span>Previous</span>
          </div>
        )}
        
        {nextEntry ? (
          <a 
            href={`/diary/${nextEntry.id}`}
            class="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-accent-100 dark:bg-accent-900/20 dark:border dark:border-accent-800 text-accent-700 dark:text-accent-400 rounded-lg hover:bg-accent-200 dark:hover:bg-accent-900/30 transition font-medium text-sm"
            title={`Session ${nextEntry.session}: ${nextEntry.title}`}
          >
            <span>Session {nextEntry.session}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ) : (
          <div class="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-400 dark:text-gray-600 rounded-lg cursor-not-allowed font-medium text-sm">
            <span>Next</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        )}
      </div>
    </article>

    <!-- Related Entities -->
    {(relatedNPCs.length > 0 || relatedLocations.length > 0 || relatedCharacters.length > 0 || relatedQuests.length > 0) && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {/* NPCs */}
        {relatedNPCs.length > 0 && (
          <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900">
            <h3 class="text-xl font-semibold text-primary-700 dark:text-primary-400 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              NPCs Met
            </h3>
            <ul class="space-y-2">
              {relatedNPCs.map(npc => (
                <li class="border-l-2 border-primary-300 dark:border-primary-700 pl-3">
                  <a href={`/npcs/${npc.id}`} class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
                    {npc.name}
                  </a>
                  <p class="text-sm text-gray-600 dark:text-gray-400">{npc.race} - {npc.relationship}</p>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Locations */}
        {relatedLocations.length > 0 && (
          <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900">
            <h3 class="text-xl font-semibold text-primary-700 dark:text-primary-400 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              Locations Visited
            </h3>
            <ul class="space-y-2">
              {relatedLocations.map(location => (
                <li class="border-l-2 border-primary-300 dark:border-primary-700 pl-3">
                  <a href={`/locations/${location.id}`} class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
                    {location.name}
                  </a>
                  <p class="text-sm text-gray-600 capitalize">{location.type}</p>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Characters */}
        {relatedCharacters.length > 0 && (
          <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900">
            <h3 class="text-xl font-semibold text-primary-700 dark:text-primary-400 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              Party Members
            </h3>
            <ul class="space-y-2">
              {relatedCharacters.map(character => (
                <li class="border-l-2 border-primary-300 dark:border-primary-700 pl-3">
                  <a href={`/characters/${character.id}`} class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
                    {character.name}
                  </a>
                  <p class="text-sm text-gray-600 dark:text-gray-400">Level {character.level} {character.race} {character.class}</p>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Quests */}
        {relatedQuests.length > 0 && (
          <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900">
            <h3 class="text-xl font-semibold text-primary-700 dark:text-primary-400 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
              Related Quests
            </h3>
            <ul class="space-y-2">
              {relatedQuests.map(quest => (
                <li class="border-l-2 border-primary-300 dark:border-primary-700 pl-3">
                  <a href="/quests" class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
                    {quest.title}
                  </a>
                  <p class="text-sm text-gray-600 capitalize">{quest.status} - {quest.priority} priority</p>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </div>
</Layout>

<style is:global>
  .diary-text p + p {
    margin-top: 2rem;
  }
</style>

<script>
  function initializeDetailPage() {
    const deleteBtn = document.getElementById('deleteEntry');
    const editBtn = document.getElementById('editEntry');
    
    // Handle edit button click
    editBtn?.addEventListener('click', () => {
      const id = editBtn.getAttribute('data-id');
      if (id) {
        window.location.href = `/diary?edit=${id}`;
      }
    });
    
    deleteBtn?.addEventListener('click', async () => {
    const id = deleteBtn.getAttribute('data-id');
    if (!id) return;
    
    if (confirm('Are you sure you want to delete this entry?')) {
      try {
        const response = await fetch(`/api/diary/${id}`, {
          method: 'DELETE',
        });
        
        if (response.ok) {
          window.location.href = '/diary';
        } else {
          const error = await response.json().catch(() => ({ error: 'Unknown error' }));
          alert(`Failed to delete entry: ${error.error || response.statusText}`);
        }
      } catch (error) {
        console.error('Delete error:', error);
        alert('An error occurred while deleting the entry. Please check your connection and try again.');
      }
    }
  });
  }

  // Run on initial page load and after View Transitions navigation
  document.addEventListener('astro:page-load', initializeDetailPage);
</script>

<script>
  import { initializeVideoAutoplay } from '../../utils/video';
  
  // Ensure videos play after View Transitions navigation
  document.addEventListener('astro:page-load', initializeVideoAutoplay);
</script>

<script>
  function initializePodcast() {
    const playBtn = document.getElementById('playPodcastBtn');
    const pauseBtn = document.getElementById('pausePodcastBtn');
    const stopBtn = document.getElementById('stopPodcastBtn');
    const statusDiv = document.getElementById('podcastStatus');
    const statusText = document.getElementById('podcastStatusText');
    const voiceSelect = document.getElementById('voiceSelector') as HTMLSelectElement;
    const voiceSelectDiv = document.getElementById('podcastVoiceSelect');

    if (!playBtn || !pauseBtn || !stopBtn || !statusDiv || !statusText || !voiceSelect) {
      return;
    }

    // Helper function to prepare podcast text
    function preparePodcastText(title: string, content: string): string {
      // Remove markdown formatting
      let text = content
        .replace(/#{1,6}\s+/g, '')
        .replace(/\*\*([^*]+)\*\*/g, '$1')
        .replace(/\*([^*]+)\*/g, '$1')
        .replace(/__([^_]+)__/g, '$1')
        .replace(/_([^_]+)_/g, '$1')
        .replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1')
        .replace(/`([^`]+)`/g, '$1')
        .replace(/---+/g, '')
        .replace(/>\s+/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      const intro = `Session recording: ${title}.`;
      const outro = 'End of session recording.';
      const paragraphs = text.split(/\n\n+/).filter(p => p.trim());
      const narration = paragraphs.join('... ');
      
      return `${intro} ${narration} ${outro}`;
    }

    // Get diary entry content from the page
    const titleElement = document.querySelector('h1');
    const contentElement = document.querySelector('.diary-text');
    
    if (!titleElement || !contentElement) {
      console.error('Could not find diary entry content');
      return;
    }

    const title = titleElement.textContent || '';
    const content = contentElement.textContent || '';
    const podcastText = preparePodcastText(title, content);

    let isPaused = false;
    let selectedVoice: SpeechSynthesisVoice | undefined;

    // Load available voices
    function loadVoices() {
      const voices = window.speechSynthesis.getVoices();
      if (voices.length > 0) {
        voiceSelectDiv?.classList.remove('hidden');
        voiceSelect.innerHTML = '<option value="">Default Voice</option>';
        
        // Add all voices with their actual index from the voices array
        voices.forEach((voice, index) => {
          const option = document.createElement('option');
          option.value = index.toString();
          option.textContent = `${voice.name} (${voice.lang})${voice.default ? ' [Default]' : ''}`;
          voiceSelect.appendChild(option);
        });
      }
    }

    // Initialize voices
    if ('speechSynthesis' in window) {
      loadVoices();
      // Voices may load asynchronously
      if (window.speechSynthesis.onvoiceschanged !== undefined) {
        window.speechSynthesis.onvoiceschanged = loadVoices;
      }
    }

    // Voice selection handler
    voiceSelect.addEventListener('change', () => {
      const voices = window.speechSynthesis.getVoices();
      const selectedIndex = parseInt(voiceSelect.value);
      if (!isNaN(selectedIndex) && selectedIndex >= 0 && selectedIndex < voices.length) {
        selectedVoice = voices[selectedIndex];
      } else {
        selectedVoice = undefined;
      }
    });

    // Play button handler
    playBtn.addEventListener('click', () => {
      if (isPaused) {
        window.speechSynthesis.resume();
        isPaused = false;
        playBtn.style.display = 'none';
        pauseBtn.style.display = 'flex';
        stopBtn.style.display = 'flex';
        statusDiv.classList.remove('hidden');
        statusText.textContent = 'Playing podcast...';
      } else {
        try {
          window.speechSynthesis.cancel();
          const utterance = new SpeechSynthesisUtterance(podcastText);
          utterance.rate = 0.9;
          utterance.pitch = 1.0;
          utterance.volume = 1.0;
          
          if (selectedVoice) {
            utterance.voice = selectedVoice;
          }

          utterance.onend = () => {
            playBtn.style.display = 'flex';
            pauseBtn.style.display = 'none';
            stopBtn.style.display = 'none';
            statusDiv.classList.add('hidden');
          };

          window.speechSynthesis.speak(utterance);
          playBtn.style.display = 'none';
          pauseBtn.style.display = 'flex';
          stopBtn.style.display = 'flex';
          statusDiv.classList.remove('hidden');
          statusText.textContent = 'Playing podcast...';
        } catch (error) {
          console.error('Podcast playback error:', error);
          statusText.textContent = 'Error: ' + (error instanceof Error ? error.message : 'Unknown error');
          statusDiv.classList.remove('hidden');
        }
      }
    });

    // Pause button handler
    pauseBtn.addEventListener('click', () => {
      window.speechSynthesis.pause();
      isPaused = true;
      playBtn.style.display = 'flex';
      pauseBtn.style.display = 'none';
      statusText.textContent = 'Podcast paused';
    });

    // Stop button handler
    stopBtn.addEventListener('click', () => {
      window.speechSynthesis.cancel();
      isPaused = false;
      playBtn.style.display = 'flex';
      pauseBtn.style.display = 'none';
      stopBtn.style.display = 'none';
      statusDiv.classList.add('hidden');
    });

    // Check if speech synthesis is supported
    if (!('speechSynthesis' in window)) {
      playBtn.disabled = true;
      playBtn.classList.add('opacity-50', 'cursor-not-allowed');
      statusText.textContent = 'Text-to-speech is not supported in your browser';
      statusDiv.classList.remove('hidden');
    }
  }

  // Initialize on page load
  document.addEventListener('astro:page-load', initializePodcast);
</script>

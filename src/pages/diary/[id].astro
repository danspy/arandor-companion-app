---
import Layout from '../../layouts/Layout.astro';
import SceneBackdrop from '../../components/SceneBackdrop.astro';
import Button from '../../components/Button.astro';
import { db, DiaryEntry, NPC, Location, Character, Quest, eq, inArray } from '@/db';
import { isAuthenticated, getUserRole } from '../../lib/auth';
import { renderMarkdown } from '../../utils/markdown';
import { getVideoMimeType, isVideoUrl } from '../../utils/video';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/diary');
}

const entries = await db.select().from(DiaryEntry).where(eq(DiaryEntry.id, id));
const entry = entries[0];

if (!entry) {
  return Astro.redirect('/diary');
}

const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);
const canManageSummary = userRole === 'dungeonmaster' || userRole === 'admin';

// Get all diary entries to find previous and next sessions
// Note: For typical D&D campaigns (10-100 sessions), fetching all entries is acceptable.
// For larger datasets, consider optimizing with targeted queries based on session number.
const allEntries = await db.select().from(DiaryEntry);
allEntries.sort((a, b) => a.session - b.session);

// Find previous and next entries based on session number
let previousEntry = null;
let nextEntry = null;

const currentIndex = allEntries.findIndex(e => e.id === id);
if (currentIndex > 0) {
  previousEntry = allEntries[currentIndex - 1];
}
if (currentIndex < allEntries.length - 1) {
  nextEntry = allEntries[currentIndex + 1];
}

// Fetch related entities
let relatedNPCs: any[] = [];
let relatedLocations: any[] = [];
let relatedCharacters: any[] = [];
let relatedQuests: any[] = [];

const npcIds = Array.isArray(entry.npcIds) ? entry.npcIds : [];
const locationIds = Array.isArray(entry.locationIds) ? entry.locationIds : [];
const characterIds = Array.isArray(entry.characterIds) ? entry.characterIds : [];
const questIds = Array.isArray(entry.questIds) ? entry.questIds : [];

if (npcIds.length > 0) {
  relatedNPCs = await db.select().from(NPC).where(inArray(NPC.id, npcIds));
}
if (locationIds.length > 0) {
  relatedLocations = await db.select().from(Location).where(inArray(Location.id, locationIds));
}
if (characterIds.length > 0) {
  relatedCharacters = await db.select().from(Character).where(inArray(Character.id, characterIds));
}
if (questIds.length > 0) {
  relatedQuests = await db.select().from(Quest).where(inArray(Quest.id, questIds));
}

// Render markdown content
const renderedContent = renderMarkdown(entry.content);

// Session gallery media
const galleryUrls: string[] = Array.isArray(entry.galleryUrls) ? entry.galleryUrls : [];
---

<Layout title={entry.title}>
  <SceneBackdrop imageUrl={entry.coverImageUrl} />
  <div class="max-w-4xl mx-auto">
    <!-- Header with Back Button -->
    <div class="flex items-center justify-between mb-6">
      <a href="/diary" class="t-back-link">
        <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        All sessions
      </a>
      {isLoggedIn && (
        <div class="flex gap-2">
          <button 
            id="editEntry"
            data-id={entry.id}
            class="t-icon-btn"
            title="Edit entry"
            aria-label="Edit entry"
          >
            <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
          </button>
          <button 
            id="deleteEntry"
            data-id={entry.id}
            class="t-icon-btn t-icon-btn-danger"
            title="Delete entry"
            aria-label="Delete entry"
          >
            <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </button>
        </div>
      )}
    </div>

    <!-- Entry Header -->
    <article class="t-panel mb-6 overflow-hidden">
      <!-- Cover Video or Image (integrated into panel) -->
      {entry.coverVideoUrl ? (
        <div style="border-bottom:1px solid var(--border-gold);">
          <video
            autoplay
            muted
            playsinline
            loop
            preload="auto"
            disablePictureInPicture
            class="w-full aspect-video object-cover block"
            aria-label={`Cover video for ${entry.title}`}
          >
            <source src={entry.coverVideoUrl} type={getVideoMimeType(entry.coverVideoUrl)} />
            Your browser does not support the video tag.
          </video>
        </div>
      ) : entry.coverImageUrl && (
        <div style="border-bottom:1px solid var(--border-gold);">
          <img
            src={entry.coverImageUrl}
            alt={entry.title}
            class="w-full aspect-video object-cover block"
          />
        </div>
      )}
      <div class="p-6 sm:p-8">
      <h1 class="mb-4" style="font-size:2.25rem;">{entry.title}</h1>
      
      <div class="flex gap-4 text-sm t-faint mb-6">
        <span class="flex items-center gap-1">
          Session {entry.session}
        </span>
      </div>

      <!-- Tags -->
      {Array.isArray(entry.tags) && entry.tags.length > 0 && (
        <div class="flex gap-2 flex-wrap mb-6">
          {entry.tags.map((tag: string) => (
            <span class="t-badge t-badge-gold">
              #{tag}
            </span>
          ))}
        </div>
      )}

      {entry.summary && (
        <div data-summary-section class="mb-6 t-inset p-4">
          <div class="flex items-start justify-between gap-4 mb-3">
            <h3 class="t-muted text-sm font-semibold flex items-center gap-2">
              <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Summary
            </h3>
            {canManageSummary && (
              <button
                id="deleteSummaryBtn"
                class="t-icon-btn t-icon-btn-danger"
                title="Delete summary"
              >
                <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            )}
          </div>
          <div id="summaryContent" class="t-body-text text-sm">
            <p>{entry.summary}</p>
          </div>
        </div>
      )}

      <!-- Content -->
      <div class="t-prose mb-6">
        <div
          class="t-prose text-lg leading-relaxed"
          set:html={renderedContent}
        />
      </div>

      <!-- Session Gallery -->
      {galleryUrls.length > 0 && (
        <div class="mb-6">
          <h2 class="t-section-h text-xl mb-4 flex items-center gap-2">
            <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Session Impressions
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
            {galleryUrls.map((url) => {
              const video = isVideoUrl(url);
              return (
                <button
                  type="button"
                  class="gallery-thumb relative block w-full overflow-hidden rounded-xs focus:outline-hidden"
                  style="border:1px solid var(--border-gold);"
                  data-gallery-src={url}
                  data-gallery-type={video ? 'video' : 'image'}
                  aria-label="Open media"
                >
                  {video ? (
                    <>
                      <video
                        src={url}
                        muted
                        playsinline
                        preload="metadata"
                        class="w-full aspect-video object-cover block pointer-events-none"
                      ></video>
                      <span class="absolute inset-0 flex items-center justify-center bg-black/30 pointer-events-none">
                        <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M8 5v14l11-7z" />
                        </svg>
                      </span>
                    </>
                  ) : (
                    <img
                      src={url}
                      alt="Session impression"
                      loading="lazy"
                      class="w-full aspect-video object-cover block pointer-events-none"
                    />
                  )}
                </button>
              );
            })}
          </div>
        </div>
      )}

      <!-- Session Navigation -->
      <div class="flex items-center justify-center gap-3 pt-6" style="border-top:1px solid var(--border);">
        {previousEntry ? (
          <a 
            href={`/diary/${previousEntry.id}`}
            class="t-btn-secondary flex-1 flex items-center justify-center gap-2 text-sm"
            title={`Session ${previousEntry.session}: ${previousEntry.title}`}
          >
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span>Session {previousEntry.session}</span>
          </a>
        ) : (
          <div class="t-btn-secondary flex-1 flex items-center justify-center gap-2 text-sm cursor-not-allowed opacity-40" style="pointer-events:none;">
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span>Previous</span>
          </div>
        )}
        
        {nextEntry ? (
          <a 
            href={`/diary/${nextEntry.id}`}
            class="t-btn-secondary flex-1 flex items-center justify-center gap-2 text-sm"
            title={`Session ${nextEntry.session}: ${nextEntry.title}`}
          >
            <span>Session {nextEntry.session}</span>
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ) : (
          <div class="t-btn-secondary flex-1 flex items-center justify-center gap-2 text-sm cursor-not-allowed opacity-40" style="pointer-events:none;">
            <span>Next</span>
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        )}
      </div>
      </div>
    </article>

    <!-- Player Notes Section (only visible when logged in) -->
    {isLoggedIn && (
      <div id="playerNotesSection" class="t-panel p-6 sm:p-8 mb-6">
        <h2 class="t-section-h text-xl mb-4 flex items-center gap-2">
          <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          My Notes
        </h2>
        <p class="t-muted text-sm mb-4">
          Private notes only you can see
        </p>
        
        <!-- Note Display/Edit Area -->
        <div id="noteDisplay" class="hidden">
          <div 
            id="noteContent"
            class="t-inset p-4 mb-4 t-body-text text-sm"
          ></div>
          <div class="flex gap-2">
            <button 
              id="editNoteBtn"
              class="t-icon-btn"
              title="Edit note"
              aria-label="Edit note"
            >
              <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
            </button>
            <button 
              id="deleteNoteBtn"
              class="t-icon-btn t-icon-btn-danger"
              title="Delete note"
              aria-label="Delete note"
            >
              <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Note Editor -->
        <div id="noteEditor">
          <textarea 
            id="noteTextarea"
            class="t-input w-full min-h-[200px] p-4 resize-y"
            placeholder="Add your private notes here... (Markdown supported)"
          ></textarea>
          <div class="flex gap-2 mt-4">
            <button 
              id="saveNoteBtn"
              class="t-link font-medium"
            >
              Save Note
            </button>
            <button 
              id="cancelNoteBtn"
              class="hidden t-muted font-medium"
            >
              Cancel
            </button>
          </div>
        </div>
      </div>
    )}

    <!-- Related Entities -->
    {(relatedNPCs.length > 0 || relatedLocations.length > 0 || relatedCharacters.length > 0 || relatedQuests.length > 0) && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {/* NPCs */}
        {relatedNPCs.length > 0 && (
          <div class="t-panel p-6">
            <h3 class="t-section-h text-lg mb-4 flex items-center gap-2">
              <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              NPCs Met
            </h3>
            <div class="space-y-3">
              {relatedNPCs.map(npc => (
                <a href={`/npcs/${npc.id}`} class="t-row p-3 flex items-center gap-3">
                  {npc.avatarUrl ? (
                    <img src={npc.avatarUrl} alt={npc.name} class="w-10 h-10 rounded-full object-cover shrink-0" style="border:2px solid var(--border-gold);" />
                  ) : (
                    <div class="w-10 h-10 rounded-full flex items-center justify-center text-lg font-bold shrink-0" style="background:var(--bg-raised);border:2px solid var(--border-gold);color:var(--gold);font-family:'Cormorant Garamond',serif;">{npc.name.charAt(0)}</div>
                  )}
                  <div class="flex-1 min-w-0">
                    <div class="t-link font-medium truncate">{npc.name}</div>
                    <p class="t-faint text-xs truncate">{npc.race} - {npc.relationship}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        {/* Locations */}
        {relatedLocations.length > 0 && (
          <div class="t-panel p-6">
            <h3 class="t-section-h text-lg mb-4 flex items-center gap-2">
              <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              Locations Visited
            </h3>
            <div class="space-y-3">
              {relatedLocations.map(location => (
                <a href={`/locations/${location.id}`} class="t-row p-3 flex items-center gap-3">
                  {location.imageUrl ? (
                    <img src={location.imageUrl} alt={location.name} class="w-10 h-10 rounded-sm object-cover shrink-0" style="border:2px solid var(--border-gold);" />
                  ) : (
                    <div class="w-10 h-10 rounded-sm flex items-center justify-center text-lg font-bold shrink-0" style="background:var(--bg-raised);border:2px solid var(--border-gold);">📍</div>
                  )}
                  <div class="flex-1 min-w-0">
                    <div class="t-link font-medium truncate">{location.name}</div>
                    <p class="t-faint text-xs capitalize truncate">{location.type}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        {/* Characters */}
        {relatedCharacters.length > 0 && (
          <div class="t-panel p-6">
            <h3 class="t-section-h text-lg mb-4 flex items-center gap-2">
              <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              Party Members
            </h3>
            <div class="space-y-3">
              {relatedCharacters.map(character => (
                <a href={`/characters/${character.id}`} class="t-row p-3 flex items-center gap-3">
                  {character.avatarUrl ? (
                    <img src={character.avatarUrl} alt={character.name} class="w-10 h-10 rounded-full object-cover shrink-0" style="border:2px solid var(--border-gold);" />
                  ) : (
                    <div class="w-10 h-10 rounded-full flex items-center justify-center text-lg font-bold shrink-0" style="background:var(--bg-raised);border:2px solid var(--border-gold);color:var(--gold);font-family:'Cormorant Garamond',serif;">{character.name.charAt(0)}</div>
                  )}
                  <div class="flex-1 min-w-0">
                    <div class="t-link font-medium truncate">{character.name}</div>
                    <p class="t-faint text-xs truncate">Level {character.level} {character.race} {character.class}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        {/* Quests */}
        {relatedQuests.length > 0 && (
          <div class="t-panel p-6">
            <h3 class="t-section-h text-lg mb-4 flex items-center gap-2">
              <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
              Related Quests
            </h3>
            <ul class="space-y-2">
              {relatedQuests.map(quest => (
                <li class="pl-3" style="border-left:2px solid var(--border-gold);">
                  <a href="/quests" class="t-link font-medium">
                    {quest.title}
                  </a>
                  <p class="t-faint text-xs capitalize">{quest.status} - {quest.priority} priority</p>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </div>

  <!-- Gallery Lightbox -->
  <div id="galleryLightbox" class="hidden fixed inset-0 bg-black/80 backdrop-blur-xs flex items-center justify-center z-50 p-4">
    <button
      id="galleryLightboxClose"
      type="button"
      class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center rounded-xs bg-black/60 text-white text-2xl leading-none hover:bg-red-600 z-10"
      title="Close (Esc)"
      aria-label="Close"
    >×</button>
    <button
      id="galleryLightboxPrev"
      type="button"
      class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center rounded-xs bg-black/60 text-white hover:bg-black/80 z-10"
      title="Previous (←)"
      aria-label="Previous"
    >
      <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button
      id="galleryLightboxNext"
      type="button"
      class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center rounded-xs bg-black/60 text-white hover:bg-black/80 z-10"
      title="Next (→)"
      aria-label="Next"
    >
      <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>
    <div id="galleryLightboxContent" class="max-w-5xl max-h-[90vh] w-full flex items-center justify-center"></div>
    <div id="galleryLightboxCounter" class="absolute bottom-4 left-1/2 -translate-x-1/2 px-3 py-1 rounded-xs bg-black/60 text-white text-sm pointer-events-none"></div>
  </div>
</Layout>

<style is:global>
  .diary-text p + p {
    margin-top: 2rem;
  }
  
  /* Audio element styling */
  audio {
    background-color: transparent;
    color: black;
  }
  
  :root.dark audio {
    filter: invert(1);
  }
</style>

<script>
  function initializeDetailPage() {
    const deleteBtn = document.getElementById('deleteEntry');
    const editBtn = document.getElementById('editEntry');
    const deleteSummaryBtn = document.getElementById('deleteSummaryBtn');
    const summaryContent = document.getElementById('summaryContent');
    
    // Helper function to get entry ID from URL
    function getEntryIdFromUrl() {
      const pathParts = window.location.pathname.split('/');
      return pathParts[pathParts.length - 1];
    }

    // Helper function to show error alert
    function showError(message) {
      alert(message);
    }
    
    // Handle edit button click
    editBtn?.addEventListener('click', () => {
      const id = editBtn.getAttribute('data-id');
      if (id) {
        window.location.href = `/diary?edit=${id}`;
      }
    });
    
    deleteBtn?.addEventListener('click', async () => {
    const id = deleteBtn.getAttribute('data-id');
    if (!id) return;
    
    if (confirm('Are you sure you want to delete this entry?')) {
      try {
        const response = await fetch(`/api/diary/${id}`, {
          method: 'DELETE',
        });
        
        if (response.ok) {
          window.location.href = '/diary';
        } else {
          const error = await response.json().catch(() => ({ error: 'Unknown error' }));
          showError(`Failed to delete entry: ${error.error || response.statusText}`);
        }
      } catch (error) {
        console.error('Delete error:', error);
        showError('An error occurred while deleting the entry. Please check your connection and try again.');
      }
    }
  });

  // Handle delete summary button click
  deleteSummaryBtn?.addEventListener('click', async () => {
    const entryId = getEntryIdFromUrl();


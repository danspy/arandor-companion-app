  import { initializeVideoAutoplay } from '../../utils/video';
  
  // Ensure videos play after View Transitions navigation
  document.addEventListener('astro:page-load', initializeVideoAutoplay);
</script>

<script>
  function initializePodcast() {
    const playPauseBtn = document.getElementById('playPauseBtn');
    const playIcon = document.getElementById('playIcon');
    const pauseIcon = document.getElementById('pauseIcon');
    const stopBtn = document.getElementById('stopBtn');
    const statusDiv = document.getElementById('podcastStatus');
    const statusText = document.getElementById('podcastStatusText');

    if (!playPauseBtn || !playIcon || !pauseIcon || !stopBtn || !statusDiv || !statusText) {
      return;
    }

    // Helper function to prepare podcast text
    function preparePodcastText(title: string, content: string): string {
      // Remove markdown formatting
      let text = content
        .replace(/#{1,6}\s+/g, '')
        .replace(/\*\*([^*]+)\*\*/g, '$1')
        .replace(/\*([^*]+)\*/g, '$1')
        .replace(/__([^_]+)__/g, '$1')
        .replace(/_([^_]+)_/g, '$1')
        .replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1')
        .replace(/`([^`]+)`/g, '$1')
        .replace(/---+/g, '')
        .replace(/>\s+/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      // Add pauses between paragraphs
      const paragraphs = text.split(/\n\n+/).filter(p => p.trim());
      const narration = paragraphs.join('... ');
      
      return narration;
    }

    // Get the best German voice
    // Note: This function is duplicated from src/utils/podcast.ts because
    // client-side Astro script tags cannot import from TypeScript utility files
    function getBestGermanVoice(): SpeechSynthesisVoice | undefined {
      const voices = window.speechSynthesis.getVoices();
      
      // Filter for German voices (de-DE, de-AT, de-CH)
      const germanVoices = voices.filter(voice => 
        voice.lang.startsWith('de-') || voice.lang === 'de'
      );
      
      if (germanVoices.length === 0) {
        return undefined;
      }
      
      // Prioritize Google voices (typically higher quality)
      const googleVoice = germanVoices.find(voice => 
        voice.name.toLowerCase().includes('google')
      );
      if (googleVoice) {
        return googleVoice;
      }
      
      // Then Microsoft voices
      const microsoftVoice = germanVoices.find(voice => 
        voice.name.toLowerCase().includes('microsoft')
      );
      if (microsoftVoice) {
        return microsoftVoice;
      }
      
      // Otherwise, prefer voices that are not marked as 'local' (usually better quality)
      const nonLocalVoice = germanVoices.find(voice => 
        !voice.localService
      );
      if (nonLocalVoice) {
        return nonLocalVoice;
      }
      
      // Fall back to first available German voice
      return germanVoices[0];
    }

    // Get diary entry content from the page
    const titleElement = document.querySelector('h1');
    const contentElement = document.querySelector('.diary-text');
    
    if (!titleElement || !contentElement) {
      console.error('Could not find diary entry content');
      return;
    }

    const title = titleElement.textContent || '';
    const content = contentElement.textContent || '';
    const podcastText = preparePodcastText(title, content);

    let isPaused = false;
    let germanVoice: SpeechSynthesisVoice | undefined;

    // Initialize voices
    function initializeVoice() {
      germanVoice = getBestGermanVoice();
      if (germanVoice) {
        console.log('Using German voice:', germanVoice.name, '(' + germanVoice.lang + ')');
      } else {
        console.warn('No German voice found. Using default voice.');
      }
    }

    if ('speechSynthesis' in window) {
      initializeVoice();
      // Voices may load asynchronously
      if (window.speechSynthesis.onvoiceschanged !== undefined) {
        window.speechSynthesis.onvoiceschanged = initializeVoice;
      }
    }

    let isPlaying = false;

    // Play/Pause button handler
    playPauseBtn.addEventListener('click', () => {
      if (isPlaying) {
        if (isPaused) {
          // Resume from pause
          window.speechSynthesis.resume();
          isPaused = false;
          playIcon.classList.add('hidden');
          pauseIcon.classList.remove('hidden');
          statusText.textContent = 'Wiedergabe...';
        } else {
          // Pause
          window.speechSynthesis.pause();
          isPaused = true;
          playIcon.classList.remove('hidden');
          pauseIcon.classList.add('hidden');
          statusText.textContent = 'Pausiert';
        }
      } else {
        // Start playback
        try {
          window.speechSynthesis.cancel();
          
          // Re-initialize voice in case it wasn't loaded before
          if (!germanVoice) {
            germanVoice = getBestGermanVoice();
          }
          
          const utterance = new SpeechSynthesisUtterance(podcastText);
          utterance.rate = 0.9;
          utterance.pitch = 1.0;
          utterance.volume = 1.0;
          
          if (germanVoice) {
            utterance.voice = germanVoice;
          }

          utterance.onend = () => {
            isPlaying = false;
            isPaused = false;
            playIcon.classList.remove('hidden');
            pauseIcon.classList.add('hidden');
            stopBtn.classList.add('hidden');
            statusDiv.classList.add('hidden');
            playPauseBtn.title = 'Play';
          };

          window.speechSynthesis.speak(utterance);
          isPlaying = true;
          isPaused = false;
          playIcon.classList.add('hidden');
          pauseIcon.classList.remove('hidden');
          stopBtn.classList.remove('hidden');
          stopBtn.style.display = 'flex';
          statusDiv.classList.remove('hidden');
          statusText.textContent = 'Wiedergabe...';
          playPauseBtn.title = 'Pause';
        } catch (error) {
          console.error('Podcast playback error:', error);
          statusText.textContent = 'Fehler: ' + (error instanceof Error ? error.message : 'Unbekannter Fehler');
          statusDiv.classList.remove('hidden');
        }
      }
    });

    // Stop button handler
    stopBtn.addEventListener('click', () => {
      window.speechSynthesis.cancel();
      isPlaying = false;
      isPaused = false;
      playIcon.classList.remove('hidden');
      pauseIcon.classList.add('hidden');
      stopBtn.classList.add('hidden');
      statusDiv.classList.add('hidden');
      playPauseBtn.title = 'Play';
    });

    // Check if speech synthesis is supported
    if (!('speechSynthesis' in window)) {
      playPauseBtn.disabled = true;
      playPauseBtn.classList.add('opacity-50', 'cursor-not-allowed');
      statusText.textContent = 'Text-zu-Sprache wird in diesem Browser nicht unterstützt';
      statusDiv.classList.remove('hidden');
    }
  }

  // Initialize on page load
  document.addEventListener('astro:page-load', initializePodcast);
</script>

<script>
  // Import marked for markdown rendering
  import { marked } from 'marked';

  // Configure marked for safe rendering
  marked.setOptions({
    breaks: true,
    gfm: true,
  });

  function initializePlayerNotes() {
    // Get entry ID from the page URL
    const pathParts = window.location.pathname.split('/');
    const entryId = pathParts[pathParts.length - 1];
    const noteDisplay = document.getElementById('noteDisplay');
    const noteEditor = document.getElementById('noteEditor');
    const noteContent = document.getElementById('noteContent');
    const noteTextarea = document.getElementById('noteTextarea');
    const saveNoteBtn = document.getElementById('saveNoteBtn');
    const cancelNoteBtn = document.getElementById('cancelNoteBtn');
    const editNoteBtn = document.getElementById('editNoteBtn');
    const deleteNoteBtn = document.getElementById('deleteNoteBtn');

    if (!noteDisplay || !noteEditor || !noteContent || !noteTextarea) {
      return; // Not logged in, elements don't exist
    }

    let currentNote = null;
    let isEditing = false;

    // Fetch existing note
    async function fetchNote() {
      try {
        const response = await fetch(`/api/diary-notes/${entryId}`);
        if (!response.ok) {
          if (response.status === 401) {
            // Not authenticated, hide notes section
            const section = document.getElementById('playerNotesSection');
            if (section) section.style.display = 'none';
            return;
          }
          throw new Error('Failed to fetch note');
        }

        const data = await response.json();
        currentNote = data.note;

        if (currentNote && currentNote.content) {
          // Show existing note with markdown rendering
          noteContent.innerHTML = marked.parse(currentNote.content);
          noteDisplay.classList.remove('hidden');
          noteEditor.classList.add('hidden');
        } else {
          // No note yet, show editor
          noteDisplay.classList.add('hidden');
          noteEditor.classList.remove('hidden');
          cancelNoteBtn.classList.add('hidden');
        }
      } catch (error) {
        console.error('Error fetching note:', error);
      }
    }

    // Save or update note
    async function saveNote() {
      const content = noteTextarea.value.trim();
      
      if (!content) {
        alert('Please enter some content for your note.');
        return;
      }

      try {
        const method = currentNote ? 'PUT' : 'POST';
        const response = await fetch(`/api/diary-notes/${entryId}`, {
          method: method,
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ content }),
        });

        if (!response.ok) {
          const error = await response.json().catch(() => ({ error: 'Unknown error' }));
          throw new Error(error.error || 'Failed to save note');
        }

        const data = await response.json();
        currentNote = data.note;

        // Update display with markdown rendering
        noteContent.innerHTML = marked.parse(currentNote.content);
        noteDisplay.classList.remove('hidden');
        noteEditor.classList.add('hidden');
        isEditing = false;
      } catch (error) {
        console.error('Error saving note:', error);
        alert(`Failed to save note: ${error.message}`);
      }
    }

    // Edit note
    function editNote() {
      if (currentNote) {
        noteTextarea.value = currentNote.content;
      }
      noteDisplay.classList.add('hidden');
      noteEditor.classList.remove('hidden');
      cancelNoteBtn.classList.remove('hidden');
      isEditing = true;
    }

    // Cancel editing
    function cancelEdit() {
      if (currentNote) {
        noteDisplay.classList.remove('hidden');
        noteEditor.classList.add('hidden');
      } else {
        noteTextarea.value = '';
      }
      cancelNoteBtn.classList.add('hidden');
      isEditing = false;
    }

    // Delete note
    async function deleteNote() {
      if (!confirm('Are you sure you want to delete this note?')) {
        return;
      }

      try {
        const response = await fetch(`/api/diary-notes/${entryId}`, {
          method: 'DELETE',
        });

        if (!response.ok) {
          throw new Error('Failed to delete note');
        }

        currentNote = null;
        noteTextarea.value = '';
        noteDisplay.classList.add('hidden');
        noteEditor.classList.remove('hidden');
        cancelNoteBtn.classList.add('hidden');
      } catch (error) {
        console.error('Error deleting note:', error);
        alert('Failed to delete note. Please try again.');
      }
    }

    // Event listeners
    saveNoteBtn?.addEventListener('click', saveNote);
    cancelNoteBtn?.addEventListener('click', cancelEdit);
    editNoteBtn?.addEventListener('click', editNote);
    deleteNoteBtn?.addEventListener('click', deleteNote);

    // Load note on page load
    fetchNote();
  }

  // Initialize on page load
  document.addEventListener('astro:page-load', initializePlayerNotes);
</script>

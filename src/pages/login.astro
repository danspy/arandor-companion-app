---
import Layout from '../layouts/Layout.astro';
import SceneBackdrop from '../components/SceneBackdrop.astro';
import { isAuthenticated } from '../lib/auth';
import { db, CampaignProgress } from '@/db';

// If already logged in, redirect to dashboard
if (isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/');
}
const campaignImage = (await db.select({ url: CampaignProgress.heroImageUrl }).from(CampaignProgress).limit(1))[0]?.url ?? null;
---

<Layout title="Login">
  <SceneBackdrop imageUrl={campaignImage} />
  <div class="login-stage">
    <!-- Rune circle backdrop -->
    <div class="rune-ring" aria-hidden="true">
      <svg viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Outer ring -->
        <circle cx="200" cy="200" r="190" stroke="rgba(201,144,50,0.18)" stroke-width="1" stroke-dasharray="8 6"/>
        <!-- Inner ring -->
        <circle cx="200" cy="200" r="148" stroke="rgba(201,144,50,0.12)" stroke-width="1"/>
        <!-- Tick marks -->
        {Array.from({ length: 24 }).map((_, i) => {
          const angle = (i * 15 * Math.PI) / 180;
          const x1 = 200 + 185 * Math.cos(angle);
          const y1 = 200 + 185 * Math.sin(angle);
          const x2 = 200 + 193 * Math.cos(angle);
          const y2 = 200 + 193 * Math.sin(angle);
          return <line x1={x1.toFixed(1)} y1={y1.toFixed(1)} x2={x2.toFixed(1)} y2={y2.toFixed(1)} stroke="rgba(201,144,50,0.3)" stroke-width={i % 6 === 0 ? 2 : 1} />;
        })}
        <!-- Cross lines -->
        <line x1="10" y1="200" x2="390" y2="200" stroke="rgba(201,144,50,0.06)" stroke-width="1"/>
        <line x1="200" y1="10" x2="200" y2="390" stroke="rgba(201,144,50,0.06)" stroke-width="1"/>
      </svg>
    </div>

    <!-- Center card -->
    <div class="login-card">
      <!-- Glyphs / decorative corners -->
      <div class="card-corner card-corner--tl" aria-hidden="true"></div>
      <div class="card-corner card-corner--tr" aria-hidden="true"></div>
      <div class="card-corner card-corner--bl" aria-hidden="true"></div>
      <div class="card-corner card-corner--br" aria-hidden="true"></div>

      <div class="login-inner">
        <!-- Brand / sigil -->
        <div class="login-brand">
          <div class="login-sigil" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none">
              <!-- Diamond / D20 evocation -->
              <polygon points="24,4 44,18 44,30 24,44 4,30 4,18" stroke="rgba(201,144,50,0.9)" stroke-width="1.5" fill="rgba(201,144,50,0.06)"/>
              <polygon points="24,10 38,20 38,28 24,38 10,28 10,20" stroke="rgba(201,144,50,0.5)" stroke-width="1" fill="none"/>
              <circle cx="24" cy="24" r="4" fill="rgba(201,144,50,0.8)"/>
            </svg>
          </div>
          <h1 class="login-title">Arandor</h1>
          <p class="login-subtitle">Campaign Companion</p>
        </div>

        <!-- Divider -->
        <div class="login-divider" aria-hidden="true">
          <span class="login-divider__line"></span>
          <span class="login-divider__dot"></span>
          <span class="login-divider__line"></span>
        </div>

        <!-- Form -->
        <form id="loginForm" class="login-form">
          <div class="login-field">
            <label for="username" class="login-label">Username</label>
            <input
              type="text"
              id="username"
              name="username"
              required
              autocomplete="username"
              class="login-input"
              placeholder="Enter your name…"
            />
          </div>

          <div class="login-field">
            <label for="password" class="login-label">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              class="login-input"
              placeholder="••••••••"
            />
          </div>

          <div id="errorMessage" class="login-error hidden"></div>

          <button type="submit" class="login-btn">
            <span class="login-btn__text">Enter the realm</span>
            <span class="login-btn__arrow" aria-hidden="true">→</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ── Layout ────────────────────────────────────────────────────── */
  .login-stage {
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 2rem 1rem;
  }

  /* ── Rune ring backdrop ────────────────────────────────────────── */
  .rune-ring {
    position: absolute;
    width: min(520px, 90vw);
    height: min(520px, 90vw);
    pointer-events: none;
    opacity: 0.7;
    animation: runeRotate 120s linear infinite;
  }
  .rune-ring svg { width: 100%; height: 100%; }

  @keyframes runeRotate {
    to { transform: rotate(360deg); }
  }

  /* ── Card ──────────────────────────────────────────────────────── */
  .login-card {
    position: relative;
    width: 100%;
    max-width: 400px;
    background: var(--bg-surface);
    border: 1px solid var(--border-gold);
    border-radius: 2px;
    box-shadow:
      0 0 0 1px rgba(201,144,50,0.08),
      0 20px 60px rgba(0,0,0,0.4),
      0 0 60px rgba(201,144,50,0.04);
    z-index: 1;
  }

  /* Decorative corner flourishes */
  .card-corner {
    position: absolute;
    width: 16px;
    height: 16px;
    pointer-events: none;
  }
  .card-corner::before,
  .card-corner::after {
    content: '';
    position: absolute;
    background: var(--gold);
    border-radius: 1px;
    opacity: 0.6;
  }
  .card-corner--tl { top: -1px; left: -1px; }
  .card-corner--tr { top: -1px; right: -1px; }
  .card-corner--bl { bottom: -1px; left: -1px; }
  .card-corner--br { bottom: -1px; right: -1px; }

  .card-corner--tl::before { width: 12px; height: 2px; top: 0; left: 0; }
  .card-corner--tl::after  { width: 2px; height: 12px; top: 0; left: 0; }
  .card-corner--tr::before { width: 12px; height: 2px; top: 0; right: 0; }
  .card-corner--tr::after  { width: 2px; height: 12px; top: 0; right: 0; }
  .card-corner--bl::before { width: 12px; height: 2px; bottom: 0; left: 0; }
  .card-corner--bl::after  { width: 2px; height: 12px; bottom: 0; left: 0; }
  .card-corner--br::before { width: 12px; height: 2px; bottom: 0; right: 0; }
  .card-corner--br::after  { width: 2px; height: 12px; bottom: 0; right: 0; }

  /* ── Inner content ─────────────────────────────────────────────── */
  .login-inner {
    padding: 2.5rem 2rem 2.25rem;
  }

  /* ── Brand ─────────────────────────────────────────────────────── */
  .login-brand {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .login-sigil {
    width: 52px;
    height: 52px;
    margin: 0 auto 0.75rem;
    filter: drop-shadow(0 0 10px rgba(201,144,50,0.35));
  }
  .login-sigil svg { width: 100%; height: 100%; }

  .login-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 700;
    font-size: 2.25rem;
    line-height: 1;
    color: var(--text-strong);
    letter-spacing: 0.03em;
    margin: 0 0 0.25rem;
  }

  .login-subtitle {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 0;
  }

  /* ── Divider ───────────────────────────────────────────────────── */
  .login-divider {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }
  .login-divider__line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--border-gold));
  }
  .login-divider__line:last-child {
    background: linear-gradient(to left, transparent, var(--border-gold));
  }
  .login-divider__dot {
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background: var(--accent);
    box-shadow: 0 0 6px rgba(201,144,50,0.6);
    flex-shrink: 0;
  }

  /* ── Form ──────────────────────────────────────────────────────── */
  .login-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .login-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .login-label {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .login-input {
    width: 100%;
    padding: 0.625rem 0.875rem;
    background: var(--bg-page);
    border: 1px solid var(--border);
    border-radius: 2px;
    color: var(--text-body);
    font-family: 'Outfit', sans-serif;
    font-size: 0.9rem;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
    outline: none;
  }
  .login-input::placeholder { color: var(--text-faint); }
  .login-input:focus {
    border-color: rgba(201,144,50,0.5);
    box-shadow: 0 0 0 3px rgba(201,144,50,0.10);
  }

  /* ── Error ─────────────────────────────────────────────────────── */
  .login-error {
    font-size: 0.8rem;
    color: #f87171;
    background: rgba(248,113,113,0.08);
    border: 1px solid rgba(248,113,113,0.2);
    border-radius: 2px;
    padding: 0.5rem 0.75rem;
  }
  .login-error.hidden { display: none; }

  /* ── Submit button ─────────────────────────────────────────────── */
  .login-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--accent);
    color: #fff;
    font-family: 'Outfit', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: none;
    border-radius: 2px;
    cursor: pointer;
    transition: background 0.18s ease, box-shadow 0.18s ease, transform 0.12s ease;
    box-shadow: 0 0 20px rgba(201,144,50,0.25);
  }
  .login-btn:hover {
    background: #b5822d;
    box-shadow: 0 0 30px rgba(201,144,50,0.4);
    transform: translateY(-1px);
  }
  .login-btn:active { transform: translateY(0); }
  .login-btn__arrow {
    transition: transform 0.18s ease;
  }
  .login-btn:hover .login-btn__arrow {
    transform: translateX(3px);
  }
</style>

<script>
  const form = document.getElementById('loginForm') as HTMLFormElement;
  const errorMessage = document.getElementById('errorMessage');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = {
      username: formData.get('username'),
      password: formData.get('password'),
    };

    try {
      const response = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        window.location.href = '/';
      } else {
        const result = await response.json();
        if (errorMessage) {
          errorMessage.textContent = result.error || 'Login failed. Please try again.';
          errorMessage.classList.remove('hidden');
        }
      }
    } catch (error) {
      if (errorMessage) {
        errorMessage.textContent = 'An error occurred. Please try again.';
        errorMessage.classList.remove('hidden');
      }
    }
  });
</script>

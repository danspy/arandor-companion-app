---
import Layout from '../../layouts/Layout.astro';
import { db, Character, DiaryEntry, eq } from 'astro:db';
import { isAuthenticated } from '../../lib/auth';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/characters');
}

const characters = await db.select().from(Character).where(eq(Character.id, id));
const character = characters[0];

if (!character) {
  return Astro.redirect('/characters');
}

// Count sessions where this character appears
const allDiaryEntries = await db.select().from(DiaryEntry);
const sessionCount = allDiaryEntries.filter(entry => {
  const characterIds = Array.isArray(entry.characterIds) ? entry.characterIds : [];
  return characterIds.includes(id);
}).length;

const isLoggedIn = isAuthenticated(Astro.cookies);
---

<Layout title={character.name}>
  <div class="max-w-4xl mx-auto">
    <!-- Header with Back Button -->
    <div class="flex items-center justify-between mb-6">
      <a href="/characters" class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Characters
      </a>
      {isLoggedIn && (
        <div class="flex gap-2">
          <button 
            id="editCharacter"
            data-id={character.id}
            class="p-2 text-gray-500 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition"
            title="Edit character"
            aria-label="Edit character"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
          </button>
          <button 
            id="deleteCharacter"
            data-id={character.id}
            class="p-2 text-gray-500 hover:text-red-600 dark:text-gray-400 dark:hover:text-red-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition"
            title="Delete character"
            aria-label="Delete character"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </button>
        </div>
      )}
    </div>

    <!-- Character Header -->
    <article class="bg-white dark:bg-black rounded-lg shadow-md overflow-hidden mb-6 dark:border dark:border-gray-900">
      <!-- Character Hero Image -->
      <div class="relative overflow-hidden">
        <!-- Blurred background -->
        {character.avatarUrl ? (
          <>
            <img 
              src={character.avatarUrl} 
              alt={character.name}
              class="absolute inset-0 w-full h-full object-cover blur-lg scale-110"
            />
            <div class="absolute inset-0 bg-black/40"></div>
          </>
        ) : (
          <div class={`absolute inset-0 bg-gradient-to-br ${character.isActive ? 'from-primary-600 via-secondary-500 to-accent-600' : 'from-gray-600 via-gray-500 to-gray-600'}`}></div>
        )}
        
        <!-- Status badge -->
        {!character.isActive && (
          <div class="absolute top-4 right-4 bg-gray-800/90 text-white text-sm px-4 py-2 rounded-full shadow-lg z-10">
            Inactive
          </div>
        )}
        
        <!-- Content container -->
        <div class="relative h-full flex flex-col justify-between p-8">
          {/* Circular avatar centered */}
          <div class="flex-1 flex items-center justify-center">
            {character.avatarUrl ? (
              <img 
                src={character.avatarUrl} 
                alt={character.name}
                class="w-40 h-40 md:w-48 md:h-48 rounded-full object-cover border-4 border-white dark:border-gray-200 shadow-2xl"
              />
            ) : (
              <div class="w-40 h-40 md:w-48 md:h-48 bg-white dark:bg-gray-800 rounded-full flex items-center justify-center text-7xl md:text-8xl font-bold text-primary-700 dark:text-primary-400 shadow-2xl border-4 border-white dark:border-gray-700">
                {character.name.charAt(0)}
              </div>
            )}
          </div>
          
          {/* Character name and info at bottom */}
          <div class="text-center pt-4">
            <h1 class="text-4xl md:text-5xl font-bold text-white drop-shadow-lg mb-2">{character.name}</h1>
            <p class="text-xl md:text-2xl text-white/90 drop-shadow-md mb-1">{character.race} {character.class}</p>
            <p class="text-lg text-white/80 drop-shadow-md">Played by {character.player}</p>
          </div>
        </div>
      </div>

      <!-- Character Info -->
      <div class="px-8 py-8">
        <!-- Quick Stats -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="bg-primary-50 dark:bg-primary-900/20 dark:border dark:border-primary-800 p-4 rounded-lg">
            <div class="text-sm text-gray-600 dark:text-gray-400 mb-1">Level</div>
            <div class="text-3xl font-bold text-primary-700 dark:text-primary-400">{character.level}</div>
          </div>
          <div class="bg-secondary-50 dark:bg-secondary-900/20 dark:border dark:border-secondary-800 p-4 rounded-lg">
            <div class="text-sm text-gray-600 dark:text-gray-400 mb-1">Race</div>
            <div class="text-2xl font-semibold text-secondary-700 dark:text-secondary-400">{character.race}</div>
          </div>
          <div class="bg-accent-50 dark:bg-accent-900/20 dark:border dark:border-accent-800 p-4 rounded-lg">
            <div class="text-sm text-gray-600 dark:text-gray-400 mb-1">Class</div>
            <div class="text-2xl font-semibold text-accent-700 dark:text-accent-400">{character.class}</div>
          </div>
          <div class="bg-green-50 dark:bg-green-900/20 dark:border dark:border-green-800 p-4 rounded-lg">
            <div class="text-sm text-gray-600 dark:text-gray-400 mb-1">Sessions Played</div>
            <div class="text-3xl font-bold text-green-700 dark:text-green-400">{sessionCount}</div>
          </div>
        </div>
      </div>
    </article>

    <!-- Ability Scores -->
    {character.stats && (
      <div class="bg-white dark:bg-black rounded-lg shadow-md p-8 mb-6 dark:border dark:border-gray-900">
        <h2 class="text-2xl font-bold text-primary-700 dark:text-primary-400 mb-6">Ability Scores</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
          <div class="bg-gradient-to-br from-red-50 to-red-100 dark:from-red-950/20 dark:to-red-900/20 p-4 rounded-lg text-center dark:border dark:border-red-900/30">
            <div class="text-sm text-gray-600 dark:text-gray-400 mb-2 font-semibold">Strength</div>
            <div class="text-4xl font-bold text-red-700 dark:text-red-400">{character.stats.strength}</div>
            <div class="text-xs text-gray-500 dark:text-gray-500 mt-1">
              {Math.floor((character.stats.strength - 10) / 2) >= 0 ? '+' : ''}{Math.floor((character.stats.strength - 10) / 2)}
            </div>
          </div>
          <div class="bg-gradient-to-br from-green-50 to-green-100 dark:from-green-950/20 dark:to-green-900/20 p-4 rounded-lg text-center dark:border dark:border-green-900/30">
            <div class="text-sm text-gray-600 dark:text-gray-400 mb-2 font-semibold">Dexterity</div>
            <div class="text-4xl font-bold text-green-700 dark:text-green-400">{character.stats.dexterity}</div>
            <div class="text-xs text-gray-500 dark:text-gray-500 mt-1">
              {Math.floor((character.stats.dexterity - 10) / 2) >= 0 ? '+' : ''}{Math.floor((character.stats.dexterity - 10) / 2)}
            </div>
          </div>
          <div class="bg-gradient-to-br from-orange-50 to-orange-100 dark:from-orange-950/20 dark:to-orange-900/20 p-4 rounded-lg text-center dark:border dark:border-orange-900/30">
            <div class="text-sm text-gray-600 dark:text-gray-400 mb-2 font-semibold">Constitution</div>
            <div class="text-4xl font-bold text-orange-700 dark:text-orange-400">{character.stats.constitution}</div>
            <div class="text-xs text-gray-500 dark:text-gray-500 mt-1">
              {Math.floor((character.stats.constitution - 10) / 2) >= 0 ? '+' : ''}{Math.floor((character.stats.constitution - 10) / 2)}
            </div>
          </div>
          <div class="bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-950/20 dark:to-blue-900/20 p-4 rounded-lg text-center dark:border dark:border-blue-900/30">
            <div class="text-sm text-gray-600 dark:text-gray-400 mb-2 font-semibold">Intelligence</div>
            <div class="text-4xl font-bold text-blue-700 dark:text-blue-400">{character.stats.intelligence}</div>
            <div class="text-xs text-gray-500 dark:text-gray-500 mt-1">
              {Math.floor((character.stats.intelligence - 10) / 2) >= 0 ? '+' : ''}{Math.floor((character.stats.intelligence - 10) / 2)}
            </div>
          </div>
          <div class="bg-gradient-to-br from-purple-50 to-purple-100 dark:from-purple-950/20 dark:to-purple-900/20 p-4 rounded-lg text-center dark:border dark:border-purple-900/30">
            <div class="text-sm text-gray-600 dark:text-gray-400 mb-2 font-semibold">Wisdom</div>
            <div class="text-4xl font-bold text-purple-700 dark:text-purple-400">{character.stats.wisdom}</div>
            <div class="text-xs text-gray-500 dark:text-gray-500 mt-1">
              {Math.floor((character.stats.wisdom - 10) / 2) >= 0 ? '+' : ''}{Math.floor((character.stats.wisdom - 10) / 2)}
            </div>
          </div>
          <div class="bg-gradient-to-br from-pink-50 to-pink-100 dark:from-pink-950/20 dark:to-pink-900/20 p-4 rounded-lg text-center dark:border dark:border-pink-900/30">
            <div class="text-sm text-gray-600 dark:text-gray-400 mb-2 font-semibold">Charisma</div>
            <div class="text-4xl font-bold text-pink-700 dark:text-pink-400">{character.stats.charisma}</div>
            <div class="text-xs text-gray-500 dark:text-gray-500 mt-1">
              {Math.floor((character.stats.charisma - 10) / 2) >= 0 ? '+' : ''}{Math.floor((character.stats.charisma - 10) / 2)}
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Character Details Section -->
    {(character.background || character.alignment || character.gender || character.age || character.height || character.weight || character.eyes || character.skin || character.hair) && (
      <div class="bg-white dark:bg-black rounded-lg shadow-md p-8 mb-6 dark:border dark:border-gray-900">
        <h2 class="text-2xl font-bold text-primary-700 dark:text-primary-400 mb-6">Character Details</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {character.background && (
            <div>
              <div class="text-sm text-gray-600 dark:text-gray-400 mb-1 font-semibold">Background</div>
              <div class="text-lg text-gray-900 dark:text-gray-100">{character.background}</div>
            </div>
          )}
          {character.alignment && (
            <div>
              <div class="text-sm text-gray-600 dark:text-gray-400 mb-1 font-semibold">Alignment</div>
              <div class="text-lg text-gray-900 dark:text-gray-100">{character.alignment}</div>
            </div>
          )}
          {character.gender && (
            <div>
              <div class="text-sm text-gray-600 dark:text-gray-400 mb-1 font-semibold">Gender</div>
              <div class="text-lg text-gray-900 dark:text-gray-100">{character.gender}</div>
            </div>
          )}
          {character.age && (
            <div>
              <div class="text-sm text-gray-600 dark:text-gray-400 mb-1 font-semibold">Age</div>
              <div class="text-lg text-gray-900 dark:text-gray-100">{character.age} years</div>
            </div>
          )}
          {character.height && (
            <div>
              <div class="text-sm text-gray-600 dark:text-gray-400 mb-1 font-semibold">Height</div>
              <div class="text-lg text-gray-900 dark:text-gray-100">{character.height}</div>
            </div>
          )}
          {character.weight && (
            <div>
              <div class="text-sm text-gray-600 dark:text-gray-400 mb-1 font-semibold">Weight</div>
              <div class="text-lg text-gray-900 dark:text-gray-100">{character.weight} lbs</div>
            </div>
          )}
          {character.eyes && (
            <div>
              <div class="text-sm text-gray-600 dark:text-gray-400 mb-1 font-semibold">Eyes</div>
              <div class="text-lg text-gray-900 dark:text-gray-100">{character.eyes}</div>
            </div>
          )}
          {character.skin && (
            <div>
              <div class="text-sm text-gray-600 dark:text-gray-400 mb-1 font-semibold">Skin</div>
              <div class="text-lg text-gray-900 dark:text-gray-100">{character.skin}</div>
            </div>
          )}
          {character.hair && (
            <div>
              <div class="text-sm text-gray-600 dark:text-gray-400 mb-1 font-semibold">Hair</div>
              <div class="text-lg text-gray-900 dark:text-gray-100">{character.hair}</div>
            </div>
          )}
        </div>
      </div>
    )}

    {/* D&D Beyond Link */}
        {character.dndbeyondUrl && (
          <div class="mb-6">
            <a 
              href={character.dndbeyondUrl}
              target="_blank"
              class="inline-flex items-center gap-2 bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700 transition"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              View on D&D Beyond
            </a>
          </div>
        )}

    <!-- Info Box about D&D Beyond Integration -->
    {isLoggedIn && (
      <div class="bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-500 dark:border-blue-400 p-4 rounded dark:border dark:border-blue-800">
        <h3 class="font-semibold text-blue-900 dark:text-blue-300 mb-2">💡 D&D Beyond Integration</h3>
        <p class="text-sm text-blue-800 dark:text-blue-200 mb-2">
          You can automatically import character data from D&D Beyond. When editing this character, 
          add their D&D Beyond URL and the system can fetch their stats automatically.
        </p>
        <p class="text-xs text-blue-700 dark:text-blue-300">
          Note: Make sure the character sheet is set to public in D&D Beyond for the integration to work.
        </p>
      </div>
    )}
  </div>
</Layout>

<script>
  function initializeDetailPage() {
    const deleteBtn = document.getElementById('deleteCharacter');
    const editBtn = document.getElementById('editCharacter');
    
    // Handle edit button click
    if (editBtn) {
      editBtn.addEventListener('click', () => {
      const id = editBtn.getAttribute('data-id');
      if (id) {
        window.location.href = `/characters?edit=${id}`;
      }
    });
  }
  
  if (deleteBtn) {
    deleteBtn.addEventListener('click', async () => {
      const id = deleteBtn.getAttribute('data-id');
      if (!id) return;
      
      if (confirm('Are you sure you want to delete this character?')) {
        try {
          const response = await fetch(`/api/characters/${id}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.href = '/characters';
          } else {
            const error = await response.json().catch(() => ({ error: 'Unknown error' }));
            alert(`Failed to delete character: ${error.error || response.statusText}`);
          }
        } catch (error) {
          console.error('Delete error:', error);
          alert('An error occurred while deleting the character. Please check your connection and try again.');
        }
      }
    });
  }
  }

  // Run on initial page load and after View Transitions navigation
  document.addEventListener('astro:page-load', initializeDetailPage);
</script>

---
import Layout from '../../layouts/Layout.astro';
import SceneBackdrop from '../../components/SceneBackdrop.astro';
import { db, Character, DiaryEntry, User, eq } from '@/db';
import { isAuthenticated, getUserRole, getCurrentUser } from '../../lib/auth';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/characters');
}

const characters = await db.select().from(Character).where(eq(Character.id, id));
const character = characters[0];

if (!character) {
  return Astro.redirect('/characters');
}

const allDiaryEntries = await db.select().from(DiaryEntry);
const sessionCount = allDiaryEntries.filter(entry => {
  const characterIds = Array.isArray(entry.characterIds) ? entry.characterIds : [];
  return characterIds.includes(id);
}).length;

const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);
const currentUser = await getCurrentUser(Astro.cookies);
const allUsers = await db.select().from(User);

const findCharacterOwner = (character: typeof characters[0]) => {
  if (character.userId) return { userId: character.userId, isLegacy: false };
  for (const user of allUsers) {
    if (user.characterIds && Array.isArray(user.characterIds) && user.characterIds.includes(character.id)) {
      return { userId: user.id, isLegacy: true };
    }
  }
  return null;
};

const canEditCharacter = () => {
  if (!isLoggedIn) return false;
  if (userRole === 'admin') return true;
  const owner = findCharacterOwner(character);
  if (!owner) return true;
  if (currentUser && owner.userId === currentUser.id) return true;
  return false;
};

const canEdit = canEditCharacter();

const shouldAutoSync = character.dndbeyondUrl &&
  canEdit &&
  (!character.lastSyncedAt ||
   (new Date().getTime() - new Date(character.lastSyncedAt).getTime()) > 24 * 60 * 60 * 1000);

const statMod = (v: number) => {
  const m = Math.floor((v - 10) / 2);
  return (m >= 0 ? '+' : '') + m;
};
---

<Layout title={character.name}>
  <SceneBackdrop imageUrl={character.avatarUrl} />
  <div class="max-w-4xl mx-auto px-1 sm:px-0">

    <!-- Nav row -->
    <div class="flex items-center justify-between mb-6">
      <a href="/characters" class="t-back-link">
        <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/>
        </svg>
        All characters
      </a>
      {canEdit && (
        <div class="flex gap-2">
          <button id="editCharacter" data-id={character.id} class="t-icon-btn" title="Edit character" aria-label="Edit character">
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </button>
          <button id="deleteCharacter" data-id={character.id} class="t-icon-btn t-icon-btn-danger" title="Delete character" aria-label="Delete character">
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
          </button>
        </div>
      )}
    </div>

    <!-- ── Character Sheet Card ─────────────────────────────────── -->
    <div class="t-panel overflow-hidden mb-6">

      <!-- Hero banner -->
      <div class="t-hero-banner" style="min-height:280px;">
        {character.avatarUrl ? (
          <>
            <img src={character.avatarUrl} alt={character.name}
              class="absolute inset-0 w-full h-full object-cover" style="filter:blur(18px) brightness(0.55) saturate(0.7); transform:scale(1.08);"/>
            <div class="absolute inset-0" style="background:linear-gradient(to bottom,rgba(8,6,3,0.2),rgba(8,6,3,0.75));"></div>
          </>
        ) : (
          <div class={`absolute inset-0 ${character.isActive ? 'bg-linear-to-br from-orange-900 via-amber-900 to-stone-900' : 'bg-linear-to-br from-stone-900 via-stone-800 to-stone-900'}`}
            style="background-image:repeating-linear-gradient(45deg,transparent,transparent 60px,rgba(201,144,50,0.03) 60px,rgba(201,144,50,0.03) 62px);">
          </div>
        )}

        {!character.isActive && (
          <div class="absolute top-4 right-4 z-10">
            <span class="t-badge" style="background:rgba(8,6,3,0.7);border-color:rgba(201,144,50,0.3);color:var(--text-muted);backdrop-filter:blur(8px);">Inactive</span>
          </div>
        )}

        <div class="t-hero-banner-content flex flex-col sm:flex-row items-center sm:items-end gap-5">
          <!-- Avatar -->
          {character.avatarUrl ? (
            <img src={character.avatarUrl} alt={character.name}
              class="w-40 h-40 sm:w-52 sm:h-52 rounded-full object-cover shrink-0 shadow-2xl"
              style="border:3px solid var(--border-gold);"/>
          ) : (
            <div class="w-40 h-40 sm:w-52 sm:h-52 rounded-full shrink-0 flex items-center justify-center shadow-2xl"
              style="background:var(--bg-surface);border:3px solid var(--border-gold);font-family:'Cormorant Garamond',serif;font-size:4.5rem;font-weight:700;color:var(--gold);">
              {character.name.charAt(0)}
            </div>
          )}
          <!-- Name block -->
          <div class="text-center sm:text-left">
            <h1 class="font-display italic font-semibold text-3xl sm:text-4xl md:text-5xl leading-tight mb-1"
              style="color:#fff;text-shadow:0 2px 20px rgba(0,0,0,0.8);">{character.name}</h1>
            <p class="text-lg sm:text-xl mb-0.5" style="color:rgba(242,232,213,0.85);">
              {character.race}{character.class ? ` · ${character.class}` : ''}
            </p>
            {character.player && (
              <p class="text-sm" style="color:rgba(201,144,50,0.8);">Played by {character.player}</p>
            )}
          </div>
        </div>
      </div>

      <!-- Quick stats strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-px" style="background:var(--border-gold);">
        <div class="px-5 py-4 text-center" style="background:var(--bg-surface);">
          <div class="t-label-sm mb-1">Level</div>
          <div class="t-num text-3xl">{character.level || '—'}</div>
        </div>
        <div class="px-5 py-4 text-center" style="background:var(--bg-surface);">
          <div class="t-label-sm mb-1">Race</div>
          <div class="font-semibold text-base" style="color:var(--text-strong);">{character.race || '—'}</div>
        </div>
        <div class="px-5 py-4 text-center" style="background:var(--bg-surface);">
          <div class="t-label-sm mb-1">Class</div>
          <div class="font-semibold text-base" style="color:var(--text-strong);">{character.class || '—'}</div>
        </div>
        <div class="px-5 py-4 text-center" style="background:var(--bg-surface);">
          <div class="t-label-sm mb-1">Sessions</div>
          <div class="t-num text-3xl">{sessionCount}</div>
        </div>
      </div>
    </div>

    <!-- ── Ability Scores ─────────────────────────────────────── -->
    {character.stats && (
      <div class="t-panel p-6 sm:p-8 mb-6">
        <div class="t-section-header">
          <h2 class="t-section-h text-xl">Ability Scores</h2>
        </div>
        <div class="grid grid-cols-3 md:grid-cols-6 gap-3">
          {([
            { key: 'strength',     label: 'STR' },
            { key: 'dexterity',    label: 'DEX' },
            { key: 'constitution', label: 'CON' },
            { key: 'intelligence', label: 'INT' },
            { key: 'wisdom',       label: 'WIS' },
            { key: 'charisma',     label: 'CHA' },
          ] as const).map(({ key, label }) => (
            <div class="t-stat-block">
              <div class="t-stat-label">{label}</div>
              <div class="t-stat-value">{(character.stats as any)[key] ?? '—'}</div>
              {(character.stats as any)[key] !== undefined && (
                <div class="t-stat-mod">{statMod((character.stats as any)[key])}</div>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- ── Character Details ──────────────────────────────────── -->
    {(character.background || character.alignment || character.gender || character.age || character.height || character.weight || character.eyes || character.skin || character.hair) && (
      <div class="t-panel p-6 sm:p-8 mb-6">
        <div class="t-section-header">
          <h2 class="t-section-h text-xl">Character Details</h2>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-5">
          {character.background && (
            <div>
              <div class="t-field-label">Background</div>
              <div class="t-field-value font-medium">{character.background}</div>
            </div>
          )}
          {character.alignment && (
            <div>
              <div class="t-field-label">Alignment</div>
              <div class="t-field-value font-medium">{character.alignment}</div>
            </div>
          )}
          {character.gender && (
            <div>
              <div class="t-field-label">Gender</div>
              <div class="t-field-value">{character.gender}</div>
            </div>
          )}
          {character.age && (
            <div>
              <div class="t-field-label">Age</div>
              <div class="t-field-value">{character.age} years</div>
            </div>
          )}
          {character.height && (
            <div>
              <div class="t-field-label">Height</div>
              <div class="t-field-value">{character.height}</div>
            </div>
          )}
          {character.weight && (
            <div>
              <div class="t-field-label">Weight</div>
              <div class="t-field-value">{character.weight} lbs</div>
            </div>
          )}
          {character.eyes && (
            <div>
              <div class="t-field-label">Eyes</div>
              <div class="t-field-value">{character.eyes}</div>
            </div>
          )}
          {character.skin && (
            <div>
              <div class="t-field-label">Skin</div>
              <div class="t-field-value">{character.skin}</div>
            </div>
          )}
          {character.hair && (
            <div>
              <div class="t-field-label">Hair</div>
              <div class="t-field-value">{character.hair}</div>
            </div>
          )}
        </div>
      </div>
    )}

    <!-- ── D&D Beyond ─────────────────────────────────────────── -->
    {character.dndbeyondUrl && (
      <div class="t-panel p-6 sm:p-8 mb-6">
        <div class="t-section-header">
          <h2 class="t-section-h text-xl">D&D Beyond</h2>
        </div>
        <div class="flex flex-wrap gap-3 items-center mb-3">
          <a href={character.dndbeyondUrl} target="_blank" class="t-btn-primary">
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
            View on D&D Beyond
          </a>
          {canEdit && (
            <button id="syncCharacter" data-id={character.id} class="t-btn-secondary">
              <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
              <span id="syncButtonText">Sync from D&D Beyond</span>
            </button>
          )}
        </div>
        {character.lastSyncedAt && (
          <p class="t-faint text-xs">Last synced: {new Date(character.lastSyncedAt).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' })}</p>
        )}
        <div id="syncStatus" class="hidden mt-3"></div>
      </div>
    )}

    <!-- ── D&D Beyond info callout ────────────────────────────── -->
    {isLoggedIn && (
      <div class="t-callout mb-6">
        <div class="t-callout-title">D&D Beyond Integration</div>
        <p class="t-body-text text-sm mb-1">
          {character.dndbeyondUrl
            ? 'This character is linked to D&D Beyond. Use the Sync button to update stats, HP, and level automatically.'
            : 'Link this character to D&D Beyond by editing and adding their profile URL to auto-import stats.'}
        </p>
        <p class="t-faint text-xs">Character sheet must be set to Public in D&D Beyond.</p>
      </div>
    )}

  </div>
</Layout>

<script>
  function initializeDetailPage() {
    const deleteBtn = document.getElementById('deleteCharacter');
    const editBtn = document.getElementById('editCharacter');

    editBtn?.addEventListener('click', () => {
      const id = editBtn.getAttribute('data-id');
      if (id) window.location.href = `/characters?edit=${id}`;
    });

    deleteBtn?.addEventListener('click', async () => {
      const id = deleteBtn.getAttribute('data-id');
      if (!id) return;
      if ((await window.arandorConfirm('Delete this character?', { detail: 'This can\u2019t be undone.', confirmLabel: 'Delete', danger: true }))) {
        try {
          const response = await fetch(`/api/characters/${id}`, { method: 'DELETE' });
          if (response.ok) {
            window.location.href = '/characters';
          } else {
            const error = await response.json().catch(() => ({ error: 'Unknown error' }));
            alert(`Failed to delete character: ${error.error || response.statusText}`);
          }
        } catch (error) {
          alert('An error occurred while deleting the character.');
        }
      }
    });

    const syncBtn = document.getElementById('syncCharacter') as HTMLButtonElement | null;
    if (syncBtn) {
      syncBtn.addEventListener('click', async () => {
        const id = syncBtn.getAttribute('data-id');
        if (!id) return;
        const syncStatus = document.getElementById('syncStatus');
        const syncButtonText = document.getElementById('syncButtonText');
        syncBtn.disabled = true;
        if (syncButtonText) syncButtonText.textContent = 'Syncing…';
        if (syncStatus) {
          syncStatus.className = 'mt-3 p-3 rounded-xs t-inset t-body-text text-sm';
          syncStatus.textContent = 'Syncing character data from D&D Beyond…';
          syncStatus.classList.remove('hidden');
        }
        try {
          const response = await fetch('/api/characters/sync', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ characterId: id }),
          });
          if (response.ok) {
            if (syncStatus) {
              syncStatus.textContent = '✓ Character synced! Reloading…';
              syncStatus.style.color = 'var(--gold)';
            }
            setTimeout(() => window.location.reload(), 1000);
          } else {
            const error = await response.json().catch(() => ({ error: 'Unknown error' }));
            if (syncStatus) {
              syncStatus.textContent = `✗ Sync failed: ${error.error || response.statusText}`;
              syncStatus.style.color = '#f87171';
            }
            syncBtn.disabled = false;
            if (syncButtonText) syncButtonText.textContent = 'Sync from D&D Beyond';
          }
        } catch {
          if (syncStatus) {
            syncStatus.textContent = '✗ An error occurred. Check your connection.';
            syncStatus.style.color = '#f87171';
          }
          syncBtn.disabled = false;
          if (syncButtonText) syncButtonText.textContent = 'Sync from D&D Beyond';
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initializeDetailPage);
</script>

<script define:vars={{ shouldAutoSync, characterId: character.id }}>
  async function autoSyncCharacter() {
    if (!shouldAutoSync) return;
    const notification = document.createElement('div');
    notification.className = 't-toast';
    notification.innerHTML = `
      <svg class="w-4 h-4 animate-spin shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
      </svg>
      <span>Auto-syncing from D&D Beyond…</span>`;
    document.body.appendChild(notification);
    try {
      const response = await fetch('/api/characters/sync', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ characterId }),
      });
      if (response.ok) {
        notification.className = 't-toast t-toast-success';
        notification.innerHTML = `<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>Synced! Reloading…</span>`;
        setTimeout(() => window.location.reload(), 1500);
      } else {
        notification.className = 't-toast t-toast-error';
        notification.innerHTML = `<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg><span>Auto-sync failed</span>`;
        setTimeout(() => notification.remove(), 3000);
      }
    } catch {
      notification.className = 't-toast t-toast-error';
      notification.innerHTML = `<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg><span>Auto-sync error</span>`;
      setTimeout(() => notification.remove(), 3000);
    }
  }
  document.addEventListener('astro:page-load', autoSyncCharacter);
</script>

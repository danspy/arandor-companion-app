---
import Layout from '../layouts/Layout.astro';
import { db, Character } from 'astro:db';
import { isAuthenticated } from '../lib/auth';

const characters = await db.select().from(Character);
const isLoggedIn = isAuthenticated(Astro.cookies);

// Get the edit parameter from URL if present
const editCharacterId = Astro.url.searchParams.get('edit');

// Get unique classes for filtering
const allClasses = [...new Set(characters.map(c => c.class).filter(Boolean))].sort();
---

<Layout title="Player Characters">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold text-primary-700 dark:text-primary-400">Player Characters</h1>
    {isLoggedIn && (
      <button 
        id="addCharacter"
        class="bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
      >
        + Add Character
      </button>
    )}
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-primary-600 dark:text-primary-400">{characters.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Total Characters</div>
    </div>
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-green-600 dark:text-green-400">{characters.filter(c => c.isActive !== false).length}</div>
      <div class="text-gray-600 dark:text-gray-400">Active Players</div>
    </div>
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-secondary-600 dark:text-secondary-400">{allClasses.length}</div>
      <div class="text-gray-600 dark:text-gray-400">Unique Classes</div>
    </div>
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 text-center dark:border dark:border-gray-900">
      <div class="text-3xl font-bold text-accent-600 dark:text-accent-400">{characters.length > 0 ? Math.round(characters.reduce((sum, c) => sum + c.level, 0) / characters.length) : 0}</div>
      <div class="text-gray-600 dark:text-gray-400">Average Level</div>
    </div>
  </div>

  <!-- Search and Filter -->
  <div class="bg-white dark:bg-black rounded-lg shadow-md p-4 mb-6 dark:border dark:border-gray-900">
    <div class="flex flex-col md:flex-row gap-4">
      <div class="relative flex-1">
        <input 
          type="text" 
          id="searchInput" 
          placeholder="Search characters by name, race, class, or player..."
          class="w-full px-4 py-2 pl-10 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100 transition"
        >
        <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-sm text-gray-600 dark:text-gray-400 font-medium">Filter:</span>
        <button 
          id="filterActive" 
          class="px-3 py-1.5 rounded-full text-sm font-medium bg-primary-600 text-white transition-all duration-200 hover:bg-primary-700 active:scale-95"
          data-active="true"
        >
          Active ({characters.filter(c => c.isActive !== false).length})
        </button>
        <button 
          id="filterInactive" 
          class="px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95"
          data-active="false"
        >
          Inactive ({characters.filter(c => c.isActive === false).length})
        </button>
        <button 
          id="filterAll" 
          class="px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95"
          data-active="false"
        >
          All ({characters.length})
        </button>
      </div>
    </div>
  </div>

  <div id="characterGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {characters.map(character => (
      <div class="character-card bg-white dark:bg-black rounded-lg shadow-md overflow-hidden hover:shadow-lg transition dark:border dark:border-gray-900" data-class={character.class} data-search={`${character.name} ${character.race} ${character.class} ${character.player}`.toLowerCase()} data-is-active={character.isActive ? "true" : "false"}>
        <a href={`/characters/${character.id}`} class="block">
          <div class={`bg-gradient-to-r ${character.isActive ? 'from-primary-600 to-secondary-600' : 'from-gray-500 to-gray-600'} h-24 flex items-center justify-center relative`}>
            {!character.isActive && (
              <div class="absolute top-2 right-2 bg-gray-800 text-white text-xs px-2 py-1 rounded">
                Inactive
              </div>
            )}
            {character.avatarUrl ? (
              <img 
                src={character.avatarUrl} 
                alt={character.name}
                class="w-16 h-16 rounded-full object-cover border-2 border-white"
              />
            ) : (
              <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center text-3xl">
                {character.name.charAt(0)}
              </div>
            )}
          </div>
        </a>
        
        <div class="p-6">
          <a href={`/characters/${character.id}`} class="block hover:text-primary-700 dark:hover:text-primary-400 transition">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">{character.name}</h2>
          </a>
          <p class="text-gray-600 dark:text-gray-400 mb-4">{character.race} {character.class}</p>
          
          <div class="grid grid-cols-2 gap-3 mb-4">
            <div class="bg-primary-50 dark:bg-primary-900/20 dark:border dark:border-primary-800 p-3 rounded">
              <div class="text-sm text-gray-600 dark:text-gray-400">Level</div>
              <div class="text-xl font-bold text-primary-700 dark:text-primary-400">{character.level}</div>
            </div>
            <div class="bg-primary-50 dark:bg-primary-900/20 dark:border dark:border-primary-800 p-3 rounded">
              <div class="text-sm text-gray-600 dark:text-gray-400">Player</div>
              <div class="text-lg font-semibold text-primary-700 dark:text-primary-400">{character.player}</div>
            </div>
          </div>

          {character.stats && (
            <div class="border-t dark:border-gray-900 pt-4">
              <h3 class="font-semibold mb-3 dark:text-gray-200">Ability Scores</h3>
              <div class="grid grid-cols-3 gap-2 text-center">
                <div class="bg-gray-50 dark:bg-gray-700 p-2 rounded">
                  <div class="text-xs text-gray-500 dark:text-gray-400">STR</div>
                  <div class="font-bold dark:text-gray-100">{character.stats.strength}</div>
                </div>
                <div class="bg-gray-50 dark:bg-gray-700 p-2 rounded">
                  <div class="text-xs text-gray-500 dark:text-gray-400">DEX</div>
                  <div class="font-bold dark:text-gray-100">{character.stats.dexterity}</div>
                </div>
                <div class="bg-gray-50 dark:bg-gray-700 p-2 rounded">
                  <div class="text-xs text-gray-500 dark:text-gray-400">CON</div>
                  <div class="font-bold dark:text-gray-100">{character.stats.constitution}</div>
                </div>
                <div class="bg-gray-50 dark:bg-gray-700 p-2 rounded">
                  <div class="text-xs text-gray-500 dark:text-gray-400">INT</div>
                  <div class="font-bold dark:text-gray-100">{character.stats.intelligence}</div>
                </div>
                <div class="bg-gray-50 dark:bg-gray-700 p-2 rounded">
                  <div class="text-xs text-gray-500 dark:text-gray-400">WIS</div>
                  <div class="font-bold dark:text-gray-100">{character.stats.wisdom}</div>
                </div>
                <div class="bg-gray-50 dark:bg-gray-700 p-2 rounded">
                  <div class="text-xs text-gray-500 dark:text-gray-400">CHA</div>
                  <div class="font-bold dark:text-gray-100">{character.stats.charisma}</div>
                </div>
              </div>
            </div>
          )}

          <a 
            href={`/characters/${character.id}`}
            class="block mt-4 text-center bg-accent-100 dark:bg-accent-900/20 dark:border dark:border-accent-800 text-accent-700 dark:text-accent-400 px-4 py-2 rounded hover:bg-accent-200 dark:hover:bg-accent-900/30 transition font-medium"
          >
            View Details →
          </a>

          {isLoggedIn && (
            <div class="mt-2 flex gap-2">
              <button class="edit-character flex-1 bg-primary-600 text-white px-4 py-2 rounded hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition" data-id={character.id}>
                Edit
              </button>
              <button class="delete-character px-4 py-2 border-2 border-red-600 text-red-600 dark:text-red-400 dark:border-red-500 rounded hover:bg-red-50 dark:hover:bg-red-900/20 transition" data-id={character.id}>
                Delete
              </button>
            </div>
          )}

          {character.dndbeyondUrl && (
            <a 
              href={character.dndbeyondUrl}
              target="_blank"
              class="block mt-2 text-center text-sm text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300"
            >
              View on D&D Beyond →
            </a>
          )}
        </div>
      </div>
    ))}
  </div>

  <div class="mt-8 bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-500 dark:border-blue-400 p-4 rounded dark:border dark:border-blue-800">
    <h3 class="font-semibold text-blue-900 dark:text-blue-300 mb-2">💡 D&D Beyond Integration</h3>
    <p class="text-sm text-blue-800 dark:text-blue-200">
      You can import character data from D&D Beyond by providing the character URL or using the API endpoint.
      This feature allows automatic synchronization of character stats, levels, and equipment.
    </p>
  </div>

  <!-- Modal for Add/Edit Character -->
  <div id="characterModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white dark:bg-black rounded-lg p-4 sm:p-8 max-w-4xl w-full max-h-[90vh] overflow-y-auto dark:border dark:border-gray-900">
      <h2 id="modalTitle" class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6 text-primary-700 dark:text-primary-400">New Character</h2>
      <form id="characterForm" class="space-y-4">
        <input type="hidden" id="characterId" name="id">
        
        <div class="mb-4 p-3 sm:p-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg">
          <p class="text-xs sm:text-sm text-blue-800 dark:text-blue-200">
            💡 <strong>Tip:</strong> You can either fill out the form manually OR use the D&D Beyond Auto-fill feature. Just provide the D&D Beyond URL and click "Auto-fill" to populate the fields automatically.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Name</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
          </div>
          
          <div>
            <label for="player" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Player</label>
            <input 
              type="text" 
              id="player" 
              name="player" 
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
          </div>
        </div>
        
        <div class="flex items-center gap-2">
          <input 
            type="checkbox" 
            id="isActive" 
            name="isActive" 
            checked
            class="w-4 h-4 text-primary-600 border-gray-300 dark:border-gray-600 rounded focus:ring-2 focus:ring-primary-500 dark:bg-gray-700"
          >
          <label for="isActive" class="text-sm font-medium text-gray-700 dark:text-gray-300">Active Player</label>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="race" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Race</label>
            <input 
              type="text" 
              id="race" 
              name="race" 
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
          </div>
          
          <div>
            <label for="class" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Class</label>
            <input 
              type="text" 
              id="class" 
              name="class" 
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
          </div>
          
          <div>
            <label for="level" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Level</label>
            <input 
              type="number" 
              id="level" 
              name="level" 
              min="1"
              max="20"
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
          </div>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="avatarUrl" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Avatar URL (optional)</label>
            <input 
              type="url" 
              id="avatarUrl" 
              name="avatarUrl" 
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
          </div>
          
          <div>
            <label for="dndbeyondUrl" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">D&D Beyond URL (optional)</label>
            <div class="flex flex-col sm:flex-row gap-2">
              <input 
                type="url" 
                id="dndbeyondUrl" 
                name="dndbeyondUrl" 
                class="flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
                placeholder="https://www.dndbeyond.com/characters/..."
              >
              <button 
                type="button"
                id="fetchFromDndBeyond"
                class="bg-secondary-600 text-white px-4 py-2 rounded-lg hover:bg-secondary-700 dark:bg-secondary-700 dark:hover:bg-secondary-600 transition whitespace-nowrap"
                title="Fetch character data from D&D Beyond"
              >
                Auto-fill
              </button>
            </div>
          </div>
        </div>
        
        <div id="fetchStatus" class="hidden p-3 rounded-lg mb-2"></div>
        
        <div>
          <h3 class="font-semibold mb-2 dark:text-gray-200">Ability Scores</h3>
          <div class="grid grid-cols-6 gap-2">
            <div>
              <label for="strength" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">STR</label>
              <input 
                type="number" 
                id="strength" 
                name="strength" 
                min="1"
                max="30"
                class="w-full px-2 py-1 border border-gray-300 dark:border-gray-600 rounded focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div>
              <label for="dexterity" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">DEX</label>
              <input 
                type="number" 
                id="dexterity" 
                name="dexterity" 
                min="1"
                max="30"
                class="w-full px-2 py-1 border border-gray-300 dark:border-gray-600 rounded focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div>
              <label for="constitution" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">CON</label>
              <input 
                type="number" 
                id="constitution" 
                name="constitution" 
                min="1"
                max="30"
                class="w-full px-2 py-1 border border-gray-300 dark:border-gray-600 rounded focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div>
              <label for="intelligence" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">INT</label>
              <input 
                type="number" 
                id="intelligence" 
                name="intelligence" 
                min="1"
                max="30"
                class="w-full px-2 py-1 border border-gray-300 dark:border-gray-600 rounded focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div>
              <label for="wisdom" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">WIS</label>
              <input 
                type="number" 
                id="wisdom" 
                name="wisdom" 
                min="1"
                max="30"
                class="w-full px-2 py-1 border border-gray-300 dark:border-gray-600 rounded focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div>
              <label for="charisma" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">CHA</label>
              <input 
                type="number" 
                id="charisma" 
                name="charisma" 
                min="1"
                max="30"
                class="w-full px-2 py-1 border border-gray-300 dark:border-gray-600 rounded focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
          </div>
        </div>
        
        <div>
          <h3 class="font-semibold mb-2 dark:text-gray-200">Additional Details (Optional)</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            <div>
              <label for="background" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Background</label>
              <input 
                type="text" 
                id="background" 
                name="background" 
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div>
              <label for="alignment" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Alignment</label>
              <input 
                type="text" 
                id="alignment" 
                name="alignment" 
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div>
              <label for="gender" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Gender</label>
              <input 
                type="text" 
                id="gender" 
                name="gender" 
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div>
              <label for="age" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Age</label>
              <input 
                type="number" 
                id="age" 
                name="age" 
                min="1"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div>
              <label for="height" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Height</label>
              <input 
                type="text" 
                id="height" 
                name="height" 
                placeholder="e.g., 5'11&quot;"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div>
              <label for="weight" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Weight (lbs)</label>
              <input 
                type="number" 
                id="weight" 
                name="weight" 
                min="1"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div>
              <label for="eyes" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Eye Color</label>
              <input 
                type="text" 
                id="eyes" 
                name="eyes" 
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div>
              <label for="skin" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Skin Color</label>
              <input 
                type="text" 
                id="skin" 
                name="skin" 
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div>
              <label for="hair" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Hair Color</label>
              <input 
                type="text" 
                id="hair" 
                name="hair" 
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
          </div>
        </div>
        
        <div class="flex gap-4 pt-4">
          <button 
            type="submit" 
            class="flex-1 bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 transition"
          >
            Save Character
          </button>
          <button 
            type="button" 
            id="cancelModal"
            class="flex-1 bg-gray-300 dark:bg-gray-600 text-gray-700 dark:text-gray-200 px-6 py-2 rounded-lg hover:bg-gray-400 dark:hover:bg-gray-700 transition"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  // Shared state for editing character ID
  let editingId: string | null = null;

  // Initialize character modal and form functionality
  function initializeCharacterModal() {
    const modal = document.getElementById('characterModal');
    const form = document.getElementById('characterForm') as HTMLFormElement;
    const modalTitle = document.getElementById('modalTitle');
    const addButton = document.getElementById('addCharacter');
    const cancelButton = document.getElementById('cancelModal');
    const fetchButton = document.getElementById('fetchFromDndBeyond');
    const fetchStatus = document.getElementById('fetchStatus');

    // Open modal for new character
    addButton?.addEventListener('click', () => {
      editingId = null;
      form.reset();
      if (modalTitle) modalTitle.textContent = 'New Character';
      modal?.classList.remove('hidden');
    });

    // Close modal
    cancelButton?.addEventListener('click', () => {
      modal?.classList.add('hidden');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });

    // Handle form submission
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      
      // Validate that required fields are filled
      const name = formData.get('name') as string;
      const player = formData.get('player') as string;
      const race = formData.get('race') as string;
      const className = formData.get('class') as string;
      const level = formData.get('level') as string;
      
      // Check if required fields are empty
      if (!name || !player || !race || !className || !level) {
        alert('Please fill out all required fields (Name, Player, Race, Class, Level) or use the D&D Beyond Auto-fill feature.');
        return;
      }
      
      const stats = {
        strength: parseInt(formData.get('strength') as string) || 10,
        dexterity: parseInt(formData.get('dexterity') as string) || 10,
        constitution: parseInt(formData.get('constitution') as string) || 10,
        intelligence: parseInt(formData.get('intelligence') as string) || 10,
        wisdom: parseInt(formData.get('wisdom') as string) || 10,
        charisma: parseInt(formData.get('charisma') as string) || 10,
      };
      
      const data = {
        name,
        player,
        race,
        class: className,
        level: parseInt(level),
        isActive: (document.getElementById('isActive') as HTMLInputElement).checked,
        avatarUrl: formData.get('avatarUrl') || undefined,
        dndbeyondUrl: formData.get('dndbeyondUrl') || undefined,
        stats,
        // Additional character details
        background: formData.get('background') || undefined,
        alignment: formData.get('alignment') || undefined,
        gender: formData.get('gender') || undefined,
        age: formData.get('age') ? parseInt(formData.get('age') as string) : undefined,
        height: formData.get('height') || undefined,
        weight: formData.get('weight') ? parseInt(formData.get('weight') as string) : undefined,
        eyes: formData.get('eyes') || undefined,
        skin: formData.get('skin') || undefined,
        hair: formData.get('hair') || undefined,
      };

      try {
        const url = editingId ? `/api/characters/${editingId}` : '/api/characters';
        const method = editingId ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Failed to save character. Please try again.');
        }
      } catch (error) {
        alert('An error occurred. Please try again.');
      }
    });

    // Fetch character data from D&D Beyond
    fetchButton?.addEventListener('click', async () => {
      const urlInput = document.getElementById('dndbeyondUrl') as HTMLInputElement;
      const url = urlInput.value.trim();
      
      if (!url) {
        alert('Please enter a D&D Beyond character URL first.');
        return;
      }
      
      // Show loading status
      if (fetchStatus) {
        fetchStatus.textContent = 'Fetching character data from D&D Beyond...';
        fetchStatus.className = 'p-3 rounded-lg mb-2 bg-blue-100 text-blue-800';
        fetchStatus.classList.remove('hidden');
      }
      
      try {
        const response = await fetch('/api/characters/dndbeyond', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url }),
        });
        
        if (response.ok) {
          const data = await response.json();
          
          // Fill in the form fields
          if (data.name) (document.getElementById('name') as HTMLInputElement).value = data.name;
          if (data.race) (document.getElementById('race') as HTMLInputElement).value = data.race;
          if (data.class) (document.getElementById('class') as HTMLInputElement).value = data.class;
          if (data.level) (document.getElementById('level') as HTMLInputElement).value = data.level;
          if (data.avatarUrl) (document.getElementById('avatarUrl') as HTMLInputElement).value = data.avatarUrl;
          
          if (data.stats) {
            if (data.stats.strength) (document.getElementById('strength') as HTMLInputElement).value = data.stats.strength;
            if (data.stats.dexterity) (document.getElementById('dexterity') as HTMLInputElement).value = data.stats.dexterity;
            if (data.stats.constitution) (document.getElementById('constitution') as HTMLInputElement).value = data.stats.constitution;
            if (data.stats.intelligence) (document.getElementById('intelligence') as HTMLInputElement).value = data.stats.intelligence;
            if (data.stats.wisdom) (document.getElementById('wisdom') as HTMLInputElement).value = data.stats.wisdom;
            if (data.stats.charisma) (document.getElementById('charisma') as HTMLInputElement).value = data.stats.charisma;
          }
          
          // Fill in additional character details
          if (data.background) (document.getElementById('background') as HTMLInputElement).value = data.background;
          if (data.alignment) (document.getElementById('alignment') as HTMLInputElement).value = data.alignment;
          if (data.gender) (document.getElementById('gender') as HTMLInputElement).value = data.gender;
          if (data.age) (document.getElementById('age') as HTMLInputElement).value = data.age;
          if (data.height) (document.getElementById('height') as HTMLInputElement).value = data.height;
          if (data.weight) (document.getElementById('weight') as HTMLInputElement).value = data.weight;
          if (data.eyes) (document.getElementById('eyes') as HTMLInputElement).value = data.eyes;
          if (data.skin) (document.getElementById('skin') as HTMLInputElement).value = data.skin;
          if (data.hair) (document.getElementById('hair') as HTMLInputElement).value = data.hair;
          
          // Show success status
          if (fetchStatus) {
            fetchStatus.textContent = '✓ Character data fetched successfully!';
            fetchStatus.className = 'p-3 rounded-lg mb-2 bg-green-100 text-green-800';
          }
        } else {
          const error = await response.json().catch(() => ({ error: 'Unknown error' }));
          if (fetchStatus) {
            fetchStatus.textContent = `Failed to fetch: ${error.error || 'Unknown error'}`;
            fetchStatus.className = 'p-3 rounded-lg mb-2 bg-red-100 text-red-800';
          }
        }
      } catch (error) {
        console.error('Fetch error:', error);
        if (fetchStatus) {
          fetchStatus.textContent = 'An error occurred. Please check the URL and try again.';
          fetchStatus.className = 'p-3 rounded-lg mb-2 bg-red-100 text-red-800';
        }
      }
    });

    // Check for edit parameter on page load and open modal if present
    const urlParams = new URLSearchParams(window.location.search);
    const editId = urlParams.get('edit');
    
    if (editId && modal && form && modalTitle) {
      (async () => {
        try {
          const response = await fetch(`/api/characters/${editId}`);
          if (!response.ok) {
            throw new Error('Character not found');
          }
          
          const character = await response.json();
          
          editingId = editId;
          (document.getElementById('name') as HTMLInputElement).value = character.name;
          (document.getElementById('player') as HTMLInputElement).value = character.player;
          (document.getElementById('race') as HTMLInputElement).value = character.race;
          (document.getElementById('class') as HTMLInputElement).value = character.class;
          (document.getElementById('level') as HTMLInputElement).value = character.level;
          (document.getElementById('isActive') as HTMLInputElement).checked = character.isActive !== false;
          (document.getElementById('avatarUrl') as HTMLInputElement).value = character.avatarUrl || '';
          (document.getElementById('dndbeyondUrl') as HTMLInputElement).value = character.dndbeyondUrl || '';
          
          if (character.stats) {
            (document.getElementById('strength') as HTMLInputElement).value = character.stats.strength;
            (document.getElementById('dexterity') as HTMLInputElement).value = character.stats.dexterity;
            (document.getElementById('constitution') as HTMLInputElement).value = character.stats.constitution;
            (document.getElementById('intelligence') as HTMLInputElement).value = character.stats.intelligence;
            (document.getElementById('wisdom') as HTMLInputElement).value = character.stats.wisdom;
            (document.getElementById('charisma') as HTMLInputElement).value = character.stats.charisma;
          }
          
          // Load additional character details
          (document.getElementById('background') as HTMLInputElement).value = character.background || '';
          (document.getElementById('alignment') as HTMLInputElement).value = character.alignment || '';
          (document.getElementById('gender') as HTMLInputElement).value = character.gender || '';
          (document.getElementById('age') as HTMLInputElement).value = character.age || '';
          (document.getElementById('height') as HTMLInputElement).value = character.height || '';
          (document.getElementById('weight') as HTMLInputElement).value = character.weight || '';
          (document.getElementById('eyes') as HTMLInputElement).value = character.eyes || '';
          (document.getElementById('skin') as HTMLInputElement).value = character.skin || '';
          (document.getElementById('hair') as HTMLInputElement).value = character.hair || '';
          
          modalTitle.textContent = 'Edit Character';
          modal.classList.remove('hidden');
          
          // Clear the URL parameter so refreshing doesn't re-open the modal
          window.history.replaceState({}, '', '/characters');
        } catch (error) {
          console.error('Failed to load character for editing:', error);
          alert('Failed to load character. Please try again.');
        }
      })();
    }
  }

  // Handle character edit/delete actions with event delegation
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const modal = document.getElementById('characterModal');
    const modalTitle = document.getElementById('modalTitle');
    
    // Edit character
    if (target.classList.contains('edit-character')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      try {
        const response = await fetch(`/api/characters/${id}`);
        if (!response.ok) {
          throw new Error('Failed to fetch character');
        }
        const character = await response.json();
        
        editingId = id;
        (document.getElementById('name') as HTMLInputElement).value = character.name;
        (document.getElementById('player') as HTMLInputElement).value = character.player;
        (document.getElementById('race') as HTMLInputElement).value = character.race;
        (document.getElementById('class') as HTMLInputElement).value = character.class;
        (document.getElementById('level') as HTMLInputElement).value = character.level;
        (document.getElementById('isActive') as HTMLInputElement).checked = character.isActive !== false;
        (document.getElementById('avatarUrl') as HTMLInputElement).value = character.avatarUrl || '';
        (document.getElementById('dndbeyondUrl') as HTMLInputElement).value = character.dndbeyondUrl || '';
        
        if (character.stats) {
          (document.getElementById('strength') as HTMLInputElement).value = character.stats.strength;
          (document.getElementById('dexterity') as HTMLInputElement).value = character.stats.dexterity;
          (document.getElementById('constitution') as HTMLInputElement).value = character.stats.constitution;
          (document.getElementById('intelligence') as HTMLInputElement).value = character.stats.intelligence;
          (document.getElementById('wisdom') as HTMLInputElement).value = character.stats.wisdom;
          (document.getElementById('charisma') as HTMLInputElement).value = character.stats.charisma;
        }
        
        // Load additional character details
        (document.getElementById('background') as HTMLInputElement).value = character.background || '';
        (document.getElementById('alignment') as HTMLInputElement).value = character.alignment || '';
        (document.getElementById('gender') as HTMLInputElement).value = character.gender || '';
        (document.getElementById('age') as HTMLInputElement).value = character.age || '';
        (document.getElementById('height') as HTMLInputElement).value = character.height || '';
        (document.getElementById('weight') as HTMLInputElement).value = character.weight || '';
        (document.getElementById('eyes') as HTMLInputElement).value = character.eyes || '';
        (document.getElementById('skin') as HTMLInputElement).value = character.skin || '';
        (document.getElementById('hair') as HTMLInputElement).value = character.hair || '';
        
        if (modalTitle) modalTitle.textContent = 'Edit Character';
        modal?.classList.remove('hidden');
      } catch (error) {
        console.error('Failed to load character:', error);
        alert('Failed to load character. Please try again.');
      }
    }
    
    // Delete character
    if (target.classList.contains('delete-character')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      if (confirm('Are you sure you want to delete this character?')) {
        try {
          const response = await fetch(`/api/characters/${id}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete character. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    }
  });

  // Initialize search and filter functionality
  function initializeFilters() {
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const filterActive = document.getElementById('filterActive') as HTMLButtonElement;
    const filterInactive = document.getElementById('filterInactive') as HTMLButtonElement;
    const filterAll = document.getElementById('filterAll') as HTMLButtonElement;
    const characterCards = document.querySelectorAll('.character-card');
    
    // Storage keys for persisting search and filter
    const SEARCH_STORAGE_KEY = 'characters_search';
    const FILTER_STORAGE_KEY = 'characters_filter';
    
    let currentFilter = localStorage.getItem(FILTER_STORAGE_KEY) || 'active';
    
    const updateFilterButtons = (filter: string) => {
      // Reset all buttons to inactive state
      [filterActive, filterInactive, filterAll].forEach(btn => {
        if (btn) {
          btn.classList.remove('bg-primary-600', 'text-white', 'hover:bg-primary-700');
          btn.classList.add('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300', 'hover:bg-gray-300', 'dark:hover:bg-gray-600', 'hover:shadow-md');
          btn.setAttribute('data-active', 'false');
        }
      });
      
      // Activate the selected button
      let activeButton = filterActive;
      if (filter === 'inactive') activeButton = filterInactive;
      if (filter === 'all') activeButton = filterAll;
      
      if (activeButton) {
        activeButton.classList.remove('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300', 'hover:bg-gray-300', 'dark:hover:bg-gray-600', 'hover:shadow-md');
        activeButton.classList.add('bg-primary-600', 'text-white', 'hover:bg-primary-700');
        activeButton.setAttribute('data-active', 'true');
      }
    };
    
    const applyFilters = (searchText: string, filter: string) => {
      const searchTerms = searchText.toLowerCase().split(/\s+/).filter(term => term.length > 0);
      characterCards.forEach(card => {
        const searchData = card.getAttribute('data-search') || '';
        const isActive = card.getAttribute('data-is-active') === 'true';
        
        // Match if ANY search term is found in the text (more flexible search)
        const matchesSearch = searchTerms.length === 0 || searchTerms.some(term => searchData.includes(term));
        
        // Match based on active filter
        let matchesFilter = true;
        if (filter === 'active') {
          matchesFilter = isActive;
        } else if (filter === 'inactive') {
          matchesFilter = !isActive;
        }
        // 'all' filter matches everything
        
        (card as HTMLElement).style.display = (matchesSearch && matchesFilter) ? 'block' : 'none';
      });
    };

    // Restore search text and filter from localStorage
    const savedSearch = localStorage.getItem(SEARCH_STORAGE_KEY) || '';
    if (searchInput) {
      searchInput.value = savedSearch;
    }
    updateFilterButtons(currentFilter);
    applyFilters(savedSearch, currentFilter);

    // Search functionality with localStorage persistence
    searchInput?.addEventListener('input', (e) => {
      const searchText = (e.target as HTMLInputElement).value;
      localStorage.setItem(SEARCH_STORAGE_KEY, searchText);
      applyFilters(searchText, currentFilter);
    });
    
    // Filter button handlers
    filterActive?.addEventListener('click', () => {
      currentFilter = 'active';
      localStorage.setItem(FILTER_STORAGE_KEY, currentFilter);
      updateFilterButtons(currentFilter);
      applyFilters(searchInput?.value || '', currentFilter);
    });
    
    filterInactive?.addEventListener('click', () => {
      currentFilter = 'inactive';
      localStorage.setItem(FILTER_STORAGE_KEY, currentFilter);
      updateFilterButtons(currentFilter);
      applyFilters(searchInput?.value || '', currentFilter);
    });
    
    filterAll?.addEventListener('click', () => {
      currentFilter = 'all';
      localStorage.setItem(FILTER_STORAGE_KEY, currentFilter);
      updateFilterButtons(currentFilter);
      applyFilters(searchInput?.value || '', currentFilter);
    });
  }

  // Run on initial page load and after View Transitions navigation
  document.addEventListener('astro:page-load', () => {
    initializeCharacterModal();
    initializeFilters();
  });
</script>

---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { db, Character, PageSettings, User, eq } from 'astro:db';
import { isAuthenticated, getUserRole, getCurrentUser } from '../lib/auth';

const characters = await db.select().from(Character);
const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);
const currentUser = await getCurrentUser(Astro.cookies);
const canEditHero = userRole === 'admin' || userRole === 'dungeonmaster';

// Fetch all users to check legacy ownership (characterIds arrays)
const allUsers = await db.select().from(User);

// Get the edit parameter from URL if present
const editCharacterId = Astro.url.searchParams.get('edit');

// Get unique classes for filtering
const allClasses = [...new Set(characters.map(c => c.class).filter(Boolean))].sort();

// Get page settings for hero image
const pageSettings = await db.select().from(PageSettings).where(eq(PageSettings.pageName, 'characters'));
const heroImageUrl = pageSettings.length > 0 ? pageSettings[0].heroImageUrl : null;

// Prepare user name for client-side script
const currentUserName = currentUser ? (currentUser.firstName || currentUser.username) : null;

// Helper function to find owner of a character (checks both modern and legacy ownership)
const findCharacterOwner = (character: typeof characters[0]) => {
  // Check modern ownership first (character.userId field)
  if (character.userId) {
    return { userId: character.userId, isLegacy: false };
  }
  
  // Check legacy ownership (character ID in any user's characterIds array)
  for (const user of allUsers) {
    if (user.characterIds && Array.isArray(user.characterIds) && user.characterIds.includes(character.id)) {
      return { userId: user.id, isLegacy: true };
    }
  }
  
  return null; // Unowned
};

// Function to check if current user can edit a character
const canEditCharacter = (character: typeof characters[0]) => {
  // Not logged in - no edit rights
  if (!isLoggedIn) return false;
  
  // Admins can edit everything - prioritize this check
  if (userRole === 'admin') return true;
  
  // Find the owner of this character
  const owner = findCharacterOwner(character);
  
  // If unowned, any logged-in user can edit
  if (!owner) return true;
  
  // Check if current user is the owner
  if (currentUser && owner.userId === currentUser.id) return true;
  
  // Otherwise, no edit rights
  return false;
};

// Helper function to get ownership display text
const getOwnershipText = (character: typeof characters[0]) => {
  const owner = findCharacterOwner(character);
  
  if (!owner) {
    return "Unowned";
  }
  
  if (owner.isLegacy) {
    return `Owner: ${owner.userId} (legacy)`;
  }
  
  return `Owner: ${owner.userId}`;
};
---

<Layout title="Player Characters">
  <PageHero 
    title="Player Characters" 
    heroImageUrl={heroImageUrl}
    pageName="characters"
    canEditHero={canEditHero}
  />

  {isLoggedIn && (
    <div class="flex justify-end mb-4">
      <Button 
        variant="primary"
        size="md"
        icon="add"
        id="addCharacter"
        title="Add new character"
      >
        Add Character
      </Button>
    </div>
  )}

  <!-- Stats -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-2 md:gap-4 mb-8">
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-3 md:p-6 text-center dark:border dark:border-gray-900">
      <div class="text-2xl md:text-3xl font-bold text-primary-600 dark:text-primary-400">{characters.length}</div>
      <div class="text-xs md:text-base text-gray-600 dark:text-gray-400">Total Characters</div>
    </div>
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-3 md:p-6 text-center dark:border dark:border-gray-900">
      <div class="text-2xl md:text-3xl font-bold text-green-600 dark:text-green-400">{characters.filter(c => c.isActive !== false).length}</div>
      <div class="text-xs md:text-base text-gray-600 dark:text-gray-400">Active Players</div>
    </div>
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-3 md:p-6 text-center dark:border dark:border-gray-900">
      <div class="text-2xl md:text-3xl font-bold text-secondary-600 dark:text-secondary-400">{allClasses.length}</div>
      <div class="text-xs md:text-base text-gray-600 dark:text-gray-400">Unique Classes</div>
    </div>
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-3 md:p-6 text-center dark:border dark:border-gray-900">
      <div class="text-2xl md:text-3xl font-bold text-accent-600 dark:text-accent-400">{characters.length > 0 ? Math.round(characters.reduce((sum, c) => sum + c.level, 0) / characters.length) : 0}</div>
      <div class="text-xs md:text-base text-gray-600 dark:text-gray-400">Average Level</div>
    </div>
  </div>

  <!-- Search and Filter -->
  <div class="bg-white dark:bg-black rounded-lg shadow-md p-4 mb-6 dark:border dark:border-gray-900">
    <div class="flex flex-col gap-3">
      <!-- Search Input - Always Full Width -->
      <div class="relative w-full">
        <input 
          type="text" 
          id="searchInput" 
          placeholder="Search characters by name, race, class, or player..."
          class="w-full px-4 py-2 pl-10 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100 transition"
        >
        <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <!-- Filter Tags Below -->
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-sm text-gray-600 dark:text-gray-400 font-medium">Filter:</span>
        <button 
          id="filterActive" 
          class="px-3 py-1.5 rounded-full text-sm font-medium bg-primary-600 text-white transition-all duration-200 hover:bg-primary-700 active:scale-95"
          data-active="true"
        >
          Active ({characters.filter(c => c.isActive !== false).length})
        </button>
        <button 
          id="filterInactive" 
          class="px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95"
          data-active="false"
        >
          Inactive ({characters.filter(c => c.isActive === false).length})
        </button>
        <button 
          id="filterAll" 
          class="px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95"
          data-active="false"
        >
          All ({characters.length})
        </button>
      </div>
    </div>
  </div>

  <div id="characterGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {characters.map(character => (
      <div 
        class="character-card bg-white dark:bg-black rounded-lg shadow-md overflow-hidden hover:shadow-lg transition dark:border dark:border-gray-900" 
        data-class={character.class} 
        data-search={`${character.name} ${character.race} ${character.class} ${character.player}`.toLowerCase()} 
        data-is-active={character.isActive ? "true" : "false"}
        data-user-id={character.userId || "unowned"}
        data-can-edit={canEditCharacter(character) ? "true" : "false"}
        data-character-id={character.id}
        data-dndbeyond-url={character.dndbeyondUrl || ""}
      >
        <a href={`/characters/${character.id}`} class="block">
          <div class="relative h-56 overflow-hidden">
            <!-- Blurred background -->
            {character.avatarUrl ? (
              <>
                <img 
                  src={character.avatarUrl} 
                  alt={character.name}
                  class="absolute inset-0 w-full h-full object-cover blur-md scale-110"
                />
                <div class="absolute inset-0 bg-black/30"></div>
              </>
            ) : (
              <div class={`absolute inset-0 bg-gradient-to-br ${character.isActive ? 'from-primary-600 to-secondary-600' : 'from-gray-500 to-gray-600'}`}></div>
            )}
            
            <!-- Circular avatar on top -->
            <div class="relative h-full flex items-center justify-center">
              {character.avatarUrl ? (
                <img 
                  src={character.avatarUrl} 
                  alt={character.name}
                  class="w-32 h-32 rounded-full object-cover border-4 border-white dark:border-gray-800 shadow-xl"
                />
              ) : (
                <div class="w-32 h-32 bg-white dark:bg-gray-800 rounded-full flex items-center justify-center text-5xl font-bold text-primary-700 dark:text-primary-400 shadow-xl border-4 border-white dark:border-gray-700">
                  {character.name.charAt(0)}
                </div>
              )}
            </div>
            
            <!-- Status badge -->
            {!character.isActive && (
              <div class="absolute top-3 right-3 bg-gray-800/90 text-white text-xs px-3 py-1 rounded-full shadow-lg">
                Inactive
              </div>
            )}
          </div>
        </a>
        
        <div class="p-6">
          <div class="flex items-start justify-between gap-2 mb-2">
            <a href={`/characters/${character.id}`} class="block hover:text-primary-700 dark:hover:text-primary-400 transition">
              <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{character.name}</h2>
            </a>
            {canEditCharacter(character) && (
              <div class="flex gap-2 items-center flex-shrink-0">
                <Button
                  variant="icon"
                  size="sm"
                  icon="edit"
                  iconPosition="only"
                  class="edit-character"
                  data-id={character.id}
                  title="Edit character"
                  ariaLabel="Edit character"
                />
                <Button
                  variant="ghost"
                  size="sm"
                  icon="delete"
                  iconPosition="only"
                  class="delete-character hover:text-red-600 dark:hover:text-red-400"
                  data-id={character.id}
                  title="Delete character"
                  ariaLabel="Delete character"
                />
              </div>
            )}
          </div>
          <a href={`/characters/${character.id}`} class="block hover:text-primary-700 dark:hover:text-primary-400 transition">
            <p class="text-gray-600 dark:text-gray-400 mb-4">{character.race} {character.class}</p>
          </a>
          
          <div class="grid grid-cols-2 gap-3 mb-4">
            <div class="bg-primary-50 dark:bg-primary-900/20 dark:border dark:border-primary-800 p-3 rounded">
              <div class="text-sm text-gray-600 dark:text-gray-400">Level</div>
              <div class="text-xl font-bold text-primary-700 dark:text-primary-400">{character.level}</div>
            </div>
            <div class="bg-primary-50 dark:bg-primary-900/20 dark:border dark:border-primary-800 p-3 rounded">
              <div class="text-sm text-gray-600 dark:text-gray-400">Player</div>
              <div class="text-lg font-semibold text-primary-700 dark:text-primary-400">{character.player}</div>
            </div>
          </div>

          {character.stats && (
            <div class="border-t dark:border-gray-900 pt-4">
              <h3 class="font-semibold mb-3 dark:text-gray-200">Ability Scores</h3>
              <div class="grid grid-cols-3 gap-2 text-center">
                <div class="bg-gray-50 dark:bg-gray-700 p-2 rounded">
                  <div class="text-xs text-gray-500 dark:text-gray-400">STR</div>
                  <div class="font-bold dark:text-gray-100">{character.stats.strength}</div>
                </div>
                <div class="bg-gray-50 dark:bg-gray-700 p-2 rounded">
                  <div class="text-xs text-gray-500 dark:text-gray-400">DEX</div>
                  <div class="font-bold dark:text-gray-100">{character.stats.dexterity}</div>
                </div>
                <div class="bg-gray-50 dark:bg-gray-700 p-2 rounded">
                  <div class="text-xs text-gray-500 dark:text-gray-400">CON</div>
                  <div class="font-bold dark:text-gray-100">{character.stats.constitution}</div>
                </div>
                <div class="bg-gray-50 dark:bg-gray-700 p-2 rounded">
                  <div class="text-xs text-gray-500 dark:text-gray-400">INT</div>
                  <div class="font-bold dark:text-gray-100">{character.stats.intelligence}</div>
                </div>
                <div class="bg-gray-50 dark:bg-gray-700 p-2 rounded">
                  <div class="text-xs text-gray-500 dark:text-gray-400">WIS</div>
                  <div class="font-bold dark:text-gray-100">{character.stats.wisdom}</div>
                </div>
                <div class="bg-gray-50 dark:bg-gray-700 p-2 rounded">
                  <div class="text-xs text-gray-500 dark:text-gray-400">CHA</div>
                  <div class="font-bold dark:text-gray-100">{character.stats.charisma}</div>
                </div>
              </div>
            </div>
          )}

          <a 
            href={`/characters/${character.id}`}
            class="block mt-4 text-center bg-accent-100 dark:bg-accent-900/20 dark:border dark:border-accent-800 text-accent-700 dark:text-accent-400 px-4 py-2 rounded-lg hover:bg-accent-200 dark:hover:bg-accent-900/30 transition font-medium text-sm"
          >
            View Details →
          </a>

          {character.dndbeyondUrl && (
            <a 
              href={character.dndbeyondUrl}
              target="_blank"
              class="block mt-2 text-center text-sm text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300"
            >
              View on D&D Beyond →
            </a>
          )}
        </div>
      </div>
    ))}
  </div>

  <div class="mt-8 bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-500 dark:border-blue-400 p-4 rounded dark:border dark:border-blue-800">
    <h3 class="font-semibold text-blue-900 dark:text-blue-300 mb-2">💡 D&D Beyond Integration</h3>
    <p class="text-sm text-blue-800 dark:text-blue-200">
      You can import character data from D&D Beyond by providing the character URL or using the API endpoint.
      This feature allows automatic synchronization of character stats, levels, and equipment.
    </p>
  </div>

  <!-- Modal for Add/Edit Character -->
  <div id="characterModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4 modal-overlay-safe">
    <div class="bg-white dark:bg-black rounded-lg p-4 sm:p-8 max-w-4xl w-full max-h-[90vh] overflow-y-auto dark:border dark:border-gray-900 modal-content-safe">
      <h2 id="modalTitle" class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6 text-primary-700 dark:text-primary-400">New Character</h2>
      <form id="characterForm" class="space-y-4">
        <input type="hidden" id="characterId" name="id">
        
        <div class="mb-4 p-3 sm:p-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg">
          <p class="text-xs sm:text-sm text-blue-800 dark:text-blue-200">
            💡 <strong>Tip:</strong> You can either fill out the form manually OR use the D&D Beyond Auto-fill feature. Just provide the D&D Beyond URL and click "Auto-fill" to populate the fields automatically.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Name</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
          </div>
          
          <div>
            <label for="player" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Player</label>
            <input 
              type="text" 
              id="player" 
              name="player" 
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
          </div>
        </div>
        
        <div class="flex items-center gap-2">
          <input 
            type="checkbox" 
            id="isActive" 
            name="isActive" 
            checked
            class="w-4 h-4 text-primary-600 border-gray-300 dark:border-gray-600 rounded focus:ring-2 focus:ring-primary-500 dark:bg-gray-700"
          >
          <label for="isActive" class="text-sm font-medium text-gray-700 dark:text-gray-300">Active Player</label>
        </div>
        
        <div id="assignToMeContainer" class="hidden flex items-center gap-2">
          <input 
            type="checkbox" 
            id="assignToMe" 
            name="assignToMe" 
            checked
            class="w-4 h-4 text-primary-600 border-gray-300 dark:border-gray-600 rounded focus:ring-2 focus:ring-primary-500 dark:bg-gray-700"
          >
          <label for="assignToMe" class="text-sm font-medium text-gray-700 dark:text-gray-300">
            Assign this character to my account
            <span class="text-xs text-gray-500 dark:text-gray-400 block">When checked, you'll be the only one (besides admins) who can edit or delete this character</span>
          </label>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="race" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Race</label>
            <input 
              type="text" 
              id="race" 
              name="race" 
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
          </div>
          
          <div>
            <label for="class" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Class</label>
            <input 
              type="text" 
              id="class" 
              name="class" 
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
          </div>
          
          <div>
            <label for="level" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Level</label>
            <input 
              type="number" 
              id="level" 
              name="level" 
              min="1"
              max="20"
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
            >
          </div>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Avatar (optional)</label>
            <div class="space-y-2">
              <div>
                <label for="avatarFile" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">Upload Image (max 5MB)</label>
                <input 
                  type="file" 
                  id="avatarFile" 
                  name="avatarFile" 
                  accept="image/*"
                  class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-gray-100"
                >
              </div>
              <div class="flex items-center gap-2">
                <div class="flex-1 h-px bg-gray-300 dark:bg-gray-600"></div>
                <span class="text-xs text-gray-500 dark:text-gray-400">OR</span>
                <div class="flex-1 h-px bg-gray-300 dark:bg-gray-600"></div>
              </div>
              <div>
                <label for="avatarUrl" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">Avatar URL or File</label>
                <input 
                  type="text" 
                  id="avatarUrl" 
                  name="avatarUrl" 
                  placeholder="https://example.com/avatar.jpg or /uploads/avatar.jpg"
                  class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
                >
              </div>
            </div>
            <div id="avatarPreview" class="hidden mt-2">
              <img id="avatarPreviewImg" src="" alt="Preview" class="max-w-full h-32 object-cover rounded-lg">
            </div>
          </div>
          
          <div>
            <label for="dndbeyondUrl" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">D&D Beyond URL (optional)</label>
            <div class="flex flex-col sm:flex-row gap-2">
              <input 
                type="url" 
                id="dndbeyondUrl" 
                name="dndbeyondUrl" 
                class="flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
                placeholder="https://www.dndbeyond.com/characters/..."
              >
              <button 
                type="button"
                id="fetchFromDndBeyond"
                class="bg-secondary-600 text-white px-4 py-2 rounded-lg hover:bg-secondary-700 dark:bg-secondary-700 dark:hover:bg-secondary-600 transition whitespace-nowrap"
                title="Fetch character data from D&D Beyond"
              >
                Auto-fill
              </button>
            </div>
          </div>
        </div>
        
        <div id="fetchStatus" class="hidden p-3 rounded-lg mb-2"></div>
        
        <div>
          <h3 class="font-semibold mb-2 dark:text-gray-200">Ability Scores</h3>
          <div class="grid grid-cols-6 gap-2">
            <div>
              <label for="strength" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">STR</label>
              <input 
                type="number" 
                id="strength" 
                name="strength" 
                min="1"
                max="30"
                class="w-full px-2 py-1 border border-gray-300 dark:border-gray-600 rounded focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div>
              <label for="dexterity" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">DEX</label>
              <input 
                type="number" 
                id="dexterity" 
                name="dexterity" 
                min="1"
                max="30"
                class="w-full px-2 py-1 border border-gray-300 dark:border-gray-600 rounded focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div>
              <label for="constitution" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">CON</label>
              <input 
                type="number" 
                id="constitution" 
                name="constitution" 
                min="1"
                max="30"
                class="w-full px-2 py-1 border border-gray-300 dark:border-gray-600 rounded focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div>
              <label for="intelligence" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">INT</label>
              <input 
                type="number" 
                id="intelligence" 
                name="intelligence" 
                min="1"
                max="30"
                class="w-full px-2 py-1 border border-gray-300 dark:border-gray-600 rounded focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div>
              <label for="wisdom" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">WIS</label>
              <input 
                type="number" 
                id="wisdom" 
                name="wisdom" 
                min="1"
                max="30"
                class="w-full px-2 py-1 border border-gray-300 dark:border-gray-600 rounded focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
              >
            </div>
            <div>
              <label for="charisma" class="block text-xs text-gray-600 dark:text-gray-400 mb-1">CHA</label>
              <input 
                type="number" 
                id="charisma" 
                name="charisma" 
                min="1"
                max="30"

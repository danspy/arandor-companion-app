<script define:vars={{ currentUserName }}>
  // Shared state for editing character ID
  let editingId = null;

  // Initialize character modal and form functionality
  function initializeCharacterModal() {
    const modal = document.getElementById('characterModal');
    const form = document.getElementById('characterForm');
    const modalTitle = document.getElementById('modalTitle');
    const addButton = document.getElementById('addCharacter');
    const cancelButton = document.getElementById('cancelModal');
    const fetchButton = document.getElementById('fetchFromDndBeyond');
    const fetchStatus = document.getElementById('fetchStatus');
    const assignToMeContainer = document.getElementById('assignToMeContainer');

    // Open modal for new character
    addButton?.addEventListener('click', () => {
      editingId = null;
      form.reset();
      if (modalTitle) modalTitle.textContent = 'New Character';
      // Auto-fill player name with current user's name
      if (currentUserName) {
        const playerInput = document.getElementById('player');
        if (playerInput) playerInput.value = currentUserName;
      }
      // Show "Assign to me" checkbox only when creating a new character
      if (assignToMeContainer) {
        assignToMeContainer.classList.remove('hidden');
        assignToMeContainer.classList.add('flex');
      }
      modal?.classList.remove('hidden');
    });

    // Close modal
    cancelButton?.addEventListener('click', () => {
      modal?.classList.add('hidden');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });

    // Handle form submission
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      
      // Validate that required fields are filled
      const name = formData.get('name');
      const player = formData.get('player');
      const race = formData.get('race');
      const className = formData.get('class');
      const level = formData.get('level');
      
      // Check if required fields are empty
      if (!name || !player || !race || !className || !level) {
        alert('Please fill out all required fields (Name, Player, Race, Class, Level) or use the D&D Beyond Auto-fill feature.');
        return;
      }
      
      // Handle avatar upload
      let avatarUrl = formData.get('avatarUrl') || undefined;
      const avatarFile = formData.get('avatarFile');
      
      if (avatarFile && avatarFile.size > 0) {
        try {
          const uploadFormData = new FormData();
          uploadFormData.append('file', avatarFile);
          
          const uploadResponse = await fetch('/api/upload', {
            method: 'POST',
            body: uploadFormData,
          });
          
          if (uploadResponse.ok) {
            const uploadData = await uploadResponse.json();
            avatarUrl = uploadData.url;
          } else {
            const error = await uploadResponse.json();
            alert(`Failed to upload avatar: ${error.error || 'Unknown error'}`);
            return;
          }
        } catch (error) {
          console.error('Upload error:', error);
          alert('Failed to upload avatar. Please try again.');
          return;
        }
      }
      
      const stats = {
        strength: parseInt(formData.get('strength')) || 10,
        dexterity: parseInt(formData.get('dexterity')) || 10,
        constitution: parseInt(formData.get('constitution')) || 10,
        intelligence: parseInt(formData.get('intelligence')) || 10,
        wisdom: parseInt(formData.get('wisdom')) || 10,
        charisma: parseInt(formData.get('charisma')) || 10,
      };
      
      const data = {
        name,
        player,
        race,
        class: className,
        level: parseInt(level),
        isActive: (document.getElementById('isActive')).checked,
        avatarUrl,
        dndbeyondUrl: formData.get('dndbeyondUrl') || undefined,
        stats,
        // Additional character details
        background: formData.get('background') || undefined,
        alignment: formData.get('alignment') || undefined,
        gender: formData.get('gender') || undefined,
        age: formData.get('age') ? parseInt(formData.get('age')) : undefined,
        height: formData.get('height') || undefined,
        weight: formData.get('weight') ? parseInt(formData.get('weight')) : undefined,
        eyes: formData.get('eyes') || undefined,
        skin: formData.get('skin') || undefined,
        hair: formData.get('hair') || undefined,
      };
      
      // Only include assignToUser when creating a new character
      if (!editingId) {
        data.assignToUser = (document.getElementById('assignToMe')).checked;
      }

      try {
        const url = editingId ? `/api/characters/${editingId}` : '/api/characters';
        const method = editingId ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Failed to save character. Please try again.');
        }
      } catch (error) {
        alert('An error occurred. Please try again.');
      }
    });

    // Handle avatar file preview
    const avatarFileInput = document.getElementById('avatarFile');
    const avatarUrlInput = document.getElementById('avatarUrl');
    const avatarPreview = document.getElementById('avatarPreview');
    const avatarPreviewImg = document.getElementById('avatarPreviewImg');

    avatarFileInput?.addEventListener('change', (e) => {
      const file = (e.target).files?.[0];
      if (file && avatarPreview && avatarPreviewImg) {
        const reader = new FileReader();
        reader.onload = (e) => {
          avatarPreviewImg.src = e.target?.result;
          avatarPreview.classList.remove('hidden');
        };
        reader.readAsDataURL(file);
        // Clear URL input when file is selected
        if (avatarUrlInput) avatarUrlInput.value = '';
      }
    });

    avatarUrlInput?.addEventListener('input', (e) => {
      const url = (e.target).value;
      if (url && avatarPreview && avatarPreviewImg) {
        avatarPreviewImg.src = url;
        avatarPreview.classList.remove('hidden');
        // Clear file input when URL is entered
        if (avatarFileInput) avatarFileInput.value = '';
      } else if (avatarPreview) {
        avatarPreview.classList.add('hidden');
      }
    });

    // Fetch character data from D&D Beyond
    fetchButton?.addEventListener('click', async () => {
      const urlInput = document.getElementById('dndbeyondUrl');
      const url = urlInput.value.trim();
      
      if (!url) {
        alert('Please enter a D&D Beyond character URL first.');
        return;
      }
      
      // Show loading status
      if (fetchStatus) {
        fetchStatus.textContent = 'Fetching character data from D&D Beyond...';
        fetchStatus.className = 'p-3 rounded-lg mb-2 bg-blue-100 text-blue-800';
        fetchStatus.classList.remove('hidden');
      }
      
      try {
        const response = await fetch('/api/characters/dndbeyond', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url }),
        });
        
        if (response.ok) {
          const data = await response.json();
          
          // Fill in the form fields
          if (data.name) (document.getElementById('name')).value = data.name;
          if (data.race) (document.getElementById('race')).value = data.race;
          if (data.class) (document.getElementById('class')).value = data.class;
          if (data.level) (document.getElementById('level')).value = data.level;
          if (data.avatarUrl) (document.getElementById('avatarUrl')).value = data.avatarUrl;
          
          if (data.stats) {
            if (data.stats.strength) (document.getElementById('strength')).value = data.stats.strength;
            if (data.stats.dexterity) (document.getElementById('dexterity')).value = data.stats.dexterity;
            if (data.stats.constitution) (document.getElementById('constitution')).value = data.stats.constitution;
            if (data.stats.intelligence) (document.getElementById('intelligence')).value = data.stats.intelligence;
            if (data.stats.wisdom) (document.getElementById('wisdom')).value = data.stats.wisdom;
            if (data.stats.charisma) (document.getElementById('charisma')).value = data.stats.charisma;
          }
          
          // Fill in additional character details
          if (data.background) (document.getElementById('background')).value = data.background;
          if (data.alignment) (document.getElementById('alignment')).value = data.alignment;
          if (data.gender) (document.getElementById('gender')).value = data.gender;
          if (data.age) (document.getElementById('age')).value = data.age;
          if (data.height) (document.getElementById('height')).value = data.height;
          if (data.weight) (document.getElementById('weight')).value = data.weight;
          if (data.eyes) (document.getElementById('eyes')).value = data.eyes;
          if (data.skin) (document.getElementById('skin')).value = data.skin;
          if (data.hair) (document.getElementById('hair')).value = data.hair;
          
          // Show success status
          if (fetchStatus) {
            fetchStatus.textContent = '✓ Character data fetched successfully!';
            fetchStatus.className = 'p-3 rounded-lg mb-2 bg-green-100 text-green-800';
          }
        } else {
          const error = await response.json().catch(() => ({ error: 'Unknown error' }));
          if (fetchStatus) {
            fetchStatus.textContent = `Failed to fetch: ${error.error || 'Unknown error'}`;
            fetchStatus.className = 'p-3 rounded-lg mb-2 bg-red-100 text-red-800';
          }
        }
      } catch (error) {
        console.error('Fetch error:', error);
        if (fetchStatus) {
          fetchStatus.textContent = 'An error occurred. Please check the URL and try again.';
          fetchStatus.className = 'p-3 rounded-lg mb-2 bg-red-100 text-red-800';
        }
      }
    });

    // Check for edit parameter on page load and open modal if present
    const urlParams = new URLSearchParams(window.location.search);
    const editId = urlParams.get('edit');
    
    if (editId && modal && form && modalTitle) {
      (async () => {
        try {
          const response = await fetch(`/api/characters/${editId}`);
          if (!response.ok) {
            throw new Error('Character not found');
          }
          
          const character = await response.json();
          
          editingId = editId;
          (document.getElementById('name')).value = character.name;
          (document.getElementById('player')).value = character.player;
          (document.getElementById('race')).value = character.race;
          (document.getElementById('class')).value = character.class;
          (document.getElementById('level')).value = character.level;
          (document.getElementById('isActive')).checked = character.isActive !== false;
          (document.getElementById('avatarUrl')).value = character.avatarUrl || '';
          (document.getElementById('dndbeyondUrl')).value = character.dndbeyondUrl || '';
          
          if (character.stats) {
            (document.getElementById('strength')).value = character.stats.strength;
            (document.getElementById('dexterity')).value = character.stats.dexterity;
            (document.getElementById('constitution')).value = character.stats.constitution;
            (document.getElementById('intelligence')).value = character.stats.intelligence;
            (document.getElementById('wisdom')).value = character.stats.wisdom;
            (document.getElementById('charisma')).value = character.stats.charisma;
          }
          
          // Load additional character details
          (document.getElementById('background')).value = character.background || '';
          (document.getElementById('alignment')).value = character.alignment || '';
          (document.getElementById('gender')).value = character.gender || '';
          (document.getElementById('age')).value = character.age || '';
          (document.getElementById('height')).value = character.height || '';
          (document.getElementById('weight')).value = character.weight || '';
          (document.getElementById('eyes')).value = character.eyes || '';
          (document.getElementById('skin')).value = character.skin || '';
          (document.getElementById('hair')).value = character.hair || '';
          
          modalTitle.textContent = 'Edit Character';
          // Hide "Assign to me" checkbox when editing
          const assignToMeContainer = document.getElementById('assignToMeContainer');
          if (assignToMeContainer) {
            assignToMeContainer.classList.add('hidden');
            assignToMeContainer.classList.remove('flex');
          }
          modal.classList.remove('hidden');
          
          // Clear the URL parameter so refreshing doesn't re-open the modal
          window.history.replaceState({}, '', '/characters');
        } catch (error) {
          console.error('Failed to load character for editing:', error);
          alert('Failed to load character. Please try again.');
        }
      })();
    }
  }

  // Handle character edit/delete actions with event delegation
  document.addEventListener('click', async (e) => {
    const target = e.target;
    const modal = document.getElementById('characterModal');
    const modalTitle = document.getElementById('modalTitle');
    
    // Edit character
    if (target.classList.contains('edit-character')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      try {
        const response = await fetch(`/api/characters/${id}`);
        if (!response.ok) {
          throw new Error('Failed to fetch character');
        }
        const character = await response.json();
        
        editingId = id;
        (document.getElementById('name')).value = character.name;
        (document.getElementById('player')).value = character.player;
        (document.getElementById('race')).value = character.race;
        (document.getElementById('class')).value = character.class;
        (document.getElementById('level')).value = character.level;
        (document.getElementById('isActive')).checked = character.isActive !== false;
        (document.getElementById('avatarUrl')).value = character.avatarUrl || '';
        (document.getElementById('dndbeyondUrl')).value = character.dndbeyondUrl || '';
        
        if (character.stats) {
          (document.getElementById('strength')).value = character.stats.strength;
          (document.getElementById('dexterity')).value = character.stats.dexterity;
          (document.getElementById('constitution')).value = character.stats.constitution;
          (document.getElementById('intelligence')).value = character.stats.intelligence;
          (document.getElementById('wisdom')).value = character.stats.wisdom;
          (document.getElementById('charisma')).value = character.stats.charisma;
        }
        
        // Load additional character details
        (document.getElementById('background')).value = character.background || '';
        (document.getElementById('alignment')).value = character.alignment || '';
        (document.getElementById('gender')).value = character.gender || '';
        (document.getElementById('age')).value = character.age || '';
        (document.getElementById('height')).value = character.height || '';
        (document.getElementById('weight')).value = character.weight || '';
        (document.getElementById('eyes')).value = character.eyes || '';
        (document.getElementById('skin')).value = character.skin || '';
        (document.getElementById('hair')).value = character.hair || '';
        
        if (modalTitle) modalTitle.textContent = 'Edit Character';
        // Hide "Assign to me" checkbox when editing
        const assignToMeContainer = document.getElementById('assignToMeContainer');
        if (assignToMeContainer) {
          assignToMeContainer.classList.add('hidden');
          assignToMeContainer.classList.remove('flex');
        }
        modal?.classList.remove('hidden');
      } catch (error) {
        console.error('Failed to load character:', error);
        alert('Failed to load character. Please try again.');
      }
    }
    
    // Delete character
    if (target.classList.contains('delete-character')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      if (confirm('Are you sure you want to delete this character?')) {
        try {
          const response = await fetch(`/api/characters/${id}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete character. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    }
  });

  // Initialize search and filter functionality
  function initializeFilters() {
    const searchInput = document.getElementById('searchInput');
    const filterActive = document.getElementById('filterActive');
    const filterInactive = document.getElementById('filterInactive');
    const filterAll = document.getElementById('filterAll');
    const characterCards = document.querySelectorAll('.character-card');
    
    // Storage keys for persisting search and filter
    const SEARCH_STORAGE_KEY = 'characters_search';
    const FILTER_STORAGE_KEY = 'characters_filter';
    
    let currentFilter = localStorage.getItem(FILTER_STORAGE_KEY) || 'active';
    
    const updateFilterButtons = (filter) => {
      // Reset all buttons to inactive state
      [filterActive, filterInactive, filterAll].forEach(btn => {
        if (btn) {
          btn.classList.remove('bg-primary-600', 'text-white', 'hover:bg-primary-700');
          btn.classList.add('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300', 'hover:bg-gray-300', 'dark:hover:bg-gray-600', 'hover:shadow-md');
          btn.setAttribute('data-active', 'false');
        }
      });
      
      // Activate the selected button
      let activeButton = filterActive;
      if (filter === 'inactive') activeButton = filterInactive;
      if (filter === 'all') activeButton = filterAll;
      
      if (activeButton) {
        activeButton.classList.remove('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300', 'hover:bg-gray-300', 'dark:hover:bg-gray-600', 'hover:shadow-md');
        activeButton.classList.add('bg-primary-600', 'text-white', 'hover:bg-primary-700');
        activeButton.setAttribute('data-active', 'true');
      }
    };
    
    const applyFilters = (searchText, filter) => {
      const searchTerms = searchText.toLowerCase().split(/\s+/).filter(term => term.length > 0);
      characterCards.forEach(card => {
        const searchData = card.getAttribute('data-search') || '';
        const isActive = card.getAttribute('data-is-active') === 'true';
        
        // Match if ANY search term is found in the text (more flexible search)
        const matchesSearch = searchTerms.length === 0 || searchTerms.some(term => searchData.includes(term));
        
        // Match based on active filter
        let matchesFilter = true;
        if (filter === 'active') {
          matchesFilter = isActive;
        } else if (filter === 'inactive') {
          matchesFilter = !isActive;
        }
        // 'all' filter matches everything
        
        (card).style.display = (matchesSearch && matchesFilter) ? 'block' : 'none';
      });
    };

    // Restore search text and filter from localStorage
    const savedSearch = localStorage.getItem(SEARCH_STORAGE_KEY) || '';
    if (searchInput) {
      searchInput.value = savedSearch;
    }
    updateFilterButtons(currentFilter);
    applyFilters(savedSearch, currentFilter);

    // Search functionality with localStorage persistence
    searchInput?.addEventListener('input', (e) => {
      const searchText = (e.target).value;
      localStorage.setItem(SEARCH_STORAGE_KEY, searchText);
      applyFilters(searchText, currentFilter);
    });
    
    // Filter button handlers
    filterActive?.addEventListener('click', () => {
      currentFilter = 'active';
      localStorage.setItem(FILTER_STORAGE_KEY, currentFilter);
      updateFilterButtons(currentFilter);
      applyFilters(searchInput?.value || '', currentFilter);
    });
    
    filterInactive?.addEventListener('click', () => {
      currentFilter = 'inactive';
      localStorage.setItem(FILTER_STORAGE_KEY, currentFilter);
      updateFilterButtons(currentFilter);
      applyFilters(searchInput?.value || '', currentFilter);
    });
    
    filterAll?.addEventListener('click', () => {
      currentFilter = 'all';
      localStorage.setItem(FILTER_STORAGE_KEY, currentFilter);
      updateFilterButtons(currentFilter);
      applyFilters(searchInput?.value || '', currentFilter);
    });
  }

  // Run on initial page load and after View Transitions navigation
  document.addEventListener('astro:page-load', () => {
    initializeCharacterModal();
    initializeFilters();
    initializeAutoSync();
  });
  
  // Auto-sync characters on page load
  async function initializeAutoSync() {
    // Get all character cards with D&D Beyond URLs
    const characterCards = document.querySelectorAll('[data-character-id]');
    
    for (const card of characterCards) {
      const characterId = card.getAttribute('data-character-id');
      const dndbeyondUrl = card.getAttribute('data-dndbeyond-url');
      
      // Only auto-sync if character has D&D Beyond URL
      if (!characterId || !dndbeyondUrl) continue;
      
      try {
        // Fire and forget - don't block page load
        fetch('/api/characters/auto-sync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ characterId }),
        }).then(response => response.json()).then(result => {
          // If character was updated, reload the page to show new data
          if (result.success && result.updated) {
            console.log(`Character ${characterId} was auto-synced with changes`);
            // Refresh page to show updated data
            window.location.reload();
          }
        }).catch(err => {
          // Silently fail - auto-sync is a nice-to-have
          console.debug('Auto-sync skipped for character', characterId, err);
        });
      } catch (error) {
        // Silently fail
        console.debug('Auto-sync error for character', characterId, error);
      }
    }

---
import Layout from '../layouts/Layout.astro';
import { db, Character } from 'astro:db';
import { isAuthenticated } from '../lib/auth';

const characters = await db.select().from(Character);
const isLoggedIn = isAuthenticated(Astro.cookies);

// Get the edit parameter from URL if present
const editCharacterId = Astro.url.searchParams.get('edit');
---

<Layout title="Player Characters">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold text-primary-700">Player Characters</h1>
    {isLoggedIn && (
      <button 
        id="addCharacter"
        class="bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 transition"
      >
        + Add Character
      </button>
    )}
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {characters.map(character => (
      <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
        <a href={`/characters/${character.id}`} class="block">
          <div class="bg-gradient-to-r from-primary-600 to-secondary-600 h-24 flex items-center justify-center">
            {character.avatarUrl ? (
              <img 
                src={character.avatarUrl} 
                alt={character.name}
                class="w-16 h-16 rounded-full object-cover border-2 border-white"
              />
            ) : (
              <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center text-3xl">
                {character.name.charAt(0)}
              </div>
            )}
          </div>
        </a>
        
        <div class="p-6">
          <a href={`/characters/${character.id}`} class="block hover:text-primary-700 transition">
            <h2 class="text-2xl font-bold text-gray-900 mb-2">{character.name}</h2>
          </a>
          <p class="text-gray-600 mb-4">{character.race} {character.class}</p>
          
          <div class="grid grid-cols-2 gap-3 mb-4">
            <div class="bg-primary-50 p-3 rounded">
              <div class="text-sm text-gray-600">Level</div>
              <div class="text-xl font-bold text-primary-700">{character.level}</div>
            </div>
            <div class="bg-primary-50 p-3 rounded">
              <div class="text-sm text-gray-600">Player</div>
              <div class="text-lg font-semibold text-primary-700">{character.player}</div>
            </div>
          </div>

          {character.stats && (
            <div class="border-t pt-4">
              <h3 class="font-semibold mb-3">Ability Scores</h3>
              <div class="grid grid-cols-3 gap-2 text-center">
                <div class="bg-gray-50 p-2 rounded">
                  <div class="text-xs text-gray-500">STR</div>
                  <div class="font-bold">{character.stats.strength}</div>
                </div>
                <div class="bg-gray-50 p-2 rounded">
                  <div class="text-xs text-gray-500">DEX</div>
                  <div class="font-bold">{character.stats.dexterity}</div>
                </div>
                <div class="bg-gray-50 p-2 rounded">
                  <div class="text-xs text-gray-500">CON</div>
                  <div class="font-bold">{character.stats.constitution}</div>
                </div>
                <div class="bg-gray-50 p-2 rounded">
                  <div class="text-xs text-gray-500">INT</div>
                  <div class="font-bold">{character.stats.intelligence}</div>
                </div>
                <div class="bg-gray-50 p-2 rounded">
                  <div class="text-xs text-gray-500">WIS</div>
                  <div class="font-bold">{character.stats.wisdom}</div>
                </div>
                <div class="bg-gray-50 p-2 rounded">
                  <div class="text-xs text-gray-500">CHA</div>
                  <div class="font-bold">{character.stats.charisma}</div>
                </div>
              </div>
            </div>
          )}

          <a 
            href={`/characters/${character.id}`}
            class="block mt-4 text-center bg-accent-100 text-accent-700 px-4 py-2 rounded hover:bg-accent-200 transition font-medium"
          >
            View Details →
          </a>

          {isLoggedIn && (
            <div class="mt-2 flex gap-2">
              <button class="edit-character flex-1 bg-primary-600 text-white px-4 py-2 rounded hover:bg-primary-700 transition" data-id={character.id}>
                Edit
              </button>
              <button class="delete-character px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 transition" data-id={character.id}>
                Delete
              </button>
            </div>
          )}

          {character.dndbeyondUrl && (
            <a 
              href={character.dndbeyondUrl}
              target="_blank"
              class="block mt-2 text-center text-sm text-primary-600 hover:text-primary-800"
            >
              View on D&D Beyond →
            </a>
          )}
        </div>
      </div>
    ))}
  </div>

  <div class="mt-8 bg-blue-50 border-l-4 border-blue-500 p-4 rounded">
    <h3 class="font-semibold text-blue-900 mb-2">💡 D&D Beyond Integration</h3>
    <p class="text-sm text-blue-800">
      You can import character data from D&D Beyond by providing the character URL or using the API endpoint.
      This feature allows automatic synchronization of character stats, levels, and equipment.
    </p>
  </div>

  <!-- Modal for Add/Edit Character -->
  <div id="characterModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg p-8 max-w-4xl w-full mx-4 max-h-[90vh] overflow-y-auto">
      <h2 id="modalTitle" class="text-2xl font-bold mb-6 text-primary-700">New Character</h2>
      <form id="characterForm" class="space-y-4">
        <input type="hidden" id="characterId" name="id">
        
        <div class="mb-4 p-4 bg-blue-50 border border-blue-200 rounded-lg">
          <p class="text-sm text-blue-800">
            💡 <strong>Tip:</strong> You can either fill out the form manually OR use the D&D Beyond Auto-fill feature. Just provide the D&D Beyond URL and click "Auto-fill" to populate the fields automatically.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
          </div>
          
          <div>
            <label for="player" class="block text-sm font-medium text-gray-700 mb-1">Player</label>
            <input 
              type="text" 
              id="player" 
              name="player" 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
          </div>
        </div>
        
        <div class="grid grid-cols-3 gap-4">
          <div>
            <label for="race" class="block text-sm font-medium text-gray-700 mb-1">Race</label>
            <input 
              type="text" 
              id="race" 
              name="race" 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
          </div>
          
          <div>
            <label for="class" class="block text-sm font-medium text-gray-700 mb-1">Class</label>
            <input 
              type="text" 
              id="class" 
              name="class" 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
          </div>
          
          <div>
            <label for="level" class="block text-sm font-medium text-gray-700 mb-1">Level</label>
            <input 
              type="number" 
              id="level" 
              name="level" 
              min="1"
              max="20"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="avatarUrl" class="block text-sm font-medium text-gray-700 mb-1">Avatar URL (optional)</label>
            <input 
              type="url" 
              id="avatarUrl" 
              name="avatarUrl" 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
          </div>
          
          <div>
            <label for="dndbeyondUrl" class="block text-sm font-medium text-gray-700 mb-1">D&D Beyond URL (optional)</label>
            <div class="flex gap-2">
              <input 
                type="url" 
                id="dndbeyondUrl" 
                name="dndbeyondUrl" 
                class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                placeholder="https://www.dndbeyond.com/characters/..."
              >
              <button 
                type="button"
                id="fetchFromDndBeyond"
                class="bg-secondary-600 text-white px-4 py-2 rounded-lg hover:bg-secondary-700 transition whitespace-nowrap"
                title="Fetch character data from D&D Beyond"
              >
                Auto-fill
              </button>
            </div>
          </div>
        </div>
        
        <div id="fetchStatus" class="hidden p-3 rounded-lg mb-2"></div>
        
        <div>
          <h3 class="font-semibold mb-2">Ability Scores</h3>
          <div class="grid grid-cols-6 gap-2">
            <div>
              <label for="strength" class="block text-xs text-gray-600 mb-1">STR</label>
              <input 
                type="number" 
                id="strength" 
                name="strength" 
                min="1"
                max="30"
                class="w-full px-2 py-1 border border-gray-300 rounded focus:ring-2 focus:ring-primary-500 focus:border-transparent"
              >
            </div>
            <div>
              <label for="dexterity" class="block text-xs text-gray-600 mb-1">DEX</label>
              <input 
                type="number" 
                id="dexterity" 
                name="dexterity" 
                min="1"
                max="30"
                class="w-full px-2 py-1 border border-gray-300 rounded focus:ring-2 focus:ring-primary-500 focus:border-transparent"
              >
            </div>
            <div>
              <label for="constitution" class="block text-xs text-gray-600 mb-1">CON</label>
              <input 
                type="number" 
                id="constitution" 
                name="constitution" 
                min="1"
                max="30"
                class="w-full px-2 py-1 border border-gray-300 rounded focus:ring-2 focus:ring-primary-500 focus:border-transparent"
              >
            </div>
            <div>
              <label for="intelligence" class="block text-xs text-gray-600 mb-1">INT</label>
              <input 
                type="number" 
                id="intelligence" 
                name="intelligence" 
                min="1"
                max="30"
                class="w-full px-2 py-1 border border-gray-300 rounded focus:ring-2 focus:ring-primary-500 focus:border-transparent"
              >
            </div>
            <div>
              <label for="wisdom" class="block text-xs text-gray-600 mb-1">WIS</label>
              <input 
                type="number" 
                id="wisdom" 
                name="wisdom" 
                min="1"
                max="30"
                class="w-full px-2 py-1 border border-gray-300 rounded focus:ring-2 focus:ring-primary-500 focus:border-transparent"
              >
            </div>
            <div>
              <label for="charisma" class="block text-xs text-gray-600 mb-1">CHA</label>
              <input 
                type="number" 
                id="charisma" 
                name="charisma" 
                min="1"
                max="30"
                class="w-full px-2 py-1 border border-gray-300 rounded focus:ring-2 focus:ring-primary-500 focus:border-transparent"
              >
            </div>
          </div>
        </div>
        
        <div class="flex gap-4 pt-4">
          <button 
            type="submit" 
            class="flex-1 bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 transition"
          >
            Save Character
          </button>
          <button 
            type="button" 
            id="cancelModal"
            class="flex-1 bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 transition"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  const modal = document.getElementById('characterModal');
  const form = document.getElementById('characterForm') as HTMLFormElement;
  const modalTitle = document.getElementById('modalTitle');
  const addButton = document.getElementById('addCharacter');
  const cancelButton = document.getElementById('cancelModal');

  let editingId: string | null = null;

  // Open modal for new character
  addButton?.addEventListener('click', () => {
    editingId = null;
    form.reset();
    if (modalTitle) modalTitle.textContent = 'New Character';
    modal?.classList.remove('hidden');
  });

  // Close modal
  cancelButton?.addEventListener('click', () => {
    modal?.classList.add('hidden');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
    }
  });

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    
    // Validate that required fields are filled
    const name = formData.get('name') as string;
    const player = formData.get('player') as string;
    const race = formData.get('race') as string;
    const className = formData.get('class') as string;
    const level = formData.get('level') as string;
    
    // Check if required fields are empty
    if (!name || !player || !race || !className || !level) {
      alert('Please fill out all required fields (Name, Player, Race, Class, Level) or use the D&D Beyond Auto-fill feature.');
      return;
    }
    
    const stats = {
      strength: parseInt(formData.get('strength') as string) || 10,
      dexterity: parseInt(formData.get('dexterity') as string) || 10,
      constitution: parseInt(formData.get('constitution') as string) || 10,
      intelligence: parseInt(formData.get('intelligence') as string) || 10,
      wisdom: parseInt(formData.get('wisdom') as string) || 10,
      charisma: parseInt(formData.get('charisma') as string) || 10,
    };
    
    const data = {
      name,
      player,
      race,
      class: className,
      level: parseInt(level),
      avatarUrl: formData.get('avatarUrl') || undefined,
      dndbeyondUrl: formData.get('dndbeyondUrl') || undefined,
      stats,
    };

    try {
      const url = editingId ? `/api/characters/${editingId}` : '/api/characters';
      const method = editingId ? 'PUT' : 'POST';
      
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        alert('Failed to save character. Please try again.');
      }
    } catch (error) {
      alert('An error occurred. Please try again.');
    }
  });

  // Edit character
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    
    if (target.classList.contains('edit-character')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      try {
        const response = await fetch(`/api/characters/${id}`);
        const character = await response.json();
        
        editingId = id;
        (document.getElementById('name') as HTMLInputElement).value = character.name;
        (document.getElementById('player') as HTMLInputElement).value = character.player;
        (document.getElementById('race') as HTMLInputElement).value = character.race;
        (document.getElementById('class') as HTMLInputElement).value = character.class;
        (document.getElementById('level') as HTMLInputElement).value = character.level;
        (document.getElementById('avatarUrl') as HTMLInputElement).value = character.avatarUrl || '';
        (document.getElementById('dndbeyondUrl') as HTMLInputElement).value = character.dndbeyondUrl || '';
        
        if (character.stats) {
          (document.getElementById('strength') as HTMLInputElement).value = character.stats.strength;
          (document.getElementById('dexterity') as HTMLInputElement).value = character.stats.dexterity;
          (document.getElementById('constitution') as HTMLInputElement).value = character.stats.constitution;
          (document.getElementById('intelligence') as HTMLInputElement).value = character.stats.intelligence;
          (document.getElementById('wisdom') as HTMLInputElement).value = character.stats.wisdom;
          (document.getElementById('charisma') as HTMLInputElement).value = character.stats.charisma;
        }
        
        if (modalTitle) modalTitle.textContent = 'Edit Character';
        modal?.classList.remove('hidden');
      } catch (error) {
        alert('Failed to load character. Please try again.');
      }
    }
    
    // Delete character
    if (target.classList.contains('delete-character')) {
      const id = target.getAttribute('data-id');
      if (!id) return;
      
      if (confirm('Are you sure you want to delete this character?')) {
        try {
          const response = await fetch(`/api/characters/${id}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete character. Please try again.');
          }
        } catch (error) {
          alert('An error occurred. Please try again.');
        }
      }
    }
  });

  // Fetch character data from D&D Beyond
  const fetchButton = document.getElementById('fetchFromDndBeyond');
  const fetchStatus = document.getElementById('fetchStatus');
  
  fetchButton?.addEventListener('click', async () => {
    const urlInput = document.getElementById('dndbeyondUrl') as HTMLInputElement;
    const url = urlInput.value.trim();
    
    if (!url) {
      alert('Please enter a D&D Beyond character URL first.');
      return;
    }
    
    // Show loading status
    if (fetchStatus) {
      fetchStatus.textContent = 'Fetching character data from D&D Beyond...';
      fetchStatus.className = 'p-3 rounded-lg mb-2 bg-blue-100 text-blue-800';
      fetchStatus.classList.remove('hidden');
    }
    
    try {
      const response = await fetch('/api/characters/dndbeyond', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url }),
      });
      
      if (response.ok) {
        const data = await response.json();
        
        // Fill in the form fields
        if (data.name) (document.getElementById('name') as HTMLInputElement).value = data.name;
        if (data.race) (document.getElementById('race') as HTMLInputElement).value = data.race;
        if (data.class) (document.getElementById('class') as HTMLInputElement).value = data.class;
        if (data.level) (document.getElementById('level') as HTMLInputElement).value = data.level;
        if (data.avatarUrl) (document.getElementById('avatarUrl') as HTMLInputElement).value = data.avatarUrl;
        
        if (data.stats) {
          if (data.stats.strength) (document.getElementById('strength') as HTMLInputElement).value = data.stats.strength;
          if (data.stats.dexterity) (document.getElementById('dexterity') as HTMLInputElement).value = data.stats.dexterity;
          if (data.stats.constitution) (document.getElementById('constitution') as HTMLInputElement).value = data.stats.constitution;
          if (data.stats.intelligence) (document.getElementById('intelligence') as HTMLInputElement).value = data.stats.intelligence;
          if (data.stats.wisdom) (document.getElementById('wisdom') as HTMLInputElement).value = data.stats.wisdom;
          if (data.stats.charisma) (document.getElementById('charisma') as HTMLInputElement).value = data.stats.charisma;
        }
        
        // Show success status
        if (fetchStatus) {
          fetchStatus.textContent = '✓ Character data fetched successfully!';
          fetchStatus.className = 'p-3 rounded-lg mb-2 bg-green-100 text-green-800';
        }
      } else {
        const error = await response.json().catch(() => ({ error: 'Unknown error' }));
        if (fetchStatus) {
          fetchStatus.textContent = `Failed to fetch: ${error.error || 'Unknown error'}`;
          fetchStatus.className = 'p-3 rounded-lg mb-2 bg-red-100 text-red-800';
        }
      }
    } catch (error) {
      console.error('Fetch error:', error);
      if (fetchStatus) {
        fetchStatus.textContent = 'An error occurred. Please check the URL and try again.';
        fetchStatus.className = 'p-3 rounded-lg mb-2 bg-red-100 text-red-800';
      }
    }
  });

  // Check for edit parameter on page load and open modal if present
  (async () => {
    const urlParams = new URLSearchParams(window.location.search);
    const editId = urlParams.get('edit');
    
    if (editId && modal && form && modalTitle) {
      try {
        const response = await fetch(`/api/characters/${editId}`);
        if (!response.ok) {
          throw new Error('Character not found');
        }
        
        const character = await response.json();
        
        editingId = editId;
        (document.getElementById('name') as HTMLInputElement).value = character.name;
        (document.getElementById('player') as HTMLInputElement).value = character.player;
        (document.getElementById('race') as HTMLInputElement).value = character.race;
        (document.getElementById('class') as HTMLInputElement).value = character.class;
        (document.getElementById('level') as HTMLInputElement).value = character.level;
        (document.getElementById('avatarUrl') as HTMLInputElement).value = character.avatarUrl || '';
        (document.getElementById('dndbeyondUrl') as HTMLInputElement).value = character.dndbeyondUrl || '';
        
        if (character.stats) {
          (document.getElementById('strength') as HTMLInputElement).value = character.stats.strength;
          (document.getElementById('dexterity') as HTMLInputElement).value = character.stats.dexterity;
          (document.getElementById('constitution') as HTMLInputElement).value = character.stats.constitution;
          (document.getElementById('intelligence') as HTMLInputElement).value = character.stats.intelligence;
          (document.getElementById('wisdom') as HTMLInputElement).value = character.stats.wisdom;
          (document.getElementById('charisma') as HTMLInputElement).value = character.stats.charisma;
        }
        
        modalTitle.textContent = 'Edit Character';
        modal.classList.remove('hidden');
        
        // Clear the URL parameter so refreshing doesn't re-open the modal
        window.history.replaceState({}, '', '/characters');
      } catch (error) {
        console.error('Failed to load character for editing:', error);
        alert('Failed to load character. Please try again.');
      }
    }
  })();
</script>

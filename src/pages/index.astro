---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { db, DiaryEntry, Quest, Character, CampaignProgress, LibraryEntry, Faction, CombatState, Event, User } from 'astro:db';
import { getUserRole } from '../lib/auth';

// Dashboard is viewable by everyone, editable by dungeonmaster and admin
const userRole = await getUserRole(Astro.cookies);
const canEdit = userRole === 'admin' || userRole === 'dungeonmaster';

const diaryEntries = await db.select().from(DiaryEntry);
const quests = await db.select().from(Quest);
const characters = await db.select().from(Character);
const campaignProgressData = await db.select().from(CampaignProgress);
const libraryEntries = await db.select().from(LibraryEntry);
const factions = await db.select().from(Faction);
const events = await db.select().from(Event);
const users = await db.select().from(User);

// Get combat state
const combatStateData = await db.select().from(CombatState);
const combatState = combatStateData.length > 0 ? combatStateData[0] : null;

// Find next upcoming event
const now = new Date();
const upcomingEvents = events
  .filter(e => new Date(`${e.date}T${e.time}`) >= now)
  .sort((a, b) => {
    const dateTimeA = new Date(`${a.date}T${a.time}`).getTime();
    const dateTimeB = new Date(`${b.date}T${b.time}`).getTime();
    return dateTimeA - dateTimeB;
  });
const nextEvent = upcomingEvents.length > 0 ? upcomingEvents[0] : null;

// Helper to get host name
const getHostName = (hostId: string | null): string => {
  if (!hostId) return 'TBD';
  const host = users.find(u => u.id === hostId);
  return host ? (host.firstName || host.username) : 'Unknown';
};

// Helper to get host info including profile image
const getHostInfo = (hostId: string | null): { name: string, imageUrl: string | null } => {
  if (!hostId) {
    return {
      name: 'TBD',
      imageUrl: null
    };
  }
  const host = users.find(u => u.id === hostId);
  return {
    name: host ? (host.firstName || host.username) : 'Unknown',
    imageUrl: host?.profileImageUrl || null
  };
};

// Helper to format date
const formatDate = (dateStr: string): string => {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });
};

// Helper to format duration
const formatDuration = (minutes: number): string => {
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  if (hours > 0 && mins > 0) return `${hours}h ${mins}m`;
  if (hours > 0) return `${hours}h`;
  return `${mins}m`;
};

// Status to color mapping for progress bars
const statusToColor = (status: string): string => {
  switch(status) {
    case 'enemy': return 'bg-red-500';
    case 'suspicious': return 'bg-orange-500';
    case 'neutral': return 'bg-yellow-500';
    case 'friendly': return 'bg-green-500';
    case 'respectful': return 'bg-teal-500';
    default: return 'bg-gray-500';
  }
};

// Status to label
const statusLabel = (status: string): string => {
  return status.charAt(0).toUpperCase() + status.slice(1);
};

const campaignProgress = campaignProgressData.length > 0 ? campaignProgressData[0] : {
  id: '1',
  currentLevel: 1,
  progressPercent: 0,
};

const activeQuests = quests.filter(q => q.status === 'active');
const latestEntries = diaryEntries.slice().sort((a, b) => 
  b.session - a.session
).slice(0, 3);

const latestLibraryEntries = libraryEntries.slice().sort((a, b) => {
  const dateA = a.createdAt ? new Date(a.createdAt).getTime() : 0;
  const dateB = b.createdAt ? new Date(b.createdAt).getTime() : 0;
  return dateB - dateA;
}).slice(0, 3);

const isLoggedIn = !!userRole;

// Use progressPercent directly (0-100)
const progressPercentage = Math.min(100, Math.max(0, campaignProgress.progressPercent));
---

<Layout title="Dashboard">
  <!-- Hero Image Section -->
  {campaignProgress.heroImageUrl ? (
    <div class="relative mb-8 rounded-lg overflow-hidden shadow-lg">
      <img 
        src={campaignProgress.heroImageUrl} 
        alt="Campaign Hero"
        class="w-full h-64 md:h-80 lg:h-96 object-cover"
      />
      {canEdit && (
        <button 
            class="edit-hero-image-btn absolute top-4 right-4 px-3 py-2 bg-white/90 hover:bg-white dark:bg-gray-800/90 dark:hover:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-lg transition text-sm shadow-lg flex items-center gap-2"
            title="Edit hero image"
          >
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span>Edit</span>
          </button>
      )}
    </div>
  ) : (
    <div class="mb-8">
      <div class="flex justify-between items-center">
        <h1 class="text-4xl font-bold text-primary-700 dark:text-primary-400">Dashboard</h1>
        {canEdit && (
          <Button
              variant="primary"
              size="sm"
              icon="add"
              class="edit-hero-image-btn"
              title="Add hero image"
            >
              Add Hero Image
            </Button>
        )}
      </div>
    </div>
  )}

  <!-- Active Combat Indicator -->
  {isLoggedIn && (
    <div id="activeCombatIndicator" class="mb-8" style="display: none;">
      <a 
        href="/tools/initiative" 
        class="block bg-gradient-to-r from-red-600 to-orange-600 hover:from-red-700 hover:to-orange-700 dark:from-red-700 dark:to-orange-700 dark:hover:from-red-600 dark:hover:to-orange-600 rounded-lg shadow-lg p-4 transition-all transform hover:scale-[1.02]"
      >
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="bg-white/20 rounded-full p-2">
              <svg class="w-6 h-6 text-white animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-bold text-white">Combat Active</h3>
              <p class="text-sm text-white/90">Initiative tracker is running</p>
            </div>
          </div>
          <div class="text-white">
            <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </div>
        </div>
      </a>
    </div>
  )}

  <!-- Next Event Card -->
  {isLoggedIn && nextEvent && (
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900 mb-8">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-2xl font-semibold text-primary-600 dark:text-primary-400">Next Event</h2>
        <a href="/calendar" class="text-sm text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
          View Calendar →
        </a>
      </div>
      
      <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
        <h3 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{nextEvent.title}</h3>
        {nextEvent.description && (
          <p class="text-gray-700 dark:text-gray-300 mb-4">{nextEvent.description}</p>
        )}
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
          <div class="flex items-center gap-3 bg-white dark:bg-gray-800/50 rounded-lg p-3">
            <div class="flex-shrink-0 w-10 h-10 bg-primary-100 dark:bg-primary-900/40 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div>
              <div class="text-xs text-gray-500 dark:text-gray-400">Date</div>
              <div class="font-semibold text-gray-800 dark:text-gray-200">{formatDate(nextEvent.date)}</div>
            </div>
          </div>
          
          {nextEvent.time && (
            <div class="flex items-center gap-3 bg-white dark:bg-gray-800/50 rounded-lg p-3">
              <div class="flex-shrink-0 w-10 h-10 bg-secondary-100 dark:bg-secondary-900/40 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-secondary-600 dark:text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <div class="text-xs text-gray-500 dark:text-gray-400">Time & Duration</div>
                <div class="font-semibold text-gray-800 dark:text-gray-200">{nextEvent.time}{nextEvent.duration ? ` (${formatDuration(nextEvent.duration)})` : ''}</div>
              </div>
            </div>
          )}
          
          <div class="flex items-center gap-3 bg-white dark:bg-gray-800/50 rounded-lg p-3">
            <div class="flex-shrink-0 w-10 h-10 bg-accent-100 dark:bg-accent-900/40 rounded-full flex items-center justify-center overflow-hidden">
              {getHostInfo(nextEvent.hostId).imageUrl ? (
                <img 
                  src={getHostInfo(nextEvent.hostId).imageUrl} 
                  alt={getHostInfo(nextEvent.hostId).name}
                  class="w-full h-full object-cover"
                />
              ) : (
                <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              )}
            </div>
            <div>
              <div class="text-xs text-gray-500 dark:text-gray-400">Host</div>
              <div class="font-semibold text-gray-800 dark:text-gray-200">{getHostName(nextEvent.hostId)}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- Campaign Progress -->
  <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900 mb-8">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-2xl font-semibold text-primary-600 dark:text-primary-400">Campaign Progress</h2>
      {canEdit && (
        <Button
            variant="primary"
            size="sm"
            icon="edit"
            id="editProgressBtn"
            title="Edit campaign progress"
          >
            Edit Progress
          </Button>
      )}
    </div>
    
    <!-- Level Progress Bar -->
    <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Party Level Progress</span>
        <span class="text-xs text-gray-500 dark:text-gray-400">{Math.round(progressPercentage)}%</span>
      </div>
      <div class="flex items-center gap-4">
        <div class="flex-shrink-0 text-center">
          <div class="text-2xl font-bold text-primary-600 dark:text-primary-400">{campaignProgress.currentLevel}</div>
          <div class="text-xs text-gray-500 dark:text-gray-400">Level</div>
        </div>
        <div class="flex-1">
          <div class="w-full bg-gray-200 dark:bg-black rounded-full h-6 overflow-hidden">
            <div 
              class="bg-gradient-to-r from-primary-500 to-secondary-500 h-6 rounded-full transition-all duration-300 flex items-center justify-center"
              style={`width: ${progressPercentage}%`}
            >
              {progressPercentage > 15 && (
                <span class="text-xs font-medium text-white">{progressPercentage}%</span>
              )}
            </div>
          </div>
          <div class="flex justify-between mt-1">
            <span class="text-xs text-gray-500 dark:text-gray-400">0%</span>
            <span class="text-xs text-gray-500 dark:text-gray-400">100%</span>
          </div>
        </div>
        <div class="flex-shrink-0 text-center">
          <div class="text-2xl font-bold text-secondary-600 dark:text-secondary-400">{campaignProgress.currentLevel + 1}</div>
          <div class="text-xs text-gray-500 dark:text-gray-400">Next</div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">
    <!-- Latest Diary Entries Card -->
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900">
      <h2 class="text-2xl font-semibold mb-4 text-primary-600 dark:text-primary-400">Latest Diary</h2>
      <div class="space-y-3">
        {latestEntries.map(entry => (
          <a href={`/diary/${entry.id}`} class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-900/50 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-900 transition cursor-pointer">
            <div>
              <h3 class="font-semibold text-primary-700 dark:text-primary-400 hover:text-primary-900 dark:hover:text-primary-300">{entry.title}</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">{entry.content}</p>
            </div>
            <div class="text-right">
              <span class="text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">Session {entry.session}</span>
            </div>
          </a>
        ))}
      </div>
      <a href="/diary" class="block mt-4 text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
        View all diary →
      </a>
    </div>

    <!-- Party Members Card -->
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900">
      <h2 class="text-2xl font-semibold mb-4 text-primary-600 dark:text-primary-400">Active Characters</h2>
      <div class="space-y-3">
        {characters.filter(char => char.isActive !== false).map(char => (
          <a href={`/characters/${char.id}`} class="block overflow-hidden rounded-lg hover:shadow-md transition cursor-pointer group">
            <div class="relative h-24 overflow-hidden">
              {/* Character teaser image */}
              {char.avatarUrl ? (
                <img 
                  src={char.avatarUrl} 
                  alt={char.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              ) : (
                <div class="w-full h-full bg-gradient-to-r from-primary-500 to-secondary-500 flex items-center justify-center">
                  <span class="text-4xl font-bold text-white opacity-40">{char.name.charAt(0)}</span>
                </div>
              )}
              {/* Overlay gradient */}
              <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/50 to-transparent"></div>
              {/* Character info overlay */}
              <div class="absolute inset-0 flex items-center px-4">
                <div class="flex-1">
                  <h3 class="font-bold text-white text-lg drop-shadow-lg">{char.name}</h3>
                  <p class="text-sm text-white/90 drop-shadow-md">{char.race} {char.class}</p>
                  <div class="flex items-center gap-2 mt-1">
                    <span class="text-xs font-medium text-white bg-white/20 backdrop-blur-sm px-2 py-0.5 rounded">Level {char.level}</span>
                    <span class="text-xs text-white/80">{char.player}</span>
                  </div>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
      <a href="/characters" class="block mt-4 text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
        View all characters →
      </a>
    </div>

    <!-- Latest Library Entries Card -->
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900">
      <h2 class="text-2xl font-semibold mb-4 text-primary-600 dark:text-primary-400 flex items-center gap-2">
        Latest Library
      </h2>
      <div class="space-y-3">
        {latestLibraryEntries.map(entry => (
          <a href={`/library/${entry.id}`} class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-900/50 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-900 transition cursor-pointer">
            <div class="flex-1 min-w-0">
              <h3 class="font-semibold text-primary-700 dark:text-primary-400 hover:text-primary-900 dark:hover:text-primary-300">{entry.title}</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">{entry.content.substring(0, 80)}{entry.content.length > 80 ? '...' : ''}</p>
            </div>
          </a>
        ))}
      </div>
      <a href="/library" class="block mt-4 text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
        View all library →
      </a>
    </div>

    <!-- Active Quests Card -->
    <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900">
      <h2 class="text-2xl font-semibold mb-4 text-primary-600 dark:text-primary-400">Active Quests</h2>
      <div class="space-y-3">
        {activeQuests.map(quest => (
          <div class="border-l-4 border-primary-500 dark:border-primary-400 pl-4 py-2">
            <h3 class="font-semibold dark:text-gray-100">{quest.title}</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">{quest.description.substring(0, 80)}{quest.description.length > 80 ? '...' : ''}</p>
            <span class={`inline-block px-2 py-1 text-xs rounded mt-2 ${
              quest.priority === 'high' ? 'bg-red-100 text-red-700 dark:bg-red-900/20 dark:text-red-400' :
              quest.priority === 'medium' ? 'bg-secondary-100 text-secondary-700 dark:bg-secondary-900/20 dark:text-secondary-400' :
              'bg-green-100 text-green-700 dark:bg-green-900/20 dark:text-green-400'
            }`}>
              {quest.priority}
            </span>
          </div>
        ))}
      </div>
      <a href="/quests" class="block mt-4 text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
        View all quests →
      </a>
    </div>
  </div>

  <!-- Faction Standings -->
  <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900 mb-8">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-2xl font-semibold text-primary-600 dark:text-primary-400">Faction Standings</h2>
      {canEdit && (
        <Button
            variant="primary"
            size="sm"
            icon="add"
            id="addFactionBtn"
            title="Add new faction"
          >
            Add Faction
          </Button>
      )}
    </div>
    
    <!-- Status Legend -->
    <div class="flex flex-wrap gap-2 mb-4 text-xs">
      <span class="flex items-center gap-1"><span class="w-3 h-3 bg-red-500 rounded"></span> Enemy</span>
      <span class="flex items-center gap-1"><span class="w-3 h-3 bg-orange-500 rounded"></span> Suspicious</span>
      <span class="flex items-center gap-1"><span class="w-3 h-3 bg-yellow-500 rounded"></span> Neutral</span>
      <span class="flex items-center gap-1"><span class="w-3 h-3 bg-green-500 rounded"></span> Friendly</span>
      <span class="flex items-center gap-1"><span class="w-3 h-3 bg-teal-500 rounded"></span> Respectful</span>
    </div>
    
    {factions.length === 0 ? (
      <p class="text-gray-500 dark:text-gray-400 text-center py-4">No factions tracked yet. Add your first faction to begin tracking relationships!</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {factions.map(faction => (
          <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg faction-item" data-faction-id={faction.id}>
            <div class="flex items-center justify-between mb-2">
              <span class="font-medium text-gray-700 dark:text-gray-300">{faction.name}</span>
              <div class="flex items-center gap-2">
                <span class="text-xs text-gray-500 dark:text-gray-400">{faction.progress}%</span>
                {canEdit && (
                  <button 
                    class="edit-faction-btn text-gray-600 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400"
                    data-faction-id={faction.id}
                    data-faction-name={faction.name}
                    data-faction-status={faction.status}
                    data-faction-progress={faction.progress}
                  >
                    <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                  </button>
                )}
                {canEdit && (
                  <button 
                    class="delete-faction-btn text-gray-600 hover:text-red-600 dark:text-gray-400 dark:hover:text-red-400"
                    data-faction-id={faction.id}
                  >
                    <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                  </button>
                )}
              </div>
            </div>
            <div class="w-full bg-gray-200 dark:bg-black rounded-full h-4 overflow-hidden">
              <div 
                class={`${statusToColor(faction.status)} h-4 rounded-full transition-all duration-300`}
                style={`width: ${faction.progress}%`}
              >
              </div>
            </div>
            <div class="flex justify-between mt-1 text-xs text-gray-500 dark:text-gray-400">
              <span>0%</span>
              <span>50%</span>
              <span>100%</span>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>

  <!-- Campaign Progress -->
  <div class="bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900 mb-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="text-center p-4 bg-primary-50 dark:bg-primary-900/20 dark:border dark:border-primary-800 rounded">
        <div class="text-3xl font-bold text-primary-600 dark:text-primary-500">{diaryEntries.length}</div>
        <div class="text-sm text-gray-600 dark:text-gray-400">Sessions Played</div>
      </div>
      <div class="text-center p-4 bg-accent-50 dark:bg-accent-900/20 dark:border dark:border-accent-800 rounded">
        <div class="text-3xl font-bold text-accent-600 dark:text-accent-500">{quests.length}</div>
        <div class="text-sm text-gray-600 dark:text-gray-400">Total Quests</div>
      </div>
      <div class="text-center p-4 bg-green-50 dark:bg-green-900/20 dark:border dark:border-green-800 rounded">
        <div class="text-3xl font-bold text-green-600 dark:text-green-500">{characters.filter(c => c.isActive !== false).length}</div>
        <div class="text-sm text-gray-600 dark:text-gray-400">Active Characters</div>
      </div>
      <div class="text-center p-4 bg-secondary-50 dark:bg-secondary-900/20 dark:border dark:border-secondary-800 rounded">
        <div class="text-3xl font-bold text-secondary-600 dark:text-secondary-500">{characters.length > 0 ? (characters.reduce((sum, c) => sum + c.level, 0) / characters.length).toFixed(1) : 0}</div>
        <div class="text-sm text-gray-600 dark:text-gray-400">Average Level</div>
      </div>
    </div>
  </div>

  <!-- Edit Progress Modal -->
  {canEdit && (
    <div id="editProgressModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4 modal-overlay-safe">
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-md w-full p-6 dark:border dark:border-gray-700 modal-content-safe">
        <div class="flex justify-between items-center mb-6">
          <h3 class="text-xl font-semibold text-primary-700 dark:text-primary-400">Edit Campaign Progress</h3>
          <button id="closeModalBtn" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
            <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        
        <form id="editProgressForm" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Current Level
            </label>
            <input 
              type="number" 
              id="currentLevel" 
              name="currentLevel" 
              value={campaignProgress.currentLevel}
              min="1"
              max="20"
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-gray-100"
              required
            />
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Progress to Next Level (%)
            </label>
            <input 
              type="number" 
              id="progressPercent" 
              name="progressPercent" 
              value={campaignProgress.progressPercent}
              min="0"
              max="100"
              step="10"
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-gray-100"
              required
            />
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Enter in steps of 10 (0, 10, 20, ..., 100)</p>
          </div>
          
          <div class="flex gap-3 pt-4">
            <button 
              type="submit" 
              class="flex-1 bg-primary-600 hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 text-white px-4 py-2 rounded-lg transition"
            >
              Save Changes
            </button>
            <button 
              type="button" 
              id="cancelBtn"
              class="flex-1 bg-gray-300 hover:bg-gray-400 dark:bg-gray-600 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 px-4 py-2 rounded-lg transition"
            >
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>
  )}

  <!-- Hero Image Modal -->
  {canEdit && (
    <div id="heroImageModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4 modal-overlay-safe">
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-md w-full p-6 dark:border dark:border-gray-700 modal-content-safe">
        <div class="flex justify-between items-center mb-6">
          <h3 class="text-xl font-semibold text-primary-700 dark:text-primary-400">Hero Image</h3>
          <button id="closeHeroImageModalBtn" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
            <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        
        <form id="heroImageForm" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Upload Hero Image
            </label>
            <input 
              type="file" 
              accept="image/*"
              id="heroImageFile"
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-gray-100 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-primary-50 file:text-primary-700 hover:file:bg-primary-100 dark:file:bg-primary-900/20 dark:file:text-primary-400"
            />
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Upload an image file (max 5MB)</p>
          </div>
          
          <div class="relative">
            <div class="absolute inset-0 flex items-center">
              <div class="w-full border-t border-gray-300 dark:border-gray-600"></div>
            </div>
            <div class="relative flex justify-center text-sm">
              <span class="px-2 bg-white dark:bg-gray-800 text-gray-500 dark:text-gray-400">OR</span>
            </div>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Hero Image URL
            </label>
            <input 
              type="text" 
              id="heroImageUrl" 
              name="heroImageUrl" 
              value={campaignProgress.heroImageUrl || ''}
              placeholder="https://example.com/hero-image.jpg or /uploads/image.jpg"
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-gray-100"
            />
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Or provide an image URL (absolute or relative)</p>
          </div>
          
          <div class="flex gap-3 pt-4">
            <button 
              type="submit"
              id="heroImageSubmitBtn"
              class="flex-1 bg-primary-600 hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 text-white px-4 py-2 rounded-lg transition"
            >
              <span id="heroImageSubmitText">Save</span>
              <span id="heroImageSubmitLoading" class="hidden">
                <svg class="animate-spin inline-block h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Uploading...
              </span>
            </button>
            <button 
              type="button" 
              id="cancelHeroImageBtn"
              class="flex-1 bg-gray-300 hover:bg-gray-400 dark:bg-gray-600 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 px-4 py-2 rounded-lg transition"
            >
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>
  )}

  <!-- Faction Modal (Add/Edit) -->
  {canEdit && (
    <div id="factionModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4 modal-overlay-safe">
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-md w-full p-6 dark:border dark:border-gray-700 modal-content-safe">
        <div class="flex justify-between items-center mb-6">
          <h3 id="factionModalTitle" class="text-xl font-semibold text-primary-700 dark:text-primary-400">Add Faction</h3>
          <button id="closeFactionModalBtn" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
            <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        
        <form id="factionForm" class="space-y-4">
          <input type="hidden" id="factionId" name="factionId" value="" />
          
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Faction Name
            </label>
            <input 
              type="text" 
              id="factionName" 
              name="factionName" 
              placeholder="Enter faction name"
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-gray-100"
              required
            />
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Status
            </label>
            <select 
              id="factionStatus" 
              name="factionStatus"
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-gray-100"
              required
            >
              <option value="enemy">Enemy</option>
              <option value="suspicious">Suspicious</option>
              <option value="neutral" selected>Neutral</option>
              <option value="friendly">Friendly</option>
              <option value="respectful">Respectful</option>
            </select>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Progress (<span id="progressValue">50</span>%)
            </label>
            <input 
              type="range" 
              id="factionProgress" 
              name="factionProgress" 
              min="0"
              max="100"
              value="50"
              class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer dark:bg-gray-700"
            />
            <div class="flex justify-between text-xs text-gray-500 dark:text-gray-400 mt-1">
              <span>0%</span>
              <span>50%</span>
              <span>100%</span>
            </div>
          </div>
          
          <div class="flex gap-3 pt-4">
            <button 
              type="submit" 
              class="flex-1 bg-primary-600 hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 text-white px-4 py-2 rounded-lg transition"
            >
              Save
            </button>
            <button 
              type="button" 
              id="cancelFactionBtn"
              class="flex-1 bg-gray-300 hover:bg-gray-400 dark:bg-gray-600 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 px-4 py-2 rounded-lg transition"
            >
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>
  )}

  <script define:vars={{ campaignProgressId: campaignProgress.id, isLoggedIn }}>
    let combatPollingInterval = null;

    // Poll combat state to show/hide indicator
    async function checkCombatStatus() {
      if (!isLoggedIn) return;
      
      try {
        const response = await fetch('/api/combat-state');
        if (response.ok) {
          const data = await response.json();
          const indicator = document.getElementById('activeCombatIndicator');
          
          if (data.status === 'active' && indicator) {
            indicator.style.display = 'block';
          } else {
            if (indicator) {
              indicator.style.display = 'none';
            }
            // Stop polling if combat is not active
            if (data.status !== 'active' && combatPollingInterval) {
              clearInterval(combatPollingInterval);
              combatPollingInterval = null;
            }
          }
        }
      } catch (error) {
        console.error('Error checking combat status:', error);
      }
    }

    // Initialize dashboard modals and forms
    function initializeDashboard() {
      // Check combat status immediately and set up polling
      if (isLoggedIn) {
        checkCombatStatus();
        
        // Clear any existing interval
        if (combatPollingInterval) {
          clearInterval(combatPollingInterval);
        }
        
        // Poll every 5 seconds
        combatPollingInterval = setInterval(checkCombatStatus, 5000);
      }
      // Campaign Progress Modal controls
      const editBtn = document.getElementById('editProgressBtn');
      const modal = document.getElementById('editProgressModal');
      const closeBtn = document.getElementById('closeModalBtn');
      const cancelBtn = document.getElementById('cancelBtn');
      const form = document.getElementById('editProgressForm');

      editBtn?.addEventListener('click', () => {
        modal?.classList.remove('hidden');
      });

      const closeModal = () => {
        modal?.classList.add('hidden');
      };

      closeBtn?.addEventListener('click', closeModal);
      cancelBtn?.addEventListener('click', closeModal);

      // Close modal on background click
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });

      // Handle form submission
      form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const data = {
        currentLevel: parseInt(formData.get('currentLevel')),
        progressPercent: parseInt(formData.get('progressPercent')),
      };

      try {
        const response = await fetch(`/api/campaign-progress/${campaignProgressId}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Failed to update campaign progress');
        }
      } catch (error) {
        console.error('Error updating campaign progress:', error);
        alert('Failed to update campaign progress');
      }
    });

      // Hero Image Modal controls
      const editHeroImageBtns = document.querySelectorAll('.edit-hero-image-btn');
      const heroImageModal = document.getElementById('heroImageModal');
      const closeHeroImageModalBtn = document.getElementById('closeHeroImageModalBtn');
      const cancelHeroImageBtn = document.getElementById('cancelHeroImageBtn');
      const heroImageForm = document.getElementById('heroImageForm');

      editHeroImageBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          heroImageModal?.classList.remove('hidden');
        });
      });

      const closeHeroImageModal = () => {
        heroImageModal?.classList.add('hidden');
      };

      closeHeroImageModalBtn?.addEventListener('click', closeHeroImageModal);
      cancelHeroImageBtn?.addEventListener('click', closeHeroImageModal);

      // Close modal on background click
      heroImageModal?.addEventListener('click', (e) => {
        if (e.target === heroImageModal) {
          closeHeroImageModal();
        }
      });

      // Handle hero image form submission
      heroImageForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const fileInput = document.getElementById('heroImageFile');
        const urlInput = document.getElementById('heroImageUrl');
        const submitBtn = document.getElementById('heroImageSubmitBtn');
        const submitText = document.getElementById('heroImageSubmitText');
        const submitLoading = document.getElementById('heroImageSubmitLoading');
        
        let heroImageUrl = urlInput?.value || null;

        // Show loading state
        if (submitBtn) submitBtn.disabled = true;
        if (submitText) submitText.classList.add('hidden');
        if (submitLoading) submitLoading.classList.remove('hidden');

        try {
          // If a file was selected, upload it first
          if (fileInput?.files && fileInput.files.length > 0) {
            const uploadFormData = new FormData();
            uploadFormData.append('file', fileInput.files[0]);

            const uploadResponse = await fetch('/api/upload', {
              method: 'POST',
              body: uploadFormData,
            });

            if (!uploadResponse.ok) {
              alert('Failed to upload image');
              return;
            }

            const uploadData = await uploadResponse.json();
            heroImageUrl = uploadData.url;
          }

          // Update campaign progress with the image URL
          const response = await fetch(`/api/campaign-progress/${campaignProgressId}`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ heroImageUrl }),
          });

          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to update hero image');
            // Reset button state on error
            if (submitBtn) submitBtn.disabled = false;
            if (submitText) submitText.classList.remove('hidden');
            if (submitLoading) submitLoading.classList.add('hidden');
          }
        } catch (error) {
          console.error('Error updating hero image:', error);
          alert('Failed to update hero image');
          // Reset button state on error
          if (submitBtn) submitBtn.disabled = false;
          if (submitText) submitText.classList.remove('hidden');
          if (submitLoading) submitLoading.classList.add('hidden');
        }
      });

      // Faction Modal controls
      const addFactionBtn = document.getElementById('addFactionBtn');
      const factionModal = document.getElementById('factionModal');
      const factionModalTitle = document.getElementById('factionModalTitle');
      const closeFactionModalBtn = document.getElementById('closeFactionModalBtn');
      const cancelFactionBtn = document.getElementById('cancelFactionBtn');
      const factionForm = document.getElementById('factionForm');
      const factionIdInput = document.getElementById('factionId');
      const factionNameInput = document.getElementById('factionName');
      const factionStatusSelect = document.getElementById('factionStatus');
      const factionProgressInput = document.getElementById('factionProgress');
      const progressValueSpan = document.getElementById('progressValue');

      // Update progress value display when slider changes
      factionProgressInput?.addEventListener('input', (e) => {
        if (progressValueSpan) progressValueSpan.textContent = e.target.value;
      });

      const closeFactionModal = () => {
        factionModal?.classList.add('hidden');
        // Reset form
        if (factionForm) factionForm.reset();
        if (factionIdInput) factionIdInput.value = '';
        if (factionModalTitle) factionModalTitle.textContent = 'Add Faction';
        if (factionProgressInput) factionProgressInput.value = '50';
        if (progressValueSpan) progressValueSpan.textContent = '50';
      };

      // Add Faction button
      addFactionBtn?.addEventListener('click', () => {
        closeFactionModal(); // Reset first
        factionModal?.classList.remove('hidden');
      });

      closeFactionModalBtn?.addEventListener('click', closeFactionModal);
      cancelFactionBtn?.addEventListener('click', closeFactionModal);

      // Close modal on background click
      factionModal?.addEventListener('click', (e) => {
        if (e.target === factionModal) {
          closeFactionModal();
        }
      });

      // Edit Faction buttons
      document.querySelectorAll('.edit-faction-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const factionId = btn.getAttribute('data-faction-id');
          const factionName = btn.getAttribute('data-faction-name');
          const factionStatus = btn.getAttribute('data-faction-status');
          const factionProgress = btn.getAttribute('data-faction-progress') || '50';
          
          if (factionIdInput) factionIdInput.value = factionId || '';
          if (factionNameInput) factionNameInput.value = factionName || '';
          if (factionStatusSelect) factionStatusSelect.value = factionStatus || 'neutral';
          if (factionProgressInput) factionProgressInput.value = factionProgress;
          if (progressValueSpan) progressValueSpan.textContent = factionProgress;
          if (factionModalTitle) factionModalTitle.textContent = 'Edit Faction';
          
          factionModal?.classList.remove('hidden');
        });
      });

      // Delete Faction buttons
      document.querySelectorAll('.delete-faction-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const factionId = btn.getAttribute('data-faction-id');
          
          if (confirm('Are you sure you want to delete this faction?')) {
            try {
              const response = await fetch(`/api/factions/${factionId}`, {
                method: 'DELETE',
              });

              if (response.ok) {
                window.location.reload();
              } else {
                alert('Failed to delete faction');
              }
            } catch (error) {
              console.error('Error deleting faction:', error);
              alert('Failed to delete faction');
            }
          }
        });
      });

      // Handle faction form submission
      factionForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const factionId = formData.get('factionId');
      const data = {
        name: formData.get('factionName'),
        status: formData.get('factionStatus'),
        progress: parseInt(formData.get('factionProgress') || '50'),
      };

      try {
        const isEditing = factionId && factionId !== '';
        const url = isEditing ? `/api/factions/${factionId}` : '/api/factions';
        const method = isEditing ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Failed to save faction');
        }
      } catch (error) {
        console.error('Error saving faction:', error);
        alert('Failed to save faction');
      }
    });
    }

    // Cleanup on navigation
    document.addEventListener('astro:before-preparation', () => {
      if (combatPollingInterval) {
        clearInterval(combatPollingInterval);
        combatPollingInterval = null;
      }
    });

    // Run on initial page load and after View Transitions navigation
    document.addEventListener('astro:page-load', initializeDashboard);
  </script>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import SessionCountdown from '../components/dashboard/SessionCountdown.astro';
import PreviouslyOn from '../components/dashboard/PreviouslyOn.astro';
import LoreSpark, { type LoreItem } from '../components/dashboard/LoreSpark.astro';
import PartyRow from '../components/dashboard/PartyRow.astro';
import DashboardHero from '../components/dashboard/DashboardHero.astro';
import NextSessionWidget from '../components/dashboard/NextSessionWidget.astro';
import ChronicleStrip from '../components/dashboard/ChronicleStrip.astro';
import QuestBoard from '../components/dashboard/QuestBoard.astro';
import LibraryShelf from '../components/dashboard/LibraryShelf.astro';
import FactionCrests from '../components/dashboard/FactionCrests.astro';
import { markdownExcerpt } from '../utils/markdown';
import { db, DiaryEntry, Quest, Character, CampaignProgress, LibraryEntry, Faction, CombatState, Event, User, NPC, Location } from '@/db';
import { getUserRole, getCurrentUser } from '../lib/auth';

// Dashboard is viewable by everyone, editable by dungeonmaster and admin
const userRole = await getUserRole(Astro.cookies);
const canEdit = userRole === 'admin' || userRole === 'dungeonmaster';
const currentUser = await getCurrentUser(Astro.cookies);

const diaryEntries = await db.select().from(DiaryEntry);
const quests = await db.select().from(Quest);
const characters = await db.select().from(Character);
const campaignProgressData = await db.select().from(CampaignProgress);
const libraryEntries = await db.select().from(LibraryEntry);
const factions = await db.select().from(Faction);
const events = await db.select().from(Event);
const users = await db.select().from(User);
const npcs = await db.select().from(NPC);
const locations = await db.select().from(Location);

// Get combat state
const combatStateData = await db.select().from(CombatState);
const combatState = combatStateData.length > 0 ? combatStateData[0] : null;

// Find next upcoming event
const now = new Date();
const upcomingEvents = events
  .filter(e => new Date(`${e.date}T${e.time}`) >= now)
  .sort((a, b) => {
    const dateTimeA = new Date(`${a.date}T${a.time}`).getTime();
    const dateTimeB = new Date(`${b.date}T${b.time}`).getTime();
    return dateTimeA - dateTimeB;
  });
const nextEvent = upcomingEvents.length > 0 ? upcomingEvents[0] : null;

// Helper to get host name
const getHostName = (hostId: string | null): string => {
  if (!hostId) return 'TBD';
  const host = users.find(u => u.id === hostId);
  return host ? (host.firstName || host.username) : 'Unknown';
};

// Helper to get host info including profile image
const getHostInfo = (hostId: string | null): { name: string, imageUrl: string | null } => {
  if (!hostId) {
    return {
      name: 'TBD',
      imageUrl: null
    };
  }
  const host = users.find(u => u.id === hostId);
  return {
    name: host ? (host.firstName || host.username) : 'Unknown',
    imageUrl: host?.profileImageUrl || null
  };
};

// Helper to format date
const formatDate = (dateStr: string): string => {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });
};

// Helper to format duration
const formatDuration = (minutes: number): string => {
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  if (hours > 0 && mins > 0) return `${hours}h ${mins}m`;
  if (hours > 0) return `${hours}h`;
  return `${mins}m`;
};

const campaignProgress = campaignProgressData.length > 0 ? campaignProgressData[0] : {
  id: '1',
  currentLevel: 1,
  progressPercent: 0,
};

const activeQuests = quests.filter(q => q.status === 'active');
const latestEntries = diaryEntries.slice().sort((a, b) => 
  b.session - a.session
).slice(0, 9);

const latestLibraryEntries = libraryEntries.slice().sort((a, b) => {
  const dateA = a.createdAt ? new Date(a.createdAt).getTime() : 0;
  const dateB = b.createdAt ? new Date(b.createdAt).getTime() : 0;
  return dateB - dateA;
}).slice(0, 8);

const isLoggedIn = !!userRole;

const latestEntry = latestEntries[0] ?? null;
const earlierEntries = latestEntries.slice(1);

// Pictures for sessions without a cover: a linked place's image, else the campaign hero.
const locationImage = new Map(locations.filter(l => l.imageUrl).map(l => [l.id, l.imageUrl!]));
const sessionImage = (e: typeof diaryEntries[number]) =>
  e.coverImageUrl || (e.locationIds ?? []).map((id: string) => locationImage.get(id)).find(Boolean) || campaignProgress.heroImageUrl || null;
const recapEntry = latestEntry ? { ...latestEntry, coverImageUrl: sessionImage(latestEntry) } : null;
const chronicle = earlierEntries.map(e => ({
  id: e.id,
  session: e.session,
  title: e.title,
  date: e.date,
  excerpt: markdownExcerpt(e.summary || e.content, 160),
  imageUrl: sessionImage(e),
}));
const activeCharacters = characters.filter(c => c.isActive !== false);
const daysSinceLastSession = latestEntry
  ? Math.max(0, Math.floor((Date.now() - new Date(latestEntry.date).getTime()) / 86_400_000))
  : null;

// Your own characters first, marked "That's you".
const myCharacterIds = new Set([
  ...characters.filter(c => currentUser && c.userId === currentUser.id).map(c => c.id),
  ...(currentUser?.characterIds ?? []),
]);
const partyCharacters = [
  ...activeCharacters.filter(c => myCharacterIds.has(c.id)),
  ...activeCharacters.filter(c => !myCharacterIds.has(c.id)),
];

const stats = [
  { label: 'Sessions played', value: diaryEntries.length, icon: 'book' },
  { label: 'NPCs met', value: npcs.length, icon: 'people' },
  { label: 'Places discovered', value: locations.filter(l => l.visited).length, icon: 'map' },
  { label: 'Quests completed', value: quests.filter(q => q.status === 'completed').length, icon: 'trophy' },
];
const hasHero = !!campaignProgress.heroImageUrl;

// "Do you remember…?": NPCs, visited locations, older sessions and library entries.
const shuffle = <T,>(items: T[]): T[] => {
  const a = items.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
};
const lorePools: LoreItem[][] = [
  npcs.map((n): LoreItem => ({
    kind: 'NPC',
    title: n.name,
    subtitle: [n.race, n.occupation].filter(Boolean).join(' · '),
    text: /\p{L}{3}/u.test(n.description) ? markdownExcerpt(n.description, 180) : markdownExcerpt(n.notes ?? '', 180),
    href: `/npcs/${n.id}`,
    imageUrl: n.avatarUrl,
  })),
  locations.filter(l => l.visited).map((l): LoreItem => ({
    kind: 'Location',
    title: l.name,
    subtitle: [l.type, l.region].filter(Boolean).join(' · '),
    text: markdownExcerpt(l.description, 180),
    href: `/locations/${l.id}`,
    imageUrl: l.imageUrl,
  })),
  diaryEntries.filter(e => e.id !== latestEntry?.id).map((e): LoreItem => ({
    kind: 'Session',
    title: e.title,
    subtitle: `Session ${e.session} · ${new Date(e.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}`,
    text: markdownExcerpt(e.summary || e.content, 180),
    href: `/diary/${e.id}`,
    imageUrl: e.coverImageUrl,
  })),
  libraryEntries.map((e): LoreItem => ({
    kind: 'Library',
    title: e.title,
    subtitle: '',
    text: markdownExcerpt(e.content, 180),
    href: `/library/${e.id}`,
    imageUrl: null,
  })),
];
// Take turns between the kinds (NPC first) so every visit gets a real mix.
const shuffledPools = lorePools.map(shuffle);
const lorePool: LoreItem[] = [];
for (let i = 0; lorePool.length < 12 && shuffledPools.some(p => i < p.length); i++) {
  for (const pool of shuffledPools) if (i < pool.length && lorePool.length < 12) lorePool.push(pool[i]);
}

// Use progressPercent directly (0-100)
const progressPercentage = Math.min(100, Math.max(0, campaignProgress.progressPercent));
---

<Layout title="Dashboard">
  <!-- Campaign Hero Image -->
  {campaignProgress.heroImageUrl ? (
    <DashboardHero
      imageUrl={campaignProgress.heroImageUrl}
      canEdit={canEdit}
      level={campaignProgress.currentLevel}
      progress={progressPercentage}
      lastSession={latestEntry ? { number: latestEntry.session, daysAgo: daysSinceLastSession! } : null}
    >
      {nextEvent && (
        <NextSessionWidget
          slot="next-session"
          event={nextEvent}
          host={getHostInfo(nextEvent.hostId)}
          isLoggedIn={isLoggedIn}
        />
      )}
    </DashboardHero>
  ) : (
    <div class="mb-8">
      <div class="flex justify-between items-center">
        <h1 class="text-4xl md:text-5xl">Dashboard</h1>
        {canEdit && (
          <button
            class="edit-hero-image-btn shrink-0 flex items-center gap-1.5 text-xs font-medium transition-colors"
            style="color: var(--accent); opacity: 0.7;"
            title="Add hero image"
          >
            <svg class="w-3.5 h-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Add Hero
          </button>
        )}
      </div>
      <div class="mt-3 h-px" style="background:linear-gradient(90deg, var(--accent) 0%, var(--border-gold) 40%, transparent 100%); max-width:280px;"></div>
    </div>
  )}

  <!-- Active Combat Indicator -->
  {isLoggedIn && (
    <div id="activeCombatIndicator" class="combat-banner mb-6" style="display: none;">
      <a href="/tools/initiative" class="flex items-center justify-between p-4 rounded-xs transition-all hover:opacity-90" style="background:linear-gradient(to right, #dc2626, #c99032); box-shadow: 0 0 30px rgba(201,144,50,0.35);">
        <div class="flex items-center gap-3">
          <div class="rounded-xs p-2" style="background:rgba(255,255,255,0.15);">
            <svg class="w-6 h-6 text-white animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white">Combat Active</h3>
            <p class="text-sm text-white/90">Initiative tracker is running</p>
          </div>
        </div>
        <svg class="w-6 h-6 text-white pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>
    </div>
  )}

  <!-- Next Event (inside the hero when there is one) -->
  {!hasHero && nextEvent && (
    <div id="next-session" class="t-panel p-5 mb-6" style="scroll-margin-top: 5rem;">
      <div class="flex justify-between items-center mb-4">
        <h2 class="t-section-h text-xl">Next Session</h2>
        {isLoggedIn && <a href="/calendar" class="t-link">View calendar →</a>}
      </div>
      <SessionCountdown date={nextEvent.date} time={nextEvent.time} duration={nextEvent.duration} />
      <div class="t-inset p-4">
        <h3 class="t-body-text font-medium text-sm mb-1">{nextEvent.title}</h3>
        {nextEvent.description && <p class="t-muted text-sm mb-3">{nextEvent.description}</p>}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          <div class="t-inset flex items-center gap-3 p-3">
            <div class="shrink-0 w-9 h-9 rounded-xs flex items-center justify-center" style="background:rgba(201,144,50,0.12);">
              <svg class="w-4 h-4 t-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
            <div><div class="t-faint text-xs">Date</div><div class="t-strong-text font-semibold text-sm">{formatDate(nextEvent.date)}</div></div>
          </div>
          {nextEvent.time && (
            <div class="t-inset flex items-center gap-3 p-3">
              <div class="shrink-0 w-9 h-9 rounded-xs flex items-center justify-center" style="background:rgba(201,144,50,0.10);">
                <svg class="w-4 h-4 t-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div><div class="t-faint text-xs">Time &amp; Duration</div><div class="t-strong-text font-semibold text-sm">{nextEvent.time}{nextEvent.duration ? ` (${formatDuration(nextEvent.duration)})` : ''}</div></div>
            </div>
          )}
          <div class="t-inset flex items-center gap-3 p-3">
            <div class="shrink-0 w-9 h-9 rounded-full overflow-hidden flex items-center justify-center" style="background:rgba(201,144,50,0.08);">
              {getHostInfo(nextEvent.hostId).imageUrl ? (
                <img src={getHostInfo(nextEvent.hostId).imageUrl} alt={getHostInfo(nextEvent.hostId).name} class="w-full h-full object-cover" />
              ) : (
                <svg class="w-4 h-4 t-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              )}
            </div>
            <div><div class="t-faint text-xs">Host</div><div class="t-strong-text font-semibold text-sm">{getHostName(nextEvent.hostId)}</div></div>
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- Previously on… + Do you remember…? -->
  {(latestEntry || lorePool.length > 0) && (
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-6">
      {latestEntry && (
        <div class={lorePool.length > 0 ? 'lg:col-span-2' : 'lg:col-span-3'}>
          <PreviouslyOn entry={recapEntry!} />
        </div>
      )}
      <div class={latestEntry ? '' : 'lg:col-span-3'}>
        <LoreSpark items={lorePool} />
      </div>
    </div>
  )}

  <PartyRow characters={partyCharacters} myCharacterIds={[...myCharacterIds]} />

  <!-- Campaign Progress (inside the hero when there is one) -->
  {!hasHero && (
  <div class="t-panel p-5 mb-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="t-section-h text-xl">Campaign Progress</h2>
      {canEdit && (
        <Button
            variant="primary"
            size="sm"
            icon="edit"
            id="editProgressBtn"
            title="Edit campaign progress"
          >
            Edit progress
          </Button>
      )}
    </div>

    <!-- Level Progress Bar -->
    <div class="t-inset p-4">
      <div class="flex items-center justify-between mb-2">
        <span class="t-label-sm">Party Level Progress</span>
        <span class="t-faint text-xs">{Math.round(progressPercentage)}%</span>
      </div>
      <div class="flex items-center gap-4">
        <div class="shrink-0 text-center">
          <div class="t-num text-3xl">{campaignProgress.currentLevel}</div>
          <div class="t-faint text-xs">Level</div>
        </div>
        <div class="flex-1">
          <div class="t-progress-track h-5">
            <div
              class="t-progress-fill flex items-center justify-center"
              style={`width: ${progressPercentage}%; height: 100%`}
            >
              {progressPercentage > 15 && (
                <span class="text-xs font-semibold text-white">{progressPercentage}%</span>
              )}
            </div>
          </div>
          <div class="flex justify-between mt-1">
            <span class="t-faint text-xs">0%</span>
            <span class="t-faint text-xs">100%</span>
          </div>
        </div>
        <div class="shrink-0 text-center">
          <div class="t-num text-3xl">{campaignProgress.currentLevel + 1}</div>
          <div class="t-faint text-xs">Next</div>
        </div>
      </div>
    </div>
  </div>
  )}

  {chronicle.length > 0 && <ChronicleStrip items={chronicle} />}

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-6">
    <div class="lg:col-span-2">
      <QuestBoard quests={activeQuests} completed={quests.filter(q => q.status === 'completed').length} failed={quests.filter(q => q.status === 'failed').length} />
    </div>
    <LibraryShelf entries={latestLibraryEntries.map(e => ({ id: e.id, title: e.title, tags: e.tags ?? [] }))} />
  </div>

  <!-- Faction Standings -->
  <FactionCrests factions={factions} canEdit={canEdit} />

  <!-- Campaign Stats -->
  <div class="t-panel p-5 mb-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      {stats.map(stat => (
        <div class="fun-stat t-inset p-4">
          <svg class="fun-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {stat.icon === 'book' && <path d="M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2Zm0 16V5M8 7h6" />}
            {stat.icon === 'people' && <path d="M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm-6 9c0-3.3 2.7-6 6-6s6 2.7 6 6M16 4.5a3.5 3.5 0 0 1 0 6.5M18 14c2 .7 3.5 2.8 3.5 6" />}
            {stat.icon === 'map' && <path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Zm0 0v14m6-12v14" />}
            {stat.icon === 'trophy' && <path d="M8 4h8v5a4 4 0 0 1-8 0V4Zm0 2H4v1a4 4 0 0 0 4 4m8-5h4v1a4 4 0 0 1-4 4m-4 2v4m-4 3h8l-1-3H9Z" />}
          </svg>
          <div class="t-num text-4xl">{stat.value}</div>
          <div class="t-label-sm mt-1">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- Edit Progress Modal -->
  {canEdit && (
    <div id="editProgressModal" class="hidden fixed inset-0 bg-black/70 z-50 flex items-center justify-center p-4 modal-overlay-safe">
      <div class="t-modal-panel max-w-md w-full p-6 modal-content-safe">
        <div class="flex justify-between items-center mb-6">
          <h3 class="t-section-h text-lg">Edit campaign progress</h3>
          <button id="closeModalBtn" class="t-muted hover:text-white transition-colors">
            <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <form id="editProgressForm" class="space-y-4">
          <div>
            <label class="t-label block mb-2">Current Level</label>
            <input
              type="number"
              id="currentLevel"
              name="currentLevel"
              value={campaignProgress.currentLevel}
              min="1"
              max="20"
              class="t-input px-3 py-2"
              required
            />
          </div>

          <div>
            <label class="t-label block mb-2">Progress to Next Level (%)</label>
            <input
              type="number"
              id="progressPercent"
              name="progressPercent"
              value={campaignProgress.progressPercent}
              min="0"
              max="100"
              step="10"
              class="t-input px-3 py-2"
              required
            />
            <p class="t-faint text-xs mt-1">Enter in steps of 10 (0, 10, 20, ..., 100)</p>
          </div>

          <div class="flex gap-3 pt-4">
            <button type="submit" class="t-btn-primary flex-1 px-4 py-2">Save changes</button>
            <button type="button" id="cancelBtn" class="t-btn-secondary flex-1">Cancel</button>
          </div>
        </form>
      </div>
    </div>
  )}

  <!-- Hero Image Modal -->
  {canEdit && (
    <div id="heroImageModal" class="hidden fixed inset-0 bg-black/70 z-50 flex items-center justify-center p-4 modal-overlay-safe">
      <div class="t-modal-panel max-w-md w-full p-6 modal-content-safe">
        <div class="flex justify-between items-center mb-6">
          <h3 class="t-section-h text-lg">Hero Image</h3>
          <button id="closeHeroImageModalBtn" class="t-muted hover:text-white transition-colors">
            <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <form id="heroImageForm" class="space-y-4">
          <div>
            <label class="t-label block mb-2">Upload Hero Image</label>
            <input
              type="file"
              accept="image/*"
              id="heroImageFile"
              class="t-input px-3 py-2 file:mr-3 file:py-1 file:px-3 file:rounded-sm file:border-0 file:text-xs file:font-semibold file:bg-amber-900/30 file:text-amber-300 hover:file:bg-amber-900/40"
            />
            <p class="t-faint text-xs mt-1">Upload an image file (max 5MB)</p>
          </div>

          <div class="relative">
            <div class="absolute inset-0 flex items-center">
              <div class="w-full" style="border-top:1px solid var(--border);"></div>
            </div>
            <div class="relative flex justify-center text-xs">
              <span class="px-2 t-muted" style="background:var(--bg-raised);">OR</span>
            </div>
          </div>

          <div>
            <label class="t-label block mb-2">Hero Image URL</label>
            <input
              type="text"
              id="heroImageUrl"
              name="heroImageUrl"
              value={campaignProgress.heroImageUrl || ''}
              placeholder="https://example.com/hero-image.jpg"
              class="t-input px-3 py-2"
            />
            <p class="t-faint text-xs mt-1">Or provide an image URL (absolute or relative)</p>
          </div>

          <div class="flex gap-3 pt-4">
            <button type="submit" id="heroImageSubmitBtn" class="t-btn-primary flex-1 px-4 py-2">
              <span id="heroImageSubmitText">Save</span>
              <span id="heroImageSubmitLoading" class="hidden">
                <svg class="animate-spin inline-block h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Uploading...
              </span>
            </button>
            <button type="button" id="cancelHeroImageBtn" class="t-btn-secondary flex-1">Cancel</button>
          </div>
        </form>
      </div>
    </div>
  )}

  <!-- Faction Modal (Add/Edit) -->
  {canEdit && (
    <div id="factionModal" class="hidden fixed inset-0 bg-black/70 z-50 flex items-center justify-center p-4 modal-overlay-safe">
      <div class="t-modal-panel max-w-md w-full p-6 modal-content-safe">
        <div class="flex justify-between items-center mb-6">
          <h3 id="factionModalTitle" class="t-section-h text-lg">Add faction</h3>
          <button id="closeFactionModalBtn" class="t-muted hover:text-white transition-colors">
            <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <form id="factionForm" class="space-y-4">
          <input type="hidden" id="factionId" name="factionId" value="" />

          <div>
            <label class="t-label block mb-2">Faction Name</label>
            <input
              type="text"
              id="factionName"
              name="factionName"
              placeholder="Enter faction name"
              class="t-input px-3 py-2"
              required
            />
          </div>

          <div>
            <label class="t-label block mb-2">Status</label>
            <select
              id="factionStatus"
              name="factionStatus"
              class="t-input px-3 py-2"
              required
            >
              <option value="enemy">Enemy</option>
              <option value="suspicious">Suspicious</option>
              <option value="neutral" selected>Neutral</option>
              <option value="friendly">Friendly</option>
              <option value="respectful">Respectful</option>
            </select>
          </div>

          <div>
            <label class="t-label block mb-2">Progress (<span id="progressValue">50</span>%)</label>
            <input
              type="range"
              id="factionProgress"
              name="factionProgress"
              min="0"
              max="100"
              value="50"
              class="w-full h-2 rounded-xs appearance-none cursor-pointer"
              style="background:var(--bg-page); accent-color:var(--accent);"
            />
            <div class="flex justify-between t-faint text-xs mt-1">
              <span>0%</span>
              <span>50%</span>
              <span>100%</span>
            </div>
          </div>

          <div class="flex gap-3 pt-4">
            <button type="submit" class="t-btn-primary flex-1 px-4 py-2">Save</button>
            <button type="button" id="cancelFactionBtn" class="t-btn-secondary flex-1">Cancel</button>
          </div>
        </form>
      </div>
    </div>
  )}

  <script define:vars={{ campaignProgressId: campaignProgress.id, isLoggedIn }}>
    let combatPollingInterval = null;

    // Poll combat state to show/hide indicator
    async function checkCombatStatus() {
      if (!isLoggedIn) return;
      
      try {
        const response = await fetch('/api/combat-state');
        if (response.ok) {
          const data = await response.json();
          const indicator = document.getElementById('activeCombatIndicator');
          
          if (data.status === 'active' && indicator) {
            indicator.style.display = 'block';
          } else {
            if (indicator) {
              indicator.style.display = 'none';
            }
            // Stop polling if combat is not active
            if (data.status !== 'active' && combatPollingInterval) {
              clearInterval(combatPollingInterval);
              combatPollingInterval = null;
            }
          }
        }
      } catch (error) {
        console.error('Error checking combat status:', error);
      }
    }

    // Initialize dashboard modals and forms
    function initializeDashboard() {
      // Check combat status immediately and set up polling
      if (isLoggedIn) {
        checkCombatStatus();
        
        // Clear any existing interval
        if (combatPollingInterval) {
          clearInterval(combatPollingInterval);
        }
        
        // Poll every 5 seconds
        combatPollingInterval = setInterval(checkCombatStatus, 5000);
      }
      // Campaign Progress Modal controls
      const editBtn = document.getElementById('editProgressBtn');
      const modal = document.getElementById('editProgressModal');
      const closeBtn = document.getElementById('closeModalBtn');
      const cancelBtn = document.getElementById('cancelBtn');
      const form = document.getElementById('editProgressForm');

      editBtn?.addEventListener('click', () => {
        modal?.classList.remove('hidden');
      });

      const closeModal = () => {
        modal?.classList.add('hidden');
      };

      closeBtn?.addEventListener('click', closeModal);
      cancelBtn?.addEventListener('click', closeModal);

      // Close modal on background click
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });

      // Handle form submission
      form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const data = {
        currentLevel: parseInt(formData.get('currentLevel')),
        progressPercent: parseInt(formData.get('progressPercent')),
      };

      try {
        const response = await fetch(`/api/campaign-progress/${campaignProgressId}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Failed to update campaign progress');
        }
      } catch (error) {
        console.error('Error updating campaign progress:', error);
        alert('Failed to update campaign progress');
      }
    });

      // Hero Image Modal controls
      const editHeroImageBtns = document.querySelectorAll('.edit-hero-image-btn');
      const heroImageModal = document.getElementById('heroImageModal');
      const closeHeroImageModalBtn = document.getElementById('closeHeroImageModalBtn');
      const cancelHeroImageBtn = document.getElementById('cancelHeroImageBtn');
      const heroImageForm = document.getElementById('heroImageForm');

      editHeroImageBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          heroImageModal?.classList.remove('hidden');
        });
      });

      const closeHeroImageModal = () => {
        heroImageModal?.classList.add('hidden');
      };

      closeHeroImageModalBtn?.addEventListener('click', closeHeroImageModal);
      cancelHeroImageBtn?.addEventListener('click', closeHeroImageModal);

      // Close modal on background click
      heroImageModal?.addEventListener('click', (e) => {
        if (e.target === heroImageModal) {
          closeHeroImageModal();
        }
      });

      // Handle hero image form submission
      heroImageForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const fileInput = document.getElementById('heroImageFile');
        const urlInput = document.getElementById('heroImageUrl');
        const submitBtn = document.getElementById('heroImageSubmitBtn');
        const submitText = document.getElementById('heroImageSubmitText');
        const submitLoading = document.getElementById('heroImageSubmitLoading');
        
        let heroImageUrl = urlInput?.value || null;

        // Show loading state
        if (submitBtn) submitBtn.disabled = true;
        if (submitText) submitText.classList.add('hidden');
        if (submitLoading) submitLoading.classList.remove('hidden');

        try {
          // If a file was selected, upload it first
          if (fileInput?.files && fileInput.files.length > 0) {
            const uploadFormData = new FormData();
            uploadFormData.append('file', fileInput.files[0]);

            const uploadResponse = await fetch('/api/upload', {
              method: 'POST',
              body: uploadFormData,
            });

            if (!uploadResponse.ok) {
              alert('Failed to upload image');
              return;
            }

            const uploadData = await uploadResponse.json();
            heroImageUrl = uploadData.url;
          }

          // Update campaign progress with the image URL
          const response = await fetch(`/api/campaign-progress/${campaignProgressId}`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ heroImageUrl }),
          });

          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to update hero image');
            // Reset button state on error
            if (submitBtn) submitBtn.disabled = false;
            if (submitText) submitText.classList.remove('hidden');
            if (submitLoading) submitLoading.classList.add('hidden');
          }
        } catch (error) {
          console.error('Error updating hero image:', error);
          alert('Failed to update hero image');
          // Reset button state on error
          if (submitBtn) submitBtn.disabled = false;
          if (submitText) submitText.classList.remove('hidden');
          if (submitLoading) submitLoading.classList.add('hidden');
        }
      });

      // Faction Modal controls
      const addFactionBtn = document.getElementById('addFactionBtn');
      const factionModal = document.getElementById('factionModal');
      const factionModalTitle = document.getElementById('factionModalTitle');
      const closeFactionModalBtn = document.getElementById('closeFactionModalBtn');
      const cancelFactionBtn = document.getElementById('cancelFactionBtn');
      const factionForm = document.getElementById('factionForm');
      const factionIdInput = document.getElementById('factionId');
      const factionNameInput = document.getElementById('factionName');
      const factionStatusSelect = document.getElementById('factionStatus');
      const factionProgressInput = document.getElementById('factionProgress');
      const progressValueSpan = document.getElementById('progressValue');

      // Update progress value display when slider changes
      factionProgressInput?.addEventListener('input', (e) => {
        if (progressValueSpan) progressValueSpan.textContent = e.target.value;
      });

      const closeFactionModal = () => {
        factionModal?.classList.add('hidden');
        // Reset form
        if (factionForm) factionForm.reset();
        if (factionIdInput) factionIdInput.value = '';
        if (factionModalTitle) factionModalTitle.textContent = 'Add faction';
        if (factionProgressInput) factionProgressInput.value = '50';
        if (progressValueSpan) progressValueSpan.textContent = '50';
      };

      // Add Faction button
      addFactionBtn?.addEventListener('click', () => {
        closeFactionModal(); // Reset first
        factionModal?.classList.remove('hidden');
      });

      closeFactionModalBtn?.addEventListener('click', closeFactionModal);
      cancelFactionBtn?.addEventListener('click', closeFactionModal);

      // Close modal on background click
      factionModal?.addEventListener('click', (e) => {
        if (e.target === factionModal) {
          closeFactionModal();
        }
      });

      // Edit Faction buttons
      document.querySelectorAll('.edit-faction-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const factionId = btn.getAttribute('data-faction-id');
          const factionName = btn.getAttribute('data-faction-name');
          const factionStatus = btn.getAttribute('data-faction-status');
          const factionProgress = btn.getAttribute('data-faction-progress') || '50';
          
          if (factionIdInput) factionIdInput.value = factionId || '';
          if (factionNameInput) factionNameInput.value = factionName || '';
          if (factionStatusSelect) factionStatusSelect.value = factionStatus || 'neutral';
          if (factionProgressInput) factionProgressInput.value = factionProgress;
          if (progressValueSpan) progressValueSpan.textContent = factionProgress;
          if (factionModalTitle) factionModalTitle.textContent = 'Edit faction';
          
          factionModal?.classList.remove('hidden');
        });
      });

      // Delete Faction buttons
      document.querySelectorAll('.delete-faction-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const factionId = btn.getAttribute('data-faction-id');
          
          if ((await window.arandorConfirm('Delete this faction?', { detail: 'This can\u2019t be undone.', confirmLabel: 'Delete', danger: true }))) {
            try {
              const response = await fetch(`/api/factions/${factionId}`, {
                method: 'DELETE',
              });

              if (response.ok) {
                window.location.reload();
              } else {
                alert('Failed to delete faction');
              }
            } catch (error) {
              console.error('Error deleting faction:', error);
              alert('Failed to delete faction');
            }
          }
        });
      });

      // Handle faction form submission
      factionForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const factionId = formData.get('factionId');
      const data = {
        name: formData.get('factionName'),
        status: formData.get('factionStatus'),
        progress: parseInt(formData.get('factionProgress') || '50'),
      };

      try {
        const isEditing = factionId && factionId !== '';
        const url = isEditing ? `/api/factions/${factionId}` : '/api/factions';
        const method = isEditing ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Failed to save faction');
        }
      } catch (error) {
        console.error('Error saving faction:', error);
        alert('Failed to save faction');
      }
    });
    }

    // Cleanup on navigation
    document.addEventListener('astro:before-preparation', () => {
      if (combatPollingInterval) {
        clearInterval(combatPollingInterval);
        combatPollingInterval = null;
      }
    });

    // Run on initial page load and after View Transitions navigation
    document.addEventListener('astro:page-load', initializeDashboard);
  </script>
</Layout>

<style is:global>
  .fun-stat { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .fun-stat-icon { width: 1.5rem; height: 1.5rem; color: var(--gold); opacity: 0.8; margin-bottom: 0.4rem; }

  /* Combat banner: slides in with a glow when initiative starts (display: none → block). */
  .combat-banner { animation: combat-in 0.6s cubic-bezier(0.2, 1.3, 0.4, 1) both; }
  .combat-banner > a { animation: combat-glow 2.4s 0.6s ease-in-out infinite; }
  @keyframes combat-in {
    from { opacity: 0; transform: translateY(-14px) scale(0.97); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes combat-glow {
    0%, 100% { box-shadow: 0 0 20px rgba(220, 38, 38, 0.35); }
    50%      { box-shadow: 0 0 40px rgba(220, 38, 38, 0.65); }
  }
  @media (prefers-reduced-motion: reduce) {
    .combat-banner, .combat-banner > a { animation: none; }
  }

  /* Dashboard cards rise in as they scroll into view (see script below). */
  .dash-reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.2, 0.9, 0.3, 1); }
  .dash-reveal.is-visible { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .dash-reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    if (window.location.pathname !== '/' || !('IntersectionObserver' in window)) return;
    const panels = document.querySelectorAll<HTMLElement>('main .t-panel');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px' }
    );
    panels.forEach((panel, i) => {
      panel.classList.add('dash-reveal');
      panel.style.transitionDelay = `${Math.min(i, 3) * 60}ms`;
      observer.observe(panel);
    });
  });
</script>

---
import Layout from '../layouts/Layout.astro';
import { db, DiaryEntry, Quest, Character, CampaignProgress } from 'astro:db';
import { isAuthenticated } from '../lib/auth';

const diaryEntries = await db.select().from(DiaryEntry);
const quests = await db.select().from(Quest);
const characters = await db.select().from(Character);
const campaignProgressData = await db.select().from(CampaignProgress);

const campaignProgress = campaignProgressData.length > 0 ? campaignProgressData[0] : {
  id: '1',
  currentLevel: 1,
  currentXP: 0,
  xpForNextLevel: 300,
};

const activeQuests = quests.filter(q => q.status === 'active');
const latestEntries = diaryEntries.slice().sort((a, b) => 
  new Date(b.date).getTime() - new Date(a.date).getTime()
).slice(0, 3);

const isLoggedIn = isAuthenticated(Astro.cookies);

// Helper function to get XP required for a given level (D&D 5e standard progression)
function getXPForLevel(level: number): number {
  const xpTable: { [key: number]: number } = {
    1: 0, 2: 300, 3: 900, 4: 2700, 5: 6500, 6: 14000, 7: 23000, 8: 34000, 9: 48000, 10: 64000,
    11: 85000, 12: 100000, 13: 120000, 14: 140000, 15: 165000, 16: 195000, 17: 225000, 18: 265000, 19: 305000, 20: 355000
  };
  return xpTable[level] || 0;
}

// Calculate progress percentage with validation
const xpForCurrentLevel = getXPForLevel(campaignProgress.currentLevel);
const xpInCurrentLevel = Math.max(0, campaignProgress.currentXP - xpForCurrentLevel);
const xpNeededForNextLevel = Math.max(1, campaignProgress.xpForNextLevel - xpForCurrentLevel);
const progressPercentage = Math.min(100, Math.max(0, (xpInCurrentLevel / xpNeededForNextLevel) * 100));
---

<Layout title="Dashboard">
  <h1 class="text-4xl font-bold mb-8 text-primary-700 dark:text-primary-400">Dashboard</h1>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    <!-- Active Quests Card -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 dark:border dark:border-gray-700">
      <h2 class="text-2xl font-semibold mb-4 text-primary-600 dark:text-primary-400">Active Quests</h2>
      <div class="space-y-3">
        {activeQuests.map(quest => (
          <div class="border-l-4 border-primary-500 dark:border-primary-400 pl-4 py-2">
            <h3 class="font-semibold dark:text-gray-100">{quest.title}</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">{quest.description}</p>
            <span class={`inline-block px-2 py-1 text-xs rounded mt-2 ${
              quest.priority === 'high' ? 'bg-red-100 text-red-700 dark:bg-red-900/20 dark:text-red-400' :
              quest.priority === 'medium' ? 'bg-secondary-100 text-secondary-700 dark:bg-secondary-900/20 dark:text-secondary-400' :
              'bg-green-100 text-green-700 dark:bg-green-900/20 dark:text-green-400'
            }`}>
              {quest.priority}
            </span>
          </div>
        ))}
      </div>
      <a href="/quests" class="block mt-4 text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
        View all quests →
      </a>
    </div>

    <!-- Party Members Card -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 dark:border dark:border-gray-700">
      <h2 class="text-2xl font-semibold mb-4 text-primary-600 dark:text-primary-400">Party Members</h2>
      <div class="space-y-3">
        {characters.map(char => (
          <a href={`/characters/${char.id}`} class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700 rounded hover:bg-gray-100 dark:hover:bg-gray-600 transition cursor-pointer">
            <div>
              <h3 class="font-semibold text-primary-700 dark:text-primary-400 hover:text-primary-900 dark:hover:text-primary-300">{char.name}</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">{char.race} {char.class} - Level {char.level}</p>
            </div>
            <div class="text-right">
              <span class="text-sm text-gray-500 dark:text-gray-400">{char.player}</span>
            </div>
          </a>
        ))}
      </div>
      <a href="/characters" class="block mt-4 text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
        View all characters →
      </a>
    </div>

    <!-- Latest Diary Entries Card -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 dark:border dark:border-gray-700">
      <h2 class="text-2xl font-semibold mb-4 text-primary-600 dark:text-primary-400">Latest Entries</h2>
      <div class="space-y-3">
        {latestEntries.map(entry => (
          <a href={`/diary/${entry.id}`} class="block border-b dark:border-gray-700 pb-3 last:border-b-0 hover:bg-gray-50 dark:hover:bg-gray-700 rounded px-2 -mx-2 transition">
            <div class="flex justify-between items-start mb-1">
              <h3 class="font-semibold text-primary-700 dark:text-primary-400 hover:text-primary-900 dark:hover:text-primary-300">{entry.title}</h3>
              <span class="text-xs text-gray-500 dark:text-gray-400">Session {entry.session}</span>
            </div>
            <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">{entry.content}</p>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">{entry.date}</p>
          </a>
        ))}
      </div>
      <a href="/diary" class="block mt-4 text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
        View all entries →
      </a>
    </div>
  </div>

  <!-- Campaign Progress -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 dark:border dark:border-gray-700">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-2xl font-semibold text-primary-600 dark:text-primary-400">Campaign Progress</h2>
      {isLoggedIn && (
        <button 
          id="editProgressBtn"
          class="px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded transition text-sm"
        >
          Edit Progress
        </button>
      )}
    </div>
    
    <!-- Level Progress Bar -->
    <div class="mb-6 p-4 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Party Level Progress</span>
        <span class="text-xs text-gray-500 dark:text-gray-400">{Math.round(progressPercentage)}%</span>
      </div>
      <div class="flex items-center gap-4">
        <div class="flex-shrink-0 text-center">
          <div class="text-2xl font-bold text-primary-600 dark:text-primary-400">{campaignProgress.currentLevel}</div>
          <div class="text-xs text-gray-500 dark:text-gray-400">Level</div>
        </div>
        <div class="flex-1">
          <div class="w-full bg-gray-200 dark:bg-gray-600 rounded-full h-6 overflow-hidden">
            <div 
              class="bg-gradient-to-r from-primary-500 to-secondary-500 h-6 rounded-full transition-all duration-300 flex items-center justify-end pr-2"
              style={`width: ${progressPercentage}%`}
            >
              {progressPercentage > 20 && (
                <span class="text-xs font-medium text-white">{campaignProgress.currentXP} XP</span>
              )}
            </div>
          </div>
          <div class="flex justify-between mt-1">
            <span class="text-xs text-gray-500 dark:text-gray-400">{getXPForLevel(campaignProgress.currentLevel)} XP</span>
            <span class="text-xs text-gray-500 dark:text-gray-400">{campaignProgress.xpForNextLevel} XP</span>
          </div>
        </div>
        <div class="flex-shrink-0 text-center">
          <div class="text-2xl font-bold text-secondary-600 dark:text-secondary-400">{campaignProgress.currentLevel + 1}</div>
          <div class="text-xs text-gray-500 dark:text-gray-400">Next</div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="text-center p-4 bg-primary-50 dark:bg-primary-900/20 dark:border dark:border-primary-800 rounded">
        <div class="text-3xl font-bold text-primary-600 dark:text-primary-400">{diaryEntries.length}</div>
        <div class="text-sm text-gray-600 dark:text-gray-400">Sessions Played</div>
      </div>
      <div class="text-center p-4 bg-accent-50 dark:bg-accent-900/20 dark:border dark:border-accent-800 rounded">
        <div class="text-3xl font-bold text-accent-600 dark:text-accent-400">{quests.length}</div>
        <div class="text-sm text-gray-600 dark:text-gray-400">Total Quests</div>
      </div>
      <div class="text-center p-4 bg-green-50 dark:bg-green-900/20 dark:border dark:border-green-800 rounded">
        <div class="text-3xl font-bold text-green-600 dark:text-green-400">{characters.length}</div>
        <div class="text-sm text-gray-600 dark:text-gray-400">Party Members</div>
      </div>
      <div class="text-center p-4 bg-secondary-50 dark:bg-secondary-900/20 dark:border dark:border-secondary-800 rounded">
        <div class="text-3xl font-bold text-secondary-600 dark:text-secondary-400">{characters.length > 0 ? (characters.reduce((sum, c) => sum + c.level, 0) / characters.length).toFixed(1) : 0}</div>
        <div class="text-sm text-gray-600 dark:text-gray-400">Average Level</div>
      </div>
    </div>
  </div>

  <!-- Edit Progress Modal -->
  {isLoggedIn && (
    <div id="editProgressModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-md w-full p-6 dark:border dark:border-gray-700">
        <div class="flex justify-between items-center mb-6">
          <h3 class="text-xl font-semibold text-primary-700 dark:text-primary-400">Edit Campaign Progress</h3>
          <button id="closeModalBtn" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        
        <form id="editProgressForm" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Current Level
            </label>
            <input 
              type="number" 
              id="currentLevel" 
              name="currentLevel" 
              value={campaignProgress.currentLevel}
              min="1"
              max="20"
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-gray-100"
              required
            />
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Current XP
            </label>
            <input 
              type="number" 
              id="currentXP" 
              name="currentXP" 
              value={campaignProgress.currentXP}
              min="0"
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-gray-100"
              required
            />
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              XP for Next Level
            </label>
            <input 
              type="number" 
              id="xpForNextLevel" 
              name="xpForNextLevel" 
              value={campaignProgress.xpForNextLevel}
              min="0"
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-gray-100"
              required
            />
          </div>
          
          <div class="flex gap-3 pt-4">
            <button 
              type="submit" 
              class="flex-1 bg-primary-600 hover:bg-primary-700 text-white px-4 py-2 rounded-lg transition"
            >
              Save Changes
            </button>
            <button 
              type="button" 
              id="cancelBtn"
              class="flex-1 bg-gray-300 hover:bg-gray-400 dark:bg-gray-600 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 px-4 py-2 rounded-lg transition"
            >
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>
  )}

  <script define:vars={{ campaignProgressId: campaignProgress.id }}>
    // Modal controls
    const editBtn = document.getElementById('editProgressBtn');
    const modal = document.getElementById('editProgressModal');
    const closeBtn = document.getElementById('closeModalBtn');
    const cancelBtn = document.getElementById('cancelBtn');
    const form = document.getElementById('editProgressForm');

    editBtn?.addEventListener('click', () => {
      modal?.classList.remove('hidden');
    });

    const closeModal = () => {
      modal?.classList.add('hidden');
    };

    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);

    // Close modal on background click
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Handle form submission
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const data = {
        currentLevel: parseInt(formData.get('currentLevel')),
        currentXP: parseInt(formData.get('currentXP')),
        xpForNextLevel: parseInt(formData.get('xpForNextLevel')),
      };

      try {
        const response = await fetch(`/api/campaign-progress/${campaignProgressId}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Failed to update campaign progress');
        }
      } catch (error) {
        console.error('Error updating campaign progress:', error);
        alert('Failed to update campaign progress');
      }
    });
  </script>
</Layout>

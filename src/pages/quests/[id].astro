---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import { db, Quest, DiaryEntry, NPC, Location, Character, TimelineEntry, LibraryEntry, eq, inArray } from '@/db';
import { getUserRole } from '../../lib/auth';
import { renderMarkdown, markdownExcerpt } from '../../utils/markdown';

const { id } = Astro.params;
if (!id) return Astro.redirect('/quests');

const quests = await db.select().from(Quest).where(eq(Quest.id, id));
const quest = quests[0];
if (!quest) return Astro.redirect('/quests');

const userRole = await getUserRole(Astro.cookies);
const canEdit = userRole === 'admin' || userRole === 'dungeonmaster';

// Quests are linked from diary entries, timeline events and library entries (their questIds).
// NPCs, locations and party members come from the diary entries of the quest.
const includesQuest = (ids: unknown) => Array.isArray(ids) && ids.includes(id);

const diaryEntries = (await db.select().from(DiaryEntry))
  .filter(entry => includesQuest(entry.questIds))
  .sort((a, b) => a.session - b.session);

const timelineEntries = (await db.select().from(TimelineEntry))
  .filter(entry => entry.entryType !== 'label' && includesQuest(entry.questIds))
  .sort((a, b) => a.year - b.year || (a.month ?? 0) - (b.month ?? 0) || (a.sortOrder ?? 0) - (b.sortOrder ?? 0));

const libraryEntries = (await db.select().from(LibraryEntry))
  .filter(entry => includesQuest(entry.questIds))
  .sort((a, b) => a.title.localeCompare(b.title));

// How many of the quest's sessions each linked id appears in
const countIds = (key: 'npcIds' | 'locationIds' | 'characterIds') => {
  const counts = new Map<string, number>();
  for (const entry of diaryEntries) {
    const ids = Array.isArray(entry[key]) ? entry[key] : [];
    for (const linkedId of new Set(ids)) counts.set(linkedId, (counts.get(linkedId) ?? 0) + 1);
  }
  return counts;
};
const npcCounts = countIds('npcIds');
const locationCounts = countIds('locationIds');
const characterCounts = countIds('characterIds');

const byCount = (counts: Map<string, number>) => (a: { id: string; name: string }, b: { id: string; name: string }) =>
  (counts.get(b.id) ?? 0) - (counts.get(a.id) ?? 0) || a.name.localeCompare(b.name);

const relatedNPCs = npcCounts.size > 0
  ? (await db.select().from(NPC).where(inArray(NPC.id, [...npcCounts.keys()]))).sort(byCount(npcCounts))
  : [];
const relatedLocations = locationCounts.size > 0
  ? (await db.select().from(Location).where(inArray(Location.id, [...locationCounts.keys()]))).sort(byCount(locationCounts))
  : [];
const relatedCharacters = characterCounts.size > 0
  ? (await db.select().from(Character).where(inArray(Character.id, [...characterCounts.keys()]))).sort(byCount(characterCounts))
  : [];

const sessionLabel = (count: number) => `${count} session${count === 1 ? '' : 's'}`;

const firstSession = diaryEntries[0]?.session;
const lastSession = diaryEntries[diaryEntries.length - 1]?.session;
const sessionSpan = firstSession === undefined
  ? null
  : firstSession === lastSession
  ? `Session ${firstSession}`
  : `Sessions ${firstSession}–${lastSession}`;

const renderedDescription = renderMarkdown(quest.description);

const statusBadge = quest.status === 'completed' ? 't-badge-green' : quest.status === 'failed' ? 't-badge-red' : 't-badge-accent';
const priorityBadge = quest.priority === 'high' ? 't-badge-red' : quest.priority === 'medium' ? 't-badge-gold' : 't-badge-green';
const heroBg = quest.status === 'completed'
  ? 'from-emerald-950 to-stone-900'
  : quest.status === 'failed'
  ? 'from-red-950 to-stone-900'
  : 'from-stone-900 to-stone-800';
const capitalize = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);
---

<Layout title={quest.title}>
  <div class="max-w-4xl mx-auto px-1 sm:px-0">

    <!-- Nav row -->
    <div class="flex items-center justify-between mb-6">
      <a href="/quests" class="t-back-link">
        <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/>
        </svg>
        All quests
      </a>
      {canEdit && (
        <div class="flex gap-2 items-center">
          {quest.status === 'active' ? (
            <>
              <Button variant="success" size="xs" class="set-quest-status" data-status="completed">Complete</Button>
              <Button variant="danger" size="xs" class="set-quest-status" data-status="failed">Fail</Button>
            </>
          ) : (
            <Button variant="secondary" size="xs" class="set-quest-status" data-status="active">Reactivate</Button>
          )}
          <button id="editQuest" class="t-icon-btn" title="Edit quest" aria-label="Edit quest">
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </button>
          <button id="deleteQuest" class="t-icon-btn t-icon-btn-danger" title="Delete quest" aria-label="Delete quest">
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
          </button>
        </div>
      )}
    </div>

    <!-- Quest Card -->
    <div class="t-panel overflow-hidden mb-6" id="questDetail" data-id={quest.id}>
      <div class={`t-hero-banner bg-linear-to-br ${heroBg}`} style="min-height:180px;">
        <div class="t-hero-banner-content">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <span class={`t-badge ${statusBadge}`} style="backdrop-filter:blur(8px);">{capitalize(quest.status)}</span>
            <span class={`t-badge ${priorityBadge}`} style="backdrop-filter:blur(8px);">{capitalize(quest.priority)} priority</span>
          </div>
          <h1 class="font-display italic font-semibold text-3xl sm:text-4xl leading-tight"
            style="color:#fff;text-shadow:0 2px 16px rgba(0,0,0,0.8);">{quest.title}</h1>
          {sessionSpan && (
            <p class="text-base sm:text-lg mt-1" style="color:rgba(242,232,213,0.8);">
              {sessionSpan} · {sessionLabel(diaryEntries.length)}
            </p>
          )}
        </div>
      </div>
    </div>

    <!-- Description -->
    {quest.description && (
      <div class="t-panel p-6 sm:p-8 mb-6">
        <div class="t-section-header">
          <h2 class="t-section-h text-xl">Description</h2>
        </div>
        <div class="t-prose" set:html={renderedDescription}/>
      </div>
    )}

    <!-- Diary entries -->
    <div class="t-panel p-6 sm:p-8 mb-6">
      <div class="t-section-header">
        <h2 class="t-section-h text-xl">In the Diary</h2>
        {diaryEntries.length > 0 && <span class="t-badge t-badge-gold ml-auto">{diaryEntries.length}</span>}
      </div>
      {diaryEntries.length > 0 ? (
        <div class="flex flex-col gap-3">
          {diaryEntries.map(entry => (
            <a href={`/diary/${entry.id}`} class="t-row p-4 flex items-start justify-between gap-4">
              <div class="min-w-0">
                <div class="t-body-text font-medium truncate">{entry.title}</div>
                <div class="t-faint text-xs mt-0.5 line-clamp-2">
                  {markdownExcerpt(entry.summary || entry.content, 140)}
                </div>
              </div>
              <span class="t-badge t-badge-accent shrink-0">Session {entry.session}</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="t-muted text-sm italic">
          No diary entries mention this quest yet.{canEdit && ' Link it from a diary entry’s Quests field.'}
        </p>
      )}
    </div>

    <!-- Library documents -->
    {libraryEntries.length > 0 && (
      <div class="t-panel p-6 sm:p-8 mb-6">
        <div class="t-section-header">
          <h2 class="t-section-h text-xl">From the Library</h2>
          <span class="t-badge t-badge-gold ml-auto">{libraryEntries.length}</span>
        </div>
        <div class="flex flex-col gap-3">
          {libraryEntries.map(entry => (
            <a href={`/library/${entry.id}`} class="t-row p-4 block">
              <div class="t-body-text font-medium truncate">{entry.title}</div>
              <div class="t-faint text-xs mt-0.5 line-clamp-2">{markdownExcerpt(entry.content, 140)}</div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- NPCs, locations, party members from the quest's sessions -->
    {(relatedNPCs.length > 0 || relatedLocations.length > 0 || relatedCharacters.length > 0) && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        {relatedNPCs.length > 0 && (
          <div class="t-panel p-6">
            <h3 class="t-section-h text-lg mb-4">NPCs Involved</h3>
            <div class="space-y-3">
              {relatedNPCs.map(npc => (
                <a href={`/npcs/${npc.id}`} class="t-row p-3 flex items-center gap-3">
                  {npc.avatarUrl ? (
                    <img src={npc.avatarUrl} alt={npc.name} class="w-10 h-10 rounded-full object-cover shrink-0" style="border:2px solid var(--border-gold);" />
                  ) : (
                    <div class="w-10 h-10 rounded-full flex items-center justify-center text-lg font-bold shrink-0" style="background:var(--bg-raised);border:2px solid var(--border-gold);color:var(--gold);font-family:'Cormorant Garamond',serif;">{npc.name.charAt(0)}</div>
                  )}
                  <div class="flex-1 min-w-0">
                    <div class="t-link font-medium truncate">{npc.name}</div>
                    <p class="t-faint text-xs truncate">{npc.race} - {npc.relationship}</p>
                  </div>
                  <span class="t-faint text-xs shrink-0">{sessionLabel(npcCounts.get(npc.id) ?? 0)}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        {relatedLocations.length > 0 && (
          <div class="t-panel p-6">
            <h3 class="t-section-h text-lg mb-4">Locations</h3>
            <div class="space-y-3">
              {relatedLocations.map(location => (
                <a href={`/locations/${location.id}`} class="t-row p-3 flex items-center gap-3">
                  {location.imageUrl ? (
                    <img src={location.imageUrl} alt={location.name} class="w-10 h-10 rounded-sm object-cover shrink-0" style="border:2px solid var(--border-gold);" />
                  ) : (
                    <div class="w-10 h-10 rounded-sm flex items-center justify-center text-lg font-bold shrink-0" style="background:var(--bg-raised);border:2px solid var(--border-gold);">📍</div>
                  )}
                  <div class="flex-1 min-w-0">
                    <div class="t-link font-medium truncate">{location.name}</div>
                    <p class="t-faint text-xs capitalize truncate">{location.type}</p>
                  </div>
                  <span class="t-faint text-xs shrink-0">{sessionLabel(locationCounts.get(location.id) ?? 0)}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        {relatedCharacters.length > 0 && (
          <div class="t-panel p-6">
            <h3 class="t-section-h text-lg mb-4">Party Members</h3>
            <div class="space-y-3">
              {relatedCharacters.map(character => (
                <a href={`/characters/${character.id}`} class="t-row p-3 flex items-center gap-3">
                  {character.avatarUrl ? (
                    <img src={character.avatarUrl} alt={character.name} class="w-10 h-10 rounded-full object-cover shrink-0" style="border:2px solid var(--border-gold);" />
                  ) : (
                    <div class="w-10 h-10 rounded-full flex items-center justify-center text-lg font-bold shrink-0" style="background:var(--bg-raised);border:2px solid var(--border-gold);color:var(--gold);font-family:'Cormorant Garamond',serif;">{character.name.charAt(0)}</div>
                  )}
                  <div class="flex-1 min-w-0">
                    <div class="t-link font-medium truncate">{character.name}</div>
                    <p class="t-faint text-xs truncate">Level {character.level} {character.race} {character.class}</p>
                  </div>
                  <span class="t-faint text-xs shrink-0">{sessionLabel(characterCounts.get(character.id) ?? 0)}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    )}

    <!-- Timeline events -->
    {timelineEntries.length > 0 && (
      <div class="t-panel p-6 sm:p-8 mb-6">
        <div class="t-section-header">
          <h2 class="t-section-h text-xl">On the Timeline</h2>
          <a href="/library/timeline" class="t-link ml-auto text-sm">Timeline →</a>
        </div>
        <ul class="space-y-3">
          {timelineEntries.map(entry => (
            <li class="pl-3" style="border-left:2px solid var(--border-gold);">
              <div class="t-body-text font-medium">{entry.headline}</div>
              <p class="t-faint text-xs">
                Year {entry.year}{entry.month ? `, month ${entry.month}` : ''}
                {entry.shortDescription && ` · ${entry.shortDescription}`}
              </p>
            </li>
          ))}
        </ul>
      </div>
    )}

  </div>
</Layout>

<script>
  function initializeQuestDetail() {
    const questId = document.getElementById('questDetail')?.getAttribute('data-id');
    if (!questId) return;

    document.getElementById('editQuest')?.addEventListener('click', () => {
      window.location.href = `/quests?edit=${questId}`;
    });

    document.querySelectorAll('.set-quest-status').forEach(button => {
      button.addEventListener('click', async () => {
        const status = button.getAttribute('data-status');
        try {
          const response = await fetch(`/api/quests/${questId}`);
          const quest = await response.json();
          const updateResponse = await fetch(`/api/quests/${questId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...quest, status }),
          });
          if (updateResponse.ok) {
            window.location.reload();
          } else {
            alert('Failed to update quest. Please try again.');
          }
        } catch {
          alert('An error occurred. Please try again.');
        }
      });
    });

    document.getElementById('deleteQuest')?.addEventListener('click', async () => {
      if ((await window.arandorConfirm('Delete this quest?', { detail: 'This can’t be undone.', confirmLabel: 'Delete', danger: true }))) {
        try {
          const response = await fetch(`/api/quests/${questId}`, { method: 'DELETE' });
          if (response.ok) {
            window.location.href = '/quests';
          } else {
            alert('Failed to delete quest. Please try again.');
          }
        } catch {
          alert('An error occurred. Please try again.');
        }
      }
    });
  }
  document.addEventListener('astro:page-load', initializeQuestDetail);
</script>

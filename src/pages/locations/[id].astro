---
import Layout from '../../layouts/Layout.astro';
import { db, Location, NPC, eq } from 'astro:db';
import { isAuthenticated } from '../../lib/auth';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/locations');
}

const locations = await db.select().from(Location).where(eq(Location.id, id));
const location = locations[0];

if (!location) {
  return Astro.redirect('/locations');
}

// Fetch all NPCs at this location
const npcsAtLocation = await db.select().from(NPC).where(eq(NPC.locationId, id));

const isLoggedIn = isAuthenticated(Astro.cookies);
---

<Layout title={location.name}>
  <div class="max-w-4xl mx-auto">
    <!-- Header with Back Button -->
    <div class="flex items-center justify-between mb-6">
      <a href="/locations" class="text-primary-600 hover:text-primary-800 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Locations
      </a>
      {isLoggedIn && (
        <div class="flex gap-2">
          <button 
            id="editLocation"
            data-id={location.id}
            class="bg-primary-600 text-white px-4 py-2 rounded-lg hover:bg-primary-700 transition"
          >
            Edit
          </button>
          <button 
            id="deleteLocation"
            data-id={location.id}
            class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition"
          >
            Delete
          </button>
        </div>
      )}
    </div>

    <!-- Location Header -->
    <article class="bg-white rounded-lg shadow-md overflow-hidden mb-6">
      <!-- Location Banner -->
      <div class={`h-48 relative ${
        location.type === 'city' ? 'bg-gradient-to-r from-blue-600 to-blue-500' :
        location.type === 'dungeon' ? 'bg-gradient-to-r from-purple-600 to-purple-500' :
        location.type === 'wilderness' ? 'bg-gradient-to-r from-green-600 to-green-500' :
        location.type === 'building' ? 'bg-gradient-to-r from-amber-600 to-amber-500' :
        'bg-gradient-to-r from-gray-600 to-gray-500'
      }`}>
        <div class="absolute bottom-8 left-8 text-white">
          <h1 class="text-5xl font-bold drop-shadow-lg">{location.name}</h1>
        </div>
      </div>

      <!-- Location Info -->
      <div class="p-8">
        <!-- Quick Info -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
          <div class={`p-4 rounded-lg ${
            location.type === 'city' ? 'bg-blue-50' :
            location.type === 'dungeon' ? 'bg-purple-50' :
            location.type === 'wilderness' ? 'bg-green-50' :
            location.type === 'building' ? 'bg-amber-50' :
            'bg-gray-50'
          }`}>
            <div class="text-sm text-gray-600 mb-1">Type</div>
            <div class={`text-2xl font-semibold ${
              location.type === 'city' ? 'text-blue-700' :
              location.type === 'dungeon' ? 'text-purple-700' :
              location.type === 'wilderness' ? 'text-green-700' :
              location.type === 'building' ? 'text-amber-700' :
              'text-gray-700'
            }`}>
              {location.type.charAt(0).toUpperCase() + location.type.slice(1)}
            </div>
          </div>
          {location.region && (
            <div class="bg-primary-50 p-4 rounded-lg">
              <div class="text-sm text-gray-600 mb-1">Region</div>
              <div class="text-2xl font-semibold text-primary-700">{location.region}</div>
            </div>
          )}
          <div class={`p-4 rounded-lg ${
            location.visited ? 'bg-green-50' : 'bg-gray-50'
          }`}>
            <div class="text-sm text-gray-600 mb-1">Status</div>
            <div class={`text-2xl font-semibold ${
              location.visited ? 'text-green-700' : 'text-gray-700'
            }`}>
              {location.visited ? '✓ Visited' : 'Not Visited'}
            </div>
          </div>
        </div>
      </div>
    </article>

    <!-- Description Section -->
    <div class="bg-white rounded-lg shadow-md p-8 mb-6">
      <h2 class="text-2xl font-bold text-primary-700 mb-4">Description</h2>
      <p class="text-lg text-gray-800 leading-relaxed">{location.description}</p>
    </div>

    <!-- Notes Section -->
    {location.notes && (
      <div class="bg-white rounded-lg shadow-md p-8 mb-6">
        <h2 class="text-2xl font-bold text-primary-700 mb-4">Notes</h2>
        <div class="bg-blue-50 border-l-4 border-blue-500 p-4 rounded">
          <p class="text-gray-800 leading-relaxed">{location.notes}</p>
        </div>
      </div>
    )}

    <!-- NPCs at this Location -->
    {npcsAtLocation.length > 0 && (
      <div class="bg-white rounded-lg shadow-md p-8 mb-6">
        <h2 class="text-2xl font-bold text-primary-700 mb-6">NPCs at this Location</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {npcsAtLocation.map(npc => (
            <a 
              href={`/npcs/${npc.id}`}
              class="flex items-center gap-4 p-4 border border-gray-200 rounded-lg hover:bg-gray-50 hover:border-primary-300 transition"
            >
              {npc.avatarUrl ? (
                <img 
                  src={npc.avatarUrl} 
                  alt={npc.name}
                  class="w-16 h-16 rounded-full object-cover border-2 border-gray-200"
                />
              ) : (
                <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center text-2xl font-bold text-primary-700">
                  {npc.name.charAt(0)}
                </div>
              )}
              <div class="flex-1">
                <h3 class="font-bold text-gray-900">{npc.name}</h3>
                <p class="text-sm text-gray-600">{npc.race} {npc.occupation && `• ${npc.occupation}`}</p>
                <span class={`inline-block mt-1 px-2 py-1 rounded text-xs font-medium ${
                  npc.relationship === 'ally' ? 'bg-green-100 text-green-700' :
                  npc.relationship === 'enemy' ? 'bg-red-100 text-red-700' :
                  'bg-gray-100 text-gray-700'
                }`}>
                  {npc.relationship}
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>

<script>
  const deleteBtn = document.getElementById('deleteLocation');
  const editBtn = document.getElementById('editLocation');
  
  // Handle edit button click
  if (editBtn) {
    editBtn.addEventListener('click', () => {
      const id = editBtn.getAttribute('data-id');
      if (id) {
        window.location.href = `/locations?edit=${id}`;
      }
    });
  }
  
  if (deleteBtn) {
    deleteBtn.addEventListener('click', async () => {
      const id = deleteBtn.getAttribute('data-id');
      if (!id) return;
      
      if (confirm('Are you sure you want to delete this location?')) {
        try {
          const response = await fetch(`/api/locations/${id}`, {
            method: 'DELETE',
          });
          
          if (response.ok) {
            window.location.href = '/locations';
          } else {
            const error = await response.json().catch(() => ({ error: 'Unknown error' }));
            alert(`Failed to delete location: ${error.error || response.statusText}`);
          }
        } catch (error) {
          console.error('Delete error:', error);
          alert('An error occurred while deleting the location. Please check your connection and try again.');
        }
      }
    });
  }
</script>

---
import Layout from '../../layouts/Layout.astro';
import SceneBackdrop from '../../components/SceneBackdrop.astro';
import { db, Location, NPC, LibraryEntry, DiaryEntry, eq } from '@/db';
import { isAuthenticated } from '../../lib/auth';
import { renderMarkdown } from '../../utils/markdown';

const { id } = Astro.params;
if (!id) return Astro.redirect('/locations');

const locations = await db.select().from(Location).where(eq(Location.id, id));
const location = locations[0];
if (!location) return Astro.redirect('/locations');

const npcsAtLocation = await db.select().from(NPC).where(eq(NPC.locationId, id));
const libraryEntries = await db.select().from(LibraryEntry).where(eq(LibraryEntry.locationId, id));
const allDiaryEntries = await db.select().from(DiaryEntry);
const relatedDiaryEntries = allDiaryEntries.filter(entry => {
  const locationIds = Array.isArray(entry.locationIds) ? entry.locationIds : [];
  return locationIds.includes(id);
}).sort((a, b) => b.session - a.session);

const isLoggedIn = isAuthenticated(Astro.cookies);
const renderedDescription = renderMarkdown(location.description);

const heroBg = `place-bg-${['city', 'dungeon', 'wilderness', 'building'].includes(location.type) ? location.type : 'other'}`;

const npcRelBadge = (rel: string) =>
  rel === 'ally' ? 't-badge-green' : rel === 'enemy' ? 't-badge-red' : '';
---

<Layout title={location.name}>
  <SceneBackdrop imageUrl={location.imageUrl} />
  <div class="max-w-4xl mx-auto px-1 sm:px-0">

    <!-- Nav row -->
    <div class="flex items-center justify-between mb-6">
      <a href="/locations" class="t-back-link">
        <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/>
        </svg>
        All locations
      </a>
      {isLoggedIn && (
        <div class="flex gap-2">
          <button id="editLocation" data-id={location.id} class="t-icon-btn" title="Edit location" aria-label="Edit location">
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </button>
          <button id="deleteLocation" data-id={location.id} class="t-icon-btn t-icon-btn-danger" title="Delete location" aria-label="Delete location">
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
          </button>
        </div>
      )}
    </div>

    <!-- Location header card -->
    <div class="t-panel overflow-hidden mb-6">
      <div class:list={['t-hero-banner', heroBg, { 't-hero-banner-photo': location.imageUrl }]}>
        {location.imageUrl && (
          <img src={location.imageUrl} alt={location.name}
            class="absolute inset-0 w-full h-full object-cover"/>
        )}
        <div class="t-hero-banner-content">
          <h1 class="font-display italic font-semibold text-3xl sm:text-4xl md:text-5xl leading-tight mb-2"
            style="color:#fff;text-shadow:0 2px 20px rgba(0,0,0,0.8);">{location.name}</h1>
          <div class="flex flex-wrap gap-2">
            <span class="t-badge" style="backdrop-filter:blur(8px);background:rgba(8,6,3,0.6);border-color:rgba(201,144,50,0.3);">
              {location.type.charAt(0).toUpperCase() + location.type.slice(1)}
            </span>
            {location.visited && (
              <span class="t-badge t-badge-green" style="backdrop-filter:blur(8px);">✓ Visited</span>
            )}
          </div>
        </div>
      </div>

      <!-- Quick facts -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-px" style="background:var(--border-gold);">
        <div class="px-5 py-4" style="background:var(--bg-surface);">
          <div class="t-field-label">Type</div>
          <div class="t-field-value font-medium capitalize">{location.type}</div>
        </div>
        {location.region && (
          <div class="px-5 py-4" style="background:var(--bg-surface);">
            <div class="t-field-label">Region</div>
            <div class="t-field-value font-medium">{location.region}</div>
          </div>
        )}
        <div class="px-5 py-4" style="background:var(--bg-surface);">
          <div class="t-field-label">Status</div>
          {location.visited ? (
            <span class="t-badge t-badge-green">✓ Visited</span>
          ) : (
            <span class="t-muted text-sm font-medium">Not Visited</span>
          )}
        </div>
      </div>
    </div>

    <!-- Description -->
    {location.description && (
      <div class="t-panel p-6 sm:p-8 mb-6">
        <div class="t-section-header">
          <h2 class="t-section-h text-xl">Description</h2>
        </div>
        <div class="t-prose" set:html={renderedDescription}/>
      </div>
    )}

    <!-- Notes -->
    {location.notes && (
      <div class="t-panel p-6 sm:p-8 mb-6">
        <div class="t-section-header">
          <h2 class="t-section-h text-xl">Notes</h2>
        </div>
        <div class="t-callout">
          <p class="t-body-text leading-relaxed">{location.notes}</p>
        </div>
      </div>
    )}

    <!-- NPCs here -->
    {npcsAtLocation.length > 0 && (
      <div class="t-panel p-6 sm:p-8 mb-6">
        <div class="t-section-header">
          <h2 class="t-section-h text-xl">Inhabitants</h2>
          <span class="t-badge t-badge-gold ml-auto">{npcsAtLocation.length}</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {npcsAtLocation.map(npc => (
            <a href={`/npcs/${npc.id}`} class="t-row p-4 flex items-center gap-3">
              {npc.avatarUrl ? (
                <img src={npc.avatarUrl} alt={npc.name}
                  class="w-16 h-16 rounded-full object-cover shrink-0"
                  style="border:2px solid var(--border-gold);"/>
              ) : (
                <div class="w-16 h-16 rounded-full shrink-0 flex items-center justify-center text-2xl font-bold"
                  style="background:var(--bg-raised);border:2px solid var(--border-gold);color:var(--gold);font-family:'Cormorant Garamond',serif;">
                  {npc.name.charAt(0)}
                </div>
              )}
              <div class="min-w-0">
                <div class="t-body-text font-medium truncate">{npc.name}</div>
                <div class="t-faint text-xs">{[npc.race, npc.occupation].filter(Boolean).join(' · ')}</div>
                <span class={`t-badge ${npcRelBadge(npc.relationship)} mt-1`}>{npc.relationship}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Library entries -->
    {libraryEntries.length > 0 && (
      <div class="t-panel p-6 sm:p-8 mb-6">
        <div class="t-section-header">
          <h2 class="t-section-h text-xl">Lore &amp; Records</h2>
          <span class="t-badge t-badge-gold ml-auto">{libraryEntries.length}</span>
        </div>
        <div class="flex flex-col gap-3">
          {libraryEntries.map(entry => (
            <a href={`/library/${entry.id}`} class="t-row p-4">
              <div class="t-body-text font-medium mb-1">{entry.title}</div>
              <div class="t-faint text-xs line-clamp-2">
                {entry.content.substring(0, 140)}{entry.content.length > 140 ? '…' : ''}
              </div>
              {Array.isArray(entry.tags) && entry.tags.length > 0 && (
                <div class="flex gap-1.5 flex-wrap mt-2">
                  {entry.tags.map((tag: string) => (
                    <span class="t-badge t-badge-gold">#{tag}</span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Diary appearances -->
    {relatedDiaryEntries.length > 0 && (
      <div class="t-panel p-6 sm:p-8 mb-6">
        <div class="t-section-header">
          <h2 class="t-section-h text-xl">Diary Appearances</h2>
          <span class="t-badge t-badge-gold ml-auto">{relatedDiaryEntries.length}</span>
        </div>
        <div class="flex flex-col gap-3">
          {relatedDiaryEntries.map(entry => (
            <a href={`/diary/${entry.id}`} class="t-row p-4 flex items-start justify-between gap-4">
              <div class="min-w-0">
                <div class="t-body-text font-medium truncate">{entry.title}</div>
                <div class="t-faint text-xs mt-0.5 line-clamp-2">
                  {entry.content.substring(0, 120)}{entry.content.length > 120 ? '…' : ''}
                </div>
                {Array.isArray(entry.tags) && entry.tags.length > 0 && (
                  <div class="flex gap-1.5 flex-wrap mt-2">
                    {entry.tags.slice(0, 3).map((tag: string) => (
                      <span class="t-badge t-badge-gold">#{tag}</span>
                    ))}
                    {entry.tags.length > 3 && <span class="t-faint text-xs">+{entry.tags.length - 3}</span>}
                  </div>
                )}
              </div>
              <span class="t-badge t-badge-accent shrink-0">Session {entry.session}</span>
            </a>
          ))}
        </div>
      </div>
    )}

  </div>
</Layout>

<script>
  function initializeDetailPage() {
    document.getElementById('editLocation')?.addEventListener('click', () => {
      const id = document.getElementById('editLocation')?.getAttribute('data-id');
      if (id) window.location.href = `/locations?edit=${id}`;
    });
    document.getElementById('deleteLocation')?.addEventListener('click', async () => {
      const id = document.getElementById('deleteLocation')?.getAttribute('data-id');
      if (!id) return;
      if ((await window.arandorConfirm('Delete this location?', { detail: 'This can\u2019t be undone.', confirmLabel: 'Delete', danger: true }))) {
        try {
          const response = await fetch(`/api/locations/${id}`, { method: 'DELETE' });
          if (response.ok) {
            window.location.href = '/locations';
          } else {
            const error = await response.json().catch(() => ({ error: 'Unknown error' }));
            alert(`Failed to delete location: ${error.error || response.statusText}`);
          }
        } catch { alert('An error occurred while deleting the location.'); }
      }
    });
  }
  document.addEventListener('astro:page-load', initializeDetailPage);
</script>

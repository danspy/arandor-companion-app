---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import StatsGrid from '../components/StatsGrid.astro';
import { db, Event, User, PageSettings, eq } from 'astro:db';
import { isAuthenticated, getUserRole } from '../lib/auth';

// Calendar page is only accessible to logged-in users
const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);

if (!isLoggedIn) {
  return Astro.redirect('/login');
}

const events = await db.select().from(Event);
const users = await db.select().from(User);
// All logged-in users can add/edit events
const canEdit = isLoggedIn;
// Only admin/DM can edit hero image
const canEditHero = userRole === 'admin' || userRole === 'dungeonmaster';

// Filter out admin users for host dropdown
const nonAdminUsers = users.filter(u => u.role !== 'admin');

// Sort events by date and time (upcoming first)
const sortedEvents = [...events].sort((a, b) => {
  const dateTimeA = new Date(`${a.date}T${a.time}`).getTime();
  const dateTimeB = new Date(`${b.date}T${b.time}`).getTime();
  return dateTimeA - dateTimeB;
});

// Calculate upcoming and past events counts
const now = new Date();
const upcomingEventsCount = sortedEvents.filter(e => new Date(`${e.date}T${e.time}`) >= now).length;
const pastEventsCount = sortedEvents.length - upcomingEventsCount;

// Get page settings for hero image
const pageSettings = await db.select().from(PageSettings).where(eq(PageSettings.pageName, 'calendar'));
const heroImageUrl = pageSettings.length > 0 ? pageSettings[0].heroImageUrl : null;

// Helper function to format date
function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });
}

// Helper function to format duration
function formatDuration(minutes: number | null): string {
  if (!minutes) return '';
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  if (hours > 0 && mins > 0) return `${hours}h ${mins}m`;
  if (hours > 0) return `${hours}h`;
  return `${mins}m`;
}

// Helper function to get host info
function getHostInfo(hostId: string | null): { name: string, imageUrl: string | null } {
  if (!hostId) {
    return {
      name: 'TBD',
      imageUrl: null
    };
  }
  const host = users.find(u => u.id === hostId);
  return {
    name: host ? (host.firstName || host.username) : 'Unknown',
    imageUrl: host?.profileImageUrl || null
  };
}

// Helper function to get host name (for backward compatibility)
function getHostName(hostId: string | null): string {
  return getHostInfo(hostId).name;
}
---

<Layout title="Calendar">
  <PageHero 
    title="Calendar" 
    heroImageUrl={heroImageUrl}
    pageName="calendar"
    canEditHero={canEditHero}
  />

  {canEdit && (
    <div class="flex justify-end mb-4">
      <Button 
        variant="primary"
        size="md"
        icon="add"
        id="addEvent"
        title="Add new event"
      >
        Add Event
      </Button>
    </div>
  )}

  <!-- Calendar Subscription Section -->
  <div class="bg-gradient-to-br from-primary-50 to-secondary-50 dark:from-gray-800 dark:to-gray-900 rounded-lg shadow-md mb-6 dark:border dark:border-gray-700 overflow-hidden">
    <!-- Accordion Header -->
    <button 
      id="subscriptionAccordionToggle"
      class="w-full p-4 flex items-center justify-between"
      aria-expanded="false"
      aria-controls="subscriptionAccordionContent"
    >
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-primary-700 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <h2 class="text-lg font-semibold text-primary-700 dark:text-primary-400">
          Subscribe to Calendar
        </h2>
      </div>
      <svg 
        id="subscriptionAccordionIcon" 
        class="w-5 h-5 text-primary-700 dark:text-primary-400 transition-transform duration-200"
        fill="none" 
        stroke="currentColor" 
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
    </button>
    
    <!-- Accordion Content -->
    <div 
      id="subscriptionAccordionContent"
      class="overflow-hidden transition-all duration-300 ease-in-out max-h-0"
      aria-hidden="true"
    >
      <div class="p-6 pt-0 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex-1">
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
            Add this calendar to Google Calendar, Apple Calendar, Outlook, or any calendar app that supports iCal subscriptions.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button
            id="copyCalendarUrl"
            class="flex items-center gap-2 px-4 py-2 bg-primary-600 hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 text-white rounded-lg transition-all duration-200 hover:shadow-md active:scale-95"
            title="Copy subscription URL"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
            <span>Copy URL</span>
          </button>
          <button
            id="downloadCalendar"
            class="flex items-center gap-2 px-4 py-2 bg-secondary-600 hover:bg-secondary-700 dark:bg-secondary-700 dark:hover:bg-secondary-600 text-white rounded-lg transition-all duration-200 hover:shadow-md active:scale-95"
            title="Download calendar file"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span>Download</span>
          </button>
          <button
            id="showInstructions"
            class="flex items-center gap-2 px-4 py-2 bg-accent-600 hover:bg-accent-700 dark:bg-accent-700 dark:hover:bg-accent-600 text-white rounded-lg transition-all duration-200 hover:shadow-md active:scale-95"
            title="Show subscription instructions"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="hidden md:inline">Instructions</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <StatsGrid 
    stats={[
      { label: 'Total Events', value: events.length, color: 'primary' },
      { label: 'Upcoming', value: upcomingEventsCount, color: 'accent' },
      { label: 'Past', value: pastEventsCount, color: 'gray' }
    ]}
    columns={3}
  />

  <!-- Filter -->
  <div class="bg-white dark:bg-black rounded-lg shadow-md p-4 mb-6 dark:border dark:border-gray-900">
    <div class="flex flex-wrap gap-2 items-center">
      <span class="text-sm text-gray-600 dark:text-gray-400 font-medium">Filter:</span>
      <button 
        class="event-filter px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95"
        data-filter="all"
      >
        All ({events.length})
      </button>
      <button 
        class="event-filter px-3 py-1.5 rounded-full text-sm font-medium bg-primary-600 text-white transition-all duration-200 hover:bg-primary-700 active:scale-95"
        data-filter="upcoming"
      >
        Upcoming ({upcomingEventsCount})
      </button>
      <button 
        class="event-filter px-3 py-1.5 rounded-full text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 transition-all duration-200 hover:bg-gray-300 dark:hover:bg-gray-600 hover:shadow-md active:scale-95"
        data-filter="past"
      >
        Past ({pastEventsCount})
      </button>
    </div>
  </div>

  <!-- Events List -->
  <div class="space-y-4">
    {events.length === 0 ? (
      <div class="bg-white dark:bg-black rounded-lg shadow-md p-8 text-center dark:border dark:border-gray-900">
        <svg class="w-16 h-16 mx-auto text-gray-400 dark:text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <p class="text-gray-500 dark:text-gray-400 text-lg">No events scheduled yet</p>
        {canEdit && (
          <p class="text-gray-400 dark:text-gray-500 text-sm mt-2">Click "Add Event" to create your first event</p>
        )}
      </div>
    ) : (
      sortedEvents.map(event => {
        const eventDateTime = new Date(`${event.date}T${event.time}`);
        const isPast = eventDateTime < new Date();
        const filterStatus = isPast ? 'past' : 'upcoming';
        
        return (
          <div class={`bg-white dark:bg-black rounded-lg shadow-md p-6 dark:border dark:border-gray-900 event-item ${isPast ? 'opacity-60' : ''}`} data-event-id={event.id} data-filter-status={filterStatus}>
            <div class="flex justify-between items-start mb-4">
              <div class="flex-1">
                <div class="flex items-center justify-between gap-3 mb-2">
                  <h3 class="text-xl flex items-center gap-2 font-semibold text-primary-700 dark:text-primary-400">
                    {event.title}
                    {isPast && (
                      <span class="text-xs px-2 py-1 bg-gray-200 dark:bg-gray-700 text-gray-600 dark:text-gray-400 rounded">Past</span>
                    )}
                  </h3>
                  {canEdit && (
                    <div class="flex gap-2 ml-4">
                      <button 
                        class="edit-event-btn text-gray-600 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400 p-2"
                        data-event-id={event.id}
                        data-event-title={event.title}
                        data-event-description={event.description}
                        data-event-date={event.date}
                        data-event-time={event.time}
                        data-event-duration={event.duration}
                        data-event-host-id={event.hostId}
                        title="Edit event"
                      >
                        <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                        </svg>
                      </button>
                      <button 
                        class="delete-event-btn text-gray-600 hover:text-red-600 dark:text-gray-400 dark:hover:text-red-400 p-2"
                        data-event-id={event.id}
                        title="Delete event"
                      >
                        <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                      </button>
                    </div>
                  )}
                </div>
                {event.description && (
                  <p class="text-gray-600 dark:text-gray-400 mb-3">{event.description}</p>
                )}
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-sm">
                  <div class="flex items-center gap-3 bg-white dark:bg-gray-800/50 rounded-lg p-3">
                    <div class="flex-shrink-0 w-10 h-10 bg-primary-100 dark:bg-primary-900/40 rounded-full flex items-center justify-center">
                      <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                      </svg>
                    </div>
                    <div>
                      <div class="text-xs text-gray-500 dark:text-gray-400">Date</div>
                      <div class="font-semibold text-gray-800 dark:text-gray-200">{formatDate(event.date)}</div>
                    </div>
                  </div>
                  <div class="flex items-center gap-3 bg-white dark:bg-gray-800/50 rounded-lg p-3">
                    <div class="flex-shrink-0 w-10 h-10 bg-secondary-100 dark:bg-secondary-900/40 rounded-full flex items-center justify-center">
                      <svg class="w-5 h-5 text-secondary-600 dark:text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                    </div>
                    <div>
                      <div class="text-xs text-gray-500 dark:text-gray-400">Time & Duration</div>
                      <div class="font-semibold text-gray-800 dark:text-gray-200">{event.time}{event.duration ? ` (${formatDuration(event.duration)})` : ''}</div>
                    </div>
                  </div>
                  <div class="flex items-center gap-3 bg-white dark:bg-gray-800/50 rounded-lg p-3">
                    <div class="flex-shrink-0 w-10 h-10 bg-accent-100 dark:bg-accent-900/40 rounded-full flex items-center justify-center overflow-hidden">
                      {getHostInfo(event.hostId).imageUrl ? (
                        <img 
                          src={getHostInfo(event.hostId).imageUrl} 
                          alt={getHostInfo(event.hostId).name}
                          class="w-full h-full object-cover"
                        />
                      ) : (
                        <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                      )}
                    </div>
                    <div>
                      <div class="text-xs text-gray-500 dark:text-gray-400">Host</div>
                      <div class="font-semibold text-gray-800 dark:text-gray-200">{getHostName(event.hostId)}</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        );
      })
    )}
  </div>

  <!-- Event Modal (Add/Edit) -->
  {canEdit && (
    <div id="eventModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4 modal-overlay-safe">
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-lg w-full p-6 dark:border dark:border-gray-700 modal-content-safe max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-6">
          <h3 id="eventModalTitle" class="text-xl font-semibold text-primary-700 dark:text-primary-400">Add Event</h3>
          <button id="closeEventModalBtn" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
            <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        
        <form id="eventForm" class="space-y-4">
          <input type="hidden" id="eventId" name="eventId" value="" />
          
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Event Title <span class="text-red-500">*</span>
            </label>
            <input 
              type="text" 
              id="eventTitle" 
              name="eventTitle" 
              placeholder="Enter event title"
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-gray-100"
              required
            />
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Description
            </label>
            <textarea 
              id="eventDescription" 
              name="eventDescription" 
              placeholder="Enter event description (optional)"
              rows="3"
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-gray-100"
            ></textarea>
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                Date <span class="text-red-500">*</span>
              </label>
              <input 
                type="date" 
                id="eventDate" 
                name="eventDate" 
                class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-gray-100"
                required
              />
            </div>
            
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                Time <span class="text-red-500">*</span>
              </label>
              <input 
                type="time" 
                id="eventTime" 
                name="eventTime" 
                class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-gray-100"
                required
              />
            </div>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Duration (minutes)
            </label>
            <input 
              type="number" 
              id="eventDuration" 
              name="eventDuration" 
              placeholder="120 (optional)"
              min="15"
              step="15"
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-gray-100"
            />
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Host
            </label>
            <select 
              id="eventHost" 
              name="eventHost"
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-gray-100"
            >
              <option value="">None / TBD</option>
              {nonAdminUsers.map(user => (
                <option value={user.id}>{user.firstName || user.username}</option>
              ))}
            </select>
          </div>
          
          <div class="flex gap-3 pt-4">
            <button 
              type="submit" 
              class="flex-1 bg-primary-600 hover:bg-primary-700 dark:bg-primary-700 dark:hover:bg-primary-600 text-white px-4 py-2 rounded-lg transition"
            >
              Save Event
            </button>
            <button 
              type="button" 
              id="cancelEventBtn"
              class="flex-1 bg-gray-300 hover:bg-gray-400 dark:bg-gray-600 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 px-4 py-2 rounded-lg transition"
            >
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>
  )}

  <!-- Instructions Modal -->
  <div id="instructionsModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4 modal-overlay-safe">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-2xl w-full p-6 dark:border dark:border-gray-700 modal-content-safe max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-6">
        <h3 class="text-xl font-semibold text-primary-700 dark:text-primary-400">Calendar Subscription Instructions</h3>
        <button id="closeInstructionsBtn" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
          <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      
      <div class="space-y-6">
        <!-- Subscription URL -->
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
            Calendar Subscription URL
          </label>
          <div class="flex gap-2">
            <input 
              type="text" 
              id="calendarUrlDisplay" 
              readonly
              class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-900 dark:text-gray-100 font-mono text-sm"
            />
            <button 
              id="copyUrlBtn"
              class="px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition"
            >
              Copy
            </button>
          </div>
        </div>

        <!-- Google Calendar Instructions -->
        <div class="border-t dark:border-gray-700 pt-4">
          <h4 class="font-semibold text-gray-900 dark:text-gray-100 mb-2 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.383 0 0 5.383 0 12s5.383 12 12 12 12-5.383 12-12S18.617 0 12 0zm-1 18h-2v-8h2v8zm0-10h-2V6h2v2zm5 10h-2v-5h2v5zm0-7h-2V9h2v2z"/>
            </svg>
            Google Calendar
          </h4>
          <ol class="list-decimal list-inside space-y-2 text-sm text-gray-600 dark:text-gray-400">
            <li>Open <a href="https://calendar.google.com" target="_blank" class="text-primary-600 hover:underline">Google Calendar</a></li>
            <li>Click the "+" next to "Other calendars" on the left sidebar</li>
            <li>Select "From URL"</li>
            <li>Paste the subscription URL above</li>
            <li>Click "Add calendar"</li>
          </ol>
        </div>

        <!-- Apple Calendar Instructions -->
        <div class="border-t dark:border-gray-700 pt-4">
          <h4 class="font-semibold text-gray-900 dark:text-gray-100 mb-2 flex items-center gap-2">
            <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            Apple Calendar (macOS/iOS)
          </h4>
          <ol class="list-decimal list-inside space-y-2 text-sm text-gray-600 dark:text-gray-400">
            <li>Open the Calendar app</li>
            <li>On Mac: Go to File → New Calendar Subscription</li>
            <li>On iPhone/iPad: Go to Settings → Calendar → Accounts → Add Account → Other → Add Subscribed Calendar</li>
            <li>Paste the subscription URL above</li>
            <li>Click "Subscribe" and customize the settings as desired</li>
          </ol>
        </div>

        <!-- Outlook Instructions -->
        <div class="border-t dark:border-gray-700 pt-4">
          <h4 class="font-semibold text-gray-900 dark:text-gray-100 mb-2 flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
              <path d="M7.88 12.04q0 .45-.11.87-.1.41-.33.74-.22.33-.58.52-.37.2-.87.2t-.85-.2q-.35-.21-.57-.55-.22-.33-.33-.75-.1-.42-.1-.87 0-.44.11-.86.1-.43.33-.75.22-.32.57-.51.35-.19.85-.19t.86.19q.35.18.58.51.22.32.33.75.1.42.1.86M24 12v9.38q0 .46-.33.8-.33.32-.8.32H7.13q-.46 0-.8-.33-.32-.33-.32-.8V18H1q-.41 0-.7-.3-.3-.29-.3-.7V7q0-.41.3-.7Q.58 6 1 6h6.5V2.62q0-.48.33-.8.33-.33.8-.33h14.75q.46 0 .8.33.32.32.32.8z"/>
            </svg>
            Microsoft Outlook
          </h4>
          <ol class="list-decimal list-inside space-y-2 text-sm text-gray-600 dark:text-gray-400">
            <li>Open <a href="https://outlook.live.com/calendar" target="_blank" class="text-primary-600 hover:underline">Outlook Calendar</a></li>
            <li>Click "Add calendar" in the left sidebar</li>
            <li>Select "Subscribe from web"</li>
            <li>Paste the subscription URL above</li>
            <li>Enter a calendar name and click "Import"</li>
          </ol>
        </div>

        <!-- Android Instructions -->
        <div class="border-t dark:border-gray-700 pt-4">
          <h4 class="font-semibold text-gray-900 dark:text-gray-100 mb-2 flex items-center gap-2">
            <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.6 9.48l1.84-3.18c.16-.31.04-.69-.26-.85-.29-.15-.65-.06-.83.22l-1.88 3.24a11.43 11.43 0 0 0-8.94 0L5.65 5.67c-.19-.28-.54-.37-.83-.22-.3.16-.42.54-.26.85l1.84 3.18C2.92 12.3 1.11 16.91 1 22h22c-.11-5.09-1.92-9.7-5.4-12.52M7 18c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1m10 0c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1"/>
            </svg>
            Android
          </h4>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            Most Android calendar apps don't support direct URL subscriptions. We recommend:
          </p>
          <ul class="list-disc list-inside space-y-1 text-sm text-gray-600 dark:text-gray-400 mt-2 ml-4">
            <li>Use Google Calendar app and follow the Google Calendar instructions above</li>
            <li>Or download the calendar file using the "Download" button and import it manually (note: this is a one-time import, not a subscription)</li>
          </ul>
        </div>

        <!-- Note about updates -->
        <div class="border-t dark:border-gray-700 pt-4">
          <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4">
            <div class="flex gap-3">
              <svg class="w-5 h-5 text-blue-600 dark:text-blue-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div class="text-sm text-blue-800 dark:text-blue-200">
                <p class="font-medium mb-1">Calendar Updates</p>
                <p>When you subscribe to the calendar, your calendar app will automatically check for updates. Any new events or changes will appear in your calendar within a few hours.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="flex justify-end gap-3 mt-6 pt-4 border-t dark:border-gray-700">
        <button 
          id="closeInstructionsBtn2"
          class="px-4 py-2 bg-gray-300 hover:bg-gray-400 dark:bg-gray-600 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-lg transition"
        >
          Close
        </button>
      </div>
    </div>
  </div>

  <script>
    function initializeCalendar() {
      const addEventBtn = document.getElementById('addEvent');
      const eventModal = document.getElementById('eventModal');
      const eventModalTitle = document.getElementById('eventModalTitle');
      const closeEventModalBtn = document.getElementById('closeEventModalBtn');
      const cancelEventBtn = document.getElementById('cancelEventBtn');
      const eventForm = document.getElementById('eventForm');
      const eventIdInput = document.getElementById('eventId');
      const eventTitleInput = document.getElementById('eventTitle');
      const eventDescriptionInput = document.getElementById('eventDescription');
      const eventDateInput = document.getElementById('eventDate');
      const eventTimeInput = document.getElementById('eventTime');
      const eventDurationInput = document.getElementById('eventDuration');
      const eventHostSelect = document.getElementById('eventHost');

      // Accordion functionality
      const accordionToggle = document.getElementById('subscriptionAccordionToggle');
      const accordionContent = document.getElementById('subscriptionAccordionContent');
      const accordionIcon = document.getElementById('subscriptionAccordionIcon');

      accordionToggle?.addEventListener('click', () => {
        const isExpanded = accordionToggle.getAttribute('aria-expanded') === 'true';
        
        if (isExpanded) {
          // Collapse
          accordionToggle.setAttribute('aria-expanded', 'false');
          accordionContent?.setAttribute('aria-hidden', 'true');
          accordionContent?.classList.remove('max-h-96');
          accordionContent?.classList.add('max-h-0');
          accordionIcon?.classList.remove('rotate-180');
        } else {
          // Expand
          accordionToggle.setAttribute('aria-expanded', 'true');
          accordionContent?.setAttribute('aria-hidden', 'false');
          accordionContent?.classList.remove('max-h-0');
          accordionContent?.classList.add('max-h-96');
          accordionIcon?.classList.add('rotate-180');
        }
      });

      // Calendar subscription elements
      const copyCalendarUrlBtn = document.getElementById('copyCalendarUrl');
      const downloadCalendarBtn = document.getElementById('downloadCalendar');
      const showInstructionsBtn = document.getElementById('showInstructions');
      const instructionsModal = document.getElementById('instructionsModal');
      const closeInstructionsBtn = document.getElementById('closeInstructionsBtn');
      const closeInstructionsBtn2 = document.getElementById('closeInstructionsBtn2');
      const calendarUrlDisplay = document.getElementById('calendarUrlDisplay');
      const copyUrlBtn = document.getElementById('copyUrlBtn');

      // Get the calendar subscription URL
      const calendarUrl = `${window.location.origin}/api/calendar/ics.ics`;
      if (calendarUrlDisplay) {
        calendarUrlDisplay.value = calendarUrl;
      }

      // Copy calendar URL functionality with fallback
      const copyToClipboard = async (text: string) => {
        // Try modern clipboard API first
        if (navigator.clipboard && window.isSecureContext) {
          try {
            await navigator.clipboard.writeText(text);
            return { success: true, method: 'clipboard' };
          } catch (err) {
            console.error('Failed to copy with clipboard API:', err);
          }
        }
        
        // Fallback to text selection method
        try {
          const textArea = document.createElement('textarea');
          textArea.value = text;
          textArea.style.position = 'fixed';
          textArea.style.left = '-999999px';
          textArea.style.top = '-999999px';
          document.body.appendChild(textArea);
          textArea.focus();
          textArea.select();
          const successful = document.execCommand('copy');
          textArea.remove();
          return { success: successful, method: 'execCommand' };
        } catch (err) {
          console.error('Failed to copy with fallback method:', err);
          return { success: false, method: 'none' };
        }
      };

      copyCalendarUrlBtn?.addEventListener('click', async () => {
        const result = await copyToClipboard(calendarUrl);
        if (result.success) {
          const originalText = copyCalendarUrlBtn.innerHTML;
          copyCalendarUrlBtn.innerHTML = `
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Copied!</span>
          `;
          setTimeout(() => {
            copyCalendarUrlBtn.innerHTML = originalText;
          }, 2000);
        } else {
          alert('Could not copy to clipboard. Please copy the URL manually from the instructions dialog.');
        }
      });

      copyUrlBtn?.addEventListener('click', async () => {
        const result = await copyToClipboard(calendarUrl);
        if (result.success) {
          copyUrlBtn.textContent = 'Copied!';
          setTimeout(() => {
            copyUrlBtn.textContent = 'Copy';
          }, 2000);
        } else {
          alert('Could not copy to clipboard. Please select and copy the URL manually.');
        }
      });

      // Download calendar file
      downloadCalendarBtn?.addEventListener('click', () => {
        window.location.href = calendarUrl;
      });

      // Show instructions modal
      showInstructionsBtn?.addEventListener('click', () => {
        instructionsModal?.classList.remove('hidden');
      });

      // Close instructions modal
      const closeInstructions = () => {
        instructionsModal?.classList.add('hidden');
      };

      closeInstructionsBtn?.addEventListener('click', closeInstructions);
      closeInstructionsBtn2?.addEventListener('click', closeInstructions);

      // Close modal on background click
      instructionsModal?.addEventListener('click', (e) => {
        if (e.target === instructionsModal) {
          closeInstructions();
        }
      });

      // Filter functionality
      let currentFilter = 'upcoming'; // Default to upcoming
      const filterButtons = document.querySelectorAll('.event-filter');
      const eventItems = document.querySelectorAll('.event-item');

      function applyFilter(filter) {
        currentFilter = filter;
        
        // Update button styles
        filterButtons.forEach(btn => {
          const isActive = btn.getAttribute('data-filter') === filter;
          if (isActive) {
            btn.classList.remove('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
            btn.classList.add('bg-primary-600', 'text-white');
          } else {
            btn.classList.remove('bg-primary-600', 'text-white');
            btn.classList.add('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
          }
        });

        // Filter events
        eventItems.forEach(item => {
          const filterStatus = item.getAttribute('data-filter-status');
          if (filter === 'all' || filterStatus === filter) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      }

      // Set up filter button listeners
      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');
          applyFilter(filter);
        });
      });

      // Apply default filter on page load
      applyFilter(currentFilter);

      const closeEventModal = () => {
        eventModal?.classList.add('hidden');
        // Reset form
        if (eventForm) eventForm.reset();
        if (eventIdInput) eventIdInput.value = '';
        if (eventModalTitle) eventModalTitle.textContent = 'Add Event';
      };

      // Add Event button
      addEventBtn?.addEventListener('click', () => {
        closeEventModal(); // Reset first
        eventModal?.classList.remove('hidden');
      });

      closeEventModalBtn?.addEventListener('click', closeEventModal);
      cancelEventBtn?.addEventListener('click', closeEventModal);

      // Close modal on background click
      eventModal?.addEventListener('click', (e) => {
        if (e.target === eventModal) {
          closeEventModal();
        }
      });

      // Edit Event buttons
      document.querySelectorAll('.edit-event-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const eventId = btn.getAttribute('data-event-id');
          const eventTitle = btn.getAttribute('data-event-title');
          const eventDescription = btn.getAttribute('data-event-description');
          const eventDate = btn.getAttribute('data-event-date');
          const eventTime = btn.getAttribute('data-event-time');
          const eventDuration = btn.getAttribute('data-event-duration');
          const eventHostId = btn.getAttribute('data-event-host-id');
          
          if (eventIdInput) eventIdInput.value = eventId || '';
          if (eventTitleInput) eventTitleInput.value = eventTitle || '';
          if (eventDescriptionInput) eventDescriptionInput.value = eventDescription || '';
          if (eventDateInput) eventDateInput.value = eventDate || '';
          if (eventTimeInput) eventTimeInput.value = eventTime || '';
          if (eventDurationInput) eventDurationInput.value = eventDuration || '';
          if (eventHostSelect) eventHostSelect.value = eventHostId || '';
          if (eventModalTitle) eventModalTitle.textContent = 'Edit Event';
          
          eventModal?.classList.remove('hidden');
        });
      });

      // Delete Event buttons
      document.querySelectorAll('.delete-event-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const eventId = btn.getAttribute('data-event-id');
          
          if (confirm('Are you sure you want to delete this event?')) {
            try {
              const response = await fetch(`/api/events/${eventId}`, {
                method: 'DELETE',
              });

              if (response.ok) {
                window.location.reload();
              } else {
                alert('Failed to delete event');
              }
            } catch (error) {
              console.error('Error deleting event:', error);
              alert('Failed to delete event');
            }
          }
        });
      });

      // Handle event form submission
      eventForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(e.target as HTMLFormElement);
        const eventId = formData.get('eventId');
        const durationValue = formData.get('eventDuration') as string;
        const hostIdValue = formData.get('eventHost') as string;
        const data = {
          title: formData.get('eventTitle'),
          description: formData.get('eventDescription') || null,
          date: formData.get('eventDate'),
          time: formData.get('eventTime'),
          duration: durationValue && durationValue.trim() !== '' ? parseInt(durationValue) : null,
          hostId: hostIdValue && hostIdValue.trim() !== '' ? hostIdValue : null,
        };

        try {
          const isEditing = eventId && eventId !== '';
          const url = isEditing ? `/api/events/${eventId}` : '/api/events';
          const method = isEditing ? 'PUT' : 'POST';
          
          const response = await fetch(url, {
            method,
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(data),
          });

          if (response.ok) {
            window.location.reload();
          } else {
            alert('Failed to save event');
          }
        } catch (error) {
          console.error('Error saving event:', error);
          alert('Failed to save event');
        }
      });
    }

    // Run on initial page load and after View Transitions navigation
    document.addEventListener('astro:page-load', initializeCalendar);
  </script>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import { isAuthenticated, getUserRole } from '../../lib/auth';
import { db, PageSettings, eq } from '@/db';

// Dice roller is only accessible to logged-in users
const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);

if (!isLoggedIn) {
  return Astro.redirect('/login');
}

const canEdit = userRole === 'admin' || userRole === 'dungeonmaster';

// Get page settings for hero image
const pageSettings = await db.select().from(PageSettings).where(eq(PageSettings.pageName, 'dice-roller'));
const heroImageUrl = pageSettings.length > 0 ? pageSettings[0].heroImageUrl : null;
---

<Layout title="Dice Roller">
  <PageHero
    title="Dice Roller"
    heroImageUrl={heroImageUrl}
    pageName="dice-roller"
    canEditHero={canEdit}
    compact
    subtitle="Roll for attacks, saves and skill checks."
  />


  <!-- Dice Roller Interface -->
  <div class="mx-auto">
    <!-- Dice Selection -->
    <div class="t-panel p-6 mb-6">
      <h2 class="t-section-h text-xl mb-4">Select Dice</h2>

      <!-- Dice Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-7 gap-4 mb-2">
        <!-- D4 -->
        <button
          type="button"
          class="dice-selector group relative t-panel p-4 hover:shadow-lg transition-all hover:scale-105 active:scale-95 cursor-pointer"
          data-dice="d4"
        >
          <div class="text-center">
            <span class="t-body-text text-lg font-bold">d4</span>
            <div class="dice-count absolute -top-2 -right-2 bg-(--gold) text-(--on-gold) rounded-xs w-8 h-8 flex items-center justify-center text-sm font-bold shadow-lg hidden">0</div>
          </div>
        </button>

        <!-- D6 -->
        <button
          type="button"
          class="dice-selector group relative t-panel p-4 hover:shadow-lg transition-all hover:scale-105 active:scale-95 cursor-pointer"
          data-dice="d6"
        >
          <div class="text-center">
            <span class="t-body-text text-lg font-bold">d6</span>
            <div class="dice-count absolute -top-2 -right-2 bg-(--gold) text-(--on-gold) rounded-xs w-8 h-8 flex items-center justify-center text-sm font-bold shadow-lg hidden">0</div>
          </div>
        </button>

        <!-- D8 -->
        <button
          type="button"
          class="dice-selector group relative t-panel p-4 hover:shadow-lg transition-all hover:scale-105 active:scale-95 cursor-pointer"
          data-dice="d8"
        >
          <div class="text-center">
            <span class="t-body-text text-lg font-bold">d8</span>
            <div class="dice-count absolute -top-2 -right-2 bg-(--gold) text-(--on-gold) rounded-xs w-8 h-8 flex items-center justify-center text-sm font-bold shadow-lg hidden">0</div>
          </div>
        </button>

        <!-- D10 -->
        <button
          type="button"
          class="dice-selector group relative t-panel p-4 hover:shadow-lg transition-all hover:scale-105 active:scale-95 cursor-pointer"
          data-dice="d10"
        >
          <div class="text-center">
            <span class="t-body-text text-lg font-bold">d10</span>
            <div class="dice-count absolute -top-2 -right-2 bg-(--gold) text-(--on-gold) rounded-xs w-8 h-8 flex items-center justify-center text-sm font-bold shadow-lg hidden">0</div>
          </div>
        </button>

        <!-- D12 -->
        <button
          type="button"
          class="dice-selector group relative t-panel p-4 hover:shadow-lg transition-all hover:scale-105 active:scale-95 cursor-pointer"
          data-dice="d12"
        >
          <div class="text-center">
            <span class="t-body-text text-lg font-bold">d12</span>
            <div class="dice-count absolute -top-2 -right-2 bg-(--gold) text-(--on-gold) rounded-xs w-8 h-8 flex items-center justify-center text-sm font-bold shadow-lg hidden">0</div>
          </div>
        </button>

        <!-- D20 -->
        <button
          type="button"
          class="dice-selector group relative t-panel p-4 hover:shadow-lg transition-all hover:scale-105 active:scale-95 cursor-pointer"
          data-dice="d20"
        >
          <div class="text-center">
            <span class="t-body-text text-lg font-bold">d20</span>
            <div class="dice-count absolute -top-2 -right-2 bg-(--gold) text-(--on-gold) rounded-xs w-8 h-8 flex items-center justify-center text-sm font-bold shadow-lg hidden">0</div>
          </div>
        </button>

        <!-- D100 -->
        <button
          type="button"
          class="dice-selector group relative t-panel p-4 hover:shadow-lg transition-all hover:scale-105 active:scale-95 cursor-pointer"
          data-dice="d100"
        >
          <div class="text-center">
            <span class="t-body-text text-lg font-bold">d100</span>
            <div class="dice-count absolute -top-2 -right-2 bg-accent-600 text-white rounded-xs w-8 h-8 flex items-center justify-center text-sm font-bold shadow-lg hidden">0</div>
          </div>
        </button>
      </div>

      <p class="text-xs text-gray-500 mt-2 mb-6 text-center">Left click to add · Right click to remove</p>

      <!-- Modifier Input -->
      <div class="flex items-center gap-4 mb-6">
        <label for="modifier" class="t-body-text text-sm font-medium">Modifier:</label>
        <input
          type="number"
          id="modifier"
          class="t-input w-24 px-3 py-2"
          value="0"
          placeholder="0"
        />
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap gap-4">
        <button
          id="rollButton"
          type="button"
          class="t-btn-primary flex-1 min-w-[200px] font-bold py-4 px-8 disabled:opacity-50 disabled:cursor-not-allowed"
          disabled
        >
          <span class="flex items-center justify-center gap-2">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Roll Dice
          </span>
        </button>
        <button
          id="clearButton"
          type="button"
          class="t-btn-secondary font-bold py-4 px-8"
        >
          Clear selection
        </button>
      </div>

      <!-- Current Selection Display -->
      <div id="currentSelection" class="mt-4 t-inset p-4 rounded-xs hidden">
        <p class="t-body-text text-sm font-medium mb-2">Current Selection:</p>
        <p id="selectionText" class="text-lg font-bold" style="color:var(--accent);"></p>
      </div>
    </div>

    <!-- Roll Result -->
    <div id="rollResult" class="t-panel overflow-hidden mb-6 hidden">
      <div class="px-6 pt-6">
        <h2 class="t-section-h text-xl mb-4">Result</h2>
      </div>

      <!-- 3D Canvas Tray -->
      <div id="dice-canvas-wrap" class="relative w-full" style="height:480px;background:var(--bg-page);">
        <div id="dice-canvas" class="absolute inset-0"></div>
        <div id="dice-loading" class="absolute inset-0 flex items-center justify-center bg-gray-900/80">
          <span class="text-gray-400 text-sm animate-pulse">Loading dice...</span>
        </div>
      </div>

      <!-- Result panel (hidden until roll settles) -->
      <div id="result-panel" class="p-8 hidden">
        <div class="text-center">
          <div id="resultBreakdown" class="t-muted mb-2"></div>
          <div id="totalResult" class="text-6xl font-bold mb-1" style="color:var(--gold);">—</div>
          <p class="t-faint text-sm">Total</p>
          <div id="critBadge" class="hidden mt-2"></div>
        </div>
        <!-- Individual die chips -->
        <div id="diceChips" class="flex flex-wrap justify-center gap-2 mt-6"></div>
      </div>
    </div>

    <!-- Roll History -->
    <div class="t-panel p-6">
      <div class="flex justify-between items-center mb-4">
        <h2 class="t-section-h text-xl">Roll History</h2>
        <button
          id="clearHistoryButton"
          type="button"
          class="t-faint text-sm font-medium hover:opacity-80" style="color:var(--danger);"
        >
          Clear history
        </button>
      </div>
      <div id="rollHistory" class="space-y-2">
        <p class="t-faint text-center py-4">No rolls yet</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Critical Success/Failure */
  @keyframes criticalSuccess {
    0%, 100% {
      transform: scale(1);
    }
    25% {
      transform: scale(1.2) rotate(-10deg);
    }
    75% {
      transform: scale(1.2) rotate(10deg);
    }
  }

  .critical-success {
    animation: criticalSuccess 0.5s ease-in-out;
    color: #10b981 !important;
  }

  .critical-fail {
    animation: criticalSuccess 0.5s ease-in-out;
    color: #ef4444 !important;
  }

  #result-panel {
    animation: resultFadeIn 0.4s ease forwards;
  }

  @keyframes resultFadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .dice-chip {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding: .375rem .75rem;
    border-radius: 2px;
    font-size: .875rem;
    border-width: 1px;
  }

  /* Make DiceBox's generated canvas fill its container.
     Must use :global() — DiceBox creates this element at runtime
     so Astro's scoped attribute is never added to it. */
  :global(#dice-canvas canvas),
  :global(#dice-canvas .dice-box-canvas) {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }

  @media (max-width: 640px) {
    #dice-canvas-wrap { height: 300px; }
  }
</style>

<script>
  // Dice selection state
  const diceSelection: Record<string, number> = {
    d4: 0,
    d6: 0,
    d8: 0,
    d10: 0,
    d12: 0,
    d20: 0,
    d100: 0,
  };

  // Roll history
  let rollHistory: Array<{
    formula: string;
    rolls: number[];
    modifier: number;
    total: number;
    timestamp: Date;
  }> = [];

  // DOM elements
  const diceSelectors = document.querySelectorAll('.dice-selector');
  const rollButton = document.getElementById('rollButton') as HTMLButtonElement;
  const clearButton = document.getElementById('clearButton') as HTMLButtonElement;
  const currentSelection = document.getElementById('currentSelection') as HTMLDivElement;
  const selectionText = document.getElementById('selectionText') as HTMLParagraphElement;
  const rollResult = document.getElementById('rollResult') as HTMLDivElement;
  const totalResult = document.getElementById('totalResult') as HTMLDivElement;
  const resultBreakdown = document.getElementById('resultBreakdown') as HTMLDivElement;
  const resultPanel = document.getElementById('result-panel') as HTMLDivElement;
  const critBadge = document.getElementById('critBadge') as HTMLDivElement;
  const diceChips = document.getElementById('diceChips') as HTMLDivElement;
  const rollHistoryEl = document.getElementById('rollHistory') as HTMLDivElement;
  const clearHistoryButton = document.getElementById('clearHistoryButton') as HTMLButtonElement;
  const modifierInput = document.getElementById('modifier') as HTMLInputElement;

  // ── Lazy dice-box singleton ──────────────────────────────────────────────
  let diceBox: any = null;
  let diceBoxReady = false;
  let diceBoxFailed = false;
  let initPromise: Promise<void> | null = null;

  async function getDiceBox(): Promise<any> {
    if (diceBoxReady) return diceBox;
    if (diceBoxFailed) return null;
    if (initPromise) { await initPromise; return diceBoxReady ? diceBox : null; }

    initPromise = (async () => {
      try {
        const { default: DiceBox } = await import('@3d-dice/dice-box');
        diceBox = new DiceBox('#dice-canvas', {
          assetPath: '/assets/dice-box/',
          theme: 'default',
          throwForce: 6,
          startingHeight: 8,
          spinForce: 4,
          lightIntensity: 0.9,
          gravity: 3,
          scale: 8,
        });
        await diceBox.init();
        // Re-measure after CSS has sized the canvas to fill the container
        diceBox.resizeWorld();
        diceBoxReady = true;
        document.getElementById('dice-loading')?.classList.add('hidden');
      } catch (e) {
        console.warn('DiceBox init failed, falling back to Math.random()', e);
        diceBoxFailed = true;
        document.getElementById('dice-loading')?.classList.add('hidden');
      }
    })();

    await initPromise;
    return diceBoxReady ? diceBox : null;
  }

  // Reset on Astro view transitions (canvas replaced in DOM)
  document.addEventListener('astro:after-swap', () => {
    diceBox = null;
    diceBoxReady = false;
    diceBoxFailed = false;
    initPromise = null;
  });

  // ── Update dice count display ────────────────────────────────────────────
  function updateDiceCount(dice: string, count: number) {
    const selector = document.querySelector(`[data-dice="${dice}"]`);
    if (selector) {
      const countEl = selector.querySelector('.dice-count') as HTMLDivElement;
      if (count > 0) {
        countEl.textContent = count.toString();
        countEl.classList.remove('hidden');
      } else {
        countEl.classList.add('hidden');
      }
    }
  }

  // ── Update selection display ─────────────────────────────────────────────
  function updateSelectionDisplay() {
    const parts: string[] = [];
    let totalDice = 0;

    Object.entries(diceSelection).forEach(([dice, count]) => {
      if (count > 0) {
        parts.push(`${count}${dice}`);
        totalDice += count;
      }
    });

    const modifier = parseInt(modifierInput.value || '0');
    if (modifier !== 0) {
      parts.push(modifier > 0 ? `+${modifier}` : `${modifier}`);
    }

    if (totalDice > 0) {
      currentSelection.classList.remove('hidden');
      selectionText.textContent = parts.join(' ');
      rollButton.disabled = false;
    } else {
      currentSelection.classList.add('hidden');
      rollButton.disabled = true;
    }
  }

  // ── Handle dice selection ────────────────────────────────────────────────
  diceSelectors.forEach((selector) => {
    selector.addEventListener('click', () => {
      const dice = selector.getAttribute('data-dice') as string;
      diceSelection[dice]++;
      updateDiceCount(dice, diceSelection[dice]);
      updateSelectionDisplay();
    });

    selector.addEventListener('contextmenu', (e) => {
      e.preventDefault();
      const dice = selector.getAttribute('data-dice') as string;
      if (diceSelection[dice] > 0) {
        diceSelection[dice]--;
        updateDiceCount(dice, diceSelection[dice]);
        updateSelectionDisplay();
      }
    });
  });

  // ── Clear selection ──────────────────────────────────────────────────────
  clearButton.addEventListener('click', () => {
    Object.keys(diceSelection).forEach((dice) => {
      diceSelection[dice] = 0;
      updateDiceCount(dice, 0);
    });
    updateSelectionDisplay();
  });

  // ── Fallback roll generator ──────────────────────────────────────────────
  function generateFallback(): Array<{ sides: number; value: number }> {
    const results: Array<{ sides: number; value: number }> = [];
    Object.entries(diceSelection).forEach(([die, count]) => {
      const sides = parseInt(die.slice(1));
      for (let i = 0; i < count; i++) {
        results.push({ sides, value: Math.floor(Math.random() * sides) + 1 });
      }
    });
    return results;
  }

  // ── showResults helper ───────────────────────────────────────────────────
  function showResults(results: Array<{ sides: number; value: number }>, modifier: number, total: number) {
    resultBreakdown.textContent =
      results.map((r) => `d${r.sides}: ${r.value}`).join(', ') +
      (modifier !== 0 ? ` ${modifier > 0 ? '+' : ''}${modifier}` : '');

    totalResult.textContent = total.toString();
    totalResult.className = 'text-6xl font-bold mb-1'; totalResult.style.color = 'var(--gold)';

    // Critical (single d20 only)
    critBadge.classList.add('hidden');
    if (results.length === 1 && results[0].sides === 20) {
      if (results[0].value === 20) {
        totalResult.classList.add('critical-success');
        critBadge.textContent = 'Natural 20!';
        critBadge.className =
          't-badge t-badge-green text-sm font-bold';
        critBadge.classList.remove('hidden');
      } else if (results[0].value === 1) {
        totalResult.classList.add('critical-fail');
        critBadge.textContent = 'Critical Fail';
        critBadge.className =
          't-badge t-badge-red text-sm font-bold';
        critBadge.classList.remove('hidden');
      }
    }

    // Die chips
    diceChips.innerHTML = results
      .map((r) => {
        const cls =
          r.sides === 20
            ? 't-badge t-badge-accent text-sm'
            : r.sides === 100
            ? 't-badge t-badge-gold text-sm'
            : 't-badge text-sm';
        return `<div class="dice-chip ${cls}">
          <span class="text-xs opacity-60">d${r.sides}</span>
          <span class="text-xl font-bold">${r.value}</span>
        </div>`;
      })
      .join('');

    resultPanel.classList.remove('hidden');
  }

  // ── Die colour map (matches button colours from tailwind.config.mjs) ────
  const DICE_COLORS: Record<string, string> = {
    d4:   '#8b4545', // primary-600  (burgundy)
    d6:   '#8b4545',
    d8:   '#8b4545',
    d10:  '#8b4545',
    d12:  '#8b4545',
    d20:  '#d97706', // secondary-600 (amber)
    d100: '#475569', // accent-600    (slate)
  };

  // ── Roll button handler ──────────────────────────────────────────────────
  rollButton.addEventListener('click', async () => {
    const parts: string[] = [];
    Object.entries(diceSelection).forEach(([die, count]) => {
      if (count > 0) parts.push(`${count}${die}`);
    });
    const modifier = parseInt(modifierInput.value || '0');
    if (!parts.length) return;

    rollResult.classList.remove('hidden');
    resultPanel.classList.add('hidden');
    critBadge.classList.add('hidden');
    rollButton.disabled = true;
    rollResult.scrollIntoView({ behavior: 'smooth', block: 'start' });

    // Show loading spinner while dice-box initialises
    const loadingEl = document.getElementById('dice-loading');
    if (loadingEl) loadingEl.classList.remove('hidden');

    const box = await getDiceBox();
    let results: Array<{ sides: number; value: number }>;

    if (box) {
      if (loadingEl) loadingEl.classList.add('hidden');
      box.resizeWorld();
      await box.clear();

      // Build array-of-objects notation so each die group gets its own colour
      const notation = Object.entries(diceSelection)
        .filter(([, count]) => count > 0)
        .map(([die, count]) => ({
          qty: count,
          sides: die === 'd100' ? 'd100' : parseInt(die.slice(1)),
          themeColor: DICE_COLORS[die],
        }));

      const timeout = new Promise<never>((_, reject) =>
        setTimeout(() => reject(new Error('timeout')), 10000)
      );
      results = await Promise.race([box.roll(notation), timeout]).catch(() => {
        console.warn('DiceBox roll timed out, using fallback');
        return generateFallback();
      });
    } else {
      if (loadingEl) loadingEl.classList.add('hidden');
      results = generateFallback();
    }

    const total = results.reduce((s: number, r: { sides: number; value: number }) => s + r.value, 0) + modifier;
    const formula = [
      ...parts,
      ...(modifier !== 0 ? [modifier > 0 ? `+${modifier}` : `${modifier}`] : []),
    ].join(' ');

    rollHistory.unshift({ formula, rolls: results.map((r: { sides: number; value: number }) => r.value), modifier, total, timestamp: new Date() });
    if (rollHistory.length > 10) rollHistory.pop();

    showResults(results, modifier, total);
    updateHistoryDisplay();
    rollButton.disabled = false;
    // (scroll already happened on click — no need to scroll again here)
  });

  // ── Update history display ───────────────────────────────────────────────
  function updateHistoryDisplay() {
    if (rollHistory.length === 0) {
      rollHistoryEl.innerHTML =
        '<p class="t-faint text-center py-4">No rolls yet</p>';
      return;
    }

    rollHistoryEl.innerHTML = rollHistory
      .slice(0, 10)
      .map((roll) => {
        const time = roll.timestamp.toLocaleTimeString();
        return `
          <div class="t-row p-3 flex justify-between items-center">
            <div class="flex-1">
              <span class="t-body-text font-medium">${roll.formula}</span>
              <span class="t-faint text-sm ml-2">${time}</span>
            </div>
            <div class="text-right">
              <div class="text-2xl font-bold" style="color:var(--gold);">${roll.total}</div>
            </div>
          </div>
        `;
      })
      .join('');
  }

  // ── Clear history ────────────────────────────────────────────────────────
  clearHistoryButton.addEventListener('click', async () => {
    if ((await window.arandorConfirm('Clear the roll history?', { confirmLabel: 'Clear history', danger: true }))) {
      rollHistory = [];
      updateHistoryDisplay();
    }
  });

  // ── Update display when modifier changes ─────────────────────────────────
  modifierInput.addEventListener('input', updateSelectionDisplay);
</script>

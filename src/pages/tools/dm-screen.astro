---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import { isAuthenticated, getUserRole } from '../../lib/auth';
import { db, Location, NPC, PageSettings, eq } from 'astro:db';

// DM Screen is only accessible to DM/Admin
const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);
const canEdit = userRole === 'admin' || userRole === 'dungeonmaster';

if (!isLoggedIn || !canEdit) {
  return Astro.redirect('/login');
}

// Fetch all locations and NPCs for selection
const locations = await db.select().from(Location);
const npcs = await db.select().from(NPC);

// Get page settings for hero image
const pageSettings = await db.select().from(PageSettings).where(eq(PageSettings.pageName, 'dm-screen'));
const heroImageUrl = pageSettings.length > 0 ? pageSettings[0].heroImageUrl : null;

// Generate player display URL
const playerDisplayUrl = `${Astro.url.origin}/display`;
---

<Layout title="DM Screen">
  <PageHero 
    title="DM Screen" 
    heroImageUrl={heroImageUrl}
    pageName="dm-screen"
    canEditHero={canEdit}
  />

  <div class="mb-6">
    <p class="t-muted mb-4">
      Control what your players see on their display screen. Select locations, NPCs in spotlight, and manage the combat tracker.
    </p>
    
    <!-- Player Display Link -->
    <div class="t-callout p-4 mb-6">
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 shrink-0 mt-0.5" style="color:var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
        <div class="flex-1">
          <h3 class="t-body-text font-semibold mb-2">Player Display Screen</h3>
          <p class="t-muted text-sm mb-3">
            Open this link on a second screen or share it with your players:
          </p>
          <div class="flex flex-col lg:flex-row items-stretch lg:items-center gap-2">
            <input 
              type="text" 
              readonly
              value={playerDisplayUrl}
              id="playerDisplayUrl"
              class="t-input flex-1 px-3 py-2 text-sm"
            />
            <div class="flex gap-2">
              <Button variant="secondary" size="sm" id="copyUrlBtn" class="flex-1 lg:flex-none">
                Copy
              </Button>
              <a href={playerDisplayUrl} target="_blank" rel="noopener noreferrer" class="flex-1 lg:flex-none">
                <Button variant="primary" size="sm" class="w-full">
                  Open
                </Button>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Location Control -->
    <div class="t-panel p-6">
      <h2 class="t-section-h text-xl mb-4 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        Current Location
      </h2>
      
      <div class="space-y-4">
        <div>
          <label for="locationSelect" class="t-label block mb-2">
            Select Location to Display
          </label>
          <select 
            id="locationSelect"
            class="t-input w-full px-4 py-2"
          >
            <option value="">-- None --</option>
            {locations.map(location => (
              <option value={location.id}>
                {location.name} ({location.type})
              </option>
            ))}
          </select>
        </div>

        <div id="locationPreview" class="hidden">
          <p class="t-body-text text-sm font-medium mb-2">Preview:</p>
          <div class="rounded-xs overflow-hidden" style="border:2px solid var(--border);">
            <div id="locationImageContainer" class="t-inset aspect-video flex items-center justify-center">
              <img id="locationImage" class="w-full h-full object-cover hidden" alt="Location" />
              <p id="noLocationImage" class="t-faint">No image available</p>
            </div>
            <div class="t-inset p-3">
              <p id="locationName" class="t-body-text font-semibold"></p>
              <p id="locationInfo" class="t-muted text-sm"></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- NPC Spotlight Control -->
    <div class="t-panel p-6">
      <h2 class="t-section-h text-xl mb-4 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
        </svg>
        NPCs in Spotlight
      </h2>

      <div class="space-y-4">
        <div>
          <label for="npcSelect" class="t-label block mb-2">
            Add NPC to Spotlight
          </label>
          <div class="flex flex-col lg:flex-row gap-2">
            <select 
              id="npcSelect"
              class="t-input flex-1 px-4 py-2 min-w-0"
            >
              <option value="">-- Select NPC --</option>
              {npcs.map(npc => (
                <option value={npc.id}>
                  {npc.name} ({npc.occupation || npc.race})
                </option>
              ))}
            </select>
            <Button variant="primary" size="sm" id="addNpcBtn" class="w-full lg:w-auto lg:shrink-0">
              Add
            </Button>
          </div>
        </div>

        <div id="spotlightNpcList" class="space-y-2">
          <p class="t-faint text-sm" id="noNpcsMessage">No NPCs in spotlight</p>
        </div>
      </div>
    </div>

    <!-- Initiative Tracker Control -->
    <div class="t-panel p-6">
      <h2 class="t-section-h text-xl mb-4 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
        </svg>
        Initiative Tracker
      </h2>

      <div class="space-y-4">
        <div class="flex items-center">
          <input 
            type="checkbox" 
            id="showInitiativeTracker"
            class="w-4 h-4 rounded-sm" style="accent-color:var(--accent);"
          />
          <label for="showInitiativeTracker" class="ml-2 t-body-text text-sm">
            Show initiative tracker on player display
          </label>
        </div>

        <p class="t-muted text-sm">
          When enabled, players will see the initiative tracker on their display screen during combat.
        </p>
        
        <!-- Combat Controls -->
        <div class="pt-4" style="border-top:1px solid var(--border);">
          <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-2 mb-3">
            <span class="t-body-text text-sm font-medium">Combat Controls</span>
            <div class="t-inset flex items-center gap-2 px-2.5 py-1 rounded-xs">
              <span class="t-body-text text-xs font-medium">Round:</span>
              <span id="dmCurrentRound" class="text-lg font-bold" style="color:var(--gold);">1</span>
            </div>
          </div>
          
          <div class="flex flex-col gap-2">
            <!-- Combat Status Buttons -->
            <div class="grid grid-cols-3 gap-2">
              <Button variant="success" size="sm" icon="play" id="dmStartCombatBtn" class="w-full text-xs lg:text-sm" ariaLabel="Start Combat" data-status="stopped">
                <span class="hidden lg:inline">Start</span>
              </Button>
              <Button variant="warning" size="sm" icon="pause" id="dmPauseCombatBtn" class="w-full text-xs lg:text-sm" ariaLabel="Pause Combat" data-status="stopped">
                <span class="hidden lg:inline">Pause</span>
              </Button>
              <Button variant="danger" size="sm" icon="stop" id="dmStopCombatBtn" class="w-full text-xs lg:text-sm" ariaLabel="Stop Combat" data-status="stopped">
                <span class="hidden lg:inline">Stop</span>
              </Button>
            </div>
            
            <!-- Turn Navigation -->
            <div class="grid grid-cols-3 gap-2">
              <Button variant="secondary" size="sm" icon="refresh" id="dmSyncHpBtn" class="w-full text-xs lg:text-sm">
                <span class="hidden lg:inline">Sync HP</span>
                <span class="lg:hidden">Sync</span>
              </Button>
              <Button variant="secondary" size="sm" icon="prev" id="dmPrevTurnBtn" class="w-full text-xs lg:text-sm">
                Prev
              </Button>
              <Button variant="secondary" size="sm" icon="next" iconPosition="right" id="dmNextTurnBtn" class="w-full text-xs lg:text-sm">
                Next
              </Button>
            </div>
           </div>
          
          <p class="t-faint text-xs mt-2">
            Control initiative turns directly from here, or use the full <a href="/tools/initiative" class="t-link">Initiative Tracker</a>.
          </p>
        </div>

        <!-- Current and Next Combatants Display -->
        <div id="initiativePreview" class="pt-4 hidden" style="border-top:1px solid var(--border);">
          <span class="t-body-text text-sm font-medium mb-2 block">Turn Order</span>
          
          <!-- Current Turn -->
          <div id="currentTurnDisplay" class="t-inset mb-2 p-3 rounded-xs" style="border:2px solid var(--gold);">
            <div class="flex items-center gap-2 mb-1">
              <svg class="w-4 h-4" style="color:var(--gold);" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-xs font-semibold" style="color:var(--gold);">CURRENT TURN</span>
            </div>
            <div id="currentTurnContent" class="text-sm">
              <span class="t-body-text font-semibold">--</span>
              <span class="t-muted ml-2">Init: --</span>
            </div>
          </div>
          
          <!-- Next Turn -->
          <div id="nextTurnDisplay" class="t-inset p-3 rounded-xs">
            <div class="flex items-center gap-2 mb-1">
              <svg class="w-4 h-4 t-faint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
              <span class="t-faint text-xs font-semibold">UP NEXT</span>
            </div>
            <div id="nextTurnContent" class="text-sm">
              <span class="t-body-text font-semibold">--</span>
              <span class="t-muted ml-2">Init: --</span>
            </div>
          </div>
        </div>

        <a href="/tools/initiative" class="inline-block">
          <Button variant="secondary" size="sm">
            Manage Initiative
          </Button>
        </a>
      </div>
    </div>

    <!-- Timer Control -->
    <div class="t-panel p-6">
      <h2 class="t-section-h text-xl mb-4 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Timer
      </h2>

      <div class="space-y-4">
        <div class="flex items-center">
          <input 
            type="checkbox" 
            id="showTimer"
            class="w-4 h-4 rounded-sm" style="accent-color:var(--accent);"
          />
          <label for="showTimer" class="ml-2 t-body-text text-sm">
            Show timer on player display
          </label>
        </div>

        <p class="t-muted text-sm">
          When enabled, players will see the timer on their display screen.
        </p>
        
        <!-- Timer Settings -->
        <div class="pt-4" style="border-top:1px solid var(--border);">
          <label for="timerMinutes" class="t-label block mb-2">
            Duration (minutes)
          </label>
          <input 
            type="number" 
            id="timerMinutes"
            min="0"
            max="999"
            value="5"
            class="t-input w-full px-4 py-2"
          />
        </div>
        
        <!-- Timer Display -->
        <div class="t-inset rounded-xs p-4 text-center">
          <div id="timerDisplay" class="text-4xl font-bold mb-2" style="color:var(--gold);">
            00:00
          </div>
          <div id="timerStatusText" class="t-muted text-sm">
            Stopped
          </div>
        </div>
        
        <!-- Timer Controls -->
        <div class="grid grid-cols-3 gap-2">
          <Button variant="success" size="sm" id="startTimerBtn" class="w-full">
            Start
          </Button>
          <Button variant="warning" size="sm" id="pauseTimerBtn" class="w-full">
            Pause
          </Button>
          <Button variant="danger" size="sm" id="resetTimerBtn" class="w-full">
            Reset
          </Button>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="t-panel p-6">
      <h2 class="t-section-h text-xl mb-4 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
        Quick Actions
      </h2>

      <div class="space-y-4">
        <!-- Show/Hide Screen Toggle -->
        <div class="t-inset p-4 rounded-xs">
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-2 mb-2">
            <label class="t-body-text text-sm font-medium">Screen Visibility</label>
            <div class="flex items-center gap-2">
              <span id="screenStatusText" class="t-muted text-sm">Visible</span>
              <button 
                id="toggleScreenBtn"
                class="t-btn-primary text-sm"
              >
                Hide Screen
              </button>
            </div>
          </div>
          <p class="t-faint text-xs">
            Hide the screen to show placeholder image while keeping your data intact.
          </p>
        </div>
        
        <!-- Placeholder Image Upload -->
        <div class="t-inset p-4 rounded-xs">
          <label class="t-label block mb-2">
            Placeholder Wallpaper
          </label>
          <div class="space-y-2">
            <input 
              type="text" 
              id="placeholderImageUrl"
              placeholder="Enter image URL..."
              class="t-input w-full px-3 py-2 text-sm"
            />
            <div class="grid grid-cols-2 lg:grid-cols-3 gap-2">
              <label for="placeholderImageFile" class="col-span-2 lg:col-span-1">
                <div class="t-btn-secondary cursor-pointer w-full px-3 py-2 text-sm text-center font-medium">
                  📁 <span class="hidden lg:inline">Upload</span>
                </div>
                <input 
                  type="file" 
                  id="placeholderImageFile"
                  accept="image/*"
                  class="hidden"
                />
              </label>
              <Button variant="secondary" size="sm" id="savePlaceholderBtn" class="w-full col-span-1">
                <span class="hidden lg:inline">Save Wallpaper</span>
                <span class="lg:hidden">Save</span>
              </Button>
              <Button variant="secondary" size="sm" id="clearPlaceholderBtn" class="w-full col-span-1">
                Clear
              </Button>
            </div>
          </div>
          <p class="t-faint text-xs mt-2">
            Upload an image file or enter an image URL. This appears when the screen is hidden.
          </p>
        </div>
        
        <!-- Clear All -->
        <div class="pt-3" style="border-top:1px solid var(--border);">
          <Button variant="danger" size="sm" id="clearAllBtn" class="w-full">
            Clear Player Display
          </Button>
          
          <p class="t-faint text-xs mt-2">
            This will clear the location, NPCs, and hide the initiative tracker on the player display.
          </p>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Loading spinner animation */
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    
    .spinner {
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      border-top-color: white;
      width: 1rem;
      height: 1rem;
      animation: spin 0.6s linear infinite;
      display: inline-block;
      margin-right: 0.5rem;
    }
  </style>

  <script>
    // Store current state
    let currentState = {
      currentLocationId: null,
      spotlightNpcIds: [],
      customAssets: [],
      showInitiativeTracker: false,
      screenVisible: true,
      placeholderImageUrl: null,
      showTimer: false,
      timerDuration: 0,
      timerStartedAt: null,
      timerPausedAt: null,
      timerStatus: 'stopped',
    };

    // Store locations and NPCs data
    const locationsData = new Map();
    const npcsData = new Map();
    
    // Store event handler references for cleanup
    let eventHandlers = new Map();
    let combatDataInterval = null;
    let hpSyncInterval = null;
    let hpSyncStatusCheckInterval = null;
    let timerUpdateInterval = null;

    // Initialize data maps
    async function initializeData() {
      try {
        const [locationsResponse, npcsResponse] = await Promise.all([
          fetch('/api/locations'),
          fetch('/api/npcs'),
        ]);

        if (locationsResponse.ok) {
          const locations = await locationsResponse.json();
          locations.forEach(loc => {
            locationsData.set(loc.id, loc);
          });
        }

        if (npcsResponse.ok) {
          const npcs = await npcsResponse.json();
          npcs.forEach(npc => {
            npcsData.set(npc.id, npc);
          });
        }
      } catch (error) {
        console.error('Error loading data:', error);
      }
    }

    // Load current DM Screen state
    async function loadState() {
      try {
        const response = await fetch('/api/dm-screen');
        if (response.ok) {
          const state = await response.json();
          currentState = state;
          
          // Update UI
          updateLocationPreview(state.currentLocationId);
          updateNpcList(state.spotlightNpcIds);
          
          const locationSelect = document.getElementById('locationSelect');
          const showInitiativeCheckbox = document.getElementById('showInitiativeTracker');
          const placeholderImageInput = document.getElementById('placeholderImageUrl');
          const showTimerCheckbox = document.getElementById('showTimer');
          const timerMinutesInput = document.getElementById('timerMinutes');
          
          if (locationSelect) locationSelect.value = state.currentLocationId || '';
          if (showInitiativeCheckbox) showInitiativeCheckbox.checked = state.showInitiativeTracker;
          if (placeholderImageInput) placeholderImageInput.value = state.placeholderImageUrl || '';
          if (showTimerCheckbox) showTimerCheckbox.checked = state.showTimer || false;
          if (timerMinutesInput && state.timerDuration !== undefined) {
            timerMinutesInput.value = Math.floor(state.timerDuration / 60);
          }
          
          // Update screen visibility UI
          updateScreenVisibilityUI(state.screenVisible !== false); // Default to true if undefined
          
          // Update timer display
          updateTimerDisplay();
        }
      } catch (error) {
        console.error('Error loading state:', error);
      }
    }
    
    // Update screen visibility UI
    function updateScreenVisibilityUI(isVisible) {
      const toggleBtn = document.getElementById('toggleScreenBtn');
      const statusText = document.getElementById('screenStatusText');
      
      if (isVisible) {
        if (toggleBtn) {
          toggleBtn.textContent = 'Hide Screen';
          toggleBtn.className = 't-btn-primary text-sm';
        }
        if (statusText) statusText.textContent = 'Visible';
      } else {
        if (toggleBtn) {
          toggleBtn.textContent = 'Show Screen';
          toggleBtn.className = 't-btn-gold text-sm';
        }
        if (statusText) statusText.textContent = 'Hidden';
      }
    }
    
    // Timer utility functions
    function getRemainingTime() {
      if (!currentState.timerDuration) return 0;
      
      if (currentState.timerStatus === 'stopped') {
        return currentState.timerDuration;
      } else if (currentState.timerStatus === 'paused') {
        if (!currentState.timerPausedAt || !currentState.timerStartedAt) return currentState.timerDuration;
        const elapsed = (currentState.timerPausedAt - currentState.timerStartedAt) / 1000;
        return Math.max(0, currentState.timerDuration - elapsed);
      } else if (currentState.timerStatus === 'running') {
        if (!currentState.timerStartedAt) return currentState.timerDuration;
        const elapsed = (Date.now() - currentState.timerStartedAt) / 1000;
        return Math.max(0, currentState.timerDuration - elapsed);
      }
      return 0;
    }
    
    function formatTime(seconds) {
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    }
    
    function updateTimerDisplay() {
      const timerDisplay = document.getElementById('timerDisplay');
      const timerStatusText = document.getElementById('timerStatusText');
      
      const remaining = getRemainingTime();
      if (timerDisplay) timerDisplay.textContent = formatTime(remaining);
      
      if (timerStatusText) {
        let statusText = 'Stopped';
        if (currentState.timerStatus === 'running') {
          statusText = 'Running';
        } else if (currentState.timerStatus === 'paused') {
          statusText = 'Paused';
        }
        timerStatusText.textContent = statusText;
      }
      
      // Update button states
      const startBtn = document.getElementById('startTimerBtn');
      const pauseBtn = document.getElementById('pauseTimerBtn');
      const resetBtn = document.getElementById('resetTimerBtn');
      
      if (startBtn) {
        startBtn.disabled = currentState.timerStatus === 'running';
      }
      if (pauseBtn) {
        pauseBtn.disabled = currentState.timerStatus !== 'running';
      }
      if (resetBtn) {
        resetBtn.disabled = currentState.timerStatus === 'stopped' && remaining === currentState.timerDuration;
      }
    }
    
    function startTimerUpdates() {
      if (timerUpdateInterval) {
        clearInterval(timerUpdateInterval);
      }
      
      if (currentState.timerStatus === 'running') {
        timerUpdateInterval = setInterval(() => {
          updateTimerDisplay();
          
          // Check if timer expired
          const remaining = getRemainingTime();
          if (remaining <= 0 && currentState.timerStatus === 'running') {
            // Timer expired - stop it
            updateState({
              timerStatus: 'stopped',
              timerStartedAt: null,
              timerPausedAt: null
            });
          }
        }, 100); // Update every 100ms for smooth countdown
      }
    }

    // Update location preview
    function updateLocationPreview(locationId) {
      const preview = document.getElementById('locationPreview');
      const image = document.getElementById('locationImage');
      const noImage = document.getElementById('noLocationImage');
      const name = document.getElementById('locationName');
      const info = document.getElementById('locationInfo');

      if (!locationId) {
        preview?.classList.add('hidden');
        return;
      }

      const location = locationsData.get(locationId);
      if (!location) return;

      preview?.classList.remove('hidden');
      
      if (location.imageUrl) {
        image?.classList.remove('hidden');
        noImage?.classList.add('hidden');
        if (image) image.src = location.imageUrl;
      } else {
        image?.classList.add('hidden');
        noImage?.classList.remove('hidden');
      }

      if (name) name.textContent = location.name;
      if (info) info.textContent = `${location.type}${location.region ? ' • ' + location.region : ''}`;
    }

    // Update NPC list
    function updateNpcList(npcIds) {
      const list = document.getElementById('spotlightNpcList');
      const noMessage = document.getElementById('noNpcsMessage');
      
      if (!list) return;

      // Clear existing NPCs (except the "no NPCs" message)
      const npcElements = list.querySelectorAll('.npc-item');
      npcElements.forEach(el => el.remove());

      if (!npcIds || npcIds.length === 0) {
        noMessage?.classList.remove('hidden');
        return;
      }

      noMessage?.classList.add('hidden');

      npcIds.forEach(npcId => {
        const npc = npcsData.get(npcId);
        if (!npc) return;

        const npcItem = document.createElement('div');
        npcItem.className = 'npc-item t-row p-3 flex items-center justify-between';
        npcItem.innerHTML = `
          <div>
            <p class="t-body-text font-medium">${npc.name}</p>
            <p class="t-muted text-sm">${npc.occupation || npc.race}</p>
          </div>
          <button class="remove-npc-btn t-icon-btn t-icon-btn-danger" data-npc-id="${npcId}">
            <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        `;
        list.appendChild(npcItem);
      });

      // Add event listeners to remove buttons
      document.querySelectorAll('.remove-npc-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const npcId = btn.getAttribute('data-npc-id');
          removeNpcFromSpotlight(npcId);
        });
      });
    }

    // Update state on server
    async function updateState(updates) {
      try {
        const response = await fetch('/api/dm-screen', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(updates),
        });

        if (response.ok) {
          const newState = await response.json();
          currentState = newState;
          return true;
        }
        return false;
      } catch (error) {
        console.error('Error updating state:', error);
        return false;
      }
    }

    // Remove NPC from spotlight
    async function removeNpcFromSpotlight(npcId) {
      const newNpcIds = currentState.spotlightNpcIds.filter(id => id !== npcId);
      const success = await updateState({ spotlightNpcIds: newNpcIds });
      
      if (success) {
        updateNpcList(newNpcIds);
      }
    }
    
    // Initialize all event listeners
    function initializeEventListeners() {
      // Location selection change
      const locationSelect = document.getElementById('locationSelect');
      const locationChangeHandler = async () => {
        const locationId = locationSelect.value || null;
        const success = await updateState({ currentLocationId: locationId });
        if (success) {
          updateLocationPreview(locationId);
        }
      };
      locationSelect?.addEventListener('change', locationChangeHandler);
      eventHandlers.set('locationSelect', locationChangeHandler);

      // Add NPC to spotlight
      const addNpcBtn = document.getElementById('addNpcBtn');
      const npcSelect = document.getElementById('npcSelect');
      
      const addNpcHandler = async () => {
        const npcId = npcSelect?.value;
        if (!npcId) return;

        if (currentState.spotlightNpcIds.includes(npcId)) {
          alert('This NPC is already in the spotlight');
          return;
        }

        const newNpcIds = [...currentState.spotlightNpcIds, npcId];
        const success = await updateState({ spotlightNpcIds: newNpcIds });
        
        if (success) {
          updateNpcList(newNpcIds);
          if (npcSelect) npcSelect.value = '';
        }
      };
      addNpcBtn?.addEventListener('click', addNpcHandler);
      eventHandlers.set('addNpcBtn', addNpcHandler);

      // Toggle initiative tracker
      const showInitiativeCheckbox = document.getElementById('showInitiativeTracker');
      const initiativeChangeHandler = async () => {
        const showTracker = showInitiativeCheckbox.checked;
        await updateState({ showInitiativeTracker: showTracker });
      };
      showInitiativeCheckbox?.addEventListener('change', initiativeChangeHandler);
      eventHandlers.set('showInitiativeCheckbox', initiativeChangeHandler);
      
      // Toggle timer visibility
      const showTimerCheckbox = document.getElementById('showTimer');
      const timerChangeHandler = async () => {
        const showTimer = showTimerCheckbox.checked;
        await updateState({ showTimer });
      };
      showTimerCheckbox?.addEventListener('change', timerChangeHandler);
      eventHandlers.set('showTimerCheckbox', timerChangeHandler);
    }

    // Combat controls
    let combatState = { currentRound: 1, currentTurnIndex: 0, status: 'stopped' };
    let initiatives = [];
    
    // Fetch combat state and initiatives
    async function loadCombatData() {
      try {
        const [combatResponse, initiativeResponse] = await Promise.all([
          fetch('/api/combat-state'),
          fetch('/api/initiative')
        ]);
        
        if (combatResponse.ok) {
          combatState = await combatResponse.json();
          const roundDisplay = document.getElementById('dmCurrentRound');
          if (roundDisplay) roundDisplay.textContent = combatState.currentRound || 1;
          updateButtonStates();
        }
        
        if (initiativeResponse.ok) {
          initiatives = await initiativeResponse.json();
          updateInitiativePreview();
        }
      } catch (error) {
        console.error('Error loading combat data:', error);
      }
    }
    
    // Update initiative preview (current and next turns)
    function updateInitiativePreview() {
      const preview = document.getElementById('initiativePreview');
      const currentContent = document.getElementById('currentTurnContent');
      const nextContent = document.getElementById('nextTurnContent');
      
      const activeInitiatives = initiatives.filter(e => e.isActive);
      
      if (activeInitiatives.length === 0 || combatState.status === 'stopped') {
        preview?.classList.add('hidden');
        return;
      }
      
      preview?.classList.remove('hidden');
      
      // Get current and next combatants
      const currentIndex = combatState.currentTurnIndex || 0;
      const nextIndex = (currentIndex + 1) % activeInitiatives.length;
      
      const currentCombatant = activeInitiatives[currentIndex];
      const nextCombatant = activeInitiatives[nextIndex];
      
      // Update current turn display
      if (currentContent && currentCombatant) {
        const typeColor = currentCombatant.type === 'character' ? 't-badge t-badge-green' :
                         currentCombatant.type === 'npc' ? 't-badge t-badge-accent' :
                         't-badge t-badge-red';
        currentContent.innerHTML = `
          <span class="t-body-text font-semibold">${currentCombatant.name}</span>
          <span class="t-muted ml-2">Init: ${currentCombatant.initiative}</span>
          <span class="text-xs ${typeColor} ml-2">${currentCombatant.type}</span>
        `;
      }
      
      // Update next turn display
      if (nextContent && nextCombatant) {
        const typeColor = nextCombatant.type === 'character' ? 't-badge t-badge-green' :
                         nextCombatant.type === 'npc' ? 't-badge t-badge-accent' :
                         't-badge t-badge-red';
        nextContent.innerHTML = `
          <span class="t-body-text font-semibold">${nextCombatant.name}</span>
          <span class="t-muted ml-2">Init: ${nextCombatant.initiative}</span>
          <span class="text-xs ${typeColor} ml-2">${nextCombatant.type}</span>
        `;
      }
    }
    
    // Update button states based on combat status
    function updateButtonStates() {
      const startBtn = document.getElementById('dmStartCombatBtn');
      const pauseBtn = document.getElementById('dmPauseCombatBtn');
      const stopBtn = document.getElementById('dmStopCombatBtn');
      
      if (startBtn) {
        startBtn.textContent = combatState.status === 'active' ? 'Active' : 'Start';
        startBtn.setAttribute('data-status', combatState.status);
      }
      if (pauseBtn) {
        pauseBtn.textContent = combatState.status === 'paused' ? 'Paused' : 'Pause';
        pauseBtn.setAttribute('data-status', combatState.status);
      }
      if (stopBtn) {
        stopBtn.textContent = combatState.status === 'stopped' ? 'Stopped' : 'Stop';
        stopBtn.setAttribute('data-status', combatState.status);
      }
    }
    
    // Update combat state
    async function updateCombatState(updates) {
      try {
        const response = await fetch('/api/combat-state', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(updates),
        });
        
        if (response.ok) {
          combatState = { ...combatState, ...updates };
          const roundDisplay = document.getElementById('dmCurrentRound');
          if (roundDisplay) roundDisplay.textContent = combatState.currentRound || 1;
          updateButtonStates();
          updateInitiativePreview();
          return true;
        }
      } catch (error) {
        console.error('Error updating combat state:', error);
      }
      return false;
    }
    
    // Initialize combat button handlers
    function initializeCombatHandlers() {
      // Next turn
      const dmNextTurnBtn = document.getElementById('dmNextTurnBtn');
      const nextTurnHandler = async () => {
        await loadCombatData(); // Refresh data
        
        const activeInitiatives = initiatives.filter(e => e.isActive);
        if (activeInitiatives.length === 0) {
          alert('No active combatants in initiative tracker');
          return;
        }
        
        let newIndex = combatState.currentTurnIndex + 1;
        let newRound = combatState.currentRound;
        
        if (newIndex >= activeInitiatives.length) {
          newIndex = 0;
          newRound++;
        }
        
        await updateCombatState({
          currentTurnIndex: newIndex,
          currentRound: newRound,
          status: 'active'
        });
      };
      dmNextTurnBtn?.addEventListener('click', nextTurnHandler);
      eventHandlers.set('dmNextTurnBtn', nextTurnHandler);
      
      // Previous turn
      const dmPrevTurnBtn = document.getElementById('dmPrevTurnBtn');
      const prevTurnHandler = async () => {
        await loadCombatData(); // Refresh data
        
        const activeInitiatives = initiatives.filter(e => e.isActive);
        if (activeInitiatives.length === 0) {
          alert('No active combatants in initiative tracker');
          return;
        }
        
        let newIndex = combatState.currentTurnIndex - 1;
        let newRound = combatState.currentRound;
        
        if (newIndex < 0) {
          newIndex = activeInitiatives.length - 1;
          newRound = Math.max(1, newRound - 1);
        }
        
        await updateCombatState({
          currentTurnIndex: newIndex,
          currentRound: newRound,
          status: 'active'
        });
      };
      dmPrevTurnBtn?.addEventListener('click', prevTurnHandler);
      eventHandlers.set('dmPrevTurnBtn', prevTurnHandler);
      
      // Start combat
      const dmStartCombatBtn = document.getElementById('dmStartCombatBtn');
      const startCombatHandler = async () => {
        await loadCombatData();
        
        const activeInitiatives = initiatives.filter(e => e.isActive);
        if (activeInitiatives.length === 0) {
          alert('Add active combatants to the initiative tracker first');
          return;
        }
        
        await updateCombatState({
          status: 'active',
          currentTurnIndex: 0,
          currentRound: 1
        });
      };
      dmStartCombatBtn?.addEventListener('click', startCombatHandler);
      eventHandlers.set('dmStartCombatBtn', startCombatHandler);
      
      // Pause combat
      const dmPauseCombatBtn = document.getElementById('dmPauseCombatBtn');
      const pauseCombatHandler = async () => {
        await updateCombatState({
          status: 'paused'
        });
      };
      dmPauseCombatBtn?.addEventListener('click', pauseCombatHandler);
      eventHandlers.set('dmPauseCombatBtn', pauseCombatHandler);
      
      // Stop combat
      const dmStopCombatBtn = document.getElementById('dmStopCombatBtn');
      const stopCombatHandler = async () => {
        if (!confirm('Stop combat? This will reset the turn order.')) return;
        
        await updateCombatState({
          status: 'stopped',
          currentTurnIndex: 0,
          currentRound: 1
        });
      };
      dmStopCombatBtn?.addEventListener('click', stopCombatHandler);
      eventHandlers.set('dmStopCombatBtn', stopCombatHandler);
      
      // Manual HP Sync Button
      const dmSyncHpBtn = document.getElementById('dmSyncHpBtn');
      const syncHpHandler = async () => {
        // Disable button and show loading state
        dmSyncHpBtn.disabled = true;
        const originalText = dmSyncHpBtn.textContent;
        dmSyncHpBtn.innerHTML = '<span class="spinner"></span>Syncing...';
        
        try {
          const response = await fetch('/api/initiative/sync-hp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
          });
          
          if (!response.ok) {
            throw new Error('Failed to sync HP');
          }
          
          const result = await response.json();
          
          // Show success message
          alert(`HP synced successfully!\n\nSynced: ${result.syncedCount} of ${result.totalCount} characters with D&D Beyond URLs.`);
          
          // Reload combat data to show updated HP
          await loadCombatData();
        } catch (error) {
          console.error('Error syncing HP:', error);
          alert('Failed to sync HP from D&D Beyond. Make sure characters have valid D&D Beyond URLs.');
        } finally {
          // Restore button state
          dmSyncHpBtn.disabled = false;
          dmSyncHpBtn.textContent = originalText;
        }
      };
      dmSyncHpBtn?.addEventListener('click', syncHpHandler);
      eventHandlers.set('dmSyncHpBtn', syncHpHandler);
    }
    
    // Initialize other button handlers
    function initializeOtherHandlers() {
      const locationSelect = document.getElementById('locationSelect');
      const showInitiativeCheckbox = document.getElementById('showInitiativeTracker');
      const placeholderImageInput = document.getElementById('placeholderImageUrl');
      
      // Clear all
      const clearAllBtn = document.getElementById('clearAllBtn');
      const clearAllHandler = async () => {
        if (!confirm('Clear the entire player display? This will remove the location, NPCs, and hide the initiative tracker.')) {
          return;
        }

        const success = await updateState({
          currentLocationId: null,
          spotlightNpcIds: [],
          showInitiativeTracker: false,
        });

        if (success) {
          if (locationSelect) locationSelect.value = '';
          if (showInitiativeCheckbox) showInitiativeCheckbox.checked = false;
          updateLocationPreview(null);
          updateNpcList([]);
        }
      };
      clearAllBtn?.addEventListener('click', clearAllHandler);
      eventHandlers.set('clearAllBtn', clearAllHandler);
      
      // Toggle screen visibility
      const toggleScreenBtn = document.getElementById('toggleScreenBtn');
      const toggleScreenHandler = async () => {
        const newVisibility = !currentState.screenVisible;
        const success = await updateState({ screenVisible: newVisibility });
        
        if (success) {
          updateScreenVisibilityUI(newVisibility);
        }
      };
      toggleScreenBtn?.addEventListener('click', toggleScreenHandler);
      eventHandlers.set('toggleScreenBtn', toggleScreenHandler);
      
      // Save placeholder image
      const savePlaceholderBtn = document.getElementById('savePlaceholderBtn');
      const savePlaceholderHandler = async () => {
        const imageUrl = placeholderImageInput?.value.trim();
        if (!imageUrl) {
          alert('Please enter an image URL');
          return;
        }
        
        const success = await updateState({ placeholderImageUrl: imageUrl });
        if (success) {
          alert('Placeholder wallpaper saved!');
        }
      };
      savePlaceholderBtn?.addEventListener('click', savePlaceholderHandler);
      eventHandlers.set('savePlaceholderBtn', savePlaceholderHandler);
      
      // Clear placeholder image
      const clearPlaceholderBtn = document.getElementById('clearPlaceholderBtn');
      const clearPlaceholderHandler = async () => {
        if (!confirm('Remove the placeholder wallpaper?')) return;
        
        const success = await updateState({ placeholderImageUrl: null });
        if (success) {
          if (placeholderImageInput) placeholderImageInput.value = '';
        }
      };
      clearPlaceholderBtn?.addEventListener('click', clearPlaceholderHandler);
      eventHandlers.set('clearPlaceholderBtn', clearPlaceholderHandler);
      
      // Handle file upload for placeholder image
      const placeholderImageFile = document.getElementById('placeholderImageFile');
      const fileChangeHandler = async (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        
        // Validate file type
        if (!file.type.startsWith('image/')) {
          alert('Please select an image file');
          return;
        }
        
        // Validate file size (max 5MB)
        if (file.size > 5 * 1024 * 1024) {
          alert('Image file is too large. Maximum size is 5MB.');
          return;
        }
        
        // Convert to data URL
        const reader = new FileReader();
        reader.onload = async (e) => {
          const dataUrl = e.target?.result;
          if (typeof dataUrl === 'string') {
            // Update the input field with the data URL
            if (placeholderImageInput) placeholderImageInput.value = dataUrl;
            
            // Automatically save
            const success = await updateState({ placeholderImageUrl: dataUrl });
            if (success) {
              alert('Placeholder wallpaper uploaded and saved!');
            }
          }
        };
        reader.onerror = () => {
          alert('Error reading file. Please try again.');
        };
        reader.readAsDataURL(file);
      };
      placeholderImageFile?.addEventListener('change', fileChangeHandler);
      eventHandlers.set('placeholderImageFile', fileChangeHandler);

      // Copy URL to clipboard
      const copyUrlBtn = document.getElementById('copyUrlBtn');
      const playerDisplayUrlInput = document.getElementById('playerDisplayUrl');
      
      const copyUrlHandler = async () => {
        if (!playerDisplayUrlInput) return;
        
        try {
          // Use modern Clipboard API
          await navigator.clipboard.writeText(playerDisplayUrlInput.value);
          
          // Show feedback
          const originalText = copyUrlBtn.textContent;
          copyUrlBtn.textContent = 'Copied!';
          setTimeout(() => {
            copyUrlBtn.textContent = originalText;
          }, 2000);
        } catch (error) {
          // Fallback to older method if Clipboard API is not available
          playerDisplayUrlInput.select();
          try {
            document.execCommand('copy');
            const originalText = copyUrlBtn.textContent;
            copyUrlBtn.textContent = 'Copied!';
            setTimeout(() => {
              copyUrlBtn.textContent = originalText;
            }, 2000);
          } catch (fallbackError) {
            console.error('Failed to copy:', fallbackError);
            alert('Failed to copy. Please copy the URL manually.');
          }
        }
      };
      copyUrlBtn?.addEventListener('click', copyUrlHandler);
      eventHandlers.set('copyUrlBtn', copyUrlHandler);
      
      // Timer controls
      const startTimerBtn = document.getElementById('startTimerBtn');
      const pauseTimerBtn = document.getElementById('pauseTimerBtn');
      const resetTimerBtn = document.getElementById('resetTimerBtn');
      const timerMinutesInput = document.getElementById('timerMinutes');
      
      const startTimerHandler = async () => {
        const minutes = parseInt(timerMinutesInput?.value || '5', 10);
        const durationSeconds = minutes * 60;
        
        if (currentState.timerStatus === 'paused' && currentState.timerPausedAt && currentState.timerStartedAt) {
          // Resume from paused state
          const elapsed = (currentState.timerPausedAt - currentState.timerStartedAt) / 1000;
          const newStartTime = Date.now() - (elapsed * 1000);
          
          await updateState({
            timerStatus: 'running',
            timerStartedAt: newStartTime,
            timerPausedAt: null
          });
        } else {
          // Start new timer
          await updateState({
            showTimer: true,
            timerDuration: durationSeconds,
            timerStartedAt: Date.now(),
            timerPausedAt: null,
            timerStatus: 'running'
          });
        }
        
        startTimerUpdates();
        updateTimerDisplay();
      };
      startTimerBtn?.addEventListener('click', startTimerHandler);
      eventHandlers.set('startTimerBtn', startTimerHandler);
      
      const pauseTimerHandler = async () => {
        if (currentState.timerStatus === 'running') {
          await updateState({
            timerStatus: 'paused',
            timerPausedAt: Date.now()
          });
          
          if (timerUpdateInterval) {
            clearInterval(timerUpdateInterval);
            timerUpdateInterval = null;
          }
          updateTimerDisplay();
        }
      };
      pauseTimerBtn?.addEventListener('click', pauseTimerHandler);
      eventHandlers.set('pauseTimerBtn', pauseTimerHandler);
      
      const resetTimerHandler = async () => {
        await updateState({
          timerStatus: 'stopped',
          timerStartedAt: null,
          timerPausedAt: null
        });
        
        if (timerUpdateInterval) {
          clearInterval(timerUpdateInterval);
          timerUpdateInterval = null;
        }
        updateTimerDisplay();
      };
      resetTimerBtn?.addEventListener('click', resetTimerHandler);
      eventHandlers.set('resetTimerBtn', resetTimerHandler);
    }
    
    // HP Syncing for D&D Beyond
    const HP_SYNC_INTERVAL = 10000; // Sync HP every 10 seconds (faster for quick updates)
    
    // Sync HP from D&D Beyond
    const syncHpFromDnDBeyond = async () => {
      // Only sync when combat is active
      if (combatState.status !== 'active') {
        if (hpSyncInterval) {
          clearInterval(hpSyncInterval);
          hpSyncInterval = null;
        }
        return;
      }
      
      try {
        console.log('[DM Screen] Auto-syncing HP from D&D Beyond...');
        const response = await fetch('/api/initiative/sync-hp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        
        if (response.ok) {
          const result = await response.json();
          console.log(`[DM Screen] HP synced: ${result.syncedCount} of ${result.totalCount} characters`);
          
          // Refresh combat data to show updated HP
          await loadCombatData();
        }
      } catch (error) {
        console.error('[DM Screen] Auto HP sync error:', error);
      }
    };
    
    // Start HP syncing if combat is active
    const startHpSync = () => {
      if (hpSyncInterval) {
        clearInterval(hpSyncInterval);
      }
      
      if (combatState.status === 'active') {
        console.log('[DM Screen] Starting HP sync...');
        syncHpFromDnDBeyond(); // Sync immediately
        hpSyncInterval = setInterval(syncHpFromDnDBeyond, HP_SYNC_INTERVAL);
      }
    };
    
    // Initialize all handlers and intervals
    async function initialize() {
      // Clear old data
      locationsData.clear();
      npcsData.clear();
      
      // Load fresh data
      await initializeData();
      await loadState();
      
      // Initialize event listeners
      initializeEventListeners();
      initializeCombatHandlers();
      initializeOtherHandlers();
      
      // Load combat data
      await loadCombatData();
      
      // Refresh combat data periodically
      combatDataInterval = setInterval(loadCombatData, 5000);
      
      // Check combat status periodically and start/stop HP sync accordingly
      hpSyncStatusCheckInterval = setInterval(() => {
        if (combatState.status === 'active' && !hpSyncInterval) {
          startHpSync();
        } else if (combatState.status !== 'active' && hpSyncInterval) {
          clearInterval(hpSyncInterval);
          hpSyncInterval = null;
          console.log('[DM Screen] HP sync stopped (combat not active)');
        }
      }, 2000);
      
      // Start HP sync if combat is already active
      startHpSync();
      
      // Start timer updates if timer is running
      if (currentState.timerStatus === 'running') {
        startTimerUpdates();
      }
      
      // Initialize button states
      updateButtonStates();
    }
    
    // Cleanup function to remove all event listeners and intervals
    const cleanup = () => {
      // Remove all event listeners
      eventHandlers.forEach((handler, elementId) => {
        const element = document.getElementById(elementId);
        if (element && handler) {
          element.removeEventListener('click', handler);
          element.removeEventListener('change', handler);
        }
      });
      eventHandlers.clear();
      
      // Clear all intervals
      if (hpSyncInterval) {
        clearInterval(hpSyncInterval);
        hpSyncInterval = null;
      }
      if (hpSyncStatusCheckInterval) {
        clearInterval(hpSyncStatusCheckInterval);
        hpSyncStatusCheckInterval = null;
      }
      if (combatDataInterval) {
        clearInterval(combatDataInterval);
        combatDataInterval = null;
      }
      if (timerUpdateInterval) {
        clearInterval(timerUpdateInterval);
        timerUpdateInterval = null;
      }
    };

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', initialize);

    // Also initialize after Astro page transitions
    document.addEventListener('astro:page-load', initialize);
    
    // Cleanup before navigation
    document.addEventListener('astro:before-preparation', cleanup);
    
    // Cleanup on page unload
    window.addEventListener('beforeunload', cleanup);
  </script>
</Layout>

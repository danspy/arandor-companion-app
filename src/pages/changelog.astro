---
import Layout from '../layouts/Layout.astro';
import { marked } from 'marked';
import changelogContent from '../../CHANGELOG.md?raw';

marked.setOptions({ gfm: true, breaks: true });
const htmlContent = marked(changelogContent);
---

<Layout title="Changelog">
  <div class="max-w-4xl mx-auto px-1 sm:px-0">
    <div class="flex items-center gap-4 mb-8">
      <a href="/profile" class="t-back-link">
        <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/>
        </svg>
        Profile
      </a>
    </div>

    <div class="flex items-center gap-3 mb-8">
      <div style="width:3px;height:2.5rem;background:var(--gold);border-radius:2px;"></div>
      <h1 class="font-display italic font-semibold text-4xl" style="color:var(--gold);">Changelog</h1>
    </div>

    <div class="t-panel p-6 sm:p-8">
      <div class="t-prose" set:html={htmlContent} />
    </div>
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { isAuthenticated, getUserRole } from '../lib/auth';
import { db, PageSettings, eq } from '@/db';

// Tools page is only accessible to logged-in users
const isLoggedIn = isAuthenticated(Astro.cookies);
const userRole = await getUserRole(Astro.cookies);

if (!isLoggedIn) {
  return Astro.redirect('/login');
}

const canEdit = userRole === 'admin' || userRole === 'dungeonmaster';

// Get page settings for hero image
const pageSettings = await db.select().from(PageSettings).where(eq(PageSettings.pageName, 'tools'));
const heroImageUrl = pageSettings.length > 0 ? pageSettings[0].heroImageUrl : null;
---

<Layout title="Tools">
  <PageHero
    title="Tools"
    heroImageUrl={heroImageUrl}
    pageName="tools"
    canEditHero={canEdit}
    subtitle="Dice, initiative, music and the DM screen for the game table."
  />


  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <!-- Calendar Card -->
    <a
      href="/calendar"
      class="t-panel p-6 t-tool-card block"
    >
      <div class="flex items-start gap-4">
        <div class="t-inset p-3 w-fit rounded-xs mb-0">
          <svg class="w-6 h-6" style="color:var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        </div>
        <div class="flex-1">
          <h2 class="t-section-h text-lg mb-1">
            Calendar
          </h2>
          <p class="t-muted text-sm">
            Schedule and manage events for your D&D sessions. Set dates, times, and assign hosts.
          </p>
        </div>
      </div>
    </a>

    <!-- Dice Roller Card -->
    <a
      href="/tools/dice-roller"
      class="t-panel p-6 t-tool-card block"
    >
      <div class="flex items-start gap-4">
        <div class="t-inset p-3 w-fit rounded-xs mb-0">
          <svg class="w-6 h-6" style="color:var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
          </svg>
        </div>
        <div class="flex-1">
          <h2 class="t-section-h text-lg mb-1">
            Dice Roller
          </h2>
          <p class="t-muted text-sm">
            Roll dice for attacks, saves, and skill checks. Supports all standard D&D dice with animations.
          </p>
        </div>
      </div>
    </a>

    <!-- Initiative Tracker Card -->
    <a
        href="/tools/initiative"
        class="t-panel p-6 t-tool-card block"
      >
        <div class="flex items-start gap-4">
          <div class="t-inset p-3 w-fit rounded-xs mb-0">
            <svg class="w-6 h-6" style="color:var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
            </svg>
          </div>
          <div class="flex-1">
            <h2 class="t-section-h text-lg mb-1">
              Initiative Tracker
            </h2>
            <p class="t-muted text-sm">
              Track combat initiative order for characters, NPCs, and monsters.
              {canEdit ? 'You can edit the tracker.' : 'View-only access.'}
            </p>
          </div>
        </div>
      </a>

    <!-- Music Card -->
    <a href="/tools/music" class="t-panel p-6 t-tool-card block">
      <div class="flex items-start gap-4">
        <div class="t-inset p-3 w-fit rounded-xs mb-0">
          <svg class="w-6 h-6" style="color:var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
          </svg>
        </div>
        <div class="flex-1">
          <h2 class="t-section-h text-lg mb-1">
            Music
          </h2>
          <p class="t-muted text-sm">
            Playlists from your files and YouTube
          </p>
        </div>
      </div>
    </a>

    <!-- DM Screen Card (DM/Admin Only) -->
    {canEdit && (
      <a
        href="/tools/dm-screen"
        class="t-panel p-6 t-tool-card block"
      >
        <div class="flex items-start gap-4">
          <div class="t-inset p-3 w-fit rounded-xs mb-0">
            <svg class="w-6 h-6" style="color:var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <div class="flex-1">
            <h2 class="t-section-h text-lg mb-1">
              DM Screen
              <span class="t-badge t-badge-accent ml-2">DM Only</span>
            </h2>
            <p class="t-muted text-sm">
              Control what your players see on their display screen. Manage locations, NPCs, and combat tracking.
            </p>
          </div>
        </div>
      </a>

      <a href="/tools/bestiary" class="t-panel p-6 t-tool-card block">
        <div class="flex items-start gap-4">
          <div class="t-inset p-3 w-fit rounded-xs mb-0">
            <svg class="w-6 h-6" style="color:var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
          <div class="flex-1">
            <h2 class="t-section-h text-lg mb-1">
              Bestiary
              <span class="t-badge t-badge-accent ml-2">DM Only</span>
            </h2>
            <p class="t-muted text-sm">
              Stat blocks for monsters and NPCs: paste them from D&amp;D Beyond, add them to a fight, roll their attacks.
            </p>
          </div>
        </div>
      </a>
    )}
  </div>
</Layout>

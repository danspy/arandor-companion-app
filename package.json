{
  "name": "arandor-companion-app",
  "type": "module",
  "version": "1.0.0",
  "description": "The new Arandor Companion App - A D&D companion for tracking adventures",
  "scripts": {
    "dev": "astro dev",
    "build": "ASTRO_DATABASE_FILE=./data/content.db astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-icons": "node scripts/generate-icons.mjs",
    "generate-splash": "node scripts/generate-splash-screens.mjs",
    "generate-screenshots": "node scripts/generate-screenshots.mjs",
    "generate-all-assets": "npm run generate-icons && npm run generate-splash && npm run generate-screenshots"
  },
  "keywords": [
    "dnd",
    "astro",
    "tailwind"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@astrojs/db": "^0.18.1",
    "@astrojs/node": "^9.5.0",
    "astro": "^5.15.1",
    "dotenv": "^17.2.3",
    "marked": "^14.1.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.19",
    "@vitejs/plugin-basic-ssl": "^2.2.0",
    "playwright": "^1.57.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.18"
  }
}
